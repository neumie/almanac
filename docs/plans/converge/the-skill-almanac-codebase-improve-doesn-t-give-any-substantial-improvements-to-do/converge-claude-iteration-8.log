{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TTABKMriZJJ5ST5H89QHkq","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# role.sh - Role config resolution (role -> provider/model/effort)\n3\t#\n4\t# A role is a configurable slot a loop fills with an agent config: ralph's\n5\t# `agent`; harden's `conductor`/`reviewer`/`fixer`. Resolution layers most\n6\t# specific first — lens -> role -> consumer-wide -> default — over env keys\n7\t# named <PREFIX>[_<ROLE>][_<LENS>]_<FIELD> (uppercased, non-alnum -> `_`).\n8\t#\n9\t# Self-contained like lib/ui.sh / lib/run.sh: uses only printf/tr/sed and bash\n10\t# indirect expansion (no lib/core.sh dependency), so this file's interface is its\n11\t# own test surface (tests/test-role.sh). Callers source it directly.\n12\t\n13\t# A single env-key component: uppercased, runs of non-alphanumerics collapsed to\n14\t# one `_`, leading/trailing `_` trimmed. Joined with `_` to form a candidate key.\n15\talmanac_loop_env_key_part() {\n16\t  printf '%s' \"$1\" \\\n17\t    | tr '[:lower:]' '[:upper:]' \\\n18\t    | sed 's/[^A-Z0-9][^A-Z0-9]*/_/g; s/^_//; s/_$//'\n19\t}\n20\t\n21\t# Echo an env var's value if it is SET (even when empty), returning 0; return 1\n22\t# when the name is unset. The `+x` test distinguishes set-empty from unset so an\n23\t# explicitly-empty override wins over a more general layer.\n24\talmanac_loop_env_value() {\n25\t  local name=\"$1\"\n26\t\n27\t  if [ \"${!name+x}\" ]; then\n28\t    printf '%s\\n' \"${!name}\"\n29\t    return 0\n30\t  fi\n31\t\n32\t  return 1\n33\t}\n34\t\n35\t# Resolve one field of a role's config, most specific layer first:\n36\t#   <PREFIX>_<ROLE>_<LENS>_<FIELD> -> <PREFIX>_<ROLE>_<FIELD>\n37\t#   -> <PREFIX>_<FIELD> -> default_value\n38\t# The lens layer is skipped when lens is empty. Returns 2 on missing args.\n39\talmanac_loop_role_field() {\n40\t  [ \"$#\" -ge 5 ] || return 2\n41\t\n42\t  local prefix=\"$1\"\n43\t  local role=\"$2\"\n44\t  local lens=\"$3\"\n45\t  local field=\"$4\"\n46\t  local default_value=\"$5\"\n47\t  local prefix_key role_key lens_key field_key candidate value\n48\t\n49\t  prefix_key=\"$(almanac_loop_env_key_part \"$prefix\")\"\n50\t  role_key=\"$(almanac_loop_env_key_part \"$role\")\"\n51\t  lens_key=\"$(almanac_loop_env_key_part \"$lens\")\"\n52\t  field_key=\"$(almanac_loop_env_key_part \"$field\")\"\n53\t\n54\t  if [ -n \"$lens_key\" ]; then\n55\t    candidate=\"${prefix_key}_${role_key}_${lens_key}_${field_key}\"\n56\t    if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n57\t      printf '%s\\n' \"$value\"\n58\t      return 0\n59\t    fi\n60\t  fi\n61\t\n62\t  candidate=\"${prefix_key}_${role_key}_${field_key}\"\n63\t  if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n64\t    printf '%s\\n' \"$value\"\n65\t    return 0\n66\t  fi\n67\t\n68\t  candidate=\"${prefix_key}_${field_key}\"\n69\t  if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n70\t    printf '%s\\n' \"$value\"\n71\t    return 0\n72\t  fi\n73\t\n74\t  printf '%s\\n' \"$default_value\"\n75\t}\n76\t\n77\t# Read ONE field by name from a role-config TSV stream on stdin (the shape every\n78\t# loop's role resolver emits via almanac_loop_role_config: `field<TAB>value` per\n79\t# line). Echoes the value (empty when the field is absent). The full stream is\n80\t# consumed (no early awk exit) so the producer never takes a SIGPIPE under\n81\t# `set -o pipefail`. Lives here so each loop's per-field reader (harden_role_field,\n82\t# converge_role_field, …) reduces to one line — the awk pipeline no longer lives\n83\t# in each loop's core.\n84\talmanac_loop_role_tsv_field() {\n85\t  awk -F'\\t' -v k=\"$1\" '$1 == k { v = $2 } END { print v }'\n86\t}\n87\t\n88\t# Resolve a role's full (provider, model, effort) config as three TSV rows, each\n89\t# field resolved through almanac_loop_role_field with its own default. Returns 2\n90\t# on missing args.\n91\talmanac_loop_role_config() {\n92\t  [ \"$#\" -ge 2 ] || return 2\n93\t\n94\t  local prefix=\"$1\"\n95\t  local role=\"$2\"\n96\t  local lens=\"${3:-}\"\n97\t  local default_provider=\"${4:-}\"\n98\t  local default_model=\"${5:-}\"\n99\t  local default_effort=\"${6:-}\"\n100\t\n101\t  printf 'provider\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"provider\" \"$default_provider\")\"\n102\t  printf 'model\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"model\" \"$default_model\")\"\n103\t  printf 'effort\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"effort\" \"$default_effort\")\"\n104\t}\n105\t"}]},"parent_tool_use_id":"toolu_01K4Z2sefXKvR6N845pzKx84","session_id":"071b63c6-c8c0-41ca-9e95-ee8516eddb8e","uuid":"2eae38bf-589b-438c-bef9-209bb13bea5f","timestamp":"2026-05-27T08:01:39.738Z","subagent_type":"Explore","task_description":"Explore almanac for friction"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016cV5g3LifEz7gaKvvKiQmo","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# feedback.sh - Project feedback-loop detection + runner\n3\t#\n4\t# The feedback loops are a project's objective gate: the test/typecheck/lint\n5\t# commands implied by its marker files (package.json, Cargo.toml, …). Detection\n6\t# maps marker files to commands (shared by Ralph's prompt and harden's fixer, so\n7\t# both run the same gate with no per-project config); the runner executes them\n8\t# and reports a pass/fail verdict per loop.\n9\t#\n10\t# Self-contained like lib/role.sh / lib/run.sh: uses only printf/tr/mkdir/eval\n11\t# and a subshell cd (no lib/core.sh dependency), so this file's interface is its\n12\t# own test surface (tests/test-feedback.sh). Callers source it directly.\n13\t\n14\t# Single source of truth: marker → list of (command, description) rows. Each\n15\t# marker block emits TAB-separated rows, so adding a marker is a single block\n16\t# carrying both the command and its description — no parallel case-statement to\n17\t# keep in sync. Private — public surface is almanac_loop_feedback_commands +\n18\t# _markdown derived below.\n19\t_almanac_loop_feedback_rows() {\n20\t  local root=\"${1:-.}\"\n21\t\n22\t  if [ -f \"$root/package.json\" ]; then\n23\t    printf '%s\\t%s\\n' \"npm run test\"      \"run npm tests\"\n24\t    printf '%s\\t%s\\n' \"npm run typecheck\" \"run TypeScript type checks\"\n25\t    printf '%s\\t%s\\n' \"npm run lint\"      \"run lint checks\"\n26\t  fi\n27\t\n28\t  if [ -f \"$root/Makefile\" ]; then\n29\t    printf '%s\\t%s\\n' \"make test\"  \"run Makefile test target\"\n30\t    printf '%s\\t%s\\n' \"make check\" \"run Makefile check target\"\n31\t  fi\n32\t\n33\t  if [ -f \"$root/Cargo.toml\" ]; then\n34\t    printf '%s\\t%s\\n' \"cargo test\"  \"run Rust tests\"\n35\t    printf '%s\\t%s\\n' \"cargo check\" \"run Rust compiler checks\"\n36\t  fi\n37\t\n38\t  if [ -f \"$root/go.mod\" ]; then\n39\t    printf '%s\\t%s\\n' \"go test ./...\" \"run Go tests\"\n40\t    printf '%s\\t%s\\n' \"go vet ./...\"  \"run Go vet checks\"\n41\t  fi\n42\t\n43\t  if [ -f \"$root/pyproject.toml\" ] || [ -f \"$root/setup.py\" ]; then\n44\t    printf '%s\\t%s\\n' \"pytest\" \"run Python tests\"\n45\t    printf '%s\\t%s\\n' \"mypy\"   \"run Python type checks\"\n46\t  fi\n47\t\n48\t  if [ -f \"$root/tests/test-skills.sh\" ]; then\n49\t    printf '%s\\t%s\\n' \"bash tests/test-skills.sh\" \"validate skill format/content\"\n50\t  fi\n51\t\n52\t  if [ -f \"$root/tests/test-structure.sh\" ]; then\n53\t    printf '%s\\t%s\\n' \"bash tests/test-structure.sh\" \"validate repo layout\"\n54\t  fi\n55\t}\n56\t\n57\t# Emit one feedback command per line, detected from the project marker files\n58\t# present at $root. The order is fixed so the prompt/runner output is stable.\n59\talmanac_loop_feedback_commands() {\n60\t  local cmd desc\n61\t  while IFS=$'\\t' read -r cmd desc; do\n62\t    [ -n \"$cmd\" ] || continue\n63\t    printf '%s\\n' \"$cmd\"\n64\t  done < <(_almanac_loop_feedback_rows \"${1:-.}\")\n65\t}\n66\t\n67\talmanac_loop_feedback_markdown() {\n68\t  local root=\"${1:-.}\"\n69\t  local cmd desc found=0\n70\t\n71\t  while IFS=$'\\t' read -r cmd desc; do\n72\t    [ -n \"$cmd\" ] || continue\n73\t    printf -- '- `%s` to %s\\n' \"$cmd\" \"$desc\"\n74\t    found=1\n75\t  done < <(_almanac_loop_feedback_rows \"$root\")\n76\t\n77\t  if [ \"$found\" -eq 0 ]; then\n78\t    printf '%s\\n' \"- (none detected)\"\n79\t  fi\n80\t}\n81\t\n82\t# Run every detected feedback loop for the project at $root and emit one TSV\n83\t# verdict row per loop: <command>\\t<pass|fail>. Each command runs from $root\n84\t# (combined output captured to $log_dir/<slug>.log when a log dir is given,\n85\t# else discarded). Returns 0 only when every loop passed and non-zero when any\n86\t# failed, so a caller can gate on the aggregate while still reading the per-loop\n87\t# verdicts. This is the runner half of the shared feedback engine; detection is\n88\t# almanac_loop_feedback_commands, shared with Ralph, so both consumers run the\n89\t# same objective gate without per-project config.\n90\talmanac_loop_feedback_run() {\n91\t  local root=\"${1:-.}\"\n92\t  local log_dir=\"${2:-}\"\n93\t  local command verdict log_file slug\n94\t  local any_fail=0\n95\t\n96\t  if [ -n \"$log_dir\" ]; then\n97\t    mkdir -p \"$log_dir\"\n98\t  fi\n99\t\n100\t  while IFS= read -r command; do\n101\t    [ -n \"$command\" ] || continue\n102\t\n103\t    if [ -n \"$log_dir\" ]; then\n104\t      slug=\"$(printf '%s' \"$command\" | tr -cs 'A-Za-z0-9' '-')\"\n105\t      log_file=\"$log_dir/${slug}.log\"\n106\t    else\n107\t      log_file=\"/dev/null\"\n108\t    fi\n109\t\n110\t    if ( cd \"$root\" && eval \"$command\" ) > \"$log_file\" 2>&1; then\n111\t      verdict=\"pass\"\n112\t    else\n113\t      verdict=\"fail\"\n114\t      any_fail=1\n115\t    fi\n116\t\n117\t    printf '%s\\t%s\\n' \"$command\" \"$verdict\"\n118\t  done < <(almanac_loop_feedback_commands \"$root\")\n119\t\n120\t  return \"$any_fail\"\n121\t}\n122\t"}]},"parent_tool_use_id":"toolu_01K4Z2sefXKvR6N845pzKx84","session_id":"071b63c6-c8c0-41ca-9e95-ee8516eddb8e","uuid":"e6011adf-c2b5-4827-98f0-fb05fee42f9a","timestamp":"2026-05-27T08:01:39.815Z","subagent_type":"Explore","task_description":"Explore almanac for friction"}
