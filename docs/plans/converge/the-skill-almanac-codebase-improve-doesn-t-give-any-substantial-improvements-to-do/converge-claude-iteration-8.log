{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uhv9VaZmxyDPQDYjbXqvYH","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# harden.sh - Bootstrap a harden-loop rubric for one target\n3\t\n4\tset -euo pipefail\n5\t\n6\tsource \"$ALMANAC_HOME/lib/harden-core.sh\"\n7\t\n8\tusage() {\n9\t  printf '%s\\n' \"Usage:\"\n10\t  printf '%s\\n' \"  almanac harden <target>\"\n11\t  printf '%s\\n' \"  almanac harden <target> --goal <goal>\"\n12\t  printf '%s\\n' \"  almanac harden <target> --approve\"\n13\t  printf '%s\\n' \"  almanac harden <target> --fix\"\n14\t  printf '%s\\n' \"  almanac harden <target> --loop [--rounds N]\"\n15\t  printf '%s\\n' \"  almanac harden <target> --watch\"\n16\t  printf '%s\\n' \"  almanac harden <target> --watch-worker <lens|worker-id>\"\n17\t  printf '%s\\n' \"\"\n18\t  printf '%s\\n' \"With no flags, fans out one read-only reviewer per lens over the target,\"\n19\t  printf '%s\\n' \"aggregates their findings into the ledger, and prints them. Configure the\"\n20\t  printf '%s\\n' \"lens set via HARDEN_LENSES (comma- or space-separated; capped by HARDEN_MAX_REVIEWERS).\"\n21\t  printf '%s\\n' \"If a rubric has been drafted for the target, it must be approved first;\"\n22\t  printf '%s\\n' \"a target with no rubric runs ad-hoc.\"\n23\t  printf '%s\\n' \"With --goal, creates docs/plans/harden/<target-slug>/rubric.md in the repo.\"\n24\t  printf '%s\\n' \"With --approve, approves an edited draft rubric.\"\n25\t  printf '%s\\n' \"With --fix, runs one sequential write-capable fixer over the open blocking\"\n26\t  printf '%s\\n' \"findings, then runs the project feedback loops and reports a verdict per loop.\"\n27\t  printf '%s\\n' \"With --loop, runs the convergence loop (fan-out -> ratify -> fix -> feedback\"\n28\t  printf '%s\\n' \"-> gate) in rounds until it converges or the round budget is hit. Set the\"\n29\t  printf '%s\\n' \"budget with --rounds N (default 5, or HARDEN_ROUND_BUDGET). Between rounds a\"\n30\t  printf '%s\\n' \"HITL checkpoint lets you ship, continue, or steer — steering captures a\"\n31\t  printf '%s\\n' \"directive that redirects the next round's reviewers and fixer.\"\n32\t  printf '%s\\n' \"With --watch, redraws the live supervision dashboard for the target's most\"\n33\t  printf '%s\\n' \"recent run (reviewer health, findings tallies, rubric progress, verdict).\"\n34\t  printf '%s\\n' \"With --watch-worker, streams a single reviewer's live event log (pass a lens\"\n35\t  printf '%s\\n' \"like 'security' or a full worker id like 'reviewer-security').\"\n36\t}\n37\t\n38\tTARGET=\"\"\n39\tGOAL=\"\"\n40\tAPPROVE=0\n41\tFIX=0\n42\tLOOP=0\n43\tROUNDS=\"\"\n44\tWATCH=0\n45\tWATCH_WORKER=\"\"\n46\t\n47\twhile [ \"$#\" -gt 0 ]; do\n48\t  case \"$1\" in\n49\t    -h|--help)\n50\t      usage\n51\t      exit 0\n52\t      ;;\n53\t    -g|--goal)\n54\t      shift\n55\t      [ \"$#\" -gt 0 ] || _die \"Missing value for --goal\"\n56\t      GOAL=\"$1\"\n57\t      ;;\n58\t    --approve)\n59\t      APPROVE=1\n60\t      ;;\n61\t    --fix)\n62\t      FIX=1\n63\t      ;;\n64\t    --loop)\n65\t      LOOP=1\n66\t      ;;\n67\t    --watch)\n68\t      WATCH=1\n69\t      ;;\n70\t    --watch-worker)\n71\t      shift\n72\t      [ \"$#\" -gt 0 ] || _die \"Missing value for --watch-worker\"\n73\t      WATCH_WORKER=\"$1\"\n74\t      ;;\n75\t    --rounds)\n76\t      shift\n77\t      [ \"$#\" -gt 0 ] || _die \"Missing value for --rounds\"\n78\t      ROUNDS=\"$1\"\n79\t      ;;\n80\t    --)\n81\t      shift\n82\t      break\n83\t      ;;\n84\t    -*)\n85\t      _die \"Unknown harden option: $1\"\n86\t      ;;\n87\t    *)\n88\t      if [ -z \"$TARGET\" ]; then\n89\t        TARGET=\"$1\"\n90\t      else\n91\t        _die \"Unexpected harden argument: $1\"\n92\t      fi\n93\t      ;;\n94\t  esac\n95\t  shift\n96\tdone\n97\t\n98\t[ -n \"$TARGET\" ] || {\n99\t  usage\n100\t  _die \"Missing harden target\"\n101\t}\n102\t\n103\t# Live supervision modes (read-only): watch the dashboard or a single worker's\n104\t# event stream for the target's most recent run. Mutually exclusive with the\n105\t# action modes (--goal/--approve/--fix/--loop).\n106\tif [ \"$WATCH\" -eq 1 ] || [ -n \"$WATCH_WORKER\" ]; then\n107\t  [ -z \"$GOAL\" ] || _die \"Use either --goal or a --watch mode, not both\"\n108\t  [ \"$APPROVE\" -eq 0 ] || _die \"Use either --approve or a --watch mode, not both\"\n109\t  [ \"$FIX\" -eq 0 ] || _die \"Use either --fix or a --watch mode, not both\"\n110\t  [ \"$LOOP\" -eq 0 ] || _die \"Use either --loop or a --watch mode, not both\"\n111\t  [ -z \"$ROUNDS\" ] || _die \"--rounds does not apply to a --watch mode\"\n112\t\n113\t  if [ \"$WATCH\" -eq 1 ] && [ -n \"$WATCH_WORKER\" ]; then\n114\t    _die \"Use either --watch or --watch-worker, not both\"\n115\t  fi\n116\t\n117\t  if [ -n \"$WATCH_WORKER\" ]; then\n118\t    almanac_harden_watch_worker \"$PWD\" \"$TARGET\" \"$WATCH_WORKER\" \"follow\"\n119\t    exit 0\n120\t  fi\n121\t\n122\t  almanac_harden_dashboard_redraw \"$PWD\" \"$TARGET\"\n123\t  exit 0\n124\tfi\n125\t\n126\tif [ \"$LOOP\" -eq 1 ]; then\n127\t  [ -z \"$GOAL\" ] || _die \"Use either --goal or --loop, not both\"\n128\t  [ \"$APPROVE\" -eq 0 ] || _die \"Use either --approve or --loop, not both\"\n129\t  [ \"$FIX\" -eq 0 ] || _die \"Use either --fix or --loop, not both\"\n130\t\n131\t  almanac_harden_run \"$PWD\" \"$TARGET\" ${ROUNDS:+\"$ROUNDS\"}\n132\t  exit 0\n133\tfi\n134\t\n135\t[ -z \"$ROUNDS\" ] || _die \"--rounds only applies with --loop\"\n136\t\n137\tif [ \"$FIX\" -eq 1 ]; then\n138\t  [ -z \"$GOAL\" ] || _die \"Use either --goal or --fix, not both\"\n139\t  [ \"$APPROVE\" -eq 0 ] || _die \"Use either --approve or --fix, not both\"\n140\t\n141\t  almanac_harden_fix \"$PWD\" \"$TARGET\"\n142\t  # Feedback is decoupled from the fixer (the loop runs it per round); run it\n143\t  # here so the standalone --fix path still reports the objective verdict.\n144\t  almanac_harden_report_feedback \"$PWD\"\n145\t  exit 0\n146\tfi\n147\t\n148\tif [ \"$APPROVE\" -eq 1 ]; then\n149\t  [ -z \"$GOAL\" ] || _die \"Use either --goal or --approve, not both\"\n150\t\n151\t  RUBRIC_PATH=\"$(almanac_harden_rubric_path \"$PWD\" \"$TARGET\")\"\n152\t  DISPLAY_PATH=\"${RUBRIC_PATH#$PWD/}\"\n153\t\n154\t  if almanac_harden_approve_rubric \"$PWD\" \"$TARGET\"; then\n155\t    _success \"Rubric approved: $DISPLAY_PATH\"\n156\t    _info \"Contract locked — reviewers can now run: almanac harden $TARGET\"\n157\t    exit 0\n158\t  else\n159\t    APPROVE_STATUS=\"$?\"\n160\t  fi\n161\t\n162\t  case \"$APPROVE_STATUS\" in\n163\t    2)\n164\t      _die \"Rubric not found: $DISPLAY_PATH\"\n165\t      ;;\n166\t    3)\n167\t      _die \"Rubric already approved: $DISPLAY_PATH\"\n168\t      ;;\n169\t    *)\n170\t      _die \"Failed to approve rubric: $DISPLAY_PATH\"\n171\t      ;;\n172\t  esac\n173\tfi\n174\t\n175\tif [ -n \"$GOAL\" ]; then\n176\t  RUBRIC_PATH=\"$(almanac_harden_rubric_path \"$PWD\" \"$TARGET\")\"\n177\t  DISPLAY_PATH=\"${RUBRIC_PATH#$PWD/}\"\n178\t\n179\t  if [ -e \"$RUBRIC_PATH\" ]; then\n180\t    _die \"Rubric already exists: $DISPLAY_PATH\"\n181\t  fi\n182\t\n183\t  almanac_harden_write_rubric \"$PWD\" \"$TARGET\" \"$GOAL\"\n184\t\n185\t  _success \"Draft rubric created: $DISPLAY_PATH\"\n186\t  _info \"Edit and approve rubric before running reviewers.\"\n187\t  exit 0\n188\tfi\n189\t\n190\t# No --goal or --approve: fan out N read-only reviewers (one per configured\n191\t# lens) over the target and aggregate their findings into the ledger.\n192\talmanac_harden_fanout \"$PWD\" \"$TARGET\"\n193\t"}]},"parent_tool_use_id":"toolu_01K4Z2sefXKvR6N845pzKx84","session_id":"071b63c6-c8c0-41ca-9e95-ee8516eddb8e","uuid":"e5521acc-d5e9-423a-ba22-4b58cf7f8824","timestamp":"2026-05-27T08:01:48.349Z","subagent_type":"Explore","task_description":"Explore almanac for friction"}
