{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SofoQuRbG7yn5ZuJmqs6tp","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# sync.sh — Check adapted skills for upstream changes\n3\t\n4\tsource \"$ALMANAC_HOME/lib/core.sh\"\n5\tsource \"$ALMANAC_HOME/lib/almanac-core.sh\"\n6\t\n7\tSHOW_DIFF=false\n8\t[ \"${1:-}\" = \"--diff\" ] && SHOW_DIFF=true\n9\t\n10\t# Fetch SHA of a file from GitHub.\n11\t# Emits ONLY a valid 40-char git blob SHA. On 404 / rate-limit, `gh api` prints\n12\t# the JSON error body to stdout — without this guard that body gets captured and\n13\t# mistaken for a SHA, so every skill falsely reports \"changed\".\n14\t_fetch_sha() {\n15\t  local api_path=\"$1\" raw=\"\"\n16\t  if command -v gh &>/dev/null; then\n17\t    raw=$(gh api \"$api_path\" --jq '.sha' 2>/dev/null || true)\n18\t  elif command -v curl &>/dev/null; then\n19\t    raw=$(curl -sL \"https://api.github.com/$api_path\" 2>/dev/null | grep '\"sha\"' | head -1 | sed 's/.*\"sha\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/' || true)\n20\t  else\n21\t    _die \"Neither gh nor curl available\"\n22\t  fi\n23\t  if printf '%s' \"$raw\" | grep -Eq '^[0-9a-f]{40}$'; then\n24\t    printf '%s' \"$raw\"\n25\t  fi\n26\t}\n27\t\n28\t_info \"Checking adapted skills for upstream changes...\"\n29\t\n30\tfound=0\n31\tup_to_date=0\n32\tchanged=0\n33\tunbaselined=0\n34\terrors=0\n35\t\n36\twhile IFS= read -r skill_dir; do\n37\t  [ -d \"$skill_dir\" ] || continue\n38\t  skill_file=\"$skill_dir/SKILL.md\"\n39\t  [ -f \"$skill_file\" ] || continue\n40\t\n41\t  # Extract upstream metadata from frontmatter\n42\t  frontmatter=$(awk 'BEGIN{f=0} /^---$/{f++; next} f==1{print} f>=2{exit}' \"$skill_file\")\n43\t\n44\t  upstream=$(echo \"$frontmatter\" | grep 'upstream:' | head -1 | sed 's/^[[:space:]]*upstream:[[:space:]]*//' || true)\n45\t  [ -z \"$upstream\" ] && continue\n46\t\n47\t  upstream_sha=$(echo \"$frontmatter\" | grep 'upstream-sha:' | head -1 | sed 's/^[[:space:]]*upstream-sha:[[:space:]]*//' || true)\n48\t  adapted_date=$(echo \"$frontmatter\" | grep 'adapted-date:' | head -1 | sed 's/^[[:space:]]*adapted-date:[[:space:]]*//' | tr -d '\"' || true)\n49\t\n50\t  skill_name=$(basename \"$skill_dir\")\n51\t  found=$((found + 1))\n52\t\n53\t  # Parse repo and path from upstream (format: owner/repo/path)\n54\t  repo=$(echo \"$upstream\" | cut -d'/' -f1-2)\n55\t  skill_path=$(echo \"$upstream\" | cut -d'/' -f3-)\n56\t\n57\t  # Get current SHA from GitHub API\n58\t  current_sha=$(_fetch_sha \"repos/$repo/contents/$skill_path/SKILL.md\")\n59\t\n60\t  if [ -z \"$current_sha\" ]; then\n61\t    _error \"$skill_name: failed to fetch upstream (bad path or API error)\"\n62\t    errors=$((errors + 1))\n63\t    continue\n64\t  fi\n65\t\n66\t  if [ -z \"$upstream_sha\" ]; then\n67\t    _warn \"$skill_name: no baseline upstream-sha recorded (upstream now ${current_sha:0:12})\"\n68\t    unbaselined=$((unbaselined + 1))\n69\t    continue\n70\t  fi\n71\t\n72\t  if [ \"$current_sha\" = \"$upstream_sha\" ]; then\n73\t    _success \"$skill_name: up to date\"\n74\t    up_to_date=$((up_to_date + 1))\n75\t  else\n76\t    _warn \"$skill_name: upstream changed (adapted $adapted_date)\"\n77\t    changed=$((changed + 1))\n78\t\n79\t    if [ \"$SHOW_DIFF\" = true ]; then\n80\t      _info \"  Upstream:     https://github.com/$repo/blob/main/$skill_path/SKILL.md\"\n81\t      _info \"  Local SHA:    ${upstream_sha:0:12}\"\n82\t      _info \"  Upstream SHA: ${current_sha:0:12}\"\n83\t    fi\n84\t  fi\n85\tdone < <(almanac_list_skills)\n86\t\n87\tif [ \"$found\" -eq 0 ]; then\n88\t  _info \"No skills with upstream tracking found\"\n89\telse\n90\t  _info \"Results: $found tracked, $up_to_date up to date, $changed changed, $unbaselined unbaselined, $errors errors\"\n91\t  if [ \"$changed\" -gt 0 ] && [ \"$SHOW_DIFF\" = false ]; then\n92\t    _warn \"Run 'almanac sync --diff' to see details\"\n93\t  fi\n94\tfi\n95\t"}]},"parent_tool_use_id":"toolu_01K4Z2sefXKvR6N845pzKx84","session_id":"071b63c6-c8c0-41ca-9e95-ee8516eddb8e","uuid":"ddca5337-8714-4530-8e97-e606b296caf8","timestamp":"2026-05-27T08:01:45.327Z","subagent_type":"Explore","task_description":"Explore almanac for friction"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PRdLovtv9TmvHPszSQLvUs","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# hub.sh — interactive front door to almanac loops (ralph, harden)\n3\t#\n4\t# Bare `almanac` routes here on a TTY (and `almanac hub` always does). The hub\n5\t# reads the run registry under the caller's repo ($PWD/.almanac/runs) and shows\n6\t# the loops it finds: a Running section (live status) and a Recent section (last\n7\t# finished). On a TTY it opens an interactive menu — start a new run, or act on a\n8\t# running loop (watch its live status, stop it, or queue a steer directive for its\n9\t# next round). The menu is gum-styled when gum is present and degrades to a plain\n10\t# numbered menu (built on the shared almanac_loop_ui_choose/input/confirm seam)\n11\t# when gum is absent, so it works on any TTY. Off a TTY it renders the overview as\n12\t# plain text and exits — it never blocks on a menu, so `almanac hub | cat`, scripts\n13\t# and tests get a clean read view.\n14\t#\n15\t# The per-run actions are also drivable non-interactively, the seam the menu and\n16\t# scripts/tests share:\n17\t#   almanac hub --watch <id>           tail a run's live status (one frame off a TTY)\n18\t#   almanac hub --stop  <id>           signal a run to stop (loop stop file)\n19\t#   almanac hub --steer <id> <text…>   queue a steer directive for the next round\n20\t#   almanac hub --new <ralph|harden|converge> [config…] [--dry-run]\n21\t#                                      launch a new run (dry-run previews the command)\n22\t#   almanac hub --resume <id>          re-launch a finished run with the same config (auto-confirm)\n23\t#   almanac hub --clone  <id>          start the launcher pre-filled from a finished run (no auto-confirm)\n24\t#   almanac hub --stats                summarise finished runs by (type, provider, model)\n25\t\n26\tset -euo pipefail\n27\t\n28\tsource \"$ALMANAC_HOME/lib/ui.sh\"\n29\tsource \"$ALMANAC_HOME/lib/run.sh\"\n30\tsource \"$ALMANAC_HOME/lib/loop-launcher.sh\"\n31\t\n32\tROOT=\"$PWD\"\n33\t\n34\thub_usage() {\n35\t  printf '%s\\n' \"Usage:\"\n36\t  printf '%s\\n' \"  almanac hub                      open the hub (interactive on a TTY, overview otherwise)\"\n37\t  printf '%s\\n' \"  almanac hub --watch <run-id>     tail a run's live status\"\n38\t  printf '%s\\n' \"  almanac hub --stop  <run-id>     signal a run to stop\"\n39\t  printf '%s\\n' \"  almanac hub --steer <run-id> …   queue a steer directive for the next round\"\n40\t  printf '%s\\n' \"  almanac hub --new <ralph|harden|converge> [config…] [--dry-run]\"\n41\t  printf '%s\\n' \"                                  launch a new run (--dry-run previews it)\"\n42\t  printf '%s\\n' \"  almanac hub --resume <run-id>    re-launch a finished run with the same config\"\n43\t  printf '%s\\n' \"  almanac hub --clone  <run-id>    start the launcher pre-filled from a finished run\"\n44\t  printf '%s\\n' \"  almanac hub --stats              summarise finished runs (runs + success rate per provider/model)\"\n45\t}\n46\t\n47\t# Launch (or, with dry_run=1, preview) a composed new run. env_raw/argv_raw are\n48\t# the newline-token streams from almanac_loop_new_run_env / almanac_loop_new_run_argv.\n49\t# Dry-run prints the resolved `ENV… almanac <argv>` command and returns — the\n50\t# non-interactive, scripts-safe preview tests and the gum confirm both use.\n51\t# Otherwise it exports the env lines and execs the launcher, handing over the\n52\t# terminal to the new run.\n53\talmanac_hub_launch_new() {\n54\t  local dry_run=\"$1\" env_raw=\"$2\" argv_raw=\"$3\"\n55\t  local line display=\"\" argv=()\n56\t\n57\t  while IFS= read -r line; do\n58\t    [ -n \"$line\" ] || continue\n59\t    argv+=(\"$line\")\n60\t  done <<< \"$argv_raw\"\n61\t  [ \"${#argv[@]}\" -gt 0 ] || _die \"Nothing to launch\"\n62\t\n63\t  if [ \"$dry_run\" = \"1\" ]; then\n64\t    while IFS= read -r line; do\n65\t      [ -n \"$line\" ] || continue\n66\t      display+=\"$line \"\n67\t    done <<< \"$env_raw\"\n68\t    display+=\"almanac\"\n69\t    for line in \"${argv[@]}\"; do\n70\t      display+=\" $line\"\n71\t    done\n72\t    printf '%s\\n' \"$display\"\n73\t    return 0\n74\t  fi\n75\t\n76\t  while IFS= read -r line; do\n77\t    [ -n \"$line\" ] || continue\n78\t    export \"$line\"\n79\t  done <<< \"$env_raw\"\n80\t\n81\t  exec bash \"$ALMANAC_HOME/bin/almanac\" \"${argv[@]}\"\n82\t}\n83\t\n84\t# Interactive New-run flow: pick the loop type, then hand off to the shared\n85\t# almanac launcher (almanac_loop_launch), which gathers that loop's config\n86\t# through the same gum seam, summarises, confirms, and execs the runner. No\n87\t# config logic lives here — one launcher, one UX, shared with `almanac ralph`\n88\t# and `almanac harden`. On confirm the launcher execs (hands over the terminal);\n89\t# if the operator cancels first it returns here and the menu loop continues.\n90\talmanac_hub_new_run() {\n91\t  local type\n92\t  type=\"$(almanac_loop_ui_choose \"New run — pick a loop\" ralph harden converge)\" || return 0\n93\t  almanac_loop_launch \"$type\"\n94\t}\n95\t\n96\talmanac_hub_menu() {\n97\t  local root=\"$1\"\n98\t  local running line choice run_id action directive\n99\t  local options\n100\t"}]},"parent_tool_use_id":"toolu_01K4Z2sefXKvR6N845pzKx84","session_id":"071b63c6-c8c0-41ca-9e95-ee8516eddb8e","uuid":"186f64af-b548-4df2-b8e0-910994e714d6","timestamp":"2026-05-27T08:01:45.395Z","subagent_type":"Explore","task_description":"Explore almanac for friction"}
