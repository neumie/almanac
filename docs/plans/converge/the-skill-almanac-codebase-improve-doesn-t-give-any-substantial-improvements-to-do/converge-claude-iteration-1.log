{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H2PCfc9PjUKWhVueY7Mtff","type":"tool_result","content":"62\t# Split a newline-separated blob into an array (caller passes the array name).\n63\t# Portable substitute for `mapfile -t`, which is bash 4+ only — macOS still ships\n64\t# bash 3.2, so any test that relies on `mapfile` cannot run on a stock Mac.\n65\tsplit_lines_into() {\n66\t  local _name=\"$1\" _blob=\"$2\" _line\n67\t  eval \"$_name=()\"\n68\t  while IFS= read -r _line; do\n69\t    eval \"$_name+=(\\\"\\$_line\\\")\"\n70\t  done <<< \"$_blob\"\n71\t}\n72\t\n73\ttest_record_fields_is_canonical_schema() {\n74\t  local expected actual\n75\t  expected=$(printf '%s\\n' \\\n76\t    id type target pid status_file started_at status finished_at round summary failure_reason \\\n77\t    provider model effort iterations oversee lenses rounds queue_progress)\n78\t  actual=\"$(almanac_loop_record_fields)\"\n79\t  assert_eq \"$expected\" \"$actual\" \"record_fields must be the canonical run-status schema, in order\"\n80\t  echo \"  PASS: record_fields is the canonical schema\"\n81\t}\n82\t\n83\ttest_record_has_field_recognises_only_canonical() {\n84\t  almanac_loop_record_has_field \"id\" || fail \"id must be a canonical field\"\n85\t  almanac_loop_record_has_field \"summary\" || fail \"summary must be a canonical field\"\n86\t  if almanac_loop_record_has_field \"bogus\"; then\n87\t    fail \"a non-canonical field must not be recognised\"\n88\t  fi\n89\t  echo \"  PASS: record_has_field recognises only canonical fields\"\n90\t}\n91\t\n92\ttest_record_set_initialises_full_key_set() {\n93\t  local tmp file keys expected\n94\t  new_tmpdir; tmp=\"$NEW_TMPDIR\"; file=\"$tmp/status.tsv\"\n95\t\n96\t  # Name only a subset; the record must still carry EVERY canonical key in order.\n97\t  almanac_loop_record_set \"$file\" \"id=r1\" \"type=ralph\" \"status=running\"\n98\t\n99\t  keys=\"$(cut -f1 \"$file\")\"\n100\t  expected=\"$(almanac_loop_record_fields)\"\n101\t  assert_eq \"$expected\" \"$keys\" \"a fresh record must carry every canonical key in order\"\n102\t  assert_eq \"r1\" \"$(almanac_loop_record_get \"$file\" id)\" \"supplied id must be set\"\n103\t  assert_eq \"ralph\" \"$(almanac_loop_record_get \"$file\" type)\" \"supplied type must be set\"\n104\t  assert_eq \"running\" \"$(almanac_loop_record_get \"$file\" status)\" \"supplied status must be set\"\n105\t  assert_eq \"\" \"$(almanac_loop_record_get \"$file\" summary)\" \"an unsupplied field must be present but blank\"\n106\t  echo \"  PASS: record_set initialises the full canonical key set\"\n107\t}\n108\t\n109\ttest_record_set_round_trips_untouched_fields() {\n110\t  local tmp file\n111\t  new_tmpdir; tmp=\"$NEW_TMPDIR\"; file=\"$tmp/status.tsv\"\n112\t\n113\t  almanac_loop_record_set \"$file\" \\\n114\t    \"id=r1\" \"type=harden\" \"target=src/app.js\" \"pid=42\" \"status=running\" \"started_at=T0\"\n115\t  # update only live progress\n116\t  almanac_loop_record_set \"$file\" \"round=3\" \"summary=lenses=security open-blocking=2\"\n117\t  # mark terminal\n118\t  almanac_loop_record_set \"$file\" \"status=done\" \"finished_at=T1\"\n119\t\n120\t  assert_eq \"r1\"         \"$(almanac_loop_record_get \"$file\" id)\"          \"id preserved across sets\"\n121\t  assert_eq \"harden\"     \"$(almanac_loop_record_get \"$file\" type)\"        \"type preserved\"\n122\t  assert_eq \"src/app.js\" \"$(almanac_loop_record_get \"$file\" target)\"      \"target preserved\"\n123\t  assert_eq \"42\"         \"$(almanac_loop_record_get \"$file\" pid)\"         \"pid preserved\"\n124\t  assert_eq \"T0\"         \"$(almanac_loop_record_get \"$file\" started_at)\"  \"started_at preserved\"\n125\t  assert_eq \"3\"          \"$(almanac_loop_record_get \"$file\" round)\"       \"round set\"\n126\t  assert_eq \"lenses=security open-blocking=2\" \\\n127\t    \"$(almanac_loop_record_get \"$file\" summary)\" \"a value containing '=' is preserved verbatim\"\n128\t  assert_eq \"