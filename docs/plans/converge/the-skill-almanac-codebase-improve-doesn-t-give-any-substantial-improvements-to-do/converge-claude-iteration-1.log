nds=3\" \"$out\" \"harden status_to_opts full round-trip\"\n\n  # Absent fields drop their key.\n  make_status_file \"$status_file\" target=src/foo.sh\n  out=\"$(almanac_loop_adapter_call harden status_to_opts \"$status_file\")\"\n  assert_eq \"target=src/foo.sh\" \"$out\" \"harden status_to_opts emits only present fields\"\n\n  rm -rf \"$tmpdir\"\n  echo \"  PASS: harden status_to_opts contract\"\n}\n\ntest_converge_status_to_opts_contract() {\n  local tmpdir status_file out\n  tmpdir=\"$(mktemp -d)\"\n  status_file=\"$tmpdir/status.tsv\"\n\n  # prompt-mode round-trip.\n  make_status_file \"$status_file\" \\\n    goal=\"ship it\" prompt=/almanac:codebase-improve \\\n    rounds=10 provider=claude model=opus effort=high \\\n    oversee=off oversee_every=3\n  out=\"$(almanac_loop_adapter_call converge status_to_opts \"$status_file\")\"\n  assert_eq \"goal=ship it\nprompt=/almanac:codebase-improve\nrounds=10\nprovider=claude\nmodel=opus\neffort=high\noversee=off\noversee_every=3\" \"$out\" \"converge status_to_opts prompt-mode round-trip\"\n\n  # exec-mode round-trip. The `exec` status field becomes `exec=...` in output\n  # (not `exec_cmd=`), matching the key new_run_argv consumes.\n  make_status_file \"$status_file\" goal=g exec=\"echo hi\"\n  out=\"$(almanac_loop_adapter_call converge status_to_opts \"$status_file\")\"\n  assert_eq \"goal=g\nexec=echo hi\" \"$out\" \"converge status_to_opts exec-mode minimal\"\n\n  # oversee=on must NOT emit `oversee=off`.\n  make_status_file \"$status_file\" goal=g prompt=p oversee=on\n  out=\"$(almanac_loop_adapter_call converge status_to_opts \"$status_file\")\"\n  case \"$out\" in\n    *\"oversee=off\"*) fail \"converge status_to_opts: oversee=on must NOT emit oversee=off\" ;;\n  esac\n\n  rm -rf \"$tmpdir\"\n  echo \"  PASS: converge status_to_opts contract\"\n}\n\necho \"=== Loop Seam Tests ===\"\ntest_discovery_lists_present_adapters\ntest_dispatch_rejects_unknown_verb\ntest_signal_file_control_contract\ntest_ralph_exec_argv_launch_contract\ntest_harden_exec_argv_launch_contract\ntest_converge_exec_argv_launch_contract\ntest_kv_get_picks_value\ntest_ralph_new_run_argv_contract\ntest_harden_new_run_argv_contract\ntest_converge_new_run_argv_contract\ntest_ralph_new_run_env_contract\ntest_harden_new_run_env_contract\ntest_converge_new_run_env_contract\ntest_ralph_status_to_opts_contract\ntest_harden_status_to_opts_contract\ntest_converge_status_to_opts_contract\n\necho \"All loop seam tests passed.\"","originalFile":"#!/usr/bin/env bash\n# test-loops.sh - loop-adapter seam tests (lib/loops.sh + lib/loops/*)\n#\n# Sources lib/loops.sh DIRECTLY (not through loop-core / the launcher) so the\n# seam's interface is its own test surface. The adapters are pure config (exec\n# argv composition + signal-file mapping), so nothing here calls a real runner —\n# exec_argv is asserted against a fake $ALMANAC_HOME, never executed.\n\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nsource \"$ROOT/lib/loops.sh\"\n# status_to_opts verbs read status.tsv via almanac_loop_status_field (run.sh).\nsource \"$ROOT/lib/run.sh\"\n\nfail() {\n  echo \"  FAIL: $1\" >&2\n  exit 1\n}\n\nassert_eq() {\n  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n}\n\n# Write a status.tsv blob for status_to_opts tests. Each remaining arg is a\n# `field=value` pair; emitted as `<field>\\t<value>\\n` so almanac_loop_status_field\n# reads it the same way real run-status records do. No schema validation — tests\n# stage exactly the fields the adapter under test reads.\nmake_status_file() {\n  local file=\"$1\"; shift\n  local pair field value\n  : > \"$file\"\n  for pair in \"$@\"; do\n    field=\"${pair%%=*}\"\n    value=\"${pair#*=}\"\n    printf '%s\\t%s\\n' \"$field\" \"$value\" >> \"$file\"\n  done\n}\n\ntest_discovery_lists_present_adapters() {\n  local list\n  list=\"$(almanac_loop_adapter_list)\"\n  case \"$list\" in *ralph*) ;; *) fail \"loop list should include the ralph adapter file\" ;; esac\n  case \"$list\" in *harden*) ;; *) fail \"loop list should include the harden adapter file\" ;; esac\n  case \"$list\" in *converge*) ;; *) fail \"loop list should include the converge adapter file\" ;; esac\n\n  almanac_loop_adapter_known ralph  || fail \"ralph must be a known loop\"\n  almanac_loop_adapter_known harden || fail \"harden must be a known loop\"\n  almanac_loop_adapter_known converge || fail \"converge must be a known loop\"\n  almanac_loop_adapter_known RALPH  || fail \"known must normalise case (RALPH -> ralph)\"\n  if almanac_loop_adapter_known bogus; then fail \"an undiscovered name must not be known\"; fi\n  echo \"  PASS: discovery lists present adapters\"\n}\n\ntest_dispatch_rejects_unknown_verb() {\n  local rc=0\n  almanac_loop_adapter_call ralph no_such_verb >/dev/null 2>&1 || rc=$?\n  assert_eq 2 \"$rc\" \"dispatch should return 2 for a verb the adapter does not implement\"\n  echo \"  PASS: dispatch rejects an unimplemented verb\"\n}\n\ntest_signal_file_control_contract() {\n  # The control contract is the resolved signal-file (adapter override OR default\n  # convention from lib/loops.sh). Adapters that follow the standard\n  # `.${name}-${kind}` pattern need not define signal_file at all — the default\n  # provides it. Test at the public resolver, not the adapter, so deleting the\n  # three identical adapter functions doesn't break this surface.\n  assert_eq \".ralph-stop\"   \"$(almanac_loop_signal_file ralph stop)\"   \"ralph stop file basename\"\n  assert_eq \".ralph-steer\"  \"$(almanac_loop_signal_file ralph steer)\"  \"ralph steer file basename\"\n  assert_eq \".harden-stop\"  \"$(almanac_loop_signal_file harden stop)\"  \"harden stop file basename\"\n  assert_eq \".harden-steer\" \"$(almanac_loop_signal_file harden steer)\" \"harden steer file basename\"\n  assert_eq \".converge-stop\" \"$(almanac_loop_signal_file converge stop)\" \"converge stop file basename\"\n  assert_eq \".converge-steer\" \"$(almanac_loop_signal_file converge steer)\" \"converge steer file basename\"\n\n  local rc=0\n  almanac_loop_signal_file ralph bogus >/dev/null 2>&1 || rc=$?\n  [ \"$rc\" -ne 0 ] || fail \"an unknown signal kind should be rejected\"\n\n  rc=0\n  almanac_loop_signal_file bogus stop >/dev/null 2>&1 || rc=$?\n  [ \"$rc\" -ne 0 ] || fail \"an unknown loop name should be rejected\"\n\n  # The default applies to a hypothetical new loop without writing a single\n  # signal_file function — this is the deepening claim under test.\n  assert_eq \".future-stop\"  \"$(almanac_loop_default_signal_file future stop)\"  \"default signal file applies to any loop name\"\n  assert_eq \".future-steer\" \"$(almanac_loop_default_signal_file future steer)\" \"default signal file applies to any loop name\"\n  echo \"  PASS: signal_file control contract\"\n}\n\ntest_ralph_exec_argv_launch_contract() {\n  local ALMANAC_HOME=\"/fake/home\"\n\n  almanac_loop_adapter_call ralph exec_argv once \"demo-prd\"\n  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/once.sh demo-prd\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph once exec argv\"\n\n  almanac_loop_adapter_call ralph exec_argv afk \"demo-prd\" \"7\"\n  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/afk.sh demo-prd 7\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph afk exec argv\"\n\n  local rc=0\n  almanac_loop_adapter_call ralph exec_argv bogus \"demo-prd\" >/dev/null 2>&1 || rc=$?\n  assert_eq 2 \"$rc\" \"an unknown ralph mode should be rejected\"\n  echo \"  PASS: ralph exec_argv launch contract\"\n}\n\ntest_harden_exec_argv_launch_contract() {\n  local ALMANAC_HOME=\"/fake/home\"\n\n  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\"\n  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (no rounds)\"\n\n  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\" \"3\"\n  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop --rounds 3\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (with rounds)\"\n  echo \"  PASS: harden exec_argv launch contract\"\n}\n\ntest_converge_exec_argv_launch_contract() {\n  local ALMANAC_HOME=\"/fake/home\"\n  local rc\n\n  # Minimum exec-mode: goal + exec\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (exec-mode goal + action)\"\n\n  # Minimum prompt-mode: goal + prompt\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"prompt\" \"/almanac:codebase-improve\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --prompt /almanac:codebase-improve\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (prompt-mode goal + action)\"\n\n  # With rounds (4th positional)\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --rounds 5\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with rounds)\"\n\n  # With --no-oversee (5th positional, non-empty + non-\"0\" enables)\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\" \"1\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --rounds 5 --no-oversee\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with --no-oversee)\"\n\n  # An empty no_oversee or \"0\" must NOT emit the flag\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\" \"\"\n  case \" ${_ALMANAC_LOOP_ARGV[*]} \" in\n    *\" --no-oversee \"*) fail \"empty no_oversee must NOT emit --no-oversee\" ;;\n  esac\n\n  # With --oversee-every (6th positional)\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"\" \"\" \"3\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --oversee-every 3\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with --oversee-every)\"\n\n  # Unknown mode returns 2\n  rc=0; almanac_loop_adapter_call converge exec_argv \"ship it\" \"bogus\" \"x\" >/dev/null 2>&1 || rc=$?\n  assert_eq \"2\" \"$rc\" \"converge exec_argv must return 2 for an unknown mode\"\n\n  echo \"  PASS: converge exec_argv launch contract\"\n}\n\ntest_kv_get_picks_value() {\n  assert_eq \"auth-system\" \"$(_almanac_loop_kv_get prd prd=auth-system mode=afk)\" \"kv_get picks the matching value\"\n  assert_eq \"afk\"         \"$(_almanac_loop_kv_get mode prd=auth-system mode=afk)\" \"kv_get scans every pair\"\n  assert_eq \"\"            \"$(_almanac_loop_kv_get missing prd=auth-system)\"      \"kv_get echoes empty for an absent key\"\n  assert_eq \"\"            \"$(_almanac_loop_kv_get prd)\"                          \"kv_get echoes empty with no pairs\"\n  # A value that contains `=` round-trips (e.g. converge --exec foo=bar).\n  assert_eq \"echo foo=bar\" \"$(_almanac_loop_kv_get exec \"exec=echo foo=bar\")\"    \"kv_get preserves '=' in values\"\n  # Last pair wins (matches the case-statement semantics the loops used inline).\n  assert_eq \"second\" \"$(_almanac_loop_kv_get k k=first k=second)\" \"kv_get: later pair wins\"\n  echo \"  PASS: _almanac_loop_kv_get\"\n}\n\necho \"=== Loop Seam Tests ===\"\ntest_discovery_lists_present_adapters\ntest_dispatch_rejects_unknown_verb\ntest_signal_file_control_contract\ntest_ralph_exec_argv_launch_contract\ntest_harden_exec_argv_launch_contract\ntest_converge_exec_argv_launch_contract\ntest_kv_get_picks_value\n\necho \"All loop seam tests passed.\"\n","structuredPatch":[{"oldStart":172,"oldLines":6,"newStart":172,"newLines":252,"lines":["   echo \"  PASS: _almanac_loop_kv_get\""," }"," ","+test_ralph_new_run_argv_contract() {","+  local out rc=0","+","+  # Happy path: every key set. Each token on its own line.","+  out=\"$(almanac_loop_adapter_call ralph new_run_argv \\","+    prd=auth-system mode=afk provider=claude model=opus effort=high \\","+    iterations=7 oversee=off)\"","+  assert_eq \"ralph","+--prd","+auth-system","+--mode","+afk","+--provider","+claude","+--model","+opus","+--effort","+high","+--iterations","+7","+--no-oversee\" \"$out\" \"ralph new_run_argv full set\"","+","+  # Minimal: only prd → only the prd flag is emitted.","+  out=\"$(almanac_loop_adapter_call ralph new_run_argv prd=demo)\"","+  assert_eq \"ralph","+--prd","+demo\" \"$out\" \"ralph new_run_argv with only prd\"","+","+  # Missing prd returns 2 (the only required field).","+  rc=0; almanac_loop_adapter_call ralph new_run_argv mode=once >/dev/null 2>&1 || rc=$?","+  assert_eq 2 \"$rc\" \"ralph new_run_argv must reject missing prd\"","+","+  # oversee values other than \"off\" must NOT emit --no-oversee.","+  out=\"$(almanac_loop_adapter_call ralph new_run_argv prd=demo oversee=on)\"","+  case \" $out \" in","+    *\" --no-oversee \"*) fail \"ralph new_run_argv: oversee=on must NOT emit --no-oversee\" ;;","+  esac","+  echo \"  PASS: ralph new_run_argv contract\"","+}","+","+test_harden_new_run_argv_contract() {","+  local out rc=0","+","+  # Happy path: target + rounds.","+  out=\"$(almanac_loop_adapter_call harden new_run_argv target=src/foo.sh rounds=3)\"","+  assert_eq \"harden","+src/foo.sh","+--loop","+--rounds","+3\" \"$out\" \"harden new_run_argv with rounds\"","+","+  # Minimal: only target.","+  out=\"$(almanac_loop_adapter_call harden new_run_argv target=src/foo.sh)\"","+  assert_eq \"harden","+src/foo.sh","+--loop\" \"$out\" \"harden new_run_argv minimal\"","+","+  # Missing target returns 2.","+  rc=0; almanac_loop_adapter_call harden new_run_argv rounds=5 >/dev/null 2>&1 || rc=$?","+  assert_eq 2 \"$rc\" \"harden new_run_argv must reject missing target\"","+  echo \"  PASS: harden new_run_argv contract\"","+}","+","+test_converge_new_run_argv_contract() {","+  local out rc=0","+","+  # Happy path: goal + prompt + rounds + oversee + oversee_every.","+  out=\"$(almanac_loop_adapter_call converge new_run_argv \\","+    goal=\"ship it\" prompt=/almanac:codebase-improve \\","+    rounds=10 oversee=off oversee_every=3)\"","+  assert_eq \"converge","+--goal","+ship it","+--prompt","+/almanac:codebase-improve","+--rounds","+10","+--no-oversee","+--oversee-every","+3\" \"$out\" \"converge new_run_argv prompt-mode full set\"","+","+  # exec-mode: --exec replaces --prompt.","+  out=\"$(almanac_loop_adapter_call converge new_run_argv goal=\"ship it\" exec=\"echo hi\")\"","+  assert_eq \"converge","+--goal","+ship it","+--exec","+echo hi\" \"$out\" \"converge new_run_argv exec-mode minimal\"","+","+  # Missing goal returns 2.","+  rc=0; almanac_loop_adapter_call converge new_run_argv prompt=x >/dev/null 2>&1 || rc=$?","+  assert_eq 2 \"$rc\" \"converge new_run_argv must reject missing goal\"","+","+  # Neither prompt nor exec returns 2.","+  rc=0; almanac_loop_adapter_call converge new_run_argv goal=g >/dev/null 2>&1 || rc=$?","+  assert_eq 2 \"$rc\" \"converge new_run_argv must reject missing prompt/exec\"","+","+  # Mutex: both prompt + exec returns 2 (composer never produces malformed).","+  rc=0; almanac_loop_adapter_call converge new_run_argv goal=g prompt=p exec=e >/dev/null 2>&1 || rc=$?","+  assert_eq 2 \"$rc\" \"converge new_run_argv must reject prompt+exec mutex\"","+  echo \"  PASS: converge new_run_argv contract\"","+}","+","+test_ralph_new_run_env_contract() {","+  # ralph rides entirely on argv — env is empty by construction.","+  local out","+  out=\"$(almanac_loop_adapter_call ralph new_run_env \\","+    provider=claude model=opus effort=high)\"","+  assert_eq \"\" \"$out\" \"ralph new_run_env must be empty by construction\"","+  echo \"  PASS: ralph new_run_env contract\"","+}","+","+test_harden_new_run_env_contract() {","+  local out","+  out=\"$(almanac_loop_adapter_call harden new_run_env \\","+    lenses=\"correctness,security\" provider=claude model=opus effort=high)\"","+  assert_eq \"HARDEN_LENSES=correctness,security","+HARDEN_PROVIDER=claude","+HARDEN_MODEL=opus","+HARDEN_EFFORT=high\" \"$out\" \"harden new_run_env full set\"","+","+  # Empty fields drop their key entirely.","+  out=\"$(almanac_loop_adapter_call harden new_run_env provider=claude)\"","+  assert_eq \"HARDEN_PROVIDER=claude\" \"$out\" \"harden new_run_env emits only set fields\"","+","+  # All-empty input yields no output.","+  out=\"$(almanac_loop_adapter_call harden new_run_env)\"","+  assert_eq \"\" \"$out\" \"harden new_run_env empty input yields empty output\"","+  echo \"  PASS: harden new_run_env contract\"","+}","+","+test_converge_new_run_env_contract() {","+  local out","+  out=\"$(almanac_loop_adapter_call converge new_run_env \\","+    provider=claude model=opus effort=high)\"","+  assert_eq \"CONVERGE_PROVIDER=claude","+CONVERGE_MODEL=opus","+CONVERGE_EFFORT=high\" \"$out\" \"converge new_run_env full set\"","+","+  out=\"$(almanac_loop_adapter_call converge new_run_env model=opus)\"","+  assert_eq \"CONVERGE_MODEL=opus\" \"$out\" \"converge new_run_env emits only set fields\"","+  echo \"  PASS: converge new_run_env contract\"","+}","+","+test_ralph_status_to_opts_contract() {","+  local tmpdir status_file out","+  tmpdir=\"$(mktemp -d)\"","+  status_file=\"$tmpdir/status.tsv\"","+","+  # Happy path (afk mode): iterations recorded → mode=afk + iterations=N.","+  # target=docs/plans/auth-system/prd.md → prd derived from basename(dirname).","+  make_status_file \"$status_file\" \\","+    target=docs/plans/auth-system/prd.md \\","+    iterations=12 provider=claude model=opus effort=high oversee=off","+  out=\"$(almanac_loop_adapter_call ralph status_to_opts \"$status_file\")\"","+  assert_eq \"prd=auth-system","+mode=afk","+iterations=12","+provider=claude","+model=opus","+effort=high","+oversee=off\" \"$out\" \"ralph status_to_opts afk-mode round-trip\"","+","+  # once-mode: no iterations recorded → mode=once, no iterations line.","+  make_status_file \"$status_file\" \\","+    target=docs/plans/demo/prd.md provider=claude","+  out=\"$(almanac_loop_adapter_call ralph status_to_opts \"$status_file\")\"","+  assert_eq \"prd=demo","+mode=once","+provider=claude\" \"$out\" \"ralph status_to_opts once-mode minimal\"","+","+  # oversee=on must NOT emit `oversee=off` (only `off` round-trips, matching the","+  # adapter's argv composer which only honours \"off\").","+  make_status_file \"$status_file\" target=docs/plans/demo/prd.md oversee=on","+  out=\"$(almanac_loop_adapter_call ralph status_to_opts \"$status_file\")\"","+  case \"$out\" in","+    *\"oversee=off\"*) fail \"ralph status_to_opts: oversee=on must NOT emit oversee=off\" ;;","+  esac","+","+  rm -rf \"$tmpdir\"","+  echo \"  PASS: ralph status_to_opts contract\"","+}","+","+test_harden_status_to_opts_contract() {","+  local tmpdir status_file out","+  tmpdir=\"$(mktemp -d)\"","+  status_file=\"$tmpdir/status.tsv\"","+","+  make_status_file \"$status_file\" \\","+    target=src/foo.sh lenses=\"correctness,security\" \\","+    provider=claude model=opus effort=high rounds=3","+  out=\"$(almanac_loop_adapter_call harden status_to_opts \"$status_file\")\"","+  assert_eq \"target=src/foo.sh","+lenses=correctness,security","+provider=claude","+model=opus","+effort=high","+rounds=3\" \"$out\" \"harden status_to_opts full round-trip\"","+","+  # Absent fields drop their key.","+  make_status_file \"$status_file\" target=src/foo.sh","+  out=\"$(almanac_loop_adapter_call harden status_to_opts \"$status_file\")\"","+  assert_eq \"target=src/foo.sh\" \"$out\" \"harden status_to_opts emits only present fields\"","+","+  rm -rf \"$tmpdir\"","+  echo \"  PASS: harden status_to_opts contract\"","+}","+","+test_converge_status_to_opts_contract() {","+  local tmpdir status_file out","+  tmpdir=\"$(mktemp -d)\"","+  status_file=\"$tmpdir/status.tsv\"","+","+  # prompt-mode round-trip.","+  make_status_file \"$status_file\" \\","+    goal=\"ship