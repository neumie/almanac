{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Am2vbj2jEf7BLyiX16w524","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/agent.sh — the agent/provider seam.\n3\t#\n4\t# Per the module map, lib/agent.sh owns \"the three shapes + provider dispatch\".\n5\t# Two layers live here:\n6\t#   1. The provider-adapter seam (loop-engine-split slice 03): discovery of\n7\t#      lib/providers/<name>.sh, contract dispatch (callers never branch on a\n8\t#      provider name), and the single default-selection policy.\n9\t#   2. The three agent-run shapes (slice 04): almanac_loop_agent_capture /\n10\t#      _stream / _raw — intention-revealing replacements for the old\n11\t#      mode-parametric almanac_loop_agent_run. Each takes only what its shape\n12\t#      needs (no invalid mode combinations to guard); they consume the adapter's\n13\t#      argv + filter and own ONLY execution mechanics (exec, capture, stream,\n14\t#      PIPESTATUS exit threading).\n15\t#\n16\t# Self-contained: the seam uses only printf / command -v / source. The run shapes\n17\t# add jq / tee / grep / mktemp (coreutils) and emit diagnostics through _error\n18\t# when a caller has sourced lib/core.sh, falling back to a plain stderr line\n19\t# otherwise (_almanac_agent_err) — so there is still no hard dependency on\n20\t# lib/core.sh and any caller (or test) can source this file directly. Provider\n21\t# adapters are auto-loaded at source time (almanac_provider_load below).\n22\t\n23\t__almanac_agent_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t\n25\t# Normalise a provider name to its adapter key (lowercase; claude-code → claude).\n26\talmanac_provider_key() {\n27\t  local k\n28\t  k=\"$(printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]')\"\n29\t  case \"$k\" in\n30\t    claude-code) k=\"claude\" ;;\n31\t  esac\n32\t  printf '%s' \"$k\"\n33\t}\n34\t\n35\t# Source every provider adapter (idempotent — adapters only define functions).\n36\talmanac_provider_load() {\n37\t  local f\n38\t  for f in \"$__almanac_agent_dir\"/providers/*.sh; do\n39\t    [ -f \"$f\" ] || continue\n40\t    # shellcheck source=/dev/null\n41\t    source \"$f\"\n42\t  done\n43\t  return 0\n44\t}\n45\t\n46\t# List discovered provider names — the provider list IS the files present, so\n47\t# there is no second place to update. Sorted by the glob (alphabetical).\n48\talmanac_provider_list() {\n49\t  local f name\n50\t  for f in \"$__almanac_agent_dir\"/providers/*.sh; do\n51\t    [ -f \"$f\" ] || continue\n52\t    name=\"$(basename \"$f\" .sh)\"\n53\t    printf '%s\\n' \"$name\"\n54\t  done\n55\t  return 0\n56\t}\n57\t\n58\t# Is NAME a discovered provider?\n59\talmanac_provider_known() {\n60\t  local want target\n61\t  want=\"$(almanac_provider_key \"$1\")\"\n62\t  while IFS= read -r target; do\n63\t    [ \"$target\" = \"$want\" ] && return 0\n64\t  done <<EOF\n65\t$(almanac_provider_list)\n66\tEOF\n67\t  return 1\n68\t}\n69\t\n70\t# Dispatch a contract verb to NAME's adapter: almanac_provider_call <name> <verb>\n71\t# [args…]. Returns 2 if the adapter doesn't implement the verb. This is the one\n72\t# place that turns (provider, verb) into a function call, so no caller anywhere\n73\t# branches on provider name.\n74\talmanac_provider_call() {\n75\t  local key verb fn\n76\t  key=\"$(almanac_provider_key \"$1\")\"\n77\t  verb=\"$2\"\n78\t  shift 2\n79\t  fn=\"almanac_provider_${key}_${verb}\"\n80\t  declare -F \"$fn\" >/dev/null 2>&1 || return 2\n81\t  \"$fn\" \"$@\"\n82\t}\n83\t\n84\t# Thin public wrappers over the contract verbs.\n85\talmanac_provider_available()  { almanac_provider_call \"$1\" available; }\n86\talmanac_provider_active_env() { almanac_provider_call \"$1\" active_env; }\n87\talmanac_provider_models()     { almanac_provider_call \"$1\" models; }\n88\talmanac_provider_efforts()    { almanac_provider_call \"$1\" efforts; }\n89\talmanac_provider_display()    { almanac_provider_call \"$1\" display; }\n90\talmanac_provider_filter()     { almanac_provider_call \"$1\" filter; }\n91\t# argv populates the global _ALMANAC_AGENT_ARGV; callers use almanac_provider_call\n92\t# \"<name>\" argv <model> <effort> <sandbox> <result_file> <shape> directly.\n93\t\n94\t# The single central default-selection policy (the one provider remainder that is\n95\t# not in an adapter, by design): the active-env provider if it is installed, else\n96\t# the first installed provider in preference order (claude → codex). Echoes the\n97\t# chosen name, or \"\" if no provider is installed.\n98\talmanac_provider_default() {\n99\t  local p\n100\t  # Phase 1 — the provider whose resumable session we are inside.\n101\t  for p in $(almanac_provider_list); do\n102\t    if almanac_provider_active_env \"$p\" && almanac_provider_available \"$p\"; then\n103\t      printf '%s\\n' \"$p\"\n104\t      return 0\n105\t    fi\n106\t  done\n107\t  # Phase 2 — preference order.\n108\t  for p in claude codex; do\n109\t    if almanac_provider_available \"$p\"; then\n110\t      printf '%s\\n' \"$p\"\n111\t      return 0\n112\t    fi\n113\t  done\n114\t  printf '%s\\n' \"\"\n115\t  return 0\n116\t}\n117\t\n118\t# --- Agent run shapes ----------------------------------------------------------\n119\t#\n120\t# Three intention-revealing shapes replace the old mode-parametric agent_run. The\n121\t# common quartet (provider, model, effort, sandbox) comes from role config; the\n122\t# provider adapter supplies the exec argv + event filter (deep invocation), and\n123\t# these own only execution mechanics. There are no invalid mode combinations to\n124\t# guard because each shape takes only the args it needs.\n125\t\n126\t# Diagnostics: prefer lib/core.sh's _error when a caller sourced it (real runs all\n127\t# do), so the message is byte-identical; else a plain stderr line. Keeps the seam\n128\t# sourceable standalone (tests) without a hard core.sh dependency.\n129\t_almanac_agent_err() {\n130\t  if declare -F _error >/dev/null 2>&1; then\n131\t    _error \"$@\"\n132\t  else\n133\t    printf '[error] %s\\n' \"$*\" >&2\n134\t  fi\n135\t}\n136\t\n137\t# Run a provider command, optionally merging its stderr into stdout (2>&1) when\n138\t# $1 is \"1\". The producer at the head of the stream pipeline so the merge toggles\n139\t# without duplicating the pipeline. Its exit is the provider's, so PIPESTATUS[0]\n140\t# in the calling pipeline reflects the producer, not this wrapper.\n141\talmanac_loop_agent_producer() {\n142\t  local merge=\"$1\"; shift\n143\t  if [ \"$merge\" = \"1\" ]; then\n144\t    \"$@\" 2>&1\n145\t  else\n146\t    \"$@\"\n147\t  fi\n148\t}\n149\t\n150\t# Private: validate the provider is known + on PATH, then build its exec argv for\n151\t# SHAPE into _ALMANAC_AGENT_ARGV. Returns 3/4 (with a diagnostic) on an unknown/\n152\t# unavailable provider; 0 with the argv ready otherwise. The single place the\n153\t# shapes turn (provider, model, effort, sandbox) into exec tokens — no shape\n154\t# contains a `codex …`/`claude …` literal.\n155\t_almanac_agent_build() {\n156\t  local provider=\"$1\" model=\"$2\" effort=\"$3\" sandbox=\"$4\" result_file=\"$5\" shape=\"$6\"\n157\t  almanac_provider_known \"$provider\"     || { _almanac_agent_err \"unsupported provider: $provider\"; return 3; }\n158\t  almanac_provider_available \"$provider\" || { _almanac_agent_err \"provider '$provider' is not on PATH.\"; return 4; }\n159\t  almanac_provider_call \"$provider\" argv \"$model\" \"$effort\" \"${sandbox:-danger-full-access}\" \"$result_file\" \"$shape\"\n160\t}\n161\t\n162\t# Private: providers that don't write their result via argv (claude) implement an\n163\t# *_extract hook that recovers it from the captured stream; codex writes it\n164\t# directly via --output-last-message and declares none. A no-op for the latter.\n165\t_almanac_agent_extract() {\n166\t  local key; key=\"$(almanac_provider_key \"$1\")\"\n167\t  local stream_file=\"$2\" result_file=\"$3\"\n168\t  if declare -F \"almanac_provider_${key}_extract\" >/dev/null 2>&1; then\n169\t    \"almanac_provider_${key}_extract\" \"$stream_file\" \"$result_file\"\n170\t  fi\n171\t  return 0\n172\t}\n173\t\n174\t# capture: run the provider silently, capturing the raw event stream to\n175\t# EVENTS_FILE and (for adapters with an extract hook) the final result to\n176\t# RESULT_FILE. No stdout — the harden fan-out / ratify / fixer and ralph's\n177\t# overseer all discard it. A direct redirect (no pipe) keeps $? as the provider's\n178\t# exit so a failure propagates.\n179\t# Usage: almanac_loop_agent_capture <provider> <model> <effort> <sandbox> \\\n180\t#                                   <prompt_file> <result_file> <events_file>\n181\talmanac_loop_agent_capture() {\n182\t  [ \"$#\" -ge 7 ] || return 2\n183\t  local provider=\"$1\" model=\"$2\" effort=\"$3\" sandbox=\"$4\"\n184\t  local prompt_file=\"$5\" result_file=\"$6\" events_file=\"$7\"\n185\t  local prompt\n186\t  [ -n \"$provider\" ] || return 2\n187\t  [ -f \"$prompt_file\" ] || return 2\n188\t  [ -n \"$events_file\" ] || return 2\n189\t\n190\t  _almanac_agent_build \"$provider\" \"$model\" \"$effort\" \"$sandbox\" \"$result_file\" \"structured\" || return\n191\t  local cmd=(\"${_ALMANAC_AGENT_ARGV[@]}\")\n192\t  prompt=\"$(cat \"$prompt_file\")\"\n193\t\n194\t  \"${cmd[@]}\" \"$prompt\" > \"$events_file\" || return \"$?\"\n195\t  _almanac_agent_extract \"$provider\" \"$events_file\" \"$result_file\"\n196\t}\n197\t\n198\t# stream: run the provider live — tee its raw event stream to EVENTS_FILE AND pipe\n199\t# it through the adapter's jq filter to stdout, so the caller sees progress as it\n200\t# happens. The PRODUCER's exit wins via PIPESTATUS (a provider failure propagates\n201\t# even though it is piped), not the jq filter's; errexit is suspended around the\n202\t# pipeline (a no-match filter must not abort a set -e caller) and restored after.\n203\t# The `grep '^{'` prefilter keeps only JSON-object lines (the events FILE is the\n204\t# raw tee, unaffected); degrades to a raw tee when jq is absent or the adapter\n205\t# yields no filter, so output is never silently dropped. Optional MERGE_STDERR\n206\t# (merge-stderr|on|1) folds the provider's stderr into the captured/streamed\n207\t# output — preserving ralph's `codex ... 2>&1 | tee` log capture; default leaves\n208\t# stderr on the terminal. The events-file path is NOT echoed (it would corrupt\n209\t# the live stream); the caller passes its own path and already knows it.\n210\t# Usage: almanac_loop_agent_stream <provider> <model> <effort> <sandbox> \\\n211\t#                          <prompt_file> <result_file> <events_file> [merge_stderr]\n212\talmanac_loop_agent_stream() {\n213\t  [ \"$#\" -ge 7 ] || return 2\n214\t  local provider=\"$1\" model=\"$2\" effort=\"$3\" sandbox=\"$4\"\n215\t  local prompt_file=\"$5\" result_file=\"$6\" events_file=\"$7\" merge_stderr=\"${8:-}\"\n216\t  local prompt filter rc had_e=0 merge=0\n217\t  [ -n \"$provider\" ] || return 2\n218\t  [ -f \"$prompt_file\" ] || return 2\n219\t  [ -n \"$events_file\" ] || return 2\n220\t  case \"$merge_stderr\" in\n221\t    merge-stderr|stderr|on|1) merge=1 ;;\n222\t  esac\n223\t\n224\t  _almanac_agent_build \"$provider\" \"$model\" \"$effort\" \"$sandbox\" \"$result_file\" \"structured\" || return\n225\t  local cmd=(\"${_ALMANAC_AGENT_ARGV[@]}\")\n226\t  prompt=\"$(cat \"$prompt_file\")\"\n227\t  filter=\"$(almanac_provider_filter \"$provider\" 2>/dev/null)\" || filter=\"\"\n228\t\n229\t  case $- in *e*) had_e=1 ;; esac\n230\t  set +e\n231\t  if command -v jq >/dev/null 2>&1 && [ -n \"$filter\" ]; then\n232\t    almanac_loop_agent_producer \"$merge\" \"${cmd[@]}\" \"$prompt\" | tee \"$events_file\" | grep --line-buffered '^{' \\\n233\t      | jq -Rj --unbuffered \"fromjson? // empty | objects | ( $filter )\"\n234\t  else\n235\t    almanac_loop_agent_producer \"$merge\" \"${cmd[@]}\" \"$prompt\" | tee \"$events_file\"\n236\t  fi\n237\t  rc=${PIPESTATUS[0]}\n238\t  [ \"$had_e\" -eq 1 ] && set -e\n239\t  [ \"$rc\" -eq 0 ] || return \"$rc\"\n240\t\n241\t  _almanac_agent_extract \"$provider\" \"$events_file\" \"$result_file\"\n242\t  return 0\n243\t}\n244\t\n245\t# raw: native passthrough for adapters that declare *_supports_raw (codex omits\n246\t# --json so its native output streams straight to the terminal — no jq filter, no\n247\t# events capture). The direct exec keeps $? as the provider's exit. A provider\n248\t# WITHOUT raw support degrades to a silent capture into a throwaway events log, so\n249\t# output is never dropped (matching the old agent_run raw fallback).\n250\t# Usage: almanac_loop_agent_raw <provider> <model> <effort> <sandbox> \\\n251\t#                               <prompt_file> <result_file>\n252\talmanac_loop_agent_raw() {\n253\t  [ \"$#\" -ge 6 ] || return 2\n254\t  local provider=\"$1\" model=\"$2\" effort=\"$3\" sandbox=\"$4\"\n255\t  local prompt_file=\"$5\" result_file=\"$6\"\n256\t  local key prompt events_file\n257\t  [ -n \"$provider\" ] || return 2\n258\t  [ -f \"$prompt_file\" ] || return 2\n259\t\n260\t  key=\"$(almanac_provider_key \"$provider\")\"\n261\t  if ! declare -F \"almanac_provider_${key}_supports_raw\" >/dev/null 2>&1; then\n262\t    events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-loop-events.XXXXXX\")\"\n263\t    almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"$sandbox\" \\\n264\t      \"$prompt_file\" \"$result_file\" \"$events_file\"\n265\t    return \"$?\"\n266\t  fi\n267\t\n268\t  _almanac_agent_build \"$provider\" \"$model\" \"$effort\" \"$sandbox\" \"$result_file\" \"raw\" || return\n269\t  local cmd=(\"${_ALMANAC_AGENT_ARGV[@]}\")\n270\t  prompt=\"$(cat \"$prompt_file\")\"\n271\t\n272\t  # No --json, no filter, no events capture: native output to the terminal. codex\n273\t  # writes its result via --output-last-message, so no extract step is needed.\n274\t  \"${cmd[@]}\" \"$prompt\" || return \"$?\"\n275\t  return 0\n276\t}\n277\t\n278\talmanac_provider_load\n279\t"}]},"parent_tool_use_id":"toolu_01KWKuqF1TnfvvxHA8r3pjMp","session_id":"6fd584a8-5bee-4020-89ec-8c8806d40fbd","uuid":"7c6b6c63-ad05-4a4d-b20b-d75d3492e2aa","timestamp":"2026-05-27T06:44:14.841Z","subagent_type":"Explore","task_description":"Codebase friction audit"}
