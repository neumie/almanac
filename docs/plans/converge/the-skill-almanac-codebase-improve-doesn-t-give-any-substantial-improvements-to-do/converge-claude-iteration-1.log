{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Riy5zwfCpYiX1VeaQsryyr","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# worker.sh — worker orchestration (background fan-out).\n3\t#\n4\t# Per CONTEXT.md's module map, this owns the WRITE/spawn side of a run's workers:\n5\t# write/mark a worker's status.tsv, spawn a provider run in the background\n6\t# (almanac_loop_worker_start — the fan-out), and stream one worker's live event\n7\t# log (almanac_loop_worker_watch). harden's reviewer/fixer fan-out is the\n8\t# consumer; the run-level registry, the worker PATH helpers + the worker-health\n9\t# read views live in lib/run.sh (this is the orchestration layer on top of them).\n10\t#\n11\t# Dependencies (sourced idempotently): lib/core.sh (_warn + the _almanac_source_sibling\n12\t# helper used below), lib/run.sh (worker path helpers + almanac_loop_status_field +\n13\t# almanac_loop_now_utc), lib/agent.sh (the capture shape the spawned worker runs).\n14\t# core.sh loads first via the literal snippet so the sibling helper is in scope.\n15\tif ! declare -F _warn >/dev/null 2>&1; then\n16\t  __worker_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n17\t  # shellcheck source=lib/core.sh\n18\t  source \"$__worker_dir/core.sh\"\n19\t  unset __worker_dir\n20\tfi\n21\t\n22\t_almanac_source_sibling run.sh   almanac_loop_worker_status_file\n23\t_almanac_source_sibling agent.sh almanac_loop_agent_capture\n24\t\n25\t# THE single source of truth for the worker-status schema: the canonical field\n26\t# list in write order. Mirrors run.sh's almanac_loop_record_fields; the generic\n27\t# almanac_loop_tsv_record_set engine iterates this list so every worker record\n28\t# carries the same keys regardless of which subset a caller supplies.\n29\talmanac_loop_worker_record_fields() {\n30\t  printf '%s\\n' \\\n31\t    id run_id pid provider model effort sandbox \\\n32\t    prompt_file events_file result_file stderr_file \\\n33\t    started_at status finished_at exit_code\n34\t}\n35\t\n36\t# Set one or more worker-status fields by name, round-tripping the rest. Thin\n37\t# wrapper over the shared tsv-record engine — callers name only the fields they\n38\t# have values for; the rest are preserved (or seeded blank on first write). No\n39\t# caller enumerates the worker schema.\n40\talmanac_loop_worker_record_set() {\n41\t  almanac_loop_tsv_record_set \"$(almanac_loop_worker_record_fields)\" \"$@\"\n42\t}\n43\t\n44\talmanac_loop_mark_worker_status() {\n45\t  [ \"$#\" -ge 5 ] || return 2\n46\t\n47\t  local root=\"$1\"\n48\t  local run_id=\"$2\"\n49\t  local worker_id=\"$3\"\n50\t  local status=\"$4\"\n51\t  local exit_code=\"$5\"\n52\t  local finished_at=\"${6:-}\"\n53\t  local status_file\n54\t\n55\t  case \"$status\" in\n56\t    done|failed) ;;\n57\t    *) return 3 ;;\n58\t  esac\n59\t\n60\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n61\t  [ -f \"$status_file\" ] || return 2\n62\t\n63\t  if [ -z \"$finished_at\" ]; then\n64\t    finished_at=\"$(almanac_loop_now_utc)\"\n65\t  fi\n66\t\n67\t  almanac_loop_worker_record_set \"$status_file\" \\\n68\t    \"status=$status\" \\\n69\t    \"finished_at=$finished_at\" \\\n70\t    \"exit_code=$exit_code\"\n71\t}\n72\t\n73\talmanac_loop_worker_start() {\n74\t  [ \"$#\" -ge 8 ] || return 2\n75\t\n76\t  local root=\"$1\"\n77\t  local run_id=\"$2\"\n78\t  local worker_id=\"$3\"\n79\t  local provider=\"$4\"\n80\t  local model=\"$5\"\n81\t  local effort=\"$6\"\n82\t  local sandbox=\"$7\"\n83\t  local prompt_file=\"$8\"\n84\t  local started_at=\"${9:-}\"\n85\t  local worker_dir status_file events_file result_file stderr_file worker_pid\n86\t\n87\t  [ -n \"$root\" ] || return 2\n88\t  [ -n \"$run_id\" ] || return 2\n89\t  [ -n \"$worker_id\" ] || return 2\n90\t  [ -n \"$provider\" ] || return 2\n91\t  [ -f \"$prompt_file\" ] || return 2\n92\t\n93\t  if [ -z \"$started_at\" ]; then\n94\t    started_at=\"$(almanac_loop_now_utc)\"\n95\t  fi\n96\t\n97\t  worker_dir=\"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\"\n98\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n99\t  events_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"events.jsonl\")\"\n100\t  result_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"result.txt\")\""}]},"parent_tool_use_id":"toolu_01KWKuqF1TnfvvxHA8r3pjMp","session_id":"6fd584a8-5bee-4020-89ec-8c8806d40fbd","uuid":"1a9a70d6-e8d8-44f9-8b82-157145774224","timestamp":"2026-05-27T06:44:24.684Z","subagent_type":"Explore","task_description":"Codebase friction audit"}
