{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GiiHtgT7p5UAjzCgQmdFcu","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# converge.sh - Run a generic convergence loop\n3\t\n4\tset -euo pipefail\n5\t\n6\tsource \"$ALMANAC_HOME/lib/converge-core.sh\"\n7\t\n8\tusage() {\n9\t  printf '%s\\n' \"Usage: almanac converge --goal <goal> (--prompt <text> | --exec <command>) [--rounds N] [--no-oversee] [--oversee-every N]\"\n10\t  printf '%s\\n' \"       almanac converge <slug> [--watch|--stop]\"\n11\t  printf '%s\\n' \"\"\n12\t  printf '%s\\n' \"  --prompt <text>  Prompt sent to the configured provider agent each round.\"\n13\t  printf '%s\\n' \"                   The dominant mode: pass a slash command (e.g. '/almanac:codebase-improve'),\"\n14\t  printf '%s\\n' \"                   a chain ('/foo. After that, /bar'), or free-form text.\"\n15\t  printf '%s\\n' \"  --exec <cmd>     Shell command run by a wrapping worker agent each round.\"\n16\t  printf '%s\\n' \"                   Power-user escape hatch for non-agent workflows.\"\n17\t  printf '%s\\n' \"  Exactly one of --prompt or --exec is required.\"\n18\t}\n19\t\n20\tGOAL=\"\"\n21\tEXEC_CMD=\"\"\n22\tPROMPT=\"\"\n23\tROUNDS=\"${CONVERGE_ROUND_BUDGET:-10}\"\n24\tNO_OVERSEE=0\n25\tOVERSEE_EVERY=\"${CONVERGE_OVERSEE_EVERY:-1}\"\n26\tTARGET_SLUG=\"\"\n27\tWATCH=0\n28\tSTOP=0\n29\t\n30\twhile [ \"$#\" -gt 0 ]; do\n31\t  case \"$1\" in\n32\t    -h|--help)\n33\t      usage\n34\t      exit 0\n35\t      ;;\n36\t    --goal)\n37\t      shift\n38\t      [ \"$#\" -gt 0 ] || {\n39\t        usage >&2\n40\t        _die \"Missing value for --goal\"\n41\t      }\n42\t      GOAL=\"$1\"\n43\t      ;;\n44\t    --exec)\n45\t      shift\n46\t      [ \"$#\" -gt 0 ] || {\n47\t        usage >&2\n48\t        _die \"Missing value for --exec\"\n49\t      }\n50\t      EXEC_CMD=\"$1\"\n51\t      ;;\n52\t    --prompt)\n53\t      shift\n54\t      [ \"$#\" -gt 0 ] || {\n55\t        usage >&2\n56\t        _die \"Missing value for --prompt\"\n57\t      }\n58\t      PROMPT=\"$1\"\n59\t      ;;\n60\t    --rounds)\n61\t      shift\n62\t      [ \"$#\" -gt 0 ] || {\n63\t        usage >&2\n64\t        _die \"Missing value for --rounds\"\n65\t      }\n66\t      ROUNDS=\"$1\"\n67\t      ;;\n68\t    --no-oversee)\n69\t      NO_OVERSEE=1\n70\t      ;;\n71\t    --oversee-every)\n72\t      shift\n73\t      [ \"$#\" -gt 0 ] || {\n74\t        usage >&2\n75\t        _die \"Missing value for --oversee-every\"\n76\t      }\n77\t      OVERSEE_EVERY=\"$1\"\n78\t      ;;\n79\t    --watch)\n80\t      WATCH=1\n81\t      ;;\n82\t    --stop)\n83\t      STOP=1\n84\t      ;;\n85\t    --)\n86\t      shift\n87\t      break\n88\t      ;;\n89\t    -*)\n90\t      usage >&2\n91\t      _die \"Unknown converge option: $1\"\n92\t      ;;\n93\t    *)\n94\t      [ -z \"$TARGET_SLUG\" ] || {\n95\t        usage >&2\n96\t        _die \"Unexpected converge argument: $1\"\n97\t      }\n98\t      TARGET_SLUG=\"$1\"\n99\t      ;;\n100\t  esac\n101\t  shift\n102\tdone\n103\t\n104\t[ \"$WATCH\" -eq 0 ] || [ \"$STOP\" -eq 0 ] || _die \"Choose only one of --watch or --stop\"\n105\t\n106\tif [ -n \"$TARGET_SLUG\" ]; then\n107\t  [ -z \"$GOAL\" ] || _die \"Cannot combine converge slug with --goal\"\n108\t  [ -z \"$EXEC_CMD\" ] || _die \"Cannot combine converge slug with --exec\"\n109\t  [ -z \"$PROMPT\" ] || _die \"Cannot combine converge slug with --prompt\"\n110\t\n111\t  if [ \"$STOP\" -eq 1 ]; then\n112\t    almanac_converge_stop \"$PWD\" \"$TARGET_SLUG\" || _die \"Unknown converge run: $TARGET_SLUG\"\n113\t    _success \"Stop requested for converge: $TARGET_SLUG\"\n114\t    exit 0\n115\t  fi\n116\t\n117\t  if [ \"$WATCH\" -eq 1 ]; then\n118\t    almanac_converge_watch \"$PWD\" \"$TARGET_SLUG\" follow || _die \"Unknown converge run: $TARGET_SLUG\"\n119\t    exit 0\n120\t  fi\n121\t\n122\t  almanac_converge_status \"$PWD\" \"$TARGET_SLUG\" || _die \"Unknown converge run: $TARGET_SLUG\"\n123\t  exit 0\n124\tfi\n125\t\n126\t[ \"