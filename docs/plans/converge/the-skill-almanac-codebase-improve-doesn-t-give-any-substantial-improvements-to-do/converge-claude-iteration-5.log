{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XS39u93zH5297SEqY7DrUv","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops.sh — the loop-adapter seam (discovery + dispatch).\n3\t#\n4\t# Mirrors the provider-adapter seam (lib/agent.sh): each loop (ralph, harden) is a\n5\t# drop-in adapter file at lib/loops/<name>.sh answering one fixed question set, so\n6\t# no central code branches on a loop type. This module owns discovery (the loop\n7\t# list IS the files present), name-normalising dispatch (the one place a loop type\n8\t# becomes a function call), and auto-loads the adapters at source time.\n9\t#\n10\t# Each adapter (called as almanac_loop_<name>_<verb>) declares two contracts:\n11\t#   launch  — exec_argv: how to exec its runner (config in, _ALMANAC_LOOP_ARGV out)\n12\t#             — consumed by the launcher (lib/loop-launcher.sh)\n13\t#   control — signal_file <stop|steer>: its between-round dot-file basename.\n14\t#             Optional override — almanac_loop_default_signal_file (below) handles\n15\t#             the standard `.${name}-${kind}` convention every loop uses today, so\n16\t#             adapters only define this if their convention diverges. Resolved\n17\t#             through almanac_loop_signal_file (consumed by lib/run.sh control).\n18\t#\n19\t# Self-contained: uses only printf / tr / basename / source — no lib/core.sh\n20\t# dependency — so the seam (and the adapters) are their own test surface and\n21\t# tests/test-loops.sh sources this file directly.\n22\t\n23\t__almanac_loops_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t\n25\t# Normalise a loop name to its adapter key (lowercase).\n26\talmanac_loop_adapter_key() {\n27\t  printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]'\n28\t}\n29\t\n30\t# Source every loop adapter (idempotent — adapters only define functions).\n31\talmanac_loop_adapter_load() {\n32\t  local f\n33\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n34\t    [ -f \"$f\" ] || continue\n35\t    # shellcheck source=/dev/null\n36\t    source \"$f\"\n37\t  done\n38\t  return 0\n39\t}\n40\t\n41\t# List discovered loop names — the loop list IS the files present, so there is no\n42\t# second place to update. Sorted by the glob (alphabetical).\n43\talmanac_loop_adapter_list() {\n44\t  local f name\n45\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n46\t    [ -f \"$f\" ] || continue\n47\t    name=\"$(basename \"$f\" .sh)\"\n48\t    printf '%s\\n' \"$name\"\n49\t  done\n50\t  return 0\n51\t}\n52\t\n53\t# Is NAME a discovered loop?\n54\talmanac_loop_adapter_known() {\n55\t  local want target\n56\t  want=\"$(almanac_loop_adapter_key \"$1\")\"\n57\t  while IFS= read -r target; do\n58\t    [ \"$target\" = \"$want\" ] && return 0\n59\t  done <<EOF\n60\t$(almanac_loop_adapter_list)\n61\tEOF\n62\t  return 1\n63\t}\n64\t\n65\t# Dispatch a contract verb to NAME's adapter: almanac_loop_adapter_call <name>\n66\t# <verb> [args…]. Returns 2 if the adapter doesn't implement the verb. This is the\n67\t# one place that turns (loop, verb) into a function call, so no caller branches on\n68\t# loop type.\n69\talmanac_loop_adapter_call() {\n70\t  local key verb fn\n71\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n72\t  verb=\"$2\"\n73\t  shift 2\n74\t  fn=\"almanac_loop_${key}_${verb}\"\n75\t  declare -F \"$fn\" >/dev/null 2>&1 || return 2\n76\t  \"$fn\" \"$@\"\n77\t}\n78\t\n79\t# Look up the value for KEY in a stream of `key=value` PAIRS (the lingua franca\n80\t# the hub speaks to a loop adapter's new_run_argv / new_run_env verbs). Echoes\n81\t# the value (which may itself contain `=`, e.g. `--prompt /foo bar=baz`) and\n82\t# returns 0; echoes nothing when KEY is absent. Later pairs win, matching the\n83\t# `case \"$key\" in foo) v=\"$val\" ;; esac` semantics each adapter used to inline.\n84\t# Lives in the loop-adapter seam (lib/loops.sh) because every adapter's\n85\t# composer is its only caller — keeps the lookup pattern in one place so a\n86\t# fourth loop is a single-file addition instead of a fourth copy of the loop.\n87\t_almanac_loop_kv_get() {\n88\t  local want=\"$1\"; shift\n89\t  local pair value=\"\"\n90\t  for pair in \"$@\"; do\n91\t    case \"$pair\" in\n92\t      \"$want=\"*) value=\"${pair#*=}\" ;;\n93\t    esac\n94\t  done\n95\t  printf '%s\\n' \"$value\"\n96\t}\n97\t\n98\t# Default signal-file basename for a loop's between-round control. Every loop uses\n99\t# the same `.${name}-${kind}` convention (`.ralph-stop`, `.harden-steer`, …) so the\n100\t# pattern lives once here instead of being copy-pasted into each adapter. A loop\n101\t# only needs to define its own `signal_file` if its convention diverges; this is\n102\t# the deepening that turns three identical stop|steer case-statements into none.\n103\t# Returns 1 for an unknown kind.\n104\talmanac_loop_default_signal_file() {\n105\t  local name=\"$1\" kind=\"$2\"\n106\t  case \"$kind\" in\n107\t    stop|steer) printf '.%s-%s\\n' \"$name\" \"$kind\" ;;\n108\t    *) return 1 ;;\n109\t  esac\n110\t}\n111\t\n112\t# Resolve a loop's signal-file basename: the adapter's override if it defines\n113\t# `signal_file`, else the standard `.${name}-${kind}` default. This is the\n114\t# control-contract public surface — callers (lib/run.sh, harden-core, converge-core)\n115\t# go through here instead of dispatching to the adapter directly, so adding a new\n116\t# loop costs zero signal_file code unless the loop is non-standard. Returns 1 for\n117\t# an unknown kind or an unknown loop name.\n118\talmanac_loop_signal_file() {\n119\t  local key fn\n120\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n121\t  almanac_loop_adapter_known \"$key\" || return 1\n122\t  fn=\"almanac_loop_${key}_signal_file\"\n123\t  if declare -F \"$fn\" >/dev/null 2>&1; then\n124\t    \"$fn\" \"$2\"\n125\t  else\n126\t    almanac_loop_default_signal_file \"$key\" \"$2\"\n127\t  fi\n128\t}\n129\t\n130\talmanac_loop_adapter_load\n131\t"}]},"parent_tool_use_id":"toolu_01ED8HbuxfqtYZgMa4GKptqQ","session_id":"39778425-941f-49ab-8330-34f036939f47","uuid":"e2b4ffbc-26cd-4a6d-885b-2aaab2036e6f","timestamp":"2026-05-27T07:50:07.435Z","subagent_type":"Explore","task_description":"Walk almanac codebase for friction"}
