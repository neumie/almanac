{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014eoJKTF1rz7PgrFmKuFY2Y","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# worker.sh — worker orchestration (background fan-out).\n3\t#\n4\t# Per CONTEXT.md's module map, this owns the WRITE/spawn side of a run's workers:\n5\t# write/mark a worker's status.tsv, spawn a provider run in the background\n6\t# (almanac_loop_worker_start — the fan-out), and stream one worker's live event\n7\t# log (almanac_loop_worker_watch). harden's reviewer/fixer fan-out is the\n8\t# consumer; the run-level registry, the worker PATH helpers + the worker-health\n9\t# read views live in lib/run.sh (this is the orchestration layer on top of them).\n10\t#\n11\t# Dependencies (sourced idempotently): lib/core.sh (_warn + the _almanac_source_sibling\n12\t# helper used below), lib/run.sh (worker path helpers + almanac_loop_status_field +\n13\t# almanac_loop_now_utc), lib/agent.sh (the capture shape the spawned worker runs).\n14\t# core.sh loads first via the literal snippet so the sibling helper is in scope.\n15\tif ! declare -F _warn >/dev/null 2>&1; then\n16\t  __worker_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n17\t  # shellcheck source=lib/core.sh\n18\t  source \"$__worker_dir/core.sh\"\n19\t  unset __worker_dir\n20\tfi\n21\t\n22\t_almanac_source_sibling run.sh   almanac_loop_worker_status_file\n23\t_almanac_source_sibling agent.sh almanac_loop_agent_capture\n24\t\n25\t# THE single source of truth for the worker-status schema: the canonical field\n26\t# list in write order. Mirrors run.sh's almanac_loop_record_fields; the generic\n27\t# almanac_loop_tsv_record_set engine iterates this list so every worker record\n28\t# carries the same keys regardless of which subset a caller supplies.\n29\talmanac_loop_worker_record_fields() {\n30\t  printf '%s\\n' \\\n31\t    id run_id pid provider model effort sandbox \\\n32\t    prompt_file events_file result_file stderr_file \\\n33\t    started_at status finished_at exit_code\n34\t}\n35\t\n36\t# Set one or more worker-status fields by name, round-tripping the rest. Thin\n37\t# wrapper over the shared tsv-record engine — callers name only the fields they\n38\t# have values for; the rest are preserved (or seeded blank on first write). No\n39\t# caller enumerates the worker schema.\n40\talmanac_loop_worker_record_set() {\n41\t  almanac_loop_tsv_record_set \"$(almanac_loop_worker_record_fields)\" \"$@\"\n42\t}\n43\t\n44\talmanac_loop_mark_worker_status() {\n45\t  [ \"$#\" -ge 5 ] || return 2\n46\t\n47\t  local root=\"$1\"\n48\t  local run_id=\"$2\"\n49\t  local worker_id=\"$3\"\n50\t  local status=\"$4\"\n51\t  local exit_code=\"$5\"\n52\t  local finished_at=\"${6:-}\"\n53\t  local status_file\n54\t\n55\t  case \"$status\" in\n56\t    done|failed) ;;\n57\t    *) return 3 ;;\n58\t  esac\n59\t\n60\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n61\t  [ -f \"$status_file\" ] || return 2\n62\t\n63\t  if [ -z \"$finished_at\" ]; then\n64\t    finished_at=\"$(almanac_loop_now_utc)\"\n65\t  fi\n66\t\n67\t  almanac_loop_worker_record_set \"$status_file\" \\\n68\t    \"status=$status\" \\\n69\t    \"finished_at=$finished_at\" \\\n70\t    \"exit_code=$exit_code\"\n71\t}\n72\t\n73\talmanac_loop_worker_start() {\n74\t  [ \"$#\" -ge 8 ] || return 2\n75\t\n76\t  local root=\"$1\"\n77\t  local run_id=\"$2\"\n78\t  local worker_id=\"$3\"\n79\t  local provider=\"$4\"\n80\t  local model=\"$5\"\n81\t  local effort=\"$6\"\n82\t  local sandbox=\"$7\"\n83\t  local prompt_file=\"$8\"\n84\t  local started_at=\"${9:-}\"\n85\t  local worker_dir status_file events_file result_file stderr_file worker_pid\n86\t\n87\t  [ -n \"$root\" ] || return 2\n88\t  [ -n \"$run_id\" ] || return 2\n89\t  [ -n \"$worker_id\" ] || return 2\n90\t  [ -n \"$provider\" ] || return 2\n91\t  [ -f \"$prompt_file\" ] || return 2\n92\t\n93\t  if [ -z \"$started_at\" ]; then\n94\t    started_at=\"$(almanac_loop_now_utc)\"\n95\t  fi\n96\t\n97\t  worker_dir=\"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\"\n98\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n99\t  events_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"events.jsonl\")\"\n100\t  result_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"result.txt\")\"\n101\t  stderr_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"stderr.log\")\"\n102\t\n103\t  if [ -e \"$worker_dir\" ]; then\n104\t    return 3\n105\t  fi\n106\t\n107\t  mkdir -p \"$worker_dir\"\n108\t\n109\t  (\n110\t    local status exit_code\n111\t\n112\t    while [ ! -f \"$status_file\" ]; do\n113\t      sleep 0.05\n114\t    done\n115\t\n116\t    if almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"$sandbox\" \"$prompt_file\" \"$result_file\" \"$events_file\" 2> \"$stderr_file\"; then\n117\t      status=\"done\"\n118\t      exit_code=0\n119\t    else\n120\t      exit_code=\"$?\"\n121\t      status=\"failed\"\n122\t    fi\n123\t\n124\t    almanac_loop_mark_worker_status \"$root\" \"$run_id\" \"$worker_id\" \"$status\" \"$exit_code\" >/dev/null\n125\t    exit \"$exit_code\"\n126\t  ) &\n127\t  worker_pid=\"$!\"\n128\t\n129\t  almanac_loop_worker_record_set \"$status_file\" \\\n130\t    \"id=$worker_id\" \\\n131\t    \"run_id=$run_id\" \\\n132\t    \"pid=$worker_pid\" \\\n133\t    \"provider=$provider\" \\\n134\t    \"model=$model\" \\\n135\t    \"effort=$effort\" \\\n136\t    \"sandbox=${sandbox:-danger-full-access}\" \\\n137\t    \"prompt_file=$prompt_file\" \\\n138\t    \"events_file=$events_file\" \\\n139\t    \"result_file=$result_file\" \\\n140\t    \"stderr_file=$stderr_file\" \\\n141\t    \"started_at=$started_at\" \\\n142\t    \"status=running\"\n143\t\n144\t  printf '%s\\n' \"$worker_pid\"\n145\t}\n146\t\n147\t# Stream one worker's live event log (events.jsonl) so an operator can watch what\n148\t# a single reviewer/fixer is doing. Reads the worker's events-file path from its\n149\t# status.tsv (falling back to the conventional path), so it works regardless of\n150\t# where the runner allocated the log. With follow=\"follow\" on a TTY it tails the\n151\t# log live (-f); otherwise it prints the current contents once and returns, so\n152\t# tests, pipes, and non-interactive callers never block. Returns 1 (and warns)\n153\t# when the worker has produced no event log yet.\n154\talmanac_loop_worker_watch() {\n155\t  local root=\"$1\"\n156\t  local run_id=\"$2\"\n157\t  local worker_id=\"$3\"\n158\t  local follow=\"${4:-}\"\n159\t  local status_file events_file=\"\"\n160\t\n161\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n162\t  if [ -f \"$status_file\" ]; then\n163\t    events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n164\t  fi\n165\t  [ -n \"$events_file\" ] || events_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"events.jsonl\")\"\n166\t\n167\t  if [ ! -f \"$events_file\" ]; then\n168\t    _warn \"No event stream for worker '$worker_id' in run '$run_id' yet.\"\n169\t    return 1\n170\t  fi\n171\t\n172\t  if [ \"$follow\" = \"follow\" ] && [ -t 1 ]; then\n173\t    tail -n +1 -f \"$events_file\"\n174\t  else\n175\t    cat \"$events_file\"\n176\t  fi\n177\t}\n178\t"}]},"parent_tool_use_id":"toolu_01ED8HbuxfqtYZgMa4GKptqQ","session_id":"39778425-941f-49ab-8330-34f036939f47","uuid":"0c9859ea-7d83-4159-857a-1c2ef925488e","timestamp":"2026-05-27T07:50:07.341Z","subagent_type":"Explore","task_description":"Walk almanac codebase for friction"}
