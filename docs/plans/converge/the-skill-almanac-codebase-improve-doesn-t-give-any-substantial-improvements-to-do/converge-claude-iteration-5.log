{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014W2j9Y5b2rrSgvkMMJhTYz","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# harden.sh - Bootstrap a harden-loop rubric for one target\n3\t\n4\tset -euo pipefail\n5\t\n6\tsource \"$ALMANAC_HOME/lib/harden-core.sh\"\n7\t\n8\tusage() {\n9\t  printf '%s\\n' \"Usage:\"\n10\t  printf '%s\\n' \"  almanac harden <target>\"\n11\t  printf '%s\\n' \"  almanac harden <target> --goal <goal>\"\n12\t  printf '%s\\n' \"  almanac harden <target> --approve\"\n13\t  printf '%s\\n' \"  almanac harden <target> --fix\"\n14\t  printf '%s\\n' \"  almanac harden <target> --loop [--rounds N]\"\n15\t  printf '%s\\n' \"  almanac harden <target> --watch\"\n16\t  printf '%s\\n' \"  almanac harden <target> --watch-worker <lens|worker-id>\"\n17\t  printf '%s\\n' \"\"\n18\t  printf '%s\\n' \"With no flags, fans out one read-only reviewer per lens over the target,\"\n19\t  printf '%s\\n' \"aggregates their findings into the ledger, and prints them. Configure the\"\n20\t  printf '%s\\n' \"lens set via HARDEN_LENSES (comma- or space-separated; capped by HARDEN_MAX_REVIEWERS).\"\n21\t  printf '%s\\n' \"If a rubric has been drafted for the target, it must be approved first;\"\n22\t  printf '%s\\n' \"a target with no rubric runs ad-hoc.\"\n23\t  printf '%s\\n' \"With --goal, creates docs/plans/harden/<target-slug>/rubric.md in the repo.\"\n24\t  printf '%s\\n' \"With --approve, approves an edited draft rubric.\"\n25\t  printf '%s\\n' \"With --fix, runs one sequential write-capable fixer over the open blocking\"\n26\t  printf '%s\\n' \"findings, then runs the project feedback loops and reports a verdict per loop.\"\n27\t  printf '%s\\n' \"With --loop, runs the convergence loop (fan-out -> ratify -> fix -> feedback\"\n28\t  printf '%s\\n' \"-> gate) in rounds until it converges or the round budget is hit. Set the\"\n29\t  printf '%s\\n' \"budget with --rounds N (default 5, or HARDEN_ROUND_BUDGET). Between rounds a\"\n30\t  printf '%s\\n' \"HITL checkpoint lets you ship, continue, or steer — steering captures a\"\n31\t  printf '%s\\n' \"directive that redirects the next round's reviewers and fixer.\"\n32\t  printf '%s\\n' \"With --watch, redraws the live supervision dashboard for the target's most\"\n33\t  printf '%s\\n' \"recent run (reviewer health, findings tallies, rubric progress, verdict).\"\n34\t  printf '%s\\n' \"With --watch-worker, streams a single reviewer's live event log (pass a lens\"\n35\t  printf '%s\\n' \"like 'security' or a full worker id like 'reviewer-security').\"\n36\t}\n37\t\n38\tTARGET=\"\"\n39\tGOAL=\"\"\n40\tAPPROVE=0\n41\tFIX=0\n42\tLOOP=0\n43\tROUNDS=\"\"\n44\tWATCH=0\n45\tWATCH_WORKER=\"\"\n46\t\n47\twhile [ \"$#\" -gt 0 ]; do\n48\t  case \"$1\" in\n49\t    -h|--help)\n50\t      usage"}]},"parent_tool_use_id":"toolu_01ED8HbuxfqtYZgMa4GKptqQ","session_id":"39778425-941f-49ab-8330-34f036939f47","uuid":"322f6be4-df83-431b-b15d-7b908a400c82","timestamp":"2026-05-27T07:50:00.522Z","subagent_type":"Explore","task_description":"Walk almanac codebase for friction"}
