true)\"\n1606\t  lens_summary=\"$(almanac_harden_lenses | tr '\\n' ',' | sed 's/,$//' || true)\"\n1607\t  if [ -n \"$run_id\" ]; then\n1608\t    _info \"Run registered: $run_id\"\n1609\t    almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n1610\t      \"provider=${HARDEN_PROVIDER:-$cond_provider}\" \\\n1611\t      \"model=${HARDEN_MODEL:-$cond_model}\" \\\n1612\t      \"effort=${HARDEN_EFFORT:-$cond_effort}\" \\\n1613\t      \"lenses=$lens_summary\" \\\n1614\t      \"rounds=$budget\" >/dev/null 2>&1 || true\n1615\t    # Mark the run aborted on any unexpected exit (signal, mid-round _die) that\n1616\t    # leaves it still running; the normal exit paths below mark done/failed and\n1617\t    # clear this via almanac_harden_run_finalize. Bake $root/$run_id into the\n1618\t    # trap text at set-time via %q — bash uses dynamic scoping for trap\n1619\t    # expansion, and inner functions (e.g. almanac_harden_fanout) declare\n1620\t    # `local run_id` for their own bookkeeping; under `set -u`, _die exits from\n1621\t    # such a frame would resolve $run_id to the inner unset local, not this\n1622\t    # outer one, and bash would die on \"run_id: unbound variable\" before the\n1623\t    # finalize call ever runs.\n1624\t    local _harden_run_finalize_cmd\n1625\t    printf -v _harden_run_finalize_cmd 'almanac_harden_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n1626\t    trap \"${_harden_run_finalize_cmd}; exit 130\" INT TERM\n1627\t    trap \"${_harden_run_finalize_cmd}\" EXIT\n1628\t  fi\n1629\t\n1630\t  round=0\n1631\t  while :; do\n1632\t    if almanac_harden_consume_stop \"$root\"; then\n1633\t      _success \"Stop signal detected (.harden-stop); exiting before next round.\"\n1634\t      almanac_harden_run_finalize \"$root\" \"$run_id\" \"done\"\n1635\t      return 0\n1636\t    fi\n1637\t\n1638\t    steer_directive=\"$(almanac_harden_consume_steer \"$root\" || true)\"\n1639\t    if [ -n \"$steer_directive\" ]; then\n1640\t      directive=\"$steer_directive\"\n1641\t      _info \"Steering applied for the next round: $directive\"\n1642\t    fi\n1643\t\n1644\t    round=$((round + 1))\n1645\t    _info \"=== Harden round $round/$budget ===\"\n1646\t\n1647\t    almanac_harden_round \"$root\" \"$target\" \"$round\" \"$directive\" && round_rc=0 || round_rc=$?\n1648\t\n1649\t    open_rows=\"$(almanac_harden_ledger_open_blocking \"$ledger_path\")\"\n1650\t    if [ -n \"$open_rows\" ]; then\n1651\t      open_count=\"$(printf '%s\\n' \"$open_rows\" | grep -c '[^[:space:]]' || true)\"\n1652\t    else\n1653\t      open_count=0\n1654\t    fi\n1655\t\n1656\t    # Update the registry's live run-status blob so the hub/dashboard reflect the\n1657\t    # current round and a lens/open-blocking summary as the loop advances.\n1658\t    if [ -n \"$run_id\" ]; then\n1659\t      almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \\\n1660\t        \"lenses=$lens_summary open-blocking=$open_count\" >/dev/null 2>&1 || true\n1661\t    fi\n1662\t\n1663\t    # Report this round's kill-list (the blocking findings still open after the\n1664\t    # round) — the HITL view of what remains to harden.\n1665\t    almanac_harden_print_killlist \"$open_rows\"\n1666\t\n1667\t    # Acceptance for the gate = the round's feedback loops are green AND every\n1668\t    # rubric acceptance criterion is checked off (vacuously true for ad-hoc runs).\n1669\t    acc=0\n1670\t    if [ \"$round_rc\" -eq 0 ] && almanac_harden_acceptance_met \"$rubric_path\"; then\n1671\t      acc=1\n1672\t    fi\n1673\t\n1674\t    verdict=\"$(almanac_harden_gate_verdict \"$acc\" \"$open_count\" \"$round\" \"$budget\")\" && rc=0 || rc=$?\n1675\t    if [ \"$acc\" -eq 1 ]; then acc_label=\"met\"; else acc_label=\"unmet\"; fi\n1676\t    _info \"Verdict: $verdict (round $round/$budget, open-blocking=$open_count, acceptance=$acc_label)\"\n1677\t\n1678\t    case \"$rc\" in\n1679\t      0)\n1680\t        _success \"Converged after $round round(s): acceptance met and no open blocking findings remain.\"\n1681\t        almanac_harden_run_finalize \"$root\" \"$run_id\" \"done\"\n1682\t        return 0\n1683\t        ;;\n1684\t      2)\n1685\t        _warn \"Round budget ($budget) reached — $open_count open blocking finding(s) remain. Status: NON-CONVERGED.\"\n1686\t        almanac_harden_run_finalize \"$root\" \"$run_id\" \"failed\"\n1687\t        return 1\n1688\t        ;;\n1689\t      *)\n1690\t        # HITL checkpoint: continue, ship, or steer. A steer (rc 2) echoes the\n1691\t        # new directive on stdout; capture it and thread it into the next round.\n1692\t        steer_directive=\"$(almanac_harden_hitl_checkpoint)\" && hitl_rc=0 || hitl_rc=$?\n1693\t        case \"$hitl_rc\" in\n1694\t          2)\n1695\t            directive=\"$steer_directive\"\n1696\t            if [ -n \"$directive\" ]; then\n1697\t              _info \"Steering applied for the next round: $directive\"\n1698\t            else\n1699\t              _info \"Steering directive cleared for the next round.\"\n1700\t            fi\n1701\t            continue\n1702\t            ;;\n1703\t          0)\n1704\t            continue\n1705\t            ;;\n1706\t          *)\n1707\t            _success \"Shipping at round $round by request — $open_count open blocking finding(s) left unaddressed.\"\n1708\t            almanac_harden_run_finalize \"$root\" \"$run_id\" \"done\"\n1709\t            return 0\n1710\t            ;;\n1711\t        esac\n1712\t        ;;\n1713\t    esac\n1714\t  done\n1715\t}\n1716\t\n1717\t# --- Supervision dashboard -----------------------------------------------------\n1718\t#\n1719\t# A gum-styled redraw dashboard for supervising a harden run: reviewer status (per\n1720\t# lens, with health), the round, findings tallies, rubric progress, and the\n1721\t# feedback verdict. The render LOGIC is pure (almanac_harden_dashboard_rows: state\n1722\t# -> printable rows) so it is unit-testable without a terminal; the gather helpers\n1723\t# read live run state into 