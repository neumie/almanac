{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011zkErqxDqhBmb7tj2h2kaZ","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/agent.sh — the agent/provider seam.\n3\t#\n4\t# Per the module map, lib/agent.sh owns \"the three shapes + provider dispatch\".\n5\t# Two layers live here:\n6\t#   1. The provider-adapter seam (loop-engine-split slice 03): discovery of\n7\t#      lib/providers/<name>.sh, contract dispatch (callers never branch on a\n8\t#      provider name), and the single default-selection policy.\n9\t#   2. The three agent-run shapes (slice 04): almanac_loop_agent_capture /\n10\t#      _stream / _raw — intention-revealing replacements for the old\n11\t#      mode-parametric almanac_loop_agent_run. Each takes only what its shape\n12\t#      needs (no invalid mode combinations to guard); they consume the adapter's\n13\t#      argv + filter and own ONLY execution mechanics (exec, capture, stream,\n14\t#      PIPESTATUS exit threading).\n15\t#\n16\t# Self-contained: the seam uses only printf / command -v / source. The run shapes\n17\t# add jq / tee / grep / mktemp (coreutils) and emit diagnostics through _error\n18\t# when a caller has sourced lib/core.sh, falling back to a plain stderr line\n19\t# otherwise (_almanac_agent_err) — so there is still no hard dependency on\n20\t# lib/core.sh and any caller (or test) can source this file directly. Provider\n21\t# adapters are auto-loaded at source time (almanac_provider_load below).\n22\t\n23\t__almanac_agent_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t\n25\t# Normalise a provider name to its adapter key (lowercase; claude-code → claude).\n26\talmanac_provider_key() {\n27\t  local k\n28\t  k=\"$(printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]')\"\n29\t  case \"$k\" in\n30\t    claude-code) k=\"claude\" ;;\n31\t  esac\n32\t  printf '%s' \"$k\"\n33\t}\n34\t\n35\t# Source every provider adapter (idempotent — adapters only define functions).\n36\talmanac_provider_load() {\n37\t  local f\n38\t  for f in \"$__almanac_agent_dir\"/providers/*.sh; do\n39\t    [ -f \"$f\" ] || continue\n40\t    # shellcheck source=/dev/null\n41\t    source \"$f\"\n42\t  done\n43\t  return 0\n44\t}\n45\t\n46\t# List discovered provider names — the provider list IS the files present, so\n47\t# there is no second place to update. Sorted by the glob (alphabetical).\n48\talmanac_provider_list() {\n49\t  local f name\n50\t  for f in \"$__almanac_agent_dir\"/providers/*.sh; do\n51\t    [ -f \"$f\" ] || continue\n52\t    name=\"$(basename \"$f\" .sh)\"\n53\t    printf '%s\\n' \"$name\"\n54\t  done\n55\t  return 0\n56\t}\n57\t\n58\t# Is NAME a discovered provider?\n59\talmanac_provider_known() {\n60\t  local want target\n61\t  want=\"$(almanac_provider_key \"$1\")\"\n62\t  while IFS= read -r target; do\n63\t    [ \"$target\" = \"$want\" ] && return 0\n64\t  done <<EOF\n65\t$(almanac_provider_list)\n66\tEOF\n67\t  return 1\n68\t}\n69\t\n70\t# Dispatch a contract verb to NAME's adapter: almanac_provider_call <name> <verb>\n71\t# [args…]. Returns 2 if the adapter doesn't implement the verb. This is the one\n72\t# place that turns (provider, verb) into a function call, so no caller anywhere\n73\t# branches on provider name.\n74\talmanac_provider_call() {\n75\t  local key verb fn\n76\t  key=\"$(almanac_provider_key \"$1\")\"\n77\t  verb=\"$2\"\n78\t  shift 2\n79\t  fn=\"almanac_provider_${key}_${verb}\"\n80\t  declare -F \"$fn\" >/dev/null 2>&1 || return 2\n81\t  \"$fn\" \"$@\"\n82\t}\n83\t\n84\t# Thin public wrappers over the contract verbs.\n85\talmanac_provider_available()  { almanac_provider_call \"$1\" available; }\n86\talmanac_provider_active_env() { almanac_provider_call \"$1\" active_env; }\n87\talmanac_provider_models()     { almanac_provider_call \"$1\" models; }\n88\talmanac_provider_efforts()    { almanac_provider_call \"$1\" efforts; }\n89\talmanac_provider_display()    { almanac_provider_call \"$1\" display; }\n90\talmanac_provider_filter()     { almanac_provider_call \"$1\" filter; }\n91\t# argv populates the global _ALMANAC_AGENT_ARGV; callers use almanac_provider_call\n92\t# \"<name>\" argv <model> <effort> <sandbox> <result_file> <shape> directly.\n93\t\n94\t# The single central default-selection policy (the one provider remainder that is\n95\t# not in an adapter, by design): the active-env provider if it is installed, else\n96\t# the first installed provider in preference order (claude → codex). Echoes the\n97\t# chosen name, or \"\" if no provider is installed.\n98\talmanac_provider_default() {\n99\t  local p\n100\t  # Phase 1 — the provider whose resumable session we are inside."}]},"parent_tool_use_id":"toolu_01G1XmY5XvTbbUFYvBrgo6G5","session_id":"3ef28929-b60b-453b-bba1-b6ef6c6d207d","uuid":"a89924b5-2f95-4bf2-b60a-9d2daefb973d","timestamp":"2026-05-27T07:04:12.706Z","subagent_type":"Explore","task_description":"Codebase friction exploration"}
