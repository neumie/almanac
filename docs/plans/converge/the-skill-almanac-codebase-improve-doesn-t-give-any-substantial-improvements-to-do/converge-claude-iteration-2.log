   [ \"$target\" = \"$slug\" ] || continue\n    match=\"$id\"\n  done <<< \"$rows\"\n\n  [ -n \"$match\" ] || return 1\n  printf '%s\\n' \"$match\"\n}\n\nalmanac_converge_worker_health() {\n  local root=\"$1\"","numLines":80,"startLine":355,"totalLines":1060}}}
