{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015PG1gGvroM48cywQSQjPbv","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# loop-launcher.sh — the single almanac launcher (ralph + harden + converge).\n3\t#\n4\t# almanac_loop_launch <type> [native flags…] interactively configures and starts\n5\t# a loop run. It is loop-agnostic: one launcher for every consumer — `almanac\n6\t# ralph`, `almanac harden`, the hub's New-run flow, and the ralph skill launcher\n7\t# all route here, so the config UX is identical everywhere (the PRD's \"almanac\n8\t# launcher, not per-loop reimplementations\").\n9\t#\n10\t# Each loop's flag parsing, prompts, env-export, and runner exec live in its\n11\t# adapter (lib/loops/<name>.sh) as the `launch` verb, and its --help text as the\n12\t# `launch_usage` verb. The launcher dispatches via the loop-adapter seam — no\n13\t# central case-statement branches on loop type, so adding a 4th loop is a\n14\t# single new file in lib/loops/.\n15\t#\n16\t# The shared bits — field collectors (provider / choice / positive-int) and the\n17\t# summary panel — stay here because every adapter uses them identically. They\n18\t# are sourced once at launcher boot, so any adapter dispatched through\n19\t# `almanac_loop_launch` finds them in scope.\n20\t#\n21\t# Requires lib/core.sh (_die/_info/_success + _almanac_source_sibling), sourced\n22\t# by every entry point before this file. The deps below are each declared\n23\t# explicitly through the sibling helper so the launcher's seam dependencies\n24\t# aren't borrowed from whatever sourced this file.\n25\t_almanac_source_sibling ui.sh    almanac_loop_ui_choose       # gum-or-plain UI seam\n26\t_almanac_source_sibling agent.sh almanac_provider_default     # provider-adapter seam (availability/default)\n27\t_almanac_source_sibling loops.sh almanac_loop_adapter_call    # loop-adapter dispatch\n28\t\n29\t# --- field collectors ---------------------------------------------------------\n30\t#\n31\t# Used by every loop adapter's `launch` verb (lib/loops/<name>.sh::almanac_loop_<name>_launch).\n32\t# The underscore prefix signals \"private to the launching subsystem (this file +\n33\t# adapter launch verbs)\" — not for callers outside that path.\n34\t\n35\t# Pick a provider into the named-by-$1 variable if it is empty. Lists only\n36\t# installed providers (discovered via the seam); dies if none.\n37\t_almanac_launch_need_provider() {\n38\t  local var=\"$1\" current=\"${2:-}\" providers=() p chosen\n39\t  if [ -n \"$current\" ]; then printf '%s\\n' \"$current\"; return 0; fi\n40\t  for p in $(almanac_provider_list); do\n41\t    almanac_provider_available \"$p\" && providers+=(\"$p\")\n42\t  done\n43\t  [ \"${#providers[@]}\" -gt 0 ] || _die \"No supported provider found. Install Codex or Claude Code.\"\n44\t  if [ \"${#providers[@]}\" -eq 1 ]; then printf '%s\\n' \"${providers[0]}\"; return 0; fi\n45\t  chosen=\"$(almanac_loop_ui_choose \"Provider\" \"${providers[@]}\")\" || return 1\n46\t  printf '%s\\n' \"$chosen\"\n47\t}\n48\t\n49\t# Resolve a model/effort value: if empty, show the provider menu; map \"default\"\n50\t# to empty and \"custom\" to a free-text prompt. Echoes the resolved value.\n51\t_almanac_launch_need_choice() {\n52\t  local header=\"$1\" current=\"$2\" picked\n53\t  shift 2\n54\t  if [ -n \"$current\" ]; then\n55\t    [ \"$current\" = \"default\" ] && current=\"\"\n56\t    printf '%s\\n' \"$current\"; return 0\n57\t  fi\n58\t  picked=\"$(almanac_loop_ui_choose \"$header\" \"$@\")\" || return 1\n59\t  if [ \"$picked\" = \"custom\" ]; then\n60\t    picked=\"$(almanac_loop_ui_input \"$header (custom)\")\" || return 1\n61\t  fi\n62\t  [ \"$picked\" = \"default\" ] && picked=\"\"\n63\t  printf '%s\\n' \"$picked\"\n64\t}\n65\t\n66\t# Resolve a positive integer. A preset (flag) value is validated once and dies on\n67\t# failure; an interactive value re-prompts until valid. Echoes the integer.\n68\t_almanac_launch_need_positive_int() {\n69\t  local header=\"$1\" current=\"$2\" default=\"${3:-}\" reply\n70\t  if [ -n \"$current\" ]; then\n71\t    case \"$current\" in ''|*[!0-9]*) _die \"$header must be a positive integer (got: $current)\";; esac\n72\t    [ \"$current\" -gt 0 ] || _die \"$header must be a positive integer (got: $current)\"\n73\t    printf '%s\\n' \"$current\"; return 0\n74\t  fi\n75\t  while :; do\n76\t    reply=\"$(almanac_loop_ui_input \"$header\" \"$default\")\" || return 1\n77\t    case \"$reply\" in ''|*[!0-9]*) _warn \"Enter a positive integer.\" >&2; continue;; esac\n78\t    [ \"$reply\" -gt 0 ] && { printf '%s\\n' \"$reply\"; return 0; }\n79\t    _warn \"Enter a positive integer.\" >&2\n80\t  done\n81\t}\n82\t\n83\t# --- summary + dispatch --------------------------------------------------------\n84\t\n85\t# Render a \"LABEL:value\" config summary as a gum-styled (or plain) panel. Each\n86\t# remaining arg is one \"Field:value\" line. Presentation only.\n87\talmanac_loop_launch_summary() {\n88\t  local type=\"$1\"; shift\n89\t  local line\n90\t  {\n91\t    printf '%s\\n' \"$(printf '%s' \"$type\" | tr '[:lower:]' '[:upper:]') run\"\n92\t    printf '%s\\n' \"──────────────────\"\n93\t    for line in \"$@\"; do\n94\t      printf '  %-11s %s\\n' \"${line%%:*}\" \"${line#*:}\"\n95\t    done\n96\t  } | almanac_loop_ui_render >&2\n97\t}\n98\t\n99\t# Per-type usage, printed for --help. Goes to stderr (stdout stays capture-clean).\n100\t# Dispatched to the loop adapter's `launch_usage` verb — no central case-statement\n101\t# on loop type. Adding a new loop puts its usage text in lib/loops/<name>.sh\n102\t# alongside its launch verb. A missing adapter or missing verb is a no-op so\n103\t# `--help` for an unknown loop fails through to the launcher's usage error\n104\t# rather than crashing.\n105\talmanac_loop_launch_usage() {\n106\t  local type=\"${1:-}\"\n107\t  [ -n \"$type\" ] || return 0\n108\t  almanac_loop_adapter_known \"$type\" || return 0\n109\t  local fn\n110\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch_usage\"\n111\t  declare -F \"$fn\" >/dev/null 2>&1 && \"$fn\"\n112\t}\n113\t\n114\t# Public entry: configure and launch a run of TYPE (ralph|harden|converge|…).\n115\t# Remaining args are that type's native flags; missing fields are prompted by\n116\t# the adapter's `launch` verb, which also execs the runner. The launcher does\n117\t# not enumerate loop types — discovery is via the loop-adapter seam, so adding\n118\t# a new loop is a single new file in lib/loops/. We resolve the launch verb's\n119\t# function name and invoke it directly (rather than going through\n120\t# almanac_loop_adapter_call) so a missing verb is a hard die — the launch\n121\t# function itself may legitimately exit non-zero (user cancelled / validation\n122\t# error), and adapter_call's \"verb missing\" rc=2 would collide with those.\n123\talmanac_loop_launch() {\n124\t  local type=\"${1:-}\"; shift || true\n125\t  [ -n \"$type\" ] || _die \"Usage: almanac_loop_launch <loop> [options] (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n126\t  almanac_loop_adapter_known \"$type\" || _die \"Unknown loop type: $type (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n127\t  local fn\n128\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch\"\n129\t  declare -F \"$fn\" >/dev/null 2>&1 || _die \"Loop adapter '$type' does not implement the launch verb\"\n130\t  \"$fn\" \"$@\"\n131\t}\n132\t"}]},"parent_tool_use_id":"toolu_014CCc6VqTJsQ4tPs9wK42Z1","session_id":"8f5db91c-a278-450c-98f6-32d4d1454f5d","uuid":"c99c30d4-3ee5-4735-9094-432e754960c5","timestamp":"2026-05-27T07:58:49.795Z","subagent_type":"Explore","task_description":"Codebase architecture exploration"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RTx1MNUQVeXFL5zCpiFr4S","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops.sh — the loop-adapter seam (discovery + dispatch).\n3\t#\n4\t# Mirrors the provider-adapter seam (lib/agent.sh): each loop (ralph, harden) is a\n5\t# drop-in adapter file at lib/loops/<name>.sh answering one fixed question set, so\n6\t# no central code branches on a loop type. This module owns discovery (the loop\n7\t# list IS the files present), name-normalising dispatch (the one place a loop type\n8\t# becomes a function call), and auto-loads the adapters at source time.\n9\t#\n10\t# Each adapter (called as almanac_loop_<name>_<verb>) declares two contracts:\n11\t#   launch  — exec_argv: how to exec its runner (config in, _ALMANAC_LOOP_ARGV out)\n12\t#             — consumed by the launcher (lib/loop-launcher.sh)\n13\t#   control — signal_file <stop|steer>: its between-round dot-file basename.\n14\t#             Optional override — almanac_loop_default_signal_file (below) handles\n15\t#             the standard `.${name}-${kind}` convention every loop uses today, so\n16\t#             adapters only define this if their convention diverges. Resolved\n17\t#             through almanac_loop_signal_file (consumed by lib/run.sh control).\n18\t#\n19\t# Self-contained: uses only printf / tr / basename / source — no lib/core.sh\n20\t# dependency — so the seam (and the adapters) are their own test surface and\n21\t# tests/test-loops.sh sources this file directly.\n22\t\n23\t__almanac_loops_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t\n25\t# Normalise a loop name to its adapter key (lowercase).\n26\talmanac_loop_adapter_key() {\n27\t  printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]'\n28\t}\n29\t\n30\t# Source every loop adapter (idempotent — adapters only define functions).\n31\talmanac_loop_adapter_load() {\n32\t  local f\n33\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n34\t    [ -f \"$f\" ] || continue\n35\t    # shellcheck source=/dev/null\n36\t    source \"$f\"\n37\t  done\n38\t  return 0\n39\t}\n40\t\n41\t# List discovered loop names — the loop list IS the files present, so there is no\n42\t# second place to update. Sorted by the glob (alphabetical).\n43\talmanac_loop_adapter_list() {\n44\t  local f name\n45\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n46\t    [ -f \"$f\" ] || continue\n47\t    name=\"$(basename \"$f\" .sh)\"\n48\t    printf '%s\\n' \"$name\"\n49\t  done\n50\t  return 0\n51\t}\n52\t\n53\t# Is NAME a discovered loop?\n54\talmanac_loop_adapter_known() {\n55\t  local want target\n56\t  want=\"$(almanac_loop_adapter_key \"$1\")\"\n57\t  while IFS= read -r target; do\n58\t    [ \"$target\" = \"$want\" ] && return 0\n59\t  done <<EOF\n60\t$(almanac_loop_adapter_list)\n61\tEOF\n62\t  return 1\n63\t}\n64\t\n65\t# Dispatch a contract verb to NAME's adapter: almanac_loop_adapter_call <name>\n66\t# <verb> [args…]. Returns 2 if the adapter doesn't implement the verb. This is the\n67\t# one place that turns (loop, verb) into a function call, so no caller branches on\n68\t# loop type.\n69\talmanac_loop_adapter_call() {\n70\t  local key verb fn\n71\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n72\t  verb=\"$2\"\n73\t  shift 2\n74\t  fn=\"almanac_loop_${key}_${verb}\"\n75\t  declare -F \"$fn\" >/dev/null 2>&1 || return 2\n76\t  \"$fn\" \"$@\"\n77\t}\n78\t\n79\t# Look up the value for KEY in a stream of `key=value` PAIRS (the lingua franca\n80\t# the hub speaks to a loop adapter's new_run_argv / new_run_env verbs). Echoes\n81\t# the value (which may itself contain `=`, e.g. `--prompt /foo bar=baz`) and\n82\t# returns 0; echoes nothing when KEY is absent. Later pairs win, matching the\n83\t# `case \"$key\" in foo) v=\"$val\" ;; esac` semantics each adapter used to inline.\n84\t# Lives in the loop-adapter seam (lib/loops.sh) because every adapter's\n85\t# composer is its only caller — keeps the lookup pattern in one place so a\n86\t# fourth loop is a single-file addition instead of a fourth copy of the loop.\n87\t_almanac_loop_kv_get() {\n88\t  local want=\"$1\"; shift\n89\t  local pair value=\"\"\n90\t  for pair in \"$@\"; do\n91\t    case \"$pair\" in\n92\t      \"$want=\"*) value=\"${pair#*=}\" ;;\n93\t    esac\n94\t  done\n95\t  printf '%s\\n' \"$value\"\n96\t}\n97\t\n98\t# Default signal-file basename for a loop's between-round control. Every loop uses\n99\t# the same `.${name}-${kind}` convention (`.ralph-stop`, `.harden-steer`, …) so the\n100\t# pattern lives once here instead of being copy-pasted into each adapter. A loop\n101\t# only needs to define its own `signal_file` if its convention diverges; this is\n102\t# the deepening that turns three identical stop|steer case-statements into none.\n103\t# Returns 1 for an unknown kind.\n104\talmanac_loop_default_signal_file() {\n105\t  local name=\"$1\" kind=\"$2\"\n106\t  case \"$kind\" in\n107\t    stop|steer) printf '.%s-%s\\n' \"$name\" \"$kind\" ;;\n108\t    *) return 1 ;;\n109\t  esac\n110\t}\n111\t\n112\t# Resolve a loop's signal-file basename: the adapter's override if it defines\n113\t# `signal_file`, else the standard `.${name}-${kind}` default. This is the\n114\t# control-contract public surface — callers (lib/run.sh, harden-core, converge-core)\n115\t# go through here instead of dispatching to the adapter directly, so adding a new\n116\t# loop costs zero signal_file code unless the loop is non-standard. Returns 1 for\n117\t# an unknown kind or an unknown loop name.\n118\talmanac_loop_signal_file() {\n119\t  local key fn\n120\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n121\t  almanac_loop_adapter_known \"$key\" || return 1\n122\t  fn=\"almanac_loop_${key}_signal_file\"\n123\t  if declare -F \"$fn\" >/dev/null 2>&1; then\n124\t    \"$fn\" \"$2\"\n125\t  else\n126\t    almanac_loop_default_signal_file \"$key\" \"$2\"\n127\t  fi\n128\t}\n129\t\n130\talmanac_loop_adapter_load\n131\t"}]},"parent_tool_use_id":"toolu_014CCc6VqTJsQ4tPs9wK42Z1","session_id":"8f5db91c-a278-450c-98f6-32d4d1454f5d","uuid":"f300b9a6-4198-4d3c-8032-047e3ce27bcc","timestamp":"2026-05-27T07:58:49.795Z","subagent_type":"Explore","task_description":"Codebase architecture exploration"}
