{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TXsogNw5c6Pw3ZBytT2LV2","type":"tool_result","content":"100\t$goal\n101\t\n102\t## Acceptance\n103\t\n104\t- [ ] Target behavior satisfies the stated goal.\n105\t- [ ] Blocking findings include a failing test, breaking input, or cited acceptance violation.\n106\t- [ ] Project feedback loops pass after fixes.\n107\t\n108\t## In Scope\n109\t\n110\t- $target\n111\t\n112\t## Out of Scope\n113\t\n114\t- Add non-goals here before running reviewers.\n115\t\n116\t## Severity\n117\t\n118\tBlocking findings must be falsifiable and reproducible against the current target.\n119\tSubjective or unreproducible findings are non-blocking notes.\n120\t\n121\t## Context\n122\t\n123\t- Add intentional decisions and false-positive preemptions here before running reviewers.\n124\tEOF\n125\t}\n126\t\n127\talmanac_harden_approve_rubric() {\n128\t  local root=\"$1\"\n129\t  local target=\"$2\"\n130\t  local path approved_at tmp\n131\t\n132\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n133\t\n134\t  if [ ! -f \"$path\" ]; then\n135\t    return 2\n136\t  fi\n137\t\n138\t  if grep -Eq '^Status: approved$' \"$path\"; then\n139\t    return 3\n140\t  fi\n141\t\n142\t  approved_at=\"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\"\n143\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n144\t\n145\t  if grep -Eq '^Status: draft$' \"$path\"; then\n146\t    awk -v approved_at=\"$approved_at\" '\n147\t      /^Status: draft$/ && !replaced {\n148\t        print \"Status: approved\"\n149\t        replaced = 1\n150\t        next\n151\t      }\n152\t      { print }\n153\t      END {\n154\t        print \"\"\n155\t        print \"## Approval\"\n156\t        print \"\"\n157\t        print \"Approved: \" approved_at\n158\t      }\n159\t    ' \"$path\" > \"$tmp\"\n160\t  else\n161\t    awk -v approved_at=\"$approved_at\" '\n162\t      /^Target: / && !inserted {\n163\t        print\n164\t        print \"Status: approved\"\n165\t        inserted = 1\n166\t        next\n167\t      }\n168\t      { print }\n169\t      END {\n170\t        if (!inserted) {\n171\t          print \"Status: approved\"\n172\t        }\n173\t        print \"\"\n174\t        print \"## Approval\"\n175\t        print \"\"\n176\t        print \"Approved: \" approved_at\n177\t      }\n178\t    ' \"$path\" > \"$tmp\"\n179\t  fi\n180\t\n181\t  mv \"$tmp\" \"$path\"\n182\t}\n183\t\n184\t# Return 0 when the rubric is approved (locked), non-zero otherwise — including\n185\t# when it is still a draft or the file is absent. Pure read; the loop gates on\n186\t# this so reviewers never run against a half-authored bar.\n187\talmanac_harden_rubric_approved() {\n188\t  local rubric_path=\"$1\"\n189\t\n190\t  [ -f \"$rubric_path\" ] || return 1\n191\t  grep -Eq '^Status: approved$' \"$rubric_path\"\n192\t}\n193\t\n194\t# Emit the rubric's acceptance criteria — the bar reviewers and ratification work\n195\t# against. Prints every bullet line under the `## Acceptance` heading up to the\n196\t# next `## ` section. Empty when the rubric or section is absent. Pure read.\n197\talmanac_harden_rubric_acceptance() {\n198\t  local path=\"$1\"\n199\t\n200\t  [ -f \"$path\" ] || return 0\n201\t\n202\t  awk '\n203\t    /^## Acceptance[[:space:]]*$/ { in_acc = 1; next }\n204\t    in_acc && /^## / { in_acc = 0 }\n205\t    in_acc && /^- / { print }\n206\t  ' \"$path\"\n207\t}\n208\t\n209\t# Append one acceptance criterion to the rubric's `## Acceptance` section. This is\n210\t# how a ratified finding grows the bar: monotonic (criteria are only added), visible\n211\t# (a clean diff), and append-only. The new `- [ ] <criterion>` lands at the end of\n212\t# the Acceptance block, before the next section. Idempotent: an identical criterion\n213\t# is never re-added (returns 1, writes nothing) so re-ratifying a reopened finding\n214\t# cannot duplicate it. Returns 2 when the rubric or its Acceptance section is absent.\n215\talmanac_harden_rubric_append_criterion() {\n216\t  local path=\"$1\"\n217\t  local criterion=\"$2\"\n218\t  local tmp\n219\t\n220\t  [ -f \"$path\" ] || return 2\n221\t  grep -q '^## Acceptance[[:space:]]*$' \"$path\" || return 2\n222\t\n223\t  if grep -Fxq -- \"- [ ] $criterion\" \"$path\" || \\\n224\t      grep -Fxq -- \"- [x] $criterion\" \"$path\"; then\n225\t    return 1\n226\t  fi\n227\t\n228\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n229\t  awk -v crit=\"$criterion\" '\n230\t    /^## Acceptance[[:space:]]*$/ { print; in_acc = 1; next }\n231\t    in_acc && /^## / {\n232\t      print \"- [ ] \" crit\n233\t      inserted = 1\n234\t      in_acc = 0\n235\t      for (i = 1; i <= nb; i++) print blanks[i]\n236\t      nb = 0\n237\t      print\n238\t      next\n239\t    }\n240\t    in_acc && /^[[:space:]]*$/ { nb++; blanks[nb] = $0; next }\n241\t    in_acc {\n242\t      for (i = 1; i <= nb; i++) print blanks[i]\n243\t      nb = 0\n244\t      print\n245\t      next\n246\t    }\n247\t    { print }\n248\t    END {\n249\t      if (in_acc && !inserted) {\n250\t        print \"- [ ] \" crit\n251\t        for (i = 1; i <= nb; i++) print blanks[i]\n252\t      }\n253\t    }\n254\t  ' \"$path\" > \"$tmp\"\n255\t  mv \"$tmp\" \"$path\"\n256\t}\n257\t\n258\t# --- Rubric immutability guard -------------------------------------------------\n259\t#\n260\t# The rubric is the contract, and during a run it is immutable to agents: the\n261\t# goalposts move only by a deliberate human act (the developer editing the file\n262\t# between runs / approving it) or the conductor's controlled append at\n263\t# ratification (almanac_harden_rubric_append_criterion — a visible, monotonic\n264\t# diff that runs OUTSIDE the reviewer/fixer phase). Reviewers run read-only and\n265\t# cannot write the rubric; the fixer (later slice) has write access and could.\n266\t# These two helpers bracket an agent phase — snapshot before, verify after — and\n267\t# revert any agent edit, so a stray agent write during a run cannot lower the bar.\n268\t\n269\t# Snapshot the rubric to a protected temp copy and echo the snapshot path so the\n270\t# caller can pass it to almanac_harden_rubric_verify. Returns 2 (echoes nothing)\n271\t# when no rubric exists — an ad-hoc bare run with no drafted contract has nothing\n272\t# to guard.\n273\talmanac_harden_rubric_snapshot() {\n274\t  local rubric_path=\"$1\"\n275\t  local snap\n276\t\n277\t  [ -f \"$rubric_path\" ] || return 2\n278\t\n279\t  snap=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-rubric-lock.XXXXXX\")\"\n280\t  cp \"$rubric_path\" \"$snap\"\n281\t  printf '%s\\n' \"$snap\"\n282\t}\n283\t\n284\t# Verify the rubric is byte-identical to its snapshot; if an agent modified it\n285\t# during the guarded phase, revert it and warn (the contract is immutable to\n286\t# agents). Discards the snapshot either way. Returns 1 when a modification was\n287\t# reverted, 0 when unchanged, 2 when the snapshot is missing.\n288\talmanac_harden_rubric_verify() {\n289\t  local rubric_path=\"$1\"\n290\t  local snap=\"$2\"\n291\t\n292\t  [ -n \"$snap\" ] && [ -f \"$snap\" ] || return 2\n293\t\n294\t  if ! cmp -s \"$rubric_path\" \"$snap\"; then\n295\t    cp \"$snap\" \"$rubric_path\"\n296\t    rm -f \"$snap\"\n297\t    _warn \"Rubric was modified during the run; reverted (contract is immutable to agents — amend it directly between runs).\"\n298\t    return 1\n299\t  fi\n300\t\n301\t  rm -f \"$snap\"\n302\t  return 0\n303\t}\n304\t\n305\t# Emit the configured reviewer lens set, one lens per line. Defaults to the five\n306\t# PRD lenses; override at runtime via HARDEN_LENSES (comma- or whitespace-\n307\t# separated).\n308\talmanac_harden_lenses() {\n309\t  local raw=\"${HARDEN_LENSES:-correctness security perf edge-cases contracts}\"\n310\t\n311\t  # Trailing newline matters: a `read` loop consumer drops a final line that\n312\t  # lacks one, which would silently swallow the last lens.\n313\t  printf '%s\\n' \"$raw\" | tr -s ', \\t' '\\n' | sed '/^$/d'\n314\t}\n315\t\n316\talmanac_harden_max_reviewers() {\n317\t  printf '%s\\n' \"${HARDEN_MAX_REVIEWERS:-16}\"\n318\t}\n319\t\n320\t# Build the fixed prompt for one read-only reviewer over a target, including the\n321\t# JSON-Lines findings schema. When a rubric path is given and exists, the rubric's\n322\t# acceptance criteria are embedded as the bar the reviewer judges against, so\n323\t# reviewers consume the contract rather than an implicit standard. An optional\n324\t# steering directive (4th arg) is embedded too, so an operator who redirects the\n325\t# run at the HITL checkpoint (e.g. \"focus on the auth module\") reaches the\n326\t# reviewers on the next round. Kept separate so the schema can grow without\n327\t# touching orchestration. (Exact prompt wording is not asserted in tests by\n328\t# design; that the rubric bar and the steer directive are consumed is.)\n329\talmanac_harden_reviewer_prompt() {\n330\t  local target=\"$1\"\n331\t  local lens=\"${2:-correctness}\"\n332\t  local rubric_path=\"${3:-}\"\n333\t  local directive=\"${4:-}\"\n334\t  local rubric_bar=\"\"\n335\t\n336\t  if [ -n \"$rubric_path\" ] && [ -f \"$rubric_path\" ]; then\n337\t    rubric_bar=\"$(almanac_harden_rubric_acceptance \"$rubric_path\")\"\n338\t  fi\n339\t\n340\t  cat <<EOF\n341\tYou are a read-only code reviewer. Lens: ${lens}.\n342\t\n343\tReview the target below for ${lens} defects only. You cannot modify any files;\n344\tthis is a read-only review.\n345\t\n346\tTarget: ${target}\n347\tEOF\n348\t\n349\t  if [ -n \"$rubric_bar\" ]; then\n350\t    cat <<EOF\n351\t\n352\tJudge the target against this acceptance bar (the rubric contract). A finding is\n353\tonly blocking if it violates a criterion below or demonstrably breaks behavior:\n354\t\n355\t${rubric_bar}\n356\tEOF\n357\t  fi\n358\t\n359\t  if [ -n \"$directive\" ]; then\n360\t    cat <<EOF\n361\t\n362\tThe operator steered this run with the directive below — follow it and prioritize\n363\tthe findings it points you toward:\n364\t\n365\t${directive}\n366\tEOF\n367\t  fi\n368\t\n369\t  cat <<EOF\n370\t\n371\tReport each defect as one JSON object per line (JSON Lines) and output nothing\n372\telse — no prose, no markdown fences. Each object must use this schema:\n373\t\n374\t{\"lens\":\"${lens}\",\"severity\":\"high|medium|low\",\"location\":\"<file:line or symbol>\",\"claim\":\"<one-line defect>\",\"demonstration\":\"<failing test, breaking input, or cited rubric criterion>\"}\n375\t\n376\tOnly report a defect you can demonstrate with a failing test, a specific breaking\n377\tinput, or a cited criterion. If you find no demonstrable defects, output nothing.\n378\tEOF\n379\t}\n380\t\n381\t# Normalize the reviewer's JSON-Lines result into TSV rows\n382\t# (lens, severity, location, claim, demonstration). Malformed lines are dropped\n383\t# cleanly. Prefers jq; falls back to a flat-field awk extractor when jq is absent\n384\t# so harden keeps almanac's near-zero-dependency promise.\n385\talmanac_harden_findings_tsv() {\n386\t  local result_file=\"$1\"\n387\t\n388\t  [ -f \"$result_file\" ] || return 0\n389\t\n390\t  if command -v jq >/dev/null 2>&1; then\n391\t    jq -Rr '\n392\t      fromjson?\n393\t      | select(type == \"object\")\n394\t      | {\n395\t          lens: (.lens // \"\"),\n396\t          severity: (.severity // \"\"),\n397\t          location: (.location // \"\"),\n398\t          claim: (.claim // \"\"),\n399\t          demonstration: (.demonstration // \"\")"}]},"parent_tool_use_id":"toolu_014CCc6VqTJsQ4tPs9wK42Z1","session_id":"8f5db91c-a278-450c-98f6-32d4d1454f5d","uuid":"e27ad271-277b-4055-8c31-aac158c4c591","timestamp":"2026-05-27T07:58:56.092Z","subagent_type":"Explore","task_description":"Codebase architecture exploration"}
