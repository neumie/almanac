{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XUpWGsmxoEBetPFYgZT36U","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# feedback.sh - Project feedback-loop detection + runner\n3\t#\n4\t# The feedback loops are a project's objective gate: the test/typecheck/lint\n5\t# commands implied by its marker files (package.json, Cargo.toml, …). Detection\n6\t# maps marker files to commands (shared by Ralph's prompt and harden's fixer, so\n7\t# both run the same gate with no per-project config); the runner executes them\n8\t# and reports a pass/fail verdict per loop.\n9\t#\n10\t# Self-contained like lib/role.sh / lib/run.sh: uses only printf/tr/mkdir/eval\n11\t# and a subshell cd (no lib/core.sh dependency), so this file's interface is its\n12\t# own test surface (tests/test-feedback.sh). Callers source it directly.\n13\t\n14\t# Single source of truth: marker → list of (command, description) rows. Each\n15\t# marker block emits TAB-separated rows, so adding a marker is a single block\n16\t# carrying both the command and its description — no parallel case-statement to\n17\t# keep in sync. Private — public surface is almanac_loop_feedback_commands +\n18\t# _markdown derived below.\n19\t_almanac_loop_feedback_rows() {\n20\t  local root=\"${1:-.}\"\n21\t\n22\t  if [ -f \"$root/package.json\" ]; then\n23\t    printf '%s\\t%s\\n' \"npm run test\"      \"run npm tests\"\n24\t    printf '%s\\t%s\\n' \"npm run typecheck\" \"run TypeScript type checks\"\n25\t    printf '%s\\t%s\\n' \"npm run lint\"      \"run lint checks\"\n26\t  fi\n27\t\n28\t  if [ -f \"$root/Makefile\" ]; then\n29\t    printf '%s\\t%s\\n' \"make test\"  \"run Makefile test target\"\n30\t    printf '%s\\t%s\\n' \"make check\" \"run Makefile check target\"\n31\t  fi\n32\t\n33\t  if [ -f \"$root/Cargo.toml\" ]; then\n34\t    printf '%s\\t%s\\n' \"cargo test\"  \"run Rust tests\"\n35\t    printf '%s\\t%s\\n' \"cargo check\" \"run Rust compiler checks\"\n36\t  fi\n37\t\n38\t  if [ -f \"$root/go.mod\" ]; then\n39\t    printf '%s\\t%s\\n' \"go test ./...\" \"run Go tests\"\n40\t    printf '%s\\t%s\\n' \"go vet ./...\"  \"run Go vet checks\"\n41\t  fi\n42\t\n43\t  if [ -f \"$root/pyproject.toml\" ] || [ -f \"$root/setup.py\" ]; then\n44\t    printf '%s\\t%s\\n' \"pytest\" \"run Python tests\"\n45\t    printf '%s\\t%s\\n' \"mypy\"   \"run Python type checks\"\n46\t  fi\n47\t\n48\t  if [ -f \"$root/tests/test-skills.sh\" ]; then\n49\t    printf '%s\\t%s\\n' \"bash tests/test-skills.sh\" \"validate skill format/content\"\n50\t  fi\n51\t\n52\t  if [ -f \"$root/tests/test-structure.sh\" ]; then\n53\t    printf '%s\\t%s\\n' \"bash tests/test-structure.sh\" \"validate repo layout\"\n54\t  fi\n55\t}\n56\t\n57\t# Emit one feedback command per line, detected from the project marker files\n58\t# present at $root. The order is fixed so the prompt/runner output is stable.\n59\talmanac_loop_feedback_commands() {\n60\t  local cmd desc\n61\t  while IFS=$'\\t' read -r cmd desc; do\n62\t    [ -n \"$cmd\" ] || continue\n63\t    printf '%s\\n' \"$cmd\"\n64\t  done < <(_almanac_loop_feedback_rows \"${1:-.}\")\n65\t}\n66\t\n67\talmanac_loop_feedback_markdown() {\n68\t  local root=\"${1:-.}\"\n69\t  local cmd desc found=0\n70\t\n71\t  while IFS=$'\\t' read -r cmd desc; do\n72\t    [ -n \"$cmd\" ] || continue\n73\t    printf -- '- `%s` to %s\\n' \"$cmd\" \"$desc\"\n74\t    found=1\n75\t  done < <(_almanac_loop_feedback_rows \"$root\")\n76\t\n77\t  if [ \"$found\" -eq 0 ]; then\n78\t    printf '%s\\n' \"- (none detected)\"\n79\t  fi\n80\t}\n81\t\n82\t# Run every detected feedback loop for the project at $root and emit one TSV\n83\t# verdict row per loop: <command>\\t<pass|fail>. Each command runs from $root\n84\t# (combined output captured to $log_dir/<slug>.log when a log dir is given,\n85\t# else discarded). Returns 0 only when every loop passed and non-zero when any\n86\t# failed, so a caller can gate on the aggregate while still reading the per-loop\n87\t# verdicts. This is the runner half of the shared feedback engine; detection is\n88\t# almanac_loop_feedback_commands, shared with Ralph, so both consumers run the\n89\t# same objective gate without per-project config.\n90\talmanac_loop_feedback_run() {\n91\t  local root=\"${1:-.}\"\n92\t  local log_dir=\"${2:-}\"\n93\t  local command verdict log_file slug\n94\t  local any_fail=0\n95\t\n96\t  if [ -n \"$log_dir\" ]; then\n97\t    mkdir -p \"$log_dir\"\n98\t  fi\n99\t\n100\t  while IFS= read -r command; do\n101\t    [ -n \"$command\" ] || continue\n102\t\n103\t    if [ -n \"$log_dir\" ]; then\n104\t      slug=\"$(printf '%s' \"$command\" | tr -cs 'A-Za-z0-9' '-')\"\n105\t      log_file=\"$log_dir/${slug}.log\"\n106\t    else\n107\t      log_file=\"/dev/null\"\n108\t    fi\n109\t\n110\t    if ( cd \"$root\" && eval \"$command\" ) > \"$log_file\" 2>&1; then\n111\t      verdict=\"pass\"\n112\t    else\n113\t      verdict=\"fail\"\n114\t      any_fail=1\n115\t    fi\n116\t\n117\t    printf '%s\\t%s\\n' \"$command\" \"$verdict\"\n118\t  done < <(almanac_loop_feedback_commands \"$root\")\n119\t\n120\t  return \"$any_fail\"\n121\t}\n122\t"}]},"parent_tool_use_id":"toolu_014CCc6VqTJsQ4tPs9wK42Z1","session_id":"8f5db91c-a278-450c-98f6-32d4d1454f5d","uuid":"5450cc3a-1fcc-4b80-bccf-a7c3446ebebf","timestamp":"2026-05-27T07:58:53.186Z","subagent_type":"Explore","task_description":"Codebase architecture exploration"}
