{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013xnPdffy44FuSwNERtHceN","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# harden-core.sh - Harden loop rubric bootstrap + reviewer helpers\n3\t\n4\t# loop-core.sh (the old shared-engine barrel) is deleted; harden-core sources the\n5\t# focused modules it actually uses, each directly and idempotently so it works\n6\t# both through bin/almanac and when a test sources this file directly. core.sh\n7\t# is sourced literally (it owns the helper); the other deps go through\n8\t# _almanac_source_sibling so the boilerplate stays minimal.\n9\tif ! declare -F _error >/dev/null 2>&1; then\n10\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n11\t  # shellcheck source=lib/core.sh\n12\t  source \"$__harden_core_dir/core.sh\"\n13\t  unset __harden_core_dir\n14\tfi\n15\t\n16\t# Explicit deps (each declared module is the contract surface this file consumes;\n17\t# transitive availability is not relied on).\n18\t_almanac_source_sibling agent.sh    almanac_loop_agent_capture   # agent run shapes (ratify/fixer)\n19\t_almanac_source_sibling run.sh      almanac_loop_register_run    # run registry + worker paths/health\n20\t_almanac_source_sibling worker.sh   almanac_loop_worker_start    # worker orchestration (reviewer/fixer fan-out)\n21\t_almanac_source_sibling ui.sh       almanac_loop_ui_render       # gum-or-plain dashboard seam\n22\t_almanac_source_sibling role.sh     almanac_loop_role_config     # per-role provider/model/effort resolution\n23\t_almanac_source_sibling feedback.sh almanac_loop_feedback_run    # objective fixer gate\n24\t\n25\t# --- Role config (per-role provider / model / effort) --------------------------\n26\t#\n27\t# Each harden role selects its own agent config:\n28\t#   conductor - judges/ratifies findings and declares convergence\n29\t#   reviewer  - one read-only reviewer per lens (lens -> provider map)\n30\t#   fixer     - the single sequential write-capable fixer\n31\t#\n32\t# Resolution layers, most specific first, via the shared loop resolver:\n33\t#   provider: HARDEN_<ROLE>[_<LENS>]_PROVIDER -> HARDEN_<ROLE>_PROVIDER\n34\t#             -> HARDEN_PROVIDER -> claude (sensible default: Claude plays every role)\n35\t#   model:    HARDEN_<ROLE>[_<LENS>]_MODEL    -> HARDEN_<ROLE>_MODEL\n36\t#             -> HARDEN_MODEL -> \"\" (the provider's own default)\n37\t#   effort:   HARDEN_<ROLE>[_<LENS>]_EFFORT   -> HARDEN_<ROLE>_EFFORT\n38\t#             -> HARDEN_EFFORT -> \"\" (the provider's own default)\n39\t#\n40\t# Only reviewers consult the lens, so providers can be mixed across lenses in one\n41\t# round; conductor and fixer are single-instance and ignore it. Resolution reads\n42\t# ONLY HARDEN_* (and the shared loop env) — never any host marker — so the tuple\n43\t# is identical whether the run was launched from Claude Code or Codex. Emits three\n44\t# TSV rows (provider/model/effort); returns 2 on an unknown role.\n45\talmanac_harden_role() {\n46\t  local role=\"$1\"\n47\t  local lens=\"${2:-}\"\n48\t\n49\t  case \"$role\" in\n50\t    reviewer) ;;                 # reviewers map lens -> provider\n51\t    conductor | fixer) lens=\"\" ;; # single-instance roles ignore the lens\n52\t    *) return 2 ;;\n53\t  esac\n54\t\n55\t  almanac_loop_role_config \"harden\" \"$role\" \"$lens\" \"$(almanac_provider_default)\" \"\" \"\"\n56\t}\n57\t\n58\t# One field (provider | model | effort) of a harden role's resolved config, for\n59\t# call sites that need a single value. Thin reader over almanac_harden_role so\n60\t# harden's per-role defaults stay defined in exactly one place.\n61\talmanac_harden_role_field() {\n62\t  local role=\"$1\"\n63\t  local field=\"$2\"\n64\t  local lens=\"${3:-}\"\n65\t\n66\t  almanac_harden_role \"$role\" \"$lens\" | almanac_loop_role_tsv_field \"$field\"\n67\t}\n68\t\n69\talmanac_harden_rubric_path() {\n70\t  local root=\"$1\"\n71\t  local target=\"$2\"\n72\t  local slug\n73\t\n74\t  slug=\"$(almanac_loop_slug \"$target\")\"\n75\t  printf '%s/rubric.md\\n' \"$(almanac_loop_plan_dir harden \"$root\" \"$slug\")\"\n76\t}\n77\t\n78\talmanac_harden_write_rubric() {\n79\t  local root=\"$1\"\n80\t  local target=\"$2\"\n81\t  local goal=\"$3\"\n82\t  local path dir\n83\t\n84\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n85\t  dir=\"$(dirname \"$path\")\"\n86\t\n87\t  if [ -e \"$path\" ]; then\n88\t    return 2\n89\t  fi\n90\t\n91\t  mkdir -p \"$dir\"\n92\t  cat > \"$path\" <<EOF\n93\t# Harden Rubric\n94\t\n95\tTarget: $target\n96\tStatus: draft\n97\t\n98\t## Goal\n99\t\n100\t$goal\n101\t\n102\t## Acceptance\n103\t\n104\t- [ ] Target behavior satisfies the stated goal.\n105\t- [ ] Blocking findings include a failing test, breaking input, or cited acceptance violation.\n106\t- [ ] Project feedback loops pass after fixes.\n107\t\n108\t## In Scope\n109\t\n110\t- $target\n111\t\n112\t## Out of Scope\n113\t\n114\t- Add non-goals here before running reviewers.\n115\t\n116\t## Severity\n117\t\n118\tBlocking findings must be falsifiable and reproducible against the current target.\n119\tSubjective or unreproducible findings are non-blocking notes.\n120\t\n121\t## Context\n122\t\n123\t- Add intentional decisions and false-positive preemptions here before running reviewers.\n124\tEOF\n125\t}\n126\t\n127\talmanac_harden_approve_rubric() {\n128\t  local root=\"$1\"\n129\t  local target=\"$2\"\n130\t  local path approved_at tmp\n131\t\n132\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n133\t\n134\t  if [ ! -f \"$path\" ]; then\n135\t    return 2\n136\t  fi\n137\t\n138\t  if grep -Eq '^Status: approved$' \"$path\"; then\n139\t    return 3\n140\t  fi\n141\t\n142\t  approved_at=\"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\"\n143\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n144\t\n145\t  if grep -Eq '^Status: draft$' \"$path\"; then\n146\t    awk -v approved_at=\"$approved_at\" '\n147\t      /^Status: draft$/ && !replaced {\n148\t        print \"Status: approved\"\n149\t        replaced = 1\n150\t        next\n151\t      }\n152\t      { print }\n153\t      END {\n154\t        print \"\"\n155\t        print \"## Approval\"\n156\t        print \"\"\n157\t        print \"Approved: \" approved_at\n158\t      }\n159\t    ' \"$path\" > \"$tmp\"\n160\t  else\n161\t    awk -v approved_at=\"$approved_at\" '\n162\t      /^Target: / && !inserted {\n163\t        print\n164\t        print \"Status: approved\"\n165\t        inserted = 1\n166\t        next\n167\t      }\n168\t      { print }\n169\t      END {\n170\t        if (!inserted) {\n171\t          print \"Status: approved\"\n172\t        }\n173\t        print \"\"\n174\t        print \"## Approval\"\n175\t        print \"\"\n176\t        print \"Approved: \" approved_at\n177\t      }\n178\t    ' \"$path\" > \"$tmp\"\n179\t  fi\n180\t\n181\t  mv \"$tmp\" \"$path\"\n182\t}\n183\t\n184\t# Return 0 when the rubric is approved (locked), non-zero otherwise — including\n185\t# when it is still a draft or the file is absent. Pure read; the loop gates on\n186\t# this so reviewers never run against a half-authored bar.\n187\talmanac_harden_rubric_approved() {\n188\t  local rubric_path=\"$1\"\n189\t\n190\t  [ -f \"$rubric_path\" ] || return 1\n191\t  grep -Eq '^Status: approved$' \"$rubric_path\"\n192\t}\n193\t\n194\t# Emit the rubric's acceptance criteria — the bar reviewers and ratification work\n195\t# against. Prints every bullet line under the `## Acceptance` heading up to the\n196\t# next `## ` section. Empty when the rubric or section is absent. Pure read.\n197\talmanac_harden_rubric_acceptance() {\n198\t  local path=\"$1\"\n199\t\n200\t  [ -f \"$path\" ] || return 0"}]},"parent_tool_use_id":"toolu_01P2gUFsjpPXPaGsNqiTn6uA","session_id":"274f3ab8-9347-4dfe-9be3-7479874e14e0","uuid":"ffba108d-84d1-4b72-85f6-1be5f347630e","timestamp":"2026-05-27T07:35:49.135Z","subagent_type":"Explore","task_description":"Explore almanac codebase for architectural friction"}
