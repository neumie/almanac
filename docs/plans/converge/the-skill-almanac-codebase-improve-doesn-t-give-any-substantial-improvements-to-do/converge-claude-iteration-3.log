{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GCVJvppL1hcZoHBp5YbUjV","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# run.sh — the run registry: the run-status record, registry, control, worker\n3\t# health, and the hub's read views, owned in one module (per CONTEXT.md's module\n4\t# map). loop-core.sh (the old god-module) is deleted; this is where its registry/\n5\t# control/worker-health/hub-view concerns now live (the worker orchestration /\n6\t# background fan-out lives in lib/worker.sh).\n7\t#\n8\t# A run-status *record* is a per-run status.tsv — one `key<TAB>value` line per\n9\t# field. This module owns the CANONICAL FIELD LIST and the only set/get-by-name\n10\t# accessors for it, so the run-status contract — every run (ralph or harden)\n11\t# carries exactly this key set, in this order — is enforced *by construction*:\n12\t# a caller names only the fields it has values for; the record fills in the rest,\n13\t# and no writer ever enumerates the schema by hand.\n14\t#\n15\t# No lib/core.sh dependency (uses only printf/read/awk/etc), so the record +\n16\t# registry are their own test surface — tests/test-run.sh sources this file\n17\t# directly. The hub read-views compose the gum-or-plain UI seam (lib/ui.sh) and\n18\t# the per-run control dispatches each loop's signal files through its adapter\n19\t# (lib/loops.sh), so source those two idempotently — they are self-contained\n20\t# (no core.sh) too. pwd -P resolves the install symlink so the siblings are found\n21\t# from either path.\n22\tif ! declare -F almanac_loop_ui_render >/dev/null 2>&1; then\n23\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t  # shellcheck source=lib/ui.sh\n25\t  source \"$__run_dir/ui.sh\"\n26\t  unset __run_dir\n27\tfi\n28\t\n29\tif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n30\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n31\t  # shellcheck source=lib/loops.sh\n32\t  source \"$__run_dir/loops.sh\"\n33\t  unset __run_dir\n34\tfi\n35\t\n36\t# THE single source of truth for the run-status schema: the canonical field list\n37\t# in write order. record_set iterates exactly this list, so every record carries\n38\t# the same keys regardless of which subset a caller supplies. The first seven are\n39\t# also the registry's index.tsv columns (the lightweight list pointer); the last\n40\t# three (finished_at/round/summary) are the per-run detail the index omits.\n41\talmanac_loop_record_fields() {\n42\t  printf '%s\\n' \\\n43\t    id type target pid status_file started_at status finished_at round summary failure_reason \\\n44\t    provider model effort iterations oversee lenses rounds queue_progress \\\n45\t    goal prompt exec oversee_every\n46\t}\n47\t\n48\t# Get one field from a record FILE by name. Prints the value (which may itself\n49\t# contain tabs — reassembled from the trailing columns) and returns 0; returns 1\n50\t# when the field is absent. This is the generic tab-field reader for the run\n51\t# registry; almanac_loop_status_field (below) is a thin alias over it for the\n52\t# worker-status and hub read paths.\n53\talmanac_loop_record_get() {\n54\t  local file=\"$1\" wanted=\"$2\" key value rest\n55\t\n56\t  while IFS=$'\\t' read -r key value rest; do\n57\t    if [ \"$key\" = \"$wanted\" ]; then\n58\t      if [ -n \"${rest:-}\" ]; then\n59\t        value=\"${value}\"$'\\t'\"${rest}\"\n60\t      fi\n61\t      printf '%s\\n' \"$value\"\n62\t      return 0\n63\t    fi\n64\t  done < \"$file\"\n65\t\n66\t  return 1\n67\t}\n68\t\n69\t# Generic TSV record engine: rewrite FILE with the schema in FIELDS_TEXT, in\n70\t# canonical order, with each (existing) field preserved unless overridden by a\n71\t# `field=value` PAIR. This is the deep module that owns the round-trip algorithm\n72\t# — schema-specific wrappers (record_set for run-status, worker_record_set for\n73\t# worker-status) just supply their own field list. Returns 2 on a missing file\n74\t# argument or a pair whose field isn't in FIELDS_TEXT.\n75\talmanac_loop_tsv_record_set() {\n76\t  local fields_text=\"$1\" file=\"$2\"\n77\t  shift 2 || return 2\n78\t  [ -n \"$file\" ] || return 2\n79\t\n80\t  local pair pfield field cur val out=\"\"\n81\t  local have_file=0\n82\t  if [ -f \"$file\" ]; then\n83\t    have_file=1\n84\t  fi\n85\t\n86\t  for pair in \"$@\"; do\n87\t    pfield=\"${pair%%=*}\"\n88\t    almanac_loop_tsv_has_field \"$fields_text\" \"$pfield\" || return 2\n89\t  done\n90\t\n91\t  while IFS= read -r field; do\n92\t    [ -n \"$field\" ] || continue\n93\t    cur=\"\"\n94\t    if [ \"$have_file\" = 1 ]; then\n95\t      cur=\"$(almanac_loop_record_get \"$file\" \"$field\" || true)\"\n96\t    fi\n97\t    val=\"$cur\"\n98\t    for pair in \"$@\"; do\n99\t      pfield=\"${pair%%=*}\"\n100\t      if [ \"$pfield\" = \"$field\" ]; then\n101\t        val=\"${pair#*=}\"\n102\t      fi\n103\t    done\n104\t    out=\"${out}${field}\"$'\\t'\"${val}\"$'\\n'\n105\t  done <<< \"$fields_text\"\n106\t\n107\t  printf '%s' \"$out\" > \"$file\"\n108\t}\n109\t\n110\t# True when NAME appears as a field in FIELDS_TEXT (newline-separated schema).\n111\talmanac_loop_tsv_has_field() {\n112\t  local fields_text=\"$1\" wanted=\"$2\" field\n113\t  while IFS= read -r field; do\n114\t    [ \"$field\" = \"$wanted\" ] && return 0\n115\t  done <<< \"$fields_text\"\n116\t  return 1\n117\t}\n118\t\n119\t# True when NAME is a canonical run-status field. Lets record_set reject a typo\n120\t# rather than silently writing a key no reader ever looks for.\n121\talmanac_loop_record_has_field() {\n122\t  almanac_loop_tsv_has_field \"$(almanac_loop_record_fields)\" \"$1\"\n123\t}\n124\t\n125\t# Set one or more run-status fields by name, round-tripping the rest. Each\n126\t# argument is a `field=value` pair (the value may itself contain `=`). The record\n127\t# is rewritten with the FULL canonical key set in canonical order: every\n128\t# canonical field already in the file is preserved unless overridden, and a\n129\t# not-yet-existing file is initialised with every key (blank where unset). So\n130\t# `register` seeds the record by naming only its known fields, while\n131\t# `mark`/`update` change only theirs and leave the rest intact — no caller\n132\t# enumerates the schema. Returns 2 on a missing file argument or a `field=value`\n133\t# whose field is not canonical.\n134\talmanac_loop_record_set() {\n135\t  almanac_loop_tsv_record_set \"$(almanac_loop_record_fields)\" \"$@\"\n136\t}\n137\t\n138\talmanac_loop_slug() {\n139\t  local raw=\"$1\"\n140\t  local slug\n141\t\n142\t  slug=\"$(printf '%s' \"$raw\" \\\n143\t    | tr '[:upper:]' '[:lower:]' \\\n144\t    | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')\"\n145\t\n146\t  if [ -z \"$slug\" ]; then\n147\t    slug=\"run\"\n148\t  fi\n149\t\n150\t  printf '%s\\n' \"$slug\"\n151\t}\n152\t\n153\t# A loop's plan dir: <root>/docs/plans/<type>/<slug>. Each loop's plan/rubric/\n154\t# ledger paths compose off this, so the docs/plans/<type>/<slug> prefix lives in\n155\t# exactly one place. Caller supplies an already-slugified key (loops use\n156\t# almanac_loop_slug) so this stays a pure path joiner — no second slug pass\n157\t# muddying the contract.\n158\talmanac_loop_plan_dir() {\n159\t  local type=\"$1\"\n160\t  local root=\"$2\"\n161\t  local slug=\"$3\"\n162\t\n163\t  printf '%s/docs/plans/%s/%s\\n' \"$root\" \"$type\" \"$slug\"\n164\t}\n165\t\n166\talmanac_loop_now_utc() {\n167\t  date -u '+%Y-%m-%dT%H:%M:%SZ'\n168\t}\n169\t\n170\talmanac_loop_run_id() {\n171\t  local type=\"$1\"\n172\t  local target=\"$2\"\n173\t  local compact_now\n174\t\n175\t  compact_now=\"$(date -u '+%Y%m%dT%H%M%SZ')\"\n176\t  printf '%s-%s-%s-%s\\n' \\\n177\t    \"$(almanac_loop_slug \"$type\")\" \\\n178\t    \"$(almanac_loop_slug \"$target\")\" \\\n179\t    \"$compact_now\" \\\n180\t    \"$$\"\n181\t}\n182\t\n183\talmanac_loop_registry_dir() {\n184\t  local root=\"${1:-.}\"\n185\t\n186\t  if [ \"$root\" != \"/\" ]; then\n187\t    root=\"${root%/}\"\n188\t  fi\n189\t\n190\t  printf '%s/.almanac/runs\\n' \"$root\"\n191\t}\n192\t\n193\talmanac_loop_run_status_file() {\n194\t  local root=\"$1\"\n195\t  local run_id=\"$2\"\n196\t\n197\t  printf '%s/%s/status.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\" \"$run_id\"\n198\t}\n199\t\n200\talmanac_loop_run_status_relpath() {\n201\t  local run_id=\"$1\"\n202\t\n203\t  printf '.almanac/runs/%s/status.tsv\\n' \"$run_id\"\n204\t}\n205\t\n206\talmanac_loop_run_index_file() {\n207\t  local root=\"$1\"\n208\t\n209\t  printf '%s/index.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\"\n210\t}\n211\t\n212\t# The run's status.tsv blob — the per-run detail view the hub reads — is the\n213\t# run-status RECORD: its canonical field list and the set/get-by-name accessors\n214\t# (almanac_loop_record_*) live above. The registry functions below seed and\n215\t# update it through that record, so the schema (id/type/target/pid/\n216\t# status_file/started_at/status + the live finished_at/round/summary) is never\n217\t# enumerated here. The index.tsv is a separate lightweight list pointer (the\n218\t# record's first seven fields), written below.\n219\t\n220\t# Thin alias for the record's generic tab-field reader, kept for the worker-status\n221\t# and hub read paths that read a field by name. The implementation (and the\n222\t# run-status record's canonical getter) is almanac_loop_record_get, above.\n223\talmanac_loop_status_field() {\n224\t  almanac_loop_record_get \"$@\"\n225\t}\n226\t\n227\talmanac_loop_register_run() {\n228\t  [ \"$#\" -ge 4 ] || return 2\n229\t\n230\t  local root=\"$1\"\n231\t  local type=\"$2\"\n232\t  local target=\"$3\"\n233\t  local pid=\"$4\"\n234\t  local run_id=\"${5:-}\"\n235\t  local started_at=\"${6:-}\"\n236\t  local registry_dir run_dir status_file status_rel index_file\n237\t\n238\t  [ -n \"$root\" ] || return 2\n239\t  [ -n \"$type\" ] || return 2\n240\t  [ -n \"$target\" ] || return 2\n241\t  [ -n \"$pid\" ] || return 2\n242\t\n243\t  if [ -z \"$run_id\" ]; then\n244\t    run_id=\"$(almanac_loop_run_id \"$type\" \"$target\")\"\n245\t  fi\n246\t\n247\t  if [ -z \"$started_at\" ]; then\n248\t    started_at=\"$(almanac_loop_now_utc)\"\n249\t  fi\n250\t\n251\t  registry_dir=\"$(almanac_loop_registry_dir \"$root\")\"\n252\t  run_dir=\"$registry_dir/$run_id\"\n253\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n254\t  status_rel=\"$(almanac_loop_run_status_relpath \"$run_id\")\"\n255\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n256\t\n257\t  if [ -e \"$run_dir\" ]; then\n258\t    return 3\n259\t  fi\n260\t\n261\t  mkdir -p \"$run_dir\"\n262\t\n263\t  if [ ! -f \"$index_file\" ]; then\n264\t    printf 'id\\ttype\\ttarget\\tpid\\tstatus_file\\tstarted_at\\tstatus\\n' > \"$index_file\"\n265\t  fi\n266\t\n267\t  # Seed the run-status record by naming only the fields known at launch; the\n268\t  # record fills the rest (finished_at/round/summary blank) from the canonical\n269\t  # schema. The index row is the lightweight pointer (the record's first seven\n270\t  # fields).\n271\t  almanac_loop_record_set \"$status_file\" \"id=$run_id\" \"type=$type\" \"target=$target\" \"pid=$pid\" \"status_file=$status_rel\" \"started_at=$started_at\" \"status=running\"\n272\t  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$run_id\" \"$type\" \"$target\" \"$pid\" \"$status_rel\" \"$started_at\" \"running\" >> \"$index_file\"\n273\t  printf '%s\\n' \"$run_id\"\n274\t}\n275\t\n276\t# Set config fields on a run after registration. Thin convenience over record_set\n277\t# that names intent: \"store the resolved launch config so resume can rebuild it.\"\n278\t# Accepts any subset of the config keys (provider/model/effort/iterations/oversee\n279\t# for ralph; provider/model/effort/lenses/rounds for harden). Blank values are\n280\t# acceptable — record_set keeps the field present-but-blank. Returns 2 when the\n281\t# run is unknown so callers can guard without aborting.\n282\talmanac_loop_set_run_config() {\n283\t  [ \"$#\" -ge 3 ] || return 2\n284\t  local root=\"$1\" run_id=\"$2\"; shift 2\n285\t  local status_file\n286\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n287\t  [ -f \"$status_file\" ] || return 2\n288\t  almanac_loop_record_set \"$status_file\" \"$@\"\n289\t}\n290\t\n291\talmanac_loop_mark_run_status() {\n292\t  [ \"$#\" -ge 3 ] || return 2\n293\t\n294\t  local root=\"$1\"\n295\t  local run_id=\"$2\"\n296\t  local status=\"$3\"\n297\t  local finished_at=\"${4:-}\"\n298\t  local reason=\"${5:-}\"\n299\t  local status_file index_file tmp\n300\t\n301\t  case \"$status\" in\n302\t    done|failed|aborted) ;;\n303\t    *) return 3 ;;\n304\t  esac\n305\t\n306\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n307\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n308\t\n309\t  [ -f \"$status_file\" ] || return 2\n310\t  [ -f \"$index_file\" ] || return 2\n311\t\n312\t  if [ -z \"$finished_at\" ]; then\n313\t    finished_at=\"$(almanac_loop_now_utc)\"\n314\t  fi\n315\t\n316\t  tmp=\"$(mktemp \"${index_file}.XXXXXX\")\"\n317\t  if ! awk -v run_id=\"$run_id\" -v status=\"$status\" '\n318\t    BEGIN { FS = OFS = \"\\t\" }\n319\t    NR == 1 { print; next }\n320\t    $1 == run_id { $7 = status; found = 1 }\n321\t    { print }\n322\t    END { if (!found) exit 4 }\n323\t  ' \"$index_file\" > \"$tmp\"; then\n324\t    rm -f \"$tmp\"\n325\t    return 2\n326\t  fi\n327\t  mv \"$tmp\" \"$index_file\"\n328\t\n329\t  # Set only the lifecycle fields; record_set round-trips id/type/target/pid/\n330\t  # status_file/started_at/round/summary, so the schema is never re-enumerated.\n331\t  # An optional 5th arg supplies a one-line failure reason (typically \"exit=N\"\n332\t  # plus a log-tail hint) so the hub can show *why* a run failed, not just that\n333\t  # it did. Blank reason → leave the field as-is (running runs start blank).\n334\t  local _fields=(\"status=$status\" \"finished_at=$finished_at\")\n335\t  [ -n \"$reason\" ] && _fields+=(\"failure_reason=$reason\")\n336\t  almanac_loop_record_set \"$status_file\" \"${_fields[@]}\"\n337\t  # Best-effort end-of-run notification (macOS osascript / Linux notify-send /\n338\t  # terminal-bell fallback). Opt out via ALMANAC_NO_NOTIFY=1. Notification\n339\t  # trouble never sinks the mark — if osascript is missing or notify-send\n340\t  # errors, the run is still correctly marked.\n341\t  almanac_loop_notify_run_end \"$root\" \"$run_id\" >/dev/null 2>&1 || true\n342\t}\n343\t\n344\t# Tell the user a run reached a terminal state. Reads the just-written record so\n345\t# the notification carries type/status/target (and failure_reason on a failed\n346\t# run). Dispatch order: macOS osascript → Linux notify-send → terminal bell\n347\t# fallback (so you at least *hear* a finish on a bare server). Opt out entirely\n348\t# with ALMANAC_NO_NOTIFY=1. ALMANAC_NOTIFY_TEST_SINK (a file path) replaces the\n349\t# OS dispatcher with a write to that file, so tests can assert title+body\n350\t# without a desktop environment.\n351\talmanac_loop_notify_run_end() {\n352\t  [ -z \"${ALMANAC_NO_NOTIFY:-}\" ] || return 0\n353\t  # Skip when there's no terminal attached (tests, daemons, captured output) —\n354\t  # nobody to notify. The test sink bypasses this so unit tests can still assert\n355\t  # the dispatch path without a TTY.\n356\t  if [ -z \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n357\t    [ -t 2 ] || return 0\n358\t  fi\n359\t  local root=\"$1\" run_id=\"$2\"\n360\t  local status_file type status target reason title body body_esc title_esc\n361\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\" 2>/dev/null)\" || return 0\n362\t  [ -f \"$status_file\" ] || return 0\n363\t  type=\"$(almanac_loop_status_field \"$status_file\" type 2>/dev/null || true)\"\n364\t  status=\"$(almanac_loop_status_field \"$status_file\" status 2>/dev/null || true)\"\n365\t  target=\"$(almanac_loop_status_field \"$status_file\" target 2>/dev/null || true)\"\n366\t  reason=\"$(almanac_loop_status_field \"$status_file\" failure_reason 2>/dev/null || true)\"\n367\t  case \"$status\" in done|failed|aborted) ;; *) return 0 ;; esac\n368\t  title=\"almanac · ${type:-run} ${status}\"\n369\t  body=\"${target}${reason:+ — $reason}\"\n370\t  if [ -n \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n371\t    printf '%s|%s\\n' \"$title\" \"$body\" >> \"$ALMANAC_NOTIFY_TEST_SINK\"\n372\t    return 0\n373\t  fi\n374\t  if command -v osascript >/dev/null 2>&1; then\n375\t    body_esc=\"$(printf '%s' \"$body\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n376\t    title_esc=\"$(printf '%s' \"$title\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n377\t    osascript -e \"display notification \\\"$body_esc\\\" with title \\\"$title_esc\\\"\" >/dev/null 2>&1 || true\n378\t  elif command -v notify-send >/dev/null 2>&1; then\n379\t    notify-send \"$title\" \"$body\" >/dev/null 2>&1 || true\n380\t  else\n381\t    printf '\\a' >&2 || true\n382\t  fi\n383\t}\n384\t\n385\t# Update a live run's progress mid-flight: rewrite its status.tsv with a new\n386\t# round (harden round / ralph iteration) and worker/lens summary, preserving the\n387\t# lifecycle status, start, and finish fields. This is the \"updated as it\n388\t# progresses\" half of the run-status contract — the loop calls it each round so\n389\t# the hub's read view reflects current progress. Touches only the per-run blob,\n390\t# not index.tsv (the index stays the lightweight lifecycle pointer). Returns 2\n391\t# when the run has no status file.\n392\talmanac_loop_update_run_progress() {\n393\t  [ \"$#\" -ge 2 ] || return 2\n394\t\n395\t  local root=\"$1\"\n396\t  local run_id=\"$2\"\n397\t  local round=\"${3:-}\"\n398\t  local summary=\"${4:-}\"\n399\t  local status_file\n400\t\n401\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n402\t  [ -f \"$status_file\" ] || return 2\n403\t\n404\t  # Set only the live-progress fields; record_set preserves the identity and\n405\t  # lifecycle (status/start/finish) fields untouched.\n406\t  almanac_loop_record_set \"$status_file\" \"round=$round\" \"summary=$summary\"\n407\t}\n408\t\n409\t# Detect a stale registry entry: a run whose recorded status is still `running`\n410\t# but whose process is gone (crashed/killed without marking itself), so the hub\n411\t# can surface or reap it. Returns 0 (stale) only when status is running AND the\n412\t# pid is not alive — a numeric pid that `kill -0` cannot signal, or a missing/\n413\t# non-numeric pid that cannot be verified. Returns 1 for a live running pid or\n414\t# any terminal status; returns 2 when the run is unknown.\n415\talmanac_loop_run_is_stale() {\n416\t  local root=\"$1\"\n417\t  local run_id=\"$2\"\n418\t  local status_file status pid\n419\t\n420\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n421\t  [ -f \"$status_file\" ] || return 2\n422\t\n423\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n424\t  [ \"$status\" = \"running\" ] || return 1\n425\t\n426\t  pid=\"$(almanac_loop_status_field \"$status_file\" \"pid\" || true)\"\n427\t  case \"$pid\" in\n428\t    ''|*[!0-9]*) return 0 ;;\n429\t  esac\n430\t\n431\t  if kill -0 \"$pid\" 2>/dev/null; then\n432\t    return 1\n433\t  fi\n434\t  return 0\n435\t}\n436\t\n437\t# List every registered run as index.tsv data rows (id/type/target/pid/status-\n438\t# file/start/status), header stripped — the API the hub reads to enumerate runs.\n439\t# Returns 1 when there is no registry or no run has been registered yet, so a\n440\t# caller can branch on \"any runs?\" without parsing.\n441\talmanac_loop_list_runs() {\n442\t  local root=\"$1\"\n443\t  local index_file rows\n444\t\n445\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n446\t  [ -f \"$index_file\" ] || return 1\n447\t\n448\t  rows=\"$(awk 'NR > 1' \"$index_file\")\"\n449\t  [ -n \"$rows\" ] || return 1\n450\t\n451\t  printf '%s\\n' \"$rows\"\n452\t}\n453\t\n454\t# Read a single run's full status.tsv blob — the detail view the hub renders for\n455\t# one run (identity plus live round/summary and finish state). Returns 1 when the\n456\t# run is unknown.\n457\talmanac_loop_read_run() {\n458\t  local root=\"$1\"\n459\t  local run_id=\"$2\"\n460\t  local status_file\n461\t\n462\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n463\t  [ -f \"$status_file\" ] || return 1\n464\t\n465\t  cat \"$status_file\"\n466\t}\n467\t\n468\talmanac_loop_worker_dir() {\n469\t  local root=\"$1\"\n470\t  local run_id=\"$2\"\n471\t  local worker_id=\"$3\"\n472\t\n473\t  printf '%s/%s/workers/%s\\n' \\\n474\t    \"$(almanac_loop_registry_dir \"$root\")\" \\\n475\t    \"$run_id\" \\\n476\t    \"$(almanac_loop_slug \"$worker_id\")\"\n477\t}\n478\t\n479\talmanac_loop_worker_status_file() {\n480\t  local root=\"$1\"\n481\t  local run_id=\"$2\"\n482\t  local worker_id=\"$3\"\n483\t\n484\t  printf '%s/status.tsv\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\"\n485\t}\n486\t\n487\talmanac_loop_worker_file() {\n488\t  local root=\"$1\"\n489\t  local run_id=\"$2\"\n490\t  local worker_id=\"$3\"\n491\t  local filename=\"$4\"\n492\t\n493\t  printf '%s/%s\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\" \"$filename\"\n494\t}\n495\t\n496\t# --- Worker health detection ---------------------------------------------------\n497\t#\n498\t# Classify a worker's health from progress signals so the dashboard can surface a\n499\t# reviewer that is stalled (log stopped advancing), idle (running but never\n500\t# produced an event), or looping (emitting the same event over and over) rather\n501\t# than the operator discovering it by hand. The classifier is a PURE predicate\n502\t# over already-gathered numbers, so it is table-testable with no files, clock, or\n503\t# terminal; the gather wrapper (almanac_loop_worker_health_of) feeds it real run\n504\t# state.\n505\t\n506\t# Pure predicate: (status, log-age-secs, event-count, trailing-repeat-count,\n507\t# stall-threshold-secs, loop-repeat-threshold) -> one of\n508\t# running|stalled|idle|looping|done|failed. A terminal status passes straight\n509\t# through. For a live worker: a trailing run of identical events at/over the loop\n510\t# threshold is a loop; otherwise zero events past the stall threshold is idle, any\n511\t# log silence past the stall threshold is stalled, and anything else is running.\n512\talmanac_loop_worker_health() {\n513\t  local status=\"${1:-running}\"\n514\t  local age=\"${2:-0}\"\n515\t  local count=\"${3:-0}\"\n516\t  local repeat=\"${4:-0}\"\n517\t  local stall=\"${5:-120}\"\n518\t  local loop=\"${6:-5}\"\n519\t\n520\t  case \"$status\" in\n521\t    done)   printf '%s\\n' \"done\";   return 0 ;;\n522\t    failed) printf '%s\\n' \"failed\"; return 0 ;;\n523\t  esac\n524\t\n525\t  if [ \"$loop\" -gt 0 ] && [ \"$repeat\" -ge \"$loop\" ]; then\n526\t    printf '%s\\n' \"looping\"; return 0\n527\t  fi\n528\t  if [ \"$count\" -eq 0 ] && [ \"$age\" -ge \"$stall\" ]; then\n529\t    printf '%s\\n' \"idle\"; return 0\n530\t  fi\n531\t  if [ \"$age\" -ge \"$stall\" ]; then\n532\t    printf '%s\\n' \"stalled\"; return 0\n533\t  fi\n534\t  printf '%s\\n' \"running\"\n535\t}\n536\t\n537\t# Seconds since a file was last modified (now - mtime). Prints -1 when the file is\n538\t# absent. now-epoch is overridable (tests) so age is deterministic. Handles both\n539\t# BSD/macOS (stat -f %m) and GNU/Linux (stat -c %Y).\n540\talmanac_loop_file_age_secs() {\n541\t  local file=\"$1\"\n542\t  local now=\"${2:-}\"\n543\t  local mtime\n544\t\n545\t  [ -f \"$file\" ] || { printf '%s\\n' \"-1\"; return 0; }\n546\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n547\t  mtime=\"$(stat -f %m \"$file\" 2>/dev/null || stat -c %Y \"$file\" 2>/dev/null || printf '%s' \"\")\"\n548\t  [ -n \"$mtime\" ] || { printf '%s\\n' \"-1\"; return 0; }\n549\t  printf '%s\\n' \"$((now - mtime))\"\n550\t}\n551\t\n552\t# Count lines in a file (0 when absent). awk NR counts a final unterminated line.\n553\talmanac_loop_count_lines() {\n554\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n555\t  awk 'END { print NR }' \"$1\"\n556\t}\n557\t\n558\t# Count the trailing run of identical lines at the end of a file (0 when absent or\n559\t# empty, 1 when the last line is unique). A long run is the loop signal.\n560\talmanac_loop_trailing_repeat() {\n561\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n562\t  awk '\n563\t    NR == 1 { last = $0; c = 1; next }\n564\t    $0 == last { c++; next }\n565\t    { last = $0; c = 1 }\n566\t    END {\n567\t      if (NR == 0) { print 0; exit }\n568\t      print c\n569\t    }\n570\t  ' \"$1\"\n571\t}\n572\t\n573\t# Gather one worker's real run state and classify its health. Reads the worker's\n574\t# status.tsv (status + events-log path), measures the log's age/size/trailing\n575\t# repeat, and returns the pure predicate's verdict. Prints \"unknown\" when the\n576\t# worker has no status file yet. now/stall/loop are overridable.\n577\talmanac_loop_worker_health_of() {\n578\t  local root=\"$1\"\n579\t  local run_id=\"$2\"\n580\t  local worker_id=\"$3\"\n581\t  local now=\"${4:-}\"\n582\t  local stall=\"${5:-120}\"\n583\t  local loop=\"${6:-5}\"\n584\t  local status_file status events_file age count repeat\n585\t\n586\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n587\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"unknown\"; return 0; }\n588\t\n589\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n590\t  events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n591\t\n592\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n593\t  age=\"$(almanac_loop_file_age_secs \"$events_file\" \"$now\")\"\n594\t  count=\"$(almanac_loop_count_lines \"$events_file\")\"\n595\t  repeat=\"$(almanac_loop_trailing_repeat \"$events_file\")\"\n596\t  [ \"$age\" -ge 0 ] 2>/dev/null || age=0\n597\t\n598\t  almanac_loop_worker_health \"${status:-running}\" \"$age\" \"$count\" \"$repeat\" \"$stall\" \"$loop\"\n599\t}\n600\t\n601\t# --- Hub overview --------------------------------------------------------------\n602\t#\n603\t# The interactive hub (`almanac` in a TTY, or `almanac hub`) is the front door to\n604\t# every loop. Its read views are PURE registry projections so they are testable\n605\t# off a terminal and degrade to plain text without gum; the interactive menus\n606\t# (new-run, per-run watch/stop/steer) layer on top of these.\n607\t\n608\t# Project the run registry into one of the hub's two lists as plain printable\n609\t# rows (text only — gum frames them later, so this stays unit-testable off a\n610\t# TTY). `which` selects the section:\n611\t#   running — every run whose lifecycle status is still `running`, carrying its\n612\t#             live round/summary from the run-status blob; a running entry whose\n613\t#             pid is gone is surfaced as `stale` (almanac_loop_run_is_stale) so a\n614\t#             crashed run is visible rather than silently lost.\n615\t#   recent  — the finished runs (done/failed/aborted), newest finish first,\n616\t#             capped at `limit` (default 10).\n617\t# Each row is \"<glyph>  <state>  <type>  <target>  <detail>  [<id>]\". Returns 1\n618\t# (no rows) when the section is empty so the caller can print an empty-state line.\n619\talmanac_loop_hub_render() {\n620\t  local root=\"$1\"\n621\t  local which=\"$2\"\n622\t  local limit=\"${3:-10}\"\n623\t  local rows id type target pid status_rel started status\n624\t  local blob round summary finished detail glyph live count reason_field display queue\n625\t\n626\t  rows=\"$(almanac_loop_list_runs \"$root\")\" || return 1\n627\t  count=0\n628\t\n629\t  if [ \"$which\" = \"recent\" ]; then\n630\t    local sortable=\"\"\n631\t    while IFS=$'\\t' read -r id type target pid status_rel started status; do\n632\t      [ -n \"$id\" ] || continue\n633\t      case \"$status\" in\n634\t        done|failed|aborted) ;;\n635\t        *) continue ;;\n636\t      esac\n637\t      blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n638\t      finished=\"$(almanac_loop_status_field \"$blob\" \"finished_at\" 2>/dev/null || true)\"\n639\t      [ -n \"$finished\" ] || finished=\"$started\"\n640\t      reason_field=\"\"\n641\t      if [ \"$status\" = \"failed\" ]; then\n642\t        reason_field=\"$(almanac_loop_status_field \"$blob\" \"failure_reason\" 2>/dev/null || true)\"\n643\t      fi\n644\t      sortable+=\"$finished\"$'\\t'\"$id\"$'\\t'\"$type\"$'\\t'\"$target\"$'\\t'\"$status\"$'\\t'\"$reason_field\"$'\\n'\n645\t    done <<< \"$rows\"\n646\t    [ -n \"$sortable\" ] || return 1\n647\t    while IFS=$'\\t' read -r finished id type target status reason_field; do\n648\t      [ -n \"$id\" ] || continue\n649\t      glyph=\"$(almanac_loop_ui_status_glyph \"$status\")\"\n650\t      display=\"$finished\"\n651\t      if [ \"$status\" = \"failed\" ] && [ -n \"$reason_field\" ]; then\n652\t        display=\"$finished — $reason_field\"\n653\t      fi\n654\t      printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$status\" \"$type\" \"$target\" \"$display\" \"$id\"\n655\t      count=$((count + 1))\n656\t      if [ \"$count\" -ge \"$limit\" ]; then break; fi\n657\t    done < <(printf '%s' \"$sortable\" | sort -t$'\\t' -k1,1r)\n658\t    if [ \"$count\" -gt 0 ]; then return 0; fi\n659\t    return 1\n660\t  fi\n661\t\n662\t  # which == running (default)\n663\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n664\t    [ -n \"$id\" ] || continue\n665\t    [ \"$status\" = \"running\" ] || continue\n666\t    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n667\t    round=\"$(almanac_loop_status_field \"$blob\" \"round\" 2>/dev/null || true)\"\n668\t    summary=\"$(almanac_loop_status_field \"$blob\" \"summary\" 2>/dev/null || true)\"\n669\t    queue=\"$(almanac_loop_status_field \"$blob\" \"queue_progress\" 2>/dev/null || true)\"\n670\t    live=\"running\"\n671\t    if almanac_loop_run_is_stale \"$root\" \"$id\"; then\n672\t      live=\"stale\"\n673\t    fi\n674\t    glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n675\t    detail=\"\"\n676\t    if [ -n \"$round\" ]; then detail=\"round $round\"; fi\n677\t    if [ -n \"$summary\" ]; then detail=\"${detail:+$detail  }$summary\"; fi\n678\t    if [ -n \"$queue\" ]; then detail=\"${detail:+$detail  }queue $queue\"; fi\n679\t    if [ -z \"$detail\" ]; then detail=\"—\"; fi\n680\t    printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$live\" \"$type\" \"$target\" \"$detail\" \"$id\"\n681\t    count=$((count + 1))\n682\t  done <<< \"$rows\"\n683\t  if [ \"$count\" -gt 0 ]; then return 0; fi\n684\t  return 1\n685\t}\n686\t\n687\t# Compose the hub's read-only overview screen: a Running section (live loops from\n688\t# the registry) and a Recent section (last finished loops), each framed through\n689\t# the shared ui renderer so it shows as a gum panel on a TTY and plain text\n690\t# without gum. This is the whole hub output off a TTY and the status screen the\n691\t# interactive hub draws around its menu. Each section prints an empty-state line\n692\t# when there are no matching runs.\n693\talmanac_loop_hub_overview() {\n694\t  local root=\"$1\"\n695\t  local recent_limit=\"${2:-10}\"\n696\t  local running recent\n697\t\n698\t  {\n699\t    printf '%s\\n' \"almanac — loop hub\"\n700\t    printf '\\n'\n701\t    printf '%s\\n' \"Running\"\n702\t    if running=\"$(almanac_loop_hub_render \"$root\" running)\"; then\n703\t      printf '%s\\n' \"$running\"\n704\t    else\n705\t      printf '%s\\n' \"  (no running loops)\"\n706\t    fi\n707\t    printf '\\n'\n708\t    printf '%s\\n' \"Recent\"\n709\t    if recent=\"$(almanac_loop_hub_render \"$root\" recent \"$recent_limit\")\"; then\n710\t      printf '%s\\n' \"$recent\"\n711\t    else\n712\t      printf '%s\\n' \"  (no recent loops)\"\n713\t    fi\n714\t  } | almanac_loop_ui_render\n715\t}\n716\t\n717\t# Aggregate finished runs (done/failed/aborted) by (type, provider, model) and\n718\t# print a small table: runs + success rate. Reads provider/model from each run's\n719\t# blob, so older runs (no recorded config) bucket under `?` for the missing\n720\t# fields rather than disappearing. Returns 1 (with no output) when the registry\n721\t# has no finished runs, so the caller can print an empty-state line.\n722\t#\n723\t# Pipeline is `read registry rows → emit (type,provider,model,status) lines →\n724\t# awk groups + counts → sort by total runs desc → awk reformats with a header`.\n725\t# Pure data + awk so the table is identical with or without gum (the caller\n726\t# frames it).\n727\talmanac_loop_hub_stats() {\n728\t  local root=\"$1\"\n729\t  local rows lines id type target pid status_rel started status blob provider model\n730\t  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n731\t  [ -n \"$rows\" ] || return 1\n732\t\n733\t  lines=\"\"\n734\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n735\t    [ -n \"$id\" ] || continue\n736\t    case \"$status\" in done|failed|aborted) ;; *) continue ;; esac\n737\t    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n738\t    provider=\"$(almanac_loop_status_field \"$blob\" provider 2>/dev/null || true)\"\n739\t    model=\"$(almanac_loop_status_field \"$blob\" model 2>/dev/null || true)\"\n740\t    lines+=\"$type\"$'\\t'\"${provider:-?}\"$'\\t'\"${model:-?}\"$'\\t'\"$status\"$'\\n'\n741\t  done <<< \"$rows\"\n742\t  [ -n \"$lines\" ] || return 1\n743\t\n744\t  printf '%s' \"$lines\" | awk -F'\\t' '\n745\t    {\n746\t      key = $1 \"|\" $2 \"|\" $3\n747\t      total[key]++\n748\t      if ($4 == \"done\") done[key]++\n749\t    }\n750\t    END {\n751\t      for (k in total) {\n752\t        n = total[k]; d = (k in done) ? done[k] : 0\n753\t        rate = (n > 0) ? (d * 100.0 / n) : 0\n754\t        split(k, kk, \"|\")\n755\t        printf \"%s\\t%s\\t%s\\t%d\\t%.0f\\n\", kk[1], kk[2], kk[3], n, rate\n756\t      }\n757\t    }\n758\t  ' | sort -t$'\\t' -k4,4 -n -r | awk -F'\\t' '\n759\t    BEGIN { printf \"%-8s %-8s %-22s %6s %8s\\n\", \"type\", \"provider\", \"model\", \"runs\", \"success\" }\n760\t    { printf \"%-8s %-8s %-22s %6d %7d%%\\n\", $1, $2, $3, $4, $5 }\n761\t  '\n762\t  return 0\n763\t}\n764\t\n765\t# --- Hub per-run actions -------------------------------------------------------\n766\t#\n767\t# The interactive hub lets the operator act on a selected running loop: watch its\n768\t# live status, stop it, or queue a steer directive for its next round. These are\n769\t# pure-ish file/signal operations (no gum, no menu), so they are unit-testable and\n770\t# also drivable non-interactively (`almanac hub --stop|--steer|--watch <id>`); the\n771\t# gum selection menu in cmd/hub.sh is a thin TTY layer over them.\n772\t\n773\t# Absolute path to a loop's between-round control file under BASE: BASE joined with\n774\t# the type's stop|steer dot-file basename (`<base>/.harden-stop`, …). Centralises\n775\t# the harden/converge pattern of \"look up the signal file, prepend the path\" so\n776\t# each loop's core stops re-implementing its own _control_file wrapper. Returns 1\n777\t# when the loop type or kind is unknown.\n778\talmanac_loop_run_control_file() {\n779\t  local type=\"$1\" base=\"$2\" kind=\"$3\"\n780\t  local name\n781\t  name=\"$(almanac_loop_signal_file \"$type\" \"$kind\")\" || return 1\n782\t  printf '%s/%s\\n' \"$base\" \"$name\"\n783\t}\n784\t\n785\t# Stop a registered running run: write the run type's stop file under root (runs\n786\t# register with root = their working dir, so the loop sees it at its next\n787\t# between-round check). The registry lives in the project and is not trusted for\n788\t# host PID signaling, so hub stop never sends TERM from a recorded pid. Returns 2\n789\t# when the run is unknown, 3 when its type has no stop convention, and 4 when the\n790\t# run is already terminal/non-running.\n791\talmanac_loop_run_stop() {\n792\t  local root=\"$1\"\n793\t  local run_id=\"$2\"\n794\t  local status_file type status stop_file\n795\t\n796\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n797\t  [ -f \"$status_file\" ] || return 2\n798\t\n799\t  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n800\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n801\t  [ \"$status\" = \"running\" ] || return 4\n802\t\n803\t  stop_file=\"$(almanac_loop_signal_file \"$type\" stop)\" || return 3\n804\t  printf '%s\\n' \"stop requested via almanac hub: $run_id\" > \"$root/$stop_file\"\n805\t  return 0\n806\t}\n807\t\n808\t# Queue a steer directive for a running loop: write the directive to the run type's\n809\t# steer file under root, which the loop's next round consumes (ralph reads\n810\t# `.ralph-steer`). Returns 2 when the run is unknown, 3 when its type has no steer\n811\t# convention, and 4 when the directive is blank.\n812\talmanac_loop_run_steer() {\n813\t  local root=\"$1\"\n814\t  local run_id=\"$2\"\n815\t  local directive=\"$3\"\n816\t  local status_file type steer_file\n817\t\n818\t  if [ -z \"${directive//[[:space:]]/}\" ]; then\n819\t    return 4\n820\t  fi\n821\t\n822\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n823\t  [ -f \"$status_file\" ] || return 2\n824\t\n825\t  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n826\t  steer_file=\"$(almanac_loop_signal_file \"$type\" steer)\" || return 3\n827\t\n828\t  printf '%s\\n' \"$directive\" > \"$root/$steer_file\"\n829\t  return 0\n830\t}\n831\t\n832\t# Pure detail view of one run for the hub's per-run screen (selection confirmation\n833\t# + watch frame): identity, live status (upgraded to `stale` when a running run's\n834\t# pid is gone, like the running list), round/summary, and start/finish. Plain text\n835\t# only — gum frames it later. Returns 1 when the run is unknown.\n836\talmanac_loop_run_detail() {\n837\t  local root=\"$1\"\n838\t  local run_id=\"$2\"\n839\t  local status_file id type target status round summary started finished live glyph failure_reason\n840\t  local provider model effort iterations oversee lenses rounds queue_progress\n841\t\n842\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n843\t  [ -f \"$status_file\" ] || return 1\n844\t\n845\t  id=\"$(almanac_loop_status_field \"$status_file\" \"id\" || true)\"\n846\t  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n847\t  target=\"$(almanac_loop_status_field \"$status_file\" \"target\" || true)\"\n848\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n849\t  round=\"$(almanac_loop_status_field \"$status_file\" \"round\" || true)\"\n850\t  summary=\"$(almanac_loop_status_field \"$status_file\" \"summary\" || true)\"\n851\t  started=\"$(almanac_loop_status_field \"$status_file\" \"started_at\" || true)\"\n852\t  finished=\"$(almanac_loop_status_field \"$status_file\" \"finished_at\" || true)\"\n853\t  failure_reason=\"$(almanac_loop_status_field \"$status_file\" \"failure_reason\" || true)\"\n854\t  provider=\"$(almanac_loop_status_field \"$status_file\" \"provider\" || true)\"\n855\t  model=\"$(almanac_loop_status_field \"$status_file\" \"model\" || true)\"\n856\t  effort=\"$(almanac_loop_status_field \"$status_file\" \"effort\" || true)\"\n857\t  iterations=\"$(almanac_loop_status_field \"$status_file\" \"iterations\" || true)\"\n858\t  oversee=\"$(almanac_loop_status_field \"$status_file\" \"oversee\" || true)\"\n859\t  lenses=\"$(almanac_loop_status_field \"$status_file\" \"lenses\" || true)\"\n860\t  rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" || true)\"\n861\t  queue_progress=\"$(almanac_loop_status_field \"$status_file\" \"queue_progress\" || true)\"\n862\t\n863\t  live=\"$status\"\n864\t  if [ \"$status\" = \"running\" ] && almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n865\t    live=\"stale\"\n866\t  fi\n867\t  glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n868\t\n869\t  printf '%s  %s  %s  %s\\n' \"$glyph\" \"$live\" \"$type\" \"$target\"\n870\t  printf 'id: %s\\n' \"$id\"\n871\t  if [ -n \"$round\" ]; then printf 'round: %s\\n' \"$round\"; fi\n872\t  if [ -n \"$summary\" ]; then printf 'summary: %s\\n' \"$summary\"; fi\n873\t  if [ -n \"$started\" ]; then printf 'started: %s\\n' \"$started\"; fi\n874\t  if [ -n \"$finished\" ]; then printf 'finished: %s\\n' \"$finished\"; fi\n875\t  if [ -n \"$failure_reason\" ]; then printf 'failure: %s\\n' \"$failure_reason\"; fi\n876\t  # Launch config (recorded at register so hub --resume can rebuild the command).\n877\t  # Each line is conditional so a run without a stored value (older runs / fields\n878\t  # that don't apply to this loop type) doesn't print empty placeholders.\n879\t  [ -n \"$provider\" ]   && printf 'provider: %s\\n' \"$provider\"\n880\t  [ -n \"$model\" ]      && printf 'model: %s\\n' \"$model\"\n881\t  [ -n \"$effort\" ]     && printf 'effort: %s\\n' \"$effort\"\n882\t  [ -n \"$iterations\" ] && printf 'iterations: %s\\n' \"$iterations\"\n883\t  [ -n \"$oversee\" ]    && printf 'oversee: %s\\n' \"$oversee\"\n884\t  [ -n \"$lenses\" ]     && printf 'lenses: %s\\n' \"$lenses\"\n885\t  [ -n \"$rounds\" ]     && printf 'rounds: %s\\n' \"$rounds\"\n886\t  [ -n \"$queue_progress\" ] && printf 'queue: %s\\n' \"$queue_progress\"\n887\t  return 0\n888\t}\n889\t\n890\t# Watch a run from the hub. One-shot (default, and whenever stdout is not a TTY):\n891\t# render the run's detail once through the shared UI renderer and return — the\n892\t# testable, scripts-safe path piped callers get. Follow (`follow` + a TTY): redraw\n893\t# the detail every interval until the run reaches a terminal status, so the\n894\t# operator can tail a live loop's status from the hub (ALMANAC_HUB_WATCH_INTERVAL\n895\t# overrides the cadence). Returns 1 when the run is unknown.\n896\talmanac_loop_run_watch() {\n897\t  local root=\"$1\"\n898\t  local run_id=\"$2\"\n899\t  local mode=\"${3:-}\"\n900\t  local interval=\"${ALMANAC_HUB_WATCH_INTERVAL:-2}\"\n901\t  local status_file status\n902\t\n903\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n904\t  [ -f \"$status_file\" ] || return 1\n905\t\n906\t  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n907\t    almanac_loop_run_detail \"$root\" \"$run_id\" | almanac_loop_ui_render\n908\t    return 0\n909\t  fi\n910\t\n911\t  while :; do\n912\t    almanac_loop_ui_clear\n913\t    almanac_loop_run_detail \"$root\" \"$run_id\" | almanac_loop_ui_render\n914\t    status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n915\t    case \"$status\" in\n916\t      done|failed|aborted) break ;;\n917\t    esac\n918\t    sleep \"$interval\"\n919\t  done\n920\t  return 0\n921\t}\n922\t\n923\t# --- New-run composition (hub \"New run\" flow) -------------------------------\n924\t#\n925\t# The hub's New-run flow picks a loop type (ralph|harden), gathers config, and\n926\t# launches it. The argv/env COMPOSITION is pure (no gum, no exec) so it is unit-\n927\t# testable off a terminal and doubles as the seam the gum menu and `almanac hub\n928\t# --new … [--dry-run]` both drive: menu choices in, launch tokens out.\n929\t#\n930\t# Config arrives as `key=value` pairs (the keys the gum menu / --new flags\n931\t# collect): ralph takes prd, mode, provider, model, effort, iterations, oversee;\n932\t# harden takes target, rounds, lenses, provider, model, effort.\n933\t\n934\t# Compose the launcher argv for a new run, one token per line, starting with the\n935\t# `almanac` subcommand. The loop-specific flag shape lives in each loop adapter's\n936\t# `new_run_argv` verb (lib/loops/<name>.sh) — this dispatcher normalises the\n937\t# unknown-type vs missing-field distinction and forwards the key=val pairs:\n938\t#   - unknown loop type  -> 1\n939\t#   - missing required   -> 2 (returned by the adapter)\n940\t# Adding a loop is a single new file under lib/loops/ — this function does not\n941\t# change. Symmetric with `almanac_loop_new_run_env` below.\n942\talmanac_loop_new_run_argv() {\n943\t  local type=\"$1\"; shift\n944\t  almanac_loop_adapter_known \"$type\" || return 1\n945\t  almanac_loop_adapter_call \"$type\" new_run_argv \"$@\"\n946\t}\n947\t\n948\t# Compose the environment assignments (KEY=VALUE, one per line) a new run needs\n949\t# beyond its argv. The loop-specific env prefix lives in each loop adapter's\n950\t# `new_run_env` verb (lib/loops/<name>.sh). Returns 1 for an unknown type;\n951\t# adapters that have no env to emit (ralph today) return 0 with no output, so\n952\t# this dispatcher never branches on loop type.\n953\talmanac_loop_new_run_env() {\n954\t  local type=\"$1\"; shift\n955\t  almanac_loop_adapter_known \"$type\" || return 1\n956\t  almanac_loop_adapter_call \"$type\" new_run_env \"$@\"\n957\t}\n958\t"}]},"parent_tool_use_id":"toolu_01P2gUFsjpPXPaGsNqiTn6uA","session_id":"274f3ab8-9347-4dfe-9be3-7479874e14e0","uuid":"fba0c92b-ae7e-4dd0-806f-b38579ae34b4","timestamp":"2026-05-27T07:35:37.127Z","subagent_type":"Explore","task_description":"Explore almanac codebase for architectural friction"}
