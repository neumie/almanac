{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uf9FtXpZHtLkXJgbc4zX9X","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# hub.sh — interactive front door to almanac loops (ralph, harden)\n3\t#\n4\t# Bare `almanac` routes here on a TTY (and `almanac hub` always does). The hub\n5\t# reads the run registry under the caller's repo ($PWD/.almanac/runs) and shows\n6\t# the loops it finds: a Running section (live status) and a Recent section (last\n7\t# finished). On a TTY it opens an interactive menu — start a new run, or act on a\n8\t# running loop (watch its live status, stop it, or queue a steer directive for its\n9\t# next round). The menu is gum-styled when gum is present and degrades to a plain\n10\t# numbered menu (built on the shared almanac_loop_ui_choose/input/confirm seam)\n11\t# when gum is absent, so it works on any TTY. Off a TTY it renders the overview as\n12\t# plain text and exits — it never blocks on a menu, so `almanac hub | cat`, scripts\n13\t# and tests get a clean read view.\n14\t#\n15\t# The per-run actions are also drivable non-interactively, the seam the menu and\n16\t# scripts/tests share:\n17\t#   almanac hub --watch <id>           tail a run's live status (one frame off a TTY)\n18\t#   almanac hub --stop  <id>           signal a run to stop (loop stop file)\n19\t#   almanac hub --steer <id> <text…>   queue a steer directive for the next round\n20\t#   almanac hub --new <ralph|harden|converge> [config…] [--dry-run]\n21\t#                                      launch a new run (dry-run previews the command)\n22\t#   almanac hub --resume <id>          re-launch a finished run with the same config (auto-confirm)\n23\t#   almanac hub --clone  <id>          start the launcher pre-filled from a finished run (no auto-confirm)\n24\t#   almanac hub --stats                summarise finished runs by (type, provider, model)\n25\t\n26\tset -euo pipefail\n27\t\n28\tsource \"$ALMANAC_HOME/lib/ui.sh\"\n29\tsource \"$ALMANAC_HOME/lib/run.sh\"\n30\tsource \"$ALMANAC_HOME/lib/loop-launcher.sh\"\n31\t\n32\tROOT=\"$PWD\"\n33\t\n34\thub_usage() {\n35\t  printf '%s\\n' \"Usage:\"\n36\t  printf '%s\\n' \"  almanac hub                      open the hub (interactive on a TTY, overview otherwise)\"\n37\t  printf '%s\\n' \"  almanac hub --watch <run-id>     tail a run's live status\"\n38\t  printf '%s\\n' \"  almanac hub --stop  <run-id>     signal a run to stop\"\n39\t  printf '%s\\n' \"  almanac hub --steer <run-id> …   queue a steer directive for the next round\"\n40\t  printf '%s\\n' \"  almanac hub --new <ralph|harden|converge> [config…] [--dry-run]\"\n41\t  printf '%s\\n' \"                                  launch a new run (--dry-run previews it)\"\n42\t  printf '%s\\n' \"  almanac hub --resume <run-id>    re-launch a finished run with the same config\"\n43\t  printf '%s\\n' \"  almanac hub --clone  <run-id>    start the launcher pre-filled from a finished run\"\n44\t  printf '%s\\n' \"  almanac hub --stats              summarise finished runs (runs + success rate per provider/model)\"\n45\t}\n46\t\n47\t# Launch (or, with dry_run=1, preview) a composed new run. env_raw/argv_raw are\n48\t# the newline-token streams from almanac_loop_new_run_env / almanac_loop_new_run_argv.\n49\t# Dry-run prints the resolved `ENV… almanac <argv>` command and returns — the\n50\t# non-interactive, scripts-safe preview tests and the gum confirm both use.\n51\t# Otherwise it exports the env lines and execs the launcher, handing over the\n52\t# terminal to the new run.\n53\talmanac_hub_launch_new() {\n54\t  local dry_run=\"$1\" env_raw=\"$2\" argv_raw=\"$3\"\n55\t  local line display=\"\" argv=()\n56\t\n57\t  while IFS= read -r line; do\n58\t    [ -n \"$line\" ] || continue\n59\t    argv+=(\"$line\")\n60\t  done <<< \"$argv_raw\"\n61\t  [ \"${#argv[@]}\" -gt 0 ] || _die \"Nothing to launch\"\n62\t\n63\t  if [ \"$dry_run\" = \"1\" ]; then\n64\t    while IFS= read -r line; do\n65\t      [ -n \"$line\" ] || continue\n66\t      display+=\"$line \"\n67\t    done <<< \"$env_raw\"\n68\t    display+=\"almanac\"\n69\t    for line in \"${argv[@]}\"; do\n70\t      display+=\" $line\"\n71\t    done\n72\t    printf '%s\\n' \"$display\"\n73\t    return 0\n74\t  fi\n75\t\n76\t  while IFS= read -r line; do\n77\t    [ -n \"$line\" ] || continue\n78\t    export \"$line\"\n79\t  done <<< \"$env_raw\"\n80\t\n81\t  exec bash \"$ALMANAC_HOME/bin/almanac\" \"${argv[@]}\"\n82\t}\n83\t\n84\t# Interactive New-run flow: pick the loop type, then hand off to the shared\n85\t# almanac launcher (almanac_loop_launch), which gathers that loop's config\n86\t# through the same gum seam, summarises, confirms, and execs the runner. No\n87\t# config logic lives here — one launcher, one UX, shared with `almanac ralph`\n88\t# and `almanac harden`. On confirm the launcher execs (hands over the terminal);\n89\t# if the operator cancels first it returns here and the menu loop continues.\n90\talmanac_hub_new_run() {\n91\t  local type\n92\t  type=\"$(almanac_loop_ui_choose \"New run — pick a loop\" ralph harden converge)\" || return 0\n93\t  almanac_loop_launch \"$type\"\n94\t}\n95\t\n96\talmanac_hub_menu() {\n97\t  local root=\"$1\"\n98\t  local running line choice run_id action directive\n99\t  local options\n100\t\n101\t  while :; do\n102\t    almanac_loop_ui_clear\n103\t    almanac_loop_hub_overview \"$root\"\n104\t\n105\t    running=\"$(almanac_loop_hub_render \"$root\" running 2>/dev/null || true)\"\n106\t\n107\t    # Top-level menu: New run is always available (even with an empty registry);\n108\t    # each running loop is an actionable row carrying its \"[id]\"; quit exits.\n109\t    options=(\"+ New run\")\n110\t    if [ -n \"$running\" ]; then\n111\t      while IFS= read -r line; do\n112\t        [ -n \"$line\" ] || continue\n113\t        options+=(\"$line\")\n114\t      done <<< \"$running\"\n115\t    fi\n116\t    options+=(\"quit\")\n117\t\n118\t    choice=\"$(almanac_loop_ui_choose \"Almanac hub\" \"${options[@]}\")\" || return 0\n119\t    case \"$choice\" in\n120\t      \"+ New run\") almanac_hub_new_run \"$root\"; continue ;;\n121\t      quit) return 0 ;;\n122\t    esac\n123\t    run_id=\"$(printf '%s\\n' \"$choice\" | sed -n 's/.*\\[\\([^]]*\\)\\].*/\\1/p')\"\n124\t    [ -n \"$run_id\" ] || continue\n125\t\n126\t    action=\"$(almanac_loop_ui_choose \"Run $run_id\" watch stop steer back)\" || continue\n127\t    case \"$action\" in\n128\t      watch)\n129\t        almanac_loop_run_watch \"$root\" \"$run_id\" follow || _warn \"No status for run: $run_id\"\n130\t        ;;\n131\t      stop)\n132\t        if almanac_loop_ui_confirm \"Stop $run_id?\"; then\n133\t          if almanac_loop_run_stop \"$root\" \"$run_id\"; then\n134\t            _success \"Stop requested for $run_id\"\n135\t          else\n136\t            _warn \"Could not stop $run_id\"\n137\t          fi\n138\t        fi\n139\t        ;;\n140\t      steer)\n141\t        directive=\"$(almanac_loop_ui_input \"Steer $run_id\")\" || continue\n142\t        if almanac_loop_run_steer \"$root\" \"$run_id\" \"$directive\"; then\n143\t          _success \"Steer queued for $run_id\"\n144\t        else\n145\t          _warn \"Empty or unsupported steer for $run_id\"\n146\t        fi\n147\t        ;;\n148\t      back) : ;;\n149\t    esac\n150\t  done\n151\t}\n152\t\n153\t# Re-build a finished run's launch command from its registry blob and either\n154\t# launch it auto-confirmed (resume) or hand it to the launcher for review/edit\n155\t# (clone). The composer + exec path is the same one `--new` uses, so a resumed/\n156\t# cloned run goes through every layer a fresh launch does. The hub is fully\n157\t# loop-agnostic: the adapter's `status_to_opts` verb inverts its own status\n158\t# schema into key=val pairs the new_run composers consume; the `launch_backed`\n159\t# verb signals whether `--yes` (a launcher-only flag) is safe to append on\n160\t# resume — direct-runner loops (harden, converge) leave it undefined and never\n161\t# get the suffix.\n162\talmanac_hub_resume_or_clone() {\n163\t  local mode=\"$1\" run_id=\"$2\"\n164\t  local status_file run_type argv env_raw opts_raw\n165\t  local -a opts=()\n166\t  local line\n167\t\n168\t  status_file=\"$(almanac_loop_run_status_file \"$ROOT\" \"$run_id\")\"\n169\t  [ -f \"$status_file\" ] || _die \"Unknown run: $run_id\"\n170\t  run_type=\"$(almanac_loop_status_field \"$status_file\" type || true)\"\n171\t  [ -n \"$run_type\" ] || _die \"Run '$run_id' has no recorded type\"\n172\t\n173\t  opts_raw=\"$(almanac_loop_adapter_call \"$run_type\" status_to_opts \"$status_file\")\" \\\n174\t    || _die \"Cannot $mode run of unknown type: $run_type\"\n175\t  while IFS= read -r line; do\n176\t    [ -n \"$line\" ] || continue\n177\t    opts+=(\"$line\")\n178\t  done <<< \"$opts_raw\"\n179\t\n180\t  argv=\"$(almanac_loop_new_run_argv \"$run_type\" \"${opts[@]}\")\" \\\n181\t    || _die \"Could not compose $mode for $run_id\"\n182\t  env_raw=\"$(almanac_loop_new_run_env \"$run_type\" \"${opts[@]}\")\" || env_raw=\"\"\n183\t\n184\t  # resume auto-confirms launcher-backed loops (ralph) via --yes; loops whose\n185\t  # adapter doesn't implement `launch_backed` exec their direct runner and would\n186\t  # reject the launcher-only flag, so they get no suffix. clone leaves confirm\n187\t  # in place where a launcher is used.\n188\t  if [ \"$mode\" = \"resume\" ] && almanac_loop_adapter_call \"$run_type\" launch_backed 2>/dev/null; then\n189\t    argv=\"${argv}\"$'\\n''--yes'\n190\t  fi\n191\t  almanac_hub_launch_new 0 \"$env_raw\" \"$argv\"\n192\t}\n193\t\n194\tACTION=\"\"\n195\tACTION_ID=\"\"\n196\tSTEER_DIRECTIVE=\"\"\n197\tACTION_TYPE=\"\"\n198\tNEW_DRY_RUN=0\n199\tNEW_OPTS=()\n200\t\n201\twhile [ \"$#\" -gt 0 ]; do\n202\t  case \"$1\" in\n203\t    -h|--help)\n204\t      hub_usage\n205\t      exit 0\n206\t      ;;\n207\t    --new)\n208\t      shift\n209\t      [ \"$#\" -gt 0 ] || _die \"Missing run type for --new (ralph|harden|converge)\"\n210\t      ACTION=\"new\"\n211\t      ACTION_TYPE=\"$1\"\n212\t      shift\n213\t      # Remaining args are New-run config flags (mapped to key=value pairs the\n214\t      # pure composer consumes), plus --dry-run.\n215\t      while [ \"$#\" -gt 0 ]; do\n216\t        case \"$1\" in\n217\t          --dry-run)    NEW_DRY_RUN=1 ;;\n218\t          --prd)        shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --prd\";        NEW_OPTS+=(\"prd=$1\") ;;\n219\t          --mode)       shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --mode\";       NEW_OPTS+=(\"mode=$1\") ;;\n220\t          --provider)   shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --provider\";   NEW_OPTS+=(\"provider=$1\") ;;\n221\t          --model)      shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --model\";      NEW_OPTS+=(\"model=$1\") ;;\n222\t          --effort)     shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --effort\";     NEW_OPTS+=(\"effort=$1\") ;;\n223\t          --iterations) shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --iterations\"; NEW_OPTS+=(\"iterations=$1\") ;;\n224\t          --no-oversee) NEW_OPTS+=(\"oversee=off\") ;;\n225\t          --target)     shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --target\";     NEW_OPTS+=(\"target=$1\") ;;\n226\t          --rounds)     shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --rounds\";     NEW_OPTS+=(\"rounds=$1\") ;;\n227\t          --lenses)     shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --lenses\";     NEW_OPTS+=(\"lenses=$1\") ;;\n228\t          --goal)       shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --goal\";       NEW_OPTS+=(\"goal=$1\") ;;\n229\t          --exec)       shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --exec\";       NEW_OPTS+=(\"exec=$1\") ;;\n230\t          --prompt)     shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --prompt\";     NEW_OPTS+=(\"prompt=$1\") ;;\n231\t          --oversee-every) shift; [ \"$#\" -gt 0 ] || _die \"Missing value for --oversee-every\"; NEW_OPTS+=(\"oversee_every=$1\") ;;\n232\t          -*) _die \"Unknown hub --new option: $1\" ;;\n233\t          *)  _die \"Unexpected hub --new argument: $1\" ;;\n234\t        esac\n235\t        shift\n236\t      done\n237\t      break\n238\t      ;;\n239\t    --watch)\n240\t      shift\n241\t      [ \"$#\" -gt 0 ] || _die \"Missing run id for --watch\"\n242\t      ACTION=\"watch\"\n243\t      ACTION_ID=\"$1\"\n244\t      ;;\n245\t    --stop)\n246\t      shift\n247\t      [ \"$#\" -gt 0 ] || _die \"Missing run id for --stop\"\n248\t      ACTION=\"stop\"\n249\t      ACTION_ID=\"$1\"\n250\t      ;;\n251\t    --steer)\n252\t      shift\n253\t      [ \"$#\" -gt 0 ] || _die \"Missing run id for --steer\"\n254\t      ACTION=\"steer\"\n255\t      ACTION_ID=\"$1\"\n256\t      shift\n257\t      STEER_DIRECTIVE=\"${*:-}\"\n258\t      break\n259\t      ;;\n260\t    --resume)\n261\t      shift\n262\t      [ \"$#\" -gt 0 ] || _die \"Missing run id for --resume\"\n263\t      ACTION=\"resume\"\n264\t      ACTION_ID=\"$1\"\n265\t      ;;\n266\t    --clone)\n267\t      shift\n268\t      [ \"$#\" -gt 0 ] || _die \"Missing run id for --clone\"\n269\t      ACTION=\"clone\"\n270\t      ACTION_ID=\"$1\"\n271\t      ;;\n272\t    --stats)\n273\t      ACTION=\"stats\"\n274\t      ;;\n275\t    -*)\n276\t      _die \"Unknown hub option: $1\"\n277\t      ;;\n278\t    *)\n279\t      _die \"Unexpected hub argument: $1\"\n280\t      ;;\n281\t  esac\n282\t  shift\n283\tdone\n284\t\n285\tcase \"$ACTION\" in\n286\t  watch)\n287\t    almanac_loop_run_watch \"$ROOT\" \"$ACTION_ID\" follow || _die \"Unknown run: $ACTION_ID\"\n288\t    exit 0\n289\t    ;;\n290\t  stop)\n291\t    STOP_RC=0\n292\t    almanac_loop_run_stop \"$ROOT\" \"$ACTION_ID\" || STOP_RC=\"$?\"\n293\t    case \"$STOP_RC\" in\n294\t      0) _success \"Stop requested for run: $ACTION_ID\"; exit 0 ;;\n295\t      2) _die \"Unknown run: $ACTION_ID\" ;;\n296\t      3) _die \"Run '$ACTION_ID' has no stop convention\" ;;\n297\t      *) _die \"Failed to stop run: $ACTION_ID\" ;;\n298\t    esac\n299\t    ;;\n300\t  steer)\n301\t    STEER_RC=0\n302\t    almanac_loop_run_steer \"$ROOT\" \"$ACTION_ID\" \"$STEER_DIRECTIVE\" || STEER_RC=\"$?\"\n303\t    case \"$STEER_RC\" in\n304\t      0) _success \"Steer queued for run: $ACTION_ID\"; exit 0 ;;\n305\t      2) _die \"Unknown run: $ACTION_ID\" ;;\n306\t      3) _die \"Run '$ACTION_ID' has no steer convention\" ;;\n307\t      4) _die \"Steer directive is empty\" ;;\n308\t      *) _die \"Failed to steer run: $ACTION_ID\" ;;\n309\t    esac\n310\t    ;;\n311\t  new)\n312\t    NEW_RC=0\n313\t    if [ \"${#NEW_OPTS[@]}\" -gt 0 ]; then\n314\t      NEW_ARGV_RAW=\"$(almanac_loop_new_run_argv \"$ACTION_TYPE\" \"${NEW_OPTS[@]}\")\" || NEW_RC=\"$?\"\n315\t    else\n316\t      NEW_ARGV_RAW=\"$(almanac_loop_new_run_argv \"$ACTION_TYPE\")\" || NEW_RC=\"$?\"\n317\t    fi\n318\t    case \"$NEW_RC\" in\n319\t      0) ;;\n320\t      1) _die \"Unknown run type: $ACTION_TYPE (use ralph or harden)\" ;;\n321\t      2) _die \"Missing required config for $ACTION_TYPE (ralph needs --prd, harden needs --target)\" ;;\n322\t      *) _die \"Could not compose $ACTION_TYPE run\" ;;\n323\t    esac\n324\t    if [ \"${#NEW_OPTS[@]}\" -gt 0 ]; then\n325\t      NEW_ENV_RAW=\"$(almanac_loop_new_run_env \"$ACTION_TYPE\" \"${NEW_OPTS[@]}\")\" || NEW_ENV_RAW=\"\"\n326\t    else\n327\t      NEW_ENV_RAW=\"$(almanac_loop_new_run_env \"$ACTION_TYPE\")\" || NEW_ENV_RAW=\"\"\n328\t    fi\n329\t    almanac_hub_launch_new \"$NEW_DRY_RUN\" \"$NEW_ENV_RAW\" \"$NEW_ARGV_RAW\"\n330\t    exit 0\n331\t    ;;\n332\t  resume|clone)\n333\t    almanac_hub_resume_or_clone \"$ACTION\" \"$ACTION_ID\"\n334\t    exit 0\n335\t    ;;\n336\t  stats)\n337\t    if STATS_OUT=\"$(almanac_loop_hub_stats \"$ROOT\")\"; then\n338\t      printf '%s\\n' \"$STATS_OUT\" | almanac_loop_ui_render\n339\t    else\n340\t      printf '%s\\n' \"(no finished runs to summarise)\" | almanac_loop_ui_render\n341\t    fi\n342\t    exit 0\n343\t    ;;\n344\tesac\n345\t\n346\t# No explicit action: bare hub. On a TTY, open the interactive menu — always, even\n347\t# with an empty registry, so New run is reachable with no prior runs. The menu\n348\t# degrades internally: gum-styled when gum is present, plain numbered menus (via\n349\t# the shared almanac_loop_ui_* seam) when it is absent. Off a TTY (piped/captured)\n350\t# render the read-only overview once — the scripts-safe path tests and pipes get.\n351\tif [ -t 0 ] && [ -t 1 ]; then\n352\t  almanac_hub_menu \"$ROOT\"\n353\telse\n354\t  almanac_loop_hub_overview \"$ROOT\"\n355\tfi\n356\t"}]},"parent_tool_use_id":"toolu_01P2gUFsjpPXPaGsNqiTn6uA","session_id":"274f3ab8-9347-4dfe-9be3-7479874e14e0","uuid":"a5a73d56-c7b9-43b9-8dc4-79bed136607d","timestamp":"2026-05-27T07:35:44.106Z","subagent_type":"Explore","task_description":"Explore almanac codebase for architectural friction"}
