{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017DuzSZbRAG9wamSShHbMyd","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# test-loops.sh - loop-adapter seam tests (lib/loops.sh + lib/loops/*)\n3\t#\n4\t# Sources lib/loops.sh DIRECTLY (not through loop-core / the launcher) so the\n5\t# seam's interface is its own test surface. The adapters are pure config (exec\n6\t# argv composition + signal-file mapping), so nothing here calls a real runner —\n7\t# exec_argv is asserted against a fake $ALMANAC_HOME, never executed.\n8\t\n9\tset -euo pipefail\n10\t\n11\tROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n12\tsource \"$ROOT/lib/loops.sh\"\n13\t\n14\tfail() {\n15\t  echo \"  FAIL: $1\" >&2\n16\t  exit 1\n17\t}\n18\t\n19\tassert_eq() {\n20\t  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n21\t  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n22\t}\n23\t\n24\ttest_discovery_lists_present_adapters() {\n25\t  local list\n26\t  list=\"$(almanac_loop_adapter_list)\"\n27\t  case \"$list\" in *ralph*) ;; *) fail \"loop list should include the ralph adapter file\" ;; esac\n28\t  case \"$list\" in *harden*) ;; *) fail \"loop list should include the harden adapter file\" ;; esac\n29\t  case \"$list\" in *converge*) ;; *) fail \"loop list should include the converge adapter file\" ;; esac\n30\t\n31\t  almanac_loop_adapter_known ralph  || fail \"ralph must be a known loop\"\n32\t  almanac_loop_adapter_known harden || fail \"harden must be a known loop\"\n33\t  almanac_loop_adapter_known converge || fail \"converge must be a known loop\"\n34\t  almanac_loop_adapter_known RALPH  || fail \"known must normalise case (RALPH -> ralph)\"\n35\t  if almanac_loop_adapter_known bogus; then fail \"an undiscovered name must not be known\"; fi\n36\t  echo \"  PASS: discovery lists present adapters\"\n37\t}\n38\t\n39\ttest_dispatch_rejects_unknown_verb() {\n40\t  local rc=0\n41\t  almanac_loop_adapter_call ralph no_such_verb >/dev/null 2>&1 || rc=$?\n42\t  assert_eq 2 \"$rc\" \"dispatch should return 2 for a verb the adapter does not implement\"\n43\t  echo \"  PASS: dispatch rejects an unimplemented verb\"\n44\t}\n45\t\n46\ttest_signal_file_control_contract() {\n47\t  # The control contract is the resolved signal-file (adapter override OR default\n48\t  # convention from lib/loops.sh). Adapters that follow the standard\n49\t  # `.${name}-${kind}` pattern need not define signal_file at all — the default\n50\t  # provides it. Test at the public resolver, not the adapter, so deleting the\n51\t  # three identical adapter functions doesn't break this surface.\n52\t  assert_eq \".ralph-stop\"   \"$(almanac_loop_signal_file ralph stop)\"   \"ralph stop file basename\"\n53\t  assert_eq \".ralph-steer\"  \"$(almanac_loop_signal_file ralph steer)\"  \"ralph steer file basename\"\n54\t  assert_eq \".harden-stop\"  \"$(almanac_loop_signal_file harden stop)\"  \"harden stop file basename\"\n55\t  assert_eq \".harden-steer\" \"$(almanac_loop_signal_file harden steer)\" \"harden steer file basename\"\n56\t  assert_eq \".converge-stop\" \"$(almanac_loop_signal_file converge stop)\" \"converge stop file basename\"\n57\t  assert_eq \".converge-steer\" \"$(almanac_loop_signal_file converge steer)\" \"converge steer file basename\"\n58\t\n59\t  local rc=0\n60\t  almanac_loop_signal_file ralph bogus >/dev/null 2>&1 || rc=$?\n61\t  [ \"$rc\" -ne 0 ] || fail \"an unknown signal kind should be rejected\"\n62\t\n63\t  rc=0\n64\t  almanac_loop_signal_file bogus stop >/dev/null 2>&1 || rc=$?\n65\t  [ \"$rc\" -ne 0 ] || fail \"an unknown loop name should be rejected\"\n66\t\n67\t  # The default applies to a hypothetical new loop without writing a single\n68\t  # signal_file function — this is the deepening claim under test.\n69\t  assert_eq \".future-stop\"  \"$(almanac_loop_default_signal_file future stop)\"  \"default signal file applies to any loop name\"\n70\t  assert_eq \".future-steer\" \"$(almanac_loop_default_signal_file future steer)\" \"default signal file applies to any loop name\"\n71\t  echo \"  PASS: signal_file control contract\"\n72\t}\n73\t\n74\ttest_ralph_exec_argv_launch_contract() {\n75\t  local ALMANAC_HOME=\"/fake/home\"\n76\t\n77\t  almanac_loop_adapter_call ralph exec_argv once \"demo-prd\"\n78\t  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/once.sh demo-prd\" \\\n79\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph once exec argv\"\n80\t\n81\t  almanac_loop_adapter_call ralph exec_argv afk \"demo-prd\" \"7\"\n82\t  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/afk.sh demo-prd 7\" \\\n83\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph afk exec argv\"\n84\t\n85\t  local rc=0\n86\t  almanac_loop_adapter_call ralph exec_argv bogus \"demo-prd\" >/dev/null 2>&1 || rc=$?\n87\t  assert_eq 2 \"$rc\" \"an unknown ralph mode should be rejected\"\n88\t  echo \"  PASS: ralph exec_argv launch contract\"\n89\t}\n90\t\n91\ttest_harden_exec_argv_launch_contract() {\n92\t  local ALMANAC_HOME=\"/fake/home\"\n93\t\n94\t  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\"\n95\t  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop\" \\\n96\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (no rounds)\"\n97\t\n98\t  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\" \"3\"\n99\t  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop --rounds 3\" \\\n100\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (with rounds)\"\n101\t  echo \"  PASS: harden exec_argv launch contract\"\n102\t}\n103\t\n104\ttest_converge_exec_argv_launch_contract() {\n105\t  local ALMANAC_HOME=\"/fake/home\"\n106\t  local rc\n107\t\n108\t  # Minimum exec-mode: goal + exec\n109\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\"\n110\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi\" \\\n111\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (exec-mode goal + action)\"\n112\t\n113\t  # Minimum prompt-mode: goal + prompt\n114\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"prompt\" \"/almanac:codebase-improve\"\n115\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --prompt /almanac:codebase-improve\" \\\n116\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (prompt-mode goal + action)\"\n117\t\n118\t  # With rounds (4th positional)\n119\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\"\n120\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --rounds 5\" \\\n121\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with rounds)\"\n122\t\n123\t  # With --no-oversee (5th positional, non-empty + non-\"0\" enables)\n124\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\" \"1\"\n125\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --rounds 5 --no-oversee\" \\\n126\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with --no-oversee)\"\n127\t\n128\t  # An empty no_oversee or \"0\" must NOT emit the flag\n129\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\" \"\"\n130\t  case \" ${_ALMANAC_LOOP_ARGV[*]} \" in\n131\t    *\" --no-oversee \"*) fail \"empty no_oversee must NOT emit --no-oversee\" ;;\n132\t  esac\n133\t\n134\t  # With --oversee-every (6th positional)\n135\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"\" \"\" \"3\"\n136\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --oversee-every 3\" \\\n137\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with --oversee-every)\"\n138\t\n139\t  # Unknown mode returns 2\n140\t  rc=0; almanac_loop_adapter_call converge exec_argv \"ship it\" \"bogus\" \"x\" >/dev/null 2>&1 || rc=$?\n141\t  assert_eq \"2\" \"$rc\" \"converge exec_argv must return 2 for an unknown mode\"\n142\t\n143\t  echo \"  PASS: converge exec_argv launch contract\"\n144\t}\n145\t\n146\ttest_kv_get_picks_value() {\n147\t  assert_eq \"auth-system\" \"$(_almanac_loop_kv_get prd prd=auth-system mode=afk)\" \"kv_get picks the matching value\"\n148\t  assert_eq \"afk\"         \"$(_almanac_loop_kv_get mode prd=auth-system mode=afk)\" \"kv_get scans every pair\"\n149\t  assert_eq \"\"            \"$(_almanac_loop_kv_get missing prd=auth-system)\"      \"kv_get echoes empty for an absent key\"\n150\t  assert_eq \"\"            \"$(_almanac_loop_kv_get prd)\"                          \"kv_get echoes empty with no pairs\"\n151\t  # A value that contains `=` round-trips (e.g. converge --exec foo=bar).\n152\t  assert_eq \"echo foo=bar\" \"$(_almanac_loop_kv_get exec \"exec=echo foo=bar\")\"    \"kv_get preserves '=' in values\"\n153\t  # Last pair wins (matches the case-statement semantics the loops used inline).\n154\t  assert_eq \"second\" \"$(_almanac_loop_kv_get k k=first k=second)\" \"kv_get: later pair wins\"\n155\t  echo \"  PASS: _almanac_loop_kv_get\"\n156\t}\n157\t\n158\techo \"=== Loop Seam Tests ===\"\n159\ttest_discovery_lists_present_adapters\n160\ttest_dispatch_rejects_unknown_verb\n161\ttest_signal_file_control_contract\n162\ttest_ralph_exec_argv_launch_contract\n163\ttest_harden_exec_argv_launch_contract\n164\ttest_converge_exec_argv_launch_contract\n165\ttest_kv_get_picks_value\n166\t\n167\techo \"All loop seam tests passed.\"\n168\t"}]},"parent_tool_use_id":null,"session_id":"5a7c94be-b519-4ed0-b07c-6b329c049eda","uuid":"9692108e-607e-401c-9692-a1322258e564","timestamp":"2026-05-27T07:42:10.539Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/tests/test-loops.sh","content":"#!/usr/bin/env bash\n# test-loops.sh - loop-adapter seam tests (lib/loops.sh + lib/loops/*)\n#\n# Sources lib/loops.sh DIRECTLY (not through loop-core / the launcher) so the\n# seam's interface is its own test surface. The adapters are pure config (exec\n# argv composition + signal-file mapping), so nothing here calls a real runner —\n# exec_argv is asserted against a fake $ALMANAC_HOME, never executed.\n\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nsource \"$ROOT/lib/loops.sh\"\n\nfail() {\n  echo \"  FAIL: $1\" >&2\n  exit 1\n}\n\nassert_eq() {\n  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n}\n\ntest_discovery_lists_present_adapters() {\n  local list\n  list=\"$(almanac_loop_adapter_list)\"\n  case \"$list\" in *ralph*) ;; *) fail \"loop list should include the ralph adapter file\" ;; esac\n  case \"$list\" in *harden*) ;; *) fail \"loop list should include the harden adapter file\" ;; esac\n  case \"$list\" in *converge*) ;; *) fail \"loop list should include the converge adapter file\" ;; esac\n\n  almanac_loop_adapter_known ralph  || fail \"ralph must be a known loop\"\n  almanac_loop_adapter_known harden || fail \"harden must be a known loop\"\n  almanac_loop_adapter_known converge || fail \"converge must be a known loop\"\n  almanac_loop_adapter_known RALPH  || fail \"known must normalise case (RALPH -> ralph)\"\n  if almanac_loop_adapter_known bogus; then fail \"an undiscovered name must not be known\"; fi\n  echo \"  PASS: discovery lists present adapters\"\n}\n\ntest_dispatch_rejects_unknown_verb() {\n  local rc=0\n  almanac_loop_adapter_call ralph no_such_verb >/dev/null 2>&1 || rc=$?\n  assert_eq 2 \"$rc\" \"dispatch should return 2 for a verb the adapter does not implement\"\n  echo \"  PASS: dispatch rejects an unimplemented verb\"\n}\n\ntest_signal_file_control_contract() {\n  # The control contract is the resolved signal-file (adapter override OR default\n  # convention from lib/loops.sh). Adapters that follow the standard\n  # `.${name}-${kind}` pattern need not define signal_file at all — the default\n  # provides it. Test at the public resolver, not the adapter, so deleting the\n  # three identical adapter functions doesn't break this surface.\n  assert_eq \".ralph-stop\"   \"$(almanac_loop_signal_file ralph stop)\"   \"ralph stop file basename\"\n  assert_eq \".ralph-steer\"  \"$(almanac_loop_signal_file ralph steer)\"  \"ralph steer file basename\"\n  assert_eq \".harden-stop\"  \"$(almanac_loop_signal_file harden stop)\"  \"harden stop file basename\"\n  assert_eq \".harden-steer\" \"$(almanac_loop_signal_file harden steer)\" \"harden steer file basename\"\n  assert_eq \".converge-stop\" \"$(almanac_loop_signal_file converge stop)\" \"converge stop file basename\"\n  assert_eq \".converge-steer\" \"$(almanac_loop_signal_file converge steer)\" \"converge steer file basename\"\n\n  local rc=0\n  almanac_loop_signal_file ralph bogus >/dev/null 2>&1 || rc=$?\n  [ \"$rc\" -ne 0 ] || fail \"an unknown signal kind should be rejected\"\n\n  rc=0\n  almanac_loop_signal_file bogus stop >/dev/null 2>&1 || rc=$?\n  [ \"$rc\" -ne 0 ] || fail \"an unknown loop name should be rejected\"\n\n  # The default applies to a hypothetical new loop without writing a single\n  # signal_file function — this is the deepening claim under test.\n  assert_eq \".future-stop\"  \"$(almanac_loop_default_signal_file future stop)\"  \"default signal file applies to any loop name\"\n  assert_eq \".future-steer\" \"$(almanac_loop_default_signal_file future steer)\" \"default signal file applies to any loop name\"\n  echo \"  PASS: signal_file control contract\"\n}\n\ntest_ralph_exec_argv_launch_contract() {\n  local ALMANAC_HOME=\"/fake/home\"\n\n  almanac_loop_adapter_call ralph exec_argv once \"demo-prd\"\n  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/once.sh demo-prd\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph once exec argv\"\n\n  almanac_loop_adapter_call ralph exec_argv afk \"demo-prd\" \"7\"\n  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/afk.sh demo-prd 7\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph afk exec argv\"\n\n  local rc=0\n  almanac_loop_adapter_call ralph exec_argv bogus \"demo-prd\" >/dev/null 2>&1 || rc=$?\n  assert_eq 2 \"$rc\" \"an unknown ralph mode should be rejected\"\n  echo \"  PASS: ralph exec_argv launch contract\"\n}\n\ntest_harden_exec_argv_launch_contract() {\n  local ALMANAC_HOME=\"/fake/home\"\n\n  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\"\n  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (no rounds)\"\n\n  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\" \"3\"\n  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop --rounds 3\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (with rounds)\"\n  echo \"  PASS: harden exec_argv launch contract\"\n}\n\ntest_converge_exec_argv_launch_contract() {\n  local ALMANAC_HOME=\"/fake/home\"\n  local rc\n\n  # Minimum exec-mode: goal + exec\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (exec-mode goal + action)\"\n\n  # Minimum prompt-mode: goal + prompt\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"prompt\" \"/almanac:codebase-improve\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --prompt /almanac:codebase-improve\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (prompt-mode goal + action)\"\n\n  # With rounds (4th positional)\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --rounds 5\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with rounds)\"\n\n  # With --no-oversee (5th positional, non-empty + non-\"0\" enables)\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\" \"1\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --rounds 5 --no-oversee\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with --no-oversee)\"\n\n  # An empty no_oversee or \"0\" must NOT emit the flag\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\" \"\"\n  case \" ${_ALMANAC_LOOP_ARGV[*]} \" in\n    *\" --no-oversee \"*) fail \"empty no_oversee must NOT emit --no-oversee\" ;;\n  esac\n\n  # With --oversee-every (6th positional)\n  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"\" \"\" \"3\"\n  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --oversee-every 3\" \\\n    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with --oversee-every)\"\n\n  # Unknown mode returns 2\n  rc=0; almanac_loop_adapter_call converge exec_argv \"ship it\" \"bogus\" \"x\" >/dev/null 2>&1 || rc=$?\n  assert_eq \"2\" \"$rc\" \"converge exec_argv must return 2 for an unknown mode\"\n\n  echo \"  PASS: converge exec_argv launch contract\"\n}\n\ntest_kv_get_picks_value() {\n  assert_eq \"auth-system\" \"$(_almanac_loop_kv_get prd prd=auth-system mode=afk)\" \"kv_get picks the matching value\"\n  assert_eq \"afk\"         \"$(_almanac_loop_kv_get mode prd=auth-system mode=afk)\" \"kv_get scans every pair\"\n  assert_eq \"\"            \"$(_almanac_loop_kv_get missing prd=auth-system)\"      \"kv_get echoes empty for an absent key\"\n  assert_eq \"\"            \"$(_almanac_loop_kv_get prd)\"                          \"kv_get echoes empty with no pairs\"\n  # A value that contains `=` round-trips (e.g. converge --exec foo=bar).\n  assert_eq \"echo foo=bar\" \"$(_almanac_loop_kv_get exec \"exec=echo foo=bar\")\"    \"kv_get preserves '=' in values\"\n  # Last pair wins (matches the case-statement semantics the loops used inline).\n  assert_eq \"second\" \"$(_almanac_loop_kv_get k k=first k=second)\" \"kv_get: later pair wins\"\n  echo \"  PASS: _almanac_loop_kv_get\"\n}\n\necho \"=== Loop Seam Tests ===\"\ntest_discovery_lists_present_adapters\ntest_dispatch_rejects_unknown_verb\ntest_signal_file_control_contract\ntest_ralph_exec_argv_launch_contract\ntest_harden_exec_argv_launch_contract\ntest_converge_exec_argv_launch_contract\ntest_kv_get_picks_value\n\necho \"All loop seam tests passed.\"\n","numLines":168,"startLine":1,"totalLines":168}}}
