{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0112owyuXpXpKR3jwThZZruy","type":"tool_result","content":"500\t# produced an event), or looping (emitting the same event over and over) rather\n501\t# than the operator discovering it by hand. The classifier is a PURE predicate\n502\t# over already-gathered numbers, so it is table-testable with no files, clock, or\n503\t# terminal; the gather wrapper (almanac_loop_worker_health_of) feeds it real run\n504\t# state.\n505\t\n506\t# Pure predicate: (status, log-age-secs, event-count, trailing-repeat-count,\n507\t# stall-threshold-secs, loop-repeat-threshold) -> one of\n508\t# running|stalled|idle|looping|done|failed. A terminal status passes straight\n509\t# through. For a live worker: a trailing run of identical events at/over the loop\n510\t# threshold is a loop; otherwise zero events past the stall threshold is idle, any\n511\t# log silence past the stall threshold is stalled, and anything else is running.\n512\talmanac_loop_worker_health() {\n513\t  local status=\"${1:-running}\"\n514\t  local age=\"${2:-0}\"\n515\t  local count=\"${3:-0}\"\n516\t  local repeat=\"${4:-0}\"\n517\t  local stall=\"${5:-120}\"\n518\t  local loop=\"${6:-5}\"\n519\t\n520\t  case \"$status\" in\n521\t    done)   printf '%s\\n' \"done\";   return 0 ;;\n522\t    failed) printf '%s\\n' \"failed\"; return 0 ;;\n523\t  esac\n524\t\n525\t  if [ \"$loop\" -gt 0 ] && [ \"$repeat\" -ge \"$loop\" ]; then\n526\t    printf '%s\\n' \"looping\"; return 0\n527\t  fi\n528\t  if [ \"$count\" -eq 0 ] && [ \"$age\" -ge \"$stall\" ]; then\n529\t    printf '%s\\n' \"idle\"; return 0\n530\t  fi\n531\t  if [ \"$age\" -ge \"$stall\" ]; then\n532\t    printf '%s\\n' \"stalled\"; return 0\n533\t  fi\n534\t  printf '%s\\n' \"running\"\n535\t}\n536\t\n537\t# Seconds since a file was last modified (now - mtime). Prints -1 when the file is\n538\t# absent. now-epoch is overridable (tests) so age is deterministic. Handles both\n539\t# BSD/macOS (stat -f %m) and GNU/Linux (stat -c %Y).\n540\talmanac_loop_file_age_secs() {\n541\t  local file=\"$1\"\n542\t  local now=\"${2:-}\"\n543\t  local mtime\n544\t\n545\t  [ -f \"$file\" ] || { printf '%s\\n' \"-1\"; return 0; }\n546\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n547\t  mtime=\"$(stat -f %m \"$file\" 2>/dev/null || stat -c %Y \"$file\" 2>/dev/null || printf '%s' \"\")\"\n548\t  [ -n \"$mtime\" ] || { printf '%s\\n' \"-1\"; return 0; }\n549\t  printf '%s\\n' \"$((now - mtime))\"\n550\t}\n551\t\n552\t# Count lines in a file (0 when absent). awk NR counts a final unterminated line.\n553\talmanac_loop_count_lines() {\n554\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n555\t  awk 'END { print NR }' \"$1\"\n556\t}\n557\t\n558\t# Count the trailing run of identical lines at the end of a file (0 when absent or\n559\t# empty, 1 when the last line is unique). A long run is the loop signal.\n560\talmanac_loop_trailing_repeat() {\n561\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n562\t  awk '\n563\t    NR == 1 { last = $0; c = 1; next }\n564\t    $0 == last { c++; next }\n565\t    { last = $0; c = 1 }\n566\t    END {\n567\t      if (NR == 0) { print 0; exit }\n568\t      print c\n569\t    }\n570\t  ' \"$1\"\n571\t}\n572\t\n573\t# Gather one worker's real run state and classify its health. Reads the worker's\n574\t# status.tsv (status + events-log path), measures the log's age/size/trailing\n575\t# repeat, and returns the pure predicate's verdict. Prints \"unknown\" when the\n576\t# worker has no status file yet. now/stall/loop are overridable.\n577\talmanac_loop_worker_health_of() {\n578\t  local root=\"$1\"\n579\t  local run_id=\"$2\"\n580\t  local worker_id=\"$3\"\n581\t  local now=\"${4:-}\"\n582\t  local stall=\"${5:-120}\"\n583\t  local loop=\"${6:-5}\"\n584\t  local status_file status events_file age count repeat\n585\t\n586\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n587\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"unknown\"; return 0; }\n588\t\n589\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n590\t  events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n591\t\n592\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n593\t  age=\"$(almanac_loop_file_age_secs \"$events_file\" \"$now\")\"\n594\t  count=\"$(almanac_loop_count_lines \"$events_file\")\"\n595\t  repeat=\"$(almanac_loop_trailing_repeat \"$events_file\")\"\n596\t  [ \"$age\" -ge 0 ] 2>/dev/null || age=0\n597\t\n598\t  almanac_loop_worker_health \"${status:-running}\" \"$age\" \"$count\" \"$repeat\" \"$stall\" \"$loop\"\n599\t}\n600\t\n601\t# --- Hub overview --------------------------------------------------------------\n602\t#\n603\t# The interactive hub (`almanac` in a TTY, or `almanac hub`) is the front door to\n604\t# every loop. Its read views are PURE registry projections so they are testable\n605\t# off a terminal and degrade to plain text without gum; the interactive menus\n606\t# (new-run, per-run watch/stop/steer) layer on top of these.\n607\t\n608\t# Project the run registry into one of the hub's two lists as plain printable\n609\t# rows (text only — gum frames them later, so this stays unit-testable off a\n610\t# TTY). `which` selects the section:\n611\t#   running — every run whose lifecycle status is still `running`, carrying its\n612\t#             live round/summary from the run-status blob; a running entry whose\n613\t#             pid is gone is surfaced as `stale` (almanac_loop_run_is_stale) so a\n614\t#             crashed run is visible rather than silently lost.\n615\t#   recent  — the finished runs (done/failed/aborted), newest finish first,\n616\t#             capped at `limit` (default 10).\n617\t# Each row is \"<glyph>  <state>  <type>  <target>  <detail>  [<id>]\". Returns 1\n618\t# (no rows) when the section is empty so the caller can print an empty-state line.\n619\talmanac_loop_hub_render() {\n620\t  local root=\"$1\"\n621\t  local which=\"$2\"\n622\t  local limit=\"${3:-10}\"\n623\t  local rows id type target pid status_rel started status\n624\t  local blob round summary finished detail glyph live count reason_field display queue\n625\t\n626\t  rows=\"$(almanac_loop_list_runs \"$root\")\" || return 1\n627\t  count=0\n628\t\n629\t  if [ \"$which\" = \"recent\" ]; then\n630\t    local sortable=\"\"\n631\t    while IFS=$'\\t' read -r id type target pid status_rel started status; do\n632\t      [ -n \"$id\" ] || continue\n633\t      case \"$status\" in\n634\t        done|failed|aborted) ;;\n635\t        *) continue ;;\n636\t      esac\n637\t      blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n638\t      finished=\"$(almanac_loop_status_field \"$blob\" \"finished_at\" 2>/dev/null || true)\"\n639\t      [ -n \"$finished\" ] || finished=\"$started\"\n640\t      reason_field=\"\"\n641\t      if [ \"$status\" = \"failed\" ]; then\n642\t        reason_field=\"$(almanac_loop_status_field \"$blob\" \"failure_reason\" 2>/dev/null || true)\"\n643\t      fi\n644\t      sortable+=\"$finished\"$'\\t'\"$id\"$'\\t'\"$type\"$'\\t'\"$target\"$'\\t'\"$status\"$'\\t'\"$reason_field\"$'\\n'\n645\t    done <<< \"$rows\"\n646\t    [ -n \"$sortable\" ] || return 1\n647\t    while IFS=$'\\t' read -r finished id type target status reason_field; do\n648\t      [ -n \"$id\" ] || continue\n649\t      glyph=\"$(almanac_loop_ui_status_glyph \"$status\")\"\n650\t      display=\"$finished\"\n651\t      if [ \"$status\" = \"failed\" ] && [ -n \"$reason_field\" ]; then\n652\t        display=\"$finished — $reason_field\"\n653\t      fi\n654\t      printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$status\" \"$type\" \"$target\" \"$display\" \"$id\"\n655\t      count=$((count + 1))\n656\t      if [ \"$count\" -ge \"$limit\" ]; then break; fi\n657\t    done < <(printf '%s' \"$sortable\" | sort -t$'\\t' -k1,1r)\n658\t    if [ \"$count\" -gt 0 ]; then return 0; fi\n659\t    return 1\n660\t  fi\n661\t\n662\t  # which == running (default)\n663\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n664\t    [ -n \"$id\" ] || continue\n665\t    [ \"$status\" = \"running\" ] || continue\n666\t    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n667\t    round=\"$(almanac_loop_status_field \"$blob\" \"round\" 2>/dev/null || true)\"\n668\t    summary=\"$(almanac_loop_status_field \"$blob\" \"summary\" 2>/dev/null || true)\"\n669\t    queue=\"$(almanac_loop_status_field \"$blob\" \"queue_progress\" 2>/dev/null || true)\"\n670\t    live=\"running\"\n671\t    if almanac_loop_run_is_stale \"$root\" \"$id\"; then\n672\t      live=\"stale\"\n673\t    fi\n674\t    glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n675\t    detail=\"\"\n676\t    if [ -n \"$round\" ]; then detail=\"round $round\"; fi\n677\t    if [ -n \"$summary\" ]; then detail=\"${detail:+$detail  }$summary\"; fi\n678\t    if [ -n \"$queue\" ]; then detail=\"${detail:+$detail  }queue $queue\"; fi\n679\t    if [ -z \"$detail\" ]; then detail=\"—\"; fi\n680\t    printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$live\" \"$type\" \"$target\" \"$detail\" \"$id\"\n681\t    count=$((count + 1))\n682\t  done <<< \"$rows\"\n683\t  if [ \"$count\" -gt 0 ]; then return 0; fi\n684\t  return 1\n685\t}\n686\t\n687\t# Compose the hub's read-only overview screen: a Running section (live loops from\n688\t# the registry) and a Recent section (last finished loops), each framed through\n689\t# the shared ui renderer so it shows as a gum panel on a TTY and plain text\n690\t# without gum. This is the whole hub output off a TTY and the status screen the\n691\t# interactive hub draws around its menu. Each section prints an empty-state line\n692\t# when there are no matching runs.\n693\talmanac_loop_hub_overview() {\n694\t  local root=\"$1\"\n695\t  local recent_limit=\"${2:-10}\"\n696\t  local running recent\n697\t\n698\t  {\n699\t    printf '%s\\n' \"almanac — loop hub\""}]},"parent_tool_use_id":null,"session_id":"5a7c94be-b519-4ed0-b07c-6b329c049eda","uuid":"4077ed18-3005-4e7e-91f6-2acd4d978194","timestamp":"2026-05-27T07:41:33.352Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/run.sh","content":"# produced an event), or looping (emitting the same event over and over) rather\n# than the operator discovering it by hand. The classifier is a PURE predicate\n# over already-gathered numbers, so it is table-testable with no files, clock, or\n# terminal; the gather wrapper (almanac_loop_worker_health_of) feeds it real run\n# state.\n\n# Pure predicate: (status, log-age-secs, event-count, trailing-repeat-count,\n# stall-threshold-secs, loop-repeat-threshold) -> one of\n# running|stalled|idle|looping|done|failed. A terminal status passes straight\n# through. For a live worker: a trailing run of identical events at/over the loop\n# threshold is a loop; otherwise zero events past the stall threshold is idle, any\n# log silence past the stall threshold is stalled, and anything else is running.\nalmanac_loop_worker_health() {\n  local status=\"${1:-running}\"\n  local age=\"${2:-0}\"\n  local count=\"${3:-0}\"\n  local repeat=\"${4:-0}\"\n  local stall=\"${5:-120}\"\n  local loop=\"${6:-5}\"\n\n  case \"$status\" in\n    done)   printf '%s\\n' \"done\";   return 0 ;;\n    failed) printf '%s\\n' \"failed\"; return 0 ;;\n  esac\n\n  if [ \"$loop\" -gt 0 ] && [ \"$repeat\" -ge \"$loop\" ]; then\n    printf '%s\\n' \"looping\"; return 0\n  fi\n  if [ \"$count\" -eq 0 ] && [ \"$age\" -ge \"$stall\" ]; then\n    printf '%s\\n' \"idle\"; return 0\n  fi\n  if [ \"$age\" -ge \"$stall\" ]; then\n    printf '%s\\n' \"stalled\"; return 0\n  fi\n  printf '%s\\n' \"running\"\n}\n\n# Seconds since a file was last modified (now - mtime). Prints -1 when the file is\n# absent. now-epoch is overridable (tests) so age is deterministic. Handles both\n# BSD/macOS (stat -f %m) and GNU/Linux (stat -c %Y).\nalmanac_loop_file_age_secs() {\n  local file=\"$1\"\n  local now=\"${2:-}\"\n  local mtime\n\n  [ -f \"$file\" ] || { printf '%s\\n' \"-1\"; return 0; }\n  [ -n \"$now\" ] || now=\"$(date +%s)\"\n  mtime=\"$(stat -f %m \"$file\" 2>/dev/null || stat -c %Y \"$file\" 2>/dev/null || printf '%s' \"\")\"\n  [ -n \"$mtime\" ] || { printf '%s\\n' \"-1\"; return 0; }\n  printf '%s\\n' \"$((now - mtime))\"\n}\n\n# Count lines in a file (0 when absent). awk NR counts a final unterminated line.\nalmanac_loop_count_lines() {\n  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n  awk 'END { print NR }' \"$1\"\n}\n\n# Count the trailing run of identical lines at the end of a file (0 when absent or\n# empty, 1 when the last line is unique). A long run is the loop signal.\nalmanac_loop_trailing_repeat() {\n  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n  awk '\n    NR == 1 { last = $0; c = 1; next }\n    $0 == last { c++; next }\n    { last = $0; c = 1 }\n    END {\n      if (NR == 0) { print 0; exit }\n      print c\n    }\n  ' \"$1\"\n}\n\n# Gather one worker's real run state and classify its health. Reads the worker's\n# status.tsv (status + events-log path), measures the log's age/size/trailing\n# repeat, and returns the pure predicate's verdict. Prints \"unknown\" when the\n# worker has no status file yet. now/stall/loop are overridable.\nalmanac_loop_worker_health_of() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local worker_id=\"$3\"\n  local now=\"${4:-}\"\n  local stall=\"${5:-120}\"\n  local loop=\"${6:-5}\"\n  local status_file status events_file age count repeat\n\n  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n  [ -f \"$status_file\" ] || { printf '%s\\n' \"unknown\"; return 0; }\n\n  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n  events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n\n  [ -n \"$now\" ] || now=\"$(date +%s)\"\n  age=\"$(almanac_loop_file_age_secs \"$events_file\" \"$now\")\"\n  count=\"$(almanac_loop_count_lines \"$events_file\")\"\n  repeat=\"$(almanac_loop_trailing_repeat \"$events_file\")\"\n  [ \"$age\" -ge 0 ] 2>/dev/null || age=0\n\n  almanac_loop_worker_health \"${status:-running}\" \"$age\" \"$count\" \"$repeat\" \"$stall\" \"$loop\"\n}\n\n# --- Hub overview --------------------------------------------------------------\n#\n# The interactive hub (`almanac` in a TTY, or `almanac hub`) is the front door to\n# every loop. Its read views are PURE registry projections so they are testable\n# off a terminal and degrade to plain text without gum; the interactive menus\n# (new-run, per-run watch/stop/steer) layer on top of these.\n\n# Project the run registry into one of the hub's two lists as plain printable\n# rows (text only — gum frames them later, so this stays unit-testable off a\n# TTY). `which` selects the section:\n#   running — every run whose lifecycle status is still `running`, carrying its\n#             live round/summary from the run-status blob; a running entry whose\n#             pid is gone is surfaced as `stale` (almanac_loop_run_is_stale) so a\n#             crashed run is visible rather than silently lost.\n#   recent  — the finished runs (done/failed/aborted), newest finish first,\n#             capped at `limit` (default 10).\n# Each row is \"<glyph>  <state>  <type>  <target>  <detail>  [<id>]\". Returns 1\n# (no rows) when the section is empty so the caller can print an empty-state line.\nalmanac_loop_hub_render() {\n  local root=\"$1\"\n  local which=\"$2\"\n  local limit=\"${3:-10}\"\n  local rows id type target pid status_rel started status\n  local blob round summary finished detail glyph live count reason_field display queue\n\n  rows=\"$(almanac_loop_list_runs \"$root\")\" || return 1\n  count=0\n\n  if [ \"$which\" = \"recent\" ]; then\n    local sortable=\"\"\n    while IFS=$'\\t' read -r id type target pid status_rel started status; do\n      [ -n \"$id\" ] || continue\n      case \"$status\" in\n        done|failed|aborted) ;;\n        *) continue ;;\n      esac\n      blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n      finished=\"$(almanac_loop_status_field \"$blob\" \"finished_at\" 2>/dev/null || true)\"\n      [ -n \"$finished\" ] || finished=\"$started\"\n      reason_field=\"\"\n      if [ \"$status\" = \"failed\" ]; then\n        reason_field=\"$(almanac_loop_status_field \"$blob\" \"failure_reason\" 2>/dev/null || true)\"\n      fi\n      sortable+=\"$finished\"$'\\t'\"$id\"$'\\t'\"$type\"$'\\t'\"$target\"$'\\t'\"$status\"$'\\t'\"$reason_field\"$'\\n'\n    done <<< \"$rows\"\n    [ -n \"$sortable\" ] || return 1\n    while IFS=$'\\t' read -r finished id type target status reason_field; do\n      [ -n \"$id\" ] || continue\n      glyph=\"$(almanac_loop_ui_status_glyph \"$status\")\"\n      display=\"$finished\"\n      if [ \"$status\" = \"failed\" ] && [ -n \"$reason_field\" ]; then\n        display=\"$finished — $reason_field\"\n      fi\n      printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$status\" \"$type\" \"$target\" \"$display\" \"$id\"\n      count=$((count + 1))\n      if [ \"$count\" -ge \"$limit\" ]; then break; fi\n    done < <(printf '%s' \"$sortable\" | sort -t$'\\t' -k1,1r)\n    if [ \"$count\" -gt 0 ]; then return 0; fi\n    return 1\n  fi\n\n  # which == running (default)\n  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n    [ -n \"$id\" ] || continue\n    [ \"$status\" = \"running\" ] || continue\n    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n    round=\"$(almanac_loop_status_field \"$blob\" \"round\" 2>/dev/null || true)\"\n    summary=\"$(almanac_loop_status_field \"$blob\" \"summary\" 2>/dev/null || true)\"\n    queue=\"$(almanac_loop_status_field \"$blob\" \"queue_progress\" 2>/dev/null || true)\"\n    live=\"running\"\n    if almanac_loop_run_is_stale \"$root\" \"$id\"; then\n      live=\"stale\"\n    fi\n    glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n    detail=\"\"\n    if [ -n \"$round\" ]; then detail=\"round $round\"; fi\n    if [ -n \"$summary\" ]; then detail=\"${detail:+$detail  }$summary\"; fi\n    if [ -n \"$queue\" ]; then detail=\"${detail:+$detail  }queue $queue\"; fi\n    if [ -z \"$detail\" ]; then detail=\"—\"; fi\n    printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$live\" \"$type\" \"$target\" \"$detail\" \"$id\"\n    count=$((count + 1))\n  done <<< \"$rows\"\n  if [ \"$count\" -gt 0 ]; then return 0; fi\n  return 1\n}\n\n# Compose the hub's read-only overview screen: a Running section (live loops from\n# the registry) and a Recent section (last finished loops), each framed through\n# the shared ui renderer so it shows as a gum panel on a TTY and plain text\n# without gum. This is the whole hub output off a TTY and the status screen the\n# interactive hub draws around its menu. Each section prints an empty-state line\n# when there are no matching runs.\nalmanac_loop_hub_overview() {\n  local root=\"$1\"\n  local recent_limit=\"${2:-10}\"\n  local running recent\n\n  {\n    printf '%s\\n' \"almanac — loop hub\"","numLines":200,"startLine":500,"totalLines":958}}}
