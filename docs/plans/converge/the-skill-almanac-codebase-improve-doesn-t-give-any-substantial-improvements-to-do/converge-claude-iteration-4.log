{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FTMit358zhjvER558t2V5q","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# feedback.sh - Project feedback-loop detection + runner\n3\t#\n4\t# The feedback loops are a project's objective gate: the test/typecheck/lint\n5\t# commands implied by its marker files (package.json, Cargo.toml, …). Detection\n6\t# maps marker files to commands (shared by Ralph's prompt and harden's fixer, so\n7\t# both run the same gate with no per-project config); the runner executes them\n8\t# and reports a pass/fail verdict per loop.\n9\t#\n10\t# Self-contained like lib/role.sh / lib/run.sh: uses only printf/tr/mkdir/eval\n11\t# and a subshell cd (no lib/core.sh dependency), so this file's interface is its\n12\t# own test surface (tests/test-feedback.sh). Callers source it directly.\n13\t\n14\t# Emit one feedback command per line, detected from the project marker files\n15\t# present at $root. The order is fixed so the prompt/runner output is stable.\n16\talmanac_loop_feedback_commands() {\n17\t  local root=\"${1:-.}\"\n18\t\n19\t  if [ -f \"$root/package.json\" ]; then\n20\t    printf '%s\\n' \"npm run test\"\n21\t    printf '%s\\n' \"npm run typecheck\"\n22\t    printf '%s\\n' \"npm run lint\"\n23\t  fi\n24\t\n25\t  if [ -f \"$root/Makefile\" ]; then\n26\t    printf '%s\\n' \"make test\"\n27\t    printf '%s\\n' \"make check\"\n28\t  fi\n29\t\n30\t  if [ -f \"$root/Cargo.toml\" ]; then\n31\t    printf '%s\\n' \"cargo test\"\n32\t    printf '%s\\n' \"cargo check\"\n33\t  fi\n34\t\n35\t  if [ -f \"$root/go.mod\" ]; then\n36\t    printf '%s\\n' \"go test ./...\"\n37\t    printf '%s\\n' \"go vet ./...\"\n38\t  fi\n39\t\n40\t  if [ -f \"$root/pyproject.toml\" ] || [ -f \"$root/setup.py\" ]; then\n41\t    printf '%s\\n' \"pytest\"\n42\t    printf '%s\\n' \"mypy\"\n43\t  fi\n44\t\n45\t  if [ -f \"$root/tests/test-skills.sh\" ]; then\n46\t    printf '%s\\n' \"bash tests/test-skills.sh\"\n47\t  fi\n48\t\n49\t  if [ -f \"$root/tests/test-structure.sh\" ]; then\n50\t    printf '%s\\n' \"bash tests/test-structure.sh\"\n51\t  fi\n52\t}\n53\t\n54\talmanac_loop_feedback_command_description() {\n55\t  case \"$1\" in\n56\t    \"npm run test\") printf '%s\\n' \"run npm tests\" ;;\n57\t    \"npm run typecheck\") printf '%s\\n' \"run TypeScript type checks\" ;;\n58\t    \"npm run lint\") printf '%s\\n' \"run lint checks\" ;;\n59\t    \"make test\") printf '%s\\n' \"run Makefile test target\" ;;\n60\t    \"make check\") printf '%s\\n' \"run Makefile check target\" ;;\n61\t    \"cargo test\") printf '%s\\n' \"run Rust tests\" ;;\n62\t    \"cargo check\") printf '%s\\n' \"run Rust compiler checks\" ;;\n63\t    \"go test ./...\") printf '%s\\n' \"run Go tests\" ;;\n64\t    \"go vet ./...\") printf '%s\\n' \"run Go vet checks\" ;;\n65\t    \"pytest\") printf '%s\\n' \"run Python tests\" ;;\n66\t    \"mypy\") printf '%s\\n' \"run Python type checks\" ;;\n67\t    \"bash tests/test-skills.sh\") printf '%s\\n' \"validate skill format/content\" ;;\n68\t    \"bash tests/test-structure.sh\") printf '%s\\n' \"validate repo layout\" ;;\n69\t    *) printf '%s\\n' \"run feedback loop\" ;;\n70\t  esac\n71\t}\n72\t\n73\talmanac_loop_feedback_markdown() {\n74\t  local root=\"${1:-.}\"\n75\t  local command description found\n76\t  found=0\n77\t\n78\t  while IFS= read -r command; do\n79\t    [ -n \"$command\" ] || continue\n80\t    description=\"$(almanac_loop_feedback_command_description \"$command\")\"\n81\t    printf -- '- `%s` to %s\\n' \"$command\" \"$description\"\n82\t    found=1\n83\t  done < <(almanac_loop_feedback_commands \"$root\")\n84\t\n85\t  if [ \"$found\" -eq 0 ]; then\n86\t    printf '%s\\n' \"- (none detected)\"\n87\t  fi\n88\t}\n89\t\n90\t# Run every detected feedback loop for the project at $root and emit one TSV\n91\t# verdict row per loop: <command>\\t<pass|fail>. Each command runs from $root\n92\t# (combined output captured to $log_dir/<slug>.log when a log dir is given,\n93\t# else discarded). Returns 0 only when every loop passed and non-zero when any\n94\t# failed, so a caller can gate on the aggregate while still reading the per-loop\n95\t# verdicts. This is the runner half of the shared feedback engine; detection is\n96\t# almanac_loop_feedback_commands, shared with Ralph, so both consumers run the\n97\t# same objective gate without per-project config.\n98\talmanac_loop_feedback_run() {\n99\t  local root=\"${1:-.}\"\n100\t  local log_dir=\"${2:-}\"\n101\t  local command verdict log_file slug\n102\t  local any_fail=0\n103\t\n104\t  if [ -n \"$log_dir\" ]; then\n105\t    mkdir -p \"$log_dir\"\n106\t  fi\n107\t\n108\t  while IFS= read -r command; do\n109\t    [ -n \"$command\" ] || continue\n110\t\n111\t    if [ -n \"$log_dir\" ]; then\n112\t      slug=\"$(printf '%s' \"$command\" | tr -cs 'A-Za-z0-9' '-')\"\n113\t      log_file=\"$log_dir/${slug}.log\"\n114\t    else\n115\t      log_file=\"/dev/null\"\n116\t    fi\n117\t\n118\t    if ( cd \"$root\" && eval \"$command\" ) > \"$log_file\" 2>&1; then\n119\t      verdict=\"pass\"\n120\t    else\n121\t      verdict=\"fail\"\n122\t      any_fail=1\n123\t    fi\n124\t\n125\t    printf '%s\\t%s\\n' \"$command\" \"$verdict\"\n126\t  done < <(almanac_loop_feedback_commands \"$root\")\n127\t\n128\t  return \"$any_fail\"\n129\t}\n130\t"}]},"parent_tool_use_id":"toolu_01TT2qPdF9rLAHNrvVUCFZTN","session_id":"5a7c94be-b519-4ed0-b07c-6b329c049eda","uuid":"12f1470e-6e01-4394-b79b-02565a04d6d5","timestamp":"2026-05-27T07:39:44.859Z","subagent_type":"Explore","task_description":"Explore almanac codebase friction"}
