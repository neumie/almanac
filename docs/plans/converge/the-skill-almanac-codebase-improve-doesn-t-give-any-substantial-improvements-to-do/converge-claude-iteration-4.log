{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VD2VSHCfPe7tb5WammGEBZ","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/ralph.sh — the ralph loop adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about how to launch and\n5\t# control the ralph loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n6\t#\n7\t# Contract (called as almanac_loop_ralph_<verb>):\n8\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n9\t#                   dispatch (no central case-statement on loop type).\n10\t#   launch_usage  — the --help text printed for this loop's launcher.\n11\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n12\t#                   for a given mode/prd/iterations. The ralph runner path lives\n13\t#                   HERE (not hard-coded in the launcher).\n14\t#   new_run_argv  — emit the hub's \"new run\" launcher argv (one token per line,\n15\t#                   starting with the `almanac` subcommand) from key=val pairs.\n16\t#                   The hub composes runs without knowing ralph's flag shape.\n17\t#   new_run_env   — emit KEY=VALUE env lines for fields that ride on environment\n18\t#                   (none for ralph; the verb exists so the dispatch in lib/run.sh\n19\t#                   has no `case \"$type\"` branches).\n20\t#\n21\t# Control contract (signal_file) inherits the default `.ralph-stop` / `.ralph-steer`\n22\t# convention from lib/loops.sh — no adapter override needed.\n23\t#\n24\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n25\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n26\t# and the shared UI / provider seams. The launcher sources those before\n27\t# dispatching, so the adapter need not source them itself.\n28\t\n29\t# Build ralph's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n30\t# it). MODE selects the runner: `once` runs a single iteration (once.sh PRD),\n31\t# `afk` runs autonomously (afk.sh PRD ITERATIONS). The ralph runner scripts live\n32\t# under the ralph-loop skill — this adapter is the single place that path is\n33\t# named, so the launcher no longer hard-codes …/ralph-loop/scripts/…. Returns 2\n34\t# for an unknown mode. Requires $ALMANAC_HOME (set by every entry point).\n35\talmanac_loop_ralph_exec_argv() {\n36\t  local mode=\"$1\" prd=\"$2\" iterations=\"${3:-}\"\n37\t  local scripts=\"$ALMANAC_HOME/skills/loop/ralph-loop/scripts\"\n38\t  case \"$mode\" in\n39\t    once) _ALMANAC_LOOP_ARGV=(bash \"$scripts/once.sh\" \"$prd\") ;;\n40\t    afk)  _ALMANAC_LOOP_ARGV=(bash \"$scripts/afk.sh\" \"$prd\" \"$iterations\") ;;\n41\t    *) return 2 ;;\n42\t  esac\n43\t  return 0\n44\t}\n45\t\n46\t# Interactive config + exec for the ralph loop. Parses native flags, prompts for\n47\t# any missing field via the gum-or-plain UI seam, exports the role-config env,\n48\t# and execs the runner via the exec_argv verb. Called by lib/loop-launcher.sh's\n49\t# adapter dispatch — no central code branches on loop type.\n50\talmanac_loop_ralph_launch() {\n51\t  local prd=\"\" mode=\"\" provider=\"\" model=\"\" effort=\"\" iterations=\"\" no_oversee=\"\" yes=\"\"\n52\t  while [ \"$#\" -gt 0 ]; do\n53\t    case \"$1\" in\n54\t      --prd)        shift; prd=\"${1:-}\";        [ -n \"$prd\" ] || _die \"--prd requires a value\" ;;\n55\t      --mode)       shift; mode=\"${1:-}\";       [ -n \"$mode\" ] || _die \"--mode requires a value\" ;;\n56\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n57\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n58\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n59\t      --iterations) shift; iterations=\"${1:-}\"; [ -n \"$iterations\" ] || _die \"--iterations requires a value\" ;;\n60\t      --no-oversee) no_oversee=1 ;;\n61\t      --yes|-y) yes=1 ;;\n62\t      --help|-h) almanac_loop_ralph_launch_usage; return 0 ;;\n63\t      *) _die \"Unknown ralph launch option: $1\" ;;\n64\t    esac\n65\t    shift\n66\t  done\n67\t\n68\t  [ -d docs/plans ] || _die \"docs/plans/ not found. Run from the project root.\"\n69\t\n70\t  # PRD\n71\t  if [ -z \"$prd\" ]; then\n72\t    local prds=() dir\n73\t    for dir in docs/plans/*/; do\n74\t      [ -f \"${dir}prd.md\" ] && prds+=(\"$(basename \"$dir\")\")\n75\t    done\n76\t    [ \"${#prds[@]}\" -gt 0 ] || _die \"No PRDs in docs/plans/. Run /prd-create first.\"\n77\t    if [ \"${#prds[@]}\" -eq 1 ]; then prd=\"${prds[0]}\"; else prd=\"$(almanac_loop_ui_choose \"Select PRD\" \"${prds[@]}\")\" || return 1; fi\n78\t  fi\n79\t  [ -f \"docs/plans/${prd}/prd.md\" ]    || _die \"docs/plans/${prd}/prd.md not found.\"\n80\t  [ -f \"docs/plans/${prd}/prompt.md\" ] || _die \"docs/plans/${prd}/prompt.md not found. Run /ralph-loop ${prd} first.\"\n81\t\n82\t  # Mode\n83\t  [ -n \"$mode\" ] || mode=\"$(almanac_loop_ui_choose \"Mode\" once afk)\" || return 1\n84\t  case \"$mode\" in once|afk) ;; *) _die \"--mode must be once or afk\" ;; esac\n85\t\n86\t  # Provider / model / effort\n87\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n88\t  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n89\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n90\t  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n91\t  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n92\t\n93\t  # Iterations + overseer (afk only)\n94\t  if [ \"$mode\" = \"afk\" ]; then\n95\t    iterations=\"$(_almanac_launch_need_positive_int \"Iterations\" \"$iterations\" \"10\")\" || return 1\n96\t    if [ -z \"$no_oversee\" ]; then\n97\t      almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n98\t    fi\n99\t  fi\n100\t"}]},"parent_tool_use_id":"toolu_01TT2qPdF9rLAHNrvVUCFZTN","session_id":"5a7c94be-b519-4ed0-b07c-6b329c049eda","uuid":"23585f57-3a5b-4b26-a5ba-8efb221f6f6f","timestamp":"2026-05-27T07:39:40.043Z","subagent_type":"Explore","task_description":"Explore almanac codebase friction"}
