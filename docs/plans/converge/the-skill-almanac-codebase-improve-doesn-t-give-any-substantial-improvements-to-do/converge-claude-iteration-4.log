{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DEozWLaj1H7koskLjtgjMc","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# core.sh — Shared CLI utilities for almanac\n3\t\n4\t# Colors (if terminal supports them)\n5\tif [[ -t 1 ]]; then\n6\t  _BOLD=\"\\033[1m\"\n7\t  _RED=\"\\033[31m\"\n8\t  _GREEN=\"\\033[32m\"\n9\t  _YELLOW=\"\\033[33m\"\n10\t  _BLUE=\"\\033[34m\"\n11\t  _RESET=\"\\033[0m\"\n12\telse\n13\t  _BOLD=\"\" _RED=\"\" _GREEN=\"\" _YELLOW=\"\" _BLUE=\"\" _RESET=\"\"\n14\tfi\n15\t\n16\t_info()    { echo -e \"${_BLUE}[info]${_RESET} $*\"; }\n17\t_success() { echo -e \"${_GREEN}[ok]${_RESET} $*\"; }\n18\t_warn()    { echo -e \"${_YELLOW}[warn]${_RESET} $*\"; }\n19\t_error()   { echo -e \"${_RED}[error]${_RESET} $*\" >&2; }\n20\t_die()     { _error \"$@\"; exit 1; }\n21\t\n22\t# --- ALMANAC_HOME resolution -----------------------------------------------\n23\t# Canonical resolver and single source of truth for locating the real repo root\n24\t# from an entry point. Prefer an already-exported ALMANAC_HOME; otherwise resolve\n25\t# the caller's own path to its physical directory (pwd -P, so the install\n26\t# dir-symlink ~/.claude/skills/almanac/<name> -> repo/skills/<category>/<name>\n27\t# and a plain checkout both land on the real repo) and climb <depth> parents to\n28\t# the repo root.\n29\t#\n30\t# Entry points can't call this until core.sh is sourced, so each inlines an\n31\t# identical one-line bootstrap that mirrors it (the standardized snippet):\n32\t#   ALMANAC_HOME=\"${ALMANAC_HOME:-$(cd -P \"$(dirname \"${BASH_SOURCE[0]}\")/<REL>\" && pwd -P)}\"\n33\t# where <REL> is the file's known depth below the root (bin/ -> \"..\",\n34\t# skills/<cat>/<name>/scripts/ -> \"../../../..\"). Keep snippet and function in\n35\t# sync; this function is the tested form (tests/test-home-resolve.sh).\n36\talmanac_resolve_home() {\n37\t  local src=\"${1:?almanac_resolve_home: source path required}\" depth=\"${2:-0}\"\n38\t  if [ -n \"${ALMANAC_HOME:-}\" ]; then\n39\t    printf '%s\\n' \"$ALMANAC_HOME\"\n40\t    return 0\n41\t  fi\n42\t  local home\n43\t  home=\"$(cd -P \"$(dirname \"$src\")\" && pwd -P)\"\n44\t  while [ \"$depth\" -gt 0 ]; do\n45\t    home=\"$(dirname \"$home\")\"\n46\t    depth=$((depth - 1))\n47\t  done\n48\t  printf '%s\\n' \"$home\"\n49\t}\n50\t\n51\t# --- Sibling-source helper -------------------------------------------------\n52\t# Idempotently source a sibling lib/ file from the caller's directory.\n53\t# Usage (from inside lib/<some-module>.sh, after core.sh has been sourced):\n54\t#   _almanac_source_sibling <basename.sh> <guard_function>\n55\t# If <guard_function> already exists, returns 0 without sourcing — so the same\n56\t# module can be pulled in via multiple paths (bin/almanac, a test sourcing it\n57\t# directly, transitive sourcing) without re-defining its functions.\n58\t#\n59\t# The caller's directory is resolved via BASH_SOURCE[1] (the file that called\n60\t# this helper) with pwd -P, so the install-time symlink\n61\t# ~/.claude/skills/almanac/<name> → repo/skills/<cat>/<name> and a plain\n62\t# checkout both land on the real lib/.\n63\t#\n64\t# Replaces the verbose five-line idiom that used to live at the top of every\n65\t# consumer module (`if ! declare -F X; then __dir=…; source …; unset __dir; fi`).\n66\t# Lives in core.sh because every consumer of this helper already depends on\n67\t# core.sh; modules that deliberately have NO core.sh dependency (run.sh, ui.sh,\n68\t# loops.sh, agent.sh) keep the literal snippet instead.\n69\t_almanac_source_sibling() {\n70\t  local module=\"$1\"\n71\t  local guard_fn=\"$2\"\n72\t  declare -F \"$guard_fn\" >/dev/null 2>&1 && return 0\n73\t  local caller_dir\n74\t  caller_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[1]}\")\" && pwd -P)\"\n75\t  # shellcheck source=/dev/null\n76\t  source \"$caller_dir/$module\"\n77\t}\n78\t\n79\t# Providers with adapters\n80\talmanac_providers() {\n81\t  local provider\n82\t  for dir in \"$ALMANAC_HOME\"/providers/*/; do\n83\t    [[ -d \"$dir\" ]] || continue\n84\t    provider=\"$(basename \"$dir\")\"\n85\t    [[ \"$provider\" == _* ]] && continue\n86\t    printf '%s\\n' \"$provider\"\n87\t  done\n88\t}\n89\t\n90\t# Optional-dependency detection. `gum` (Charm) styles the harden/ralph\n91\t# dashboards and HITL prompts; it is optional — the CLI degrades to plain output\n92\t# when absent. This is a pure binary-presence check (unlike the runtime\n93\t# TTY-gated almanac_loop_ui_has_gum), so install/doctor can report it.\n94\talmanac_gum_present() { command -v gum >/dev/null 2>&1; }\n95\t\n96\t# Report gum presence/absence with an actionable hint. Used by `almanac doctor`\n97\t# and the installers so users learn the dashboard is gum-styled and optional.\n98\talmanac_report_gum() {\n99\t  if almanac_gum_present; then\n100\t    _success \"gum: installed ($(command -v gum)) — dashboards render styled\"\n101\t  else\n102\t    _warn \"gum: not found — harden/ralph dashboards degrade to plain output\"\n103\t    _info \"Install gum (optional) for styled dashboards: https://github.com/charmbracelet/gum\"\n104\t  fi\n105\t}\n106\t\n107\t# Check if a provider is installed (return 0 = yes, 1 = no)\n108\t_is_installed() {\n109\t  local provider=\"$1\"\n110\t  case \"$provider\" in\n111\t    claude-code)\n112\t      [[ -d \"$HOME/.claude/commands/almanac\" ]]\n113\t      ;;\n114\t    opencode)\n115\t      [[ -e \"$HOME/.config/opencode/skills/almanac\" ]]\n116\t      ;;\n117\t    cursor)\n118\t      [[ -e \"$HOME/.cursor/skills/almanac\" ]]\n119\t      ;;\n120\t    codex)\n121\t      [[ -e \"$HOME/.agents/skills/almanac\" ]]\n122\t      ;;\n123\t    *)\n124\t      return 1\n125\t      ;;\n126\t  esac\n127\t}\n128\t"}]},"parent_tool_use_id":"toolu_01TT2qPdF9rLAHNrvVUCFZTN","session_id":"5a7c94be-b519-4ed0-b07c-6b329c049eda","uuid":"86a7b49f-ea5d-4e0b-ac10-114e89cb0ad8","timestamp":"2026-05-27T07:39:27.458Z","subagent_type":"Explore","task_description":"Explore almanac codebase friction"}
