{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0196EX9Zg8gB8EC2QKBqDHGc","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# converge-core.sh - Generic convergence loop core\n3\t\n4\t# Source focused deps idempotently so tests can source this file directly.\n5\t# core.sh owns the helper, so it's pulled in via the literal pattern.\n6\tif ! declare -F _error >/dev/null 2>&1; then\n7\t  __converge_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n8\t  # shellcheck source=lib/core.sh\n9\t  source \"$__converge_core_dir/core.sh\"\n10\t  unset __converge_core_dir\n11\tfi\n12\t\n13\t_almanac_source_sibling run.sh    almanac_loop_register_run\n14\t_almanac_source_sibling agent.sh  almanac_loop_agent_capture\n15\t_almanac_source_sibling role.sh   almanac_loop_role_config\n16\t\n17\talmanac_converge_plan_dir() {\n18\t  local root=\"$1\"\n19\t  local slug=\"$2\"\n20\t\n21\t  almanac_loop_plan_dir converge \"$root\" \"$slug\"\n22\t}\n23\t\n24\talmanac_converge_scaffold() {\n25\t  local root=\"$1\"\n26\t  local goal=\"$2\"\n27\t  local plan_dir\n28\t\n29\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n30\t\n31\t  if ! mkdir -p \"$plan_dir\"; then\n32\t    _die \"Could not create converge plan dir: ${plan_dir#\"$root\"/}\"\n33\t  fi\n34\t  if ! printf '%s\\n' \"$goal\" > \"$plan_dir/goal.md\"; then\n35\t    _die \"Could not write converge goal: ${plan_dir#\"$root\"/}/goal.md\"\n36\t  fi\n37\t  if ! : > \"$plan_dir/agent-reports.log\"; then\n38\t    _die \"Could not write converge report log: ${plan_dir#\"$root\"/}/agent-reports.log\"\n39\t  fi\n40\t  if ! : > \"$plan_dir/goal.history.log\"; then\n41\t    _die \"Could not write converge goal history: ${plan_dir#\"$root\"/}/goal.history.log\"\n42\t  fi\n43\t}\n44\t\n45\talmanac_converge_role() {\n46\t  local role=\"$1\"\n47\t\n48\t  case \"$role\" in\n49\t    agent|overseer) ;;\n50\t    *) return 2 ;;\n51\t  esac\n52\t\n53\t  almanac_loop_role_config \"converge\" \"$role\" \"\" \"$(almanac_provider_default)\" \"\" \"\"\n54\t}\n55\t\n56\talmanac_converge_role_field() {\n57\t  local role=\"$1\"\n58\t  local field=\"$2\"\n59\t\n60\t  almanac_converge_role \"$role\" | almanac_loop_role_tsv_field \"$field\"\n61\t}\n62\t\n63\talmanac_converge_ensure_prompt_template() {\n64\t  local root=\"$1\"\n65\t  local goal=\"$2\"\n66\t  local plan_dir prompt_file\n67\t\n68\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n69\t  prompt_file=\"$plan_dir/prompt.md\"\n70\t  [ -f \"$prompt_file\" ] && return 0\n71\t\n72\t  cat > \"$prompt_file\" <<'EOF'\n73\t# Converge Worker\n74\t\n75\tYou are one worker round in a generic convergence loop.\n76\t\n77\tRead current goal, follow one-shot steer directive if present, run exact exec\n78\tcommand, then leave clear evidence in git history and agent-reports.log.\n79\t\n80\tDo not edit the goal unless explicitly asked by the exec command. Do not commit\n81\t.almanac or converge state files under docs/plans/converge/.\n82\tEOF\n83\t}\n84\t\n85\talmanac_converge_worker_prompt() {\n86\t  local root=\"$1\"\n87\t  local goal=\"$2\"\n88\t  local exec_cmd=\"$3\"\n89\t  local round=\"$4\"\n90\t  local slug plan_dir rel_plan steer_file\n91\t\n92\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n93\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n94\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n95\t  steer_file=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n96\t\n97\t  almanac_converge_ensure_prompt_template \"$root\" \"$goal\"\n98\t\n99\t  cat \"$plan_dir/prompt.md\"\n100\t  cat <<EOF\n101\t\n102\tCONVERGE_TICK=$round\n103\tCONVERGE_SLUG=$slug\n104\tCONVERGE_PLAN_DIR=$rel_plan\n105\tCONVERGE_REPORT_LOG=$rel_plan/agent-reports.log\n106\t\n107\tCommit user-visible worktree changes, excluding .almanac and $rel_plan, with:\n108\tCONVERGE($slug): <one-line summary>\n109\t\n110\tAppend one structured self-report to $rel_plan/agent-reports.log. Use this exact\n111\theader shape and these exact section labels:\n112\t\n113\t===== tick=<N> ts=<ISO> =====\n114\tsummary:\n115\tconcerns:\n116\tnext:\n117\t\n118\tFor this round, N is $round.\n119\t\n120\t===== GOAL.md =====\n121\tEOF\n122\t  cat \"$plan_dir/goal.md\"\n123\t  cat <<EOF\n124\t===== END GOAL.md =====\n125\t\n126\t===== EXEC COMMAND =====\n127\t$exec_cmd\n128\t===== END EXEC COMMAND =====\n129\tEOF\n130\t\n131\t  if [ -f \"$steer_file\" ]; then\n132\t    cat <<'EOF'\n133\t\n134\t===== STEER =====\n135\tEOF\n136\t    cat \"$steer_file\"\n137\t    cat <<'EOF'\n138\t===== END STEER =====\n139\tEOF\n140\t    rm -f \"$steer_file\"\n141\t  fi\n142\t}\n143\t\n144\talmanac_converge_report_log_has_structured_block() {\n145\t  local file=\"$1\"\n146\t\n147\t  [ -f \"$file\" ] || return 1\n148\t  awk '\n149\t    /^===== tick=[0-9][0-9]* ts=.* =====$/ {\n150\t      seen = 1\n151\t      summary = 0\n152\t      concerns = 0\n153\t      next_seen = 0\n154\t      next\n155\t    }\n156\t    seen && /^summary:$/ { summary = 1; next }\n157\t    seen && /^concerns:$/ { concerns = 1; next }\n158\t    seen && /^next:$/ { next_seen = 1; ok = summary && concerns && next_seen; next }\n159\t    END { exit ok ? 0 : 1 }\n160\t  ' \"$file\"\n161\t}\n162\t\n163\talmanac_converge_trim() {\n164\t  printf '%s' \"$1\" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'\n165\t}\n166\t\n167\talmanac_converge_overseer_prompt() {\n168\t  local root=\"$1\"\n169\t  local goal=\"$2\"\n170\t  local round=\"$3\"\n171\t  local slug plan_dir rel_plan reports_file reports commits\n172\t\n173\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n174\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n175\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n176\t  reports_file=\"$plan_dir/agent-reports.log\"\n177\t\n178\t  if [ -f \"$reports_file\" ]; then\n179\t    reports=\"$(tail -c 8192 \"$reports_file\")\"\n180\t  else\n181\t    reports=\"(no agent reports yet)\"\n182\t  fi\n183\t\n184\t  commits=\"$(git -C \"$root\" log --fixed-strings --grep=\"CONVERGE($slug):\" -n 10 \\\n185\t    --format='%H%n%ad%n%B%n---' --date=short 2>/dev/null || true)\"\n186\t  [ -n \"$commits\" ] || commits=\"No CONVERGE commits yet\"\n187\t\n188\t  cat <<EOF\n189\tYou are the overseer for converge($slug), a synchronous convergence loop.\n190\t\n191\tCONVERGE_TICK=$round\n192\tCONVERGE_SLUG=$slug\n193\tCONVERGE_PLAN_DIR=$rel_plan\n194\t\n195\tJudge whether the current goal is satisfied, whether the next worker needs a\n196\tone-shot steering directive, or whether the loop should stop.\n197\t\n198\t===== GOAL.md =====\n199\tEOF\n200\t  cat \"$plan_dir/goal.md\"\n201\t  cat <<EOF\n202\t===== END GOAL.md =====\n203\t\n204\t===== RECENT AGENT SELF-REPORTS (last ~8KB) =====\n205\t$reports\n206\t===== END RECENT AGENT SELF-REPORTS =====\n207\t\n208\t===== RECENT CONVERGE COMMITS (last 10) =====\n209\t$commits\n210\t===== END RECENT CONVERGE COMMITS =====\n211\t\n212\tOutput these four fields in order, exactly this raw format, no preamble, no\n213\tmarkdown decoration, no code fences, no bold, no headings:\n214\t\n215\tVERDICT: <CONVERGED|CONTINUE|STEER|STOP>\n216\tREASON: <one paragraph>\n217\tSTEER: <one paragraph, or 'none'>\n218\tGOAL_UPDATE: <new goal.md content, or 'unchanged'>\n219\t\n220\tYou MUST emit all four KEY: lines even when a value is \"none\" or \"unchanged\"\n221\t— a missing line tells the parser you did not respond, not that nothing was\n222\tneeded. Do NOT prefix the keys with **bold**, ### headings, - bullet points,\n223\tor > quotes; the keys live at column 0 with the literal colon.\n224\t\n225\tBe conservative. Malformed output is treated as CONTINUE with no steering and\n226\tno goal update. GOAL_UPDATE may span multiple lines because it is the final\n227\tfield; the parser captures everything from the GOAL_UPDATE: marker to EOF.\n228\tEOF\n229\t}\n230\t\n231\talmanac_converge_overseer_parse() {\n232\t  local input=\"${1:-}\"\n233\t  local content line key_line current_key=\"\"\n234\t  local raw_verdict=\"\" raw_reason=\"\" raw_steer=\"\" raw_goal=\"\"\n235\t  local found_verdict=0 found_reason=0 found_steer=0 found_goal=0\n236\t\n237\t  if [ -f \"$input\" ]; then\n238\t    content=\"$(cat \"$input\")\"\n239\t  else\n240\t    content=\"$input\"\n241\t  fi\n242\t\n243\t  ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n244\t  ALMANAC_CONVERGE_REASON=\"\"\n245\t  ALMANAC_CONVERGE_STEER=\"none\"\n246\t  ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n247\t\n248\t  # State-machine line walker. Each KEY: prefix switches the current field;\n249\t  # subsequent non-key lines append to whatever field is currently open.\n250\t  #\n251\t  # Pre-leniency: parser only matched the literal \"KEY:\" prefix. LLMs that\n252\t  # added markdown bold (`**VERDICT:**`), heading hashes (`### VERDICT:`),\n253\t  # or list-bullet markers (`- VERDICT:`) silently failed the case match,\n254\t  # found_X stayed 0, and the guard at the bottom returned with all defaults\n255\t  # — producing the canonical \"VERDICT=CONTINUE, REASON='', STEER=none,\n256\t  # GOAL_UPDATE=unchanged\" mirage seen across every overseer tick of three\n257\t  # consecutive converge runs.\n258\t  #\n259\t  # Now: strip a small set of decorative prefixes (markdown bold, leading\n260\t  # `#`/`-`/`*`/`>` characters + space) from the start of each line BEFORE\n261\t  # the case match, and trim trailing `**` for the bold-close variant\n262\t  # (`**VERDICT:**`). This is purposely a tight whitelist — we don't want\n263\t  # to start accepting `; VERDICT:` or `// VERDICT:` and then debug new\n264\t  # ambiguities; just the markdown shapes models actually emit.\n265\t  while IFS= read -r line || [ -n \"$line\" ]; do\n266\t    # Normalize a small set of decorative prefixes that wrap KEY: markers.\n267\t    # The targeted shapes (in order, all anchored to start of line):\n268\t    #   `**VERDICT:** value`   markdown bold + colon-close\n269\t    #   `**VERDICT:**`         bold-only, value on next line\n270\t    #   `### VERDICT: value`   markdown heading (1-6 hashes)\n271\t    #   `- VERDICT: value`     list bullet (`-` or `*`)\n272\t    #   `> VERDICT: value`     quote marker (rare but seen)\n273\t    # Each strips ONLY the surrounding decoration, leaves the KEY: literal\n274\t    # alone so the case match below works unchanged. Continuation lines\n275\t    # (paragraph body) bypass these substitutions when they don't start\n276\t    # with a recognized decoration — values keep their internal markdown\n277\t    # (e.g. a REASON paragraph with `**bold**` inline emphasis stays\n278\t    # intact).\n279\t    key_line=\"$(printf '%s' \"$line\" | sed -E '\n280\t      s/^[[:space:]]+//\n281\t      s/^\\*\\*([A-Z_]+):\\*\\*[[:space:]]*/\\1: /\n282\t      s/^\\*\\*([A-Z_]+):\\*\\*[[:space:]]*$/\\1:/\n283\t      s/^#+[[:space:]]+([A-Z_]+:)/\\1/\n284\t      s/^[-*][[:space:]]+([A-Z_]+:)/\\1/\n285\t      s/^>[[:space:]]*([A-Z_]+:)/\\1/\n286\t    ')\"\n287\t    case \"$key_line\" in\n288\t      VERDICT:*)\n289\t        current_key=\"VERDICT\"; found_verdict=1\n290\t        raw_verdict=\"${key_line#VERDICT:}\"\n291\t        case \"$raw_verdict\" in \" \"*) raw_verdict=\"${raw_verdict# }\" ;; esac\n292\t        ;;\n293\t      REASON:*)\n294\t        current_key=\"REASON\"; found_reason=1\n295\t        raw_reason=\"${key_line#REASON:}\"\n296\t        case \"$raw_reason\" in \" \"*) raw_reason=\"${raw_reason# }\" ;; esac\n297\t        ;;\n298\t      STEER:*)\n299\t        current_key=\"STEER\"; found_steer=1\n300\t        raw_steer=\"${key_line#STEER:}\"\n301\t        case \"$raw_steer\" in \" \"*) raw_steer=\"${raw_steer# }\" ;; esac\n302\t        ;;\n303\t      GOAL_UPDATE:*)\n304\t        current_key=\"GOAL_UPDATE\"; found_goal=1\n305\t        raw_goal=\"${key_line#GOAL_UPDATE:}\"\n306\t        case \"$raw_goal\" in \" \"*) raw_goal=\"${raw_goal# }\" ;; esac\n307\t        ;;\n308\t      *)\n309\t        # Continuation line — append to whichever field is currently open.\n310\t        # Lines before the first KEY: marker (preamble noise) have current_key\n311\t        # empty and are dropped, matching the prompt's \"no preamble\" contract.\n312\t        # The original line (not the leading-whitespace-stripped key_line) is\n313\t        # preserved so multi-line paragraphs keep their indentation if any.\n314\t        case \"$current_key\" in\n315\t          VERDICT)     raw_verdict=\"${raw_verdict}\"$'\\n'\"${line}\" ;;\n316\t          REASON)      raw_reason=\"${raw_reason}\"$'\\n'\"${line}\" ;;\n317\t          STEER)       raw_steer=\"${raw_steer}\"$'\\n'\"${line}\" ;;\n318\t          GOAL_UPDATE) raw_goal=\"${raw_goal}\"$'\\n'\"${line}\" ;;\n319\t        esac\n320\t        ;;\n321\t    esac\n322\t  done <<< \"$content\"\n323\t\n324\t  # Partial-output policy: capture every field we DID find, default-fill the\n325\t  # rest. Pre-fix the parser bailed completely on any missing field —\n326\t  # silently returning all-defaults — which masked the LLM's actual\n327\t  # response. Now: VERDICT is required (a missing verdict can't be safely\n328\t  # defaulted to CONTINUE — that's confusing; bail), but REASON / STEER /\n329\t  # GOAL_UPDATE missing just keep their initial defaults (\"\", \"none\",\n330\t  # \"unchanged\") and we proceed with the verdict we have. The bare verdict\n331\t  # case (LLM emits \"VERDICT: CONTINUE\" followed by a paragraph instead of\n332\t  # the other three keys) now produces a useful tick: the verdict is\n333\t  # honored, the REASON section in overseer.log shows empty (operator can\n334\t  # tighten the prompt), STEER stays none, goal stays unchanged.\n335\t  if [ \"$found_verdict\" -ne 1 ]; then\n336\t    # No usable verdict at all — surface this so the operator sees the\n337\t    # parse failure in the overseer log instead of a silent all-defaults\n338\t    # fallback. Caller still gets the conservative CONTINUE default but\n339\t    # the parse-failure marker stamps the cause.\n340\t    ALMANAC_CONVERGE_PARSE_NOTE=\"no VERDICT marker found\"\n341\t    return 0\n342\t  fi\n343\t  ALMANAC_CONVERGE_PARSE_NOTE=\"\"\n344\t\n345\t  # Note in the parse marker which optional fields the LLM skipped — so the\n346\t  # operator can see whether to tighten the prompt for that model.\n347\t  local _missing=()\n348\t  [ \"$found_reason\" -eq 1 ] || _missing+=(REASON)\n349\t  [ \"$found_steer\" -eq 1 ]  || _missing+=(STEER)\n350\t  [ \"$found_goal\" -eq 1 ]   || _missing+=(GOAL_UPDATE)\n351\t  if [ \"${#_missing[@]}\" -gt 0 ]; then\n352\t    ALMANAC_CONVERGE_PARSE_NOTE=\"missing fields: ${_missing[*]}\"\n353\t  fi\n354\t\n355\t  # VERDICT is always a single token. A chatty LLM may put the token on its own\n356\t  # line and then ramble before REASON; the state-machine above will have\n357\t  # accumulated those ramble lines into raw_verdict. Reduce to the first\n358\t  # non-empty line so the case-match below still recognises the token.\n359\t  raw_verdict=\"$(printf '%s\\n' \"$raw_verdict\" | awk 'NF{print; exit}')\"\n360\t  raw_verdict=\"$(almanac_converge_trim \"$raw_verdict\")\"\n361\t  case \"$raw_verdict\" in\n362\t    CONVERGED|CONTINUE|STEER|STOP) ALMANAC_CONVERGE_VERDICT=\"$raw_verdict\" ;;\n363\t    *)\n364\t      ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n365\t      ALMANAC_CONVERGE_STEER=\"none\"\n366\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n367\t      return 0\n368\t      ;;\n369\t  esac\n370\t\n371\t  ALMANAC_CONVERGE_REASON=\"$(almanac_converge_trim \"$raw_reason\")\"\n372\t\n373\t  raw_steer=\"$(almanac_converge_trim \"$raw_steer\")\"\n374\t  if [ -n \"$raw_steer\" ] && ! printf '%s\\n' \"$raw_steer\" | grep -qiE '^none[[:space:]]*$'; then\n375\t    ALMANAC_CONVERGE_STEER=\"$raw_steer\"\n376\t  fi\n377\t\n378\t  if [ \"$found_goal\" -eq 1 ]; then\n379\t    local goal_check\n380\t    goal_check=\"$(almanac_converge_trim \"$raw_goal\")\"\n381\t    if [ -n \"$goal_check\" ] && ! printf '%s\\n' \"$goal_check\" | grep -qiE '^unchanged[[:space:]]*$'; then\n382\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"$raw_goal\"\n383\t    fi\n384\t  fi\n385\t}\n386\t\n387\t# Write the convergence.md final record.\n388\t#\n389\t# Args:\n390\t#   root           — repo root\n391\t#   goal           — initial goal text (used to derive the plan dir)\n392\t#   outcome        — authoritative loop result, one of:\n393\t#                      CONVERGED       overseer said so → goal met\n394\t#                      NON_CONVERGED   round budget hit before overseer converged\n395\t#                      STOPPED         stop signal (overseer STOP verdict OR human\n396\t#                                      `.converge-stop`)\n397\t#                      FAILED          exec error with CONVERGE_FAIL_ON_EXEC_ERROR=1\n398\t#                      ABORTED         EXIT trap fired (mid-loop _die, signal, etc.)\n399\t#   last_verdict   — the overseer's last raw verdict, informational only\n400\t#                    (e.g. \"CONTINUE\" is meaningless as a FINAL answer — it just\n401\t#                    means the overseer was asked one more time and wanted more\n402\t#                    rounds). Pass \"n/a\" if no overseer ran (e.g. --no-oversee).\n403\t#   tick           — round number reached\n404\t#   budget         — round budget configured for the run\n405\t#   started_epoch  — UNIX timestamp the run started (or empty for \"unknown\")\n406\t#   reason         — one-line termination reason (\"round budget exhausted (10/10)\",\n407\t#                    \"exec exit=2 round=4\", \"overseer verdict: CONVERGED\").\n408\t#\n409\t# Pre-fix the writer took only a single `verdict` argument and wrote it as\n410\t# \"Final verdict\", which conflated three different things: the overseer's last\n411\t# raw say, the loop's actual outcome, and whether convergence was reached.\n412\t# A run that hit the round budget without convergence wrote \"Final verdict:\n413\t# CONTINUE\" — readable as a soft answer, actually meaning \"the overseer wanted\n414\t# more rounds and we ran out\". The split here makes the misread structurally\n415\t# impossible: outcome is the source of truth, last_verdict is metadata.\n416\talmanac_converge_write_convergence() {\n417\t  local root=\"$1\"\n418\t  local goal=\"$2\"\n419\t  local outcome=\"$3\"\n420\t  local last_verdict=\"$4\"\n421\t  local tick=\"$5\"\n422\t  local budget=\"$6\"\n423\t  local started_epoch=\"${7:-}\"\n424\t  local reason=\"${8:-}\"\n425\t  local plan_dir now_epoch elapsed status_summary\n426\t\n427\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n428\t  now_epoch=\"$(date +%s)\"\n429\t  elapsed=\"\"\n430\t  case \"$started_epoch\" in\n431\t    ''|*[!0-9]*) ;;\n432\t    *) elapsed=\"$((now_epoch - started_epoch))s\" ;;\n433\t  esac\n434\t\n435\t  # Human-readable headline for the Outcome section — one line that future\n436\t  # operators (and agents reading convergence.md as evidence) can act on\n437\t  # without parsing the rest.\n438\t  case \"$outcome\" in\n439\t    CONVERGED)\n440\t      status_summary=\"CONVERGED — overseer reached convergence at round $tick of $budget.\"\n441\t      ;;\n442\t    NON_CONVERGED)\n443\t      status_summary=\"NON_CONVERGED — round budget exhausted ($tick/$budget) without overseer reaching CONVERGED.\"\n444\t      ;;\n445\t    STOPPED)\n446\t      status_summary=\"STOPPED — halted by stop signal at round $tick of $budget.\"\n447\t      ;;\n448\t    FAILED)\n449\t      status_summary=\"FAILED — exec error at round $tick of $budget.\"\n450\t      ;;\n451\t    ABORTED)\n452\t      status_summary=\"ABORTED — loop exited unexpectedly at round $tick of $budget (signal, mid-loop _die, etc.).\"\n453\t      ;;\n454\t    *)\n455\t      status_summary=\"UNKNOWN ($outcome) — round $tick of $budget.\"\n456\t      ;;\n457\t  esac\n458\t\n459\t  {\n460\t    printf '# Convergence\\n\\n'\n461\t    printf '## Outcome\\n\\n%s\\n\\n' \"$status_summary\"\n462\t    printf '## Last overseer verdict\\n\\n%s\\n\\n' \"${last_verdict:-n/a}\"\n463\t    printf '## Tick count\\n\\n%s of %s\\n\\n' \"$tick\" \"$budget\"\n464\t    printf '## Time elapsed\\n\\n%s\\n\\n' \"${elapsed:-unknown}\"\n465\t    printf '## Final goal\\n\\n'\n466\t    if [ -f \"$plan_dir/goal.md\" ]; then\n467\t      cat \"$plan_dir/goal.md\"\n468\t    fi\n469\t    printf '\\n\\n## Termination reason\\n\\n%s\\n' \"${reason:-none}\"\n470\t  } > \"$plan_dir/convergence.md\"\n471\t}\n472\t\n473\talmanac_converge_goal_summary() {\n474\t  printf '%s' \"$1\" | tr '\\n' ' ' | cut -c 1-80\n475\t}\n476\t\n477\talmanac_converge_latest_run_id() {\n478\t  local root=\"$1\"\n479\t  local slug=\"$2\"\n480\t  local rows id type target pid status_rel started status match=\"\"\n481\t\n482\t  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n483\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n484\t    [ -n \"$id\" ] || continue\n485\t    [ \"$type\" = \"converge\" ] || continue\n486\t    [ \"$target\" = \"$slug\" ] || continue\n487\t    match=\"$id\"\n488\t  done <<< \"$rows\"\n489\t\n490\t  [ -n \"$match\" ] || return 1\n491\t  printf '%s\\n' \"$match\"\n492\t}\n493\t\n494\talmanac_converge_worker_health() {\n495\t  local root=\"$1\"\n496\t  local run_id=\"$2\"\n497\t  local status_file status\n498\t\n499\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n500\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"dead\"; return 0; }\n501\t\n502\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n503\t  if [ \"$status\" = \"running\" ] && ! almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n504\t    printf '%s\\n' \"alive\"\n505\t  else\n506\t    printf '%s\\n' \"dead\"\n507\t  fi\n508\t}\n509\t\n510\talmanac_converge_last_verdict_line() {\n511\t  local log_file=\"$1\"\n512\t\n513\t  [ -f \"$log_file\" ] || return 1\n514\t  awk '\n515\t    /^===== tick=/ { verdict = \"\"; reason = \"\" }\n516\t    /^VERDICT: / { verdict = substr($0, 10) }\n517\t    /^REASON: / { reason = substr($0, 9) }\n518\t    END {\n519\t      if (verdict != \"\" || reason != \"\") {\n520\t        printf \"%s\\t%s\\n\", verdict, reason\n521\t      }\n522\t    }\n523\t  ' \"$log_file\"\n524\t}\n525\t\n526\talmanac_converge_last_report_header() {\n527\t  local reports_file=\"$1\"\n528\t\n529\t  [ -f \"$reports_file\" ] || return 1\n530\t  grep -E '^===== tick=[0-9][0-9]* ts=.* =====$' \"$reports_file\" 2>/dev/null | tail -n 1\n531\t}\n532\t\n533\talmanac_converge_goal_mutation_count() {\n534\t  local history_file=\"$1\"\n535\t\n536\t  [ -f \"$history_file\" ] || { printf '%s\\n' \"0\"; return 0; }\n537\t  awk '/^===== tick=[0-9][0-9]* ts=.* overseer=/ { c++ } END { print c + 0 }' \"$history_file\"\n538\t}\n539\t\n540\talmanac_converge_dashboard_frame() {\n541\t  local root=\"$1\"\n542\t  local slug=\"$2\"\n543\t  local plan_dir goal_file reports_file history_file log_file\n544\t  local run_id=\"\" status_file round=\"\" rounds=\"\" health=\"dead\"\n545\t  local verdict=\"none\" reason=\"none\" verdict_line report_header goal_text goal_summary mutations\n546\t  local tab=$'\\t'\n547\t\n548\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n549\t  [ -d \"$plan_dir\" ] || return 1\n550\t\n551\t  goal_file=\"$plan_dir/goal.md\"\n552\t  reports_file=\"$plan_dir/agent-reports.log\"\n553\t  history_file=\"$plan_dir/goal.history.log\"\n554\t  log_file=\"$plan_dir/overseer.log\"\n555\t\n556\t  if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n557\t    status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n558\t    round=\"$(almanac_loop_status_field \"$status_file\" \"round\" 2>/dev/null || true)\"\n559\t    rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" 2>/dev/null || true)\"\n560\t    health=\"$(almanac_converge_worker_health \"$root\" \"$run_id\")\"\n561\t  fi\n562\t  [ -n \"$round\" ] || round=\"0\"\n563\t  [ -n \"$rounds\" ] || rounds=\"?\"\n564\t\n565\t  if verdict_line=\"$(almanac_converge_last_verdict_line \"$log_file\" 2>/dev/null)\"; then\n566\t    verdict=\"${verdict_line%%$tab*}\"\n567\t    reason=\"${verdict_line#*$tab}\"\n568\t    [ \"$reason\" != \"$verdict_line\" ] || reason=\"none\"\n569\t    [ -n \"$verdict\" ] || verdict=\"none\"\n570\t    [ -n \"$reason\" ] || reason=\"none\"\n571\t  fi\n572\t\n573\t  report_header=\"$(almanac_converge_last_report_header \"$reports_file\" 2>/dev/null || true)\"\n574\t  [ -n \"$report_header\" ] || report_header=\"none\"\n575\t\n576\t  goal_text=\"\"\n577\t  [ -f \"$goal_file\" ] && goal_text=\"$(cat \"$goal_file\")\"\n578\t  goal_summary=\"$(almanac_converge_goal_summary \"$goal_text\")\"\n579\t  [ -n \"$goal_summary\" ] || goal_summary=\"none\"\n580\t  mutations=\"$(almanac_converge_goal_mutation_count \"$history_file\")\"\n581\t\n582\t  printf 'converge %s\\n' \"$slug\"\n583\t  printf 'current round: %s/%s\\n' \"$round\" \"$rounds\"\n584\t  printf 'last verdict: %s\\n' \"$verdict\"\n585\t  printf 'reason: %s\\n' \"$reason\"\n586\t  printf 'last report: %s\\n' \"$report_header\"\n587\t  printf 'goal: %s\\n' \"$goal_summary\"\n588\t  printf 'goal mutations: %s\\n' \"$mutations\"\n589\t  printf 'worker health: %s\\n' \"$health\"\n590\t}\n591\t\n592\talmanac_converge_status() {\n593\t  local root=\"$1\"\n594\t  local slug=\"$2\"\n595\t  local frame\n596\t\n597\t  frame=\"$(almanac_converge_dashboard_frame \"$root\" \"$slug\")\" || return 1\n598\t  printf '%s\\n' \"$frame\" | almanac_loop_ui_render\n599\t}\n600\t\n601\talmanac_converge_watch() {\n602\t  local root=\"$1\"\n603\t  local slug=\"$2\"\n604\t  local mode=\"${3:-}\"\n605\t  local interval=\"${CONVERGE_WATCH_INTERVAL:-${ALMANAC_HUB_WATCH_INTERVAL:-2}}\"\n606\t  local run_id status_file status\n607\t\n608\t  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n609\t    almanac_converge_status \"$root\" \"$slug\"\n610\t    return\n611\t  fi\n612\t\n613\t  while :; do\n614\t    almanac_loop_ui_clear\n615\t    almanac_converge_status \"$root\" \"$slug\"\n616\t    if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n617\t      status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n618\t      status=\"$(almanac_loop_status_field \"$status_file\" \"status\" 2>/dev/null || true)\"\n619\t      case \"$status\" in\n620\t        done|failed|aborted) break ;;\n621\t      esac\n622\t    fi\n623\t    sleep \"$interval\"\n624\t  done\n625\t}\n626\t\n627\talmanac_converge_stop() {\n628\t  local root=\"$1\"\n629\t  local slug=\"$2\"\n630\t  local plan_dir root_stop plan_stop\n631\t\n632\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n633\t  [ -d \"$plan_dir\" ] || return 1\n634\t  root_stop=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n635\t  plan_stop=\"$(almanac_loop_run_control_file converge \"$plan_dir\" stop)\"\n636\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$root_stop\"\n637\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$plan_stop\"\n638\t}\n639\t\n640\talmanac_converge_apply_goal_update() {\n641\t  local root=\"$1\"\n642\t  local goal=\"$2\"\n643\t  local round=\"$3\"\n644\t  local provider=\"$4\"\n645\t  local reason=\"$5\"\n646\t  local new_goal=\"$6\"\n647\t  local plan_dir goal_file history_file log_file ts old_goal old_file new_file diff_output diff_status summary\n648\t\n649\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n650\t  goal_file=\"$plan_dir/goal.md\"\n651\t  history_file=\"$plan_dir/goal.history.log\"\n652\t  log_file=\"$plan_dir/overseer.log\"\n653\t  ts=\"$(almanac_loop_now_utc)\"\n654\t  old_goal=\"\"\n655\t  [ -f \"$goal_file\" ] && old_goal=\"$(cat \"$goal_file\")\"\n656\t\n657\t  old_file=\"$plan_dir/.goal.old.$$\"\n658\t  new_file=\"$plan_dir/.goal.new.$$\"\n659\t  printf '%s\\n' \"$old_goal\" > \"$old_file\"\n660\t  printf '%s\\n' \"$new_goal\" > \"$new_file\"\n661\t\n662\t  diff_output=\"\"\n663\t  diff_status=127\n664\t  if command -v diff >/dev/null 2>&1; then\n665\t    if diff_output=\"$(diff -u \"$old_file\" \"$new_file\" 2>/dev/null)\"; then\n666\t      diff_status=0\n667\t    else\n668\t      diff_status=$?\n669\t    fi\n670\t  fi\n671\t\n672\t  {\n673\t    printf '===== tick=%s ts=%s overseer=%s =====\\n' \"$round\" \"$ts\" \"$provider\"\n674\t    printf 'REASON: %s\\n' \"$reason\"\n675\t    if [ \"$diff_status\" -le 1 ]; then\n676\t      printf -- '--- DIFF ---\\n'\n677\t      printf '%s\\n' \"$diff_output\"\n678\t    else\n679\t      printf -- '--- AFTER ---\\n'\n680\t      printf '%s\\n' \"$new_goal\"\n681\t    fi\n682\t  } >> \"$history_file\"\n683\t\n684\t  printf '%s\\n' \"$new_goal\" > \"$goal_file\"\n685\t  rm -f \"$old_file\" \"$new_file\"\n686\t\n687\t  summary=\"$(almanac_converge_goal_summary \"$new_goal\")\"\n688\t  printf '[tick=%s] goal updated: %s\\n' \"$round\" \"$summary\" >> \"$log_file\"\n689\t}\n690\t\n691\talmanac_converge_run_finalize() {\n692\t  local root=\"$1\"\n693\t  local run_id=\"$2\"\n694\t  local status=\"$3\"\n695\t  local reason=\"${4:-}\"\n696\t\n697\t  trap - EXIT INT TERM\n698\t  [ -n \"$run_id\" ] || return 0\n699\t  almanac_loop_mark_run_status \"$root\" \"$run_id\" \"$status\" \"\" \"$reason\" >/dev/null 2>&1 || true\n700\t}\n701\t\n702\talmanac_converge_git_user_status() {\n703\t  local root=\"$1\"\n704\t  local plan_dir=\"$2\"\n705\t  local rel_plan\n706\t\n707\t  git -C \"$root\" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1\n708\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n709\t\n710\t  if [ \"$rel_plan\" = \"$plan_dir\" ]; then\n711\t    git -C \"$root\" status --porcelain -- . ':!.almanac'\n712\t  else\n713\t    git -C \"$root\" status --porcelain -- . ':!.almanac' \":!$rel_plan\"\n714\t  fi\n715\t}\n716\t\n717\talmanac_converge_run_worker() {\n718\t  local root=\"$1\"\n719\t  local goal=\"$2\"\n720\t  local exec_cmd=\"$3\"\n721\t  local round=\"$4\"\n722\t  local provider model effort prompt_file result_file events_file plan_dir slug rc\n723\t\n724\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n725\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n726\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n727\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n728\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n729\t\n730\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-prompt.XXXXXX\")\"\n731\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-result.XXXXXX\")\"\n732\t  # Persistent per-round session log under the plan dir (mirrors ralph's\n733\t  # docs/plans/<name>/ralph-codex-iteration-N.log). The full raw event stream\n734\t  # tees here while the filtered agent-message text streams live to the\n735\t  # terminal — operator sees progress, durable log is kept for forensics.\n736\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n737\t\n738\t  almanac_converge_worker_prompt \"$root\" \"$goal\" \"$exec_cmd\" \"$round\" > \"$prompt_file\"\n739\t\n740\t  _info \"Converge round $round — exec-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n741\t\n742\t  # danger-full-access sandbox: converge runs are autonomous-by-design.\n743\t  # `claude --print` has no human to answer a permission prompt, so anything\n744\t  # less than full access dies on every un-allowlisted Bash call (\"This\n745\t  # command requires approval\"). For codex this drops the sandbox; for claude\n746\t  # it maps to --permission-mode bypassPermissions (per the provider adapter).\n747\t  rc=0\n748\t  almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n749\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr || rc=$?\n750\t\n751\t  rm -f \"$prompt_file\" \"$result_file\"\n752\t  return \"$rc\"\n753\t}\n754\t\n755\t# Prompt-mode round: the user's --prompt text IS the agent invocation. No worker\n756\t# template wrapper — the agent receives the prompt verbatim, prefixed only with\n757\t# a one-shot .converge-steer directive if one is queued. This is the dominant\n758\t# mode for \"run skill X in a convergence loop\" workflows; the loop driver\n759\t# handles the bookkeeping (auto-commit + agent-reports.log entry) after the\n760\t# agent exits, instead of asking the agent to know about CONVERGE conventions.\n761\t#\n762\t# Returns the agent's exit code; commit and report writes are best-effort and\n763\t# never alter the return.\n764\t# List every currently-dirty path in $root, one per line, sorted+deduped.\n765\t# Output is the union of:\n766\t#   - tracked-modified paths (`git diff --name-only HEAD`)\n767\t#   - untracked-not-ignored paths (`git ls-files --others --exclude-standard`)\n768\t# Used by the prompt-mode auto-commit to distinguish PRE-EXISTING dirty work\n769\t# (untouched by the agent) from AGENT-TOUCHED paths (commit candidates). Empty\n770\t# string on git failure or non-repo. Pure read-only — safe to call multiple\n771\t# times per round.\n772\talmanac_converge_dirty_paths() {\n773\t  local root=\"$1\"\n774\t  ( cd \"$root\" \\\n775\t      && { git diff --name-only HEAD 2>/dev/null; \\\n776\t           git ls-files --others --exclude-standard 2>/dev/null; } \\\n777\t      | sort -u\n778\t  )\n779\t}\n780\t\n781\t# Auto-commit ONLY the paths the agent newly touched this round, computed as\n782\t# (dirty-after) - (dirty-before). Pre-existing dirty paths are left alone so a\n783\t# concurrent unrelated edit never gets swept into a CONVERGE commit (the bug\n784\t# that caused commit 4526a58 to misattribute the developer's in-flight edits\n785\t# to the agent). Files that were pre-existing dirty AND also touched by the\n786\t# agent stay dirty — conservative; the agent's change in that file isn't\n787\t# committed by this round, but no false attribution happens. Best-effort:\n788\t# commit failure logs a warn and never alters the caller's return code.\n789\t#\n790\t# Args: ROOT SLUG ROUND PRE_DIRTY (newline-separated pre-existing dirty paths)\n791\talmanac_converge_commit_agent_paths() {\n792\t  local root=\"$1\" slug=\"$2\" round=\"$3\" pre_dirty=\"$4\"\n793\t  local post_dirty agent_paths\n794\t\n795\t  post_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n796\t  # comm needs sorted inputs; both producers (almanac_converge_dirty_paths +\n797\t  # the snapshot taken before the agent ran) emit sorted-unique.\n798\t  agent_paths=\"$(comm -23 <(printf '%s\\n' \"$post_dirty\") <(printf '%s\\n' \"$pre_dirty\") | sed '/^$/d')\"\n799\t\n800\t  if [ -z \"$agent_paths\" ]; then\n801\t    # Either the agent didn't change anything OR every change was on a path\n802\t    # that was already dirty (so the change stays uncommitted on purpose).\n803\t    return 0\n804\t  fi\n805\t\n806\t  # Stage each agent-touched path individually (handles deletions, new files,\n807\t  # and modifications — `git add` accepts paths to files that no longer exist\n808\t  # by recording the deletion).\n809\t  local path failed=0\n810\t  while IFS= read -r path; do\n811\t    [ -n \"$path\" ] || continue\n812\t    (cd \"$root\" && git add -- \"$path\" >/dev/null 2>&1) || failed=1\n813\t  done <<< \"$agent_paths\"\n814\t\n815\t  if [ \"$failed\" -eq 1 ]; then\n816\t    _warn \"Converge round $round: staging one or more agent-touched paths failed (changes left in worktree)\"\n817\t    return 0\n818\t  fi\n819\t\n820\t  if ! (cd \"$root\" \\\n821\t          && git -c user.email=converge@almanac -c user.name=converge \\\n822\t                 commit -m \"CONVERGE($slug): round $round\" --no-verify >/dev/null 2>&1); then\n823\t    _warn \"Converge round $round: auto-commit failed (changes left in worktree)\"\n824\t  fi\n825\t}\n826\t\n827\talmanac_converge_run_worker_prompt() {\n828\t  local root=\"$1\"\n829\t  local goal=\"$2\"\n830\t  local prompt=\"$3\"\n831\t  local round=\"$4\"\n832\t  local provider model effort prompt_file result_file events_file rc\n833\t  local slug plan_dir log_file steer_path ts result_summary\n834\t\n835\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n836\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n837\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n838\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n839\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n840\t  log_file=\"$plan_dir/agent-reports.log\"\n841\t  steer_path=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n842\t\n843\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-prompt.XXXXXX\")\"\n844\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-result.XXXXXX\")\"\n845\t  # Persistent per-round session log under the plan dir (same shape as\n846\t  # exec-mode + ralph's per-iteration logs). Streams live to terminal so the\n847\t  # operator sees the agent working; tees the raw stream here for forensics.\n848\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n849\t\n850\t  # Steer (one-shot): emitted by the overseer in the prior round, consumed and\n851\t  # removed here so the next overseer tick can re-emit if the issue persists.\n852\t  # Steer prefix comes BEFORE the user prompt so a slash command sees the\n853\t  # directive as context before its own work.\n854\t  {\n855\t    if [ -f \"$steer_path\" ]; then\n856\t      printf '# Steer directive (from previous overseer tick):\\n'\n857\t      cat \"$steer_path\"\n858\t      printf '\\n\\n'\n859\t      rm -f \"$steer_path\"\n860\t    fi\n861\t    printf '%s\\n' \"$prompt\"\n862\t  } > \"$prompt_file\"\n863\t\n864\t  _info \"Converge round $round — prompt-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n865\t\n866\t  # Snapshot the dirty worktree BEFORE the agent runs so the auto-commit below\n867\t  # can stage only the paths the agent newly touches — not whatever unrelated\n868\t  # work the operator had in-flight. (Without this snapshot, an earlier `git\n869\t  # add -A` swept up the developer's uncommitted edits and committed them\n870\t  # under the agent's name — bug observed in commit 4526a58.)\n871\t  local pre_dirty\n872\t  pre_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n873\t\n874\t  # danger-full-access: same rationale as exec-mode worker — converge agents\n875\t  # need to run arbitrary shell (tests, git status, lint) the prompt asks for.\n876\t  rc=0\n877\t  (cd \"$root\" && almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n878\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr) || rc=$?\n879\t\n880\t  # Auto-commit only the agent-touched paths. A smart prompt may have committed\n881\t  # itself (worktree clean, nothing to do); a slash command like\n882\t  # /almanac:codebase-improve typically doesn't commit, so the driver does it.\n883\t  # Best-effort: a failed commit logs a warn but never alters the return code —\n884\t  # the agent's work itself succeeded or failed, the commit is bookkeeping.\n885\t  almanac_converge_commit_agent_paths \"$root\" \"$slug\" \"$round\" \"$pre_dirty\"\n886\t\n887\t  # Auto-write a minimal self-report. Format mirrors slice-03's worker block\n888\t  # (===== tick=N ts=ISO mode=prompt exit=N =====) so the overseer's parser\n889\t  # treats it the same. result_summary is the first 500 bytes of the agent's\n890\t  # final message — enough for the overseer to see \"what the agent said it\n891\t  # did\" without dragging the full transcript through the prompt budget.\n892\t  ts=\"$(almanac_loop_now_utc)\"\n893\t  result_summary=\"(no agent output)\"\n894\t  if [ -s \"$result_file\" ]; then\n895\t    result_summary=\"$(head -c 500 \"$result_file\")\"\n896\t  fi\n897\t  {\n898\t    printf '\\n===== tick=%s ts=%s mode=prompt exit=%s =====\\n' \"$round\" \"$ts\" \"$rc\"\n899\t    printf 'summary:\\n'\n900\t    printf '%s\\n' \"$result_summary\"\n901\t    printf 'concerns:\\n(none captured — prompt mode does not enforce structured self-report)\\n'\n902\t    printf 'next:\\n(driven by overseer / next-round prompt)\\n'\n903\t  } >> \"$log_file\"\n904\t\n905\t  # events_file is the persistent per-round session log under the plan dir —\n906\t  # NOT removed here. prompt/result are still scratch.\n907\t  rm -f \"$prompt_file\" \"$result_file\"\n908\t  return \"$rc\"\n909\t}\n910\t\n911\talmanac_converge_run_overseer() {\n912\t  local root=\"$1\"\n913\t  local goal=\"$2\"\n914\t  local round=\"$3\"\n915\t  local provider model effort prompt_file result_file events_file result rc plan_dir log_file ts\n916\t\n917\t  provider=\"$(almanac_converge_role_field \"overseer\" \"provider\")\"\n918\t  model=\"$(almanac_converge_role_field \"overseer\" \"model\")\"\n919\t  effort=\"$(almanac_converge_role_field \"overseer\" \"effort\")\"\n920\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n921\t  log_file=\"$plan_dir/overseer.log\"\n922\t\n923\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-prompt.XXXXXX\")\"\n924\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-result.XXXXXX\")\"\n925\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-events.XXXXXX\")\"\n926\t\n927\t  almanac_converge_overseer_prompt \"$root\" \"$goal\" \"$round\" > \"$prompt_file\"\n928\t\n929\t  rc=0\n930\t  (cd \"$root\" && almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"read-only\" \\\n931\t    \"$prompt_file\" \"$result_file\" \"$events_file\") >/dev/null || rc=$?\n932\t\n933\t  result=\"\"\n934\t  [ -s \"$result_file\" ] && result=\"$(cat \"$result_file\")\"\n935\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n936\t\n937\t  [ \"$rc\" -eq 0 ] || _warn \"Converge overseer tick $round exited $rc; continuing\"\n938\t  almanac_converge_overseer_parse \"$result\"\n939\t\n940\t  # Log the RAW LLM response alongside the parsed verdict. Pre-fix the\n941\t  # overseer log showed only the parsed fields, so a parse failure (LLM\n942\t  # using markdown bold, skipping fields, putting the value on the next\n943\t  # line) looked identical to \"the LLM gave us nothing useful\". The raw\n944\t  # block is fenced so it's visually distinct from the structured parser\n945\t  # output and easy to grep for (\"===== RAW =====\") when debugging.\n946\t  ts=\"$(almanac_loop_now_utc)\"\n947\t  {\n948\t    printf '\\n===== tick=%s ts=%s overseer=%s exit=%s =====\\n' \"$round\" \"$ts\" \"$provider\" \"$rc\"\n949\t    printf 'VERDICT: %s\\n' \"$ALMANAC_CONVERGE_VERDICT\"\n950\t    printf 'REASON: %s\\n' \"$ALMANAC_CONVERGE_REASON\"\n951\t    printf 'STEER: %s\\n' \"$ALMANAC_CONVERGE_STEER\"\n952\t    printf 'GOAL_UPDATE: %s\\n' \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n953\t    if [ -n \"${ALMANAC_CONVERGE_PARSE_NOTE:-}\" ]; then\n954\t      printf 'PARSE_NOTE: %s\\n' \"$ALMANAC_CONVERGE_PARSE_NOTE\"\n955\t    fi\n956\t    printf '\\n===== RAW LLM RESPONSE =====\\n'\n957\t    if [ -n \"$result\" ]; then\n958\t      printf '%s\\n' \"$result\"\n959\t    else\n960\t      printf '(empty — provider exited %s with no final message)\\n' \"$rc\"\n961\t    fi\n962\t    printf '===== END RAW =====\\n'\n963\t  } >> \"$log_file\"\n964\t\n965\t  if [ \"$ALMANAC_CONVERGE_GOAL_UPDATE\" != \"unchanged\" ]; then\n966\t    almanac_converge_apply_goal_update \"$root\" \"$goal\" \"$round\" \"$provider\" \\\n967\t      \"$ALMANAC_CONVERGE_REASON\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n968\t  fi\n969\t\n970\t  case \"$ALMANAC_CONVERGE_VERDICT\" in\n971\t    CONVERGED|STOP)\n972\t      : > \"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n973\t      ;;\n974\t    STEER)\n975\t      if [ \"$ALMANAC_CONVERGE_STEER\" != \"none\" ]; then\n976\t        printf '%s\\n' \"$ALMANAC_CONVERGE_STEER\" > \"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n977\t      fi\n978\t      ;;\n979\t    CONTINUE) ;;\n980\t  esac\n981\t}\n982\t\n983\talmanac_converge_run() {\n984\t  local root=\"$1\"\n985\t  local goal=\"$2\"\n986\t  local exec_cmd=\"$3\"\n987\t  local rounds=\"${4:-${CONVERGE_ROUND_BUDGET:-10}}\"\n988\t  local no_oversee=\"${5:-0}\"\n989\t  local oversee_every=\"${6:-1}\"\n990\t  local prompt=\"${7:-}\"\n991\t  local slug plan_dir run_id pid exec_rc round started_epoch action_mode\n992\t  local final_status final_outcome final_verdict final_reason\n993\t\n994\t  # Mode dispatch: prompt-mode (agent invocation, dominant) vs exec-mode (shell\n995\t  # command in a wrapping worker, escape hatch). cmd/converge.sh enforces the\n996\t  # mutex; here we just pick a label for run-config + dispatch.\n997\t  if [ -n \"$prompt\" ]; then\n998\t    action_mode=\"prompt\"\n999\t  else\n1000\t    action_mode=\"exec\"\n1001\t  fi\n1002\t\n1003\t  case \"$rounds\" in\n1004\t    ''|*[!0-9]*) _die \"--rounds must be a positive integer: $rounds\" ;;\n1005\t  esac\n1006\t  [ \"$rounds\" -ge 1 ] || _die \"--rounds must be at least 1: $rounds\"\n1007\t\n1008\t  case \"$oversee_every\" in\n1009\t    ''|*[!0-9]*) _die \"--oversee-every must be a positive integer: $oversee_every\" ;;\n1010\t  esac\n1011\t  [ \"$oversee_every\" -ge 1 ] || _die \"--oversee-every must be at least 1: $oversee_every\"\n1012\t\n1013\t  case \"$no_oversee\" in\n1014\t    1|true|yes|on) no_oversee=1 ;;\n1015\t    *) no_oversee=0 ;;\n1016\t  esac\n1017\t\n1018\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n1019\t  pid=\"${BASHPID:-$$}\"\n1020\t  started_epoch=\"$(date +%s)\"\n1021\t  run_id=\"$(almanac_loop_register_run \"$root\" \"converge\" \"$slug\" \"$pid\")\" \\\n1022\t    || _die \"Could not register converge run\"\n1023\t\n1024\t  local _converge_run_finalize_cmd\n1025\t  printf -v _converge_run_finalize_cmd 'almanac_converge_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n1026\t  trap \"${_converge_run_finalize_cmd}; exit 130\" INT TERM\n1027\t  trap \"${_converge_run_finalize_cmd}\" EXIT\n1028\t\n1029\t  # Persist enough of the launch config that the hub's resume path can rebuild\n1030\t  # the same invocation from status.tsv alone — see almanac_loop_converge_status_to_opts.\n1031\t  # Without these the hub would resume with --goal blank / no action verb.\n1032\t  almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n1033\t    \"goal=$goal\" \\\n1034\t    \"prompt=$prompt\" \\\n1035\t    \"exec=$exec_cmd\" \\\n1036\t    \"rounds=$rounds\" \\\n1037\t    \"oversee=$([ \"$no_oversee\" -eq 1 ] && printf off || printf 'every-%s' \"$oversee_every\")\" \\\n1038\t    \"oversee_every=$oversee_every\" \\\n1039\t    >/dev/null 2>&1 || true\n1040\t\n1041\t  almanac_converge_scaffold \"$root\" \"$goal\"\n1042\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n1043\t\n1044\t  # Default state when the loop exits via the round budget. `final_verdict` is\n1045\t  # the overseer's LAST raw say (informational); `final_outcome` is the\n1046\t  # AUTHORITATIVE termination shape (used to label convergence.md). A run that\n1047\t  # hits the budget without an overseer-said CONVERGED is NON_CONVERGED — the\n1048\t  # loop ran out of attempts, not consensus. Pre-fix the convergence.md just\n1049\t  # echoed final_verdict, so a budget exhaustion looked like \"Final verdict:\n1050\t  # CONTINUE\" — misread by future agents (and humans) as a soft stop.\n1051\t  final_status=\"done\"\n1052\t  final_outcome=\"NON_CONVERGED\"\n1053\t  if [ \"$no_oversee\" -eq 1 ]; then\n1054\t    final_verdict=\"n/a\"\n1055\t    final_reason=\"overseer disabled; round budget ($rounds) exhausted\"\n1056\t  else\n1057\t    final_verdict=\"CONTINUE\"\n1058\t    final_reason=\"round budget ($rounds) exhausted; overseer's last verdict was CONTINUE\"\n1059\t  fi\n1060\t\n1061\t  local _converge_stop_file\n1062\t  _converge_stop_file=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n1063\t\n1064\t  round=0\n1065\t  while [ \"$round\" -lt \"$rounds\" ]; do\n1066\t    if [ -f \"$_converge_stop_file\" ]; then\n1067\t      final_status=\"aborted\"\n1068\t      final_outcome=\"STOPPED\"\n1069\t      final_verdict=\"STOP\"\n1070\t      final_reason=\"stop signal present before round $((round + 1))\"\n1071\t      break\n1072\t    fi\n1073\t\n1074\t    round=$((round + 1))\n1075\t    case \"$action_mode\" in\n1076\t      prompt)\n1077\t        if almanac_converge_run_worker_prompt \"$root\" \"$goal\" \"$prompt\" \"$round\"; then\n1078\t          exec_rc=0\n1079\t        else\n1080\t          exec_rc=$?\n1081\t        fi\n1082\t        ;;\n1083\t      *)\n1084\t        if (cd \"$root\" && almanac_converge_run_worker \"$root\" \"$goal\" \"$exec_cmd\" \"$round\"); then\n1085\t          exec_rc=0\n1086\t        else\n1087\t          exec_rc=$?\n1088\t        fi\n1089\t        ;;\n1090\t    esac\n1091\t\n1092\t    # In exec-mode the worker is authoritative for commits (slice 03 contract).\n1093\t    # In prompt-mode the driver already attempted the auto-commit inside the\n1094\t    # worker function and will have warned on failure, so the check is skipped\n1095\t    # to avoid a duplicate / misleading \"driver will not commit\" message.\n1096\t    if [ \"$action_mode\" = \"exec\" ] \\\n1097\t       && [ -n \"$(almanac_converge_git_user_status \"$root\" \"$plan_dir\" 2>/dev/null || true)\" ]; then\n1098\t      _warn \"Converge round $round: worker left uncommitted changes; driver will not commit\"\n1099\t    fi\n1100\t\n1101\t    if [ \"$exec_rc\" -ne 0 ]; then\n1102\t      if [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n1103\t        _warn \"Converge round $round exec exited $exec_rc; stopping\"\n1104\t      else\n1105\t        _warn \"Converge round $round exec exited $exec_rc; continuing\"\n1106\t      fi\n1107\t    fi\n1108\t\n1109\t    almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \"goal=$slug\" >/dev/null 2>&1 || true\n1110\t\n1111\t    if [ \"$exec_rc\" -ne 0 ] && [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n1112\t      almanac_converge_write_convergence \"$root\" \"$goal\" \\\n1113\t        \"FAILED\" \"${final_verdict:-n/a}\" \"$round\" \"$rounds\" \"$started_epoch\" \\\n1114\t        \"exec exit=$exec_rc round=$round\"\n1115\t      almanac_converge_run_finalize \"$root\" \"$run_id\" \"failed\" \"exec exit=$exec_rc round=$round\"\n1116\t      return \"$exec_rc\"\n1117\t    fi\n1118\t\n1119\t    if [ \"$no_oversee\" -eq 0 ] && [ $((round % oversee_every)) -eq 0 ]; then\n1120\t      almanac_converge_run_overseer \"$root\" \"$goal\" \"$round\"\n1121\t      final_verdict=\"$ALMANAC_CONVERGE_VERDICT\"\n1122\t      final_reason=\"$ALMANAC_CONVERGE_REASON\"\n1123\t      case \"$ALMANAC_CONVERGE_VERDICT\" in\n1124\t        CONVERGED)\n1125\t          final_status=\"done\"\n1126\t          final_outcome=\"CONVERGED\"\n1127\t          [ -n \"$final_reason\" ] || final_reason=\"overseer verdict: CONVERGED at round $round\"\n1128\t          break\n1129\t          ;;\n1130\t        STOP)\n1131\t          final_status=\"aborted\"\n1132\t          final_outcome=\"STOPPED\"\n1133\t          [ -n \"$final_reason\" ] || final_reason=\"overseer verdict: STOP at round $round\"\n1134\t          break\n1135\t          ;;\n1136\t      esac\n1137\t    fi\n1138\t  done\n1139\t\n1140\t  almanac_converge_write_convergence \"$root\" \"$goal\" \\\n1141\t    \"$final_outcome\" \"$final_verdict\" \"$round\" \"$rounds\" \"$started_epoch\" \"$final_reason\"\n1142\t  almanac_converge_run_finalize \"$root\" \"$run_id\" \"$final_status\"\n1143\t}\n1144\t"}]},"parent_tool_use_id":null,"session_id":"2b9bb146-1d8c-4ac2-bc65-549f8194c6ce","uuid":"09fa4e04-906f-4410-ba4c-f36661daf6d6","timestamp":"2026-05-27T07:55:58.368Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/converge-core.sh","content":"#!/usr/bin/env bash\n# converge-core.sh - Generic convergence loop core\n\n# Source focused deps idempotently so tests can source this file directly.\n# core.sh owns the helper, so it's pulled in via the literal pattern.\nif ! declare -F _error >/dev/null 2>&1; then\n  __converge_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/core.sh\n  source \"$__converge_core_dir/core.sh\"\n  unset __converge_core_dir\nfi\n\n_almanac_source_sibling run.sh    almanac_loop_register_run\n_almanac_source_sibling agent.sh  almanac_loop_agent_capture\n_almanac_source_sibling role.sh   almanac_loop_role_config\n\nalmanac_converge_plan_dir() {\n  local root=\"$1\"\n  local slug=\"$2\"\n\n  almanac_loop_plan_dir converge \"$root\" \"$slug\"\n}\n\nalmanac_converge_scaffold() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local plan_dir\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n\n  if ! mkdir -p \"$plan_dir\"; then\n    _die \"Could not create converge plan dir: ${plan_dir#\"$root\"/}\"\n  fi\n  if ! printf '%s\\n' \"$goal\" > \"$plan_dir/goal.md\"; then\n    _die \"Could not write converge goal: ${plan_dir#\"$root\"/}/goal.md\"\n  fi\n  if ! : > \"$plan_dir/agent-reports.log\"; then\n    _die \"Could not write converge report log: ${plan_dir#\"$root\"/}/agent-reports.log\"\n  fi\n  if ! : > \"$plan_dir/goal.history.log\"; then\n    _die \"Could not write converge goal history: ${plan_dir#\"$root\"/}/goal.history.log\"\n  fi\n}\n\nalmanac_converge_role() {\n  local role=\"$1\"\n\n  case \"$role\" in\n    agent|overseer) ;;\n    *) return 2 ;;\n  esac\n\n  almanac_loop_role_config \"converge\" \"$role\" \"\" \"$(almanac_provider_default)\" \"\" \"\"\n}\n\nalmanac_converge_role_field() {\n  local role=\"$1\"\n  local field=\"$2\"\n\n  almanac_converge_role \"$role\" | almanac_loop_role_tsv_field \"$field\"\n}\n\nalmanac_converge_ensure_prompt_template() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local plan_dir prompt_file\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  prompt_file=\"$plan_dir/prompt.md\"\n  [ -f \"$prompt_file\" ] && return 0\n\n  cat > \"$prompt_file\" <<'EOF'\n# Converge Worker\n\nYou are one worker round in a generic convergence loop.\n\nRead current goal, follow one-shot steer directive if present, run exact exec\ncommand, then leave clear evidence in git history and agent-reports.log.\n\nDo not edit the goal unless explicitly asked by the exec command. Do not commit\n.almanac or converge state files under docs/plans/converge/.\nEOF\n}\n\nalmanac_converge_worker_prompt() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local exec_cmd=\"$3\"\n  local round=\"$4\"\n  local slug plan_dir rel_plan steer_file\n\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  rel_plan=\"${plan_dir#\"$root\"/}\"\n  steer_file=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n\n  almanac_converge_ensure_prompt_template \"$root\" \"$goal\"\n\n  cat \"$plan_dir/prompt.md\"\n  cat <<EOF\n\nCONVERGE_TICK=$round\nCONVERGE_SLUG=$slug\nCONVERGE_PLAN_DIR=$rel_plan\nCONVERGE_REPORT_LOG=$rel_plan/agent-reports.log\n\nCommit user-visible worktree changes, excluding .almanac and $rel_plan, with:\nCONVERGE($slug): <one-line summary>\n\nAppend one structured self-report to $rel_plan/agent-reports.log. Use this exact\nheader shape and these exact section labels:\n\n===== tick=<N> ts=<ISO> =====\nsummary:\nconcerns:\nnext:\n\nFor this round, N is $round.\n\n===== GOAL.md =====\nEOF\n  cat \"$plan_dir/goal.md\"\n  cat <<EOF\n===== END GOAL.md =====\n\n===== EXEC COMMAND =====\n$exec_cmd\n===== END EXEC COMMAND =====\nEOF\n\n  if [ -f \"$steer_file\" ]; then\n    cat <<'EOF'\n\n===== STEER =====\nEOF\n    cat \"$steer_file\"\n    cat <<'EOF'\n===== END STEER =====\nEOF\n    rm -f \"$steer_file\"\n  fi\n}\n\nalmanac_converge_report_log_has_structured_block() {\n  local file=\"$1\"\n\n  [ -f \"$file\" ] || return 1\n  awk '\n    /^===== tick=[0-9][0-9]* ts=.* =====$/ {\n      seen = 1\n      summary = 0\n      concerns = 0\n      next_seen = 0\n      next\n    }\n    seen && /^summary:$/ { summary = 1; next }\n    seen && /^concerns:$/ { concerns = 1; next }\n    seen && /^next:$/ { next_seen = 1; ok = summary && concerns && next_seen; next }\n    END { exit ok ? 0 : 1 }\n  ' \"$file\"\n}\n\nalmanac_converge_trim() {\n  printf '%s' \"$1\" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'\n}\n\nalmanac_converge_overseer_prompt() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local round=\"$3\"\n  local slug plan_dir rel_plan reports_file reports commits\n\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  rel_plan=\"${plan_dir#\"$root\"/}\"\n  reports_file=\"$plan_dir/agent-reports.log\"\n\n  if [ -f \"$reports_file\" ]; then\n    reports=\"$(tail -c 8192 \"$reports_file\")\"\n  else\n    reports=\"(no agent reports yet)\"\n  fi\n\n  commits=\"$(git -C \"$root\" log --fixed-strings --grep=\"CONVERGE($slug):\" -n 10 \\\n    --format='%H%n%ad%n%B%n---' --date=short 2>/dev/null || true)\"\n  [ -n \"$commits\" ] || commits=\"No CONVERGE commits yet\"\n\n  cat <<EOF\nYou are the overseer for converge($slug), a synchronous convergence loop.\n\nCONVERGE_TICK=$round\nCONVERGE_SLUG=$slug\nCONVERGE_PLAN_DIR=$rel_plan\n\nJudge whether the current goal is satisfied, whether the next worker needs a\none-shot steering directive, or whether the loop should stop.\n\n===== GOAL.md =====\nEOF\n  cat \"$plan_dir/goal.md\"\n  cat <<EOF\n===== END GOAL.md =====\n\n===== RECENT AGENT SELF-REPORTS (last ~8KB) =====\n$reports\n===== END RECENT AGENT SELF-REPORTS =====\n\n===== RECENT CONVERGE COMMITS (last 10) =====\n$commits\n===== END RECENT CONVERGE COMMITS =====\n\nOutput these four fields in order, exactly this raw format, no preamble, no\nmarkdown decoration, no code fences, no bold, no headings:\n\nVERDICT: <CONVERGED|CONTINUE|STEER|STOP>\nREASON: <one paragraph>\nSTEER: <one paragraph, or 'none'>\nGOAL_UPDATE: <new goal.md content, or 'unchanged'>\n\nYou MUST emit all four KEY: lines even when a value is \"none\" or \"unchanged\"\n— a missing line tells the parser you did not respond, not that nothing was\nneeded. Do NOT prefix the keys with **bold**, ### headings, - bullet points,\nor > quotes; the keys live at column 0 with the literal colon.\n\nBe conservative. Malformed output is treated as CONTINUE with no steering and\nno goal update. GOAL_UPDATE may span multiple lines because it is the final\nfield; the parser captures everything from the GOAL_UPDATE: marker to EOF.\nEOF\n}\n\nalmanac_converge_overseer_parse() {\n  local input=\"${1:-}\"\n  local content line key_line current_key=\"\"\n  local raw_verdict=\"\" raw_reason=\"\" raw_steer=\"\" raw_goal=\"\"\n  local found_verdict=0 found_reason=0 found_steer=0 found_goal=0\n\n  if [ -f \"$input\" ]; then\n    content=\"$(cat \"$input\")\"\n  else\n    content=\"$input\"\n  fi\n\n  ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n  ALMANAC_CONVERGE_REASON=\"\"\n  ALMANAC_CONVERGE_STEER=\"none\"\n  ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n\n  # State-machine line walker. Each KEY: prefix switches the current field;\n  # subsequent non-key lines append to whatever field is currently open.\n  #\n  # Pre-leniency: parser only matched the literal \"KEY:\" prefix. LLMs that\n  # added markdown bold (`**VERDICT:**`), heading hashes (`### VERDICT:`),\n  # or list-bullet markers (`- VERDICT:`) silently failed the case match,\n  # found_X stayed 0, and the guard at the bottom returned with all defaults\n  # — producing the canonical \"VERDICT=CONTINUE, REASON='', STEER=none,\n  # GOAL_UPDATE=unchanged\" mirage seen across every overseer tick of three\n  # consecutive converge runs.\n  #\n  # Now: strip a small set of decorative prefixes (markdown bold, leading\n  # `#`/`-`/`*`/`>` characters + space) from the start of each line BEFORE\n  # the case match, and trim trailing `**` for the bold-close variant\n  # (`**VERDICT:**`). This is purposely a tight whitelist — we don't want\n  # to start accepting `; VERDICT:` or `// VERDICT:` and then debug new\n  # ambiguities; just the markdown shapes models actually emit.\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    # Normalize a small set of decorative prefixes that wrap KEY: markers.\n    # The targeted shapes (in order, all anchored to start of line):\n    #   `**VERDICT:** value`   markdown bold + colon-close\n    #   `**VERDICT:**`         bold-only, value on next line\n    #   `### VERDICT: value`   markdown heading (1-6 hashes)\n    #   `- VERDICT: value`     list bullet (`-` or `*`)\n    #   `> VERDICT: value`     quote marker (rare but seen)\n    # Each strips ONLY the surrounding decoration, leaves the KEY: literal\n    # alone so the case match below works unchanged. Continuation lines\n    # (paragraph body) bypass these substitutions when they don't start\n    # with a recognized decoration — values keep their internal markdown\n    # (e.g. a REASON paragraph with `**bold**` inline emphasis stays\n    # intact).\n    key_line=\"$(printf '%s' \"$line\" | sed -E '\n      s/^[[:space:]]+//\n      s/^\\*\\*([A-Z_]+):\\*\\*[[:space:]]*/\\1: /\n      s/^\\*\\*([A-Z_]+):\\*\\*[[:space:]]*$/\\1:/\n      s/^#+[[:space:]]+([A-Z_]+:)/\\1/\n      s/^[-*][[:space:]]+([A-Z_]+:)/\\1/\n      s/^>[[:space:]]*([A-Z_]+:)/\\1/\n    ')\"\n    case \"$key_line\" in\n      VERDICT:*)\n        current_key=\"VERDICT\"; found_verdict=1\n        raw_verdict=\"${key_line#VERDICT:}\"\n        case \"$raw_verdict\" in \" \"*) raw_verdict=\"${raw_verdict# }\" ;; esac\n        ;;\n      REASON:*)\n        current_key=\"REASON\"; found_reason=1\n        raw_reason=\"${key_line#REASON:}\"\n        case \"$raw_reason\" in \" \"*) raw_reason=\"${raw_reason# }\" ;; esac\n        ;;\n      STEER:*)\n        current_key=\"STEER\"; found_steer=1\n        raw_steer=\"${key_line#STEER:}\"\n        case \"$raw_steer\" in \" \"*) raw_steer=\"${raw_steer# }\" ;; esac\n        ;;\n      GOAL_UPDATE:*)\n        current_key=\"GOAL_UPDATE\"; found_goal=1\n        raw_goal=\"${key_line#GOAL_UPDATE:}\"\n        case \"$raw_goal\" in \" \"*) raw_goal=\"${raw_goal# }\" ;; esac\n        ;;\n      *)\n        # Continuation line — append to whichever field is currently open.\n        # Lines before the first KEY: marker (preamble noise) have current_key\n        # empty and are dropped, matching the prompt's \"no preamble\" contract.\n        # The original line (not the leading-whitespace-stripped key_line) is\n        # preserved so multi-line paragraphs keep their indentation if any.\n        case \"$current_key\" in\n          VERDICT)     raw_verdict=\"${raw_verdict}\"$'\\n'\"${line}\" ;;\n          REASON)      raw_reason=\"${raw_reason}\"$'\\n'\"${line}\" ;;\n          STEER)       raw_steer=\"${raw_steer}\"$'\\n'\"${line}\" ;;\n          GOAL_UPDATE) raw_goal=\"${raw_goal}\"$'\\n'\"${line}\" ;;\n        esac\n        ;;\n    esac\n  done <<< \"$content\"\n\n  # Partial-output policy: capture every field we DID find, default-fill the\n  # rest. Pre-fix the parser bailed completely on any missing field —\n  # silently returning all-defaults — which masked the LLM's actual\n  # response. Now: VERDICT is required (a missing verdict can't be safely\n  # defaulted to CONTINUE — that's confusing; bail), but REASON / STEER /\n  # GOAL_UPDATE missing just keep their initial defaults (\"\", \"none\",\n  # \"unchanged\") and we proceed with the verdict we have. The bare verdict\n  # case (LLM emits \"VERDICT: CONTINUE\" followed by a paragraph instead of\n  # the other three keys) now produces a useful tick: the verdict is\n  # honored, the REASON section in overseer.log shows empty (operator can\n  # tighten the prompt), STEER stays none, goal stays unchanged.\n  if [ \"$found_verdict\" -ne 1 ]; then\n    # No usable verdict at all — surface this so the operator sees the\n    # parse failure in the overseer log instead of a silent all-defaults\n    # fallback. Caller still gets the conservative CONTINUE default but\n    # the parse-failure marker stamps the cause.\n    ALMANAC_CONVERGE_PARSE_NOTE=\"no VERDICT marker found\"\n    return 0\n  fi\n  ALMANAC_CONVERGE_PARSE_NOTE=\"\"\n\n  # Note in the parse marker which optional fields the LLM skipped — so the\n  # operator can see whether to tighten the prompt for that model.\n  local _missing=()\n  [ \"$found_reason\" -eq 1 ] || _missing+=(REASON)\n  [ \"$found_steer\" -eq 1 ]  || _missing+=(STEER)\n  [ \"$found_goal\" -eq 1 ]   || _missing+=(GOAL_UPDATE)\n  if [ \"${#_missing[@]}\" -gt 0 ]; then\n    ALMANAC_CONVERGE_PARSE_NOTE=\"missing fields: ${_missing[*]}\"\n  fi\n\n  # VERDICT is always a single token. A chatty LLM may put the token on its own\n  # line and then ramble before REASON; the state-machine above will have\n  # accumulated those ramble lines into raw_verdict. Reduce to the first\n  # non-empty line so the case-match below still recognises the token.\n  raw_verdict=\"$(printf '%s\\n' \"$raw_verdict\" | awk 'NF{print; exit}')\"\n  raw_verdict=\"$(almanac_converge_trim \"$raw_verdict\")\"\n  case \"$raw_verdict\" in\n    CONVERGED|CONTINUE|STEER|STOP) ALMANAC_CONVERGE_VERDICT=\"$raw_verdict\" ;;\n    *)\n      ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n      ALMANAC_CONVERGE_STEER=\"none\"\n      ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n      return 0\n      ;;\n  esac\n\n  ALMANAC_CONVERGE_REASON=\"$(almanac_converge_trim \"$raw_reason\")\"\n\n  raw_steer=\"$(almanac_converge_trim \"$raw_steer\")\"\n  if [ -n \"$raw_steer\" ] && ! printf '%s\\n' \"$raw_steer\" | grep -qiE '^none[[:space:]]*$'; then\n    ALMANAC_CONVERGE_STEER=\"$raw_steer\"\n  fi\n\n  if [ \"$found_goal\" -eq 1 ]; then\n    local goal_check\n    goal_check=\"$(almanac_converge_trim \"$raw_goal\")\"\n    if [ -n \"$goal_check\" ] && ! printf '%s\\n' \"$goal_check\" | grep -qiE '^unchanged[[:space:]]*$'; then\n      ALMANAC_CONVERGE_GOAL_UPDATE=\"$raw_goal\"\n    fi\n  fi\n}\n\n# Write the convergence.md final record.\n#\n# Args:\n#   root           — repo root\n#   goal           — initial goal text (used to derive the plan dir)\n#   outcome        — authoritative loop result, one of:\n#                      CONVERGED       overseer said so → goal met\n#                      NON_CONVERGED   round budget hit before overseer converged\n#                      STOPPED         stop signal (overseer STOP verdict OR human\n#                                      `.converge-stop`)\n#                      FAILED          exec error with CONVERGE_FAIL_ON_EXEC_ERROR=1\n#                      ABORTED         EXIT trap fired (mid-loop _die, signal, etc.)\n#   last_verdict   — the overseer's last raw verdict, informational only\n#                    (e.g. \"CONTINUE\" is meaningless as a FINAL answer — it just\n#                    means the overseer was asked one more time and wanted more\n#                    rounds). Pass \"n/a\" if no overseer ran (e.g. --no-oversee).\n#   tick           — round number reached\n#   budget         — round budget configured for the run\n#   started_epoch  — UNIX timestamp the run started (or empty for \"unknown\")\n#   reason         — one-line termination reason (\"round budget exhausted (10/10)\",\n#                    \"exec exit=2 round=4\", \"overseer verdict: CONVERGED\").\n#\n# Pre-fix the writer took only a single `verdict` argument and wrote it as\n# \"Final verdict\", which conflated three different things: the overseer's last\n# raw say, the loop's actual outcome, and whether convergence was reached.\n# A run that hit the round budget without convergence wrote \"Final verdict:\n# CONTINUE\" — readable as a soft answer, actually meaning \"the overseer wanted\n# more rounds and we ran out\". The split here makes the misread structurally\n# impossible: outcome is the source of truth, last_verdict is metadata.\nalmanac_converge_write_convergence() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local outcome=\"$3\"\n  local last_verdict=\"$4\"\n  local tick=\"$5\"\n  local budget=\"$6\"\n  local started_epoch=\"${7:-}\"\n  local reason=\"${8:-}\"\n  local plan_dir now_epoch elapsed status_summary\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  now_epoch=\"$(date +%s)\"\n  elapsed=\"\"\n  case \"$started_epoch\" in\n    ''|*[!0-9]*) ;;\n    *) elapsed=\"$((now_epoch - started_epoch))s\" ;;\n  esac\n\n  # Human-readable headline for the Outcome section — one line that future\n  # operators (and agents reading convergence.md as evidence) can act on\n  # without parsing the rest.\n  case \"$outcome\" in\n    CONVERGED)\n      status_summary=\"CONVERGED — overseer reached convergence at round $tick of $budget.\"\n      ;;\n    NON_CONVERGED)\n      status_summary=\"NON_CONVERGED — round budget exhausted ($tick/$budget) without overseer reaching CONVERGED.\"\n      ;;\n    STOPPED)\n      status_summary=\"STOPPED — halted by stop signal at round $tick of $budget.\"\n      ;;\n    FAILED)\n      status_summary=\"FAILED — exec error at round $tick of $budget.\"\n      ;;\n    ABORTED)\n      status_summary=\"ABORTED — loop exited unexpectedly at round $tick of $budget (signal, mid-loop _die, etc.).\"\n      ;;\n    *)\n      status_summary=\"UNKNOWN ($outcome) — round $tick of $budget.\"\n      ;;\n  esac\n\n  {\n    printf '# Convergence\\n\\n'\n    printf '## Outcome\\n\\n%s\\n\\n' \"$status_summary\"\n    printf '## Last overseer verdict\\n\\n%s\\n\\n' \"${last_verdict:-n/a}\"\n    printf '## Tick count\\n\\n%s of %s\\n\\n' \"$tick\" \"$budget\"\n    printf '## Time elapsed\\n\\n%s\\n\\n' \"${elapsed:-unknown}\"\n    printf '## Final goal\\n\\n'\n    if [ -f \"$plan_dir/goal.md\" ]; then\n      cat \"$plan_dir/goal.md\"\n    fi\n    printf '\\n\\n## Termination reason\\n\\n%s\\n' \"${reason:-none}\"\n  } > \"$plan_dir/convergence.md\"\n}\n\nalmanac_converge_goal_summary() {\n  printf '%s' \"$1\" | tr '\\n' ' ' | cut -c 1-80\n}\n\nalmanac_converge_latest_run_id() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local rows id type target pid status_rel started status match=\"\"\n\n  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n    [ -n \"$id\" ] || continue\n    [ \"$type\" = \"converge\" ] || continue\n    [ \"$target\" = \"$slug\" ] || continue\n    match=\"$id\"\n  done <<< \"$rows\"\n\n  [ -n \"$match\" ] || return 1\n  printf '%s\\n' \"$match\"\n}\n\nalmanac_converge_worker_health() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status_file status\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || { printf '%s\\n' \"dead\"; return 0; }\n\n  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n  if [ \"$status\" = \"running\" ] && ! almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n    printf '%s\\n' \"alive\"\n  else\n    printf '%s\\n' \"dead\"\n  fi\n}\n\nalmanac_converge_last_verdict_line() {\n  local log_file=\"$1\"\n\n  [ -f \"$log_file\" ] || return 1\n  awk '\n    /^===== tick=/ { verdict = \"\"; reason = \"\" }\n    /^VERDICT: / { verdict = substr($0, 10) }\n    /^REASON: / { reason = substr($0, 9) }\n    END {\n      if (verdict != \"\" || reason != \"\") {\n        printf \"%s\\t%s\\n\", verdict, reason\n      }\n    }\n  ' \"$log_file\"\n}\n\nalmanac_converge_last_report_header() {\n  local reports_file=\"$1\"\n\n  [ -f \"$reports_file\" ] || return 1\n  grep -E '^===== tick=[0-9][0-9]* ts=.* =====$' \"$reports_file\" 2>/dev/null | tail -n 1\n}\n\nalmanac_converge_goal_mutation_count() {\n  local history_file=\"$1\"\n\n  [ -f \"$history_file\" ] || { printf '%s\\n' \"0\"; return 0; }\n  awk '/^===== tick=[0-9][0-9]* ts=.* overseer=/ { c++ } END { print c + 0 }' \"$history_file\"\n}\n\nalmanac_converge_dashboard_frame() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local plan_dir goal_file reports_file history_file log_file\n  local run_id=\"\" status_file round=\"\" rounds=\"\" health=\"dead\"\n  local verdict=\"none\" reason=\"none\" verdict_line report_header goal_text goal_summary mutations\n  local tab=$'\\t'\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  [ -d \"$plan_dir\" ] || return 1\n\n  goal_file=\"$plan_dir/goal.md\"\n  reports_file=\"$plan_dir/agent-reports.log\"\n  history_file=\"$plan_dir/goal.history.log\"\n  log_file=\"$plan_dir/overseer.log\"\n\n  if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n    status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n    round=\"$(almanac_loop_status_field \"$status_file\" \"round\" 2>/dev/null || true)\"\n    rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" 2>/dev/null || true)\"\n    health=\"$(almanac_converge_worker_health \"$root\" \"$run_id\")\"\n  fi\n  [ -n \"$round\" ] || round=\"0\"\n  [ -n \"$rounds\" ] || rounds=\"?\"\n\n  if verdict_line=\"$(almanac_converge_last_verdict_line \"$log_file\" 2>/dev/null)\"; then\n    verdict=\"${verdict_line%%$tab*}\"\n    reason=\"${verdict_line#*$tab}\"\n    [ \"$reason\" != \"$verdict_line\" ] || reason=\"none\"\n    [ -n \"$verdict\" ] || verdict=\"none\"\n    [ -n \"$reason\" ] || reason=\"none\"\n  fi\n\n  report_header=\"$(almanac_converge_last_report_header \"$reports_file\" 2>/dev/null || true)\"\n  [ -n \"$report_header\" ] || report_header=\"none\"\n\n  goal_text=\"\"\n  [ -f \"$goal_file\" ] && goal_text=\"$(cat \"$goal_file\")\"\n  goal_summary=\"$(almanac_converge_goal_summary \"$goal_text\")\"\n  [ -n \"$goal_summary\" ] || goal_summary=\"none\"\n  mutations=\"$(almanac_converge_goal_mutation_count \"$history_file\")\"\n\n  printf 'converge %s\\n' \"$slug\"\n  printf 'current round: %s/%s\\n' \"$round\" \"$rounds\"\n  printf 'last verdict: %s\\n' \"$verdict\"\n  printf 'reason: %s\\n' \"$reason\"\n  printf 'last report: %s\\n' \"$report_header\"\n  printf 'goal: %s\\n' \"$goal_summary\"\n  printf 'goal mutations: %s\\n' \"$mutations\"\n  printf 'worker health: %s\\n' \"$health\"\n}\n\nalmanac_converge_status() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local frame\n\n  frame=\"$(almanac_converge_dashboard_frame \"$root\" \"$slug\")\" || return 1\n  printf '%s\\n' \"$frame\" | almanac_loop_ui_render\n}\n\nalmanac_converge_watch() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local mode=\"${3:-}\"\n  local interval=\"${CONVERGE_WATCH_INTERVAL:-${ALMANAC_HUB_WATCH_INTERVAL:-2}}\"\n  local run_id status_file status\n\n  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n    almanac_converge_status \"$root\" \"$slug\"\n    return\n  fi\n\n  while :; do\n    almanac_loop_ui_clear\n    almanac_converge_status \"$root\" \"$slug\"\n    if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n      status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n      status=\"$(almanac_loop_status_field \"$status_file\" \"status\" 2>/dev/null || true)\"\n      case \"$status\" in\n        done|failed|aborted) break ;;\n      esac\n    fi\n    sleep \"$interval\"\n  done\n}\n\nalmanac_converge_stop() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local plan_dir root_stop plan_stop\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  [ -d \"$plan_dir\" ] || return 1\n  root_stop=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n  plan_stop=\"$(almanac_loop_run_control_file converge \"$plan_dir\" stop)\"\n  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$root_stop\"\n  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$plan_stop\"\n}\n\nalmanac_converge_apply_goal_update() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local round=\"$3\"\n  local provider=\"$4\"\n  local reason=\"$5\"\n  local new_goal=\"$6\"\n  local plan_dir goal_file history_file log_file ts old_goal old_file new_file diff_output diff_status summary\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  goal_file=\"$plan_dir/goal.md\"\n  history_file=\"$plan_dir/goal.history.log\"\n  log_file=\"$plan_dir/overseer.log\"\n  ts=\"$(almanac_loop_now_utc)\"\n  old_goal=\"\"\n  [ -f \"$goal_file\" ] && old_goal=\"$(cat \"$goal_file\")\"\n\n  old_file=\"$plan_dir/.goal.old.$$\"\n  new_file=\"$plan_dir/.goal.new.$$\"\n  printf '%s\\n' \"$old_goal\" > \"$old_file\"\n  printf '%s\\n' \"$new_goal\" > \"$new_file\"\n\n  diff_output=\"\"\n  diff_status=127\n  if command -v diff >/dev/null 2>&1; then\n    if diff_output=\"$(diff -u \"$old_file\" \"$new_file\" 2>/dev/null)\"; then\n      diff_status=0\n    else\n      diff_status=$?\n    fi\n  fi\n\n  {\n    printf '===== tick=%s ts=%s overseer=%s =====\\n' \"$round\" \"$ts\" \"$provider\"\n    printf 'REASON: %s\\n' \"$reason\"\n    if [ \"$diff_status\" -le 1 ]; then\n      printf -- '--- DIFF ---\\n'\n      printf '%s\\n' \"$diff_output\"\n    else\n      printf -- '--- AFTER ---\\n'\n      printf '%s\\n' \"$new_goal\"\n    fi\n  } >> \"$history_file\"\n\n  printf '%s\\n' \"$new_goal\" > \"$goal_file\"\n  rm -f \"$old_file\" \"$new_file\"\n\n  summary=\"$(almanac_converge_goal_summary \"$new_goal\")\"\n  printf '[tick=%s] goal updated: %s\\n' \"$round\" \"$summary\" >> \"$log_file\"\n}\n\nalmanac_converge_run_finalize() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status=\"$3\"\n  local reason=\"${4:-}\"\n\n  trap - EXIT INT TERM\n  [ -n \"$run_id\" ] || return 0\n  almanac_loop_mark_run_status \"$root\" \"$run_id\" \"$status\" \"\" \"$reason\" >/dev/null 2>&1 || true\n}\n\nalmanac_converge_git_user_status() {\n  local root=\"$1\"\n  local plan_dir=\"$2\"\n  local rel_plan\n\n  git -C \"$root\" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1\n  rel_plan=\"${plan_dir#\"$root\"/}\"\n\n  if [ \"$rel_plan\" = \"$plan_dir\" ]; then\n    git -C \"$root\" status --porcelain -- . ':!.almanac'\n  else\n    git -C \"$root\" status --porcelain -- . ':!.almanac' \":!$rel_plan\"\n  fi\n}\n\nalmanac_converge_run_worker() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local exec_cmd=\"$3\"\n  local round=\"$4\"\n  local provider model effort prompt_file result_file events_file plan_dir slug rc\n\n  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-prompt.XXXXXX\")\"\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-result.XXXXXX\")\"\n  # Persistent per-round session log under the plan dir (mirrors ralph's\n  # docs/plans/<name>/ralph-codex-iteration-N.log). The full raw event stream\n  # tees here while the filtered agent-message text streams live to the\n  # terminal — operator sees progress, durable log is kept for forensics.\n  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n\n  almanac_converge_worker_prompt \"$root\" \"$goal\" \"$exec_cmd\" \"$round\" > \"$prompt_file\"\n\n  _info \"Converge round $round — exec-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n\n  # danger-full-access sandbox: converge runs are autonomous-by-design.\n  # `claude --print` has no human to answer a permission prompt, so anything\n  # less than full access dies on every un-allowlisted Bash call (\"This\n  # command requires approval\"). For codex this drops the sandbox; for claude\n  # it maps to --permission-mode bypassPermissions (per the provider adapter).\n  rc=0\n  almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr || rc=$?\n\n  rm -f \"$prompt_file\" \"$result_file\"\n  return \"$rc\"\n}\n\n# Prompt-mode round: the user's --prompt text IS the agent invocation. No worker\n# template wrapper — the agent receives the prompt verbatim, prefixed only with\n# a one-shot .converge-steer directive if one is queued. This is the dominant\n# mode for \"run skill X in a convergence loop\" workflows; the loop driver\n# handles the bookkeeping (auto-commit + agent-reports.log entry) after the\n# agent exits, instead of asking the agent to know about CONVERGE conventions.\n#\n# Returns the agent's exit code; commit and report writes are best-effort and\n# never alter the return.\n# List every currently-dirty path in $root, one per line, sorted+deduped.\n# Output is the union of:\n#   - tracked-modified paths (`git diff --name-only HEAD`)\n#   - untracked-not-ignored paths (`git ls-files --others --exclude-standard`)\n# Used by the prompt-mode auto-commit to distinguish PRE-EXISTING dirty work\n# (untouched by the agent) from AGENT-TOUCHED paths (commit candidates). Empty\n# string on git failure or non-repo. Pure read-only — safe to call multiple\n# times per round.\nalmanac_converge_dirty_paths() {\n  local root=\"$1\"\n  ( cd \"$root\" \\\n      && { git diff --name-only HEAD 2>/dev/null; \\\n           git ls-files --others --exclude-standard 2>/dev/null; } \\\n      | sort -u\n  )\n}\n\n# Auto-commit ONLY the paths the agent newly touched this round, computed as\n# (dirty-after) - (dirty-before). Pre-existing dirty paths are left alone so a\n# concurrent unrelated edit never gets swept into a CONVERGE commit (the bug\n# that caused commit 4526a58 to misattribute the developer's in-flight edits\n# to the agent). Files that were pre-existing dirty AND also touched by the\n# agent stay dirty — conservative; the agent's change in that file isn't\n# committed by this round, but no false attribution happens. Best-effort:\n# commit failure logs a warn and never alters the caller's return code.\n#\n# Args: ROOT SLUG ROUND PRE_DIRTY (newline-separated pre-existing dirty paths)\nalmanac_converge_commit_agent_paths() {\n  local root=\"$1\" slug=\"$2\" round=\"$3\" pre_dirty=\"$4\"\n  local post_dirty agent_paths\n\n  post_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n  # comm needs sorted inputs; both producers (almanac_converge_dirty_paths +\n  # the snapshot taken before the agent ran) emit sorted-unique.\n  agent_paths=\"$(comm -23 <(printf '%s\\n' \"$post_dirty\") <(printf '%s\\n' \"$pre_dirty\") | sed '/^$/d')\"\n\n  if [ -z \"$agent_paths\" ]; then\n    # Either the agent didn't change anything OR every change was on a path\n    # that was already dirty (so the change stays uncommitted on purpose).\n    return 0\n  fi\n\n  # Stage each agent-touched path individually (handles deletions, new files,\n  # and modifications — `git add` accepts paths to files that no longer exist\n  # by recording the deletion).\n  local path failed=0\n  while IFS= read -r path; do\n    [ -n \"$path\" ] || continue\n    (cd \"$root\" && git add -- \"$path\" >/dev/null 2>&1) || failed=1\n  done <<< \"$agent_paths\"\n\n  if [ \"$failed\" -eq 1 ]; then\n    _warn \"Converge round $round: staging one or more agent-touched paths failed (changes left in worktree)\"\n    return 0\n  fi\n\n  if ! (cd \"$root\" \\\n          && git -c user.email=converge@almanac -c user.name=converge \\\n                 commit -m \"CONVERGE($slug): round $round\" --no-verify >/dev/null 2>&1); then\n    _warn \"Converge round $round: auto-commit failed (changes left in worktree)\"\n  fi\n}\n\nalmanac_converge_run_worker_prompt() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local prompt=\"$3\"\n  local round=\"$4\"\n  local provider model effort prompt_file result_file events_file rc\n  local slug plan_dir log_file steer_path ts result_summary\n\n  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  log_file=\"$plan_dir/agent-reports.log\"\n  steer_path=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-prompt.XXXXXX\")\"\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-result.XXXXXX\")\"\n  # Persistent per-round session log under the plan dir (same shape as\n  # exec-mode + ralph's per-iteration logs). Streams live to terminal so the\n  # operator sees the agent working; tees the raw stream here for forensics.\n  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n\n  # Steer (one-shot): emitted by the overseer in the prior round, consumed and\n  # removed here so the next overseer tick can re-emit if the issue persists.\n  # Steer prefix comes BEFORE the user prompt so a slash command sees the\n  # directive as context before its own work.\n  {\n    if [ -f \"$steer_path\" ]; then\n      printf '# Steer directive (from previous overseer tick):\\n'\n      cat \"$steer_path\"\n      printf '\\n\\n'\n      rm -f \"$steer_path\"\n    fi\n    printf '%s\\n' \"$prompt\"\n  } > \"$prompt_file\"\n\n  _info \"Converge round $round — prompt-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n\n  # Snapshot the dirty worktree BEFORE the agent runs so the auto-commit below\n  # can stage only the paths the agent newly touches — not whatever unrelated\n  # work the operator had in-flight. (Without this snapshot, an earlier `git\n  # add -A` swept up the developer's uncommitted edits and committed them\n  # under the agent's name — bug observed in commit 4526a58.)\n  local pre_dirty\n  pre_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n\n  # danger-full-access: same rationale as exec-mode worker — converge agents\n  # need to run arbitrary shell (tests, git status, lint) the prompt asks for.\n  rc=0\n  (cd \"$root\" && almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr) || rc=$?\n\n  # Auto-commit only the agent-touched paths. A smart prompt may have committed\n  # itself (worktree clean, nothing to do); a slash command like\n  # /almanac:codebase-improve typically doesn't commit, so the driver does it.\n  # Best-effort: a failed commit logs a warn but never alters the return code —\n  # the agent's work itself succeeded or failed, the commit is bookkeeping.\n  almanac_converge_commit_agent_paths \"$root\" \"$slug\" \"$round\" \"$pre_dirty\"\n\n  # Auto-write a minimal self-report. Format mirrors slice-03's worker block\n  # (===== tick=N ts=ISO mode=prompt exit=N =====) so the overseer's parser\n  # treats it the same. result_summary is the first 500 bytes of the agent's\n  # final message — enough for the overseer to see \"what the agent said it\n  # did\" without dragging the full transcript through the prompt budget.\n  ts=\"$(almanac_loop_now_utc)\"\n  result_summary=\"(no agent output)\"\n  if [ -s \"$result_file\" ]; then\n    result_summary=\"$(head -c 500 \"$result_file\")\"\n  fi\n  {\n    printf '\\n===== tick=%s ts=%s mode=prompt exit=%s =====\\n' \"$round\" \"$ts\" \"$rc\"\n    printf 'summary:\\n'\n    printf '%s\\n' \"$result_summary\"\n    printf 'concerns:\\n(none captured — prompt mode does not enforce structured self-report)\\n'\n    printf 'next:\\n(driven by overseer / next-round prompt)\\n'\n  } >> \"$log_file\"\n\n  # events_file is the persistent per-round session log under the plan dir —\n  # NOT removed here. prompt/result are still scratch.\n  rm -f \"$prompt_file\" \"$result_file\"\n  return \"$rc\"\n}\n\nalmanac_converge_run_overseer() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local round=\"$3\"\n  local provider model effort prompt_file result_file events_file result rc plan_dir log_file ts\n\n  provider=\"$(almanac_converge_role_field \"overseer\" \"provider\")\"\n  model=\"$(almanac_converge_role_field \"overseer\" \"model\")\"\n  effort=\"$(almanac_converge_role_field \"overseer\" \"effort\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  log_file=\"$plan_dir/overseer.log\"\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-prompt.XXXXXX\")\"\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-result.XXXXXX\")\"\n  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-events.XXXXXX\")\"\n\n  almanac_converge_overseer_prompt \"$root\" \"$goal\" \"$round\" > \"$prompt_file\"\n\n  rc=0\n  (cd \"$root\" && almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"read-only\" \\\n    \"$prompt_file\" \"$result_file\" \"$events_file\") >/dev/null || rc=$?\n\n  result=\"\"\n  [ -s \"$result_file\" ] && result=\"$(cat \"$result_file\")\"\n  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n\n  [ \"$rc\" -eq 0 ] || _warn \"Converge overseer tick $round exited $rc; continuing\"\n  almanac_converge_overseer_parse \"$result\"\n\n  # Log the RAW LLM response alongside the parsed verdict. Pre-fix the\n  # overseer log showed only the parsed fields, so a parse failure (LLM\n  # using markdown bold, skipping fields, putting the value on the next\n  # line) looked identical to \"the LLM gave us nothing useful\". The raw\n  # block is fenced so it's visually distinct from the structured parser\n  # output and easy to grep for (\"===== RAW =====\") when debugging.\n  ts=\"$(almanac_loop_now_utc)\"\n  {\n    printf '\\n===== tick=%s ts=%s overseer=%s exit=%s =====\\n' \"$round\" \"$ts\" \"$provider\" \"$rc\"\n    printf 'VERDICT: %s\\n' \"$ALMANAC_CONVERGE_VERDICT\"\n    printf 'REASON: %s\\n' \"$ALMANAC_CONVERGE_REASON\"\n    printf 'STEER: %s\\n' \"$ALMANAC_CONVERGE_STEER\"\n    printf 'GOAL_UPDATE: %s\\n' \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n    if [ -n \"${ALMANAC_CONVERGE_PARSE_NOTE:-}\" ]; then\n      printf 'PARSE_NOTE: %s\\n' \"$ALMANAC_CONVERGE_PARSE_NOTE\"\n    fi\n    printf '\\n===== RAW LLM RESPONSE =====\\n'\n    if [ -n \"$result\" ]; then\n      printf '%s\\n' \"$result\"\n    else\n      printf '(empty — provider exited %s with no final message)\\n' \"$rc\"\n    fi\n    printf '===== END RAW =====\\n'\n  } >> \"$log_file\"\n\n  if [ \"$ALMANAC_CONVERGE_GOAL_UPDATE\" != \"unchanged\" ]; then\n    almanac_converge_apply_goal_update \"$root\" \"$goal\" \"$round\" \"$provider\" \\\n      \"$ALMANAC_CONVERGE_REASON\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n  fi\n\n  case \"$ALMANAC_CONVERGE_VERDICT\" in\n    CONVERGED|STOP)\n      : > \"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n      ;;\n    STEER)\n      if [ \"$ALMANAC_CONVERGE_STEER\" != \"none\" ]; then\n        printf '%s\\n' \"$ALMANAC_CONVERGE_STEER\" > \"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n      fi\n      ;;\n    CONTINUE) ;;\n  esac\n}\n\nalmanac_converge_run() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local exec_cmd=\"$3\"\n  local rounds=\"${4:-${CONVERGE_ROUND_BUDGET:-10}}\"\n  local no_oversee=\"${5:-0}\"\n  local oversee_every=\"${6:-1}\"\n  local prompt=\"${7:-}\"\n  local slug plan_dir run_id pid exec_rc round started_epoch action_mode\n  local final_status final_outcome final_verdict final_reason\n\n  # Mode dispatch: prompt-mode (agent invocation, dominant) vs exec-mode (shell\n  # command in a wrapping worker, escape hatch). cmd/converge.sh enforces the\n  # mutex; here we just pick a label for run-config + dispatch.\n  if [ -n \"$prompt\" ]; then\n    action_mode=\"prompt\"\n  else\n    action_mode=\"exec\"\n  fi\n\n  case \"$rounds\" in\n    ''|*[!0-9]*) _die \"--rounds must be a positive integer: $rounds\" ;;\n  esac\n  [ \"$rounds\" -ge 1 ] || _die \"--rounds must be at least 1: $rounds\"\n\n  case \"$oversee_every\" in\n    ''|*[!0-9]*) _die \"--oversee-every must be a positive integer: $oversee_every\" ;;\n  esac\n  [ \"$oversee_every\" -ge 1 ] || _die \"--oversee-every must be at least 1: $oversee_every\"\n\n  case \"$no_oversee\" in\n    1|true|yes|on) no_oversee=1 ;;\n    *) no_oversee=0 ;;\n  esac\n\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  pid=\"${BASHPID:-$$}\"\n  started_epoch=\"$(date +%s)\"\n  run_id=\"$(almanac_loop_register_run \"$root\" \"converge\" \"$slug\" \"$pid\")\" \\\n    || _die \"Could not register converge run\"\n\n  local _converge_run_finalize_cmd\n  printf -v _converge_run_finalize_cmd 'almanac_converge_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n  trap \"${_converge_run_finalize_cmd}; exit 130\" INT TERM\n  trap \"${_converge_run_finalize_cmd}\" EXIT\n\n  # Persist enough of the launch config that the hub's resume path can rebuild\n  # the same invocation from status.tsv alone — see almanac_loop_converge_status_to_opts.\n  # Without these the hub would resume with --goal blank / no action verb.\n  almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n    \"goal=$goal\" \\\n    \"prompt=$prompt\" \\\n    \"exec=$exec_cmd\" \\\n    \"rounds=$rounds\" \\\n    \"oversee=$([ \"$no_oversee\" -eq 1 ] && printf off || printf 'every-%s' \"$oversee_every\")\" \\\n    \"oversee_every=$oversee_every\" \\\n    >/dev/null 2>&1 || true\n\n  almanac_converge_scaffold \"$root\" \"$goal\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n\n  # Default state when the loop exits via the round budget. `final_verdict` is\n  # the overseer's LAST raw say (informational); `final_outcome` is the\n  # AUTHORITATIVE termination shape (used to label convergence.md). A run that\n  # hits the budget without an overseer-said CONVERGED is NON_CONVERGED — the\n  # loop ran out of attempts, not consensus. Pre-fix the convergence.md just\n  # echoed final_verdict, so a budget exhaustion looked like \"Final verdict:\n  # CONTINUE\" — misread by future agents (and humans) as a soft stop.\n  final_status=\"done\"\n  final_outcome=\"NON_CONVERGED\"\n  if [ \"$no_oversee\" -eq 1 ]; then\n    final_verdict=\"n/a\"\n    final_reason=\"overseer disabled; round budget ($rounds) exhausted\"\n  else\n    final_verdict=\"CONTINUE\"\n    final_reason=\"round budget ($rounds) exhausted; overseer's last verdict was CONTINUE\"\n  fi\n\n  local _converge_stop_file\n  _converge_stop_file=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n\n  round=0\n  while [ \"$round\" -lt \"$rounds\" ]; do\n    if [ -f \"$_converge_stop_file\" ]; then\n      final_status=\"aborted\"\n      final_outcome=\"STOPPED\"\n      final_verdict=\"STOP\"\n      final_reason=\"stop signal present before round $((round + 1))\"\n      break\n    fi\n\n    round=$((round + 1))\n    case \"$action_mode\" in\n      prompt)\n        if almanac_converge_run_worker_prompt \"$root\" \"$goal\" \"$prompt\" \"$round\"; then\n          exec_rc=0\n        else\n          exec_rc=$?\n        fi\n        ;;\n      *)\n        if (cd \"$root\" && almanac_converge_run_worker \"$root\" \"$goal\" \"$exec_cmd\" \"$round\"); then\n          exec_rc=0\n        else\n          exec_rc=$?\n        fi\n        ;;\n    esac\n\n    # In exec-mode the worker is authoritative for commits (slice 03 contract).\n    # In prompt-mode the driver already attempted the auto-commit inside the\n    # worker function and will have warned on failure, so the check is skipped\n    # to avoid a duplicate / misleading \"driver will not commit\" message.\n    if [ \"$action_mode\" = \"exec\" ] \\\n       && [ -n \"$(almanac_converge_git_user_status \"$root\" \"$plan_dir\" 2>/dev/null || true)\" ]; then\n      _warn \"Converge round $round: worker left uncommitted changes; driver will not commit\"\n    fi\n\n    if [ \"$exec_rc\" -ne 0 ]; then\n      if [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n        _warn \"Converge round $round exec exited $exec_rc; stopping\"\n      else\n        _warn \"Converge round $round exec exited $exec_rc; continuing\"\n      fi\n    fi\n\n    almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \"goal=$slug\" >/dev/null 2>&1 || true\n\n    if [ \"$exec_rc\" -ne 0 ] && [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n      almanac_converge_write_convergence \"$root\" \"$goal\" \\\n        \"FAILED\" \"${final_verdict:-n/a}\" \"$round\" \"$rounds\" \"$started_epoch\" \\\n        \"exec exit=$exec_rc round=$round\"\n      almanac_converge_run_finalize \"$root\" \"$run_id\" \"failed\" \"exec exit=$exec_rc round=$round\"\n      return \"$exec_rc\"\n    fi\n\n    if [ \"$no_oversee\" -eq 0 ] && [ $((round % oversee_every)) -eq 0 ]; then\n      almanac_converge_run_overseer \"$root\" \"$goal\" \"$round\"\n      final_verdict=\"$ALMANAC_CONVERGE_VERDICT\"\n      final_reason=\"$ALMANAC_CONVERGE_REASON\"\n      case \"$ALMANAC_CONVERGE_VERDICT\" in\n        CONVERGED)\n          final_status=\"done\"\n          final_outcome=\"CONVERGED\"\n          [ -n \"$final_reason\" ] || final_reason=\"overseer verdict: CONVERGED at round $round\"\n          break\n          ;;\n        STOP)\n          final_status=\"aborted\"\n          final_outcome=\"STOPPED\"\n          [ -n \"$final_reason\" ] || final_reason=\"overseer verdict: STOP at round $round\"\n          break\n          ;;\n      esac\n    fi\n  done\n\n  almanac_converge_write_convergence \"$root\" \"$goal\" \\\n    \"$final_outcome\" \"$final_verdict\" \"$round\" \"$rounds\" \"$started_epoch\" \"$final_reason\"\n  almanac_converge_run_finalize \"$root\" \"$run_id\" \"$final_status\"\n}\n","numLines":1144,"startLine":1,"totalLines":1144}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014QizNb7Fkntm5GZs6UBdXz","type":"tool_result","content":"<system-reminder>[Truncated: PARTIAL view — showing lines 1-1343 of 1978 total (31296 tokens, cap 25000). Call Read with offset=1344 limit=1343 for the next page, or Grep to find a specific section. Do NOT answer from this page alone if the answer may be further in the file.]</system-reminder>\n\n1\t#!/usr/bin/env bash\n2\t# harden-core.sh - Harden loop rubric bootstrap + reviewer helpers\n3\t\n4\t# loop-core.sh (the old shared-engine barrel) is deleted; harden-core sources the\n5\t# focused modules it actually uses, each directly and idempotently so it works\n6\t# both through bin/almanac and when a test sources this file directly. core.sh\n7\t# is sourced literally (it owns the helper); the other deps go through\n8\t# _almanac_source_sibling so the boilerplate stays minimal.\n9\tif ! declare -F _error >/dev/null 2>&1; then\n10\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n11\t  # shellcheck source=lib/core.sh\n12\t  source \"$__harden_core_dir/core.sh\"\n13\t  unset __harden_core_dir\n14\tfi\n15\t\n16\t# Explicit deps (each declared module is the contract surface this file consumes;\n17\t# transitive availability is not relied on).\n18\t_almanac_source_sibling agent.sh    almanac_loop_agent_capture   # agent run shapes (ratify/fixer)\n19\t_almanac_source_sibling run.sh      almanac_loop_register_run    # run registry + worker paths/health\n20\t_almanac_source_sibling worker.sh   almanac_loop_worker_start    # worker orchestration (reviewer/fixer fan-out)\n21\t_almanac_source_sibling ui.sh       almanac_loop_ui_render       # gum-or-plain dashboard seam\n22\t_almanac_source_sibling role.sh     almanac_loop_role_config     # per-role provider/model/effort resolution\n23\t_almanac_source_sibling feedback.sh almanac_loop_feedback_run    # objective fixer gate\n24\t\n25\t# --- Role config (per-role provider / model / effort) --------------------------\n26\t#\n27\t# Each harden role selects its own agent config:\n28\t#   conductor - judges/ratifies findings and declares convergence\n29\t#   reviewer  - one read-only reviewer per lens (lens -> provider map)\n30\t#   fixer     - the single sequential write-capable fixer\n31\t#\n32\t# Resolution layers, most specific first, via the shared loop resolver:\n33\t#   provider: HARDEN_<ROLE>[_<LENS>]_PROVIDER -> HARDEN_<ROLE>_PROVIDER\n34\t#             -> HARDEN_PROVIDER -> claude (sensible default: Claude plays every role)\n35\t#   model:    HARDEN_<ROLE>[_<LENS>]_MODEL    -> HARDEN_<ROLE>_MODEL\n36\t#             -> HARDEN_MODEL -> \"\" (the provider's own default)\n37\t#   effort:   HARDEN_<ROLE>[_<LENS>]_EFFORT   -> HARDEN_<ROLE>_EFFORT\n38\t#             -> HARDEN_EFFORT -> \"\" (the provider's own default)\n39\t#\n40\t# Only reviewers consult the lens, so providers can be mixed across lenses in one\n41\t# round; conductor and fixer are single-instance and ignore it. Resolution reads\n42\t# ONLY HARDEN_* (and the shared loop env) — never any host marker — so the tuple\n43\t# is identical whether the run was launched from Claude Code or Codex. Emits three\n44\t# TSV rows (provider/model/effort); returns 2 on an unknown role.\n45\talmanac_harden_role() {\n46\t  local role=\"$1\"\n47\t  local lens=\"${2:-}\"\n48\t\n49\t  case \"$role\" in\n50\t    reviewer) ;;                 # reviewers map lens -> provider\n51\t    conductor | fixer) lens=\"\" ;; # single-instance roles ignore the lens\n52\t    *) return 2 ;;\n53\t  esac\n54\t\n55\t  almanac_loop_role_config \"harden\" \"$role\" \"$lens\" \"$(almanac_provider_default)\" \"\" \"\"\n56\t}\n57\t\n58\t# One field (provider | model | effort) of a harden role's resolved config, for\n59\t# call sites that need a single value. Thin reader over almanac_harden_role so\n60\t# harden's per-role defaults stay defined in exactly one place.\n61\talmanac_harden_role_field() {\n62\t  local role=\"$1\"\n63\t  local field=\"$2\"\n64\t  local lens=\"${3:-}\"\n65\t\n66\t  almanac_harden_role \"$role\" \"$lens\" | almanac_loop_role_tsv_field \"$field\"\n67\t}\n68\t\n69\talmanac_harden_rubric_path() {\n70\t  local root=\"$1\"\n71\t  local target=\"$2\"\n72\t  local slug\n73\t\n74\t  slug=\"$(almanac_loop_slug \"$target\")\"\n75\t  printf '%s/rubric.md\\n' \"$(almanac_loop_plan_dir harden \"$root\" \"$slug\")\"\n76\t}\n77\t\n78\talmanac_harden_write_rubric() {\n79\t  local root=\"$1\"\n80\t  local target=\"$2\"\n81\t  local goal=\"$3\"\n82\t  local path dir\n83\t\n84\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n85\t  dir=\"$(dirname \"$path\")\"\n86\t\n87\t  if [ -e \"$path\" ]; then\n88\t    return 2\n89\t  fi\n90\t\n91\t  mkdir -p \"$dir\"\n92\t  cat > \"$path\" <<EOF\n93\t# Harden Rubric\n94\t\n95\tTarget: $target\n96\tStatus: draft\n97\t\n98\t## Goal\n99\t\n100\t$goal\n101\t\n102\t## Acceptance\n103\t\n104\t- [ ] Target behavior satisfies the stated goal.\n105\t- [ ] Blocking findings include a failing test, breaking input, or cited acceptance violation.\n106\t- [ ] Project feedback loops pass after fixes.\n107\t\n108\t## In Scope\n109\t\n110\t- $target\n111\t\n112\t## Out of Scope\n113\t\n114\t- Add non-goals here before running reviewers.\n115\t\n116\t## Severity\n117\t\n118\tBlocking findings must be falsifiable and reproducible against the current target.\n119\tSubjective or unreproducible findings are non-blocking notes.\n120\t\n121\t## Context\n122\t\n123\t- Add intentional decisions and false-positive preemptions here before running reviewers.\n124\tEOF\n125\t}\n126\t\n127\talmanac_harden_approve_rubric() {\n128\t  local root=\"$1\"\n129\t  local target=\"$2\"\n130\t  local path approved_at tmp\n131\t\n132\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n133\t\n134\t  if [ ! -f \"$path\" ]; then\n135\t    return 2\n136\t  fi\n137\t\n138\t  if grep -Eq '^Status: approved$' \"$path\"; then\n139\t    return 3\n140\t  fi\n141\t\n142\t  approved_at=\"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\"\n143\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n144\t\n145\t  if grep -Eq '^Status: draft$' \"$path\"; then\n146\t    awk -v approved_at=\"$approved_at\" '\n147\t      /^Status: draft$/ && !replaced {\n148\t        print \"Status: approved\"\n149\t        replaced = 1\n150\t        next\n151\t      }\n152\t      { print }\n153\t      END {\n154\t        print \"\"\n155\t        print \"## Approval\"\n156\t        print \"\"\n157\t        print \"Approved: \" approved_at\n158\t      }\n159\t    ' \"$path\" > \"$tmp\"\n160\t  else\n161\t    awk -v approved_at=\"$approved_at\" '\n162\t      /^Target: / && !inserted {\n163\t        print\n164\t        print \"Status: approved\"\n165\t        inserted = 1\n166\t        next\n167\t      }\n168\t      { print }\n169\t      END {\n170\t        if (!inserted) {\n171\t          print \"Status: approved\"\n172\t        }\n173\t        print \"\"\n174\t        print \"## Approval\"\n175\t        print \"\"\n176\t        print \"Approved: \" approved_at\n177\t      }\n178\t    ' \"$path\" > \"$tmp\"\n179\t  fi\n180\t\n181\t  mv \"$tmp\" \"$path\"\n182\t}\n183\t\n184\t# Return 0 when the rubric is approved (locked), non-zero otherwise — including\n185\t# when it is still a draft or the file is absent. Pure read; the loop gates on\n186\t# this so reviewers never run against a half-authored bar.\n187\talmanac_harden_rubric_approved() {\n188\t  local rubric_path=\"$1\"\n189\t\n190\t  [ -f \"$rubric_path\" ] || return 1\n191\t  grep -Eq '^Status: approved$' \"$rubric_path\"\n192\t}\n193\t\n194\t# Emit the rubric's acceptance criteria — the bar reviewers and ratification work\n195\t# against. Prints every bullet line under the `## Acceptance` heading up to the\n196\t# next `## ` section. Empty when the rubric or section is absent. Pure read.\n197\talmanac_harden_rubric_acceptance() {\n198\t  local path=\"$1\"\n199\t\n200\t  [ -f \"$path\" ] || return 0\n201\t\n202\t  awk '\n203\t    /^## Acceptance[[:space:]]*$/ { in_acc = 1; next }\n204\t    in_acc && /^## / { in_acc = 0 }\n205\t    in_acc && /^- / { print }\n206\t  ' \"$path\"\n207\t}\n208\t\n209\t# Append one acceptance criterion to the rubric's `## Acceptance` section. This is\n210\t# how a ratified finding grows the bar: monotonic (criteria are only added), visible\n211\t# (a clean diff), and append-only. The new `- [ ] <criterion>` lands at the end of\n212\t# the Acceptance block, before the next section. Idempotent: an identical criterion\n213\t# is never re-added (returns 1, writes nothing) so re-ratifying a reopened finding\n214\t# cannot duplicate it. Returns 2 when the rubric or its Acceptance section is absent.\n215\talmanac_harden_rubric_append_criterion() {\n216\t  local path=\"$1\"\n217\t  local criterion=\"$2\"\n218\t  local tmp\n219\t\n220\t  [ -f \"$path\" ] || return 2\n221\t  grep -q '^## Acceptance[[:space:]]*$' \"$path\" || return 2\n222\t\n223\t  if grep -Fxq -- \"- [ ] $criterion\" \"$path\" || \\\n224\t      grep -Fxq -- \"- [x] $criterion\" \"$path\"; then\n225\t    return 1\n226\t  fi\n227\t\n228\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n229\t  awk -v crit=\"$criterion\" '\n230\t    /^## Acceptance[[:space:]]*$/ { print; in_acc = 1; next }\n231\t    in_acc && /^## / {\n232\t      print \"- [ ] \" crit\n233\t      inserted = 1\n234\t      in_acc = 0\n235\t      for (i = 1; i <= nb; i++) print blanks[i]\n236\t      nb = 0\n237\t      print\n238\t      next\n239\t    }\n240\t    in_acc && /^[[:space:]]*$/ { nb++; blanks[nb] = $0; next }\n241\t    in_acc {\n242\t      for (i = 1; i <= nb; i++) print blanks[i]\n243\t      nb = 0\n244\t      print\n245\t      next\n246\t    }\n247\t    { print }\n248\t    END {\n249\t      if (in_acc && !inserted) {\n250\t        print \"- [ ] \" crit\n251\t        for (i = 1; i <= nb; i++) print blanks[i]\n252\t      }\n253\t    }\n254\t  ' \"$path\" > \"$tmp\"\n255\t  mv \"$tmp\" \"$path\"\n256\t}\n257\t\n258\t# --- Rubric immutability guard -------------------------------------------------\n259\t#\n260\t# The rubric is the contract, and during a run it is immutable to agents: the\n261\t# goalposts move only by a deliberate human act (the developer editing the file\n262\t# between runs / approving it) or the conductor's controlled append at\n263\t# ratification (almanac_harden_rubric_append_criterion — a visible, monotonic\n264\t# diff that runs OUTSIDE the reviewer/fixer phase). Reviewers run read-only and\n265\t# cannot write the rubric; the fixer (later slice) has write access and could.\n266\t# These two helpers bracket an agent phase — snapshot before, verify after — and\n267\t# revert any agent edit, so a stray agent write during a run cannot lower the bar.\n268\t\n269\t# Snapshot the rubric to a protected temp copy and echo the snapshot path so the\n270\t# caller can pass it to almanac_harden_rubric_verify. Returns 2 (echoes nothing)\n271\t# when no rubric exists — an ad-hoc bare run with no drafted contract has nothing\n272\t# to guard.\n273\talmanac_harden_rubric_snapshot() {\n274\t  local rubric_path=\"$1\"\n275\t  local snap\n276\t\n277\t  [ -f \"$rubric_path\" ] || return 2\n278\t\n279\t  snap=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-rubric-lock.XXXXXX\")\"\n280\t  cp \"$rubric_path\" \"$snap\"\n281\t  printf '%s\\n' \"$snap\"\n282\t}\n283\t\n284\t# Verify the rubric is byte-identical to its snapshot; if an agent modified it\n285\t# during the guarded phase, revert it and warn (the contract is immutable to\n286\t# agents). Discards the snapshot either way. Returns 1 when a modification was\n287\t# reverted, 0 when unchanged, 2 when the snapshot is missing.\n288\talmanac_harden_rubric_verify() {\n289\t  local rubric_path=\"$1\"\n290\t  local snap=\"$2\"\n291\t\n292\t  [ -n \"$snap\" ] && [ -f \"$snap\" ] || return 2\n293\t\n294\t  if ! cmp -s \"$rubric_path\" \"$snap\"; then\n295\t    cp \"$snap\" \"$rubric_path\"\n296\t    rm -f \"$snap\"\n297\t    _warn \"Rubric was modified during the run; reverted (contract is immutable to agents — amend it directly between runs).\"\n298\t    return 1\n299\t  fi\n300\t\n301\t  rm -f \"$snap\"\n302\t  return 0\n303\t}\n304\t\n305\t# Emit the configured reviewer lens set, one lens per line. Defaults to the five\n306\t# PRD lenses; override at runtime via HARDEN_LENSES (comma- or whitespace-\n307\t# separated).\n308\talmanac_harden_lenses() {\n309\t  local raw=\"${HARDEN_LENSES:-correctness security perf edge-cases contracts}\"\n310\t\n311\t  # Trailing newline matters: a `read` loop consumer drops a final line that\n312\t  # lacks one, which would silently swallow the last lens.\n313\t  printf '%s\\n' \"$raw\" | tr -s ', \\t' '\\n' | sed '/^$/d'\n314\t}\n315\t\n316\talmanac_harden_max_reviewers() {\n317\t  printf '%s\\n' \"${HARDEN_MAX_REVIEWERS:-16}\"\n318\t}\n319\t\n320\t# Build the fixed prompt for one read-only reviewer over a target, including the\n321\t# JSON-Lines findings schema. When a rubric path is given and exists, the rubric's\n322\t# acceptance criteria are embedded as the bar the reviewer judges against, so\n323\t# reviewers consume the contract rather than an implicit standard. An optional\n324\t# steering directive (4th arg) is embedded too, so an operator who redirects the\n325\t# run at the HITL checkpoint (e.g. \"focus on the auth module\") reaches the\n326\t# reviewers on the next round. Kept separate so the schema can grow without\n327\t# touching orchestration. (Exact prompt wording is not asserted in tests by\n328\t# design; that the rubric bar and the steer directive are consumed is.)\n329\talmanac_harden_reviewer_prompt() {\n330\t  local target=\"$1\"\n331\t  local lens=\"${2:-correctness}\"\n332\t  local rubric_path=\"${3:-}\"\n333\t  local directive=\"${4:-}\"\n334\t  local rubric_bar=\"\"\n335\t\n336\t  if [ -n \"$rubric_path\" ] && [ -f \"$rubric_path\" ]; then\n337\t    rubric_bar=\"$(almanac_harden_rubric_acceptance \"$rubric_path\")\"\n338\t  fi\n339\t\n340\t  cat <<EOF\n341\tYou are a read-only code reviewer. Lens: ${lens}.\n342\t\n343\tReview the target below for ${lens} defects only. You cannot modify any files;\n344\tthis is a read-only review.\n345\t\n346\tTarget: ${target}\n347\tEOF\n348\t\n349\t  if [ -n \"$rubric_bar\" ]; then\n350\t    cat <<EOF\n351\t\n352\tJudge the target against this acceptance bar (the rubric contract). A finding is\n353\tonly blocking if it violates a criterion below or demonstrably breaks behavior:\n354\t\n355\t${rubric_bar}\n356\tEOF\n357\t  fi\n358\t\n359\t  if [ -n \"$directive\" ]; then\n360\t    cat <<EOF\n361\t\n362\tThe operator steered this run with the directive below — follow it and prioritize\n363\tthe findings it points you toward:\n364\t\n365\t${directive}\n366\tEOF\n367\t  fi\n368\t\n369\t  cat <<EOF\n370\t\n371\tReport each defect as one JSON object per line (JSON Lines) and output nothing\n372\telse — no prose, no markdown fences. Each object must use this schema:\n373\t\n374\t{\"lens\":\"${lens}\",\"severity\":\"high|medium|low\",\"location\":\"<file:line or symbol>\",\"claim\":\"<one-line defect>\",\"demonstration\":\"<failing test, breaking input, or cited rubric criterion>\"}\n375\t\n376\tOnly report a defect you can demonstrate with a failing test, a specific breaking\n377\tinput, or a cited criterion. If you find no demonstrable defects, output nothing.\n378\tEOF\n379\t}\n380\t\n381\t# Normalize the reviewer's JSON-Lines result into TSV rows\n382\t# (lens, severity, location, claim, demonstration). Malformed lines are dropped\n383\t# cleanly. Prefers jq; falls back to a flat-field awk extractor when jq is absent\n384\t# so harden keeps almanac's near-zero-dependency promise.\n385\talmanac_harden_findings_tsv() {\n386\t  local result_file=\"$1\"\n387\t\n388\t  [ -f \"$result_file\" ] || return 0\n389\t\n390\t  if command -v jq >/dev/null 2>&1; then\n391\t    jq -Rr '\n392\t      fromjson?\n393\t      | select(type == \"object\")\n394\t      | {\n395\t          lens: (.lens // \"\"),\n396\t          severity: (.severity // \"\"),\n397\t          location: (.location // \"\"),\n398\t          claim: (.claim // \"\"),\n399\t          demonstration: (.demonstration // \"\")\n400\t        }\n401\t      | select(\n402\t          (.lens | type == \"string\" and length > 0) and\n403\t          (.severity | type == \"string\" and length > 0) and\n404\t          (.location | type == \"string\" and length > 0) and\n405\t          (.claim | type == \"string\" and length > 0) and\n406\t          (.demonstration | type == \"string\" and length > 0)\n407\t        )\n408\t      | [.lens, .severity, .location, .claim, .demonstration]\n409\t      | @tsv\n410\t    ' \"$result_file\" 2>/dev/null\n411\t    return 0\n412\t  fi\n413\t\n414\t  awk '\n415\t    function field(line, key,   v) {\n416\t      v = line\n417\t      if (v ~ (\"\\\"\" key \"\\\"[ \\t]*:[ \\t]*\\\"\")) {\n418\t        sub(\".*\\\"\" key \"\\\"[ \\t]*:[ \\t]*\\\"\", \"\", v)\n419\t        sub(\"\\\".*\", \"\", v)\n420\t        return v\n421\t      }\n422\t      return \"\"\n423\t    }\n424\t    /\"claim\"[ \\t]*:/ {\n425\t      lens = field($0, \"lens\")\n426\t      severity = field($0, \"severity\")\n427\t      location = field($0, \"location\")\n428\t      claim = field($0, \"claim\")\n429\t      demonstration = field($0, \"demonstration\")\n430\t      if (lens != \"\" && severity != \"\" && location != \"\" && claim != \"\" && demonstration != \"\") {\n431\t        printf \"%s\\t%s\\t%s\\t%s\\t%s\\n\", lens, severity, location, claim, demonstration\n432\t      }\n433\t    }\n434\t  ' \"$result_file\"\n435\t}\n436\t\n437\t# Print parsed findings as a readable list. Reports \"No findings reported.\" when\n438\t# the reviewer returned nothing parseable.\n439\talmanac_harden_format_findings() {\n440\t  local result_file=\"$1\"\n441\t  local lens severity location claim demonstration count\n442\t\n443\t  count=0\n444\t  while IFS=$'\\t' read -r lens severity location claim demonstration; do\n445\t    [ -n \"${lens}${severity}${location}${claim}${demonstration}\" ] || continue\n446\t    printf -- '- [%s] %s: %s\\n' \"${severity:-?}\" \"${lens:-?}\" \"${claim:-?}\"\n447\t    [ -n \"$location\" ] && printf '    where: %s\\n' \"$location\"\n448\t    [ -n \"$demonstration\" ] && printf '    demo:  %s\\n' \"$demonstration\"\n449\t    count=$((count + 1))\n450\t  done < <(almanac_harden_findings_tsv \"$result_file\")\n451\t\n452\t  if [ \"$count\" -eq 0 ]; then\n453\t    printf '%s\\n' \"No findings reported.\"\n454\t  fi\n455\t}\n456\t\n457\t# --- Findings ledger -----------------------------------------------------------\n458\t#\n459\t# Canonical finding schema (one JSON object per reviewer line, see the reviewer\n460\t# prompt above): lens, severity, location, claim, demonstration. The ledger adds\n461\t# three adjudication fields when a finding is recorded:\n462\t#   id            - deterministic fingerprint of (lens, location, claim)\n463\t#   status        - open | fixed | rejected-subjective | wontfix-per-context\n464\t#   round         - the review round that first raised the finding\n465\t#   adjudication  - free-text note (why rejected / how fixed); empty when open\n466\t#\n467\t# Findings persist append-only to findings.md next to the target's rubric.md.\n468\t# Each finding is one markdown section keyed by its id, so the file is both\n469\t# human-readable and re-parseable (dedupe + open-blocking query read it back).\n470\t\n471\talmanac_harden_ledger_path() {\n472\t  local root=\"$1\"\n473\t  local target=\"$2\"\n474\t  local slug\n475\t\n476\t  slug=\"$(almanac_loop_slug \"$target\")\"\n477\t  printf '%s/findings.md\\n' \"$(almanac_loop_plan_dir harden \"$root\" \"$slug\")\"\n478\t}\n479\t\n480\t# Deterministic finding identity. Two reviewer reports of the same defect\n481\t# (same lens, same place, same claim) collapse to one id so re-raising a\n482\t# finding never re-adds it. Demonstration is deliberately excluded: a reworded\n483\t# repro must not look like a new finding. cksum keeps this dependency-free.\n484\talmanac_harden_finding_id() {\n485\t  local lens=\"$1\"\n486\t  local location=\"$2\"\n487\t  local claim=\"$3\"\n488\t  local sum\n489\t\n490\t  sum=\"$(printf '%s\\037%s\\037%s' \"$lens\" \"$location\" \"$claim\" | cksum | awk '{print $1}')\"\n491\t  printf 'f-%s\\n' \"$sum\"\n492\t}\n493\t\n494\talmanac_harden_ledger_init() {\n495\t  local path=\"$1\"\n496\t  local dir\n497\t\n498\t  dir=\"$(dirname \"$path\")\"\n499\t  mkdir -p \"$dir\"\n500\t\n501\t  if [ ! -f \"$path\" ]; then\n502\t    {\n503\t      printf '%s\\n\\n' \"# Findings Ledger\"\n504\t      printf '%s\\n' \"<!-- Append-only finding records managed by 'almanac harden'. One section per finding. -->\"\n505\t    } > \"$path\"\n506\t  fi\n507\t}\n508\t\n509\t# True when the ledger already holds a finding with this id.\n510\talmanac_harden_ledger_has() {\n511\t  local path=\"$1\"\n512\t  local id=\"$2\"\n513\t\n514\t  [ -f \"$path\" ] || return 1\n515\t  grep -Fxq -- \"## $id\" \"$path\"\n516\t}\n517\t\n518\t# Append one finding section. Returns 1 (and writes nothing) when the id is\n519\t# already present, so callers can count genuinely-new findings. Creates the\n520\t# ledger file with its header on first write.\n521\talmanac_harden_ledger_append_entry() {\n522\t  [ \"$#\" -ge 7 ] || return 2\n523\t\n524\t  local path=\"$1\"\n525\t  local id=\"$2\"\n526\t  local lens=\"$3\"\n527\t  local severity=\"$4\"\n528\t  local location=\"$5\"\n529\t  local claim=\"$6\"\n530\t  local demonstration=\"$7\"\n531\t  local status=\"${8:-open}\"\n532\t  local round=\"${9:-1}\"\n533\t  local adjudication=\"${10:-}\"\n534\t\n535\t  almanac_harden_ledger_init \"$path\"\n536\t\n537\t  if almanac_harden_ledger_has \"$path\" \"$id\"; then\n538\t    return 1\n539\t  fi\n540\t\n541\t  almanac_harden_ledger_append_entry_unchecked \\\n542\t    \"$path\" \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \\\n543\t    \"$demonstration\" \"$status\" \"$round\" \"$adjudication\"\n544\t}\n545\t\n546\t# Append one already-deduped finding section. Callers must have initialised the\n547\t# ledger and decided the id is new; this keeps bulk ingestion from grepping the\n548\t# growing ledger once per finding.\n549\talmanac_harden_ledger_append_entry_unchecked() {\n550\t  [ \"$#\" -ge 7 ] || return 2\n551\t\n552\t  local path=\"$1\"\n553\t  local id=\"$2\"\n554\t  local lens=\"$3\"\n555\t  local severity=\"$4\"\n556\t  local location=\"$5\"\n557\t  local claim=\"$6\"\n558\t  local demonstration=\"$7\"\n559\t  local status=\"${8:-open}\"\n560\t  local round=\"${9:-1}\"\n561\t  local adjudication=\"${10:-}\"\n562\t\n563\t  {\n564\t    printf '\\n## %s\\n\\n' \"$id\"\n565\t    printf -- '- lens: %s\\n' \"$lens\"\n566\t    printf -- '- severity: %s\\n' \"$severity\"\n567\t    printf -- '- location: %s\\n' \"$location\"\n568\t    printf -- '- claim: %s\\n' \"$claim\"\n569\t    printf -- '- demonstration: %s\\n' \"$demonstration\"\n570\t    printf -- '- status: %s\\n' \"$status\"\n571\t    printf -- '- round: %s\\n' \"$round\"\n572\t    printf -- '- adjudication: %s\\n' \"$adjudication\"\n573\t  } >> \"$path\"\n574\t}\n575\t\n576\t# Normalize a reviewer's JSON-Lines result into ledger-entry TSV rows\n577\t# (id, lens, severity, location, claim, demonstration, status, round,\n578\t# adjudication). New findings are status=open with an empty adjudication.\n579\t# Malformed reviewer lines are dropped cleanly (via almanac_harden_findings_tsv).\n580\talmanac_harden_parse_findings() {\n581\t  local result_file=\"$1\"\n582\t  local round=\"${2:-1}\"\n583\t  local lens severity location claim demonstration id\n584\t\n585\t  while IFS=$'\\t' read -r lens severity location claim demonstration; do\n586\t    [ -n \"${lens}${severity}${location}${claim}${demonstration}\" ] || continue\n587\t    id=\"$(almanac_harden_finding_id \"$lens\" \"$location\" \"$claim\")\"\n588\t    printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \\\n589\t      \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \"$demonstration\" \"open\" \"$round\" \"\"\n590\t  done < <(almanac_harden_findings_tsv \"$result_file\")\n591\t}\n592\t\n593\t# Parse a reviewer result and append each new finding to the ledger, deduping\n594\t# against everything already adjudicated. Prints the count of findings actually\n595\t# added (duplicates do not count).\n596\talmanac_harden_ledger_record() {\n597\t  local path=\"$1\"\n598\t  local result_file=\"$2\"\n599\t  local round=\"${3:-1}\"\n600\t  local parsed statuses actions reopen_ids action\n601\t  local id lens severity location claim demonstration status r adjudication\n602\t  local added=0\n603\t\n604\t  almanac_harden_ledger_init \"$path\"\n605\t\n606\t  parsed=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-findings.XXXXXX\")\"\n607\t  statuses=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-statuses.XXXXXX\")\"\n608\t  actions=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-actions.XXXXXX\")\"\n609\t  reopen_ids=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-reopen.XXXXXX\")\"\n610\t\n611\t  almanac_harden_parse_findings \"$result_file\" \"$round\" > \"$parsed\"\n612\t\n613\t  awk '\n614\t    /^## / { id = substr($0, 4); next }\n615\t    /^- status:/ && id != \"\" {\n616\t      val = $0\n617\t      sub(/^- status:[ \\t]*/, \"\", val)\n618\t      print id \"\\t\" val\n619\t    }\n620\t  ' \"$path\" > \"$statuses\"\n621\t\n622\t  awk '\n623\t    BEGIN { FS = \"\\t\" }\n624\t    FILENAME == ARGV[1] { existing[$1] = $2; next }\n625\t    $1 == \"\" { next }\n626\t    seen[$1]++ { next }\n627\t    !($1 in existing) {\n628\t      print \"append\\t\" $0\n629\t      next\n630\t    }\n631\t    existing[$1] == \"fixed\" {\n632\t      print \"reopen\\t\" $0\n633\t      next\n634\t    }\n635\t  ' \"$statuses\" \"$parsed\" > \"$actions\"\n636\t\n637\t  while IFS=$'\\t' read -r action id lens severity location claim demonstration status r adjudication; do\n638\t    [ -n \"$id\" ] || continue\n639\t    case \"$action\" in\n640\t      append)\n641\t        almanac_harden_ledger_append_entry_unchecked \\\n642\t          \"$path\" \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \\\n643\t          \"$demonstration\" \"$status\" \"$r\" \"$adjudication\"\n644\t        added=$((added + 1))\n645\t        ;;\n646\t      reopen)\n647\t        printf '%s\\n' \"$id\" >> \"$reopen_ids\"\n648\t        ;;\n649\t    esac\n650\t  done < \"$actions\"\n651\t\n652\t  if [ -s \"$reopen_ids\" ]; then\n653\t    almanac_harden_ledger_set_status_many \"$path\" \"open\" \\\n654\t      \"re-raised by reviewer at round $round; pending ratification\" < \"$reopen_ids\"\n655\t  fi\n656\t\n657\t  rm -f \"$parsed\" \"$statuses\" \"$actions\" \"$reopen_ids\"\n658\t\n659\t  printf '%s\\n' \"$added\"\n660\t}\n661\t\n662\t# Emit the open blocking findings as TSV rows\n663\t# (id, lens, severity, location, claim, demonstration). Only status=open\n664\t# entries qualify; fixed / rejected-subjective / wontfix-per-context never gate.\n665\talmanac_harden_ledger_open_blocking() {\n666\t  local path=\"$1\"\n667\t\n668\t  [ -f \"$path\" ] || return 0\n669\t\n670\t  awk '\n671\t    function flush() {\n672\t      if (id != \"\" && status == \"open\") {\n673\t        printf \"%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n\", id, lens, severity, location, claim, demonstration\n674\t      }\n675\t    }\n676\t    /^## / {\n677\t      flush()\n678\t      id = substr($0, 4)\n679\t      lens = \"\"; severity = \"\"; location = \"\"; claim = \"\"; demonstration = \"\"; status = \"\"\n680\t      next\n681\t    }\n682\t    /^- / {\n683\t      line = substr($0, 3)\n684\t      p = index(line, \":\")\n685\t      if (p == 0) next\n686\t      key = substr(line, 1, p - 1)\n687\t      val = substr(line, p + 1)\n688\t      sub(/^ /, \"\", val)\n689\t      if (key == \"lens\") lens = val\n690\t      else if (key == \"severity\") severity = val\n691\t      else if (key == \"location\") location = val\n692\t      else if (key == \"claim\") claim = val\n693\t      else if (key == \"demonstration\") demonstration = val\n694\t      else if (key == \"status\") status = val\n695\t    }\n696\t    END { flush() }\n697\t  ' \"$path\"\n698\t}\n699\t\n700\t# Print the recorded status of the finding with this id (empty when the id is\n701\t# not in the ledger). Used by ratification to tell new from already-adjudicated.\n702\talmanac_harden_ledger_status() {\n703\t  local path=\"$1\"\n704\t  local id=\"$2\"\n705\t\n706\t  [ -f \"$path\" ] || return 0\n707\t\n708\t  awk -v want=\"$id\" '\n709\t    /^## / { cur = substr($0, 4); next }\n710\t    /^- status:/ && cur == want {\n711\t      val = $0\n712\t      sub(/^- status:[ \\t]*/, \"\", val)\n713\t      print val\n714\t      exit\n715\t    }\n716\t  ' \"$path\"\n717\t}\n718\t\n719\t# Rewrite the status (and adjudication note) of the finding with this id in\n720\t# place, leaving every other field and finding untouched. Returns 1 when the\n721\t# ledger file is absent.\n722\talmanac_harden_ledger_set_status() {\n723\t  local path=\"$1\"\n724\t  local id=\"$2\"\n725\t  local status=\"$3\"\n726\t  local adjudication=\"${4:-}\"\n727\t  local tmp\n728\t\n729\t  [ -f \"$path\" ] || return 1\n730\t\n731\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n732\t  awk -v want=\"$id\" -v status=\"$status\" -v adj=\"$adjudication\" '\n733\t    /^## / { cur = substr($0, 4); print; next }\n734\t    cur == want && /^- status:/ { print \"- status: \" status; next }\n735\t    cur == want && /^- adjudication:/ { print \"- adjudication: \" adj; next }\n736\t    { print }\n737\t  ' \"$path\" > \"$tmp\"\n738\t  mv \"$tmp\" \"$path\"\n739\t}\n740\t\n741\t# Rewrite status/adjudication for many finding ids in one ledger pass. Reads ids\n742\t# from stdin, one per line. Used after a batch fix so marking N findings fixed is\n743\t# O(ledger) instead of N full ledger rewrites.\n744\talmanac_harden_ledger_set_status_many() {\n745\t  local path=\"$1\"\n746\t  local status=\"$2\"\n747\t  local adjudication=\"${3:-}\"\n748\t  local ids tmp\n749\t\n750\t  [ -f \"$path\" ] || return 1\n751\t\n752\t  ids=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ids.XXXXXX\")\"\n753\t  cat > \"$ids\"\n754\t  [ -s \"$ids\" ] || { rm -f \"$ids\"; return 0; }\n755\t\n756\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n757\t  awk -v ids=\"$ids\" -v status=\"$status\" -v adj=\"$adjudication\" '\n758\t    BEGIN {\n759\t      while ((getline line < ids) > 0) {\n760\t        if (line != \"\") wanted[line] = 1\n761\t      }\n762\t      close(ids)\n763\t    }\n764\t    /^## / { cur = substr($0, 4); print; next }\n765\t    (cur in wanted) && /^- status:/ { print \"- status: \" status; next }\n766\t    (cur in wanted) && /^- adjudication:/ { print \"- adjudication: \" adj; next }\n767\t    { print }\n768\t  ' \"$path\" > \"$tmp\"\n769\t  mv \"$tmp\" \"$path\"\n770\t  rm -f \"$ids\"\n771\t}\n772\t\n773\t# --- Ratification engine -------------------------------------------------------\n774\t#\n775\t# A finding is \"blocking\" only if its demonstration objectively reproduces\n776\t# against the current target — never on a reviewer's assertion alone. Execution\n777\t# of the demonstration is isolated behind a seam (almanac_harden_demo_reproduces)\n778\t# so the decision logic is testable without running anything, and so the real\n779\t# executor (a conductor agent-runner call) can be wired in a later slice.\n780\t\n781\t# Prompt the conductor uses to execute one finding's demonstration. It must run\n782\t# the demonstration against the CURRENT code and render a strict, falsifiable\n783\t# verdict — never an opinion. The verdict contract is a single machine-readable\n784\t# token so the parser can be unambiguous (see almanac_harden_ratify_verdict).\n785\talmanac_harden_ratify_prompt() {\n786\t  local demonstration=\"$1\"\n787\t  local target_path=\"${2:-}\"\n788\t\n789\t  cat <<EOF\n790\tYou are the CONDUCTOR in a code-hardening loop. Ratify ONE reviewer finding by\n791\tEXECUTING its demonstration against the current code — decide by reproduction,\n792\tnever by opinion.\n793\t\n794\tTarget: ${target_path:-(the current working directory)}\n795\t\n796\tDemonstration to reproduce:\n797\t${demonstration}\n798\t\n799\tDo this:\n800\t1. Carry out the demonstration against the code AS IT IS RIGHT NOW: run the\n801\t   proposed failing test, try the specific breaking input, or check the cited\n802\t   rubric criterion.\n803\t2. Decide strictly. The finding reproduces ONLY if the defect actually manifests\n804\t   against the current code. A demonstration that you cannot run, that is vague\n805\t   or speculative, or that does not actually fail does NOT reproduce.\n806\t3. You are a JUDGE, not a fixer: do not modify the target to change the outcome.\n807\t\n808\tEnd your message with EXACTLY ONE of these two lines and nothing after it:\n809\tHARDEN_VERDICT=reproduces\n810\tHARDEN_VERDICT=not-reproduces\n811\tEOF\n812\t}\n813\t\n814\t# Parse the conductor's final message into a reproduce verdict. The contract is a\n815\t# single unambiguous token: the affirmative is the literal \"HARDEN_VERDICT=reproduces\"\n816\t# (the negative \"HARDEN_VERDICT=not-reproduces\" cannot match it — the char after\n817\t# `=` is `n`, not `r`). Anything else (no token, garbled, only the negative) reads\n818\t# as \"not\", so an un-parseable verdict is conservatively a non-blocking note.\n819\talmanac_harden_ratify_verdict() {\n820\t  local result_file=\"$1\"\n821\t\n822\t  [ -f \"$result_file\" ] || { printf '%s\\n' \"not\"; return 0; }\n823\t\n824\t  if grep -Fxq 'HARDEN_VERDICT=reproduces' \"$result_file\" 2>/dev/null; then\n825\t    printf '%s\\n' \"reproduces\"\n826\t  else\n827\t    printf '%s\\n' \"not\"\n828\t  fi\n829\t}\n830\t\n831\t# Execution seam: decide whether a finding's demonstration reproduces against the\n832\t# target. Return 0 = reproduces (real defect, blocking), non-zero = does not\n833\t# reproduce (opinion / stale). This seam IS the conductor executing the\n834\t# demonstration: it runs the demonstration through the resolved conductor provider\n835\t# (the (provider, model, effort) it is handed — no host-marker dependence, so it\n836\t# is mixable per the role config) via the shared agent runner and reads the\n837\t# conductor's verdict back from its final message. PRD story 8: \"blocking means\n838\t# objectively reproducible, not a reviewer's assertion.\"\n839\t#\n840\t# Conservative on every uncertainty so opinions never silently gate the loop and\n841\t# a flaky/missing provider never blocks a run: an empty demonstration, an\n842\t# unresolved conductor provider, a failed/un-runnable conductor call, or an\n843\t# un-parseable verdict all read as non-reproducing (a note). Tests override this\n844\t# to drive the decision paths directly; here it is the real executor.\n845\talmanac_harden_demo_reproduces() {\n846\t  local demonstration=\"$1\"\n847\t  local target_path=\"${2:-}\"\n848\t  local conductor_provider=\"${3:-}\"\n849\t  local conductor_model=\"${4:-}\"\n850\t  local conductor_effort=\"${5:-}\"\n851\t  local prompt_file result_file events_file verdict rc\n852\t\n853\t  # Nothing to execute / no provider to execute it through -> conservative note.\n854\t  [ -n \"$demonstration\" ] || return 1\n855\t  [ -n \"$conductor_provider\" ] || return 1\n856\t\n857\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-prompt.XXXXXX\")\" || return 1\n858\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-result.XXXXXX\")\" || { rm -f \"$prompt_file\"; return 1; }\n859\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-events.XXXXXX\")\" || { rm -f \"$prompt_file\" \"$result_file\"; return 1; }\n860\t\n861\t  almanac_harden_ratify_prompt \"$demonstration\" \"$target_path\" > \"$prompt_file\"\n862\t\n863\t  # Reviewer text is untrusted. Ratification may inspect/run existing repro\n864\t  # commands, but it must not write to the repo before the single fixer phase.\n865\t  rc=0\n866\t  almanac_loop_agent_capture \"$conductor_provider\" \"$conductor_model\" \"$conductor_effort\" \\\n867\t    \"read-only\" \"$prompt_file\" \"$result_file\" \"$events_file\" >/dev/null 2>&1 || rc=$?\n868\t\n869\t  if [ \"$rc\" -ne 0 ]; then\n870\t    # Provider missing/crashed or the demonstration was un-runnable: cannot\n871\t    # confirm reproduction -> non-blocking note, never a hang or a hard failure.\n872\t    rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n873\t    return 1\n874\t  fi\n875\t\n876\t  verdict=\"$(almanac_harden_ratify_verdict \"$result_file\")\"\n877\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n878\t\n879\t  [ \"$verdict\" = \"reproduces\" ] && return 0\n880\t  return 1\n881\t}\n882\t\n883\t# Adjudicate one finding by executing its demonstration through the seam and\n884\t# recording the outcome in the ledger. Prints the verdict:\n885\t#   blocking - new/open finding whose demonstration reproduces (ratified, gates)\n886\t#   note     - new/open finding that does not reproduce (non-blocking note)\n887\t#   reopened - an already-adjudicated finding whose demonstration newly reproduces\n888\t#   dropped  - an already-adjudicated finding that still does not reproduce\n889\t# Already-adjudicated findings are re-litigated ONLY when they newly reproduce,\n890\t# so a rejected opinion cannot churn the loop round after round.\n891\t#\n892\t# When a rubric path is given, a finding that reproduces (blocking or reopened)\n893\t# also appends a falsifiable criterion to the rubric's `## Acceptance` — the bar\n894\t# grows monotonically and visibly with every ratified defect. Notes and drops\n895\t# never touch the rubric, so opinions cannot raise the bar.\n896\t#\n897\t# The trailing conductor (provider, model, effort) args (11th-13th) identify the\n898\t# provider that executes the demonstration; they are passed straight to the\n899\t# execution seam. Optional/backward-compatible — omit them to use the default.\n900\talmanac_harden_ratify() {\n901\t  local path=\"$1\"\n902\t  local id=\"$2\"\n903\t  local lens=\"$3\"\n904\t  local severity=\"$4\"\n905\t  local location=\"$5\"\n906\t  local claim=\"$6\"\n907\t  local demonstration=\"$7\"\n908\t  local round=\"${8:-1}\"\n909\t  local target_path=\"${9:-}\"\n910\t  local rubric_path=\"${10:-}\"\n911\t  local conductor_provider=\"${11:-}\"\n912\t  local conductor_model=\"${12:-}\"\n913\t  local conductor_effort=\"${13:-}\"\n914\t  local current_status reproduces status note\n915\t\n916\t  almanac_harden_ledger_init \"$path\"\n917\t  current_status=\"$(almanac_harden_ledger_status \"$path\" \"$id\")\"\n918\t\n919\t  if almanac_harden_demo_reproduces \"$demonstration\" \"$target_path\" \\\n920\t      \"$conductor_provider\" \"$conductor_model\" \"$conductor_effort\"; then\n921\t    reproduces=1\n922\t  else\n923\t    reproduces=0\n924\t  fi\n925\t\n926\t  # A ratified (reproducing) finding grows the rubric bar, regardless of whether\n927\t  # it is newly raised or a reopened prior finding. Idempotent on the criterion\n928\t  # text, so a reopen never duplicates an already-listed criterion.\n929\t  if [ \"$reproduces\" -eq 1 ] && [ -n \"$rubric_path\" ]; then\n930\t    almanac_harden_rubric_append_criterion \"$rubric_path\" \\\n931\t      \"${claim} — must not reproduce (lens: ${lens}, at ${location})\" >/dev/null || true\n932\t  fi\n933\t\n934\t  case \"$current_status\" in\n935\t    fixed | rejected-subjective | wontfix-per-context)\n936\t      if [ \"$reproduces\" -eq 1 ]; then\n937\t        almanac_harden_ledger_set_status \"$path\" \"$id\" \"open\" \\\n938\t          \"reopened: demonstration reproduced at round $round\"\n939\t        printf '%s\\n' \"reopened\"\n940\t      else\n941\t        printf '%s\\n' \"dropped\"\n942\t      fi\n943\t      return 0\n944\t      ;;\n945\t  esac\n946\t\n947\t  if [ \"$reproduces\" -eq 1 ]; then\n948\t    status=\"open\"\n949\t    note=\"ratified: demonstration reproduced at round $round\"\n950\t  else\n951\t    status=\"rejected-subjective\"\n952\t    note=\"did not reproduce at round $round\"\n953\t  fi\n954\t\n955\t  if [ -z \"$current_status\" ]; then\n956\t    almanac_harden_ledger_append_entry \"$path\" \"$id\" \"$lens\" \"$severity\" \\\n957\t      \"$location\" \"$claim\" \"$demonstration\" \"$status\" \"$round\" \"$note\" >/dev/null\n958\t  else\n959\t    almanac_harden_ledger_set_status \"$path\" \"$id\" \"$status\" \"$note\"\n960\t  fi\n961\t\n962\t  if [ \"$reproduces\" -eq 1 ]; then\n963\t    printf '%s\\n' \"blocking\"\n964\t  else\n965\t    printf '%s\\n' \"note\"\n966\t  fi\n967\t}\n968\t\n969\t# Fan out one read-only reviewer per configured lens as a background worker via\n970\t# the shared worker orchestration, then aggregate every reviewer's findings into\n971\t# the ledger (deduped). Reviewers run concurrently and never write to the target\n972\t# (read-only sandbox); the parent aggregates sequentially after they finish, so\n973\t# there are no concurrent ledger writers. The lens set is configurable via\n974\t# HARDEN_LENSES, capped by HARDEN_MAX_REVIEWERS. Each reviewer's\n975\t# provider/model/effort resolves through the shared role config\n976\t# (HARDEN_REVIEWER[_<LENS>]_{PROVIDER,MODEL,EFFORT}). _die on a missing target\n977\t# before spawning anything.\n978\talmanac_harden_fanout() {\n979\t  local root=\"$1\"\n980\t  local target=\"$2\"\n981\t  local round=\"${3:-1}\"\n982\t  local directive=\"${4:-}\"\n983\t  local target_path run_id run_id_base registry_dir ledger_path rubric_path lens provider model effort\n984\t  local worker_id prompt_file pidfile pid result_file status_file wstatus\n985\t  local added total_added i max_reviewers succeeded_count suffix\n986\t  local -a lenses=() worker_ids=() worker_pids=() prompt_files=()\n987\t\n988\t  case \"$target\" in\n989\t    /*) target_path=\"$target\" ;;\n990\t    *)  target_path=\"$root/$target\" ;;\n991\t  esac\n992\t\n993\t  if [ ! -e \"$target_path\" ]; then\n994\t    _die \"Harden target not found: $target\"\n995\t  fi\n996\t\n997\t  while IFS= read -r lens; do\n998\t    [ -n \"$lens\" ] || continue\n999\t    lenses+=(\"$lens\")\n1000\t  done < <(almanac_harden_lenses)\n1001\t\n1002\t  [ \"${#lenses[@]}\" -gt 0 ] || _die \"No reviewer lenses configured\"\n1003\t  max_reviewers=\"$(almanac_harden_max_reviewers)\"\n1004\t  case \"$max_reviewers\" in\n1005\t    ''|*[!0-9]*) _die \"HARDEN_MAX_REVIEWERS must be a positive integer: $max_reviewers\" ;;\n1006\t  esac\n1007\t  [ \"$max_reviewers\" -ge 1 ] || _die \"HARDEN_MAX_REVIEWERS must be at least 1: $max_reviewers\"\n1008\t  if [ \"${#lenses[@]}\" -gt \"$max_reviewers\" ]; then\n1009\t    _die \"Too many reviewer lenses (${#lenses[@]}); cap is $max_reviewers (set HARDEN_MAX_REVIEWERS to change it)\"\n1010\t  fi\n1011\t\n1012\t  run_id=\"$(almanac_loop_run_id \"harden\" \"$target\")\"\n1013\t  run_id_base=\"$run_id\"\n1014\t  registry_dir=\"$(almanac_loop_registry_dir \"$root\")\"\n1015\t  suffix=1\n1016\t  while [ -e \"$registry_dir/$run_id\" ]; do\n1017\t    suffix=$((suffix + 1))\n1018\t    run_id=\"${run_id_base}-${suffix}\"\n1019\t  done\n1020\t  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n1021\t  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n1022\t\n1023\t  # The rubric is the contract; once one has been drafted it must be approved\n1024\t  # (locked) before the loop proceeds, so reviewers never run against a bar the\n1025\t  # human is still authoring. No rubric at all = an explicit ad-hoc run; proceed.\n1026\t  if [ -f \"$rubric_path\" ] && ! almanac_harden_rubric_approved \"$rubric_path\"; then\n1027\t    _die \"Rubric not approved: ${rubric_path#\"$root\"/} — edit it, then: almanac harden $target --approve\"\n1028\t  fi\n1029\t\n1030\t  almanac_harden_ledger_init \"$ledger_path\"\n1031\t\n1032\t  # The rubric is immutable to agents during the run. Snapshot it before any\n1033\t  # reviewer spawns; the reviewer round makes no legitimate rubric edits (the\n1034\t  # conductor's controlled append happens at ratification, a later phase), so\n1035\t  # any change observed when reviewers finish is an agent tampering — revert it.\n1036\t  local rubric_snapshot=\"\"\n1037\t  if [ -f \"$rubric_path\" ]; then\n1038\t    rubric_snapshot=\"$(almanac_harden_rubric_snapshot \"$rubric_path\")\" || rubric_snapshot=\"\"\n1039\t  fi\n1040\t\n1041\t  _info \"Hardening $target — fanning out ${#lenses[@]} read-only reviewer(s)\"\n1042\t\n1043\t  for lens in \"${lenses[@]}\"; do\n1044\t    provider=\"$(almanac_harden_role_field \"reviewer\" \"provider\" \"$lens\")\"\n1045\t    model=\"$(almanac_harden_role_field \"reviewer\" \"model\" \"$lens\")\"\n1046\t    effort=\"$(almanac_harden_role_field \"reviewer\" \"effort\" \"$lens\")\"\n1047\t\n1048\t    worker_id=\"reviewer-$lens\"\n1049\t    prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-prompt.XXXXXX\")\"\n1050\t    # Reviewers judge against the rubric when one exists (read gracefully when\n1051\t    # absent, e.g. an ad-hoc bare run with no drafted contract yet) and follow an\n1052\t    # operator steer directive when one was set at the HITL checkpoint.\n1053\t    almanac_harden_reviewer_prompt \"$target\" \"$lens\" \"$rubric_path\" \"$directive\" > \"$prompt_file\"\n1054\t\n1055\t    # Capture the worker pid via a file (not $(...)): worker_start backgrounds\n1056\t    # the agent as a child of THIS shell, so it stays waitable. A command\n1057\t    # substitution would reparent it into a subshell and break the wait.\n1058\t    pidfile=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-pid.XXXXXX\")\"\n1059\t    almanac_loop_worker_start \"$root\" \"$run_id\" \"$worker_id\" \\\n1060\t      \"$provider\" \"$model\" \"$effort\" \"read-only\" \"$prompt_file\" > \"$pidfile\"\n1061\t    pid=\"$(cat \"$pidfile\")\"\n1062\t    rm -f \"$pidfile\"\n1063\t\n1064\t    worker_ids+=(\"$worker_id\")\n1065\t    worker_pids+=(\"$pid\")\n1066\t    prompt_files+=(\"$prompt_file\")\n1067\t    _info \"  reviewer lens=$lens provider=$provider pid=$pid (read-only)\"\n1068\t  done\n1069\t\n1070\t  # Reviewers run concurrently; block until every one finishes.\n1071\t  for pid in \"${worker_pids[@]}\"; do\n1072\t    wait \"$pid\" 2>/dev/null || true\n1073\t  done\n1074\t\n1075\t  total_added=0\n1076\t  succeeded_count=0\n1077\t  i=0\n1078\t  for worker_id in \"${worker_ids[@]}\"; do\n1079\t    lens=\"${lenses[$i]}\"\n1080\t    i=$((i + 1))\n1081\t    status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n1082\t    result_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"result.txt\")\"\n1083\t\n1084\t    wstatus=\"\"\n1085\t    if [ -f \"$status_file\" ]; then\n1086\t      wstatus=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n1087\t    fi\n1088\t\n1089\t    if [ \"$wstatus\" != \"done\" ]; then\n1090\t      _warn \"reviewer lens=$lens failed or did not finish cleanly; skipping its findings\"\n1091\t      continue\n1092\t    fi\n1093\t    succeeded_count=$((succeeded_count + 1))\n1094\t\n1095\t    _info \"Findings (lens: $lens):\"\n1096\t    almanac_harden_format_findings \"$result_file\"\n1097\t\n1098\t    if [ -f \"$result_file\" ]; then\n1099\t      added=\"$(almanac_harden_ledger_record \"$ledger_path\" \"$result_file\" \"$round\")\"\n1100\t      total_added=$((total_added + added))\n1101\t    fi\n1102\t  done\n1103\t\n1104\t  [ \"${#prompt_files[@]}\" -eq 0 ] || rm -f \"${prompt_files[@]}\"\n1105\t\n1106\t  # Enforce the immutability invariant: revert (and warn about) any rubric edit\n1107\t  # an agent slipped in during the round.\n1108\t  if [ -n \"$rubric_snapshot\" ]; then\n1109\t    almanac_harden_rubric_verify \"$rubric_path\" \"$rubric_snapshot\" || true\n1110\t  fi\n1111\t\n1112\t  if [ \"$succeeded_count\" -eq 0 ]; then\n1113\t    _warn \"All reviewer workers failed; no reliable review result was produced.\"\n1114\t    return 1\n1115\t  fi\n1116\t\n1117\t  _success \"Aggregated $total_added new finding(s) into ${ledger_path#\"$root\"/}\"\n1118\t}\n1119\t\n1120\t# --- Single sequential fixer + feedback verdict --------------------------------\n1121\t#\n1122\t# After reviewers fan out and the conductor ratifies findings, ONE write-capable\n1123\t# fixer applies changes for the open blocking findings, in place, in the working\n1124\t# tree. v1 is deliberately a single sequential agent — no worktrees, no parallel\n1125\t# writers — so there is never a merge conflict to reconcile and any regression\n1126\t# test the fixer writes simply persists on disk. The fixer then runs the\n1127\t# project's feedback loops (shared detection + runner) and reports a verdict per\n1128\t# loop, so the objective half of \"bulletproof\" is enforced every round.\n1129\t\n1130\t# Build the prompt for the single sequential fixer. It receives the kill-list\n1131\t# (the open blocking findings) and the rubric bar, and is told to apply minimal\n1132\t# fixes AND leave a regression test per finding so the fix stays enforced. An\n1133\t# optional steering directive (4th arg) is embedded too, so a mid-run redirect at\n1134\t# the HITL checkpoint reaches the fixer. Exact wording is not asserted by tests by\n1135\t# design; that the fixer runs write-capable, its output persists, and it consumes\n1136\t# the steer directive is.\n1137\talmanac_harden_fixer_prompt() {\n1138\t  local target=\"$1\"\n1139\t  local findings_text=\"$2\"\n1140\t  local rubric_path=\"${3:-}\"\n1141\t  local directive=\"${4:-}\"\n1142\t  local rubric_bar=\"\"\n1143\t\n1144\t  if [ -n \"$rubric_path\" ] && [ -f \"$rubric_path\" ]; then\n1145\t    rubric_bar=\"$(almanac_harden_rubric_acceptance \"$rubric_path\")\"\n1146\t  fi\n1147\t\n1148\t  cat <<EOF\n1149\tYou are a single sequential fixer with write access to the repository. Apply the\n1150\tminimal changes that resolve every blocking finding below for the target. For\n1151\teach finding, add or update a regression test that fails before your fix and\n1152\tpasses after, so the defect cannot silently return.\n1153\t\n1154\tTarget: ${target}\n1155\t\n1156\tBlocking findings to fix:\n1157\t${findings_text}\n1158\tEOF\n1159\t\n1160\t  if [ -n \"$rubric_bar\" ]; then\n1161\t    cat <<EOF\n1162\t\n1163\tYour changes must satisfy this acceptance bar (the rubric contract):\n1164\t\n1165\t${rubric_bar}\n1166\tEOF\n1167\t  fi\n1168\t\n1169\t  if [ -n \"$directive\" ]; then\n1170\t    cat <<EOF\n1171\t\n1172\tThe operator steered this run with the directive below — apply it while you fix:\n1173\t\n1174\t${directive}\n1175\tEOF\n1176\t  fi\n1177\t\n1178\t  cat <<EOF\n1179\t\n1180\tDo not weaken, skip, or delete existing tests, and do not edit the rubric. Leave\n1181\tthe working tree building and the project's feedback loops (tests / typecheck /\n1182\tlint) green.\n1183\tEOF\n1184\t}\n1185\t\n1186\t# Run the single sequential fixer over the target's open blocking findings, then\n1187\t# run the project's feedback loops and report a pass/fail verdict per loop.\n1188\t#\n1189\t# One agent, write-capable (sandbox=workspace-write, NOT read-only), in place: no\n1190\t# worktree, so any regression tests it generates persist in the repo after the\n1191\t# run. Sequential by construction — a single foreground agent call — so there are\n1192\t# never concurrent writers. The fixer's agent call is bracketed by the rubric\n1193\t# immutability guard (snapshot before, verify after) so a write-capable fixer\n1194\t# cannot move the goalposts mid-run; legitimate rubric growth happens earlier, in\n1195\t# ratification, outside this bracket. On a clean fixer exit every open blocking\n1196\t# finding is marked `fixed` in the ledger; the next round's reviewers/ratify\n1197\t# reopen anything that still reproduces, so a still-broken finding cannot be\n1198\t# silently closed. A no-op (prints a note, returns 0) when there are no open\n1199\t# blocking findings. Returns the provider's exit code on a fixer failure, leaving\n1200\t# the findings open.\n1201\t#\n1202\t# The objective feedback gate is NOT run here: the convergence loop runs it once\n1203\t# per round (almanac_harden_round) so feedback executes every round even when\n1204\t# there is nothing to fix, and the gate reads a fresh verdict. The standalone\n1205\t# `--fix` CLI path runs almanac_harden_report_feedback explicitly afterwards.\n1206\talmanac_harden_fix() {\n1207\t  local root=\"$1\"\n1208\t  local target=\"$2\"\n1209\t  local round=\"${3:-1}\"\n1210\t  local directive=\"${4:-}\"\n1211\t  local target_path ledger_path rubric_path open findings_text count\n1212\t  local provider model effort prompt_file result_file events_file rubric_snapshot rc\n1213\t  local id lens severity location claim demonstration\n1214\t\n1215\t  case \"$target\" in\n1216\t    /*) target_path=\"$target\" ;;\n1217\t    *)  target_path=\"$root/$target\" ;;\n1218\t  esac\n1219\t\n1220\t  if [ ! -e \"$target_path\" ]; then\n1221\t    _die \"Harden target not found: $target\"\n1222\t  fi\n1223\t\n1224\t  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n1225\t  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n1226\t\n1227\t  open=\"$(almanac_harden_ledger_open_blocking \"$ledger_path\")\"\n1228\t  if [ -z \"$open\" ]; then\n1229\t    _info \"No open blocking findings to fix.\"\n1230\t    return 0\n1231\t  fi\n1232\t\n1233\t  count=\"$(printf '%s\\n' \"$open\" | grep -c .)\"\n1234\t\n1235\t  # Render the kill-list into the fixer prompt's findings block.\n1236\t  findings_text=\"$(\n1237\t    while IFS=$'\\t' read -r id lens severity location claim demonstration; do\n1238\t      [ -n \"$id\" ] || continue\n1239\t      printf -- '- [%s] %s: %s (at %s)\\n    demo: %s\\n' \\\n1240\t        \"${severity:-?}\" \"${lens:-?}\" \"${claim:-?}\" \"${location:-?}\" \"${demonstration:-?}\"\n1241\t    done <<INNER\n1242\t$open\n1243\tINNER\n1244\t  )\"\n1245\t\n1246\t  provider=\"$(almanac_harden_role_field \"fixer\" \"provider\")\"\n1247\t  model=\"$(almanac_harden_role_field \"fixer\" \"model\")\"\n1248\t  effort=\"$(almanac_harden_role_field \"fixer\" \"effort\")\"\n1249\t\n1250\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-prompt.XXXXXX\")\"\n1251\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-result.XXXXXX\")\"\n1252\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-events.XXXXXX\")\"\n1253\t  almanac_harden_fixer_prompt \"$target\" \"$findings_text\" \"$rubric_path\" \"$directive\" > \"$prompt_file\"\n1254\t\n1255\t  # The rubric is immutable to agents during a run. The fixer is write-capable,\n1256\t  # so bracket its agent call: snapshot before, verify (revert + warn) after.\n1257\t  rubric_snapshot=\"\"\n1258\t  if [ -f \"$rubric_path\" ]; then\n1259\t    rubric_snapshot=\"$(almanac_harden_rubric_snapshot \"$rubric_path\")\" || rubric_snapshot=\"\"\n1260\t  fi\n1261\t\n1262\t  _info \"Fixing $count open blocking finding(s) with one sequential fixer (provider=$provider, write-capable)\"\n1263\t\n1264\t  rc=0\n1265\t  almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"workspace-write\" \\\n1266\t    \"$prompt_file\" \"$result_file\" \"$events_file\" >/dev/null || rc=$?\n1267\t\n1268\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n1269\t\n1270\t  if [ -n \"$rubric_snapshot\" ]; then\n1271\t    almanac_harden_rubric_verify \"$rubric_path\" \"$rubric_snapshot\" || true\n1272\t  fi\n1273\t\n1274\t  if [ \"$rc\" -ne 0 ]; then\n1275\t    _warn \"Fixer failed (exit $rc); blocking findings remain open.\"\n1276\t    return \"$rc\"\n1277\t  fi\n1278\t\n1279\t  # The single fixer addresses the whole kill-list; mark all open blocking\n1280\t  # findings fixed in one ledger rewrite. A finding that still reproduces is\n1281\t  # reopened next round.\n1282\t  printf '%s\\n' \"$open\" | awk -F '\\t' '$1 != \"\" { print $1 }' \\\n1283\t    | almanac_harden_ledger_set_status_many \"$ledger_path\" \"fixed\" \\\n1284\t      \"fixed by sequential fixer at round $round\"\n1285\t\n1286\t  _success \"Applied fixes for $count finding(s); regenerated tests persist in the working tree.\"\n1287\t}\n1288\t\n1289\t# Run the project's feedback loops via the shared runner and print a pass/fail\n1290\t# verdict per loop. Returns the runner's aggregate (0 = all green, non-zero =\n1291\t# any failed) so a caller (the convergence gate, later) can act on it.\n1292\talmanac_harden_report_feedback() {\n1293\t  local root=\"$1\"\n1294\t  local verdicts cmd verdict rc\n1295\t\n1296\t  _info \"Running project feedback loops:\"\n1297\t\n1298\t  rc=0\n1299\t  verdicts=\"$(almanac_loop_feedback_run \"$root\")\" || rc=$?\n1300\t\n1301\t  if [ -z \"$verdicts\" ]; then\n1302\t    _info \"  (no feedback loops detected)\"\n1303\t    return 0\n1304\t  fi\n1305\t\n1306\t  while IFS=$'\\t' read -r cmd verdict; do\n1307\t    [ -n \"$cmd\" ] || continue\n1308\t    if [ \"$verdict\" = \"pass\" ]; then\n1309\t      _success \"  PASS  $cmd\"\n1310\t    else\n1311\t      _warn \"  FAIL  $cmd\"\n1312\t    fi\n1313\t  done <<INNER\n1314\t$verdicts\n1315\tINNER\n1316\t\n1317\t  return \"$rc\"\n1318\t}\n1319\t\n1320\t# --- Convergence loop + gate ---------------------------------------------------\n1321\t#\n1322\t# A round is the full hardening pass over one target: fan out reviewers, ratify\n1323\t# their findings by execution, fix the blocking ones, and run the project's\n1324\t# feedback loops. The convergence loop repeats rounds until the gate says stop:\n1325\t# it converges when the acceptance bar is met AND no open blocking findings\n1326\t# remain, gives up with a clear NON-CONVERGED status when the round budget is\n1327\t# hit, and otherwise checks in with the human (ship vs. continue) between rounds.\n1328\t# Because the gate only ever exits on convergence or the budget, the loop always\n1329\t# terminates — a pathological target cannot run forever.\n1330\t\n1331\t# Pure convergence predicate. Given the round's state, decide what the loop does\n1332\t# next. No I/O, no side effects (besides echoing the verdict) so it is trivially\n1333\t# unit-testable across the whole input space:\n1334\t#\n1335\t#   acceptance_met  1 = every acceptance criterion is met, else 0\n1336\t#   open_blocking   count of open blocking findings still remaining\n1337\t#   round           the round that just finished (1-based)\n1338\t#   budget          the hard round cap (>= 1)\n1339\t#\n1340\t# Echoes one verdict and returns a distinct code so a caller can branch on either:\n1341\t#   converged      (return 0) acceptance met AND zero open blocking — exit success\n1342\t#   non-converged  (return 2) budget reached without convergence — exit failure\n1343\t#   continue       (return 1) neither — run another round"}]},"parent_tool_use_id":null,"session_id":"2b9bb146-1d8c-4ac2-bc65-549f8194c6ce","uuid":"f0e245cc-c10c-4734-8986-5d8cd47c6f95","timestamp":"2026-05-27T07:55:58.654Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/harden-core.sh","content":"#!/usr/bin/env bash\n# harden-core.sh - Harden loop rubric bootstrap + reviewer helpers\n\n# loop-core.sh (the old shared-engine barrel) is deleted; harden-core sources the\n# focused modules it actually uses, each directly and idempotently so it works\n# both through bin/almanac and when a test sources this file directly. core.sh\n# is sourced literally (it owns the helper); the other deps go through\n# _almanac_source_sibling so the boilerplate stays minimal.\nif ! declare -F _error >/dev/null 2>&1; then\n  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/core.sh\n  source \"$__harden_core_dir/core.sh\"\n  unset __harden_core_dir\nfi\n\n# Explicit deps (each declared module is the contract surface this file consumes;\n# transitive availability is not relied on).\n_almanac_source_sibling agent.sh    almanac_loop_agent_capture   # agent run shapes (ratify/fixer)\n_almanac_source_sibling run.sh      almanac_loop_register_run    # run registry + worker paths/health\n_almanac_source_sibling worker.sh   almanac_loop_worker_start    # worker orchestration (reviewer/fixer fan-out)\n_almanac_source_sibling ui.sh       almanac_loop_ui_render       # gum-or-plain dashboard seam\n_almanac_source_sibling role.sh     almanac_loop_role_config     # per-role provider/model/effort resolution\n_almanac_source_sibling feedback.sh almanac_loop_feedback_run    # objective fixer gate\n\n# --- Role config (per-role provider / model / effort) --------------------------\n#\n# Each harden role selects its own agent config:\n#   conductor - judges/ratifies findings and declares convergence\n#   reviewer  - one read-only reviewer per lens (lens -> provider map)\n#   fixer     - the single sequential write-capable fixer\n#\n# Resolution layers, most specific first, via the shared loop resolver:\n#   provider: HARDEN_<ROLE>[_<LENS>]_PROVIDER -> HARDEN_<ROLE>_PROVIDER\n#             -> HARDEN_PROVIDER -> claude (sensible default: Claude plays every role)\n#   model:    HARDEN_<ROLE>[_<LENS>]_MODEL    -> HARDEN_<ROLE>_MODEL\n#             -> HARDEN_MODEL -> \"\" (the provider's own default)\n#   effort:   HARDEN_<ROLE>[_<LENS>]_EFFORT   -> HARDEN_<ROLE>_EFFORT\n#             -> HARDEN_EFFORT -> \"\" (the provider's own default)\n#\n# Only reviewers consult the lens, so providers can be mixed across lenses in one\n# round; conductor and fixer are single-instance and ignore it. Resolution reads\n# ONLY HARDEN_* (and the shared loop env) — never any host marker — so the tuple\n# is identical whether the run was launched from Claude Code or Codex. Emits three\n# TSV rows (provider/model/effort); returns 2 on an unknown role.\nalmanac_harden_role() {\n  local role=\"$1\"\n  local lens=\"${2:-}\"\n\n  case \"$role\" in\n    reviewer) ;;                 # reviewers map lens -> provider\n    conductor | fixer) lens=\"\" ;; # single-instance roles ignore the lens\n    *) return 2 ;;\n  esac\n\n  almanac_loop_role_config \"harden\" \"$role\" \"$lens\" \"$(almanac_provider_default)\" \"\" \"\"\n}\n\n# One field (provider | model | effort) of a harden role's resolved config, for\n# call sites that need a single value. Thin reader over almanac_harden_role so\n# harden's per-role defaults stay defined in exactly one place.\nalmanac_harden_role_field() {\n  local role=\"$1\"\n  local field=\"$2\"\n  local lens=\"${3:-}\"\n\n  almanac_harden_role \"$role\" \"$lens\" | almanac_loop_role_tsv_field \"$field\"\n}\n\nalmanac_harden_rubric_path() {\n  local root=\"$1\"\n  local target=\"$2\"\n  local slug\n\n  slug=\"$(almanac_loop_slug \"$target\")\"\n  printf '%s/rubric.md\\n' \"$(almanac_loop_plan_dir harden \"$root\" \"$slug\")\"\n}\n\nalmanac_harden_write_rubric() {\n  local root=\"$1\"\n  local target=\"$2\"\n  local goal=\"$3\"\n  local path dir\n\n  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n  dir=\"$(dirname \"$path\")\"\n\n  if [ -e \"$path\" ]; then\n    return 2\n  fi\n\n  mkdir -p \"$dir\"\n  cat > \"$path\" <<EOF\n# Harden Rubric\n\nTarget: $target\nStatus: draft\n\n## Goal\n\n$goal\n\n## Acceptance\n\n- [ ] Target behavior satisfies the stated goal.\n- [ ] Blocking findings include a failing test, breaking input, or cited acceptance violation.\n- [ ] Project feedback loops pass after fixes.\n\n## In Scope\n\n- $target\n\n## Out of Scope\n\n- Add non-goals here before running reviewers.\n\n## Severity\n\nBlocking findings must be falsifiable and reproducible against the current target.\nSubjective or unreproducible findings are non-blocking notes.\n\n## Context\n\n- Add intentional decisions and false-positive preemptions here before running reviewers.\nEOF\n}\n\nalmanac_harden_approve_rubric() {\n  local root=\"$1\"\n  local target=\"$2\"\n  local path approved_at tmp\n\n  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n\n  if [ ! -f \"$path\" ]; then\n    return 2\n  fi\n\n  if grep -Eq '^Status: approved$' \"$path\"; then\n    return 3\n  fi\n\n  approved_at=\"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\"\n  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n\n  if grep -Eq '^Status: draft$' \"$path\"; then\n    awk -v approved_at=\"$approved_at\" '\n      /^Status: draft$/ && !replaced {\n        print \"Status: approved\"\n        replaced = 1\n        next\n      }\n      { print }\n      END {\n        print \"\"\n        print \"## Approval\"\n        print \"\"\n        print \"Approved: \" approved_at\n      }\n    ' \"$path\" > \"$tmp\"\n  else\n    awk -v approved_at=\"$approved_at\" '\n      /^Target: / && !inserted {\n        print\n        print \"Status: approved\"\n        inserted = 1\n        next\n      }\n      { print }\n      END {\n        if (!inserted) {\n          print \"Status: approved\"\n        }\n        print \"\"\n        print \"## Approval\"\n        print \"\"\n        print \"Approved: \" approved_at\n      }\n    ' \"$path\" > \"$tmp\"\n  fi\n\n  mv \"$tmp\" \"$path\"\n}\n\n# Return 0 when the rubric is approved (locked), non-zero otherwise — including\n# when it is still a draft or the file is absent. Pure read; the loop gates on\n# this so reviewers never run against a half-authored bar.\nalmanac_harden_rubric_approved() {\n  local rubric_path=\"$1\"\n\n  [ -f \"$rubric_path\" ] || return 1\n  grep -Eq '^Status: approved$' \"$rubric_path\"\n}\n\n# Emit the rubric's acceptance criteria — the bar reviewers and ratification work\n# against. Prints every bullet line under the `## Acceptance` heading up to the\n# next `## ` section. Empty when the rubric or section is absent. Pure read.\nalmanac_harden_rubric_acceptance() {\n  local path=\"$1\"\n\n  [ -f \"$path\" ] || return 0\n\n  awk '\n    /^## Acceptance[[:space:]]*$/ { in_acc = 1; next }\n    in_acc && /^## / { in_acc = 0 }\n    in_acc && /^- / { print }\n  ' \"$path\"\n}\n\n# Append one acceptance criterion to the rubric's `## Acceptance` section. This is\n# how a ratified finding grows the bar: monotonic (criteria are only added), visible\n# (a clean diff), and append-only. The new `- [ ] <criterion>` lands at the end of\n# the Acceptance block, before the next section. Idempotent: an identical criterion\n# is never re-added (returns 1, writes nothing) so re-ratifying a reopened finding\n# cannot duplicate it. Returns 2 when the rubric or its Acceptance section is absent.\nalmanac_harden_rubric_append_criterion() {\n  local path=\"$1\"\n  local criterion=\"$2\"\n  local tmp\n\n  [ -f \"$path\" ] || return 2\n  grep -q '^## Acceptance[[:space:]]*$' \"$path\" || return 2\n\n  if grep -Fxq -- \"- [ ] $criterion\" \"$path\" || \\\n      grep -Fxq -- \"- [x] $criterion\" \"$path\"; then\n    return 1\n  fi\n\n  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n  awk -v crit=\"$criterion\" '\n    /^## Acceptance[[:space:]]*$/ { print; in_acc = 1; next }\n    in_acc && /^## / {\n      print \"- [ ] \" crit\n      inserted = 1\n      in_acc = 0\n      for (i = 1; i <= nb; i++) print blanks[i]\n      nb = 0\n      print\n      next\n    }\n    in_acc && /^[[:space:]]*$/ { nb++; blanks[nb] = $0; next }\n    in_acc {\n      for (i = 1; i <= nb; i++) print blanks[i]\n      nb = 0\n      print\n      next\n    }\n    { print }\n    END {\n      if (in_acc && !inserted) {\n        print \"- [ ] \" crit\n        for (i = 1; i <= nb; i++) print blanks[i]\n      }\n    }\n  ' \"$path\" > \"$tmp\"\n  mv \"$tmp\" \"$path\"\n}\n\n# --- Rubric immutability guard -------------------------------------------------\n#\n# The rubric is the contract, and during a run it is immutable to agents: the\n# goalposts move only by a deliberate human act (the developer editing the file\n# between runs / approving it) or the conductor's controlled append at\n# ratification (almanac_harden_rubric_append_criterion — a visible, monotonic\n# diff that runs OUTSIDE the reviewer/fixer phase). Reviewers run read-only and\n# cannot write the rubric; the fixer (later slice) has write access and could.\n# These two helpers bracket an agent phase — snapshot before, verify after — and\n# revert any agent edit, so a stray agent write during a run cannot lower the bar.\n\n# Snapshot the rubric to a protected temp copy and echo the snapshot path so the\n# caller can pass it to almanac_harden_rubric_verify. Returns 2 (echoes nothing)\n# when no rubric exists — an ad-hoc bare run with no drafted contract has nothing\n# to guard.\nalmanac_harden_rubric_snapshot() {\n  local rubric_path=\"$1\"\n  local snap\n\n  [ -f \"$rubric_path\" ] || return 2\n\n  snap=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-rubric-lock.XXXXXX\")\"\n  cp \"$rubric_path\" \"$snap\"\n  printf '%s\\n' \"$snap\"\n}\n\n# Verify the rubric is byte-identical to its snapshot; if an agent modified it\n# during the guarded phase, revert it and warn (the contract is immutable to\n# agents). Discards the snapshot either way. Returns 1 when a modification was\n# reverted, 0 when unchanged, 2 when the snapshot is missing.\nalmanac_harden_rubric_verify() {\n  local rubric_path=\"$1\"\n  local snap=\"$2\"\n\n  [ -n \"$snap\" ] && [ -f \"$snap\" ] || return 2\n\n  if ! cmp -s \"$rubric_path\" \"$snap\"; then\n    cp \"$snap\" \"$rubric_path\"\n    rm -f \"$snap\"\n    _warn \"Rubric was modified during the run; reverted (contract is immutable to agents — amend it directly between runs).\"\n    return 1\n  fi\n\n  rm -f \"$snap\"\n  return 0\n}\n\n# Emit the configured reviewer lens set, one lens per line. Defaults to the five\n# PRD lenses; override at runtime via HARDEN_LENSES (comma- or whitespace-\n# separated).\nalmanac_harden_lenses() {\n  local raw=\"${HARDEN_LENSES:-correctness security perf edge-cases contracts}\"\n\n  # Trailing newline matters: a `read` loop consumer drops a final line that\n  # lacks one, which would silently swallow the last lens.\n  printf '%s\\n' \"$raw\" | tr -s ', \\t' '\\n' | sed '/^$/d'\n}\n\nalmanac_harden_max_reviewers() {\n  printf '%s\\n' \"${HARDEN_MAX_REVIEWERS:-16}\"\n}\n\n# Build the fixed prompt for one read-only reviewer over a target, including the\n# JSON-Lines findings schema. When a rubric path is given and exists, the rubric's\n# acceptance criteria are embedded as the bar the reviewer judges against, so\n# reviewers consume the contract rather than an implicit standard. An optional\n# steering directive (4th arg) is embedded too, so an operator who redirects the\n# run at the HITL checkpoint (e.g. \"focus on the auth module\") reaches the\n# reviewers on the next round. Kept separate so the schema can grow without\n# touching orchestration. (Exact prompt wording is not asserted in tests by\n# design; that the rubric bar and the steer directive are consumed is.)\nalmanac_harden_reviewer_prompt() {\n  local target=\"$1\"\n  local lens=\"${2:-correctness}\"\n  local rubric_path=\"${3:-}\"\n  local directive=\"${4:-}\"\n  local rubric_bar=\"\"\n\n  if [ -n \"$rubric_path\" ] && [ -f \"$rubric_path\" ]; then\n    rubric_bar=\"$(almanac_harden_rubric_acceptance \"$rubric_path\")\"\n  fi\n\n  cat <<EOF\nYou are a read-only code reviewer. Lens: ${lens}.\n\nReview the target below for ${lens} defects only. You cannot modify any files;\nthis is a read-only review.\n\nTarget: ${target}\nEOF\n\n  if [ -n \"$rubric_bar\" ]; then\n    cat <<EOF\n\nJudge the target against this acceptance bar (the rubric contract). A finding is\nonly blocking if it violates a criterion below or demonstrably breaks behavior:\n\n${rubric_bar}\nEOF\n  fi\n\n  if [ -n \"$directive\" ]; then\n    cat <<EOF\n\nThe operator steered this run with the directive below — follow it and prioritize\nthe findings it points you toward:\n\n${directive}\nEOF\n  fi\n\n  cat <<EOF\n\nReport each defect as one JSON object per line (JSON Lines) and output nothing\nelse — no prose, no markdown fences. Each object must use this schema:\n\n{\"lens\":\"${lens}\",\"severity\":\"high|medium|low\",\"location\":\"<file:line or symbol>\",\"claim\":\"<one-line defect>\",\"demonstration\":\"<failing test, breaking input, or cited rubric criterion>\"}\n\nOnly report a defect you can demonstrate with a failing test, a specific breaking\ninput, or a cited criterion. If you find no demonstrable defects, output nothing.\nEOF\n}\n\n# Normalize the reviewer's JSON-Lines result into TSV rows\n# (lens, severity, location, claim, demonstration). Malformed lines are dropped\n# cleanly. Prefers jq; falls back to a flat-field awk extractor when jq is absent\n# so harden keeps almanac's near-zero-dependency promise.\nalmanac_harden_findings_tsv() {\n  local result_file=\"$1\"\n\n  [ -f \"$result_file\" ] || return 0\n\n  if command -v jq >/dev/null 2>&1; then\n    jq -Rr '\n      fromjson?\n      | select(type == \"object\")\n      | {\n          lens: (.lens // \"\"),\n          severity: (.severity // \"\"),\n          location: (.location // \"\"),\n          claim: (.claim // \"\"),\n          demonstration: (.demonstration // \"\")\n        }\n      | select(\n          (.lens | type == \"string\" and length > 0) and\n          (.severity | type == \"string\" and length > 0) and\n          (.location | type == \"string\" and length > 0) and\n          (.claim | type == \"string\" and length > 0) and\n          (.demonstration | type == \"string\" and length > 0)\n        )\n      | [.lens, .severity, .location, .claim, .demonstration]\n      | @tsv\n    ' \"$result_file\" 2>/dev/null\n    return 0\n  fi\n\n  awk '\n    function field(line, key,   v) {\n      v = line\n      if (v ~ (\"\\\"\" key \"\\\"[ \\t]*:[ \\t]*\\\"\")) {\n        sub(\".*\\\"\" key \"\\\"[ \\t]*:[ \\t]*\\\"\", \"\", v)\n        sub(\"\\\".*\", \"\", v)\n        return v\n      }\n      return \"\"\n    }\n    /\"claim\"[ \\t]*:/ {\n      lens = field($0, \"lens\")\n      severity = field($0, \"severity\")\n      location = field($0, \"location\")\n      claim = field($0, \"claim\")\n      demonstration = field($0, \"demonstration\")\n      if (lens != \"\" && severity != \"\" && location != \"\" && claim != \"\" && demonstration != \"\") {\n        printf \"%s\\t%s\\t%s\\t%s\\t%s\\n\", lens, severity, location, claim, demonstration\n      }\n    }\n  ' \"$result_file\"\n}\n\n# Print parsed findings as a readable list. Reports \"No findings reported.\" when\n# the reviewer returned nothing parseable.\nalmanac_harden_format_findings() {\n  local result_file=\"$1\"\n  local lens severity location claim demonstration count\n\n  count=0\n  while IFS=$'\\t' read -r lens severity location claim demonstration; do\n    [ -n \"${lens}${severity}${location}${claim}${demonstration}\" ] || continue\n    printf -- '- [%s] %s: %s\\n' \"${severity:-?}\" \"${lens:-?}\" \"${claim:-?}\"\n    [ -n \"$location\" ] && printf '    where: %s\\n' \"$location\"\n    [ -n \"$demonstration\" ] && printf '    demo:  %s\\n' \"$demonstration\"\n    count=$((count + 1))\n  done < <(almanac_harden_findings_tsv \"$result_file\")\n\n  if [ \"$count\" -eq 0 ]; then\n    printf '%s\\n' \"No findings reported.\"\n  fi\n}\n\n# --- Findings ledger -----------------------------------------------------------\n#\n# Canonical finding schema (one JSON object per reviewer line, see the reviewer\n# prompt above): lens, severity, location, claim, demonstration. The ledger adds\n# three adjudication fields when a finding is recorded:\n#   id            - deterministic fingerprint of (lens, location, claim)\n#   status        - open | fixed | rejected-subjective | wontfix-per-context\n#   round         - the review round that first raised the finding\n#   adjudication  - free-text note (why rejected / how fixed); empty when open\n#\n# Findings persist append-only to findings.md next to the target's rubric.md.\n# Each finding is one markdown section keyed by its id, so the file is both\n# human-readable and re-parseable (dedupe + open-blocking query read it back).\n\nalmanac_harden_ledger_path() {\n  local root=\"$1\"\n  local target=\"$2\"\n  local slug\n\n  slug=\"$(almanac_loop_slug \"$target\")\"\n  printf '%s/findings.md\\n' \"$(almanac_loop_plan_dir harden \"$root\" \"$slug\")\"\n}\n\n# Deterministic finding identity. Two reviewer reports of the same defect\n# (same lens, same place, same claim) collapse to one id so re-raising a\n# finding never re-adds it. Demonstration is deliberately excluded: a reworded\n# repro must not look like a new finding. cksum keeps this dependency-free.\nalmanac_harden_finding_id() {\n  local lens=\"$1\"\n  local location=\"$2\"\n  local claim=\"$3\"\n  local sum\n\n  sum=\"$(printf '%s\\037%s\\037%s' \"$lens\" \"$location\" \"$claim\" | cksum | awk '{print $1}')\"\n  printf 'f-%s\\n' \"$sum\"\n}\n\nalmanac_harden_ledger_init() {\n  local path=\"$1\"\n  local dir\n\n  dir=\"$(dirname \"$path\")\"\n  mkdir -p \"$dir\"\n\n  if [ ! -f \"$path\" ]; then\n    {\n      printf '%s\\n\\n' \"# Findings Ledger\"\n      printf '%s\\n' \"<!-- Append-only finding records managed by 'almanac harden'. One section per finding. -->\"\n    } > \"$path\"\n  fi\n}\n\n# True when the ledger already holds a finding with this id.\nalmanac_harden_ledger_has() {\n  local path=\"$1\"\n  local id=\"$2\"\n\n  [ -f \"$path\" ] || return 1\n  grep -Fxq -- \"## $id\" \"$path\"\n}\n\n# Append one finding section. Returns 1 (and writes nothing) when the id is\n# already present, so callers can count genuinely-new findings. Creates the\n# ledger file with its header on first write.\nalmanac_harden_ledger_append_entry() {\n  [ \"$#\" -ge 7 ] || return 2\n\n  local path=\"$1\"\n  local id=\"$2\"\n  local lens=\"$3\"\n  local severity=\"$4\"\n  local location=\"$5\"\n  local claim=\"$6\"\n  local demonstration=\"$7\"\n  local status=\"${8:-open}\"\n  local round=\"${9:-1}\"\n  local adjudication=\"${10:-}\"\n\n  almanac_harden_ledger_init \"$path\"\n\n  if almanac_harden_ledger_has \"$path\" \"$id\"; then\n    return 1\n  fi\n\n  almanac_harden_ledger_append_entry_unchecked \\\n    \"$path\" \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \\\n    \"$demonstration\" \"$status\" \"$round\" \"$adjudication\"\n}\n\n# Append one already-deduped finding section. Callers must have initialised the\n# ledger and decided the id is new; this keeps bulk ingestion from grepping the\n# growing ledger once per finding.\nalmanac_harden_ledger_append_entry_unchecked() {\n  [ \"$#\" -ge 7 ] || return 2\n\n  local path=\"$1\"\n  local id=\"$2\"\n  local lens=\"$3\"\n  local severity=\"$4\"\n  local location=\"$5\"\n  local claim=\"$6\"\n  local demonstration=\"$7\"\n  local status=\"${8:-open}\"\n  local round=\"${9:-1}\"\n  local adjudication=\"${10:-}\"\n\n  {\n    printf '\\n## %s\\n\\n' \"$id\"\n    printf -- '- lens: %s\\n' \"$lens\"\n    printf -- '- severity: %s\\n' \"$severity\"\n    printf -- '- location: %s\\n' \"$location\"\n    printf -- '- claim: %s\\n' \"$claim\"\n    printf -- '- demonstration: %s\\n' \"$demonstration\"\n    printf -- '- status: %s\\n' \"$status\"\n    printf -- '- round: %s\\n' \"$round\"\n    printf -- '- adjudication: %s\\n' \"$adjudication\"\n  } >> \"$path\"\n}\n\n# Normalize a reviewer's JSON-Lines result into ledger-entry TSV rows\n# (id, lens, severity, location, claim, demonstration, status, round,\n# adjudication). New findings are status=open with an empty adjudication.\n# Malformed reviewer lines are dropped cleanly (via almanac_harden_findings_tsv).\nalmanac_harden_parse_findings() {\n  local result_file=\"$1\"\n  local round=\"${2:-1}\"\n  local lens severity location claim demonstration id\n\n  while IFS=$'\\t' read -r lens severity location claim demonstration; do\n    [ -n \"${lens}${severity}${location}${claim}${demonstration}\" ] || continue\n    id=\"$(almanac_harden_finding_id \"$lens\" \"$location\" \"$claim\")\"\n    printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \\\n      \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \"$demonstration\" \"open\" \"$round\" \"\"\n  done < <(almanac_harden_findings_tsv \"$result_file\")\n}\n\n# Parse a reviewer result and append each new finding to the ledger, deduping\n# against everything already adjudicated. Prints the count of findings actually\n# added (duplicates do not count).\nalmanac_harden_ledger_record() {\n  local path=\"$1\"\n  local result_file=\"$2\"\n  local round=\"${3:-1}\"\n  local parsed statuses actions reopen_ids action\n  local id lens severity location claim demonstration status r adjudication\n  local added=0\n\n  almanac_harden_ledger_init \"$path\"\n\n  parsed=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-findings.XXXXXX\")\"\n  statuses=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-statuses.XXXXXX\")\"\n  actions=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-actions.XXXXXX\")\"\n  reopen_ids=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-reopen.XXXXXX\")\"\n\n  almanac_harden_parse_findings \"$result_file\" \"$round\" > \"$parsed\"\n\n  awk '\n    /^## / { id = substr($0, 4); next }\n    /^- status:/ && id != \"\" {\n      val = $0\n      sub(/^- status:[ \\t]*/, \"\", val)\n      print id \"\\t\" val\n    }\n  ' \"$path\" > \"$statuses\"\n\n  awk '\n    BEGIN { FS = \"\\t\" }\n    FILENAME == ARGV[1] { existing[$1] = $2; next }\n    $1 == \"\" { next }\n    seen[$1]++ { next }\n    !($1 in existing) {\n      print \"append\\t\" $0\n      next\n    }\n    existing[$1] == \"fixed\" {\n      print \"reopen\\t\" $0\n      next\n    }\n  ' \"$statuses\" \"$parsed\" > \"$actions\"\n\n  while IFS=$'\\t' read -r action id lens severity location claim demonstration status r adjudication; do\n    [ -n \"$id\" ] || continue\n    case \"$action\" in\n      append)\n        almanac_harden_ledger_append_entry_unchecked \\\n          \"$path\" \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \\\n          \"$demonstration\" \"$status\" \"$r\" \"$adjudication\"\n        added=$((added + 1))\n        ;;\n      reopen)\n        printf '%s\\n' \"$id\" >> \"$reopen_ids\"\n        ;;\n    esac\n  done < \"$actions\"\n\n  if [ -s \"$reopen_ids\" ]; then\n    almanac_harden_ledger_set_status_many \"$path\" \"open\" \\\n      \"re-raised by reviewer at round $round; pending ratification\" < \"$reopen_ids\"\n  fi\n\n  rm -f \"$parsed\" \"$statuses\" \"$actions\" \"$reopen_ids\"\n\n  printf '%s\\n' \"$added\"\n}\n\n# Emit the open blocking findings as TSV rows\n# (id, lens, severity, location, claim, demonstration). Only status=open\n# entries qualify; fixed / rejected-subjective / wontfix-per-context never gate.\nalmanac_harden_ledger_open_blocking() {\n  local path=\"$1\"\n\n  [ -f \"$path\" ] || return 0\n\n  awk '\n    function flush() {\n      if (id != \"\" && status == \"open\") {\n        printf \"%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n\", id, lens, severity, location, claim, demonstration\n      }\n    }\n    /^## / {\n      flush()\n      id = substr($0, 4)\n      lens = \"\"; severity = \"\"; location = \"\"; claim = \"\"; demonstration = \"\"; status = \"\"\n      next\n    }\n    /^- / {\n      line = substr($0, 3)\n      p = index(line, \":\")\n      if (p == 0) next\n      key = substr(line, 1, p - 1)\n      val = substr(line, p + 1)\n      sub(/^ /, \"\", val)\n      if (key == \"lens\") lens = val\n      else if (key == \"severity\") severity = val\n      else if (key == \"location\") location = val\n      else if (key == \"claim\") claim = val\n      else if (key == \"demonstration\") demonstration = val\n      else if (key == \"status\") status = val\n    }\n    END { flush() }\n  ' \"$path\"\n}\n\n# Print the recorded status of the finding with this id (empty when the id is\n# not in the ledger). Used by ratification to tell new from already-adjudicated.\nalmanac_harden_ledger_status() {\n  local path=\"$1\"\n  local id=\"$2\"\n\n  [ -f \"$path\" ] || return 0\n\n  awk -v want=\"$id\" '\n    /^## / { cur = substr($0, 4); next }\n    /^- status:/ && cur == want {\n      val = $0\n      sub(/^- status:[ \\t]*/, \"\", val)\n      print val\n      exit\n    }\n  ' \"$path\"\n}\n\n# Rewrite the status (and adjudication note) of the finding with this id in\n# place, leaving every other field and finding untouched. Returns 1 when the\n# ledger file is absent.\nalmanac_harden_ledger_set_status() {\n  local path=\"$1\"\n  local id=\"$2\"\n  local status=\"$3\"\n  local adjudication=\"${4:-}\"\n  local tmp\n\n  [ -f \"$path\" ] || return 1\n\n  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n  awk -v want=\"$id\" -v status=\"$status\" -v adj=\"$adjudication\" '\n    /^## / { cur = substr($0, 4); print; next }\n    cur == want && /^- status:/ { print \"- status: \" status; next }\n    cur == want && /^- adjudication:/ { print \"- adjudication: \" adj; next }\n    { print }\n  ' \"$path\" > \"$tmp\"\n  mv \"$tmp\" \"$path\"\n}\n\n# Rewrite status/adjudication for many finding ids in one ledger pass. Reads ids\n# from stdin, one per line. Used after a batch fix so marking N findings fixed is\n# O(ledger) instead of N full ledger rewrites.\nalmanac_harden_ledger_set_status_many() {\n  local path=\"$1\"\n  local status=\"$2\"\n  local adjudication=\"${3:-}\"\n  local ids tmp\n\n  [ -f \"$path\" ] || return 1\n\n  ids=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ids.XXXXXX\")\"\n  cat > \"$ids\"\n  [ -s \"$ids\" ] || { rm -f \"$ids\"; return 0; }\n\n  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n  awk -v ids=\"$ids\" -v status=\"$status\" -v adj=\"$adjudication\" '\n    BEGIN {\n      while ((getline line < ids) > 0) {\n        if (line != \"\") wanted[line] = 1\n      }\n      close(ids)\n    }\n    /^## / { cur = substr($0, 4); print; next }\n    (cur in wanted) && /^- status:/ { print \"- status: \" status; next }\n    (cur in wanted) && /^- adjudication:/ { print \"- adjudication: \" adj; next }\n    { print }\n  ' \"$path\" > \"$tmp\"\n  mv \"$tmp\" \"$path\"\n  rm -f \"$ids\"\n}\n\n# --- Ratification engine -------------------------------------------------------\n#\n# A finding is \"blocking\" only if its demonstration objectively reproduces\n# against the current target — never on a reviewer's assertion alone. Execution\n# of the demonstration is isolated behind a seam (almanac_harden_demo_reproduces)\n# so the decision logic is testable without running anything, and so the real\n# executor (a conductor agent-runner call) can be wired in a later slice.\n\n# Prompt the conductor uses to execute one finding's demonstration. It must run\n# the demonstration against the CURRENT code and render a strict, falsifiable\n# verdict — never an opinion. The verdict contract is a single machine-readable\n# token so the parser can be unambiguous (see almanac_harden_ratify_verdict).\nalmanac_harden_ratify_prompt() {\n  local demonstration=\"$1\"\n  local target_path=\"${2:-}\"\n\n  cat <<EOF\nYou are the CONDUCTOR in a code-hardening loop. Ratify ONE reviewer finding by\nEXECUTING its demonstration against the current code — decide by reproduction,\nnever by opinion.\n\nTarget: ${target_path:-(the current working directory)}\n\nDemonstration to reproduce:\n${demonstration}\n\nDo this:\n1. Carry out the demonstration against the code AS IT IS RIGHT NOW: run the\n   proposed failing test, try the specific breaking input, or check the cited\n   rubric criterion.\n2. Decide strictly. The finding reproduces ONLY if the defect actually manifests\n   against the current code. A demonstration that you cannot run, that is vague\n   or speculative, or that does not actually fail does NOT reproduce.\n3. You are a JUDGE, not a fixer: do not modify the target to change the outcome.\n\nEnd your message with EXACTLY ONE of these two lines and nothing after it:\nHARDEN_VERDICT=reproduces\nHARDEN_VERDICT=not-reproduces\nEOF\n}\n\n# Parse the conductor's final message into a reproduce verdict. The contract is a\n# single unambiguous token: the affirmative is the literal \"HARDEN_VERDICT=reproduces\"\n# (the negative \"HARDEN_VERDICT=not-reproduces\" cannot match it — the char after\n# `=` is `n`, not `r`). Anything else (no token, garbled, only the negative) reads\n# as \"not\", so an un-parseable verdict is conservatively a non-blocking note.\nalmanac_harden_ratify_verdict() {\n  local result_file=\"$1\"\n\n  [ -f \"$result_file\" ] || { printf '%s\\n' \"not\"; return 0; }\n\n  if grep -Fxq 'HARDEN_VERDICT=reproduces' \"$result_file\" 2>/dev/null; then\n    printf '%s\\n' \"reproduces\"\n  else\n    printf '%s\\n' \"not\"\n  fi\n}\n\n# Execution seam: decide whether a finding's demonstration reproduces against the\n# target. Return 0 = reproduces (real defect, blocking), non-zero = does not\n# reproduce (opinion / stale). This seam IS the conductor executing the\n# demonstration: it runs the demonstration through the resolved conductor provider\n# (the (provider, model, effort) it is handed — no host-marker dependence, so it\n# is mixable per the role config) via the shared agent runner and reads the\n# conductor's verdict back from its final message. PRD story 8: \"blocking means\n# objectively reproducible, not a reviewer's assertion.\"\n#\n# Conservative on every uncertainty so opinions never silently gate the loop and\n# a flaky/missing provider never blocks a run: an empty demonstration, an\n# unresolved conductor provider, a failed/un-runnable conductor call, or an\n# un-parseable verdict all read as non-reproducing (a note). Tests override this\n# to drive the decision paths directly; here it is the real executor.\nalmanac_harden_demo_reproduces() {\n  local demonstration=\"$1\"\n  local target_path=\"${2:-}\"\n  local conductor_provider=\"${3:-}\"\n  local conductor_model=\"${4:-}\"\n  local conductor_effort=\"${5:-}\"\n  local prompt_file result_file events_file verdict rc\n\n  # Nothing to execute / no provider to execute it through -> conservative note.\n  [ -n \"$demonstration\" ] || return 1\n  [ -n \"$conductor_provider\" ] || return 1\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-prompt.XXXXXX\")\" || return 1\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-result.XXXXXX\")\" || { rm -f \"$prompt_file\"; return 1; }\n  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-events.XXXXXX\")\" || { rm -f \"$prompt_file\" \"$result_file\"; return 1; }\n\n  almanac_harden_ratify_prompt \"$demonstration\" \"$target_path\" > \"$prompt_file\"\n\n  # Reviewer text is untrusted. Ratification may inspect/run existing repro\n  # commands, but it must not write to the repo before the single fixer phase.\n  rc=0\n  almanac_loop_agent_capture \"$conductor_provider\" \"$conductor_model\" \"$conductor_effort\" \\\n    \"read-only\" \"$prompt_file\" \"$result_file\" \"$events_file\" >/dev/null 2>&1 || rc=$?\n\n  if [ \"$rc\" -ne 0 ]; then\n    # Provider missing/crashed or the demonstration was un-runnable: cannot\n    # confirm reproduction -> non-blocking note, never a hang or a hard failure.\n    rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n    return 1\n  fi\n\n  verdict=\"$(almanac_harden_ratify_verdict \"$result_file\")\"\n  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n\n  [ \"$verdict\" = \"reproduces\" ] && return 0\n  return 1\n}\n\n# Adjudicate one finding by executing its demonstration through the seam and\n# recording the outcome in the ledger. Prints the verdict:\n#   blocking - new/open finding whose demonstration reproduces (ratified, gates)\n#   note     - new/open finding that does not reproduce (non-blocking note)\n#   reopened - an already-adjudicated finding whose demonstration newly reproduces\n#   dropped  - an already-adjudicated finding that still does not reproduce\n# Already-adjudicated findings are re-litigated ONLY when they newly reproduce,\n# so a rejected opinion cannot churn the loop round after round.\n#\n# When a rubric path is given, a finding that reproduces (blocking or reopened)\n# also appends a falsifiable criterion to the rubric's `## Acceptance` — the bar\n# grows monotonically and visibly with every ratified defect. Notes and drops\n# never touch the rubric, so opinions cannot raise the bar.\n#\n# The trailing conductor (provider, model, effort) args (11th-13th) identify the\n# provider that executes the demonstration; they are passed straight to the\n# execution seam. Optional/backward-compatible — omit them to use the default.\nalmanac_harden_ratify() {\n  local path=\"$1\"\n  local id=\"$2\"\n  local lens=\"$3\"\n  local severity=\"$4\"\n  local location=\"$5\"\n  local claim=\"$6\"\n  local demonstration=\"$7\"\n  local round=\"${8:-1}\"\n  local target_path=\"${9:-}\"\n  local rubric_path=\"${10:-}\"\n  local conductor_provider=\"${11:-}\"\n  local conductor_model=\"${12:-}\"\n  local conductor_effort=\"${13:-}\"\n  local current_status reproduces status note\n\n  almanac_harden_ledger_init \"$path\"\n  current_status=\"$(almanac_harden_ledger_status \"$path\" \"$id\")\"\n\n  if almanac_harden_demo_reproduces \"$demonstration\" \"$target_path\" \\\n      \"$conductor_provider\" \"$conductor_model\" \"$conductor_effort\"; then\n    reproduces=1\n  else\n    reproduces=0\n  fi\n\n  # A ratified (reproducing) finding grows the rubric bar, regardless of whether\n  # it is newly raised or a reopened prior finding. Idempotent on the criterion\n  # text, so a reopen never duplicates an already-listed criterion.\n  if [ \"$reproduces\" -eq 1 ] && [ -n \"$rubric_path\" ]; then\n    almanac_harden_rubric_append_criterion \"$rubric_path\" \\\n      \"${claim} — must not reproduce (lens: ${lens}, at ${location})\" >/dev/null || true\n  fi\n\n  case \"$current_status\" in\n    fixed | rejected-subjective | wontfix-per-context)\n      if [ \"$reproduces\" -eq 1 ]; then\n        almanac_harden_ledger_set_status \"$path\" \"$id\" \"open\" \\\n          \"reopened: demonstration reproduced at round $round\"\n        printf '%s\\n' \"reopened\"\n      else\n        printf '%s\\n' \"dropped\"\n      fi\n      return 0\n      ;;\n  esac\n\n  if [ \"$reproduces\" -eq 1 ]; then\n    status=\"open\"\n    note=\"ratified: demonstration reproduced at round $round\"\n  else\n    status=\"rejected-subjective\"\n    note=\"did not reproduce at round $round\"\n  fi\n\n  if [ -z \"$current_status\" ]; then\n    almanac_harden_ledger_append_entry \"$path\" \"$id\" \"$lens\" \"$severity\" \\\n      \"$location\" \"$claim\" \"$demonstration\" \"$status\" \"$round\" \"$note\" >/dev/null\n  else\n    almanac_harden_ledger_set_status \"$path\" \"$id\" \"$status\" \"$note\"\n  fi\n\n  if [ \"$reproduces\" -eq 1 ]; then\n    printf '%s\\n' \"blocking\"\n  else\n    printf '%s\\n' \"note\"\n  fi\n}\n\n# Fan out one read-only reviewer per configured lens as a background worker via\n# the shared worker orchestration, then aggregate every reviewer's findings into\n# the ledger (deduped). Reviewers run concurrently and never write to the target\n# (read-only sandbox); the parent aggregates sequentially after they finish, so\n# there are no concurrent ledger writers. The lens set is configurable via\n# HARDEN_LENSES, capped by HARDEN_MAX_REVIEWERS. Each reviewer's\n# provider/model/effort resolves through the shared role config\n# (HARDEN_REVIEWER[_<LENS>]_{PROVIDER,MODEL,EFFORT}). _die on a missing target\n# before spawning anything.\nalmanac_harden_fanout() {\n  local root=\"$1\"\n  local target=\"$2\"\n  local round=\"${3:-1}\"\n  local directive=\"${4:-}\"\n  local target_path run_id run_id_base registry_dir ledger_path rubric_path lens provider model effort\n  local worker_id prompt_file pidfile pid result_file status_file wstatus\n  local added total_added i max_reviewers succeeded_count suffix\n  local -a lenses=() worker_ids=() worker_pids=() prompt_files=()\n\n  case \"$target\" in\n    /*) target_path=\"$target\" ;;\n    *)  target_path=\"$root/$target\" ;;\n  esac\n\n  if [ ! -e \"$target_path\" ]; then\n    _die \"Harden target not found: $target\"\n  fi\n\n  while IFS= read -r lens; do\n    [ -n \"$lens\" ] || continue\n    lenses+=(\"$lens\")\n  done < <(almanac_harden_lenses)\n\n  [ \"${#lenses[@]}\" -gt 0 ] || _die \"No reviewer lenses configured\"\n  max_reviewers=\"$(almanac_harden_max_reviewers)\"\n  case \"$max_reviewers\" in\n    ''|*[!0-9]*) _die \"HARDEN_MAX_REVIEWERS must be a positive integer: $max_reviewers\" ;;\n  esac\n  [ \"$max_reviewers\" -ge 1 ] || _die \"HARDEN_MAX_REVIEWERS must be at least 1: $max_reviewers\"\n  if [ \"${#lenses[@]}\" -gt \"$max_reviewers\" ]; then\n    _die \"Too many reviewer lenses (${#lenses[@]}); cap is $max_reviewers (set HARDEN_MAX_REVIEWERS to change it)\"\n  fi\n\n  run_id=\"$(almanac_loop_run_id \"harden\" \"$target\")\"\n  run_id_base=\"$run_id\"\n  registry_dir=\"$(almanac_loop_registry_dir \"$root\")\"\n  suffix=1\n  while [ -e \"$registry_dir/$run_id\" ]; do\n    suffix=$((suffix + 1))\n    run_id=\"${run_id_base}-${suffix}\"\n  done\n  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n\n  # The rubric is the contract; once one has been drafted it must be approved\n  # (locked) before the loop proceeds, so reviewers never run against a bar the\n  # human is still authoring. No rubric at all = an explicit ad-hoc run; proceed.\n  if [ -f \"$rubric_path\" ] && ! almanac_harden_rubric_approved \"$rubric_path\"; then\n    _die \"Rubric not approved: ${rubric_path#\"$root\"/} — edit it, then: almanac harden $target --approve\"\n  fi\n\n  almanac_harden_ledger_init \"$ledger_path\"\n\n  # The rubric is immutable to agents during the run. Snapshot it before any\n  # reviewer spawns; the reviewer round makes no legitimate rubric edits (the\n  # conductor's controlled append happens at ratification, a later phase), so\n  # any change observed when reviewers finish is an agent tampering — revert it.\n  local rubric_snapshot=\"\"\n  if [ -f \"$rubric_path\" ]; then\n    rubric_snapshot=\"$(almanac_harden_rubric_snapshot \"$rubric_path\")\" || rubric_snapshot=\"\"\n  fi\n\n  _info \"Hardening $target — fanning out ${#lenses[@]} read-only reviewer(s)\"\n\n  for lens in \"${lenses[@]}\"; do\n    provider=\"$(almanac_harden_role_field \"reviewer\" \"provider\" \"$lens\")\"\n    model=\"$(almanac_harden_role_field \"reviewer\" \"model\" \"$lens\")\"\n    effort=\"$(almanac_harden_role_field \"reviewer\" \"effort\" \"$lens\")\"\n\n    worker_id=\"reviewer-$lens\"\n    prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-prompt.XXXXXX\")\"\n    # Reviewers judge against the rubric when one exists (read gracefully when\n    # absent, e.g. an ad-hoc bare run with no drafted contract yet) and follow an\n    # operator steer directive when one was set at the HITL checkpoint.\n    almanac_harden_reviewer_prompt \"$target\" \"$lens\" \"$rubric_path\" \"$directive\" > \"$prompt_file\"\n\n    # Capture the worker pid via a file (not $(...)): worker_start backgrounds\n    # the agent as a child of THIS shell, so it stays waitable. A command\n    # substitution would reparent it into a subshell and break the wait.\n    pidfile=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-pid.XXXXXX\")\"\n    almanac_loop_worker_start \"$root\" \"$run_id\" \"$worker_id\" \\\n      \"$provider\" \"$model\" \"$effort\" \"read-only\" \"$prompt_file\" > \"$pidfile\"\n    pid=\"$(cat \"$pidfile\")\"\n    rm -f \"$pidfile\"\n\n    worker_ids+=(\"$worker_id\")\n    worker_pids+=(\"$pid\")\n    prompt_files+=(\"$prompt_file\")\n    _info \"  reviewer lens=$lens provider=$provider pid=$pid (read-only)\"\n  done\n\n  # Reviewers run concurrently; block until every one finishes.\n  for pid in \"${worker_pids[@]}\"; do\n    wait \"$pid\" 2>/dev/null || true\n  done\n\n  total_added=0\n  succeeded_count=0\n  i=0\n  for worker_id in \"${worker_ids[@]}\"; do\n    lens=\"${lenses[$i]}\"\n    i=$((i + 1))\n    status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n    result_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"result.txt\")\"\n\n    wstatus=\"\"\n    if [ -f \"$status_file\" ]; then\n      wstatus=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n    fi\n\n    if [ \"$wstatus\" != \"done\" ]; then\n      _warn \"reviewer lens=$lens failed or did not finish cleanly; skipping its findings\"\n      continue\n    fi\n    succeeded_count=$((succeeded_count + 1))\n\n    _info \"Findings (lens: $lens):\"\n    almanac_harden_format_findings \"$result_file\"\n\n    if [ -f \"$result_file\" ]; then\n      added=\"$(almanac_harden_ledger_record \"$ledger_path\" \"$result_file\" \"$round\")\"\n      total_added=$((total_added + added))\n    fi\n  done\n\n  [ \"${#prompt_files[@]}\" -eq 0 ] || rm -f \"${prompt_files[@]}\"\n\n  # Enforce the immutability invariant: revert (and warn about) any rubric edit\n  # an agent slipped in during the round.\n  if [ -n \"$rubric_snapshot\" ]; then\n    almanac_harden_rubric_verify \"$rubric_path\" \"$rubric_snapshot\" || true\n  fi\n\n  if [ \"$succeeded_count\" -eq 0 ]; then\n    _warn \"All reviewer workers failed; no reliable review result was produced.\"\n    return 1\n  fi\n\n  _success \"Aggregated $total_added new finding(s) into ${ledger_path#\"$root\"/}\"\n}\n\n# --- Single sequential fixer + feedback verdict --------------------------------\n#\n# After reviewers fan out and the conductor ratifies findings, ONE write-capable\n# fixer applies changes for the open blocking findings, in place, in the working\n# tree. v1 is deliberately a single sequential agent — no worktrees, no parallel\n# writers — so there is never a merge conflict to reconcile and any regression\n# test the fixer writes simply persists on disk. The fixer then runs the\n# project's feedback loops (shared detection + runner) and reports a verdict per\n# loop, so the objective half of \"bulletproof\" is enforced every round.\n\n# Build the prompt for the single sequential fixer. It receives the kill-list\n# (the open blocking findings) and the rubric bar, and is told to apply minimal\n# fixes AND leave a regression test per finding so the fix stays enforced. An\n# optional steering directive (4th arg) is embedded too, so a mid-run redirect at\n# the HITL checkpoint reaches the fixer. Exact wording is not asserted by tests by\n# design; that the fixer runs write-capable, its output persists, and it consumes\n# the steer directive is.\nalmanac_harden_fixer_prompt() {\n  local target=\"$1\"\n  local findings_text=\"$2\"\n  local rubric_path=\"${3:-}\"\n  local directive=\"${4:-}\"\n  local rubric_bar=\"\"\n\n  if [ -n \"$rubric_path\" ] && [ -f \"$rubric_path\" ]; then\n    rubric_bar=\"$(almanac_harden_rubric_acceptance \"$rubric_path\")\"\n  fi\n\n  cat <<EOF\nYou are a single sequential fixer with write access to the repository. Apply the\nminimal changes that resolve every blocking finding below for the target. For\neach finding, add or update a regression test that fails before your fix and\npasses after, so the defect cannot silently return.\n\nTarget: ${target}\n\nBlocking findings to fix:\n${findings_text}\nEOF\n\n  if [ -n \"$rubric_bar\" ]; then\n    cat <<EOF\n\nYour changes must satisfy this acceptance bar (the rubric contract):\n\n${rubric_bar}\nEOF\n  fi\n\n  if [ -n \"$directive\" ]; then\n    cat <<EOF\n\nThe operator steered this run with the directive below — apply it while you fix:\n\n${directive}\nEOF\n  fi\n\n  cat <<EOF\n\nDo not weaken, skip, or delete existing tests, and do not edit the rubric. Leave\nthe working tree building and the project's feedback loops (tests / typecheck /\nlint) green.\nEOF\n}\n\n# Run the single sequential fixer over the target's open blocking findings, then\n# run the project's feedback loops and report a pass/fail verdict per loop.\n#\n# One agent, write-capable (sandbox=workspace-write, NOT read-only), in place: no\n# worktree, so any regression tests it generates persist in the repo after the\n# run. Sequential by construction — a single foreground agent call — so there are\n# never concurrent writers. The fixer's agent call is bracketed by the rubric\n# immutability guard (snapshot before, verify after) so a write-capable fixer\n# cannot move the goalposts mid-run; legitimate rubric growth happens earlier, in\n# ratification, outside this bracket. On a clean fixer exit every open blocking\n# finding is marked `fixed` in the ledger; the next round's reviewers/ratify\n# reopen anything that still reproduces, so a still-broken finding cannot be\n# silently closed. A no-op (prints a note, returns 0) when there are no open\n# blocking findings. Returns the provider's exit code on a fixer failure, leaving\n# the findings open.\n#\n# The objective feedback gate is NOT run here: the convergence loop runs it once\n# per round (almanac_harden_round) so feedback executes every round even when\n# there is nothing to fix, and the gate reads a fresh verdict. The standalone\n# `--fix` CLI path runs almanac_harden_report_feedback explicitly afterwards.\nalmanac_harden_fix() {\n  local root=\"$1\"\n  local target=\"$2\"\n  local round=\"${3:-1}\"\n  local directive=\"${4:-}\"\n  local target_path ledger_path rubric_path open findings_text count\n  local provider model effort prompt_file result_file events_file rubric_snapshot rc\n  local id lens severity location claim demonstration\n\n  case \"$target\" in\n    /*) target_path=\"$target\" ;;\n    *)  target_path=\"$root/$target\" ;;\n  esac\n\n  if [ ! -e \"$target_path\" ]; then\n    _die \"Harden target not found: $target\"\n  fi\n\n  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n\n  open=\"$(almanac_harden_ledger_open_blocking \"$ledger_path\")\"\n  if [ -z \"$open\" ]; then\n    _info \"No open blocking findings to fix.\"\n    return 0\n  fi\n\n  count=\"$(printf '%s\\n' \"$open\" | grep -c .)\"\n\n  # Render the kill-list into the fixer prompt's findings block.\n  findings_text=\"$(\n    while IFS=$'\\t' read -r id lens severity location claim demonstration; do\n      [ -n \"$id\" ] || continue\n      printf -- '- [%s] %s: %s (at %s)\\n    demo: %s\\n' \\\n        \"${severity:-?}\" \"${lens:-?}\" \"${claim:-?}\" \"${location:-?}\" \"${demonstration:-?}\"\n    done <<INNER\n$open\nINNER\n  )\"\n\n  provider=\"$(almanac_harden_role_field \"fixer\" \"provider\")\"\n  model=\"$(almanac_harden_role_field \"fixer\" \"model\")\"\n  effort=\"$(almanac_harden_role_field \"fixer\" \"effort\")\"\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-prompt.XXXXXX\")\"\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-result.XXXXXX\")\"\n  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-events.XXXXXX\")\"\n  almanac_harden_fixer_prompt \"$target\" \"$findings_text\" \"$rubric_path\" \"$directive\" > \"$prompt_file\"\n\n  # The rubric is immutable to agents during a run. The fixer is write-capable,\n  # so bracket its agent call: snapshot before, verify (revert + warn) after.\n  rubric_snapshot=\"\"\n  if [ -f \"$rubric_path\" ]; then\n    rubric_snapshot=\"$(almanac_harden_rubric_snapshot \"$rubric_path\")\" || rubric_snapshot=\"\"\n  fi\n\n  _info \"Fixing $count open blocking finding(s) with one sequential fixer (provider=$provider, write-capable)\"\n\n  rc=0\n  almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"workspace-write\" \\\n    \"$prompt_file\" \"$result_file\" \"$events_file\" >/dev/null || rc=$?\n\n  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n\n  if [ -n \"$rubric_snapshot\" ]; then\n    almanac_harden_rubric_verify \"$rubric_path\" \"$rubric_snapshot\" || true\n  fi\n\n  if [ \"$rc\" -ne 0 ]; then\n    _warn \"Fixer failed (exit $rc); blocking findings remain open.\"\n    return \"$rc\"\n  fi\n\n  # The single fixer addresses the whole kill-list; mark all open blocking\n  # findings fixed in one ledger rewrite. A finding that still reproduces is\n  # reopened next round.\n  printf '%s\\n' \"$open\" | awk -F '\\t' '$1 != \"\" { print $1 }' \\\n    | almanac_harden_ledger_set_status_many \"$ledger_path\" \"fixed\" \\\n      \"fixed by sequential fixer at round $round\"\n\n  _success \"Applied fixes for $count finding(s); regenerated tests persist in the working tree.\"\n}\n\n# Run the project's feedback loops via the shared runner and print a pass/fail\n# verdict per loop. Returns the runner's aggregate (0 = all green, non-zero =\n# any failed) so a caller (the convergence gate, later) can act on it.\nalmanac_harden_report_feedback() {\n  local root=\"$1\"\n  local verdicts cmd verdict rc\n\n  _info \"Running project feedback loops:\"\n\n  rc=0\n  verdicts=\"$(almanac_loop_feedback_run \"$root\")\" || rc=$?\n\n  if [ -z \"$verdicts\" ]; then\n    _info \"  (no feedback loops detected)\"\n    return 0\n  fi\n\n  while IFS=$'\\t' read -r cmd verdict; do\n    [ -n \"$cmd\" ] || continue\n    if [ \"$verdict\" = \"pass\" ]; then\n      _success \"  PASS  $cmd\"\n    else\n      _warn \"  FAIL  $cmd\"\n    fi\n  done <<INNER\n$verdicts\nINNER\n\n  return \"$rc\"\n}\n\n# --- Convergence loop + gate ---------------------------------------------------\n#\n# A round is the full hardening pass over one target: fan out reviewers, ratify\n# their findings by execution, fix the blocking ones, and run the project's\n# feedback loops. The convergence loop repeats rounds until the gate says stop:\n# it converges when the acceptance bar is met AND no open blocking findings\n# remain, gives up with a clear NON-CONVERGED status when the round budget is\n# hit, and otherwise checks in with the human (ship vs. continue) between rounds.\n# Because the gate only ever exits on convergence or the budget, the loop always\n# terminates — a pathological target cannot run forever.\n\n# Pure convergence predicate. Given the round's state, decide what the loop does\n# next. No I/O, no side effects (besides echoing the verdict) so it is trivially\n# unit-testable across the whole input space:\n#\n#   acceptance_met  1 = every acceptance criterion is met, else 0\n#   open_blocking   count of open blocking findings still remaining\n#   round           the round that just finished (1-based)\n#   budget          the hard round cap (>= 1)\n#\n# Echoes one verdict and returns a distinct code so a caller can branch on either:\n#   converged      (return 0) acceptance met AND zero open blocking — exit success\n#   non-converged  (return 2) budget reached without convergence — exit failure\n#   continue       (return 1) neither — run another round","numLines":1343,"startLine":1,"totalLines":1978,"truncatedByTokenCap":true}}}
