{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CeJ1KaXfjsj2vj8GKaJX3Q","type":"tool_result","content":"1341\t#\n1342\t# Echoes one verdict and returns a distinct code so a caller can branch on either:\n1343\t#   converged      (return 0) acceptance met AND zero open blocking — exit success\n1344\t#   non-converged  (return 2) budget reached without convergence — exit failure\n1345\t#   continue       (return 1) neither — run another round\n1346\t#\n1347\t# Convergence is checked first, so a round that converges exactly at the budget\n1348\t# still reports converged (it never falsely claims non-convergence). And it never\n1349\t# reports converged unless BOTH conditions hold (it never exits early).\n1350\talmanac_harden_gate_verdict() {\n1351\t  local acceptance_met=\"$1\"\n1352\t  local open_blocking=\"$2\"\n1353\t  local round=\"$3\"\n1354\t  local budget=\"$4\"\n1355\t\n1356\t  if [ \"$acceptance_met\" = \"1\" ] && [ \"$open_blocking\" -eq 0 ]; then\n1357\t    printf '%s\\n' \"converged\"\n1358\t    return 0\n1359\t  fi\n1360\t\n1361\t  if [ \"$round\" -ge \"$budget\" ]; then\n1362\t    printf '%s\\n' \"non-converged\"\n1363\t    return 2\n1364\t  fi\n1365\t\n1366\t  printf '%s\\n' \"continue\"\n1367\t  return 1\n1368\t}\n1369\t\n1370\t# Return 0 (acceptance met) when the rubric's `## Acceptance` section has no\n1371\t# unchecked `- [ ]` criteria left, non-zero when at least one remains. An ad-hoc\n1372\t# run with no rubric has no checklist to satisfy, so acceptance is vacuously met\n1373\t# (return 0). This is one half of the gate's acceptance signal; the other half —\n1374\t# the objective feedback loops being green — is the round's own exit code.\n1375\talmanac_harden_acceptance_met() {\n1376\t  local rubric_path=\"$1\"\n1377\t\n1378\t  [ -f \"$rubric_path\" ] || return 0\n1379\t\n1380\t  if almanac_harden_rubric_acceptance \"$rubric_path\" | grep -q '^- \\[ \\]'; then\n1381\t    return 1\n1382\t  fi\n1383\t  return 0\n1384\t}\n1385\t\n1386\t# Ratify every currently-open finding by executing its demonstration through the\n1387\t# seam (almanac_harden_demo_reproduces): a finding that reproduces stays open\n1388\t# (blocking) and grows the rubric bar; one that does not becomes a non-blocking\n1389\t# note. Iterates the open-blocking rows the fan-out just recorded. The rubric\n1390\t# append happens here, between fan-out and fix and OUTSIDE the immutability\n1391\t# brackets those phases use — this is the conductor's sanctioned, monotonic\n1392\t# growth of the contract, not an agent edit. A no-op when nothing is open.\n1393\talmanac_harden_ratify_open() {\n1394\t  local root=\"$1\"\n1395\t  local target=\"$2\"\n1396\t  local round=\"${3:-1}\"\n1397\t  local ledger_path rubric_path target_path open\n1398\t  local cond_provider cond_model cond_effort\n1399\t  local id lens severity location claim demonstration\n1400\t\n1401\t  case \"$target\" in\n1402\t    /*) target_path=\"$target\" ;;\n1403\t    *)  target_path=\"$root/$target\" ;;\n1404\t  esac\n1405\t\n1406\t  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n1407\t  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n1408\t\n1409\t  open=\"$(almanac_harden_ledger_open_blocking \"$ledger_path\")\"\n1410\t  [ -n \"$open\" ] || return 0\n1411\t\n1412\t  # The conductor is the role that ratifies findings by executing their\n1413\t  # demonstrations; resolve its (provider, model, effort) once and hand it to the\n1414\t  # execution seam for every finding this round.\n1415\t  cond_provider=\"$(almanac_harden_role_field \"conductor\" \"provider\")\"\n1416\t  cond_model=\"$(almanac_harden_role_field \"conductor\" \"model\")\"\n1417\t  cond_effort=\"$(almanac_harden_role_field \"conductor\" \"effort\")\"\n1418\t\n1419\t  while IFS=$'\\t' read -r id lens severity location claim demonstration; do\n1420\t    [ -n \"$id\" ] || continue\n1421\t    almanac_harden_ratify \"$ledger_path\" \"$id\" \"$lens\" \"$severity\" \\\n1422\t      \"$location\" \"$claim\" \"$demonstration\" \"$round\" \"$target_path\" \"$rubric_path\" \\\n1423\t      \"$cond_provider\" \"$cond_model\" \"$cond_effort\" >/dev/null\n1424\t  done <<INNER\n1425\t$open\n1426\tINNER\n1427\t}\n1428\t\n1429\t# Print the kill-list — the blocking findings the round must fix — from the\n1430\t# open-blocking TSV rows. Reports an empty kill-list explicitly so every round\n1431\t# shows its verdict input. Pure presentation; does not touch the ledger.\n1432\talmanac_harden_print_killlist() {\n1433\t  local rows=\"$1\"\n1434\t  local id lens severity location claim demonstration\n1435\t\n1436\t  if [ -z \"$rows\" ]; then\n1437\t    _info \"Kill-list: no blocking findings this round.\"\n1438\t    return 0\n1439\t  fi\n1440\t\n1441\t  _info \"Kill-list (blocking findings this round):\"\n1442\t  while IFS=$'\\t' read -r id lens severity location claim demonstration; do\n1443\t    [ -n \"$id\" ] || continue\n1444\t    printf -- '  - [%s] %s: %s (at %s)\\n' \\\n1445\t      \"${severity:-?}\" \"${lens:-?}\" \"${claim:-?}\" \"${location:-?}\"\n1446\t  done <<INNER\n1447\t$rows\n1448\tINNER\n1449\t}\n1450\t\n1451\t# HITL checkpoint between rounds: let the human ship the current state, keep\n1452\t# going, or steer the run. Returns a distinct code per choice:\n1453\t#   0 = continue (run another round, directive unchanged)\n1454\t#   1 = ship (stop, accept the current state now)\n1455\t#   2 = steer (redirect/amend the run — the directive is echoed on stdout for the\n1456\t#       caller to thread into the next round's reviewers and fixer)\n1457\t# HARDEN_HITL (\"ship\"|\"continue\"|\"steer\") drives the choice non-interactively\n1458\t# (tests, headless runs); on \"steer\" the directive comes from HARDEN_STEER. With a\n1459\t# stdin TTY it prompts through the UI seam (gum-or-plain in lib/ui.sh) — gum\n1460\t# choose/input when gum is present and stderr is a TTY, plain numbered menu / read\n1461\t# otherwise. With no TTY and no override it defaults to continue so an unattended\n1462\t# loop keeps working rather than blocking on input. The prompt text goes to stderr\n1463\t# (ui.sh contract) so stdout carries only the steer directive.\n1464\talmanac_harden_hitl_checkpoint() {\n1465\t  local choice=\"${HARDEN_HITL:-}\"\n1466\t  local directive=\"${HARDEN_STEER:-}\"\n1467\t\n1468\t  if [ -z \"$choice\" ]; then\n1469\t    if [ -t 0 ]; then\n1470\t      choice=\"$(almanac_loop_ui_choose \"Round complete — ship, continue, or steer?\" continue ship steer)\" || choice=\"continue\"\n1471\t    else\n1472\t      choice=\"continue\"\n1473\t    fi\n1474\t  fi\n1475\t\n1476\t  case \"$choice\" in\n1477\t    ship|s|S|SHIP)\n1478\t      return 1\n1479\t      ;;\n1480\t    steer|st|STEER|redirect|amend)\n1481\t      # Collect a directive to redirect (or amend) the next round, unless one was\n1482\t      # supplied non-interactively via HARDEN_STEER. Echo it on stdout; the prompt\n1483\t      # itself goes to stderr (ui.sh contract) so the caller captures only the\n1484\t      # directive.\n1485\t      if [ -z \"$directive\" ] && [ -t 0 ]; then\n1486\t        directive=\"$(almanac_loop_ui_input \"Steer the run (redirect/amend)\")\" || directive=\"\"\n1487\t      fi\n1488\t      printf '%s\\n' \"$directive\"\n1489\t      return 2\n1490\t      ;;\n1491\t    *)\n1492\t      return 0\n1493\t      ;;\n1494\t  esac\n1495\t}\n1496\t\n1497\t# Run one hardening round over the target: fan out reviewers -> ratify their\n1498\t# findings by execution -> fix the blocking findings -> run the project feedback\n1499\t# loops. The round's exit code is the feedback verdict (0 = all loops green) so\n1500\t# the loop can fold it into the acceptance signal. A fixer failure is reported but\n1501\t# does not abort the round — the next round's reviewers re-surface anything still\n1502\t# broken. An optional steer directive (4th arg) is threaded into both the reviewer\n1503\t# fan-out and the fixer, so a mid-run redirect reaches the agents. The per-round\n1504\t# kill-list + verdict are reported by almanac_harden_run.\n1505\talmanac_harden_round() {\n1506\t  local root=\"$1\"\n1507\t  local target=\"$2\"\n1508\t  local round=\"${3:-1}\"\n1509\t  local directive=\"${4:-}\"\n1510\t  local rc\n1511\t\n1512\t  almanac_harden_fanout \"$root\" \"$target\" \"$round\" \"$directive\"\n1513\t  almanac_harden_ratify_open \"$root\" \"$target\" \"$round\"\n1514\t\n1515\t  if ! almanac_harden_fix \"$root\" \"$target\" \"$round\" \"$directive\"; then\n1516\t    _warn \"Fixer did not complete cleanly this round; unaddressed findings carry to the next round.\"\n1517\t  fi\n1518\t\n1519\t  rc=0\n1520\t  almanac_harden_report_feedback \"$root\" || rc=$?\n1521\t  return \"$rc\"\n1522\t}\n1523\t\n1524\t# Mark a registered harden run terminal (done|failed|aborted) and clear the\n1525\t# lifecycle trap. Best-effort and idempotent: a run that never registered (empty\n1526\t# id) or a registry write that fails never aborts the loop. Routed from every\n1527\t# normal exit path of almanac_harden_run so the run leaves \"running\", and reused\n1528\t# by the abort trap for unexpected exits (signal, mid-round _die).\n1529\talmanac_harden_run_finalize() {\n1530\t  local root=\"$1\"\n1531\t  local run_id=\"$2\"\n1532\t  local status=\"$3\"\n1533\t\n1534\t  trap - EXIT INT TERM\n1535\t  [ -n \"$run_id\" ] || return 0\n1536\t  almanac_loop_mark_run_status \"$root\" \"$run_id\" \"$status\" >/dev/null 2>&1 || true\n1537\t}\n1538\t\n1539\talmanac_harden_consume_stop() {\n1540\t  local root=\"$1\"\n1541\t  local file\n1542\t\n1543\t  file=\"$(almanac_loop_run_control_file harden \"$root\" stop)\" || return 1\n1544\t  [ -f \"$file\" ] || return 1\n1545\t  rm -f \"$file\"\n1546\t  return 0\n1547\t}\n1548\t\n1549\talmanac_harden_consume_steer() {\n1550\t  local root=\"$1\"\n1551\t  local file\n1552\t\n1553\t  file=\"$(almanac_loop_run_control_file harden \"$root\" steer)\" || return 1\n1554\t  [ -f \"$file\" ] || return 1\n1555\t  cat \"$file\"\n1556\t  rm -f \"$file\"\n1557\t  return 0\n1558\t}\n1559\t\n1560\t# Drive the convergence loop: repeat almanac_harden_round under the gate until\n1561\t# the target converges, the round budget is exhausted, or the human ships.\n1562\t# Budget is configurable (3rd arg, else HARDEN_ROUND_BUDGET, else 5). Each round\n1563\t# prints its kill-list and a verdict. Returns 0 when converged or shipped, 1 when\n1564\t# the budget is hit without convergence (clear NON-CONVERGED status).\n1565\t#\n1566\t# Between rounds the human can steer at the HITL checkpoint: a steer directive\n1567\t# (echoed by almanac_harden_hitl_checkpoint, captured here) is carried forward and\n1568\t# threaded into every subsequent round's reviewers and fixer, so the operator can\n1569\t# redirect the run without babysitting each worker. An optional starting directive\n1570\t# (4th arg) seeds the first round; the checkpoint's own directive (HARDEN_STEER /\n1571\t# the gum prompt) overrides it from the next round on.\n1572\t#\n1573\t# The loop registers itself in the shared run registry at start (the same contract\n1574\t# ralph emits, so it shows in the almanac hub), updates its live run-status blob\n1575\t# each round (round + lens/open-blocking summary), and marks the run done (converge\n1576\t# or ship), failed (budget hit), or aborted (signal / mid-round _die) on exit.\n1577\talmanac_harden_run() {\n1578\t  local root=\"$1\"\n1579\t  local target=\"$2\"\n1580\t  local budget=\"${3:-${HARDEN_ROUND_BUDGET:-5}}\"\n1581\t  local directive=\"${4:-}\"\n1582\t  local ledger_path rubric_path round round_rc open_rows open_count acc verdict rc acc_label\n1583\t  local cond_provider cond_model cond_effort steer_directive hitl_rc\n1584\t  local run_id pid lens_summary\n1585\t\n1586\t  case \"$budget\" in\n1587\t    ''|*[!0-9]*) _die \"Round budget must be a positive integer: $budget\" ;;\n1588\t  esac\n1589\t  [ \"$budget\" -ge 1 ] || _die \"Round budget must be at least 1: $budget\"\n1590\t\n1591\t  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n1592\t  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n1593\t\n1594\t  # Announce the configured conductor — the provider judging findings this run —\n1595\t  # so the role config is visible to whoever is supervising.\n1596\t  cond_provider=\"$(almanac_harden_role_field \"conductor\" \"provider\")\"\n1597\t  cond_model=\"$(almanac_harden_role_field \"conductor\" \"model\")\"\n1598\t  cond_effort=\"$(almanac_harden_role_field \"conductor\" \"effort\")\"\n1599\t  _info \"Conductor: provider=$cond_provider${cond_model:+ model=$cond_model}${cond_effort:+ effort=$cond_effort}\"\n1600\t\n1601\t  # Register this loop in the shared run registry — the SAME contract ralph emits\n1602\t  # (id/type/target/pid/status-file/start), so both appear in the almanac hub. The\n1603\t  # per-round fan-out keeps its own worker run dirs; this is the loop-level run.\n1604\t  # Best-effort: a registry failure must never stop a hardening run. lens_summary\n1605\t  # is the static lens list for the per-round progress blob.\n1606\t  pid=\"${BASHPID:-$$}\"\n1607\t  run_id=\"$(almanac_loop_register_run \"$root\" \"harden\" \"$target\" \"$pid\" 2>/dev/null || true)\"\n1608\t  lens_summary=\"$(almanac_harden_lenses | tr '\\n' ',' | sed 's/,$//' || true)\"\n1609\t  if [ -n \"$run_id\" ]; then\n1610\t    _info \"Run registered: $run_id\"\n1611\t    almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n1612\t      \"provider=${HARDEN_PROVIDER:-$cond_provider}\" \\\n1613\t      \"model=${HARDEN_MODEL:-$cond_model}\" \\\n1614\t      \"effort=${HARDEN_EFFORT:-$cond_effort}\" \\\n1615\t      \"lenses=$lens_summary\" \\\n1616\t      \"rounds=$budget\" >/dev/null 2>&1 || true\n1617\t    # Mark the run aborted on any unexpected exit (signal, mid-round _die) that\n1618\t    # leaves it still running; the normal exit paths below mark done/failed and\n1619\t    # clear this via almanac_harden_run_finalize. Bake $root/$run_id into the\n1620\t    # trap text at set-time via %q — bash uses dynamic scoping for trap\n1621\t    # expansion, and inner functions (e.g. almanac_harden_fanout) declare\n1622\t    # `local run_id` for their own bookkeeping; under `set -u`, _die exits from\n1623\t    # such a frame would resolve $run_id to the inner unset local, not this\n1624\t    # outer one, and bash would die on \"run_id: unbound variable\" before the\n1625\t    # finalize call ever runs.\n1626\t    local _harden_run_finalize_cmd\n1627\t    printf -v _harden_run_finalize_cmd 'almanac_harden_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n1628\t    trap \"${_harden_run_finalize_cmd}; exit 130\" INT TERM\n1629\t    trap \"${_harden_run_finalize_cmd}\" EXIT\n1630\t  fi\n1631\t\n1632\t  round=0\n1633\t  while :; do\n1634\t    if almanac_harden_consume_stop \"$root\"; then\n1635\t      _success \"Stop signal detected (.harden-stop); exiting before next round.\"\n1636\t      almanac_harden_run_finalize \"$root\" \"$run_id\" \"done\"\n1637\t      return 0\n1638\t    fi\n1639\t\n1640\t    steer_directive=\"$(almanac_harden_consume_steer \"$root\" || true)\"\n1641\t    if [ -n \"$steer_directive\" ]; then\n1642\t      directive=\"$steer_directive\"\n1643\t      _info \"Steering applied for the next round: $directive\"\n1644\t    fi\n1645\t\n1646\t    round=$((round + 1))\n1647\t    _info \"=== Harden round $round/$budget ===\"\n1648\t\n1649\t    almanac_harden_round \"$root\" \"$target\" \"$round\" \"$directive\" && round_rc=0 || round_rc=$?\n1650\t\n1651\t    open_rows=\"$(almanac_harden_ledger_open_blocking \"$ledger_path\")\"\n1652\t    if [ -n \"$open_rows\" ]; then\n1653\t      open_count=\"$(printf '%s\\n' \"$open_rows\" | grep -c '[^[:space:]]' || true)\"\n1654\t    else\n1655\t      open_count=0\n1656\t    fi\n1657\t\n1658\t    # Update the registry's live run-status blob so the hub/dashboard reflect the\n1659\t    # current round and a lens/open-blocking summary as the loop advances.\n1660\t    if [ -n \"$run_id\" ]; then\n1661\t      almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \\\n1662\t        \"lenses=$lens_summary open-blocking=$open_count\" >/dev/null 2>&1 || true\n1663\t    fi\n1664\t\n1665\t    # Report this round's kill-list (the blocking findings still open after the\n1666\t    # round) — the HITL view of what remains to harden.\n1667\t    almanac_harden_print_killlist \"$open_rows\"\n1668\t\n1669\t    # Acceptance for the gate = the round's feedback loops are green AND every\n1670\t    # rubric acceptance criterion is checked off (vacuously true for ad-hoc runs).\n1671\t    acc=0\n1672\t    if [ \"$round_rc\" -eq 0 ] && almanac_harden_acceptance_met \"$rubric_path\"; then\n1673\t      acc=1\n1674\t    fi\n1675\t\n1676\t    verdict=\"$(almanac_harden_gate_verdict \"$acc\" \"$open_count\" \"$round\" \"$budget\")\" && rc=0 || rc=$?\n1677\t    if [ \"$acc\" -eq 1 ]; then acc_label=\"met\"; else acc_label=\"unmet\"; fi\n1678\t    _info \"Verdict: $verdict (round $round/$budget, open-blocking=$open_count, acceptance=$acc_label)\"\n1679\t\n1680\t    case \"$rc\" in\n1681\t      0)\n1682\t        _success \"Converged after $round round(s): acceptance met and no open blocking findings remain.\"\n1683\t        almanac_harden_run_finalize \"$root\" \"$run_id\" \"done\"\n1684\t        return 0\n1685\t        ;;\n1686\t      2)\n1687\t        _warn \"Round budget ($budget) reached — $open_count open blocking finding(s) remain. Status: NON-CONVERGED.\"\n1688\t        almanac_harden_run_finalize \"$root\" \"$run_id\" \"failed\"\n1689\t        return 1\n1690\t        ;;\n1691\t      *)\n1692\t        # HITL checkpoint: continue, ship, or steer. A steer (rc 2) echoes the\n1693\t        # new directive on stdout; capture it and thread it into the next round.\n1694\t        steer_directive=\"$(almanac_harden_hitl_checkpoint)\" && hitl_rc=0 || hitl_rc=$?\n1695\t        case \"$hitl_rc\" in\n1696\t          2)\n1697\t            directive=\"$steer_directive\"\n1698\t            if [ -n \"$directive\" ]; then\n1699\t              _info \"Steering applied for the next round: $directive\"\n1700\t            else\n1701\t              _info \"Steering directive cleared for the next round.\"\n1702\t            fi\n1703\t            continue\n1704\t            ;;\n1705\t          0)\n1706\t            continue\n1707\t            ;;\n1708\t          *)\n1709\t            _success \"Shipping at round $round by request — $open_count open blocking finding(s) left unaddressed.\"\n1710\t            almanac_harden_run_finalize \"$root\" \"$run_id\" \"done\"\n1711\t            return 0\n1712\t            ;;\n1713\t        esac\n1714\t        ;;\n1715\t    esac\n1716\t  done\n1717\t}\n1718\t\n1719\t# --- Supervision dashboard -----------------------------------------------------\n1720\t#\n1721\t# A gum-styled redraw dashboard for supervising a harden run: reviewer status (per\n1722\t# lens, with health), the round, findings tallies, rubric progress, and the\n1723\t# feedback verdict. The render LOGIC is pure (almanac_harden_dashboard_rows: state\n1724\t# -> printable rows) so it is unit-testable without a terminal; the gather helpers\n1725\t# read live run state into that pure composer, and almanac_harden_render_dashboard\n1726\t# wraps the result in gum styling that degrades to plain output when gum is absent\n1727\t# (via the shared UI primitives in lib/ui.sh).\n1728\t\n1729\t# Findings tally for the dashboard: counts the ledger's findings by status as\n1730\t# `open=N fixed=N notes=N`, where notes = rejected-subjective + wontfix-per-context\n1731\t# (the non-blocking outcomes). Prints all-zero when the ledger is absent.\n1732\talmanac_harden_findings_tally() {\n1733\t  local path=\"$1\"\n1734\t\n1735\t  [ -f \"$path\" ] || { printf '%s\\n' \"open=0 fixed=0 notes=0\"; return 0; }\n1736\t\n1737\t  awk '\n1738\t    /^- status:/ {\n1739\t      s = $0; sub(/^- status:[ \\t]*/, \"\", s)\n1740\t      if (s == \"open\") o++\n1741\t      else if (s == \"fixed\") f++\n1742\t      else if (s == \"rejected-subjective\" || s == \"wontfix-per-context\") n++\n1743\t    }\n1744\t    END { printf \"open=%d fixed=%d notes=%d\\n\", o, f, n }\n1745\t  ' \"$path\"\n1746\t}\n1747\t\n1748\t# Rubric acceptance progress for the dashboard: `checked/total` over the\n1749\t# `## Acceptance` checklist. Prints 0/0 when the rubric or section is absent.\n1750\talmanac_harden_rubric_progress() {\n1751\t  local path=\"$1\"\n1752\t  local acc total checked\n1753\t\n1754\t  acc=\"$(almanac_harden_rubric_acceptance \"$path\")\"\n1755\t  total=\"$(printf '%s\\n' \"$acc\" | grep -c '^- \\[' || true)\"\n1756\t  checked=\"$(printf '%s\\n' \"$acc\" | grep -c '^- \\[[xX]\\]' || true)\"\n1757\t  printf '%s/%s\\n' \"$checked\" \"$total\"\n1758\t}\n1759\t\n1760\t# Pure render: compose the dashboard's printable rows from already-gathered state.\n1761\t# Reads worker rows from stdin as TSV (id<TAB>provider<TAB>health), one per\n1762\t# reviewer, and takes round/budget, findings tally, rubric progress, and feedback\n1763\t# verdict as args. No file I/O, no clock, no gum — fully deterministic and\n1764\t# unit-testable. Surfaces each reviewer's health (running, stalled, idle, looping,\n1765\t# done, failed) with a status glyph, and reports an empty reviewer set explicitly.\n1766\talmanac_harden_dashboard_rows() {\n1767\t  local round=\"${1:-?}\"\n1768\t  local budget=\"${2:-?}\"\n1769\t  local tally=\"${3:-}\"\n1770\t  local progress=\"${4:-}\"\n1771\t  local verdict=\"${5:-n/a}\"\n1772\t  local id provider health glyph\n1773\t  local any=0\n1774\t\n1775\t  printf 'Harden dashboard — round %s/%s\\n' \"$round\" \"$budget\"\n1776\t  printf 'Reviewers:\\n'\n1777\t  while IFS=$'\\t' read -r id provider health; do\n1778\t    [ -n \"$id\" ] || continue\n1779\t    glyph=\"$(almanac_loop_ui_status_glyph \"$health\")\"\n1780\t    printf '  %s %s  %s  %s\\n' \"$glyph\" \"$id\" \"${provider:-?}\" \"${health:-?}\"\n1781\t    any=1\n1782\t  done\n1783\t  [ \"$any\" -eq 1 ] || printf '  (no reviewers)\\n'\n1784\t  printf 'Findings: %s\\n' \"${tally:-open=0 fixed=0 notes=0}\"\n1785\t  printf 'Rubric: %s acceptance criteria\\n' \"${progress:-0/0}\"\n1786\t  printf 'Feedback: %s\\n' \"$verdict\"\n1787\t}\n1788\t\n1789\t# Gather the run's reviewer rows for the composer: one TSV line per worker\n1790\t# (id<TAB>provider<TAB>health), reading each worker's status.tsv and classifying\n1791\t# its health via the shared detector. Empty when the run has no workers yet.\n1792\t# now/stall/loop pass through to the classifier (overridable for tests).\n1793\talmanac_harden_dashboard_worker_rows() {\n1794\t  local root=\"$1\"\n1795\t  local run_id=\"$2\"\n1796\t  local now=\"${3:-}\"\n1797\t  local stall=\"${4:-120}\"\n1798\t  local loop=\"${5:-5}\"\n1799\t  local workers_dir wdir status_file base id provider health\n1800\t\n1801\t  workers_dir=\"$(almanac_loop_registry_dir \"$root\")/$run_id/workers\"\n1802\t  [ -d \"$workers_dir\" ] || return 0\n1803\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n1804\t\n1805\t  for wdir in \"$workers_dir\"/*/; do\n1806\t    [ -d \"$wdir\" ] || continue\n1807\t    status_file=\"$wdir/status.tsv\"\n1808\t    [ -f \"$status_file\" ] || continue\n1809\t    base=\"$(basename \"$wdir\")\"\n1810\t    id=\"$(almanac_loop_status_field \"$status_file\" \"id\" || true)\"\n1811\t    provider=\"$(almanac_loop_status_field \"$status_file\" \"provider\" || true)\"\n1812\t    health=\"$(almanac_loop_worker_health_of \"$root\" \"$run_id\" \"$base\" \"$now\" \"$stall\" \"$loop\")\"\n1813\t    printf '%s\\t%s\\t%s\\n' \"${id:-$base}\" \"${provider:-?}\" \"$health\"\n1814\t  done\n1815\t}\n1816\t\n1817\t# Find the most recent harden run id for a target under the run registry (newest\n1818\t# by directory mtime). Returns non-zero when no matching run exists. Used by the\n1819\t# dashboard to render the live run's state.\n1820\talmanac_harden_latest_run_id() {\n1821\t  local root=\"$1\"\n1822\t  local target=\"$2\"\n1823\t  local registry slug prefix d t base=\"\"\n1824\t  local newest_t=0\n1825\t\n1826\t  registry=\"$(almanac_loop_registry_dir \"$root\")\"\n1827\t  [ -d \"$registry\" ] || return 1\n1828\t  slug=\"$(almanac_loop_slug \"$target\")\"\n1829\t  prefix=\"harden-$slug-\"\n1830\t\n1831\t  # Glob + mtime rather than `ls -t | head`: the early pipe close in a head-\n1832\t  # truncated ls trips SIGPIPE under `set -o pipefail` and aborts the call.\n1833\t  shopt -s nullglob\n1834\t  for d in \"$registry/$prefix\"*/; do\n1835\t    [ -d \"$d\" ] || continue\n1836\t    t=\"$(stat -f %m \"$d\" 2>/dev/null || stat -c %Y \"$d\" 2>/dev/null || printf '%s' \"0\")\"\n1837\t    if [ \"$t\" -ge \"$newest_t\" ]; then\n1838\t      newest_t=\"$t\"\n1839\t      base=\"$(basename \"$d\")\"\n1840\t    fi\n1841\t  done\n1842\t  shopt -u nullglob\n1843\t\n1844\t  [ -n \"$base\" ] || return 1\n1845\t  printf '%s\\n' \"$base\"\n1846\t}\n1847\t\n1848\t# Render the supervision dashboard for a target's most recent run: gather the\n1849\t# run's reviewer health, findings tally, and rubric progress, compose the pure\n1850\t# rows, and style them (gum panel when available, plain text otherwise). Safe to\n1851\t# call when no run/worker/rubric state exists yet — it degrades to an empty\n1852\t# reviewer list and zeroed tallies rather than failing.\n1853\talmanac_harden_render_dashboard() {\n1854\t  local root=\"$1\"\n1855\t  local target=\"$2\"\n1856\t  local round=\"${3:-?}\"\n1857\t  local budget=\"${4:-?}\"\n1858\t  local verdict=\"${5:-n/a}\"\n1859\t  local run_id ledger_path rubric_path tally progress rows\n1860\t\n1861\t  run_id=\"$(almanac_harden_latest_run_id \"$root\" \"$target\" || true)\"\n1862\t  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n1863\t  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n1864\t\n1865\t  tally=\"$(almanac_harden_findings_tally \"$ledger_path\")\"\n1866\t  progress=\"$(almanac_harden_rubric_progress \"$rubric_path\")\"\n1867\t\n1868\t  rows=\"\"\n1869\t  if [ -n \"$run_id\" ]; then\n1870\t    rows=\"$(almanac_harden_dashboard_worker_rows \"$root\" \"$run_id\" || true)\"\n1871\t  fi\n1872\t\n1873\t  printf '%s\\n' \"$rows\" \\\n1874\t    | almanac_harden_dashboard_rows \"$round\" \"$budget\" \"$tally\" \"$progress\" \"$verdict\" \\\n1875\t    | almanac_loop_ui_render\n1876\t}\n1877\t\n1878\t# True (0) when at least one worker in the run is still running (its status.tsv\n1879\t# status field reads \"running\"), so the live redraw loop can tell an ongoing run\n1880\t# from a finished one. Non-zero when the run dir is absent or every worker has\n1881\t# reached a terminal status (done/failed). Harden does not yet register runs in\n1882\t# the run registry (deferred to #67), so the redraw loop keys on per-worker status\n1883\t# rather than a run-status blob.\n1884\talmanac_harden_run_has_active_worker() {\n1885\t  local root=\"$1\"\n1886\t  local run_id=\"$2\"\n1887\t  local workers_dir wdir st\n1888\t\n1889\t  workers_dir=\"$(almanac_loop_registry_dir \"$root\")/$run_id/workers\"\n1890\t  [ -d \"$workers_dir\" ] || return 1\n1891\t\n1892\t  for wdir in \"$workers_dir\"/*/; do\n1893\t    [ -d \"$wdir\" ] || continue\n1894\t    [ -f \"$wdir/status.tsv\" ] || continue\n1895\t    st=\"$(almanac_loop_status_field \"$wdir/status.tsv\" \"status\" || true)\"\n1896\t    [ \"$st\" = \"running\" ] && return 0\n1897\t  done\n1898\t\n1899\t  return 1\n1900\t}\n1901\t\n1902\t# Live supervision: redraw the dashboard on an interval so an operator can watch a\n1903\t# harden run unfold (this is the hub's \"watch a run\" action and the `--watch` CLI\n1904\t# mode). Each frame clears the terminal (TTY only, via almanac_loop_ui_clear) and\n1905\t# reprints almanac_harden_render_dashboard from the run's live worker/ledger/rubric\n1906\t# state, so reviewer health, findings tallies, rubric progress, and the verdict\n1907\t# update as the run progresses.\n1908\t#\n1909\t# Termination is bounded by construction so it can never run forever:\n1910\t#   max_frames > 0  -> render exactly that many frames (the unit-test path).\n1911\t#   max_frames == 0 and stdout is NOT a TTY -> render a single frame and return,\n1912\t#                     so a pipe / script / test never blocks on a live loop.\n1913\t#   max_frames == 0 on a TTY -> redraw until the latest run's workers have all\n1914\t#                     finished (or there is no run to watch), then return.\n1915\t# interval is the seconds slept between frames.\n1916\talmanac_harden_dashboard_redraw() {\n1917\t  local root=\"$1\"\n1918\t  local target=\"$2\"\n1919\t  local round=\"${3:-live}\"\n1920\t  local budget=\"${4:-?}\"\n1921\t  local verdict=\"${5:-n/a}\"\n1922\t  local max_frames=\"${6:-0}\"\n1923\t  local interval=\"${7:-2}\"\n1924\t  local frames=0 run_id\n1925\t\n1926\t  case \"$max_frames\" in ''|*[!0-9]*) max_frames=0 ;; esac\n1927\t\n1928\t  if [ \"$max_frames\" -eq 0 ] && [ ! -t 1 ]; then\n1929\t    almanac_harden_render_dashboard \"$root\" \"$target\" \"$round\" \"$budget\" \"$verdict\"\n1930\t    return 0\n1931\t  fi\n1932\t\n1933\t  while :; do\n1934\t    almanac_loop_ui_clear\n1935\t    almanac_harden_render_dashboard \"$root\" \"$target\" \"$round\" \"$budget\" \"$verdict\"\n1936\t    frames=$((frames + 1))\n1937\t\n1938\t    if [ \"$max_frames\" -gt 0 ]; then\n1939\t      [ \"$frames\" -ge \"$max_frames\" ] && break\n1940\t    else\n1941\t      run_id=\"$(almanac_harden_latest_run_id \"$root\" \"$target\" || true)\"\n1942\t      if [ -z \"$run_id\" ] || ! almanac_harden_run_has_active_worker \"$root\" \"$run_id\"; then\n1943\t        break\n1944\t      fi\n1945\t    fi\n1946\t\n1947\t    sleep \"$interval\"\n1948\t  done\n1949\t}\n1950\t\n1951\t# Watch a single reviewer/worker's live event stream for the target's most recent\n1952\t# run, so an operator can see what one worker is doing without the whole dashboard.\n1953\t# worker_id accepts a full worker id (reviewer-correctness) or a bare lens\n1954\t# (correctness) as shorthand for its reviewer worker. follow=\"follow\" tails the\n1955\t# log live on a TTY; otherwise the current contents print once. Delegates the\n1956\t# actual streaming to the shared almanac_loop_worker_watch. Returns 1 (and warns)\n1957\t# when no run exists for the target.\n1958\talmanac_harden_watch_worker() {\n1959\t  local root=\"$1\"\n1960\t  local target=\"$2\"\n1961\t  local worker_id=\"$3\"\n1962\t  local follow=\"${4:-}\"\n1963\t  local run_id status_file\n1964\t\n1965\t  run_id=\"$(almanac_harden_latest_run_id \"$root\" \"$target\")\" || {\n1966\t    _warn \"No harden run found for target: $target\"\n1967\t    return 1\n1968\t  }\n1969\t\n1970\t  # A bare lens (e.g. \"security\") is shorthand for its reviewer worker when no\n1971\t  # worker with that exact id exists in the run.\n1972\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n1973\t  if [ ! -f \"$status_file\" ]; then\n1974\t    status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"reviewer-$worker_id\")\"\n1975\t    [ -f \"$status_file\" ] && worker_id=\"reviewer-$worker_id\"\n1976\t  fi\n1977\t\n1978\t  almanac_loop_worker_watch \"$root\" \"$run_id\" \"$worker_id\" \"$follow\"\n1979\t}\n1980\t"}]},"parent_tool_use_id":"toolu_01LWqUsCftpFR1X4vgXfD9xG","session_id":"f9a4bfcb-3f60-4000-92ad-9c030057e806","uuid":"bd47176d-f1aa-4496-967c-aea2e4018319","timestamp":"2026-05-26T18:39:12.008Z","subagent_type":"Explore","task_description":"Find architectural friction"}
