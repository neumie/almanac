{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DzizVwjYM8GNyT3yJzLtfU","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/converge.sh - converge loop adapter.\n3\t#\n4\t# Contract (called as almanac_loop_converge_<verb>):\n5\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n6\t#                   dispatch (no central case-statement on loop type).\n7\t#   launch_usage  — the --help text printed for this loop's launcher.\n8\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n9\t#                   for a given goal / exec / rounds / oversee config. Converge's\n10\t#                   runner is the CLI itself (`almanac converge --goal … --exec …`),\n11\t#                   so the adapter yields that bin/almanac invocation. Mirrors\n12\t#                   harden's adapter shape (no standalone runner script).\n13\t#\n14\t# Control contract (signal_file) inherits the default `.converge-stop` /\n15\t# `.converge-steer` convention from lib/loops.sh — no adapter override needed.\n16\t#\n17\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n18\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n19\t# and the shared UI / provider seams. The launcher sources those before\n20\t# dispatching, so the adapter need not source them itself.\n21\t\n22\t# Build converge's runner exec command into _ALMANAC_LOOP_ARGV (the launcher\n23\t# execs it). Positional args:\n24\t#   $1  goal           (required)\n25\t#   $2  action_mode    \"prompt\" | \"exec\" (required) — picks the flag $3 maps to\n26\t#   $3  action         the prompt text OR shell command (required)\n27\t#   $4  rounds         (optional) numeric budget\n28\t#   $5  no_oversee     (optional) \"1\" / \"true\" enables, anything else is off\n29\t#   $6  oversee_every  (optional) cadence\n30\t# The role config (provider/model/effort per CONVERGE_AGENT_* / CONVERGE_OVERSEER_*)\n31\t# rides on environment exported by the launcher, not argv — same split ralph and\n32\t# harden use. Requires $ALMANAC_HOME (set by every entry point).\n33\t# Returns 2 on an unknown action_mode.\n34\talmanac_loop_converge_exec_argv() {\n35\t  local goal=\"$1\" mode=\"$2\" action=\"$3\" rounds=\"${4:-}\" no_oversee=\"${5:-}\" oversee_every=\"${6:-}\"\n36\t  local action_flag\n37\t  case \"$mode\" in\n38\t    prompt) action_flag=\"--prompt\" ;;\n39\t    exec)   action_flag=\"--exec\" ;;\n40\t    *) return 2 ;;\n41\t  esac\n42\t  _ALMANAC_LOOP_ARGV=(bash \"$ALMANAC_HOME/bin/almanac\" converge --goal \"$goal\" \"$action_flag\" \"$action\")\n43\t  [ -n \"$rounds\" ]         && _ALMANAC_LOOP_ARGV+=(--rounds \"$rounds\")\n44\t  [ -n \"$no_oversee\" ]     && [ \"$no_oversee\" != \"0\" ] && _ALMANAC_LOOP_ARGV+=(--no-oversee)\n45\t  [ -n \"$oversee_every\" ]  && _ALMANAC_LOOP_ARGV+=(--oversee-every \"$oversee_every\")\n46\t  return 0\n47\t}\n48\t\n49\t# Interactive config + exec for the converge loop. Parses native flags, prompts\n50\t# for any missing field, exports the role-config env, and execs the runner via\n51\t# the exec_argv verb. Called by lib/loop-launcher.sh's adapter dispatch — no\n52\t# central code branches on loop type.\n53\talmanac_loop_converge_launch() {\n54\t  local goal=\"\" exec_cmd=\"\" prompt=\"\" rounds=\"\" provider=\"\" model=\"\" effort=\"\" no_oversee=\"\" oversee_every=\"\" yes=\"\"\n55\t  while [ \"$#\" -gt 0 ]; do\n56\t    case \"$1\" in\n57\t      --goal)       shift; goal=\"${1:-}\";       [ -n \"$goal\" ] || _die \"--goal requires a value\" ;;\n58\t      --exec)       shift; exec_cmd=\"${1:-}\";   [ -n \"$exec_cmd\" ] || _die \"--exec requires a value\" ;;\n59\t      --prompt)     shift; prompt=\"${1:-}\";     [ -n \"$prompt\" ] || _die \"--prompt requires a value\" ;;\n60\t      --rounds)     shift; rounds=\"${1:-}\";     [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n61\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n62\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n63\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n64\t      --no-oversee) no_oversee=1 ;;\n65\t      --oversee-every) shift; oversee_every=\"${1:-}\"; [ -n \"$oversee_every\" ] || _die \"--oversee-every requires a value\" ;;\n66\t      --yes|-y) yes=1 ;;\n67\t      --help|-h) almanac_loop_converge_launch_usage; return 0 ;;\n68\t      *) _die \"Unknown converge launch option: $1\" ;;\n69\t    esac\n70\t    shift\n71\t  done\n72\t\n73\t  # Goal is always required. Action is either --prompt (agent invocation —\n74\t  # dominant mode, takes slash commands / chains / free-form text) or --exec\n75\t  # (shell command run by a wrapping worker agent — escape hatch). Mutex\n76\t  # enforced; the runner enforces it again so direct invocations stay safe.\n77\t  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then\n78\t    _die \"--prompt and --exec are mutually exclusive — pick one\"\n79\t  fi\n80\t\n81\t  [ -n \"$goal\" ] || goal=\"$(almanac_loop_ui_input \"Goal (one-line description of convergence target)\")\" || return 1\n82\t  [ -n \"$goal\" ] || _die \"A converge goal is required.\"\n83\t\n84\t  # If neither --prompt nor --exec was passed, ask which mode the operator\n85\t  # wants and prompt for the value. Default to prompt-mode because slash-command\n86\t  # convergence is the canonical use case.\n87\t  if [ -z \"$prompt\" ] && [ -z \"$exec_cmd\" ]; then\n88\t    local action_mode\n89\t    action_mode=\"$(almanac_loop_ui_choose \"Action mode\" \"prompt (agent invocation — recommended)\" \"exec (shell command)\")\" || return 1\n90\t    case \"$action_mode\" in\n91\t      prompt*)\n92\t        prompt=\"$(almanac_loop_ui_input \"Prompt (slash command, chain, or free-form — sent to agent each round)\")\" || return 1\n93\t        [ -n \"$prompt\" ] || _die \"A converge --prompt or --exec is required.\"\n94\t        ;;\n95\t      exec*)\n96\t        exec_cmd=\"$(almanac_loop_ui_input \"Exec (shell command run by wrapping worker agent each round)\")\" || return 1\n97\t        [ -n \"$exec_cmd\" ] || _die \"A converge --prompt or --exec is required.\"\n98\t        ;;\n99\t    esac\n100\t  fi\n101\t\n102\t  local action_mode action_text\n103\t  if [ -n \"$prompt\" ]; then\n104\t    action_mode=\"prompt\"\n105\t    action_text=\"$prompt\"\n106\t  else\n107\t    action_mode=\"exec\"\n108\t    action_text=\"$exec_cmd\"\n109\t  fi\n110\t\n111\t  # Provider / model / effort — same resolution as ralph + harden. Single\n112\t  # provider drives both the worker and overseer roles by default; the user can\n113\t  # still override per-role via CONVERGE_{AGENT,OVERSEER}_* env outside the\n114\t  # launcher.\n115\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n116\t  almanac_provider_known \"$provider\"     || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n117\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n118\t  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n119\t  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n120\t\n121\t  # Rounds: optional; blank accepts the cmd/converge.sh default\n122\t  # (CONVERGE_ROUND_BUDGET or 10). Validated when present.\n123\t  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n124\t  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n125\t\n126\t  # Overseer: on by default; ask the operator only if neither flag was passed.\n127\t  if [ -z \"$no_oversee\" ]