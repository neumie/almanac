{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012VgsEBJoK4UtRB9gbQqByP","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/ralph.sh — the ralph loop adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about how to launch and\n5\t# control the ralph loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n6\t#\n7\t# Contract (called as almanac_loop_ralph_<verb>):\n8\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n9\t#                   dispatch (no central case-statement on loop type).\n10\t#   launch_usage  — the --help text printed for this loop's launcher.\n11\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n12\t#                   for a given mode/prd/iterations. The ralph runner path lives\n13\t#                   HERE (not hard-coded in the launcher).\n14\t#\n15\t# Control contract (signal_file) inherits the default `.ralph-stop` / `.ralph-steer`\n16\t# convention from lib/loops.sh — no adapter override needed.\n17\t#\n18\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n19\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n20\t# and the shared UI / provider seams. The launcher sources those before\n21\t# dispatching, so the adapter need not source them itself.\n22\t\n23\t# Build ralph's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n24\t# it). MODE selects the runner: `once` runs a single iteration (once.sh PRD),\n25\t# `afk` runs autonomously (afk.sh PRD ITERATIONS). The ralph runner scripts live\n26\t# under the ralph-loop skill — this adapter is the single place that path is\n27\t# named, so the launcher no longer hard-codes …/ralph-loop/scripts/…. Returns 2\n28\t# for an unknown mode. Requires $ALMANAC_HOME (set by every entry point).\n29\talmanac_loop_ralph_exec_argv() {\n30\t  local mode=\"$1\" prd=\"$2\" iterations=\"${3:-}\"\n31\t  local scripts=\"$ALMANAC_HOME/skills/loop/ralph-loop/scripts\"\n32\t  case \"$mode\" in\n33\t    once) _ALMANAC_LOOP_ARGV=(bash \"$scripts/once.sh\" \"$prd\") ;;\n34\t    afk)  _ALMANAC_LOOP_ARGV=(bash \"$scripts/afk.sh\" \"$prd\" \"$iterations\") ;;\n35\t    *) return 2 ;;\n36\t  esac\n37\t  return 0\n38\t}\n39\t\n40\t# Interactive config + exec for the ralph loop. Parses native flags, prompts for\n41\t# any missing field via the gum-or-plain UI seam, exports the role-config env,\n42\t# and execs the runner via the exec_argv verb. Called by lib/loop-launcher.sh's\n43\t# adapter dispatch — no central code branches on loop type.\n44\talmanac_loop_ralph_launch() {\n45\t  local prd=\"\" mode=\"\" provider=\"\" model=\"\" effort=\"\" iterations=\"\" no_oversee=\"\" yes=\"\"\n46\t  while [ \"$#\" -gt 0 ]; do\n47\t    case \"$1\" in\n48\t      --prd)        shift; prd=\"${1:-}\";        [ -n \"$prd\" ] || _die \"--prd requires a value\" ;;\n49\t      --mode)       shift; mode=\"${1:-}\";       [ -n \"$mode\" ] || _die \"--mode requires a value\" ;;\n50\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n51\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n52\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n53\t      --iterations) shift; iterations=\"${1:-}\"; [ -n \"$iterations\" ] || _die \"--iterations requires a value\" ;;\n54\t      --no-oversee) no_oversee=1 ;;\n55\t      --yes|-y) yes=1 ;;\n56\t      --help|-h) almanac_loop_ralph_launch_usage; return 0 ;;\n57\t      *) _die \"Unknown ralph launch option: $1\" ;;\n58\t    esac\n59\t    shift\n60\t  done\n61\t\n62\t  [ -d docs/plans ] || _die \"docs/plans/ not found. Run from the project root.\"\n63\t\n64\t  # PRD\n65\t  if [ -z \"$prd\" ]; then\n66\t    local prds=() dir\n67\t    for dir in docs/plans/*/; do\n68\t      [ -f \"${dir}prd.md\" ] && prds+=(\"$(basename \"$dir\")\")\n69\t    done\n70\t    [ \"${#prds[@]}\" -gt 0 ] || _die \"No PRDs in docs/plans/. Run /prd-create first.\"\n71\t    if [ \"${#prds[@]}\" -eq 1 ]; then prd=\"${prds[0]}\"; else prd=\"$(almanac_loop_ui_choose \"Select PRD\" \"${prds[@]}\")\" || return 1; fi\n72\t  fi\n73\t  [ -f \"docs/plans/${prd}/prd.md\" ]    || _die \"docs/plans/${prd}/prd.md not found.\"\n74\t  [ -f \"docs/plans/${prd}/prompt.md\" ] || _die \"docs/plans/${prd}/prompt.md not found. Run /ralph-loop ${prd} first.\"\n75\t\n76\t  # Mode\n77\t  [ -n \"$mode\" ] || mode=\"$(almanac_loop_ui_choose \"Mode\" once afk)\" || return 1\n78\t  case \"$mode\" in once|afk) ;; *) _die \"--mode must be once or afk\" ;; esac\n79\t\n80\t  # Provider / model / effort\n81\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n82\t  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n83\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n84\t  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n85\t  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n86\t\n87\t  # Iterations + overseer (afk only)\n88\t  if [ \"$mode\" = \"afk\" ]; then\n89\t    iterations=\"$(_almanac_launch_need_positive_int \"Iterations\" \"$iterations\" \"10\")\" || return 1\n90\t    if [ -z \"$no_oversee\" ]; then\n91\t      almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n92\t    fi\n93\t  fi\n94\t\n95\t  # Summary + confirm\n96\t  almanac_loop_launch_summary \"ralph\" \\\n97\t    \"PRD:$prd\" \"Mode:$mode\" \"Provider:$provider\" \\\n98\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n99\t    $([ \"$mode\" = \"afk\" ] && printf '%s\\n%s' \"Iterations:$iterations\" \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\")\n100\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n101\t\n102\t  # Export role config + exec the runner (no re-launch through `almanac ralph`).\n103\t  export RALPH_PROVIDER=\"$provider\"\n104\t  [ -n \"$model\" ]  && export RALPH_MODEL=\"$model\"   || unset RALPH_MODEL\n105\t  [ -n \"$effort\" ] && export RALPH_EFFORT=\"$effort\" || unset RALPH_EFFORT\n106\t  [ -n \"$no_oversee\" ] && export RALPH_NO_OVERSEE=1\n107\t\n108\t  # Exec the runner via the ralph adapter (no hard-coded …/ralph-loop/scripts/…\n109\t  # path lives here any more — the adapter owns it).\n110\t  almanac_loop_adapter_call ralph exec_argv \"$mode\" \"$prd\" \"$iterations\" \\\n111\t    || _die \"ralph adapter could not build a runner for mode: $mode\"\n112\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n113\t}\n114\t\n115\t# --help text for `almanac ralph` / `almanac_loop_launch ralph`. Stays inside\n116\t# the adapter so adding a loop is a one-file change.\n117\talmanac_loop_ralph_launch_usage() {\n118\t  cat >&2 <<'EOF'\n119\tUsage: almanac ralph [options]   (also: bash ralph.sh [options])\n120\t  --prd <name>        PRD under docs/plans/<name>/\n121\t  --mode <once|afk>   one iteration, or autonomous\n122\t  --provider <p>      codex | claude\n123\t  --model <m>         model name (\"default\" = provider default)\n124\t  --effort <l>        thinking level (\"default\" = provider default)\n125\t  --iterations <n>    afk iteration count\n126\t  --no-oversee        disable the afk overseer\n127\tAny option not given is prompted interactively.\n128\tEOF\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"f9a4bfcb-3f60-4000-92ad-9c030057e806","uuid":"111c4ab8-0dbc-4759-b72d-f7b664d711f6","timestamp":"2026-05-26T20:38:15.198Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/loops/ralph.sh","content":"#!/usr/bin/env bash\n# lib/loops/ralph.sh — the ralph loop adapter.\n#\n# One file owns everything the engine needs to know about how to launch and\n# control the ralph loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n#\n# Contract (called as almanac_loop_ralph_<verb>):\n#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n#                   dispatch (no central case-statement on loop type).\n#   launch_usage  — the --help text printed for this loop's launcher.\n#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n#                   for a given mode/prd/iterations. The ralph runner path lives\n#                   HERE (not hard-coded in the launcher).\n#\n# Control contract (signal_file) inherits the default `.ralph-stop` / `.ralph-steer`\n# convention from lib/loops.sh — no adapter override needed.\n#\n# The launch verb uses helpers defined in lib/loop-launcher.sh\n# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n# and the shared UI / provider seams. The launcher sources those before\n# dispatching, so the adapter need not source them itself.\n\n# Build ralph's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n# it). MODE selects the runner: `once` runs a single iteration (once.sh PRD),\n# `afk` runs autonomously (afk.sh PRD ITERATIONS). The ralph runner scripts live\n# under the ralph-loop skill — this adapter is the single place that path is\n# named, so the launcher no longer hard-codes …/ralph-loop/scripts/…. Returns 2\n# for an unknown mode. Requires $ALMANAC_HOME (set by every entry point).\nalmanac_loop_ralph_exec_argv() {\n  local mode=\"$1\" prd=\"$2\" iterations=\"${3:-}\"\n  local scripts=\"$ALMANAC_HOME/skills/loop/ralph-loop/scripts\"\n  case \"$mode\" in\n    once) _ALMANAC_LOOP_ARGV=(bash \"$scripts/once.sh\" \"$prd\") ;;\n    afk)  _ALMANAC_LOOP_ARGV=(bash \"$scripts/afk.sh\" \"$prd\" \"$iterations\") ;;\n    *) return 2 ;;\n  esac\n  return 0\n}\n\n# Interactive config + exec for the ralph loop. Parses native flags, prompts for\n# any missing field via the gum-or-plain UI seam, exports the role-config env,\n# and execs the runner via the exec_argv verb. Called by lib/loop-launcher.sh's\n# adapter dispatch — no central code branches on loop type.\nalmanac_loop_ralph_launch() {\n  local prd=\"\" mode=\"\" provider=\"\" model=\"\" effort=\"\" iterations=\"\" no_oversee=\"\" yes=\"\"\n  while [ \"$#\" -gt 0 ]; do\n    case \"$1\" in\n      --prd)        shift; prd=\"${1:-}\";        [ -n \"$prd\" ] || _die \"--prd requires a value\" ;;\n      --mode)       shift; mode=\"${1:-}\";       [ -n \"$mode\" ] || _die \"--mode requires a value\" ;;\n      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n      --iterations) shift; iterations=\"${1:-}\"; [ -n \"$iterations\" ] || _die \"--iterations requires a value\" ;;\n      --no-oversee) no_oversee=1 ;;\n      --yes|-y) yes=1 ;;\n      --help|-h) almanac_loop_ralph_launch_usage; return 0 ;;\n      *) _die \"Unknown ralph launch option: $1\" ;;\n    esac\n    shift\n  done\n\n  [ -d docs/plans ] || _die \"docs/plans/ not found. Run from the project root.\"\n\n  # PRD\n  if [ -z \"$prd\" ]; then\n    local prds=() dir\n    for dir in docs/plans/*/; do\n      [ -f \"${dir}prd.md\" ] && prds+=(\"$(basename \"$dir\")\")\n    done\n    [ \"${#prds[@]}\" -gt 0 ] || _die \"No PRDs in docs/plans/. Run /prd-create first.\"\n    if [ \"${#prds[@]}\" -eq 1 ]; then prd=\"${prds[0]}\"; else prd=\"$(almanac_loop_ui_choose \"Select PRD\" \"${prds[@]}\")\" || return 1; fi\n  fi\n  [ -f \"docs/plans/${prd}/prd.md\" ]    || _die \"docs/plans/${prd}/prd.md not found.\"\n  [ -f \"docs/plans/${prd}/prompt.md\" ] || _die \"docs/plans/${prd}/prompt.md not found. Run /ralph-loop ${prd} first.\"\n\n  # Mode\n  [ -n \"$mode\" ] || mode=\"$(almanac_loop_ui_choose \"Mode\" once afk)\" || return 1\n  case \"$mode\" in once|afk) ;; *) _die \"--mode must be once or afk\" ;; esac\n\n  # Provider / model / effort\n  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n\n  # Iterations + overseer (afk only)\n  if [ \"$mode\" = \"afk\" ]; then\n    iterations=\"$(_almanac_launch_need_positive_int \"Iterations\" \"$iterations\" \"10\")\" || return 1\n    if [ -z \"$no_oversee\" ]; then\n      almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n    fi\n  fi\n\n  # Summary + confirm\n  almanac_loop_launch_summary \"ralph\" \\\n    \"PRD:$prd\" \"Mode:$mode\" \"Provider:$provider\" \\\n    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n    $([ \"$mode\" = \"afk\" ] && printf '%s\\n%s' \"Iterations:$iterations\" \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\")\n  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n\n  # Export role config + exec the runner (no re-launch through `almanac ralph`).\n  export RALPH_PROVIDER=\"$provider\"\n  [ -n \"$model\" ]  && export RALPH_MODEL=\"$model\"   || unset RALPH_MODEL\n  [ -n \"$effort\" ] && export RALPH_EFFORT=\"$effort\" || unset RALPH_EFFORT\n  [ -n \"$no_oversee\" ] && export RALPH_NO_OVERSEE=1\n\n  # Exec the runner via the ralph adapter (no hard-coded …/ralph-loop/scripts/…\n  # path lives here any more — the adapter owns it).\n  almanac_loop_adapter_call ralph exec_argv \"$mode\" \"$prd\" \"$iterations\" \\\n    || _die \"ralph adapter could not build a runner for mode: $mode\"\n  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n}\n\n# --help text for `almanac ralph` / `almanac_loop_launch ralph`. Stays inside\n# the adapter so adding a loop is a one-file change.\nalmanac_loop_ralph_launch_usage() {\n  cat >&2 <<'EOF'\nUsage: almanac ralph [options]   (also: bash ralph.sh [options])\n  --prd <name>        PRD under docs/plans/<name>/\n  --mode <once|afk>   one iteration, or autonomous\n  --provider <p>      codex | claude\n  --model <m>         model name (\"default\" = provider default)\n  --effort <l>        thinking level (\"default\" = provider default)\n  --iterations <n>    afk iteration count\n  --no-oversee        disable the afk overseer\nAny option not given is prompted interactively.\nEOF\n}\n","numLines":130,"startLine":1,"totalLines":130}}}
