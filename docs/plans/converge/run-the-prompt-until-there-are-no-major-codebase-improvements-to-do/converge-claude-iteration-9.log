{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L5Du5VJmFDRCBUW8tS8QEj","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/converge.sh - converge loop adapter.\n3\t#\n4\t# Contract (called as almanac_loop_converge_<verb>):\n5\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n6\t#                   dispatch (no central case-statement on loop type).\n7\t#   launch_usage  — the --help text printed for this loop's launcher.\n8\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n9\t#                   for a given goal / exec / rounds / oversee config. Converge's\n10\t#                   runner is the CLI itself (`almanac converge --goal … --exec …`),\n11\t#                   so the adapter yields that bin/almanac invocation. Mirrors\n12\t#                   harden's adapter shape (no standalone runner script).\n13\t#   new_run_argv  — emit the hub's \"new run\" launcher argv (one token per line)\n14\t#                   from key=val pairs; role config rides on env (see\n15\t#                   new_run_env). Enforces the prompt/exec mutex.\n16\t#   new_run_env   — emit KEY=VALUE env lines for the role config (CONVERGE_*)\n17\t#                   so the hub never has to know converge's env prefixes.\n18\t#\n19\t# Control contract (signal_file) inherits the default `.converge-stop` /\n20\t# `.converge-steer` convention from lib/loops.sh — no adapter override needed.\n21\t#\n22\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n23\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n24\t# and the shared UI / provider seams. The launcher sources those before\n25\t# dispatching, so the adapter need not source them itself.\n26\t\n27\t# Build converge's runner exec command into _ALMANAC_LOOP_ARGV (the launcher\n28\t# execs it). Positional args:\n29\t#   $1  goal           (required)\n30\t#   $2  action_mode    \"prompt\" | \"exec\" (required) — picks the flag $3 maps to\n31\t#   $3  action         the prompt text OR shell command (required)\n32\t#   $4  rounds         (optional) numeric budget\n33\t#   $5  no_oversee     (optional) \"1\" / \"true\" enables, anything else is off\n34\t#   $6  oversee_every  (optional) cadence\n35\t# The role config (provider/model/effort per CONVERGE_AGENT_* / CONVERGE_OVERSEER_*)\n36\t# rides on environment exported by the launcher, not argv — same split ralph and\n37\t# harden use. Requires $ALMANAC_HOME (set by every entry point).\n38\t# Returns 2 on an unknown action_mode.\n39\talmanac_loop_converge_exec_argv() {\n40\t  local goal=\"$1\" mode=\"$2\" action=\"$3\" rounds=\"${4:-}\" no_oversee=\"${5:-}\" oversee_every=\"${6:-}\"\n41\t  local action_flag\n42\t  case \"$mode\" in\n43\t    prompt) action_flag=\"--prompt\" ;;\n44\t    exec)   action_flag=\"--exec\" ;;\n45\t    *) return 2 ;;\n46\t  esac\n47\t  _ALMANAC_LOOP_ARGV=(bash \"$ALMANAC_HOME/bin/almanac\" converge --goal \"$goal\" \"$action_flag\" \"$action\")\n48\t  [ -n \"$rounds\" ]         && _ALMANAC_LOOP_ARGV+=(--rounds \"$rounds\")\n49\t  [ -n \"$no_oversee\" ]     && [ \"$no_oversee\" != \"0\" ] && _ALMANAC_LOOP_ARGV+=(--no-oversee)\n50\t  [ -n \"$oversee_every\" ]  && _ALMANAC_LOOP_ARGV+=(--oversee-every \"$oversee_every\")\n51\t  return 0\n52\t}\n53\t\n54\t# Interactive config + exec for the converge loop. Parses native flags, prompts\n55\t# for any missing field, exports the role-config env, and execs the runner via\n56\t# the exec_argv verb. Called by lib/loop-launcher.sh's adapter dispatch — no\n57\t# central code branches on loop type.\n58\talmanac_loop_converge_launch() {\n59\t  local goal=\"\" exec_cmd=\"\" prompt=\"\" rounds=\"\" provider=\"\" model=\"\" effort=\"\" no_oversee=\"\" oversee_every=\"\" yes=\"\"\n60\t  while [ \"$#\" -gt 0 ]; do\n61\t    case \"$1\" in\n62\t      --goal)       shift; goal=\"${1:-}\";       [ -n \"$goal\" ] || _die \"--goal requires a value\" ;;\n63\t      --exec)       shift; exec_cmd=\"${1:-}\";   [ -n \"$exec_cmd\" ] || _die \"--exec requires a value\" ;;\n64\t      --prompt)     shift; prompt=\"${1:-}\";     [ -n \"$prompt\" ] || _die \"--prompt requires a value\" ;;\n65\t      --rounds)     shift; rounds=\"${1:-}\";     [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n66\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n67\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n68\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n69\t      --no-oversee) no_oversee=1 ;;\n70\t      --oversee-every) shift; oversee_every=\"${1:-}\"; [ -n \"$oversee_every\" ] || _die \"--oversee-every requires a value\" ;;\n71\t      --yes|-y) yes=1 ;;\n72\t      --help|-h) almanac_loop_converge_launch_usage; return 0 ;;\n73\t      *) _die \"Unknown converge launch option: $1\" ;;\n74\t    esac\n75\t    shift\n76\t  done\n77\t\n78\t  # Goal is always required. Action is either --prompt (agent invocation —\n79\t  # dominant mode, takes slash commands / chains / free-form text) or --exec\n80\t  # (shell command run by a wrapping worker agent — escape hatch). Mutex\n81\t  # enforced; the runner enforces it again so direct invocations stay safe.\n82\t  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then\n83\t    _die \"--prompt and --exec are mutually exclusive — pick one\"\n84\t  fi\n85\t\n86\t  [ -n \"$goal\" ] || goal=\"$(almanac_loop_ui_input \"Goal (one-line description of convergence target)\")\" || return 1\n87\t  [ -n \"$goal\" ] || _die \"A converge goal is required.\"\n88\t\n89\t  # If neither --prompt nor --exec was passed, ask which mode the operator\n90\t  # wants and prompt for the value. Default to prompt-mode because slash-command\n91\t  # convergence is the canonical use case.\n92\t  if [ -z \"$prompt\" ] && [ -z \"$exec_cmd\" ]; then\n93\t    local action_mode\n94\t    action_mode=\"$(almanac_loop_ui_choose \"Action mode\" \"prompt (agent invocation — recommended)\" \"exec (shell command)\")\" || return 1\n95\t    case \"$action_mode\" in\n96\t      prompt*)\n97\t        prompt=\"$(almanac_loop_ui_input \"Prompt (slash command, chain, or free-form — sent to agent each round)\")\" || return 1\n98\t        [ -n \"$prompt\" ] || _die \"A converge --prompt or --exec is required.\"\n99\t        ;;\n100\t      exec*)"}]},"parent_tool_use_id":"toolu_01FJ9EEdfdtbtg8quvqZtx5v","session_id":"2b01beec-8e7f-499f-84c4-979f364c4a47","uuid":"c63faa4c-ebf1-4f3d-9ede-0672b41ca204","timestamp":"2026-05-27T06:22:31.266Z","subagent_type":"Explore","task_description":"Codebase architectural friction survey"}
