ite-capable fixer\n31\t#\n32\t# Resolution layers, most specific first, via the shared loop resolver:\n33\t#   provider: HARDEN_<ROLE>[_<LENS>]_PROVIDER -> HARDEN_<ROLE>_PROVIDER\n34\t#             -> HARDEN_PROVIDER -> claude (sensible default: Claude plays every role)\n35\t#   model:    HARDEN_<ROLE>[_<LENS>]_MODEL    -> HARDEN_<ROLE>_MODEL\n36\t#             -> HARDEN_MODEL -> \"\" (the provider's own default)\n37\t#   effort:   HARDEN_<ROLE>[_<LENS>]_EFFORT   -> HARDEN_<ROLE>_EFFORT\n38\t#             -> HARDEN_EFFORT -> \"\" (the provider's own default)\n39\t#\n40\t# Only reviewers consult the lens, so providers can be mixed across lenses in one\n41\t# round; conductor and fixer are single-instance and ignore it. Resolution reads\n42\t# ONLY HARDEN_* (and the shared loop env) — never any host marker — so the tuple\n43\t# is identical whether the run was launched from Claude Code or Codex. Emits three\n44\t# TSV rows (provider/model/effort); returns 2 on an unknown role.\n45\talmanac_harden_role() {\n46\t  local role=\"$1\"\n47\t  local lens=\"${2:-}\"\n48\t\n49\t  case \"$role\" in\n50\t    reviewer) ;;                 # reviewers map lens -> provider\n51\t    conductor | fixer) lens=\"\" ;; # single-instance roles ignore the lens\n52\t    *) return 2 ;;\n53\t  esac\n54\t\n55\t  almanac_loop_role_config \"harden\" \"$role\" \"$lens\" \"$(almanac_provider_default)\" \"\" \"\"\n56\t}\n57\t\n58\t# One field (provider | model | effort) of a harden role's resolved config, for\n59\t# call sites that need a single value. Thin reader over almanac_harden_role so\n60\t# harden's per-role defaults stay defined in exactly one place.\n61\talmanac_harden_role_field() {\n62\t  local role=\"$1\"\n63\t  local field=\"$2\"\n64\t  local lens=\"${3:-}\"\n65\t\n66\t  # Consume all of almanac_harden_role's output (no early awk exit) so the\n67\t  # producer never takes a SIGPIPE under `set -o pipefail`.\n68\t  almanac_harden_role \"$role\" \"$lens\" | awk -F'\\t' -v k=\"$field\" '$1