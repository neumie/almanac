{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XBMg5uDKn6AHTwEEWTgnmU","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# test-run.sh - run registry tests (lib/run.sh)\n3\t#\n4\t# Sources lib/run.sh DIRECTLY (its interface is its own test surface) — loop-core.sh\n5\t# was deleted and its run registry, control, worker-health, and hub read-views moved\n6\t# into lib/run.sh, alongside the run-status record it already owned. These tests pin:\n7\t#   - the run-status RECORD: canonical field list, set/get-by-name, round-trip write,\n8\t#     unknown-field rejection, identical-key-set-by-construction\n9\t#   - the run REGISTRY: register/mark/update, staleness, list/read\n10\t#   - WORKER HEALTH: the pure classifier + the gather wrapper\n11\t#   - the HUB read-views: running/recent render, overview, per-run detail/watch\n12\t#   - CONTROL: stop/steer signal-file dispatch (via the loop adapter)\n13\t#   - the NEW-RUN composer: argv/env for ralph + harden\n14\t# The worker ORCHESTRATION (background fan-out) lives in lib/worker.sh and is\n15\t# tested in tests/test-worker.sh.\n16\t\n17\tset -euo pipefail\n18\t\n19\tROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n20\tsource \"$ROOT/lib/run.sh\"\n21\t\n22\tTMPDIRS=()\n23\tNEW_TMPDIR=\"\"\n24\t\n25\tcleanup() {\n26\t  local dir\n27\t  [ \"${#TMPDIRS[@]}\" -eq 0 ] && return 0\n28\t  for dir in \"${TMPDIRS[@]}\"; do\n29\t    rm -rf \"$dir\"\n30\t  done\n31\t}\n32\ttrap cleanup EXIT\n33\t\n34\tfail() {\n35\t  echo \"  FAIL: $1\" >&2\n36\t  exit 1\n37\t}\n38\t\n39\tassert_eq() {\n40\t  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n41\t  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n42\t}\n43\t\n44\tassert_file_contains() {\n45\t  local file=\"$1\" needle=\"$2\" message=\"$3\"\n46\t  grep -Fq -- \"$needle\" \"$file\" || fail \"$message\"\n47\t}\n48\t\n49\tassert_contains() {\n50\t  local haystack=\"$1\" needle=\"$2\" message=\"$3\"\n51\t  case \"$haystack\" in\n52\t    *\"$needle\"*) ;;\n53\t    *) fail \"$message\" ;;\n54\t  esac\n55\t}\n56\t\n57\tnew_tmpdir() {\n58\t  NEW_TMPDIR=$(mktemp -d)\n59\t  TMPDIRS+=(\"$NEW_TMPDIR\")\n60\t}\n61\t\n62\ttest_record_fields_is_canonical_schema() {\n63\t  local expected actual\n64\t  expected=$(printf '%s\\n' \\\n65\t    id type target pid status_file started_at status finished_at round summary failure_reason \\\n66\t    provider model effort iterations oversee lenses rounds queue_progress)\n67\t  actual=\"$(almanac_loop_record_fields)\"\n68\t  assert_eq \"$expected\" \"$actual\" \"record_fields must be the canonical run-status schema, in order\"\n69\t  echo \"  PASS: record_fields is the canonical schema\"\n70\t}\n71\t\n72\ttest_record_has_field_recognises_only_canonical() {\n73\t  almanac_loop_record_has_field \"id\" || fail \"id must be a canonical field\"\n74\t  almanac_loop_record_has_field \"summary\" || fail \"summary must be a canonical field\"\n75\t  if almanac_loop_record_has_field \"bogus\"; then\n76\t    fail \"a non-canonical field must not be recognised\"\n77\t  fi\n78\t  echo \"  PASS: record_has_field recognises only canonical fields\"\n79\t}\n80\t"}]},"parent_tool_use_id":null,"session_id":"2b01beec-8e7f-499f-84c4-979f364c4a47","uuid":"679321a9-8c73-4409-99f7-115b102f9571","timestamp":"2026-05-27T06:28:29.153Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/tests/test-run.sh","content":"#!/usr/bin/env bash\n# test-run.sh - run registry tests (lib/run.sh)\n#\n# Sources lib/run.sh DIRECTLY (its interface is its own test surface) — loop-core.sh\n# was deleted and its run registry, control, worker-health, and hub read-views moved\n# into lib/run.sh, alongside the run-status record it already owned. These tests pin:\n#   - the run-status RECORD: canonical field list, set/get-by-name, round-trip write,\n#     unknown-field rejection, identical-key-set-by-construction\n#   - the run REGISTRY: register/mark/update, staleness, list/read\n#   - WORKER HEALTH: the pure classifier + the gather wrapper\n#   - the HUB read-views: running/recent render, overview, per-run detail/watch\n#   - CONTROL: stop/steer signal-file dispatch (via the loop adapter)\n#   - the NEW-RUN composer: argv/env for ralph + harden\n# The worker ORCHESTRATION (background fan-out) lives in lib/worker.sh and is\n# tested in tests/test-worker.sh.\n\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nsource \"$ROOT/lib/run.sh\"\n\nTMPDIRS=()\nNEW_TMPDIR=\"\"\n\ncleanup() {\n  local dir\n  [ \"${#TMPDIRS[@]}\" -eq 0 ] && return 0\n  for dir in \"${TMPDIRS[@]}\"; do\n    rm -rf \"$dir\"\n  done\n}\ntrap cleanup EXIT\n\nfail() {\n  echo \"  FAIL: $1\" >&2\n  exit 1\n}\n\nassert_eq() {\n  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n}\n\nassert_file_contains() {\n  local file=\"$1\" needle=\"$2\" message=\"$3\"\n  grep -Fq -- \"$needle\" \"$file\" || fail \"$message\"\n}\n\nassert_contains() {\n  local haystack=\"$1\" needle=\"$2\" message=\"$3\"\n  case \"$haystack\" in\n    *\"$needle\"*) ;;\n    *) fail \"$message\" ;;\n  esac\n}\n\nnew_tmpdir() {\n  NEW_TMPDIR=$(mktemp -d)\n  TMPDIRS+=(\"$NEW_TMPDIR\")\n}\n\ntest_record_fields_is_canonical_schema() {\n  local expected actual\n  expected=$(printf '%s\\n' \\\n    id type target pid status_file started_at status finished_at round summary failure_reason \\\n    provider model effort iterations oversee lenses rounds queue_progress)\n  actual=\"$(almanac_loop_record_fields)\"\n  assert_eq \"$expected\" \"$actual\" \"record_fields must be the canonical run-status schema, in order\"\n  echo \"  PASS: record_fields is the canonical schema\"\n}\n\ntest_record_has_field_recognises_only_canonical() {\n  almanac_loop_record_has_field \"id\" || fail \"id must be a canonical field\"\n  almanac_loop_record_has_field \"summary\" || fail \"summary must be a canonical field\"\n  if almanac_loop_record_has_field \"bogus\"; then\n    fail \"a non-canonical field must not be recognised\"\n  fi\n  echo \"  PASS: record_has_field recognises only canonical fields\"\n}\n","numLines":80,"startLine":1,"totalLines":1026}}}
