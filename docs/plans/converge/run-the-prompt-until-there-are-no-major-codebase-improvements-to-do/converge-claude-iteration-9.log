on lines (got: '$ALMANAC_CONVERGE_STEER')\" ;;\ntests/test-converge.sh:815:  assert_eq \"unchanged\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\" \"GOAL_UPDATE unchanged on multi-line REASON\"\ntests/test-converge.sh:819:  almanac_converge_overseer_parse \"VERDICT: CONTINUE\ntests/test-converge.sh:830:  case \"$ALMANAC_CONVERGE_STEER\" in\ntests/test-converge.sh:832:    *) fail \"STEER value on line after KEY: must parse (got: '$ALMANAC_CONVERGE_STEER')\" ;;\ntests/test-converge.sh:834:  assert_eq \"unchanged\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\" \"GOAL_UPDATE value on next line still recognised as unchanged\"\ntests/test-converge.sh:838:  almanac_converge_overseer_parse \"VERDICT:\ntests/test-converge.sh:844:  assert_eq \"CONVERGED\" \"$ALMANAC_CONVERGE_VERDICT\" \"VERDICT token on next line, with trailing chatter, still parses\"\ntests/test-converge.sh:848:  almanac_converge_overseer_parse \"VERDICT: CONTINUE\ntests/test-converge.sh:852:  assert_eq \"CONTINUE\" \"$ALMANAC_CONVERGE_VERDICT\" \"empty REASON does not malform the verdict\"\ntests/test-converge.sh:1271:test_overseer_parse_verdicts_and_malformed_input\ntests/test-converge.sh:1272:test_overseer_parse_captures_multi_line_values","numLines":32}}
