| _die \"harden adapter could not build a runner for target: $target\"\n90\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n91\t}\n92\t\n93\t# Compose the hub's new-run launcher argv for harden (one token per line). The\n94\t# convergence loop launches via `almanac harden <target> --loop [--rounds N]` —\n95\t# all other reviewer/role config rides on env (see new_run_env). Returns 2 when\n96\t# a required field (target) is missing.\n97\talmanac_loop_harden_new_run_argv() {\n98\t  local target=\"\" rounds=\"\" kv key val\n99\t  for kv in \"$@\"; do\n100\t    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n101\t    case \"$key\" in\n102\t      target) target=\"$val\" ;;\n103\t      rounds) rounds=\"$val\" ;;\n104\t    esac\n105\t  done\n106\t\n107\t  [ -n \"$target\" ] || return 2\n108\t  printf '%s\\n%s\\n%s\\n' harden \"$target\" --loop\n109\t  [ -n \"$rounds\" ] && printf '%s\\n%s\\n' --rounds \"$rounds\"\n110\t  return 0\n111\t}\n112\t\n113\t# Compose the hub's new-run env stream for harden (KEY=VALUE per line) from\n114\t# key=val pairs: reviewer lenses + role config (HARDEN_LENSES / HARDEN_PROVIDER /\n115\t# HARDEN_MODEL / HARDEN_EFFORT). Empty fields drop their key.\n116\talmanac_loop_harden_new_run_env() {\n117\t  local provider=\"\" model=\"\" effort=\"\" lenses=\"\" kv key val\n118\t  for kv in \"$@\"; do\n119\t    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n120\t    case \"$key\" in\n121\t      provider) provider=\"$val\" ;;\n122\t      model)    model=\"$val\" ;;\n123\t      effort)   effort=\"$val\" ;;\n124\t      lenses)   lenses=\"$val\" ;;\n125\t    esac\n126\t  done\n127\t  [ -n \"$lenses\" ]   && printf 'HARDEN_LENSES=%s\\n' \"$lenses\"\n128\t  [ -n \"$provider\" ] && printf 'HARDEN_PROVIDER=%s\\n' \"$provider\"\n129\t  [ -n \"$model\" ]    && printf 'HARDEN_MODEL=%s\\n' \"$model\"\n130\t  [ -n \"$effort\" ]   && printf 'HARDEN_EFFORT=%s\\n' \"$effort\"\n131\t  return 0\n132\t}\n133\t\n134\t# Read a harden run's status blob and emit the key=val pairs that\n135\t# almanac_loop_har