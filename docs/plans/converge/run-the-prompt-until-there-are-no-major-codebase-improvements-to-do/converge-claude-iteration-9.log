{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mc4nfXeD6WRvZyPjirr74U","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# harden-core.sh - Harden loop rubric bootstrap + reviewer helpers\n3\t\n4\t# loop-core.sh (the old shared-engine barrel) is deleted; harden-core sources the\n5\t# focused modules it actually uses, each directly and idempotently so it works\n6\t# both through bin/almanac and when a test sources this file directly. core.sh\n7\t# is sourced literally (it owns the helper); the other deps go through\n8\t# _almanac_source_sibling so the boilerplate stays minimal.\n9\tif ! declare -F _error >/dev/null 2>&1; then\n10\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n11\t  # shellcheck source=lib/core.sh\n12\t  source \"$__harden_core_dir/core.sh\"\n13\t  unset __harden_core_dir\n14\tfi\n15\t\n16\t# Explicit deps (each declared module is the contract surface this file consumes;\n17\t# transitive availability is not relied on).\n18\t_almanac_source_sibling agent.sh    almanac_loop_agent_capture   # agent run shapes (ratify/fixer)\n19\t_almanac_source_sibling run.sh      almanac_loop_register_run    # run registry + worker paths/health\n20\t_almanac_source_sibling worker.sh   almanac_loop_worker_start    # worker orchestration (reviewer/fixer fan-out)\n21\t_almanac_source_sibling ui.sh       almanac_loop_ui_render       # gum-or-plain dashboard seam\n22\t_almanac_source_sibling role.sh     almanac_loop_role_config     # per-role provider/model/effort resolution\n23\t_almanac_source_sibling feedback.sh almanac_loop_feedback_run    # objective fixer gate\n24\t\n25\t# --- Role config (per-role provider / model / effort) --------------------------\n26\t#\n27\t# Each harden role selects its own agent config:\n28\t#   conductor - judges/ratifies findings and declares convergence\n29\t#   reviewer  - one read-only reviewer per lens (lens -> provider map)\n30\t#   fixer     - the single sequential write-capable fixer\n31\t#\n32\t# Resolution layers, most specific first, via the shared loop resolver:\n33\t#   provider: HARDEN_<ROLE>[_<LENS>]_PROVIDER -> HARDEN_<ROLE>_PROVIDER\n34\t#             -> HARDEN_PROVIDER -> claude (sensible default: Claude plays every role)\n35\t#   model:    HARDEN_<ROLE>[_<LENS>]_MODEL    -> HARDEN_<ROLE>_MODEL\n36\t#             -> HARDEN_MODEL -> \"\" (the provider's own default)\n37\t#   effort:   HARDEN_<ROLE>[_<LENS>]_EFFORT   -> HARDEN_<ROLE>_EFFORT\n38\t#             -> HARDEN_EFFORT -> \"\" (the provider's own default)\n39\t#\n40\t# Only reviewers consult the lens, so providers can be mixed across lenses in one\n41\t# round; conductor and fixer are single-instance and ignore it. Resolution reads\n42\t# ONLY HARDEN_* (and the shared loop env) — never any host marker — so the tuple\n43\t# is identical whether the run was launched from Claude Code or Codex. Emits three\n44\t# TSV rows (provider/model/effort); returns 2 on an unknown role.\n45\talmanac_harden_role() {\n46\t  local role=\"$1\"\n47\t  local lens=\"${2:-}\"\n48\t\n49\t  case \"$role\" in\n50\t    reviewer) ;;                 # reviewers map lens -> provider\n51\t    conductor | fixer) lens=\"\" ;; # single-instance roles ignore the lens\n52\t    *) return 2 ;;\n53\t  esac\n54\t\n55\t  almanac_loop_role_config \"harden\" \"$role\" \"$lens\" \"$(almanac_provider_default)\" \"\" \"\"\n56\t}\n57\t\n58\t# One field (provider | model | effort) of a harden role's resolved config, for\n59\t# call sites that need a single value. Thin reader over almanac_harden_role so\n60\t# harden's per-role defaults stay defined in exactly one place.\n61\talmanac_harden_role_field() {\n62\t  local role=\"$1\"\n63\t  local field=\"$2\"\n64\t  local lens=\"${3:-}\"\n65\t\n66\t  # Consume all of almanac_harden_role's output (no early awk exit) so the\n67\t  # producer never takes a SIGPIPE under `set -o pipefail`.\n68\t  almanac_harden_role \"$role\" \"$lens\" | awk -F'\\t' -v k=\"$field\" '$1 == k { v = $2 } END { print v }'\n69\t}\n70\t\n71\talmanac_harden_rubric_path() {\n72\t  local root=\"$1\"\n73\t  local target=\"$2\"\n74\t  local slug\n75\t\n76\t  slug=\"$(almanac_loop_slug \"$target\")\"\n77\t  printf '%s/docs/plans/harden/%s/rubric.md\\n' \"$root\" \"$slug\"\n78\t}\n79\t\n80\talmanac_harden_write_rubric() {\n81\t  local root=\"$1\"\n82\t  local target=\"$2\"\n83\t  local goal=\"$3\"\n84\t  local path dir\n85\t\n86\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n87\t  dir=\"$(dirname \"$path\")\"\n88\t\n89\t  if [ -e \"$path\" ]; then\n90\t    return 2\n91\t  fi\n92\t\n93\t  mkdir -p \"$dir\"\n94\t  cat > \"$path\" <<EOF\n95\t# Harden Rubric\n96\t\n97\tTarget: $target\n98\tStatus: draft\n99\t\n100\t## Goal"}]},"parent_tool_use_id":"toolu_01FJ9EEdfdtbtg8quvqZtx5v","session_id":"2b01beec-8e7f-499f-84c4-979f364c4a47","uuid":"ae71b6f8-d626-452c-86cc-cd400844ee8f","timestamp":"2026-05-27T06:22:18.314Z","subagent_type":"Explore","task_description":"Codebase architectural friction survey"}
