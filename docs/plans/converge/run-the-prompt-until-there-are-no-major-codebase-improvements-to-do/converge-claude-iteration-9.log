{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JXYdw3oi37nxRqFG74Cytp","type":"tool_result","content":"50\talmanac_loop_ralph_launch() {\n51\t  local prd=\"\" mode=\"\" provider=\"\" model=\"\" effort=\"\" iterations=\"\" no_oversee=\"\" yes=\"\"\n52\t  while [ \"$#\" -gt 0 ]; do\n53\t    case \"$1\" in\n54\t      --prd)        shift; prd=\"${1:-}\";        [ -n \"$prd\" ] || _die \"--prd requires a value\" ;;\n55\t      --mode)       shift; mode=\"${1:-}\";       [ -n \"$mode\" ] || _die \"--mode requires a value\" ;;\n56\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n57\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n58\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n59\t      --iterations) shift; iterations=\"${1:-}\"; [ -n \"$iterations\" ] || _die \"--iterations requires a value\" ;;\n60\t      --no-oversee) no_oversee=1 ;;\n61\t      --yes|-y) yes=1 ;;\n62\t      --help|-h) almanac_loop_ralph_launch_usage; return 0 ;;\n63\t      *) _die \"Unknown ralph launch option: $1\" ;;\n64\t    esac\n65\t    shift\n66\t  done\n67\t\n68\t  [ -d docs/plans ] || _die \"docs/plans/ not found. Run from the project root.\"\n69\t\n70\t  # PRD\n71\t  if [ -z \"$prd\" ]; then\n72\t    local prds=() dir\n73\t    for dir in docs/plans/*/; do\n74\t      [ -f \"${dir}prd.md\" ] && prds+=(\"$(basename \"$dir\")\")\n75\t    done\n76\t    [ \"${#prds[@]}\" -gt 0 ] || _die \"No PRDs in docs/plans/. Run /prd-create first.\"\n77\t    if [ \"${#prds[@]}\" -eq 1 ]; then prd=\"${prds[0]}\"; else prd=\"$(almanac_loop_ui_choose \"Select PRD\" \"${prds[@]}\")\" || return 1; fi\n78\t  fi\n79\t  [ -f \"docs/plans/${prd}/prd.md\" ]    || _die \"docs/plans/${prd}/prd.md not found.\"\n80\t  [ -f \"docs/plans/${prd}/prompt.md\" ] || _die \"docs/plans/${prd}/prompt.md not found. Run /ralph-loop ${prd} first.\"\n81\t\n82\t  # Mode\n83\t  [ -n \"$mode\" ] || mode=\"$(almanac_loop_ui_choose \"Mode\" once afk)\" || return 1\n84\t  case \"$mode\" in once|afk) ;; *) _die \"--mode must be once or afk\" ;; esac\n85\t\n86\t  # Provider / model / effort\n87\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n88\t  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n89\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n90\t  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n91\t  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n92\t\n93\t  # Iterations + overseer (afk only)\n94\t  if [ \"$mode\" = \"afk\" ]; then\n95\t    iterations=\"$(_almanac_launch_need_positive_int \"Iterations\" \"$iterations\" \"10\")\" || return 1\n96\t    if [ -z \"$no_oversee\" ]; then\n97\t      almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n98\t    fi\n99\t  fi\n100\t\n101\t  # Summary + confirm\n102\t  almanac_loop_launch_summary \"ralph\" \\\n103\t    \"PRD:$prd\" \"Mode:$mode\" \"Provider:$provider\" \\\n104\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n105\t    $([ \"$mode\" = \"afk\" ] && printf '%s\\n%s' \"Iterations:$iterations\" \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\")\n106\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n107\t\n108\t  # Export role config + exec the runner (no re-launch through `almanac ralph`).\n109\t  export RALPH_PROVIDER=\"$provider\"\n110\t  [ -n \"$model\" ]  && export RALPH_MODEL=\"$model\"   || unset RALPH_MODEL\n111\t  [ -n \"$effort\" ] && export RALPH_EFFORT=\"$effort\" || unset RALPH_EFFORT\n112\t  [ -n \"$no_oversee\" ] && export RALPH_NO_OVERSEE=1\n113\t\n114\t  # Exec the runner via the ralph adapter (no hard-coded …/ralph-loop/scripts/…\n115\t  # path lives here any more — the adapter owns it).\n116\t  almanac_loop_adapter_call ralph exec_argv \"$mode\" \"$prd\" \"$iterations\" \\\n117\t    || _die \"ralph adapter could not build a runner for mode: $mode\"\n118\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n119\t}\n120\t\n121\t# Compose the hub's new-run launcher argv for ralph (one token per line, starting\n122\t# with the `almanac` subcommand). Accepts key=val pairs (the hub's lingua franca\n123\t# for new-run config) so the dispatcher in lib/run.sh never has to know ralph's\n124\t# flag shape. Returns 2 when a required field (prd) is missing. ralph takes all\n125\t# its config as flags — no env lines — so it has no new_run_env counterpart with\n126\t# real work to do, but it still implements one (below) for contract uniformity.\n127\talmanac_loop_ralph_new_run_argv() {\n128\t  local prd=\"\" mode=\"\" provider=\"\" model=\"\" effort=\"\" iterations=\"\" oversee=\"\"\n129\t  local kv key val\n130\t  for kv in \"$@\"; do\n131\t    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n132\t    case \"$key\" in\n133\t      prd) prd=\"$val\" ;;\n134\t      mode) mode=\"$val\" ;;\n135\t      provider) provider=\"$val\" ;;\n136\t      model) model=\"$val\" ;;\n137\t      effort) effort=\"$val\" ;;\n138\t      iterations) iterations=\"$val\" ;;\n139\t      oversee) oversee=\"$val\" ;;\n140\t    esac\n141\t  done\n142\t\n143\t  [ -n \"$prd\" ] || return 2\n144\t  printf '%s\\n' ralph\n145\t  printf '%s\\n%s\\n' --prd \"$prd\"\n146\t  [ -n \"$mode\" ]       && printf '%s\\n%s\\n' --mode \"$mode\"\n147\t  [ -n \"$provider\" ]   && printf '%s\\n%s\\n' --provider \"$provider\"\n148\t  [ -n \"$model\" ]      && printf '%s\\n%s\\n' --model \"$model\"\n149\t  [ -n \"$effort\" ]     && printf '%s\\n%s\\n' --effort \"$effort\""}]},"parent_tool_use_id":"toolu_01F