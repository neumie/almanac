{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K6u8qo9GAHACCZeJGWUaxM","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# loop-launcher.sh — the single almanac launcher (ralph + harden + converge).\n3\t#\n4\t# almanac_loop_launch <type> [native flags…] interactively configures and starts\n5\t# a loop run. It is loop-agnostic: one launcher for every consumer — `almanac\n6\t# ralph`, `almanac harden`, the hub's New-run flow, and the ralph skill launcher\n7\t# all route here, so the config UX is identical everywhere (the PRD's \"almanac\n8\t# launcher, not per-loop reimplementations\").\n9\t#\n10\t# Each loop's flag parsing, prompts, env-export, and runner exec live in its\n11\t# adapter (lib/loops/<name>.sh) as the `launch` verb, and its --help text as the\n12\t# `launch_usage` verb. The launcher dispatches via the loop-adapter seam — no\n13\t# central case-statement branches on loop type, so adding a 4th loop is a\n14\t# single new file in lib/loops/.\n15\t#\n16\t# The shared bits — field collectors (provider / choice / positive-int) and the\n17\t# summary panel — stay here because every adapter uses them identically. They\n18\t# are sourced once at launcher boot, so any adapter dispatched through\n19\t# `almanac_loop_launch` finds them in scope.\n20\t#\n21\t# Requires lib/core.sh (_die/_info/_success + _almanac_source_sibling), sourced\n22\t# by every entry point before this file. The deps below are each declared\n23\t# explicitly through the sibling helper so the launcher's seam dependencies\n24\t# aren't borrowed from whatever sourced this file.\n25\t_almanac_source_sibling ui.sh    almanac_loop_ui_choose       # gum-or-plain UI seam\n26\t_almanac_source_sibling agent.sh almanac_provider_default     # provider-adapter seam (availability/default)\n27\t_almanac_source_sibling loops.sh almanac_loop_adapter_call    # loop-adapter dispatch\n28\t\n29\t# --- field collectors ---------------------------------------------------------\n30\t#\n31\t# Used by every loop adapter's `launch` verb (lib/loops/<name>.sh::almanac_loop_<name>_launch).\n32\t# The underscore prefix signals \"private to the launching subsystem (this file +\n33\t# adapter launch verbs)\" — not for callers outside that path.\n34\t\n35\t# Pick a provider into the named-by-$1 variable if it is empty. Lists only\n36\t# installed providers (discovered via the seam); dies if none.\n37\t_almanac_launch_need_provider() {\n38\t  local var=\"$1\" current=\"${2:-}\" providers=() p chosen\n39\t  if [ -n \"$current\" ]; then printf '%s\\n' \"$current\"; return 0; fi\n40\t  for p in $(almanac_provider_list); do\n41\t    almanac_provider_available \"$p\" && providers+=(\"$p\")\n42\t  done\n43\t  [ \"${#providers[@]}\" -gt 0 ] || _die \"No supported provider found. Install Codex or Claude Code.\"\n44\t  if [ \"${#providers[@]}\" -eq 1 ]; then printf '%s\\n' \"${providers[0]}\"; return 0; fi\n45\t  chosen=\"$(almanac_loop_ui_choose \"Provider\" \"${providers[@]}\")\" || return 1\n46\t  printf '%s\\n' \"$chosen\"\n47\t}\n48\t\n49\t# Resolve a model/effort value: if empty, show the provider menu; map \"default\"\n50\t# to empty and \"custom\" to a free-text prompt. Echoes the resolved value.\n51\t_almanac_launch_need_choice() {\n52\t  local header=\"$1\" current=\"$2\" picked\n53\t  shift 2\n54\t  if [ -n \"$current\" ]; then\n55\t    [ \"$current\" = \"default\" ] && current=\"\"\n56\t    printf '%s\\n' \"$current\"; return 0\n57\t  fi\n58\t  picked=\"$(almanac_loop_ui_choose \"$header\" \"$@\")\" || return 1\n59\t  if [ \"$picked\" = \"custom\" ]; then\n60\t    picked=\"$(almanac_loop_ui_input \"$header (custom)\")\" || return 1\n61\t  fi\n62\t  [ \"$picked\" = \"default\" ] && picked=\"\"\n63\t  printf '%s\\n' \"$picked\"\n64\t}\n65\t\n66\t# Resolve a positive integer. A preset (flag) value is validated once and dies on\n67\t# failure; an interactive value re-prompts until valid. Echoes the integer.\n68\t_almanac_launch_need_positive_int() {\n69\t  local header=\"$1\" current=\"$2\" default=\"${3:-}\" reply\n70\t  if [ -n \"$current\" ]; then\n71\t    case \"$current\" in ''|*[!0-9]*) _die \"$header must be a positive integer (got: $current)\";; esac\n72\t    [ \"$current\" -gt 0 ] || _die \"$header must be a positive integer (got: $current)\"\n73\t    printf '%s\\n' \"$current\"; return 0\n74\t  fi\n75\t  while :; do\n76\t    reply=\"$(almanac_loop_ui_input \"$header\" \"$default\")\" || return 1\n77\t    case \"$reply\" in ''|*[!0-9]*) _warn \"Enter a positive integer.\" >&2; continue;; esac\n78\t    [ \"$reply\" -gt 0 ] && { printf '%s\\n' \"$reply\"; return 0; }\n79\t    _warn \"Enter a positive integer.\" >&2\n80\t  done\n81\t}\n82\t\n83\t# --- summary + dispatch --------------------------------------------------------\n84\t\n85\t# Render a \"LABEL:value\" config summary as a gum-styled (or plain) panel. Each\n86\t# remaining arg is one \"Field:value\" line. Presentation only.\n87\talmanac_loop_launch_summary() {\n88\t  local type=\"$1\"; shift\n89\t  local line\n90\t  {\n91\t    printf '%s\\n' \"$(printf '%s' \"$type\" | tr '[:lower:]' '[:upper:]') run\"\n92\t    printf '%s\\n' \"──────────────────\"\n93\t    for line in \"$@\"; do\n94\t      printf '  %-11s %s\\n' \"${line%%:*}\" \"${line#*:}\"\n95\t    done\n96\t  } | almanac_loop_ui_render >&2\n97\t}\n98\t\n99\t# Per-type usage, printed for --help. Goes to stderr (stdout stays capture-clean).\n100\t# Dispatched to the loop adapter's `launch_usage` verb — no central case-statement\n101\t# on loop type. Adding a new loop puts its usage text in lib/loops/<name>.sh\n102\t# alongside its launch verb. A missing adapter or missing verb is a no-op so\n103\t# `--help` for an unknown loop fails through to the launcher's usage error\n104\t# rather than crashing.\n105\talmanac_loop_launch_usage() {\n106\t  local type=\"${1:-}\"\n107\t  [ -n \"$type\" ] || return 0\n108\t  almanac_loop_adapter_known \"$type\" || return 0\n109\t  local fn\n110\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch_usage\"\n111\t  declare -F \"$fn\" >/dev/null 2>&1 && \"$fn\"\n112\t}\n113\t\n114\t# Public entry: configure and launch a run of TYPE (ralph|harden|converge|…).\n115\t# Remaining args are that type's native flags; missing fields are prompted by\n116\t# the adapter's `launch` verb, which also execs the runner. The launcher does\n117\t# not enumerate loop types — discovery is via the loop-adapter seam, so adding\n118\t# a new loop is a single new file in lib/loops/. We resolve the launch verb's\n119\t# function name and invoke it directly (rather than going through\n120\t# almanac_loop_adapter_call) so a missing verb is a hard die — the launch\n121\t# function itself may legitimately exit non-zero (user cancelled / validation\n122\t# error), and adapter_call's \"verb missing\" rc=2 would collide with those.\n123\talmanac_loop_launch() {\n124\t  local type=\"${1:-}\"; shift || true\n125\t  [ -n \"$type\" ] || _die \"Usage: almanac_loop_launch <loop> [options] (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n126\t  almanac_loop_adapter_known \"$type\" || _die \"Unknown loop type: $type (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n127\t  local fn\n128\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch\"\n129\t  declare -F \"$fn\" >/dev/null 2>&1 || _die \"Loop adapter '$type' does not implement the launch verb\"\n130\t  \"$fn\" \"$@\"\n131\t}\n132\t"}]},"parent_tool_use_id":"toolu_01FJ9EEdfdtbtg8quvqZtx5v","session_id":"2b01beec-8e7f-499f-84c4-979f364c4a47","uuid":"8b7b3dee-3d65-4e76-b780-a2477d811e83","timestamp":"2026-05-27T06:22:43.637Z","subagent_type":"Explore","task_description":"Codebase architectural friction survey"}
