{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LMsscWrTatZ4dEAiuLQAuf","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/providers/codex.sh — the codex provider adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about codex: availability,\n5\t# its active-session signal, the model/effort menus, its display name, the exec\n6\t# argv (deep invocation — incl. the sandbox value and --json-or-not by shape),\n7\t# and the event-stream jq filter. Nothing outside this file contains a `codex …`\n8\t# literal. Auto-discovered by lib/agent.sh from lib/providers/*.sh; adding a\n9\t# provider is a sibling file implementing the same contract.\n10\t#\n11\t# Contract (called as almanac_provider_codex_<verb>):\n12\t#   available    — is the codex CLI on PATH?\n13\t#   active_env   — are we inside a resumable codex session? (CODEX_THREAD_ID)\n14\t#   models       — model menu (one per line; \"default\"/\"custom\" are sentinels)\n15\t#   efforts      — thinking-effort menu (one per line)\n16\t#   display      — human display name\n17\t#   argv         — populate _ALMANAC_AGENT_ARGV with the exec tokens (no prompt)\n18\t#   filter       — jq program turning --json events into live agent-message text\n19\t#   supports_raw — declared (codex has a native, non-JSON passthrough mode)\n20\t#   (no _extract — codex writes its result via --output-last-message)\n21\t\n22\talmanac_provider_codex_available() {\n23\t  command -v codex >/dev/null 2>&1\n24\t}\n25\t\n26\t# CODEX_THREAD_ID is a resume directive (\"continue this exact thread\"), so a run\n27\t# inside a codex session should prefer codex — the seam's default-selection\n28\t# honours this active-env signal before falling back to preference order.\n29\talmanac_provider_codex_active_env() {\n30\t  [ -n \"${CODEX_THREAD_ID:-}\" ]\n31\t}\n32\t\n33\talmanac_provider_codex_models() {\n34\t  printf '%s\\n' default gpt-5.5 gpt-5.4 gpt-5.4-mini gpt-5.3-codex gpt-5.2 custom\n35\t}\n36\t\n37\talmanac_provider_codex_efforts() {\n38\t  printf '%s\\n' default low medium high xhigh custom\n39\t}\n40\t\n41\talmanac_provider_codex_display() {\n42\t  printf '%s\\n' \"Codex\"\n43\t}\n44\t\n45\t# Declared (not called) so the agent runner can detect — without branching on\n46\t# provider name — that codex has a raw passthrough shape (native output, no\n47\t# --json/filter/events capture). Providers without it fall back to capture.\n48\talmanac_provider_codex_supports_raw() {\n49\t  return 0\n50\t}\n51\t\n52\t# Build codex's exec argv into _ALMANAC_AGENT_ARGV (the prompt is appended by the\n53\t# runner, not here). shape \"raw\" omits --json so codex's native output streams\n54\t# straight to the terminal; every other shape parses the structured --json event\n55\t# stream. --output-last-message captures the final message to $result_file in\n56\t# both shapes. The sandbox value is passed straight through to --sandbox.\n57\talmanac_provider_codex_argv() {\n58\t  local model=\"$1\" effort=\"$2\" sandbox=\"$3\" result_file=\"$4\" shape=\"$5\"\n59\t  sandbox=\"${sandbox:-danger-full-access}\"\n60\t\n61\t  _ALMANAC_AGENT_ARGV=(\n62\t    codex\n63\t    --ask-for-approval never\n64\t    exec\n65\t    --cd \"$PWD\"\n66\t    --sandbox \"$sandbox\"\n67\t    --color never\n68\t  )\n69\t  [ \"$shape\" = \"raw\" ] || _ALMANAC_AGENT_ARGV+=(--json)\n70\t  _ALMANAC_AGENT_ARGV+=(--output-last-message \"$result_file\")\n71\t  [ -n \"$model\" ]  && _ALMANAC_AGENT_ARGV+=(--model \"$model\")\n72\t  [ -n \"$effort\" ] && _ALMANAC_AGENT_ARGV+=(-c \"model_reasoning_effort=\\\"$effort\\\"\")\n73\t  return 0\n74\t}\n75\t\n76\t# jq filter turning codex --json events into the live agent-message text the\n77\t# console shows.\n78\talmanac_provider_codex_filter() {\n79\t  cat <<'JQ'\n80\t  if .type == \"item.completed\" and .item.type == \"agent_message\" then\n81\t    .item.text | . + \"\\n\\n\"\n82\t  else\n83\t    empty\n84\t  end\n85\tJQ\n86\t}\n87\t"}]},"parent_tool_use_id":"toolu_01