{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AmohKo1LDvFMb3Ho8RfcDq","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/harden.sh — the harden loop adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about how to launch and\n5\t# control the harden loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n6\t#\n7\t# Contract (called as almanac_loop_harden_<verb>):\n8\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n9\t#                   dispatch (no central case-statement on loop type).\n10\t#   launch_usage  — the --help text printed for this loop's launcher.\n11\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n12\t#                   for a given target/rounds. Harden's runner runs through the\n13\t#                   CLI (`almanac harden <target> --loop`).\n14\t#\n15\t# Control contract (signal_file) inherits the default `.harden-stop` /\n16\t# `.harden-steer` convention from lib/loops.sh — no adapter override needed.\n17\t#\n18\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n19\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n20\t# and the shared UI / provider seams. The launcher sources those before\n21\t# dispatching, so the adapter need not source them itself.\n22\t\n23\t# Build harden's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n24\t# it). harden has no standalone runner script — its convergence loop runs through\n25\t# the CLI (`almanac harden <target> --loop [--rounds N]`), so the adapter yields\n26\t# that bin/almanac invocation. The reviewer/role config rides on environment\n27\t# exported by the launcher, not argv. Requires $ALMANAC_HOME (set by every entry\n28\t# point).\n29\talmanac_loop_harden_exec_argv() {\n30\t  local target=\"$1\" rounds=\"${2:-}\"\n31\t  _ALMANAC_LOOP_ARGV=(bash \"$ALMANAC_HOME/bin/almanac\" harden \"$target\" --loop)\n32\t  [ -n \"$rounds\" ] && _ALMANAC_LOOP_ARGV+=(--rounds \"$rounds\")\n33\t  return 0\n34\t}\n35\t\n36\t# Interactive config + exec for the harden loop. Parses native flags, prompts\n37\t# for any missing field, exports the role-config env, and execs the runner via\n38\t# the exec_argv verb. Called by lib/loop-launcher.sh's adapter dispatch — no\n39\t# central code branches on loop type.\n40\talmanac_loop_harden_launch() {\n41\t  local target=\"\" lenses=\"\" provider=\"\" model=\"\" effort=\"\" rounds=\"\" yes=\"\"\n42\t  while [ \"$#\" -gt 0 ]; do\n43\t    case \"$1\" in\n44\t      --lenses)   shift; lenses=\"${1:-}\";   [ -n \"$lenses\" ] || _die \"--lenses requires a value\" ;;\n45\t      --provider) shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n46\t      --model)    shift; model=\"${1:-}\";    [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n47\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n48\t      --rounds)   shift; rounds=\"${1:-}\";   [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n49\t      --yes|-y) yes=1 ;;\n50\t      --help|-h) almanac_loop_harden_launch_usage; return 0 ;;\n51\t      -*) _die \"Unknown harden launch option: $1\" ;;\n52\t      *)  [ -z \"$target\" ] && target=\"$1\" || _die \"Unexpected harden argument: $1\" ;;\n53\t    esac\n54\t    shift\n55\t  done\n56\t\n57\t  [ -n \"$target\" ] || target=\"$(almanac_loop_ui_input \"Target (file / dir / PR)\")\" || return 1\n58\t  [ -n \"$target\" ] || _die \"A harden target is required.\"\n59\t\n60\t  lenses=\"$(test -n \"$lenses\" && printf '%s' \"$lenses\" || almanac_loop_ui_input \"Lenses (blank = default set)\")\" || return 1\n61\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n62\t  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n63\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n64\t  model=\"$(_almanac_launch_need_choice \"Reviewer model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n65\t  effort=\"$(_almanac_launch_need_choice \"Reviewer thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n66\t  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n67\t  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n68\t\n69\t  almanac_loop_launch_summary \"harden\" \\\n70\t    \"Target:$target\" \"Lenses:${lenses:-default set}\" \"Provider:$provider\" \\\n71\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n72\t    \"Rounds:${rounds:-default budget}\"\n73\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n74\t\n75\t  [ -n \"$lenses\" ]   && export HARDEN_LENSES=\"$lenses\"\n76\t  export HARDEN_PROVIDER=\"$provider\"\n77\t  [ -n \"$model\" ]    && export HARDEN_MODEL=\"$model\"   || unset HARDEN_MODEL\n78\t  [ -n \"$effort\" ]   && export HARDEN_EFFORT=\"$effort\" || unset HARDEN_EFFORT\n79\t\n80\t  # Exec the runner via the harden adapter (its convergence loop runs through\n81\t  # `almanac harden <target> --loop` — the adapter owns that invocation).\n82\t  almanac_loop_adapter_call harden exec_argv \"$target\" \"$rounds\" \\\n83\t    || _die \"harden adapter could not build a runner for target: $target\"\n84\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n85\t}\n86\t\n87\t# --help text for `almanac harden --loop` / `almanac_loop_launch harden`. Stays\n88\t# inside the adapter so adding a loop is a one-file change.\n89\talmanac_loop_harden_launch_usage() {\n90\t  cat >&2 <<'EOF'\n91\tUsage (loop launch): <target> [options]\n92\t  <target>            file / dir / PR to harden\n93\t  --lenses <list>     reviewer lenses (blank = default set)\n94\t  --provider <p>      codex | claude\n95\t  --model <m>         reviewer model\n96\t  --effort <l>        reviewer thinking level\n97\t  --rounds <n>        round budget\n98\tAny option not given is prompted interactively.\n99\tEOF\n100\t}\n101\t"}]},"parent_tool_use_id":"toolu_011jum217MMD1buwBQXTXcgD","session_id":"2788a3dc-ec0d-4660-89bb-3c9bc3797157","uuid":"71a3e2a3-9847-440f-ae3a-f42c9bec3ab5","timestamp":"2026-05-26T14:55:37.581Z","subagent_type":"Explore","task_description":"Explore almanac codebase for deepening opportunities"}
