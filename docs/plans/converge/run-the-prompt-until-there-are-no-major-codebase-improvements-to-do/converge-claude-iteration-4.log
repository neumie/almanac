{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M5bhahFEQ9hN8UGxMqswEN","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# test-loops.sh - loop-adapter seam tests (lib/loops.sh + lib/loops/*)\n3\t#\n4\t# Sources lib/loops.sh DIRECTLY (not through loop-core / the launcher) so the\n5\t# seam's interface is its own test surface. The adapters are pure config (exec\n6\t# argv composition + signal-file mapping), so nothing here calls a real runner —\n7\t# exec_argv is asserted against a fake $ALMANAC_HOME, never executed.\n8\t\n9\tset -euo pipefail\n10\t\n11\tROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n12\tsource \"$ROOT/lib/loops.sh\"\n13\t\n14\tfail() {\n15\t  echo \"  FAIL: $1\" >&2\n16\t  exit 1\n17\t}\n18\t\n19\tassert_eq() {\n20\t  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n21\t  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n22\t}\n23\t\n24\ttest_discovery_lists_present_adapters() {\n25\t  local list\n26\t  list=\"$(almanac_loop_adapter_list)\"\n27\t  case \"$list\" in *ralph*) ;; *) fail \"loop list should include the ralph adapter file\" ;; esac\n28\t  case \"$list\" in *harden*) ;; *) fail \"loop list should include the harden adapter file\" ;; esac\n29\t  case \"$list\" in *converge*) ;; *) fail \"loop list should include the converge adapter file\" ;; esac\n30\t"}]},"parent_tool_use_id":null,"session_id":"2788a3dc-ec0d-4660-89bb-3c9bc3797157","uuid":"350e9174-a6c6-4d4b-8cb5-ef5b7d98e30c","timestamp":"2026-05-26T15:01:08.734Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/tests/test-loops.sh","content":"#!/usr/bin/env bash\n# test-loops.sh - loop-adapter seam tests (lib/loops.sh + lib/loops/*)\n#\n# Sources lib/loops.sh DIRECTLY (not through loop-core / the launcher) so the\n# seam's interface is its own test surface. The adapters are pure config (exec\n# argv composition + signal-file mapping), so nothing here calls a real runner —\n# exec_argv is asserted against a fake $ALMANAC_HOME, never executed.\n\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nsource \"$ROOT/lib/loops.sh\"\n\nfail() {\n  echo \"  FAIL: $1\" >&2\n  exit 1\n}\n\nassert_eq() {\n  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n}\n\ntest_discovery_lists_present_adapters() {\n  local list\n  list=\"$(almanac_loop_adapter_list)\"\n  case \"$list\" in *ralph*) ;; *) fail \"loop list should include the ralph adapter file\" ;; esac\n  case \"$list\" in *harden*) ;; *) fail \"loop list should include the harden adapter file\" ;; esac\n  case \"$list\" in *converge*) ;; *) fail \"loop list should include the converge adapter file\" ;; esac\n","numLines":30,"startLine":1,"totalLines":155}}}
