{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XGoBQZiagq9WGmfk3QSgJy","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/harden.sh — the harden loop adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about how to launch and\n5\t# control the harden loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n6\t#\n7\t# Contract (called as almanac_loop_harden_<verb>):\n8\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n9\t#                   dispatch (no central case-statement on loop type).\n10\t#   launch_usage  — the --help text printed for this loop's launcher.\n11\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n12\t#                   for a given target/rounds. Harden's runner runs through the\n13\t#                   CLI (`almanac harden <target> --loop`).\n14\t#   new_run_argv  — emit the hub's \"new run\" launcher argv (one token per line)\n15\t#                   from key=val pairs; reviewer/role config rides on env, not\n16\t#                   argv (see new_run_env).\n17\t#   new_run_env   — emit KEY=VALUE env lines for the reviewer/role config\n18\t#                   (HARDEN_LENSES/PROVIDER/MODEL/EFFORT) so the hub never has\n19\t#                   to know harden's env prefixes.\n20\t#\n21\t# Control contract (signal_file) inherits the default `.harden-stop` /\n22\t# `.harden-steer` convention from lib/loops.sh — no adapter override needed.\n23\t#\n24\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n25\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n26\t# and the shared UI / provider seams. The launcher sources those before\n27\t# dispatching, so the adapter need not source them itself.\n28\t\n29\t# Build harden's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n30\t# it). harden has no standalone runner script — its convergence loop runs through\n31\t# the CLI (`almanac harden <target> --loop [--rounds N]`), so the adapter yields\n32\t# that bin/almanac invocation. The reviewer/role config rides on environment\n33\t# exported by the launcher, not argv. Requires $ALMANAC_HOME (set by every entry\n34\t# point).\n35\talmanac_loop_harden_exec_argv() {\n36\t  local target=\"$1\" rounds=\"${2:-}\"\n37\t  _ALMANAC_LOOP_ARGV=(bash \"$ALMANAC_HOME/bin/almanac\" harden \"$target\" --loop)\n38\t  [ -n \"$rounds\" ] && _ALMANAC_LOOP_ARGV+=(--rounds \"$rounds\")\n39\t  return 0\n40\t}\n41\t\n42\t# Interactive config + exec for the harden loop. Parses native flags, prompts\n43\t# for any missing field, exports the role-config env, and execs the runner via\n44\t# the exec_argv verb. Called by lib/loop-launcher.sh's adapter dispatch — no\n45\t# central code branches on loop type.\n46\talmanac_loop_harden_launch() {\n47\t  local target=\"\" lenses=\"\" provider=\"\" model=\"\" effort=\"\" rounds=\"\" yes=\"\"\n48\t  while [ \"$#\" -gt 0 ]; do\n49\t    case \"$1\" in\n50\t      --lenses)   shift; lenses=\"${1:-}\";   [ -n \"$lenses\" ] || _die \"--lenses requires a value\" ;;\n51\t      --provider) shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n52\t      --model)    shift; model=\"${1:-}\";    [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n53\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n54\t      --rounds)   shift; rounds=\"${1:-}\";   [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n55\t      --yes|-y) yes=1 ;;\n56\t      --help|-h) almanac_loop_harden_launch_usage; return 0 ;;\n57\t      -*) _die \"Unknown harden launch option: $1\" ;;\n58\t      *)  [ -z \"$target\" ] && target=\"$1\" || _die \"Unexpected harden argument: $1\" ;;\n59\t    esac\n60\t    shift\n61\t  done\n62\t\n63\t  [ -n \"$target\" ] || target=\"$(almanac_loop_ui_input \"Target (file / dir / PR)\")\" || return 1\n64\t  [ -n \"$target\" ] || _die \"A harden target is required.\"\n65\t\n66\t  lenses=\"$(test -n \"$lenses\" && printf '%s' \"$lenses\" || almanac_loop_ui_input \"Lenses (blank = default set)\")\" || return 1\n67\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n68\t  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n69\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n70\t  model=\"$(_almanac_launch_need_choice \"Reviewer model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n71\t  effort=\"$(_almanac_launch_need_choice \"Reviewer thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n72\t  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n73\t  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n74\t\n75\t  almanac_loop_launch_summary \"harden\" \\\n76\t    \"Target:$target\" \"Lenses:${lenses:-default set}\" \"Provider:$provider\" \\\n77\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n78\t    \"Rounds:${rounds:-default budget}\"\n79\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n80\t\n81\t  [ -n \"$lenses\" ]   && export HARDEN_LENSES=\"$lenses\"\n82\t  export HARDEN_PROVIDER=\"$provider\"\n83\t  [ -n \"$model\" ]    && export HARDEN_MODEL=\"$model\"   || unset HARDEN_MODEL\n84\t  [ -n \"$effort\" ]   && export HARDEN_EFFORT=\"$effort\" || unset HARDEN_EFFORT\n85\t\n86\t  # Exec the runner via the harden adapter (its convergence loop runs through\n87\t  # `almanac harden <target> --loop` — the adapter owns that invocation).\n88\t  almanac_loop_adapter_call harden exec_argv \"$target\" \"$rounds\" \\\n89\t    || _die \"harden adapter could not build a runner for target: $target\"\n90\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n91\t}\n92\t\n93\t# Compose the hub's new-run launcher argv for harden (one token per line). The\n94\t# convergence loop launches via `almanac harden <target> --loop [--rounds N]` —\n95\t# all other reviewer/role config rides on env (see new_run_env). Returns 2 when\n96\t# a required field (target) is missing.\n97\talmanac_loop_harden_new_run_argv() {\n98\t  local target=\"\" rounds=\"\" kv key val\n99\t  for kv in \"$@\"; do\n100\t    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n101\t    case \"$key\" in\n102\t      target) target=\"$val\" ;;\n103\t      rounds) rounds=\"$val\" ;;\n104\t    esac\n105\t  done\n106\t\n107\t  [ -n \"$target\" ] || return 2\n108\t  printf '%s\\n%s\\n%s\\n' harden \"$target\" --loop\n109\t  [ -n \"$rounds\" ] && printf '%s\\n%s\\n' --rounds \"$rounds\"\n110\t  return 0\n111\t}\n112\t\n113\t# Compose the hub's new-run env stream for harden (KEY=VALUE per line) from\n114\t# key=val pairs: reviewer lenses + role config (HARDEN_LENSES / HARDEN_PROVIDER /\n115\t# HARDEN_MODEL / HARDEN_EFFORT). Empty fields drop their key.\n116\talmanac_loop_harden_new_run_env() {\n117\t  local provider=\"\" model=\"\" effort=\"\" lenses=\"\" kv key val\n118\t  for kv in \"$@\"; do\n119\t    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n120\t    case \"$key\" in\n121\t      provider) provider=\"$val\" ;;\n122\t      model)    model=\"$val\" ;;\n123\t      effort)   effort=\"$val\" ;;\n124\t      lenses)   lenses=\"$val\" ;;\n125\t    esac\n126\t  done\n127\t  [ -n \"$lenses\" ]   && printf 'HARDEN_LENSES=%s\\n' \"$lenses\"\n128\t  [ -n \"$provider\" ] && printf 'HARDEN_PROVIDER=%s\\n' \"$provider\"\n129\t  [ -n \"$model\" ]    && printf 'HARDEN_MODEL=%s\\n' \"$model\"\n130\t  [ -n \"$effort\" ]   && printf 'HARDEN_EFFORT=%s\\n' \"$effort\"\n131\t  return 0\n132\t}\n133\t\n134\t# Read a harden run's status blob and emit the key=val pairs that\n135\t# almanac_loop_harden_new_run_argv / _new_run_env consume — the inverse of those\n136\t# composers. Resume / clone in the hub pipes the output straight to them, so the\n137\t# hub never has to know harden's status schema (it used to; this verb is the\n138\t# deepening that makes the hub loop-agnostic).\n139\talmanac_loop_harden_status_to_opts() {\n140\t  local status_file=\"$1\"\n141\t  local target lenses provider model effort rounds\n142\t  target=\"$(almanac_loop_status_field \"$status_file\" target || true)\"\n143\t  lenses=\"$(almanac_loop_status_field \"$status_file\" lenses || true)\"\n144\t  provider=\"$(almanac_loop_status_field \"$status_file\" provider || true)\"\n145\t  model=\"$(almanac_loop_status_field \"$status_file\" model || true)\"\n146\t  effort=\"$(almanac_loop_status_field \"$status_file\" effort || true)\"\n147\t  rounds=\"$(almanac_loop_status_field \"$status_file\" rounds || true)\"\n148\t\n149\t  [ -n \"$target\" ]   && printf '%s\\n' \"target=$target\"\n150\t  [ -n \"$lenses\" ]   && printf '%s\\n' \"lenses=$lenses\"\n151\t  [ -n \"$provider\" ] && printf '%s\\n' \"provider=$provider\"\n152\t  [ -n \"$model\" ]    && printf '%s\\n' \"model=$model\"\n153\t  [ -n \"$effort\" ]   && printf '%s\\n' \"effort=$effort\"\n154\t  [ -n \"$rounds\" ]   && printf '%s\\n' \"rounds=$rounds\"\n155\t  return 0\n156\t}\n157\t\n158\t# --help text for `almanac harden --loop` / `almanac_loop_launch harden`. Stays\n159\t# inside the adapter so adding a loop is a one-file change.\n160\talmanac_loop_harden_launch_usage() {\n161\t  cat >&2 <<'EOF'\n162\tUsage (loop launch): <target> [options]\n163\t  <target>            file / dir / PR to harden\n164\t  --lenses <list>     reviewer lenses (blank = default set)\n165\t  --provider <p>      codex | claude\n166\t  --model <m>         reviewer model\n167\t  --effort <l>        reviewer thinking level\n168\t  --rounds <n>        round budget\n169\tAny option not given is prompted interactively.\n170\tEOF\n171\t}\n172\t"}]},"parent_tool_use_id":"toolu_01RZGwwDRZp9MotZJ6b26mSg","session_id":"92d47660-4965-47f1-a4d3-fc4dbbc15bee","uuid":"668984c6-825a-4c85-b25f-9d4c3e293fd5","timestamp":"2026-05-27T06:31:30.184Z","subagent_type":"Explore","task_description":"Codebase friction survey"}
