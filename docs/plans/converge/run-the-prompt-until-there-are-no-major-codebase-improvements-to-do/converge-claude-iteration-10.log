{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EYWJ8VN7NvAaH3AMnKHWej","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# test-agent.sh - agent run-shape tests (lib/agent.sh)\n3\t#\n4\t# Sources lib/agent.sh DIRECTLY (not through loop-core) so the three run shapes —\n5\t# almanac_loop_agent_capture / _stream / _raw — are their own test surface. Each\n6\t# shape runs behind a FAKE provider: a temp bin holds fake `codex`/`claude`\n7\t# executables that emit the same event-stream shape the real adapters parse, so no\n8\t# real model is ever called. The provider-adapter seam itself (discovery, argv,\n9\t# filter, default-selection) is covered by test-providers.sh.\n10\t\n11\tset -euo pipefail\n12\t\n13\tROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n14\tsource \"$ROOT/lib/agent.sh\"\n15\t\n16\tTMPDIRS=()\n17\tNEW_TMPDIR=\"\"\n18\t\n19\tcleanup() {\n20\t  local dir\n21\t  [ \"${#TMPDIRS[@]}\" -eq 0 ] && return 0\n22\t  for dir in \"${TMPDIRS[@]}\"; do\n23\t    rm -rf \"$dir\"\n24\t  done\n25\t}\n26\ttrap cleanup EXIT\n27\t\n28\tfail() {\n29\t  echo \"  FAIL: $1\" >&2\n30\t  exit 1\n31\t}\n32\t\n33\tassert_eq() {\n34\t  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n35\t  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n36\t}\n37\t\n38\tassert_contains() {\n39\t  local haystack=\"$1\" needle=\"$2\" message=\"$3\"\n40\t  case \"$haystack\" in\n41\t    *\"$needle\"*) ;;\n42\t    *) fail \"$message (looking for '$needle')\" ;;\n43\t  esac\n44\t}\n45\t\n46\tassert_file_contains() {\n47\t  local file=\"$1\" needle=\"$2\" message=\"$3\"\n48\t  grep -Fq -- \"$needle\" \"$file\" || fail \"$message\"\n49\t}\n50\t\n51\tnew_tmpdir() {\n52\t  NEW_TMPDIR=$(mktemp -d)\n53\t  TMPDIRS+=(\"$NEW_TMPDIR\")\n54\t}\n55\t\n56\t# --- Fake providers ------------------------------------------------------------\n57\t# Each emits the event-stream shape its real adapter parses, records its argv to a\n58\t# log, and (codex) writes its --output-last-message result. PATH puts the fake\n59\t# first so it shadows any real codex/claude on the host.\n60\t\n61\twrite_fake_codex_agent() {\n62\t  local fakebin=\"$1\" args_log=\"$2\"\n63\t  mkdir -p \"$fakebin\"\n64\t  cat > \"$fakebin/codex\" <<EOF\n65\t#!/usr/bin/env bash\n66\tset -euo pipefail\n67\t\n68\tprintf '%s\\n' \"\\$*\" > \"$args_log\"\n69\tresult_file=\"\"\n70\tprompt=\"\"\n71\twhile [ \"\\$#\" -gt 0 ]; do\n72\t  case \"\\$1\" in\n73\t    --output-last-message)\n74\t      shift\n75\t      result_file=\"\\${1:-}\"\n76\t      ;;\n77\t    *)\n78\t      prompt=\"\\$1\"\n79\t      ;;\n80\t  esac\n81\t  shift || true\n82\tdone\n83\t\n84\t[ -n \"\\$result_file\" ] && printf '%s\\n' \"codex final: \\$prompt\" > \"\\$result_file\"\n85\tprintf '%s\\n' '{\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"codex event\"}}'\n86\tprintf '%s\\n' '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"codex streamed: hardened\"}}'\n87\tEOF\n88\t  chmod +x \"$fakebin/codex\"\n89\t}\n90\t\n91\twrite_fake_claude_agent() {\n92\t  local fakebin=\"$1\" args_log=\"$2\"\n93\t  mkdir -p \"$fakebin\"\n94\t  cat > \"$fakebin/claude\" <<EOF\n95\t#!/usr/bin/env bash\n96\tset -euo pipefail\n97\t\n98\tprintf '%s\\n' \"\\$*\" > \"$args_log\"\n99\tprintf '%s\\n' '{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"claude event\"}]}}'\n100\tprintf '%s\\n' '{\"type\":\"result\",\"result\":\"claude final\"}'"}]},"parent_tool_use_id":"toolu_01RZGwwDRZp9MotZJ6b26mSg","session_id":"92d47660-4965-47f1-a4d3-fc4dbbc15bee","uuid":"de60e8e1-4754-493c-93f1-498db5d76739","timestamp":"2026-05-27T06:31:43.561Z","subagent_type":"Explore","task_description":"Codebase friction survey"}
