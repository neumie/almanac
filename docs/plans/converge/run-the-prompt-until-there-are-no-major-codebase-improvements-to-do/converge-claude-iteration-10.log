{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S22z6JLwzit9RgpRkkLqw3","type":"tool_result","content":"100\t# Dispatched to the loop adapter's `launch_usage` verb — no central case-statement\n101\t# on loop type. Adding a new loop puts its usage text in lib/loops/<name>.sh\n102\t# alongside its launch verb. A missing adapter or missing verb is a no-op so\n103\t# `--help` for an unknown loop fails through to the launcher's usage error\n104\t# rather than crashing.\n105\talmanac_loop_launch_usage() {\n106\t  local type=\"${1:-}\"\n107\t  [ -n \"$type\" ] || return 0\n108\t  almanac_loop_adapter_known \"$type\" || return 0\n109\t  local fn\n110\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch_usage\"\n111\t  declare -F \"$fn\" >/dev/null 2>&1 && \"$fn\"\n112\t}\n113\t\n114\t# Public entry: configure and launch a run of TYPE (ralph|harden|converge|…).\n115\t# Remaining args are that type's native flags; missing fields are prompted by\n116\t# the adapter's `launch` verb, which also execs the runner. The launcher does\n117\t# not enumerate loop types — discovery is via the loop-adapter seam, so adding\n118\t# a new loop is a single new file in lib/loops/. We resolve the launch verb's\n119\t# function name and invoke it directly (rather than going through\n120\t# almanac_loop_adapter_call) so a missing verb is a hard die — the launch\n121\t# function itself may legitimately exit non-zero (user cancelled / validation\n122\t# error), and adapter_call's \"verb missing\" rc=2 would collide with those.\n123\talmanac_loop_launch() {\n124\t  local type=\"${1:-}\"; shift || true\n125\t  [ -n \"$type\" ] || _die \"Usage: almanac_loop_launch <loop> [options] (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n126\t  almanac_loop_adapter_known \"$type\" || _die \"Unknown loop type: $type (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n127\t  local fn\n128\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch\"\n129\t  declare -F \"$fn\" >/dev/null 2>&1 || _die \"Loop adapter '$type' does not implement the launch verb\"\n130\t  \"$fn\" \"$@\"\n131\t}\n132\t"}]},"parent_tool_use_id":"toolu_01RZGwwDRZp9MotZJ6b26mSg","session_id":"92d47660-4965-47f1-a4d3-fc4dbbc15bee","uuid":"1d97e73c-dc8a-457a-a27c-f26998235113","timestamp":"2026-05-27T06:31:44.300Z","subagent_type":"Explore","task_description":"Codebase friction survey"}
