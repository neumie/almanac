{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NXYcWBXQSPzPNzr8r7VDDt","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# role.sh - Role config resolution (role -> provider/model/effort)\n3\t#\n4\t# A role is a configurable slot a loop fills with an agent config: ralph's\n5\t# `agent`; harden's `conductor`/`reviewer`/`fixer`. Resolution layers most\n6\t# specific first — lens -> role -> consumer-wide -> default — over env keys\n7\t# named <PREFIX>[_<ROLE>][_<LENS>]_<FIELD> (uppercased, non-alnum -> `_`).\n8\t#\n9\t# Self-contained like lib/ui.sh / lib/run.sh: uses only printf/tr/sed and bash\n10\t# indirect expansion (no lib/core.sh dependency), so this file's interface is its\n11\t# own test surface (tests/test-role.sh). Callers source it directly.\n12\t\n13\t# A single env-key component: uppercased, runs of non-alphanumerics collapsed to\n14\t# one `_`, leading/trailing `_` trimmed. Joined with `_` to form a candidate key.\n15\talmanac_loop_env_key_part() {\n16\t  printf '%s' \"$1\" \\\n17\t    | tr '[:lower:]' '[:upper:]' \\\n18\t    | sed 's/[^A-Z0-9][^A-Z0-9]*/_/g; s/^_//; s/_$//'\n19\t}\n20\t\n21\t# Echo an env var's value if it is SET (even when empty), returning 0; return 1\n22\t# when the name is unset. The `+x` test distinguishes set-empty from unset so an\n23\t# explicitly-empty override wins over a more general layer.\n24\talmanac_loop_env_value() {\n25\t  local name=\"$1\"\n26\t\n27\t  if [ \"${!name+x}\" ]; then\n28\t    printf '%s\\n' \"${!name}\"\n29\t    return 0\n30\t  fi\n31\t\n32\t  return 1\n33\t}\n34\t\n35\t# Resolve one field of a role's config, most specific layer first:\n36\t#   <PREFIX>_<ROLE>_<LENS>_<FIELD> -> <PREFIX>_<ROLE>_<FIELD>\n37\t#   -> <PREFIX>_<FIELD> -> default_value\n38\t# The lens layer is skipped when lens is empty. Returns 2 on missing args.\n39\talmanac_loop_role_field() {\n40\t  [ \"$#\" -ge 5 ] || return 2\n41\t\n42\t  local prefix=\"$1\"\n43\t  local role=\"$2\"\n44\t  local lens=\"$3\"\n45\t  local field=\"$4\"\n46\t  local default_value=\"$5\"\n47\t  local prefix_key role_key lens_key field_key candidate value\n48\t\n49\t  prefix_key=\"$(almanac_loop_env_key_part \"$prefix\")\"\n50\t  role_key=\"$(almanac_loop_env_key_part \"$role\")\"\n51\t  lens_key=\"$(almanac_loop_env_key_part \"$lens\")\"\n52\t  field_key=\"$(almanac_loop_env_key_part \"$field\")\"\n53\t\n54\t  if [ -n \"$lens_key\" ]; then\n55\t    candidate=\"${prefix_key}_${role_key}_${lens_key}_${field_key}\"\n56\t    if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n57\t      printf '%s\\n' \"$value\"\n58\t      return 0\n59\t    fi\n60\t  fi\n61\t\n62\t  candidate=\"${prefix_key}_${role_key}_${field_key}\"\n63\t  if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n64\t    printf '%s\\n' \"$value\"\n65\t    return 0\n66\t  fi\n67\t\n68\t  candidate=\"${prefix_key}_${field_key}\"\n69\t  if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n70\t    printf '%s\\n' \"$value\"\n71\t    return 0\n72\t  fi\n73\t\n74\t  printf '%s\\n' \"$default_value\"\n75\t}\n76\t\n77\t# Resolve a role's full (provider, model, effort) config as three TSV rows, each\n78\t# field resolved through almanac_loop_role_field with its own default. Returns 2\n79\t# on missing args.\n80\talmanac_loop_role_config() {\n81\t  [ \"$#\" -ge 2 ] || return 2\n82\t\n83\t  local prefix=\"$1\"\n84\t  local role=\"$2\"\n85\t  local lens=\"${3:-}\"\n86\t  local default_provider=\"${4:-}\"\n87\t  local default_model=\"${5:-}\"\n88\t  local default_effort=\"${6:-}\"\n89\t\n90\t  printf 'provider\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"provider\" \"$default_provider\")\"\n91\t  printf 'model\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"model\" \"$default_model\")\"\n92\t  printf 'effort\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"effort\" \"$default_effort\")\"\n93\t}\n94\t"}]},"parent_tool_use_id":null,"session_id":"92d47660-4965-47f1-a4d3-fc4dbbc15bee","uuid":"40b49fdd-0f49-4b2c-a0e7-ccdc6bff8ccb","timestamp":"2026-05-27T06:32:45.912Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/role.sh","content":"#!/usr/bin/env bash\n# role.sh - Role config resolution (role -> provider/model/effort)\n#\n# A role is a configurable slot a loop fills with an agent config: ralph's\n# `agent`; harden's `conductor`/`reviewer`/`fixer`. Resolution layers most\n# specific first — lens -> role -> consumer-wide -> default — over env keys\n# named <PREFIX>[_<ROLE>][_<LENS>]_<FIELD> (uppercased, non-alnum -> `_`).\n#\n# Self-contained like lib/ui.sh / lib/run.sh: uses only printf/tr/sed and bash\n# indirect expansion (no lib/core.sh dependency), so this file's interface is its\n# own test surface (tests/test-role.sh). Callers source it directly.\n\n# A single env-key component: uppercased, runs of non-alphanumerics collapsed to\n# one `_`, leading/trailing `_` trimmed. Joined with `_` to form a candidate key.\nalmanac_loop_env_key_part() {\n  printf '%s' \"$1\" \\\n    | tr '[:lower:]' '[:upper:]' \\\n    | sed 's/[^A-Z0-9][^A-Z0-9]*/_/g; s/^_//; s/_$//'\n}\n\n# Echo an env var's value if it is SET (even when empty), returning 0; return 1\n# when the name is unset. The `+x` test distinguishes set-empty from unset so an\n# explicitly-empty override wins over a more general layer.\nalmanac_loop_env_value() {\n  local name=\"$1\"\n\n  if [ \"${!name+x}\" ]; then\n    printf '%s\\n' \"${!name}\"\n    return 0\n  fi\n\n  return 1\n}\n\n# Resolve one field of a role's config, most specific layer first:\n#   <PREFIX>_<ROLE>_<LENS>_<FIELD> -> <PREFIX>_<ROLE>_<FIELD>\n#   -> <PREFIX>_<FIELD> -> default_value\n# The lens layer is skipped when lens is empty. Returns 2 on missing args.\nalmanac_loop_role_field() {\n  [ \"$#\" -ge 5 ] || return 2\n\n  local prefix=\"$1\"\n  local role=\"$2\"\n  local lens=\"$3\"\n  local field=\"$4\"\n  local default_value=\"$5\"\n  local prefix_key role_key lens_key field_key candidate value\n\n  prefix_key=\"$(almanac_loop_env_key_part \"$prefix\")\"\n  role_key=\"$(almanac_loop_env_key_part \"$role\")\"\n  lens_key=\"$(almanac_loop_env_key_part \"$lens\")\"\n  field_key=\"$(almanac_loop_env_key_part \"$field\")\"\n\n  if [ -n \"$lens_key\" ]; then\n    candidate=\"${prefix_key}_${role_key}_${lens_key}_${field_key}\"\n    if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n      printf '%s\\n' \"$value\"\n      return 0\n    fi\n  fi\n\n  candidate=\"${prefix_key}_${role_key}_${field_key}\"\n  if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n    printf '%s\\n' \"$value\"\n    return 0\n  fi\n\n  candidate=\"${prefix_key}_${field_key}\"\n  if value=\"$(almanac_loop_env_value \"$candidate\")\"; then\n    printf '%s\\n' \"$value\"\n    return 0\n  fi\n\n  printf '%s\\n' \"$default_value\"\n}\n\n# Resolve a role's full (provider, model, effort) config as three TSV rows, each\n# field resolved through almanac_loop_role_field with its own default. Returns 2\n# on missing args.\nalmanac_loop_role_config() {\n  [ \"$#\" -ge 2 ] || return 2\n\n  local prefix=\"$1\"\n  local role=\"$2\"\n  local lens=\"${3:-}\"\n  local default_provider=\"${4:-}\"\n  local default_model=\"${5:-}\"\n  local default_effort=\"${6:-}\"\n\n  printf 'provider\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"provider\" \"$default_provider\")\"\n  printf 'model\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"model\" \"$default_model\")\"\n  printf 'effort\\t%s\\n' \"$(almanac_loop_role_field \"$prefix\" \"$role\" \"$lens\" \"effort\" \"$default_effort\")\"\n}\n","numLines":94,"startLine":1,"totalLines":94}}}
