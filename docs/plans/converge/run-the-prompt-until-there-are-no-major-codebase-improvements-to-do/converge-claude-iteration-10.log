{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012959mPRCBA9YmBUcHr3qzN","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# run.sh — the run registry: the run-status record, registry, control, worker\n3\t# health, and the hub's read views, owned in one module (per CONTEXT.md's module\n4\t# map). loop-core.sh (the old god-module) is deleted; this is where its registry/\n5\t# control/worker-health/hub-view concerns now live (the worker orchestration /\n6\t# background fan-out lives in lib/worker.sh).\n7\t#\n8\t# A run-status *record* is a per-run status.tsv — one `key<TAB>value` line per\n9\t# field. This module owns the CANONICAL FIELD LIST and the only set/get-by-name\n10\t# accessors for it, so the run-status contract — every run (ralph or harden)\n11\t# carries exactly this key set, in this order — is enforced *by construction*:\n12\t# a caller names only the fields it has values for; the record fills in the rest,\n13\t# and no writer ever enumerates the schema by hand.\n14\t#\n15\t# No lib/core.sh dependency (uses only printf/read/awk/etc), so the record +\n16\t# registry are their own test surface — tests/test-run.sh sources this file\n17\t# directly. The hub read-views compose the gum-or-plain UI seam (lib/ui.sh) and\n18\t# the per-run control dispatches each loop's signal files through its adapter\n19\t# (lib/loops.sh), so source those two idempotently — they are self-contained\n20\t# (no core.sh) too. pwd -P resolves the install symlink so the siblings are found\n21\t# from either path.\n22\tif ! declare -F almanac_loop_ui_render >/dev/null 2>&1; then\n23\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t  # shellcheck source=lib/ui.sh\n25\t  source \"$__run_dir/ui.sh\"\n26\t  unset __run_dir\n27\tfi\n28\t\n29\tif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n30\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n31\t  # shellcheck source=lib/loops.sh\n32\t  source \"$__run_dir/loops.sh\"\n33\t  unset __run_dir\n34\tfi\n35\t\n36\t# THE single source of truth for the run-status schema: the canonical field list\n37\t# in write order. record_set iterates exactly this list, so every record carries\n38\t# the same keys regardless of which subset a caller supplies. The first seven are\n39\t# also the registry's index.tsv columns (the lightweight list pointer); the last\n40\t# three (finished_at/round/summary) are the per-run detail the index omits.\n41\talmanac_loop_record_fields() {\n42\t  printf '%s\\n' \\\n43\t    id type target pid status_file started_at status finished_at round summary failure_reason \\\n44\t    provider model effort iterations oversee lenses rounds queue_progress\n45\t}\n46\t\n47\t# Get one field from a record FILE by name. Prints the value (which may itself\n48\t# contain tabs — reassembled from the trailing columns) and returns 0; returns 1\n49\t# when the field is absent. This is the generic tab-field reader for the run\n50\t# registry; almanac_loop_status_field (below) is a thin alias over it for the\n51\t# worker-status and hub read paths.\n52\talmanac_loop_record_get() {\n53\t  local file=\"$1\" wanted=\"$2\" key value rest\n54\t\n55\t  while IFS=$'\\t' read -r key value rest; do\n56\t    if [ \"$key\" = \"$wanted\" ]; then\n57\t      if [ -n \"${rest:-}\" ]; then\n58\t        value=\"${value}\"$'\\t'\"${rest}\"\n59\t      fi\n60\t      printf '%s\\n' \"$value\"\n61\t      return 0\n62\t    fi\n63\t  done < \"$file\"\n64\t\n65\t  return 1\n66\t}\n67\t\n68\t# Generic TSV record engine: rewrite FILE with the schema in FIELDS_TEXT, in\n69\t# canonical order, with each (existing) field preserved unless overridden by a\n70\t# `field=value` PAIR. This is the deep module that owns the round-trip algorithm\n71\t# — schema-specific wrappers (record_set for run-status, worker_record_set for\n72\t# worker-status) just supply their own field list. Returns 2 on a missing file\n73\t# argument or a pair whose field isn't in FIELDS_TEXT.\n74\talmanac_loop_tsv_record_set() {\n75\t  local fields_text=\"$1\" file=\"$2\"\n76\t  shift 2 || return 2\n77\t  [ -n \"$file\" ] || return 2\n78\t\n79\t  local pair pfield field cur val out=\"\"\n80\t  local have_file=0\n81\t  if [ -f \"$file\" ]; then\n82\t    have_file=1\n83\t  fi\n84\t\n85\t  for pair in \"$@\"; do\n86\t    pfield=\"${pair%%=*}\"\n87\t    almanac_loop_tsv_has_field \"$fields_text\" \"$pfield\" || return 2\n88\t  done\n89\t\n90\t  while IFS= read -r field; do\n91\t    [ -n \"$field\" ] || continue\n92\t    cur=\"\"\n93\t    if [ \"$have_file\" = 1 ]; then\n94\t      cur=\"$(almanac_loop_record_get \"$file\" \"$field\" || true)\"\n95\t    fi\n96\t    val=\"$cur\"\n97\t    for pair in \"$@\"; do\n98\t      pfield=\"${pair%%=*}\"\n99\t      if [ \"$pfield\" = \"$field\" ]; then\n100\t        val=\"${pair#*=}\"\n101\t      fi\n102\t    done\n103\t    out=\"${out}${field}\"$'\\t'\"${val}\"$'\\n'\n104\t  done <<< \"$fields_text\"\n105\t\n106\t  printf '%s' \"$out\" > \"$file\"\n107\t}\n108\t\n109\t# True when NAME appears as a field in FIELDS_TEXT (newline-separated schema).\n110\talmanac_loop_tsv_has_field() {\n111\t  local fields_text=\"$1\" wanted=\"$2\" field\n112\t  while IFS= read -r field; do\n113\t    [ \"$field\" = \"$wanted\" ] && return 0\n114\t  done <<< \"$fields_text\"\n115\t  return 1\n116\t}\n117\t\n118\t# True when NAME is a canonical run-status field. Lets record_set reject a typo\n119\t# rather than silently writing a key no reader ever looks for.\n120\talmanac_loop_record_has_field() {\n121\t  almanac_loop_tsv_has_field \"$(almanac_loop_record_fields)\" \"$1\"\n122\t}\n123\t\n124\t# Set one or more run-status fields by name, round-tripping the rest. Each\n125\t# argument is a `field=value` pair (the value may itself contain `=`). The record\n126\t# is rewritten with the FULL canonical key set in canonical order: every\n127\t# canonical field already in the file is preserved unless overridden, and a\n128\t# not-yet-existing file is initialised with every key (blank where unset). So\n129\t# `register` seeds the record by naming only its known fields, while\n130\t# `mark`/`update` change only theirs and leave the rest intact — no caller\n131\t# enumerates the schema. Returns 2 on a missing file argument or a `field=value`\n132\t# whose field is not canonical.\n133\talmanac_loop_record_set() {\n134\t  almanac_loop_tsv_record_set \"$(almanac_loop_record_fields)\" \"$@\"\n135\t}\n136\t\n137\talmanac_loop_slug() {\n138\t  local raw=\"$1\"\n139\t  local slug\n140\t\n141\t  slug=\"$(printf '%s' \"$raw\" \\\n142\t    | tr '[:upper:]' '[:lower:]' \\\n143\t    | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')\"\n144\t\n145\t  if [ -z \"$slug\" ]; then\n146\t    slug=\"run\"\n147\t  fi\n148\t\n149\t  printf '%s\\n' \"$slug\"\n150\t}\n151\t\n152\t# A loop's plan dir: <root>/docs/plans/<type>/<slug>. Each loop's plan/rubric/\n153\t# ledger paths compose off this, so the docs/plans/<type>/<slug> prefix lives in\n154\t# exactly one place. Caller supplies an already-slugified key (loops use\n155\t# almanac_loop_slug) so this stays a pure path joiner — no second slug pass\n156\t# muddying the contract.\n157\talmanac_loop_plan_dir() {\n158\t  local type=\"$1\"\n159\t  local root=\"$2\"\n160\t  local slug=\"$3\"\n161\t\n162\t  printf '%s/docs/plans/%s/%s\\n' \"$root\" \"$type\" \"$slug\"\n163\t}\n164\t\n165\talmanac_loop_now_utc() {\n166\t  date -u '+%Y-%m-%dT%H:%M:%SZ'\n167\t}\n168\t\n169\talmanac_loop_run_id() {\n170\t  local type=\"$1\"\n171\t  local target=\"$2\"\n172\t  local compact_now\n173\t\n174\t  compact_now=\"$(date -u '+%Y%m%dT%H%M%SZ')\"\n175\t  printf '%s-%s-%s-%s\\n' \\\n176\t    \"$(almanac_loop_slug \"$type\")\" \\\n177\t    \"$(almanac_loop_slug \"$target\")\" \\\n178\t    \"$compact_now\" \\\n179\t    \"$$\"\n180\t}\n181\t\n182\talmanac_loop_registry_dir() {\n183\t  local root=\"${1:-.}\"\n184\t\n185\t  if [ \"$root\" != \"/\" ]; then\n186\t    root=\"${root%/}\"\n187\t  fi\n188\t\n189\t  printf '%s/.almanac/runs\\n' \"$root\"\n190\t}\n191\t\n192\talmanac_loop_run_status_file() {\n193\t  local root=\"$1\"\n194\t  local run_id=\"$2\"\n195\t\n196\t  printf '%s/%s/status.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\" \"$run_id\"\n197\t}\n198\t\n199\talmanac_loop_run_status_relpath() {\n200\t  local run_id=\"$1\"\n201\t\n202\t  printf '.almanac/runs/%s/status.tsv\\n' \"$run_id\"\n203\t}\n204\t\n205\talmanac_loop_run_index_file() {\n206\t  local root=\"$1\"\n207\t\n208\t  printf '%s/index.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\"\n209\t}\n210\t\n211\t# The run's status.tsv blob — the per-run detail view the hub reads — is the\n212\t# run-status RECORD: its canonical field list and the set/get-by-name accessors\n213\t# (almanac_loop_record_*) live above. The registry functions below seed and\n214\t# update it through that record, so the schema (id/type/target/pid/\n215\t# status_file/started_at/status + the live finished_at/round/summary) is never\n216\t# enumerated here. The index.tsv is a separate lightweight list pointer (the\n217\t# record's first seven fields), written below.\n218\t\n219\t# Thin alias for the record's generic tab-field reader, kept for the worker-status\n220\t# and hub read paths that read a field by name. The implementation (and the\n221\t# run-status record's canonical getter) is almanac_loop_record_get, above.\n222\talmanac_loop_status_field() {\n223\t  almanac_loop_record_get \"$@\"\n224\t}\n225\t\n226\talmanac_loop_register_run() {\n227\t  [ \"$#\" -ge 4 ] || return 2\n228\t\n229\t  local root=\"$1\"\n230\t  local type=\"$2\"\n231\t  local target=\"$3\"\n232\t  local pid=\"$4\"\n233\t  local run_id=\"${5:-}\"\n234\t  local started_at=\"${6:-}\"\n235\t  local registry_dir run_dir status_file status_rel index_file\n236\t\n237\t  [ -n \"$root\" ] || return 2\n238\t  [ -n \"$type\" ] || return 2\n239\t  [ -n \"$target\" ] || return 2\n240\t  [ -n \"$pid\" ] || return 2\n241\t\n242\t  if [ -z \"$run_id\" ]; then\n243\t    run_id=\"$(almanac_loop_run_id \"$type\" \"$target\")\"\n244\t  fi\n245\t\n246\t  if [ -z \"$started_at\" ]; then\n247\t    started_at=\"$(almanac_loop_now_utc)\"\n248\t  fi\n249\t\n250\t  registry_dir=\"$(almanac_loop_registry_dir \"$root\")\"\n251\t  run_dir=\"$registry_dir/$run_id\"\n252\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n253\t  status_rel=\"$(almanac_loop_run_status_relpath \"$run_id\")\"\n254\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n255\t\n256\t  if [ -e \"$run_dir\" ]; then\n257\t    return 3\n258\t  fi\n259\t\n260\t  mkdir -p \"$run_dir\"\n261\t\n262\t  if [ ! -f \"$index_file\" ]; then\n263\t    printf 'id\\ttype\\ttarget\\tpid\\tstatus_file\\tstarted_at\\tstatus\\n' > \"$index_file\"\n264\t  fi\n265\t\n266\t  # Seed the run-status record by naming only the fields known at launch; the\n267\t  # record fills the rest (finished_at/round/summary blank) from the canonical\n268\t  # schema. The index row is the lightweight pointer (the record's first seven\n269\t  # fields).\n270\t  almanac_loop_record_set \"$status_file\" \"id=$run_id\" \"type=$type\" \"target=$target\" \"pid=$pid\" \"status_file=$status_rel\" \"started_at=$started_at\" \"status=running\"\n271\t  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$run_id\" \"$type\" \"$target\" \"$pid\" \"$status_rel\" \"$started_at\" \"running\" >> \"$index_file\"\n272\t  printf '%s\\n' \"$run_id\"\n273\t}\n274\t\n275\t# Set config fields on a run after registration. Thin convenience over record_set\n276\t# that names intent: \"store the resolved launch config so resume can rebuild it.\"\n277\t# Accepts any subset of the config keys (provider/model/effort/iterations/oversee\n278\t# for ralph; provider/model/effort/lenses/rounds for harden). Blank values are\n279\t# acceptable — record_set keeps the field present-but-blank. Returns 2 when the\n280\t# run is unknown so callers can guard without aborting.\n281\talmanac_loop_set_run_config() {\n282\t  [ \"$#\" -ge 3 ] || return 2\n283\t  local root=\"$1\" run_id=\"$2\"; shift 2\n284\t  local status_file\n285\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n286\t  [ -f \"$status_file\" ] || return 2\n287\t  almanac_loop_record_set \"$status_file\" \"$@\"\n288\t}\n289\t\n290\talmanac_loop_mark_run_status() {\n291\t  [ \"$#\" -ge 3 ] || return 2\n292\t\n293\t  local root=\"$1\"\n294\t  local run_id=\"$2\"\n295\t  local status=\"$3\"\n296\t  local finished_at=\"${4:-}\"\n297\t  local reason=\"${5:-}\"\n298\t  local status_file index_file tmp\n299\t\n300\t  case \"$status\" in\n301\t    done|failed|aborted) ;;\n302\t    *) return 3 ;;\n303\t  esac\n304\t\n305\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n306\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n307\t\n308\t  [ -f \"$status_file\" ] || return 2\n309\t  [ -f \"$index_file\" ] || return 2\n310\t\n311\t  if [ -z \"$finished_at\" ]; then\n312\t    finished_at=\"$(almanac_loop_now_utc)\"\n313\t  fi\n314\t\n315\t  tmp=\"$(mktemp \"${index_file}.XXXXXX\")\"\n316\t  if ! awk -v run_id=\"$run_id\" -v status=\"$status\" '\n317\t    BEGIN { FS = OFS = \"\\t\" }\n318\t    NR == 1 { print; next }\n319\t    $1 == run_id { $7 = status; found = 1 }\n320\t    { print }\n321\t    END { if (!found) exit 4 }\n322\t  ' \"$index_file\" > \"$tmp\"; then\n323\t    rm -f \"$tmp\"\n324\t    return 2\n325\t  fi\n326\t  mv \"$tmp\" \"$index_file\"\n327\t\n328\t  # Set only the lifecycle fields; record_set round-trips id/type/target/pid/\n329\t  # status_file/started_at/round/summary, so the schema is never re-enumerated.\n330\t  # An optional 5th arg supplies a one-line failure reason (typically \"exit=N\"\n331\t  # plus a log-tail hint) so the hub can show *why* a run failed, not just that\n332\t  # it did. Blank reason → leave the field as-is (running runs start blank).\n333\t  local _fields=(\"status=$status\" \"finished_at=$finished_at\")\n334\t  [ -n \"$reason\" ] && _fields+=(\"failure_reason=$reason\")\n335\t  almanac_loop_record_set \"$status_file\" \"${_fields[@]}\"\n336\t  # Best-effort end-of-run notification (macOS osascript / Linux notify-send /\n337\t  # terminal-bell fallback). Opt out via ALMANAC_NO_NOTIFY=1. Notification\n338\t  # trouble never sinks the mark — if osascript is missing or notify-send\n339\t  # errors, the run is still correctly marked.\n340\t  almanac_loop_notify_run_end \"$root\" \"$run_id\" >/dev/null 2>&1 || true\n341\t}\n342\t\n343\t# Tell the user a run reached a terminal state. Reads the just-written record so\n344\t# the notification carries type/status/target (and failure_reason on a failed\n345\t# run). Dispatch order: macOS osascript → Linux notify-send → terminal bell\n346\t# fallback (so you at least *hear* a finish on a bare server). Opt out entirely\n347\t# with ALMANAC_NO_NOTIFY=1. ALMANAC_NOTIFY_TEST_SINK (a file path) replaces the\n348\t# OS dispatcher with a write to that file, so tests can assert title+body\n349\t# without a desktop environment.\n350\talmanac_loop_notify_run_end() {\n351\t  [ -z \"${ALMANAC_NO_NOTIFY:-}\" ] || return 0\n352\t  # Skip when there's no terminal attached (tests, daemons, captured output) —\n353\t  # nobody to notify. The test sink bypasses this so unit tests can still assert\n354\t  # the dispatch path without a TTY.\n355\t  if [ -z \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n356\t    [ -t 2 ] || return 0\n357\t  fi\n358\t  local root=\"$1\" run_id=\"$2\"\n359\t  local status_file type status target reason title body body_esc title_esc\n360\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\" 2>/dev/null)\" || return 0\n361\t  [ -f \"$status_file\" ] || return 0\n362\t  type=\"$(almanac_loop_status_field \"$status_file\" type 2>/dev/null || true)\"\n363\t  status=\"$(almanac_loop_status_field \"$status_file\" status 2>/dev/null || true)\"\n364\t  target=\"$(almanac_loop_status_field \"$status_file\" target 2>/dev/null || true)\"\n365\t  reason=\"$(almanac_loop_status_field \"$status_file\" failure_reason 2>/dev/null || true)\"\n366\t  case \"$status\" in done|failed|aborted) ;; *) return 0 ;; esac\n367\t  title=\"almanac · ${type:-run} ${status}\"\n368\t  body=\"${target}${reason:+ — $reason}\"\n369\t  if [ -n \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n370\t    printf '%s|%s\\n' \"$title\" \"$body\" >> \"$ALMANAC_NOTIFY_TEST_SINK\"\n371\t    return 0\n372\t  fi\n373\t  if command -v osascript >/dev/null 2>&1; then\n374\t    body_esc=\"$(printf '%s' \"$body\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n375\t    title_esc=\"$(printf '%s' \"$title\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n376\t    osascript -e \"display notification \\\"$body_esc\\\" with title \\\"$title_esc\\\"\" >/dev/null 2>&1 || true\n377\t  elif command -v notify-send >/dev/null 2>&1; then\n378\t    notify-send \"$title\" \"$body\" >/dev/null 2>&1 || true\n379\t  else\n380\t    printf '\\a' >&2 || true\n381\t  fi\n382\t}\n383\t\n384\t# Update a live run's progress mid-flight: rewrite its status.tsv with a new\n385\t# round (harden round / ralph iteration) and worker/lens summary, preserving the\n386\t# lifecycle status, start, and finish fields. This is the \"updated as it\n387\t# progresses\" half of the run-status contract — the loop calls it each round so\n388\t# the hub's read view reflects current progress. Touches only the per-run blob,\n389\t# not index.tsv (the index stays the lightweight lifecycle pointer). Returns 2\n390\t# when the run has no status file.\n391\talmanac_loop_update_run_progress() {\n392\t  [ \"$#\" -ge 2 ] || return 2\n393\t\n394\t  local root=\"$1\"\n395\t  local run_id=\"$2\"\n396\t  local round=\"${3:-}\"\n397\t  local summary=\"${4:-}\"\n398\t  local status_file\n399\t\n400\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n401\t  [ -f \"$status_file\" ] || return 2\n402\t\n403\t  # Set only the live-progress fields; record_set preserves the identity and\n404\t  # lifecycle (status/start/finish) fields untouched.\n405\t  almanac_loop_record_set \"$status_file\" \"round=$round\" \"summary=$summary\"\n406\t}\n407\t\n408\t# Detect a stale registry entry: a run whose recorded status is still `running`\n409\t# but whose process is gone (crashed/killed without marking itself), so the hub\n410\t# can surface or reap it. Returns 0 (stale) only when status is running AND the\n411\t# pid is not alive — a numeric pid that `kill -0` cannot signal, or a missing/\n412\t# non-numeric pid that cannot be verified. Returns 1 for a live running pid or\n413\t# any terminal status; returns 2 when the run is unknown.\n414\talmanac_loop_run_is_stale() {\n415\t  local root=\"$1\"\n416\t  local run_id=\"$2\"\n417\t  local status_file status pid\n418\t\n419\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n420\t  [ -f \"$status_file\" ] || return 2\n421\t\n422\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n423\t  [ \"$status\" = \"running\" ] || return 1\n424\t\n425\t  pid=\"$(almanac_loop_status_field \"$status_file\" \"pid\" || true)\"\n426\t  case \"$pid\" in\n427\t    ''|*[!0-9]*) return 0 ;;\n428\t  esac\n429\t\n430\t  if kill -0 \"$pid\" 2>/dev/null; then\n431\t    return 1\n432\t  fi\n433\t  return 0\n434\t}\n435\t\n436\t# List every registered run as index.tsv data rows (id/type/target/pid/status-\n437\t# file/start/status), header stripped — the API the hub reads to enumerate runs.\n438\t# Returns 1 when there is no registry or no run has been registered yet, so a\n439\t# caller can branch on \"any runs?\" without parsing.\n440\talmanac_loop_list_runs() {\n441\t  local root=\"$1\"\n442\t  local index_file rows\n443\t\n444\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n445\t  [ -f \"$index_file\" ] || return 1\n446\t\n447\t  rows=\"$(awk 'NR > 1' \"$index_file\")\"\n448\t  [ -n \"$rows\" ] || return 1\n449\t\n450\t  printf '%s\\n' \"$rows\"\n451\t}\n452\t\n453\t# Read a single run's full status.tsv blob — the detail view the hub renders for\n454\t# one run (identity plus live round/summary and finish state). Returns 1 when the\n455\t# run is unknown.\n456\talmanac_loop_read_run() {\n457\t  local root=\"$1\"\n458\t  local run_id=\"$2\"\n459\t  local status_file\n460\t\n461\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n462\t  [ -f \"$status_file\" ] || return 1\n463\t\n464\t  cat \"$status_file\"\n465\t}\n466\t\n467\talmanac_loop_worker_dir() {\n468\t  local root=\"$1\"\n469\t  local run_id=\"$2\"\n470\t  local worker_id=\"$3\"\n471\t\n472\t  printf '%s/%s/workers/%s\\n' \\\n473\t    \"$(almanac_loop_registry_dir \"$root\")\" \\\n474\t    \"$run_id\" \\\n475\t    \"$(almanac_loop_slug \"$worker_id\")\"\n476\t}\n477\t\n478\talmanac_loop_worker_status_file() {\n479\t  local root=\"$1\"\n480\t  local run_id=\"$2\"\n481\t  local worker_id=\"$3\"\n482\t\n483\t  printf '%s/status.tsv\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\"\n484\t}\n485\t\n486\talmanac_loop_worker_file() {\n487\t  local root=\"$1\"\n488\t  local run_id=\"$2\"\n489\t  local worker_id=\"$3\"\n490\t  local filename=\"$4\"\n491\t\n492\t  printf '%s/%s\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\" \"$filename\"\n493\t}\n494\t\n495\t# --- Worker health detection ---------------------------------------------------\n496\t#\n497\t# Classify a worker's health from progress signals so the dashboard can surface a\n498\t# reviewer that is stalled (log stopped advancing), idle (running but never\n499\t# produced an event), or looping (emitting the same event over and over) rather\n500\t# than the operator discovering it by hand. The classifier is a PURE predicate\n501\t# over already-gathered numbers, so it is table-testable with no files, clock, or\n502\t# terminal; the gather wrapper (almanac_loop_worker_health_of) feeds it real run\n503\t# state.\n504\t\n505\t# Pure predicate: (status, log-age-secs, event-count, trailing-repeat-count,\n506\t# stall-threshold-secs, loop-repeat-threshold) -> one of\n507\t# running|stalled|idle|looping|done|failed. A terminal status passes straight\n508\t# through. For a live worker: a trailing run of identical events at/over the loop\n509\t# threshold is a loop; otherwise zero events past the stall threshold is idle, any\n510\t# log silence past the stall threshold is stalled, and anything else is running.\n511\talmanac_loop_worker_health() {\n512\t  local status=\"${1:-running}\"\n513\t  local age=\"${2:-0}\"\n514\t  local count=\"${3:-0}\"\n515\t  local repeat=\"${4:-0}\"\n516\t  local stall=\"${5:-120}\"\n517\t  local loop=\"${6:-5}\"\n518\t\n519\t  case \"$status\" in\n520\t    done)   printf '%s\\n' \"done\";   return 0 ;;\n521\t    failed) printf '%s\\n' \"failed\"; return 0 ;;\n522\t  esac\n523\t\n524\t  if [ \"$loop\" -gt 0 ] && [ \"$repeat\" -ge \"$loop\" ]; then\n525\t    printf '%s\\n' \"looping\"; return 0\n526\t  fi\n527\t  if [ \"$count\" -eq 0 ] && [ \"$age\" -ge \"$stall\" ]; then\n528\t    printf '%s\\n' \"idle\"; return 0\n529\t  fi\n530\t  if [ \"$age\" -ge \"$stall\" ]; then\n531\t    printf '%s\\n' \"stalled\"; return 0\n532\t  fi\n533\t  printf '%s\\n' \"running\"\n534\t}\n535\t\n536\t# Seconds since a file was last modified (now - mtime). Prints -1 when the file is\n537\t# absent. now-epoch is overridable (tests) so age is deterministic. Handles both\n538\t# BSD/macOS (stat -f %m) and GNU/Linux (stat -c %Y).\n539\talmanac_loop_file_age_secs() {\n540\t  local file=\"$1\"\n541\t  local now=\"${2:-}\"\n542\t  local mtime\n543\t\n544\t  [ -f \"$file\" ] || { printf '%s\\n' \"-1\"; return 0; }\n545\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n546\t  mtime=\"$(stat -f %m \"$file\" 2>/dev/null || stat -c %Y \"$file\" 2>/dev/null || printf '%s' \"\")\"\n547\t  [ -n \"$mtime\" ] || { printf '%s\\n' \"-1\"; return 0; }\n548\t  printf '%s\\n' \"$((now - mtime))\"\n549\t}\n550\t\n551\t# Count lines in a file (0 when absent). awk NR counts a final unterminated line.\n552\talmanac_loop_count_lines() {\n553\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n554\t  awk 'END { print NR }' \"$1\"\n555\t}\n556\t\n557\t# Count the trailing run of identical lines at the end of a file (0 when absent or\n558\t# empty, 1 when the last line is unique). A long run is the loop signal.\n559\talmanac_loop_trailing_repeat() {\n560\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n561\t  awk '\n562\t    NR == 1 { last = $0; c = 1; next }\n563\t    $0 == last { c++; next }\n564\t    { last = $0; c = 1 }\n565\t    END {\n566\t      if (NR == 0) { print 0; exit }\n567\t      print c\n568\t    }\n569\t  ' \"$1\"\n570\t}\n571\t\n572\t# Gather one worker's real run state and classify its health. Reads the worker's\n573\t# status.tsv (status + events-log path), measures the log's age/size/trailing\n574\t# repeat, and returns the pure predicate's verdict. Prints \"unknown\" when the\n575\t# worker has no status file yet. now/stall/loop are overridable.\n576\talmanac_loop_worker_health_of() {\n577\t  local root=\"$1\"\n578\t  local run_id=\"$2\"\n579\t  local worker_id=\"$3\"\n580\t  local now=\"${4:-}\"\n581\t  local stall=\"${5:-120}\"\n582\t  local loop=\"${6:-5}\"\n583\t  local status_file status events_file age count repeat\n584\t\n585\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n586\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"unknown\"; return 0; }\n587\t\n588\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n589\t  events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n590\t\n591\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n592\t  age=\"$(almanac_loop_file_age_secs \"$events_file\" \"$now\")\"\n593\t  count=\"$(almanac_loop_count_lines \"$events_file\")\"\n594\t  repeat=\"$(almanac_loop_trailing_repeat \"$events_file\")\"\n595\t  [ \"$age\" -ge 0 ] 2>/dev/null || age=0\n596\t\n597\t  almanac_loop_worker_health \"${status:-running}\" \"$age\" \"$count\" \"$repeat\" \"$stall\" \"$loop\"\n598\t}\n599\t\n600\t# --- Hub overview --------------------------------------------------------------\n601\t#\n602\t# The interactive hub (`almanac` in a TTY, or `almanac hub`) is the front door to\n603\t# every loop. Its read views are PURE registry projections so they are testable\n604\t# off a terminal and degrade to plain text without gum; the interactive menus\n605\t# (new-run, per-run watch/stop/steer) layer on top of these.\n606\t\n607\t# Project the run registry into one of the hub's two lists as plain printable\n608\t# rows (text only — gum frames them later, so this stays unit-testable off a\n609\t# TTY). `which` selects the section:\n610\t#   running — every run whose lifecycle status is still `running`, carrying its\n611\t#             live round/summary from the run-status blob; a running entry whose\n612\t#             pid is gone is surfaced as `stale` (almanac_loop_run_is_stale) so a\n613\t#             crashed run is visible rather than silently lost.\n614\t#   recent  — the finished runs (done/failed/aborted), newest finish first,\n615\t#             capped at `limit` (default 10).\n616\t# Each row is \"<glyph>  <state>  <type>  <target>  <detail>  [<id>]\". Returns 1\n617\t# (no rows) when the section is empty so the caller can print an empty-state line.\n618\talmanac_loop_hub_render() {\n619\t  local root=\"$1\"\n620\t  local which=\"$2\"\n621\t  local limit=\"${3:-10}\"\n622\t  local rows id type target pid status_rel started status\n623\t  local blob round summary finished detail glyph live count reason_field display queue\n624\t\n625\t  rows=\"$(almanac_loop_list_runs \"$root\")\" || return 1\n626\t  count=0\n627\t\n628\t  if [ \"$which\" = \"recent\" ]; then\n629\t    local sortable=\"\"\n630\t    while IFS=$'\\t' read -r id type target pid status_rel started status; do\n631\t      [ -n \"$id\" ] || continue\n632\t      case \"$status\" in\n633\t        done|failed|aborted) ;;\n634\t        *) continue ;;\n635\t      esac\n636\t      blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n637\t      finished=\"$(almanac_loop_status_field \"$blob\" \"finished_at\" 2>/dev/null || true)\"\n638\t      [ -n \"$finished\" ] || finished=\"$started\"\n639\t      reason_field=\"\"\n640\t      if [ \"$status\" = \"failed\" ]; then\n641\t        reason_field=\"$(almanac_loop_status_field \"$blob\" \"failure_reason\" 2>/dev/null || true)\"\n642\t      fi\n643\t      sortable+=\"$finished\"$'\\t'\"$id\"$'\\t'\"$type\"$'\\t'\"$target\"$'\\t'\"$status\"$'\\t'\"$reason_field\"$'\\n'\n644\t    done <<< \"$rows\"\n645\t    [ -n \"$sortable\" ] || return 1\n646\t    while IFS=$'\\t' read -r finished id type target status reason_field; do\n647\t      [ -n \"$id\" ] || continue\n648\t      glyph=\"$(almanac_loop_ui_status_glyph \"$status\")\"\n649\t      display=\"$finished\"\n650\t      if [ \"$status\" = \"failed\" ] && [ -n \"$reason_field\" ]; then\n651\t        display=\"$finished — $reason_field\"\n652\t      fi\n653\t      printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$status\" \"$type\" \"$target\" \"$display\" \"$id\"\n654\t      count=$((count + 1))\n655\t      if [ \"$count\" -ge \"$limit\" ]; then break; fi\n656\t    done < <(printf '%s' \"$sortable\" | sort -t$'\\t' -k1,1r)\n657\t    if [ \"$count\" -gt 0 ]; then return 0; fi\n658\t    return 1\n659\t  fi\n660\t\n661\t  # which == running (default)\n662\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n663\t    [ -n \"$id\" ] || continue\n664\t    [ \"$status\" = \"running\" ] || continue\n665\t    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n666\t    round=\"$(almanac_loop_status_field \"$blob\" \"round\" 2>/dev/null || true)\"\n667\t    summary=\"$(almanac_loop_status_field \"$blob\" \"summary\" 2>/dev/null || true)\"\n668\t    queue=\"$(almanac_loop_status_field \"$blob\" \"queue_progress\" 2>/dev/null || true)\"\n669\t    live=\"running\"\n670\t    if almanac_loop_run_is_stale \"$root\" \"$id\"; then\n671\t      live=\"stale\"\n672\t    fi\n673\t    glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n674\t    detail=\"\"\n675\t    if [ -n \"$round\" ]; then detail=\"round $round\"; fi\n676\t    if [ -n \"$summary\" ]; then detail=\"${detail:+$detail  }$summary\"; fi\n677\t    if [ -n \"$queue\" ]; then detail=\"${detail:+$detail  }queue $queue\"; fi\n678\t    if [ -z \"$detail\" ]; then detail=\"—\"; fi\n679\t    printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$live\" \"$type\" \"$target\" \"$detail\" \"$id\"\n680\t    count=$((count + 1))\n681\t  done <<< \"$rows\"\n682\t  if [ \"$count\" -gt 0 ]; then return 0; fi\n683\t  return 1\n684\t}\n685\t\n686\t# Compose the hub's read-only overview screen: a Running section (live loops from\n687\t# the registry) and a Recent section (last finished loops), each framed through\n688\t# the shared ui renderer so it shows as a gum panel on a TTY and plain text\n689\t# without gum. This is the whole hub output off a TTY and the status screen the\n690\t# interactive hub draws around its menu. Each section prints an empty-state line\n691\t# when there are no matching runs.\n692\talmanac_loop_hub_overview() {\n693\t  local root=\"$1\"\n694\t  local recent_limit=\"${2:-10}\"\n695\t  local running recent\n696\t\n697\t  {\n698\t    printf '%s\\n' \"almanac — loop hub\"\n699\t    printf '\\n'\n700\t    printf '%s\\n' \"Running\"\n701\t    if running=\"$(almanac_loop_hub_render \"$root\" running)\"; then\n702\t      printf '%s\\n' \"$running\"\n703\t    else\n704\t      printf '%s\\n' \"  (no running loops)\"\n705\t    fi\n706\t    printf '\\n'\n707\t    printf '%s\\n' \"Recent\"\n708\t    if recent=\"$(almanac_loop_hub_render \"$root\" recent \"$recent_limit\")\"; then\n709\t      printf '%s\\n' \"$recent\"\n710\t    else\n711\t      printf '%s\\n' \"  (no recent loops)\"\n712\t    fi\n713\t  } | almanac_loop_ui_render\n714\t}\n715\t\n716\t# Aggregate finished runs (done/failed/aborted) by (type, provider, model) and\n717\t# print a small table: runs + success rate. Reads provider/model from each run's\n718\t# blob, so older runs (no recorded config) bucket under `?` for the missing\n719\t# fields rather than disappearing. Returns 1 (with no output) when the registry\n720\t# has no finished runs, so the caller can print an empty-state line.\n721\t#\n722\t# Pipeline is `read registry rows → emit (type,provider,model,status) lines →\n723\t# awk groups + counts → sort by total runs desc → awk reformats with a header`.\n724\t# Pure data + awk so the table is identical with or without gum (the caller\n725\t# frames it).\n726\talmanac_loop_hub_stats() {\n727\t  local root=\"$1\"\n728\t  local rows lines id type target pid status_rel started status blob provider model\n729\t  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n730\t  [ -n \"$rows\" ] || return 1\n731\t\n732\t  lines=\"\"\n733\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n734\t    [ -n \"$id\" ] || continue\n735\t    case \"$status\" in done|failed|aborted) ;; *) continue ;; esac\n736\t    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n737\t    provider=\"$(almanac_loop_status_field \"$blob\" provider 2>/dev/null || true)\"\n738\t    model=\"$(almanac_loop_status_field \"$blob\" model 2>/dev/null || true)\"\n739\t    lines+=\"$type\"$'\\t'\"${provider:-?}\"$'\\t'\"${model:-?}\"$'\\t'\"$status\"$'\\n'\n740\t  done <<< \"$rows\"\n741\t  [ -n \"$lines\" ] || return 1\n742\t\n743\t  printf '%s' \"$lines\" | awk -F'\\t' '\n744\t    {\n745\t      key = $1 \"|\" $2 \"|\" $3\n746\t      total[key]++\n747\t      if ($4 == \"done\") done[key]++\n748\t    }\n749\t    END {\n750\t      for (k in total) {\n751\t        n = total[k]; d = (k in done) ? done[k] : 0\n752\t        rate = (n > 0) ? (d * 100.0 / n) : 0\n753\t        split(k, kk, \"|\")\n754\t        printf \"%s\\t%s\\t%s\\t%d\\t%.0f\\n\", kk[1], kk[2], kk[3], n, rate\n755\t      }\n756\t    }\n757\t  ' | sort -t$'\\t' -k4,4 -n -r | awk -F'\\t' '\n758\t    BEGIN { printf \"%-8s %-8s %-22s %6s %8s\\n\", \"type\", \"provider\", \"model\", \"runs\", \"success\" }\n759\t    { printf \"%-8s %-8s %-22s %6d %7d%%\\n\", $1, $2, $3, $4, $5 }\n760\t  '\n761\t  return 0\n762\t}\n763\t\n764\t# --- Hub per-run actions -------------------------------------------------------\n765\t#\n766\t# The interactive hub lets the operator act on a selected running loop: watch its\n767\t# live status, stop it, or queue a steer directive for its next round. These are\n768\t# pure-ish file/signal operations (no gum, no menu), so they are unit-testable and\n769\t# also drivable non-interactively (`almanac hub --stop|--steer|--watch <id>`); the\n770\t# gum selection menu in cmd/hub.sh is a thin TTY layer over them.\n771\t\n772\t# Map a run type + signal kind to the dot-file basename the loop's runner watches\n773\t# for between rounds. Thin pass-through to almanac_loop_signal_file (lib/loops.sh),\n774\t# which resolves the adapter's override if any else the standard `.${type}-${kind}`\n775\t# default — so this run-registry layer is independent of which loops opt to use\n776\t# the default and which override. Prints the basename; returns 1 for an unknown\n777\t# type or kind.\n778\talmanac_loop_run_signal_file() {\n779\t  almanac_loop_signal_file \"$1\" \"$2\"\n780\t}\n781\t\n782\t# Absolute path to a loop's between-round control file under BASE: BASE joined with\n783\t# the type's stop|steer dot-file basename (`<base>/.harden-stop`, …). Centralises\n784\t# the harden/converge pattern of \"look up the signal file, prepend the path\" so\n785\t# each loop's core stops re-implementing its own _control_file wrapper. Returns 1\n786\t# when the loop type or kind is unknown.\n787\talmanac_loop_run_control_file() {\n788\t  local type=\"$1\" base=\"$2\" kind=\"$3\"\n789\t  local name\n790\t  name=\"$(almanac_loop_run_signal_file \"$type\" \"$kind\")\" || return 1\n791\t  printf '%s/%s\\n' \"$base\" \"$name\"\n792\t}\n793\t\n794\t# Stop a registered running run: write the run type's stop file under root (runs\n795\t# register with root = their working dir, so the loop sees it at its next\n796\t# between-round check). The registry lives in the project and is not trusted for\n797\t# host PID signaling, so hub stop never sends TERM from a recorded pid. Returns 2\n798\t# when the run is unknown, 3 when its type has no stop convention, and 4 when the\n799\t# run is already terminal/non-running.\n800\talmanac_loop_run_stop() {\n801\t  local root=\"$1\"\n802\t  local run_id=\"$2\"\n803\t  local status_file type status stop_file\n804\t\n805\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n806\t  [ -f \"$status_file\" ] || return 2\n807\t\n808\t  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n809\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n810\t  [ \"$status\" = \"running\" ] || return 4\n811\t\n812\t  stop_file=\"$(almanac_loop_run_signal_file \"$type\" stop)\" || return 3\n813\t  printf '%s\\n' \"stop requested via almanac hub: $run_id\" > \"$root/$stop_file\"\n814\t  return 0\n815\t}\n816\t\n817\t# Queue a steer directive for a running loop: write the directive to the run type's\n818\t# steer file under root, which the loop's next round consumes (ralph reads\n819\t# `.ralph-steer`). Returns 2 when the run is unknown, 3 when its type has no steer\n820\t# convention, and 4 when the directive is blank.\n821\talmanac_loop_run_steer() {\n822\t  local root=\"$1\"\n823\t  local run_id=\"$2\"\n824\t  local directive=\"$3\"\n825\t  local status_file type steer_file\n826\t\n827\t  if [ -z \"${directive//[[:space:]]/}\" ]; then\n828\t    return 4\n829\t  fi\n830\t\n831\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n832\t  [ -f \"$status_file\" ] || return 2\n833\t\n834\t  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n835\t  steer_file=\"$(almanac_loop_run_signal_file \"$type\" steer)\" || return 3\n836\t\n837\t  printf '%s\\n' \"$directive\" > \"$root/$steer_file\"\n838\t  return 0\n839\t}\n840\t\n841\t# Pure detail view of one run for the hub's per-run screen (selection confirmation\n842\t# + watch frame): identity, live status (upgraded to `stale` when a running run's\n843\t# pid is gone, like the running list), round/summary, and start/finish. Plain text\n844\t# only — gum frames it later. Returns 1 when the run is unknown.\n845\talmanac_loop_run_detail() {\n846\t  local root=\"$1\"\n847\t  local run_id=\"$2\"\n848\t  local status_file id type target status round summary started finished live glyph failure_reason\n849\t  local provider model effort iterations oversee lenses rounds queue_progress\n850\t\n851\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n852\t  [ -f \"$status_file\" ] || return 1\n853\t\n854\t  id=\"$(almanac_loop_status_field \"$status_file\" \"id\" || true)\"\n855\t  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n856\t  target=\"$(almanac_loop_status_field \"$status_file\" \"target\" || true)\"\n857\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n858\t  round=\"$(almanac_loop_status_field \"$status_file\" \"round\" || true)\"\n859\t  summary=\"$(almanac_loop_status_field \"$status_file\" \"summary\" || true)\"\n860\t  started=\"$(almanac_loop_status_field \"$status_file\" \"started_at\" || true)\"\n861\t  finished=\"$(almanac_loop_status_field \"$status_file\" \"finished_at\" || true)\"\n862\t  failure_reason=\"$(almanac_loop_status_field \"$status_file\" \"failure_reason\" || true)\"\n863\t  provider=\"$(almanac_loop_status_field \"$status_file\" \"provider\" || true)\"\n864\t  model=\"$(almanac_loop_status_field \"$status_file\" \"model\" || true)\"\n865\t  effort=\"$(almanac_loop_status_field \"$status_file\" \"effort\" || true)\"\n866\t  iterations=\"$(almanac_loop_status_field \"$status_file\" \"iterations\" || true)\"\n867\t  oversee=\"$(almanac_loop_status_field \"$status_file\" \"oversee\" || true)\"\n868\t  lenses=\"$(almanac_loop_status_field \"$status_file\" \"lenses\" || true)\"\n869\t  rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" || true)\"\n870\t  queue_progress=\"$(almanac_loop_status_field \"$status_file\" \"queue_progress\" || true)\"\n871\t\n872\t  live=\"$status\"\n873\t  if [ \"$status\" = \"running\" ] && almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n874\t    live=\"stale\"\n875\t  fi\n876\t  glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n877\t\n878\t  printf '%s  %s  %s  %s\\n' \"$glyph\" \"$live\" \"$type\" \"$target\"\n879\t  printf 'id: %s\\n' \"$id\"\n880\t  if [ -n \"$round\" ]; then printf 'round: %s\\n' \"$round\"; fi\n881\t  if [ -n \"$summary\" ]; then printf 'summary: %s\\n' \"$summary\"; fi\n882\t  if [ -n \"$started\" ]; then printf 'started: %s\\n' \"$started\"; fi\n883\t  if [ -n \"$finished\" ]; then printf 'finished: %s\\n' \"$finished\"; fi\n884\t  if [ -n \"$failure_reason\" ]; then printf 'failure: %s\\n' \"$failure_reason\"; fi\n885\t  # Launch config (recorded at register so hub --resume can rebuild the command).\n886\t  # Each line is conditional so a run without a stored value (older runs / fields\n887\t  # that don't apply to this loop type) doesn't print empty placeholders.\n888\t  [ -n \"$provider\" ]   && printf 'provider: %s\\n' \"$provider\"\n889\t  [ -n \"$model\" ]      && printf 'model: %s\\n' \"$model\"\n890\t  [ -n \"$effort\" ]     && printf 'effort: %s\\n' \"$effort\"\n891\t  [ -n \"$iterations\" ] && printf 'iterations: %s\\n' \"$iterations\"\n892\t  [ -n \"$oversee\" ]    && printf 'oversee: %s\\n' \"$oversee\"\n893\t  [ -n \"$lenses\" ]     && printf 'lenses: %s\\n' \"$lenses\"\n894\t  [ -n \"$rounds\" ]     && printf 'rounds: %s\\n' \"$rounds\"\n895\t  [ -n \"$queue_progress\" ] && printf 'queue: %s\\n' \"$queue_progress\"\n896\t  return 0\n897\t}\n898\t\n899\t# Watch a run from the hub. One-shot (default, and whenever stdout is not a TTY):\n900\t# render the run's detail once through the shared UI renderer and return — the\n901\t# testable, scripts-safe path piped callers get. Follow (`follow` + a TTY): redraw\n902\t# the detail every interval until the run reaches a terminal status, so the\n903\t# operator can tail a live loop's status from the hub (ALMANAC_HUB_WATCH_INTERVAL\n904\t# overrides the cadence). Returns 1 when the run is unknown.\n905\talmanac_loop_run_watch() {\n906\t  local root=\"$1\"\n907\t  local run_id=\"$2\"\n908\t  local mode=\"${3:-}\"\n909\t  local interval=\"${ALMANAC_HUB_WATCH_INTERVAL:-2}\"\n910\t  local status_file status\n911\t\n912\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n913\t  [ -f \"$status_file\" ] || return 1\n914\t\n915\t  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n916\t    almanac_loop_run_detail \"$root\" \"$run_id\" | almanac_loop_ui_render\n917\t    return 0\n918\t  fi\n919\t\n920\t  while :; do\n921\t    almanac_loop_ui_clear\n922\t    almanac_loop_run_detail \"$root\" \"$run_id\" | almanac_loop_ui_render\n923\t    status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n924\t    case \"$status\" in\n925\t      done|failed|aborted) break ;;\n926\t    esac\n927\t    sleep \"$interval\"\n928\t  done\n929\t  return 0\n930\t}\n931\t\n932\t# --- New-run composition (hub \"New run\" flow) -------------------------------\n933\t#\n934\t# The hub's New-run flow picks a loop type (ralph|harden), gathers config, and\n935\t# launches it. The argv/env COMPOSITION is pure (no gum, no exec) so it is unit-\n936\t# testable off a terminal and doubles as the seam the gum menu and `almanac hub\n937\t# --new … [--dry-run]` both drive: menu choices in, launch tokens out.\n938\t#\n939\t# Config arrives as `key=value` pairs (the keys the gum menu / --new flags\n940\t# collect): ralph takes prd, mode, provider, model, effort, iterations, oversee;\n941\t# harden takes target, rounds, lenses, provider, model, effort.\n942\t\n943\t# Compose the launcher argv for a new run, one token per line, starting with the\n944\t# `almanac` subcommand. The loop-specific flag shape lives in each loop adapter's\n945\t# `new_run_argv` verb (lib/loops/<name>.sh) — this dispatcher normalises the\n946\t# unknown-type vs missing-field distinction and forwards the key=val pairs:\n947\t#   - unknown loop type  -> 1\n948\t#   - missing required   -> 2 (returned by the adapter)\n949\t# Adding a loop is a single new file under lib/loops/ — this function does not\n950\t# change. Symmetric with `almanac_loop_new_run_env` below.\n951\talmanac_loop_new_run_argv() {\n952\t  local type=\"$1\"; shift\n953\t  almanac_loop_adapter_known \"$type\" || return 1\n954\t  almanac_loop_adapter_call \"$type\" new_run_argv \"$@\"\n955\t}\n956\t\n957\t# Compose the environment assignments (KEY=VALUE, one per line) a new run needs\n958\t# beyond its argv. The loop-specific env prefix lives in each loop adapter's\n959\t# `new_run_env` verb (lib/loops/<name>.sh). Returns 1 for an unknown type;\n960\t# adapters that have no env to emit (ralph today) return 0 with no output, so\n961\t# this dispatcher never branches on loop type.\n962\talmanac_loop_new_run_env() {\n963\t  local type=\"$1\"; shift\n964\t  almanac_loop_adapter_known \"$type\" || return 1\n965\t  almanac_loop_adapter_call \"$type\" new_run_env \"$@\"\n966\t}\n967\t"}]},"parent_tool_use_id":null,"session_id":"92d47660-4965-47f1-a4d3-fc4dbbc15bee","uuid":"2e5ed4b1-f911-4bbb-b356-543b9b155c06","timestamp":"2026-05-27T06:33:03.752Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/run.sh","content":"#!/usr/bin/env bash\n# run.sh — the run registry: the run-status record, registry, control, worker\n# health, and the hub's read views, owned in one module (per CONTEXT.md's module\n# map). loop-core.sh (the old god-module) is deleted; this is where its registry/\n# control/worker-health/hub-view concerns now live (the worker orchestration /\n# background fan-out lives in lib/worker.sh).\n#\n# A run-status *record* is a per-run status.tsv — one `key<TAB>value` line per\n# field. This module owns the CANONICAL FIELD LIST and the only set/get-by-name\n# accessors for it, so the run-status contract — every run (ralph or harden)\n# carries exactly this key set, in this order — is enforced *by construction*:\n# a caller names only the fields it has values for; the record fills in the rest,\n# and no writer ever enumerates the schema by hand.\n#\n# No lib/core.sh dependency (uses only printf/read/awk/etc), so the record +\n# registry are their own test surface — tests/test-run.sh sources this file\n# directly. The hub read-views compose the gum-or-plain UI seam (lib/ui.sh) and\n# the per-run control dispatches each loop's signal files through its adapter\n# (lib/loops.sh), so source those two idempotently — they are self-contained\n# (no core.sh) too. pwd -P resolves the install symlink so the siblings are found\n# from either path.\nif ! declare -F almanac_loop_ui_render >/dev/null 2>&1; then\n  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/ui.sh\n  source \"$__run_dir/ui.sh\"\n  unset __run_dir\nfi\n\nif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/loops.sh\n  source \"$__run_dir/loops.sh\"\n  unset __run_dir\nfi\n\n# THE single source of truth for the run-status schema: the canonical field list\n# in write order. record_set iterates exactly this list, so every record carries\n# the same keys regardless of which subset a caller supplies. The first seven are\n# also the registry's index.tsv columns (the lightweight list pointer); the last\n# three (finished_at/round/summary) are the per-run detail the index omits.\nalmanac_loop_record_fields() {\n  printf '%s\\n' \\\n    id type target pid status_file started_at status finished_at round summary failure_reason \\\n    provider model effort iterations oversee lenses rounds queue_progress\n}\n\n# Get one field from a record FILE by name. Prints the value (which may itself\n# contain tabs — reassembled from the trailing columns) and returns 0; returns 1\n# when the field is absent. This is the generic tab-field reader for the run\n# registry; almanac_loop_status_field (below) is a thin alias over it for the\n# worker-status and hub read paths.\nalmanac_loop_record_get() {\n  local file=\"$1\" wanted=\"$2\" key value rest\n\n  while IFS=$'\\t' read -r key value rest; do\n    if [ \"$key\" = \"$wanted\" ]; then\n      if [ -n \"${rest:-}\" ]; then\n        value=\"${value}\"$'\\t'\"${rest}\"\n      fi\n      printf '%s\\n' \"$value\"\n      return 0\n    fi\n  done < \"$file\"\n\n  return 1\n}\n\n# Generic TSV record engine: rewrite FILE with the schema in FIELDS_TEXT, in\n# canonical order, with each (existing) field preserved unless overridden by a\n# `field=value` PAIR. This is the deep module that owns the round-trip algorithm\n# — schema-specific wrappers (record_set for run-status, worker_record_set for\n# worker-status) just supply their own field list. Returns 2 on a missing file\n# argument or a pair whose field isn't in FIELDS_TEXT.\nalmanac_loop_tsv_record_set() {\n  local fields_text=\"$1\" file=\"$2\"\n  shift 2 || return 2\n  [ -n \"$file\" ] || return 2\n\n  local pair pfield field cur val out=\"\"\n  local have_file=0\n  if [ -f \"$file\" ]; then\n    have_file=1\n  fi\n\n  for pair in \"$@\"; do\n    pfield=\"${pair%%=*}\"\n    almanac_loop_tsv_has_field \"$fields_text\" \"$pfield\" || return 2\n  done\n\n  while IFS= read -r field; do\n    [ -n \"$field\" ] || continue\n    cur=\"\"\n    if [ \"$have_file\" = 1 ]; then\n      cur=\"$(almanac_loop_record_get \"$file\" \"$field\" || true)\"\n    fi\n    val=\"$cur\"\n    for pair in \"$@\"; do\n      pfield=\"${pair%%=*}\"\n      if [ \"$pfield\" = \"$field\" ]; then\n        val=\"${pair#*=}\"\n      fi\n    done\n    out=\"${out}${field}\"$'\\t'\"${val}\"$'\\n'\n  done <<< \"$fields_text\"\n\n  printf '%s' \"$out\" > \"$file\"\n}\n\n# True when NAME appears as a field in FIELDS_TEXT (newline-separated schema).\nalmanac_loop_tsv_has_field() {\n  local fields_text=\"$1\" wanted=\"$2\" field\n  while IFS= read -r field; do\n    [ \"$field\" = \"$wanted\" ] && return 0\n  done <<< \"$fields_text\"\n  return 1\n}\n\n# True when NAME is a canonical run-status field. Lets record_set reject a typo\n# rather than silently writing a key no reader ever looks for.\nalmanac_loop_record_has_field() {\n  almanac_loop_tsv_has_field \"$(almanac_loop_record_fields)\" \"$1\"\n}\n\n# Set one or more run-status fields by name, round-tripping the rest. Each\n# argument is a `field=value` pair (the value may itself contain `=`). The record\n# is rewritten with the FULL canonical key set in canonical order: every\n# canonical field already in the file is preserved unless overridden, and a\n# not-yet-existing file is initialised with every key (blank where unset). So\n# `register` seeds the record by naming only its known fields, while\n# `mark`/`update` change only theirs and leave the rest intact — no caller\n# enumerates the schema. Returns 2 on a missing file argument or a `field=value`\n# whose field is not canonical.\nalmanac_loop_record_set() {\n  almanac_loop_tsv_record_set \"$(almanac_loop_record_fields)\" \"$@\"\n}\n\nalmanac_loop_slug() {\n  local raw=\"$1\"\n  local slug\n\n  slug=\"$(printf '%s' \"$raw\" \\\n    | tr '[:upper:]' '[:lower:]' \\\n    | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')\"\n\n  if [ -z \"$slug\" ]; then\n    slug=\"run\"\n  fi\n\n  printf '%s\\n' \"$slug\"\n}\n\n# A loop's plan dir: <root>/docs/plans/<type>/<slug>. Each loop's plan/rubric/\n# ledger paths compose off this, so the docs/plans/<type>/<slug> prefix lives in\n# exactly one place. Caller supplies an already-slugified key (loops use\n# almanac_loop_slug) so this stays a pure path joiner — no second slug pass\n# muddying the contract.\nalmanac_loop_plan_dir() {\n  local type=\"$1\"\n  local root=\"$2\"\n  local slug=\"$3\"\n\n  printf '%s/docs/plans/%s/%s\\n' \"$root\" \"$type\" \"$slug\"\n}\n\nalmanac_loop_now_utc() {\n  date -u '+%Y-%m-%dT%H:%M:%SZ'\n}\n\nalmanac_loop_run_id() {\n  local type=\"$1\"\n  local target=\"$2\"\n  local compact_now\n\n  compact_now=\"$(date -u '+%Y%m%dT%H%M%SZ')\"\n  printf '%s-%s-%s-%s\\n' \\\n    \"$(almanac_loop_slug \"$type\")\" \\\n    \"$(almanac_loop_slug \"$target\")\" \\\n    \"$compact_now\" \\\n    \"$$\"\n}\n\nalmanac_loop_registry_dir() {\n  local root=\"${1:-.}\"\n\n  if [ \"$root\" != \"/\" ]; then\n    root=\"${root%/}\"\n  fi\n\n  printf '%s/.almanac/runs\\n' \"$root\"\n}\n\nalmanac_loop_run_status_file() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n\n  printf '%s/%s/status.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\" \"$run_id\"\n}\n\nalmanac_loop_run_status_relpath() {\n  local run_id=\"$1\"\n\n  printf '.almanac/runs/%s/status.tsv\\n' \"$run_id\"\n}\n\nalmanac_loop_run_index_file() {\n  local root=\"$1\"\n\n  printf '%s/index.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\"\n}\n\n# The run's status.tsv blob — the per-run detail view the hub reads — is the\n# run-status RECORD: its canonical field list and the set/get-by-name accessors\n# (almanac_loop_record_*) live above. The registry functions below seed and\n# update it through that record, so the schema (id/type/target/pid/\n# status_file/started_at/status + the live finished_at/round/summary) is never\n# enumerated here. The index.tsv is a separate lightweight list pointer (the\n# record's first seven fields), written below.\n\n# Thin alias for the record's generic tab-field reader, kept for the worker-status\n# and hub read paths that read a field by name. The implementation (and the\n# run-status record's canonical getter) is almanac_loop_record_get, above.\nalmanac_loop_status_field() {\n  almanac_loop_record_get \"$@\"\n}\n\nalmanac_loop_register_run() {\n  [ \"$#\" -ge 4 ] || return 2\n\n  local root=\"$1\"\n  local type=\"$2\"\n  local target=\"$3\"\n  local pid=\"$4\"\n  local run_id=\"${5:-}\"\n  local started_at=\"${6:-}\"\n  local registry_dir run_dir status_file status_rel index_file\n\n  [ -n \"$root\" ] || return 2\n  [ -n \"$type\" ] || return 2\n  [ -n \"$target\" ] || return 2\n  [ -n \"$pid\" ] || return 2\n\n  if [ -z \"$run_id\" ]; then\n    run_id=\"$(almanac_loop_run_id \"$type\" \"$target\")\"\n  fi\n\n  if [ -z \"$started_at\" ]; then\n    started_at=\"$(almanac_loop_now_utc)\"\n  fi\n\n  registry_dir=\"$(almanac_loop_registry_dir \"$root\")\"\n  run_dir=\"$registry_dir/$run_id\"\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  status_rel=\"$(almanac_loop_run_status_relpath \"$run_id\")\"\n  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n\n  if [ -e \"$run_dir\" ]; then\n    return 3\n  fi\n\n  mkdir -p \"$run_dir\"\n\n  if [ ! -f \"$index_file\" ]; then\n    printf 'id\\ttype\\ttarget\\tpid\\tstatus_file\\tstarted_at\\tstatus\\n' > \"$index_file\"\n  fi\n\n  # Seed the run-status record by naming only the fields known at launch; the\n  # record fills the rest (finished_at/round/summary blank) from the canonical\n  # schema. The index row is the lightweight pointer (the record's first seven\n  # fields).\n  almanac_loop_record_set \"$status_file\" \"id=$run_id\" \"type=$type\" \"target=$target\" \"pid=$pid\" \"status_file=$status_rel\" \"started_at=$started_at\" \"status=running\"\n  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$run_id\" \"$type\" \"$target\" \"$pid\" \"$status_rel\" \"$started_at\" \"running\" >> \"$index_file\"\n  printf '%s\\n' \"$run_id\"\n}\n\n# Set config fields on a run after registration. Thin convenience over record_set\n# that names intent: \"store the resolved launch config so resume can rebuild it.\"\n# Accepts any subset of the config keys (provider/model/effort/iterations/oversee\n# for ralph; provider/model/effort/lenses/rounds for harden). Blank values are\n# acceptable — record_set keeps the field present-but-blank. Returns 2 when the\n# run is unknown so callers can guard without aborting.\nalmanac_loop_set_run_config() {\n  [ \"$#\" -ge 3 ] || return 2\n  local root=\"$1\" run_id=\"$2\"; shift 2\n  local status_file\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 2\n  almanac_loop_record_set \"$status_file\" \"$@\"\n}\n\nalmanac_loop_mark_run_status() {\n  [ \"$#\" -ge 3 ] || return 2\n\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status=\"$3\"\n  local finished_at=\"${4:-}\"\n  local reason=\"${5:-}\"\n  local status_file index_file tmp\n\n  case \"$status\" in\n    done|failed|aborted) ;;\n    *) return 3 ;;\n  esac\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n\n  [ -f \"$status_file\" ] || return 2\n  [ -f \"$index_file\" ] || return 2\n\n  if [ -z \"$finished_at\" ]; then\n    finished_at=\"$(almanac_loop_now_utc)\"\n  fi\n\n  tmp=\"$(mktemp \"${index_file}.XXXXXX\")\"\n  if ! awk -v run_id=\"$run_id\" -v status=\"$status\" '\n    BEGIN { FS = OFS = \"\\t\" }\n    NR == 1 { print; next }\n    $1 == run_id { $7 = status; found = 1 }\n    { print }\n    END { if (!found) exit 4 }\n  ' \"$index_file\" > \"$tmp\"; then\n    rm -f \"$tmp\"\n    return 2\n  fi\n  mv \"$tmp\" \"$index_file\"\n\n  # Set only the lifecycle fields; record_set round-trips id/type/target/pid/\n  # status_file/started_at/round/summary, so the schema is never re-enumerated.\n  # An optional 5th arg supplies a one-line failure reason (typically \"exit=N\"\n  # plus a log-tail hint) so the hub can show *why* a run failed, not just that\n  # it did. Blank reason → leave the field as-is (running runs start blank).\n  local _fields=(\"status=$status\" \"finished_at=$finished_at\")\n  [ -n \"$reason\" ] && _fields+=(\"failure_reason=$reason\")\n  almanac_loop_record_set \"$status_file\" \"${_fields[@]}\"\n  # Best-effort end-of-run notification (macOS osascript / Linux notify-send /\n  # terminal-bell fallback). Opt out via ALMANAC_NO_NOTIFY=1. Notification\n  # trouble never sinks the mark — if osascript is missing or notify-send\n  # errors, the run is still correctly marked.\n  almanac_loop_notify_run_end \"$root\" \"$run_id\" >/dev/null 2>&1 || true\n}\n\n# Tell the user a run reached a terminal state. Reads the just-written record so\n# the notification carries type/status/target (and failure_reason on a failed\n# run). Dispatch order: macOS osascript → Linux notify-send → terminal bell\n# fallback (so you at least *hear* a finish on a bare server). Opt out entirely\n# with ALMANAC_NO_NOTIFY=1. ALMANAC_NOTIFY_TEST_SINK (a file path) replaces the\n# OS dispatcher with a write to that file, so tests can assert title+body\n# without a desktop environment.\nalmanac_loop_notify_run_end() {\n  [ -z \"${ALMANAC_NO_NOTIFY:-}\" ] || return 0\n  # Skip when there's no terminal attached (tests, daemons, captured output) —\n  # nobody to notify. The test sink bypasses this so unit tests can still assert\n  # the dispatch path without a TTY.\n  if [ -z \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n    [ -t 2 ] || return 0\n  fi\n  local root=\"$1\" run_id=\"$2\"\n  local status_file type status target reason title body body_esc title_esc\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\" 2>/dev/null)\" || return 0\n  [ -f \"$status_file\" ] || return 0\n  type=\"$(almanac_loop_status_field \"$status_file\" type 2>/dev/null || true)\"\n  status=\"$(almanac_loop_status_field \"$status_file\" status 2>/dev/null || true)\"\n  target=\"$(almanac_loop_status_field \"$status_file\" target 2>/dev/null || true)\"\n  reason=\"$(almanac_loop_status_field \"$status_file\" failure_reason 2>/dev/null || true)\"\n  case \"$status\" in done|failed|aborted) ;; *) return 0 ;; esac\n  title=\"almanac · ${type:-run} ${status}\"\n  body=\"${target}${reason:+ — $reason}\"\n  if [ -n \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n    printf '%s|%s\\n' \"$title\" \"$body\" >> \"$ALMANAC_NOTIFY_TEST_SINK\"\n    return 0\n  fi\n  if command -v osascript >/dev/null 2>&1; then\n    body_esc=\"$(printf '%s' \"$body\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n    title_esc=\"$(printf '%s' \"$title\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n    osascript -e \"display notification \\\"$body_esc\\\" with title \\\"$title_esc\\\"\" >/dev/null 2>&1 || true\n  elif command -v notify-send >/dev/null 2>&1; then\n    notify-send \"$title\" \"$body\" >/dev/null 2>&1 || true\n  else\n    printf '\\a' >&2 || true\n  fi\n}\n\n# Update a live run's progress mid-flight: rewrite its status.tsv with a new\n# round (harden round / ralph iteration) and worker/lens summary, preserving the\n# lifecycle status, start, and finish fields. This is the \"updated as it\n# progresses\" half of the run-status contract — the loop calls it each round so\n# the hub's read view reflects current progress. Touches only the per-run blob,\n# not index.tsv (the index stays the lightweight lifecycle pointer). Returns 2\n# when the run has no status file.\nalmanac_loop_update_run_progress() {\n  [ \"$#\" -ge 2 ] || return 2\n\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local round=\"${3:-}\"\n  local summary=\"${4:-}\"\n  local status_file\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 2\n\n  # Set only the live-progress fields; record_set preserves the identity and\n  # lifecycle (status/start/finish) fields untouched.\n  almanac_loop_record_set \"$status_file\" \"round=$round\" \"summary=$summary\"\n}\n\n# Detect a stale registry entry: a run whose recorded status is still `running`\n# but whose process is gone (crashed/killed without marking itself), so the hub\n# can surface or reap it. Returns 0 (stale) only when status is running AND the\n# pid is not alive — a numeric pid that `kill -0` cannot signal, or a missing/\n# non-numeric pid that cannot be verified. Returns 1 for a live running pid or\n# any terminal status; returns 2 when the run is unknown.\nalmanac_loop_run_is_stale() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status_file status pid\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 2\n\n  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n  [ \"$status\" = \"running\" ] || return 1\n\n  pid=\"$(almanac_loop_status_field \"$status_file\" \"pid\" || true)\"\n  case \"$pid\" in\n    ''|*[!0-9]*) return 0 ;;\n  esac\n\n  if kill -0 \"$pid\" 2>/dev/null; then\n    return 1\n  fi\n  return 0\n}\n\n# List every registered run as index.tsv data rows (id/type/target/pid/status-\n# file/start/status), header stripped — the API the hub reads to enumerate runs.\n# Returns 1 when there is no registry or no run has been registered yet, so a\n# caller can branch on \"any runs?\" without parsing.\nalmanac_loop_list_runs() {\n  local root=\"$1\"\n  local index_file rows\n\n  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n  [ -f \"$index_file\" ] || return 1\n\n  rows=\"$(awk 'NR > 1' \"$index_file\")\"\n  [ -n \"$rows\" ] || return 1\n\n  printf '%s\\n' \"$rows\"\n}\n\n# Read a single run's full status.tsv blob — the detail view the hub renders for\n# one run (identity plus live round/summary and finish state). Returns 1 when the\n# run is unknown.\nalmanac_loop_read_run() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status_file\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 1\n\n  cat \"$status_file\"\n}\n\nalmanac_loop_worker_dir() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local worker_id=\"$3\"\n\n  printf '%s/%s/workers/%s\\n' \\\n    \"$(almanac_loop_registry_dir \"$root\")\" \\\n    \"$run_id\" \\\n    \"$(almanac_loop_slug \"$worker_id\")\"\n}\n\nalmanac_loop_worker_status_file() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local worker_id=\"$3\"\n\n  printf '%s/status.tsv\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\"\n}\n\nalmanac_loop_worker_file() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local worker_id=\"$3\"\n  local filename=\"$4\"\n\n  printf '%s/%s\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\" \"$filename\"\n}\n\n# --- Worker health detection ---------------------------------------------------\n#\n# Classify a worker's health from progress signals so the dashboard can surface a\n# reviewer that is stalled (log stopped advancing), idle (running but never\n# produced an event), or looping (emitting the same event over and over) rather\n# than the operator discovering it by hand. The classifier is a PURE predicate\n# over already-gathered numbers, so it is table-testable with no files, clock, or\n# terminal; the gather wrapper (almanac_loop_worker_health_of) feeds it real run\n# state.\n\n# Pure predicate: (status, log-age-secs, event-count, trailing-repeat-count,\n# stall-threshold-secs, loop-repeat-threshold) -> one of\n# running|stalled|idle|looping|done|failed. A terminal status passes straight\n# through. For a live worker: a trailing run of identical events at/over the loop\n# threshold is a loop; otherwise zero events past the stall threshold is idle, any\n# log silence past the stall threshold is stalled, and anything else is running.\nalmanac_loop_worker_health() {\n  local status=\"${1:-running}\"\n  local age=\"${2:-0}\"\n  local count=\"${3:-0}\"\n  local repeat=\"${4:-0}\"\n  local stall=\"${5:-120}\"\n  local loop=\"${6:-5}\"\n\n  case \"$status\" in\n    done)   printf '%s\\n' \"done\";   return 0 ;;\n    failed) printf '%s\\n' \"failed\"; return 0 ;;\n  esac\n\n  if [ \"$loop\" -gt 0 ] && [ \"$repeat\" -ge \"$loop\" ]; then\n    printf '%s\\n' \"looping\"; return 0\n  fi\n  if [ \"$count\" -eq 0 ] && [ \"$age\" -ge \"$stall\" ]; then\n    printf '%s\\n' \"idle\"; return 0\n  fi\n  if [ \"$age\" -ge \"$stall\" ]; then\n    printf '%s\\n' \"stalled\"; return 0\n  fi\n  printf '%s\\n' \"running\"\n}\n\n# Seconds since a file was last modified (now - mtime). Prints -1 when the file is\n# absent. now-epoch is overridable (tests) so age is deterministic. Handles both\n# BSD/macOS (stat -f %m) and GNU/Linux (stat -c %Y).\nalmanac_loop_file_age_secs() {\n  local file=\"$1\"\n  local now=\"${2:-}\"\n  local mtime\n\n  [ -f \"$file\" ] || { printf '%s\\n' \"-1\"; return 0; }\n  [ -n \"$now\" ] || now=\"$(date +%s)\"\n  mtime=\"$(stat -f %m \"$file\" 2>/dev/null || stat -c %Y \"$file\" 2>/dev/null || printf '%s' \"\")\"\n  [ -n \"$mtime\" ] || { printf '%s\\n' \"-1\"; return 0; }\n  printf '%s\\n' \"$((now - mtime))\"\n}\n\n# Count lines in a file (0 when absent). awk NR counts a final unterminated line.\nalmanac_loop_count_lines() {\n  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n  awk 'END { print NR }' \"$1\"\n}\n\n# Count the trailing run of identical lines at the end of a file (0 when absent or\n# empty, 1 when the last line is unique). A long run is the loop signal.\nalmanac_loop_trailing_repeat() {\n  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n  awk '\n    NR == 1 { last = $0; c = 1; next }\n    $0 == last { c++; next }\n    { last = $0; c = 1 }\n    END {\n      if (NR == 0) { print 0; exit }\n      print c\n    }\n  ' \"$1\"\n}\n\n# Gather one worker's real run state and classify its health. Reads the worker's\n# status.tsv (status + events-log path), measures the log's age/size/trailing\n# repeat, and returns the pure predicate's verdict. Prints \"unknown\" when the\n# worker has no status file yet. now/stall/loop are overridable.\nalmanac_loop_worker_health_of() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local worker_id=\"$3\"\n  local now=\"${4:-}\"\n  local stall=\"${5:-120}\"\n  local loop=\"${6:-5}\"\n  local status_file status events_file age count repeat\n\n  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n  [ -f \"$status_file\" ] || { printf '%s\\n' \"unknown\"; return 0; }\n\n  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n  events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n\n  [ -n \"$now\" ] || now=\"$(date +%s)\"\n  age=\"$(almanac_loop_file_age_secs \"$events_file\" \"$now\")\"\n  count=\"$(almanac_loop_count_lines \"$events_file\")\"\n  repeat=\"$(almanac_loop_trailing_repeat \"$events_file\")\"\n  [ \"$age\" -ge 0 ] 2>/dev/null || age=0\n\n  almanac_loop_worker_health \"${status:-running}\" \"$age\" \"$count\" \"$repeat\" \"$stall\" \"$loop\"\n}\n\n# --- Hub overview --------------------------------------------------------------\n#\n# The interactive hub (`almanac` in a TTY, or `almanac hub`) is the front door to\n# every loop. Its read views are PURE registry projections so they are testable\n# off a terminal and degrade to plain text without gum; the interactive menus\n# (new-run, per-run watch/stop/steer) layer on top of these.\n\n# Project the run registry into one of the hub's two lists as plain printable\n# rows (text only — gum frames them later, so this stays unit-testable off a\n# TTY). `which` selects the section:\n#   running — every run whose lifecycle status is still `running`, carrying its\n#             live round/summary from the run-status blob; a running entry whose\n#             pid is gone is surfaced as `stale` (almanac_loop_run_is_stale) so a\n#             crashed run is visible rather than silently lost.\n#   recent  — the finished runs (done/failed/aborted), newest finish first,\n#             capped at `limit` (default 10).\n# Each row is \"<glyph>  <state>  <type>  <target>  <detail>  [<id>]\". Returns 1\n# (no rows) when the section is empty so the caller can print an empty-state line.\nalmanac_loop_hub_render() {\n  local root=\"$1\"\n  local which=\"$2\"\n  local limit=\"${3:-10}\"\n  local rows id type target pid status_rel started status\n  local blob round summary finished detail glyph live count reason_field display queue\n\n  rows=\"$(almanac_loop_list_runs \"$root\")\" || return 1\n  count=0\n\n  if [ \"$which\" = \"recent\" ]; then\n    local sortable=\"\"\n    while IFS=$'\\t' read -r id type target pid status_rel started status; do\n      [ -n \"$id\" ] || continue\n      case \"$status\" in\n        done|failed|aborted) ;;\n        *) continue ;;\n      esac\n      blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n      finished=\"$(almanac_loop_status_field \"$blob\" \"finished_at\" 2>/dev/null || true)\"\n      [ -n \"$finished\" ] || finished=\"$started\"\n      reason_field=\"\"\n      if [ \"$status\" = \"failed\" ]; then\n        reason_field=\"$(almanac_loop_status_field \"$blob\" \"failure_reason\" 2>/dev/null || true)\"\n      fi\n      sortable+=\"$finished\"$'\\t'\"$id\"$'\\t'\"$type\"$'\\t'\"$target\"$'\\t'\"$status\"$'\\t'\"$reason_field\"$'\\n'\n    done <<< \"$rows\"\n    [ -n \"$sortable\" ] || return 1\n    while IFS=$'\\t' read -r finished id type target status reason_field; do\n      [ -n \"$id\" ] || continue\n      glyph=\"$(almanac_loop_ui_status_glyph \"$status\")\"\n      display=\"$finished\"\n      if [ \"$status\" = \"failed\" ] && [ -n \"$reason_field\" ]; then\n        display=\"$finished — $reason_field\"\n      fi\n      printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$status\" \"$type\" \"$target\" \"$display\" \"$id\"\n      count=$((count + 1))\n      if [ \"$count\" -ge \"$limit\" ]; then break; fi\n    done < <(printf '%s' \"$sortable\" | sort -t$'\\t' -k1,1r)\n    if [ \"$count\" -gt 0 ]; then return 0; fi\n    return 1\n  fi\n\n  # which == running (default)\n  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n    [ -n \"$id\" ] || continue\n    [ \"$status\" = \"running\" ] || continue\n    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n    round=\"$(almanac_loop_status_field \"$blob\" \"round\" 2>/dev/null || true)\"\n    summary=\"$(almanac_loop_status_field \"$blob\" \"summary\" 2>/dev/null || true)\"\n    queue=\"$(almanac_loop_status_field \"$blob\" \"queue_progress\" 2>/dev/null || true)\"\n    live=\"running\"\n    if almanac_loop_run_is_stale \"$root\" \"$id\"; then\n      live=\"stale\"\n    fi\n    glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n    detail=\"\"\n    if [ -n \"$round\" ]; then detail=\"round $round\"; fi\n    if [ -n \"$summary\" ]; then detail=\"${detail:+$detail  }$summary\"; fi\n    if [ -n \"$queue\" ]; then detail=\"${detail:+$detail  }queue $queue\"; fi\n    if [ -z \"$detail\" ]; then detail=\"—\"; fi\n    printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$live\" \"$type\" \"$target\" \"$detail\" \"$id\"\n    count=$((count + 1))\n  done <<< \"$rows\"\n  if [ \"$count\" -gt 0 ]; then return 0; fi\n  return 1\n}\n\n# Compose the hub's read-only overview screen: a Running section (live loops from\n# the registry) and a Recent section (last finished loops), each framed through\n# the shared ui renderer so it shows as a gum panel on a TTY and plain text\n# without gum. This is the whole hub output off a TTY and the status screen the\n# interactive hub draws around its menu. Each section prints an empty-state line\n# when there are no matching runs.\nalmanac_loop_hub_overview() {\n  local root=\"$1\"\n  local recent_limit=\"${2:-10}\"\n  local running recent\n\n  {\n    printf '%s\\n' \"almanac — loop hub\"\n    printf '\\n'\n    printf '%s\\n' \"Running\"\n    if running=\"$(almanac_loop_hub_render \"$root\" running)\"; then\n      printf '%s\\n' \"$running\"\n    else\n      printf '%s\\n' \"  (no running loops)\"\n    fi\n    printf '\\n'\n    printf '%s\\n' \"Recent\"\n    if recent=\"$(almanac_loop_hub_render \"$root\" recent \"$recent_limit\")\"; then\n      printf '%s\\n' \"$recent\"\n    else\n      printf '%s\\n' \"  (no recent loops)\"\n    fi\n  } | almanac_loop_ui_render\n}\n\n# Aggregate finished runs (done/failed/aborted) by (type, provider, model) and\n# print a small table: runs + success rate. Reads provider/model from each run's\n# blob, so older runs (no recorded config) bucket under `?` for the missing\n# fields rather than disappearing. Returns 1 (with no output) when the registry\n# has no finished runs, so the caller can print an empty-state line.\n#\n# Pipeline is `read registry rows → emit (type,provider,model,status) lines →\n# awk groups + counts → sort by total runs desc → awk reformats with a header`.\n# Pure data + awk so the table is identical with or without gum (the caller\n# frames it).\nalmanac_loop_hub_stats() {\n  local root=\"$1\"\n  local rows lines id type target pid status_rel started status blob provider model\n  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n  [ -n \"$rows\" ] || return 1\n\n  lines=\"\"\n  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n    [ -n \"$id\" ] || continue\n    case \"$status\" in done|failed|aborted) ;; *) continue ;; esac\n    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n    provider=\"$(almanac_loop_status_field \"$blob\" provider 2>/dev/null || true)\"\n    model=\"$(almanac_loop_status_field \"$blob\" model 2>/dev/null || true)\"\n    lines+=\"$type\"$'\\t'\"${provider:-?}\"$'\\t'\"${model:-?}\"$'\\t'\"$status\"$'\\n'\n  done <<< \"$rows\"\n  [ -n \"$lines\" ] || return 1\n\n  printf '%s' \"$lines\" | awk -F'\\t' '\n    {\n      key = $1 \"|\" $2 \"|\" $3\n      total[key]++\n      if ($4 == \"done\") done[key]++\n    }\n    END {\n      for (k in total) {\n        n = total[k]; d = (k in done) ? done[k] : 0\n        rate = (n > 0) ? (d * 100.0 / n) : 0\n        split(k, kk, \"|\")\n        printf \"%s\\t%s\\t%s\\t%d\\t%.0f\\n\", kk[1], kk[2], kk[3], n, rate\n      }\n    }\n  ' | sort -t$'\\t' -k4,4 -n -r | awk -F'\\t' '\n    BEGIN { printf \"%-8s %-8s %-22s %6s %8s\\n\", \"type\", \"provider\", \"model\", \"runs\", \"success\" }\n    { printf \"%-8s %-8s %-22s %6d %7d%%\\n\", $1, $2, $3, $4, $5 }\n  '\n  return 0\n}\n\n# --- Hub per-run actions -------------------------------------------------------\n#\n# The interactive hub lets the operator act on a selected running loop: watch its\n# live status, stop it, or queue a steer directive for its next round. These are\n# pure-ish file/signal operations (no gum, no menu), so they are unit-testable and\n# also drivable non-interactively (`almanac hub --stop|--steer|--watch <id>`); the\n# gum selection menu in cmd/hub.sh is a thin TTY layer over them.\n\n# Map a run type + signal kind to the dot-file basename the loop's runner watches\n# for between rounds. Thin pass-through to almanac_loop_signal_file (lib/loops.sh),\n# which resolves the adapter's override if any else the standard `.${type}-${kind}`\n# default — so this run-registry layer is independent of which loops opt to use\n# the default and which override. Prints the basename; returns 1 for an unknown\n# type or kind.\nalmanac_loop_run_signal_file() {\n  almanac_loop_signal_file \"$1\" \"$2\"\n}\n\n# Absolute path to a loop's between-round control file under BASE: BASE joined with\n# the type's stop|steer dot-file basename (`<base>/.harden-stop`, …). Centralises\n# the harden/converge pattern of \"look up the signal file, prepend the path\" so\n# each loop's core stops re-implementing its own _control_file wrapper. Returns 1\n# when the loop type or kind is unknown.\nalmanac_loop_run_control_file() {\n  local type=\"$1\" base=\"$2\" kind=\"$3\"\n  local name\n  name=\"$(almanac_loop_run_signal_file \"$type\" \"$kind\")\" || return 1\n  printf '%s/%s\\n' \"$base\" \"$name\"\n}\n\n# Stop a registered running run: write the run type's stop file under root (runs\n# register with root = their working dir, so the loop sees it at its next\n# between-round check). The registry lives in the project and is not trusted for\n# host PID signaling, so hub stop never sends TERM from a recorded pid. Returns 2\n# when the run is unknown, 3 when its type has no stop convention, and 4 when the\n# run is already terminal/non-running.\nalmanac_loop_run_stop() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status_file type status stop_file\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 2\n\n  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n  [ \"$status\" = \"running\" ] || return 4\n\n  stop_file=\"$(almanac_loop_run_signal_file \"$type\" stop)\" || return 3\n  printf '%s\\n' \"stop requested via almanac hub: $run_id\" > \"$root/$stop_file\"\n  return 0\n}\n\n# Queue a steer directive for a running loop: write the directive to the run type's\n# steer file under root, which the loop's next round consumes (ralph reads\n# `.ralph-steer`). Returns 2 when the run is unknown, 3 when its type has no steer\n# convention, and 4 when the directive is blank.\nalmanac_loop_run_steer() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local directive=\"$3\"\n  local status_file type steer_file\n\n  if [ -z \"${directive//[[:space:]]/}\" ]; then\n    return 4\n  fi\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 2\n\n  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n  steer_file=\"$(almanac_loop_run_signal_file \"$type\" steer)\" || return 3\n\n  printf '%s\\n' \"$directive\" > \"$root/$steer_file\"\n  return 0\n}\n\n# Pure detail view of one run for the hub's per-run screen (selection confirmation\n# + watch frame): identity, live status (upgraded to `stale` when a running run's\n# pid is gone, like the running list), round/summary, and start/finish. Plain text\n# only — gum frames it later. Returns 1 when the run is unknown.\nalmanac_loop_run_detail() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status_file id type target status round summary started finished live glyph failure_reason\n  local provider model effort iterations oversee lenses rounds queue_progress\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 1\n\n  id=\"$(almanac_loop_status_field \"$status_file\" \"id\" || true)\"\n  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n  target=\"$(almanac_loop_status_field \"$status_file\" \"target\" || true)\"\n  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n  round=\"$(almanac_loop_status_field \"$status_file\" \"round\" || true)\"\n  summary=\"$(almanac_loop_status_field \"$status_file\" \"summary\" || true)\"\n  started=\"$(almanac_loop_status_field \"$status_file\" \"started_at\" || true)\"\n  finished=\"$(almanac_loop_status_field \"$status_file\" \"finished_at\" || true)\"\n  failure_reason=\"$(almanac_loop_status_field \"$status_file\" \"failure_reason\" || true)\"\n  provider=\"$(almanac_loop_status_field \"$status_file\" \"provider\" || true)\"\n  model=\"$(almanac_loop_status_field \"$status_file\" \"model\" || true)\"\n  effort=\"$(almanac_loop_status_field \"$status_file\" \"effort\" || true)\"\n  iterations=\"$(almanac_loop_status_field \"$status_file\" \"iterations\" || true)\"\n  oversee=\"$(almanac_loop_status_field \"$status_file\" \"oversee\" || true)\"\n  lenses=\"$(almanac_loop_status_field \"$status_file\" \"lenses\" || true)\"\n  rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" || true)\"\n  queue_progress=\"$(almanac_loop_status_field \"$status_file\" \"queue_progress\" || true)\"\n\n  live=\"$status\"\n  if [ \"$status\" = \"running\" ] && almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n    live=\"stale\"\n  fi\n  glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n\n  printf '%s  %s  %s  %s\\n' \"$glyph\" \"$live\" \"$type\" \"$target\"\n  printf 'id: %s\\n' \"$id\"\n  if [ -n \"$round\" ]; then printf 'round: %s\\n' \"$round\"; fi\n  if [ -n \"$summary\" ]; then printf 'summary: %s\\n' \"$summary\"; fi\n  if [ -n \"$started\" ]; then printf 'started: %s\\n' \"$started\"; fi\n  if [ -n \"$finished\" ]; then printf 'finished: %s\\n' \"$finished\"; fi\n  if [ -n \"$failure_reason\" ]; then printf 'failure: %s\\n' \"$failure_reason\"; fi\n  # Launch config (recorded at register so hub --resume can rebuild the command).\n  # Each line is conditional so a run without a stored value (older runs / fields\n  # that don't apply to this loop type) doesn't print empty placeholders.\n  [ -n \"$provider\" ]   && printf 'provider: %s\\n' \"$provider\"\n  [ -n \"$model\" ]      && printf 'model: %s\\n' \"$model\"\n  [ -n \"$effort\" ]     && printf 'effort: %s\\n' \"$effort\"\n  [ -n \"$iterations\" ] && printf 'iterations: %s\\n' \"$iterations\"\n  [ -n \"$oversee\" ]    && printf 'oversee: %s\\n' \"$oversee\"\n  [ -n \"$lenses\" ]     && printf 'lenses: %s\\n' \"$lenses\"\n  [ -n \"$rounds\" ]     && printf 'rounds: %s\\n' \"$rounds\"\n  [ -n \"$queue_progress\" ] && printf 'queue: %s\\n' \"$queue_progress\"\n  return 0\n}\n\n# Watch a run from the hub. One-shot (default, and whenever stdout is not a TTY):\n# render the run's detail once through the shared UI renderer and return — the\n# testable, scripts-safe path piped callers get. Follow (`follow` + a TTY): redraw\n# the detail every interval until the run reaches a terminal status, so the\n# operator can tail a live loop's status from the hub (ALMANAC_HUB_WATCH_INTERVAL\n# overrides the cadence). Returns 1 when the run is unknown.\nalmanac_loop_run_watch() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local mode=\"${3:-}\"\n  local interval=\"${ALMANAC_HUB_WATCH_INTERVAL:-2}\"\n  local status_file status\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || return 1\n\n  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n    almanac_loop_run_detail \"$root\" \"$run_id\" | almanac_loop_ui_render\n    return 0\n  fi\n\n  while :; do\n    almanac_loop_ui_clear\n    almanac_loop_run_detail \"$root\" \"$run_id\" | almanac_loop_ui_render\n    status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n    case \"$status\" in\n      done|failed|aborted) break ;;\n    esac\n    sleep \"$interval\"\n  done\n  return 0\n}\n\n# --- New-run composition (hub \"New run\" flow) -------------------------------\n#\n# The hub's New-run flow picks a loop type (ralph|harden), gathers config, and\n# launches it. The argv/env COMPOSITION is pure (no gum, no exec) so it is unit-\n# testable off a terminal and doubles as the seam the gum menu and `almanac hub\n# --new … [--dry-run]` both drive: menu choices in, launch tokens out.\n#\n# Config arrives as `key=value` pairs (the keys the gum menu / --new flags\n# collect): ralph takes prd, mode, provider, model, effort, iterations, oversee;\n# harden takes target, rounds, lenses, provider, model, effort.\n\n# Compose the launcher argv for a new run, one token per line, starting with the\n# `almanac` subcommand. The loop-specific flag shape lives in each loop adapter's\n# `new_run_argv` verb (lib/loops/<name>.sh) — this dispatcher normalises the\n# unknown-type vs missing-field distinction and forwards the key=val pairs:\n#   - unknown loop type  -> 1\n#   - missing required   -> 2 (returned by the adapter)\n# Adding a loop is a single new file under lib/loops/ — this function does not\n# change. Symmetric with `almanac_loop_new_run_env` below.\nalmanac_loop_new_run_argv() {\n  local type=\"$1\"; shift\n  almanac_loop_adapter_known \"$type\" || return 1\n  almanac_loop_adapter_call \"$type\" new_run_argv \"$@\"\n}\n\n# Compose the environment assignments (KEY=VALUE, one per line) a new run needs\n# beyond its argv. The loop-specific env prefix lives in each loop adapter's\n# `new_run_env` verb (lib/loops/<name>.sh). Returns 1 for an unknown type;\n# adapters that have no env to emit (ralph today) return 0 with no output, so\n# this dispatcher never branches on loop type.\nalmanac_loop_new_run_env() {\n  local type=\"$1\"; shift\n  almanac_loop_adapter_known \"$type\" || return 1\n  almanac_loop_adapter_call \"$type\" new_run_env \"$@\"\n}\n","numLines":967,"startLine":1,"totalLines":967}}}
