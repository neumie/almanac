{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VqGjdGezvh6ShCnSksJKBK","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops.sh — the loop-adapter seam (discovery + dispatch).\n3\t#\n4\t# Mirrors the provider-adapter seam (lib/agent.sh): each loop (ralph, harden) is a\n5\t# drop-in adapter file at lib/loops/<name>.sh answering one fixed question set, so\n6\t# no central code branches on a loop type. This module owns discovery (the loop\n7\t# list IS the files present), name-normalising dispatch (the one place a loop type\n8\t# becomes a function call), and auto-loads the adapters at source time.\n9\t#\n10\t# Each adapter (called as almanac_loop_<name>_<verb>) declares two contracts:\n11\t#   launch  — exec_argv: how to exec its runner (config in, _ALMANAC_LOOP_ARGV out)\n12\t#             — consumed by the launcher (lib/loop-launcher.sh)\n13\t#   control — signal_file <stop|steer>: its between-round dot-file basename.\n14\t#             Optional override — almanac_loop_default_signal_file (below) handles\n15\t#             the standard `.${name}-${kind}` convention every loop uses today, so\n16\t#             adapters only define this if their convention diverges. Resolved\n17\t#             through almanac_loop_signal_file (consumed by lib/run.sh control).\n18\t#\n19\t# Self-contained: uses only printf / tr / basename / source — no lib/core.sh\n20\t# dependency — so the seam (and the adapters) are their own test surface and\n21\t# tests/test-loops.sh sources this file directly.\n22\t\n23\t__almanac_loops_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t\n25\t# Normalise a loop name to its adapter key (lowercase).\n26\talmanac_loop_adapter_key() {\n27\t  printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]'\n28\t}\n29\t\n30\t# Source every loop adapter (idempotent — adapters only define functions).\n31\talmanac_loop_adapter_load() {\n32\t  local f\n33\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n34\t    [ -f \"$f\" ] || continue\n35\t    # shellcheck source=/dev/null\n36\t    source \"$f\"\n37\t  done\n38\t  return 0\n39\t}\n40\t\n41\t# List discovered loop names — the loop list IS the files present, so there is no\n42\t# second place to update. Sorted by the glob (alphabetical).\n43\talmanac_loop_adapter_list() {\n44\t  local f name\n45\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n46\t    [ -f \"$f\" ] || continue\n47\t    name=\"$(basename \"$f\" .sh)\"\n48\t    printf '%s\\n' \"$name\"\n49\t  done\n50\t  return 0\n51\t}\n52\t\n53\t# Is NAME a discovered loop?\n54\talmanac_loop_adapter_known() {\n55\t  local want target\n56\t  want=\"$(almanac_loop_adapter_key \"$1\")\"\n57\t  while IFS= read -r target; do\n58\t    [ \"$target\" = \"$want\" ] && return 0\n59\t  done <<EOF\n60\t$(almanac_loop_adapter_list)\n61\tEOF\n62\t  return 1\n63\t}\n64\t\n65\t# Dispatch a contract verb to NAME's adapter: almanac_loop_adapter_call <name>\n66\t# <verb> [args…]. Returns 2 if the adapter doesn't implement the verb. This is the\n67\t# one place that turns (loop, verb) into a function call, so no caller branches on\n68\t# loop type.\n69\talmanac_loop_adapter_call() {\n70\t  local key verb fn\n71\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n72\t  verb=\"$2\"\n73\t  shift 2\n74\t  fn=\"almanac_loop_${key}_${verb}\"\n75\t  declare -F \"$fn\" >/dev/null 2>&1 || return 2\n76\t  \"$fn\" \"$@\"\n77\t}\n78\t\n79\t# Default signal-file basename for a loop's between-round control. Every loop uses\n80\t# the same `.${name}-${kind}` convention (`.ralph-stop`, `.harden-steer`, …) so the\n81\t# pattern lives once here instead of being copy-pasted into each adapter. A loop\n82\t# only needs to define its own `signal_file` if its convention diverges; this is\n83\t# the deepening that turns three identical stop|steer case-statements into none.\n84\t# Returns 1 for an unknown kind.\n85\talmanac_loop_default_signal_file() {\n86\t  local name=\"$1\" kind=\"$2\"\n87\t  case \"$kind\" in\n88\t    stop|steer) printf '.%s-%s\\n' \"$name\" \"$kind\" ;;\n89\t    *) return 1 ;;\n90\t  esac\n91\t}\n92\t\n93\t# Resolve a loop's signal-file basename: the adapter's override if it defines\n94\t# `signal_file`, else the standard `.${name}-${kind}` default. This is the\n95\t# control-contract public surface — callers (lib/run.sh, harden-core, converge-core)\n96\t# go through here instead of dispatching to the adapter directly, so adding a new\n97\t# loop costs zero signal_file code unless the loop is non-standard. Returns 1 for\n98\t# an unknown kind or an unknown loop name.\n99\talmanac_loop_signal_file() {\n100\t  local key fn\n101\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n102\t  almanac_loop_adapter_known \"$key\" || return 1\n103\t  fn=\"almanac_loop_${key}_signal_file\"\n104\t  if declare -F \"$fn\" >/dev/null 2>&1; then\n105\t    \"$fn\" \"$2\"\n106\t  else\n107\t    almanac_loop_default_signal_file \"$key\" \"$2\"\n108\t  fi\n109\t}\n110\t\n111\talmanac_loop_adapter_load\n112\t"}]},"parent_tool_use_id":"toolu_01RZGwwDRZp9MotZJ6b26mSg","session_id":"92d47660-4965-47f1-a4d3-fc4dbbc15bee","uuid":"ed876e40-fa68-47d5-8d09-45c3df3e8bc4","timestamp":"2026-05-27T06:31:25.694Z","subagent_type":"Explore","task_description":"Codebase friction survey"}
