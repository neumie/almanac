{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QcdVt6PakMMFdoTCL4essc","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# ui.sh - gum-or-plain UI seam (the engine's only presentation layer)\n3\t#\n4\t# The supervision dashboard is a gum-styled redraw loop (PRD: bash + gum, no true\n5\t# TUI). Render LOGIC is kept pure (state -> printable rows) so it is unit-testable\n6\t# without a terminal; gum is only a styling layer wrapped around that text, and the\n7\t# CLI degrades to plain output when gum is absent — keeping almanac's near-zero-dep\n8\t# promise. Set ALMANAC_NO_GUM=1 to force plain output (tests, CI, scripts).\n9\t#\n10\t# Self-contained: these helpers use only printf/read/cat/gum and never call the\n11\t# _die/_info output helpers, so this file has no dependency on lib/core.sh. Every\n12\t# consumer (lib/run.sh, the launcher, harden-core, the hub) sources it directly.\n13\t\n14\t# True (0) only when gum styling should be used: gum is installed, stdout is a\n15\t# terminal, and the operator has not opted out via ALMANAC_NO_GUM. Piped/captured\n16\t# output is never styled, so callers and tests can assert on plain content.\n17\talmanac_loop_ui_has_gum() {\n18\t  [ -z \"${ALMANAC_NO_GUM:-}\" ] || return 1\n19\t  command -v gum >/dev/null 2>&1 || return 1\n20\t  [ -t 1 ] || return 1\n21\t  return 0\n22\t}\n23\t\n24\t# Like almanac_loop_ui_has_gum, but for the interactive SELECTORS (choose / input\n25\t# / confirm). They are called inside `$( … )` to capture the chosen value, so\n26\t# their stdout is a pipe and `[ -t 1 ]` is ALWAYS false — which wrongly forced the\n27\t# plain menus even with gum installed on a real terminal. gum interacts via the\n28\t# controlling terminal, not stdout, so gate on stderr being a TTY (`[ -t 2 ]`):\n29\t# true inside command substitution on a real terminal, false when piped/captured\n30\t# (tests, scripts), so the plain fallback still kicks in off a TTY.\n31\talmanac_loop_ui_has_gum_interactive() {\n32\t  [ -z \"${ALMANAC_NO_GUM:-}\" ] || return 1\n33\t  command -v gum >/dev/null 2>&1 || return 1\n34\t  [ -t 2 ] || return 1\n35\t  return 0\n36\t}\n37\t\n38\t# Style a block of text read from stdin: a rounded gum panel when gum styling is\n39\t# available, otherwise the text passed straight through. Presentation only; the\n40\t# content is identical either way, so the dashboard degrades gracefully and stays\n41\t# assertable.\n42\talmanac_loop_ui_render() {\n43\t  if almanac_loop_ui_has_gum; then\n44\t    gum style --border rounded --padding \"0 1\" \"$(cat)\"\n45\t  else\n46\t    cat\n47\t  fi\n48\t}\n49\t\n50\t# Clear the terminal between redraw-loop frames — but ONLY when stdout is a TTY,\n51\t# so piped/captured output (tests, scripts, the hub reading a tail) is never\n52\t# polluted with clear escape sequences. A no-op off a terminal. Uses clear(1)\n53\t# when present, else the ANSI clear+home sequence.\n54\talmanac_loop_ui_clear() {\n55\t  [ -t 1 ] || return 0\n56\t  if command -v clear >/dev/null 2>&1; then\n57\t    clear\n58\t  else\n59\t    printf '\\033[2J\\033[H'\n60\t  fi\n61\t}\n62\t\n63\t# Pure state -> glyph mapping for a worker-health OR run-lifecycle state. Plain\n64\t# unicode, no color, no gum, so the dashboard/hub composer that calls it stays\n65\t# deterministic. Worker health: running/stalled/idle/looping/done/failed. Run\n66\t# lifecycle adds `stale` (a running entry whose pid is gone) and `aborted`.\n67\talmanac_loop_ui_status_glyph() {\n68\t  case \"$1\" in\n69\t    running) printf '%s\\n' \"●\" ;;\n70\t    stalled) printf '%s\\n' \"◐\" ;;\n71\t    stale)   printf '%s\\n' \"◌\" ;;\n72\t    idle)    printf '%s\\n' \"○\" ;;\n73\t    looping) printf '%s\\n' \"↻\" ;;\n74\t    done)    printf '%s\\n' \"✔\" ;;\n75\t    failed)  printf '%s\\n' \"✘\" ;;\n76\t    aborted) printf '%s\\n' \"■\" ;;\n77\t    *)       printf '%s\\n' \"•\" ;;\n78\t  esac\n79\t}\n80\t\n81\t# --- Interactive selection primitives (gum-or-plain) ---------------------------\n82\t#\n83\t# The interactive hub (and any other menu-driven flow) picks from a list, reads a\n84\t# free-text value, and asks yes/no. With gum those are gum choose/input/confirm;\n85\t# without gum they degrade to a plain numbered menu + `read`, so the menus work on\n86\t# any TTY — keeping almanac's near-zero-dep promise (PRD: \"degrade gracefully when\n87\t# gum is absent\"). The selection LOGIC is split into pure functions (menu_render,\n88\t# menu_pick) that are unit-testable off a terminal; the choose/input/confirm\n89\t# wrappers add only the gum-or-`read` I/O around them. Set ALMANAC_NO_GUM=1 to\n90\t# force the plain path (tests, CI, scripts).\n91\t\n92\t# Pure: render OPTIONS as a 1-based numbered menu, one per line, to stdout. The\n93\t# plain-mode selector prints this; tests assert on it directly. No gum, no read.\n94\talmanac_loop_ui_menu_render() {\n95\t  local i=1 opt\n96\t  for opt in \"$@\"; do\n97\t    printf '  %d) %s\\n' \"$i\" \"$opt\"\n98\t    i=$((i + 1))\n99\t  done\n100\t}\n101\t\n102\t# Pure: map a 1-based selection number to the chosen OPTION, echoed on stdout.\n103\t# Returns 1 for a blank, non-numeric, or out-of-range selection so the caller can\n104\t# treat it like a cancel. No gum, no read — the testable core of the plain chooser.\n105\talmanac_loop_ui_menu_pick() {\n106\t  local sel=\"$1\"\n107\t  shift\n108\t  case \"$sel\" in\n109\t    ''|*[!0-9]*) return 1 ;;\n110\t  esac\n111\t  [ \"$sel\" -ge 1 ] && [ \"$sel\" -le \"$#\" ] || return 1\n112\t  shift \"$((sel - 1))\"\n113\t  printf '%s\\n' \"$1\"\n114\t}\n115\t\n116\t# Choose one of OPTIONS under HEADER. With gum styling available: `gum choose`.\n117\t# Without it: print the header + numbered menu to stderr, read a number from\n118\t# stdin, and map it to the option via the pure pick. Either way the chosen option\n119\t# is the ONLY thing on stdout (the prompt goes to stderr), so callers capture just\n120\t# the choice. Returns nonzero on cancel / EOF / bad input, mirroring gum choose's\n121\t# cancel exit so callers can `|| return` to go back.\n122\talmanac_loop_ui_choose() {\n123\t  local header=\"$1\"\n124\t  shift\n125\t  local reply\n126\t  if almanac_loop_ui_has_gum_interactive; then\n127\t    printf '%s\\n' \"$@\" | gum choose --header \"$header\"\n128\t    return\n129\t  fi\n130\t  printf '%s\\n' \"$header\" >&2\n131\t  almanac_loop_ui_menu_render \"$@\" >&2\n132\t  printf 'Select [1-%d]: ' \"$#\" >&2\n133\t  read -r reply || return 1\n134\t  almanac_loop_ui_menu_pick \"$reply\" \"$@\"\n135\t}\n136\t\n137\t# Prompt for a free-text value under HEADER, with an optional DEFAULT ($2). With\n138\t# gum: `gum input`. Without it: a plain `read` (empty input falls back to the\n139\t# default). The value is echoed on stdout; the prompt goes to stderr.\n140\talmanac_loop_ui_input() {\n141\t  local header=\"$1\"\n142\t  local default=\"${2:-}\"\n143\t  local reply\n144\t  if almanac_loop_ui_has_gum_interactive; then\n145\t    if [ -n \"$default\" ]; then\n146\t      gum input --header \"$header\" --value \"$default\"\n147\t    else\n148\t      gum input --header \"$header\"\n149\t    fi\n150\t    return\n151\t  fi\n152\t  if [ -n \"$default\" ]; then\n153\t    printf '%s [%s]: ' \"$header\" \"$default\" >&2\n154\t  else\n155\t    printf '%s: ' \"$header\" >&2\n156\t  fi\n157\t  read -r reply || reply=\"\"\n158\t  [ -n \"$reply\" ] || reply=\"$default\"\n159\t  printf '%s\\n' \"$reply\"\n160\t}\n161\t\n162\t# Yes/no confirm of PROMPT. With gum: `gum confirm`. Without it: a plain `read`,\n163\t# defaulting to yes on empty input to match gum confirm's affirmative-default\n164\t# button. Returns 0 for yes, 1 for no (gum confirm's exit semantics), so callers\n165\t# keep `gum confirm … || fallback` shape unchanged. Prompt goes to stderr.\n166\talmanac_loop_ui_confirm() {\n167\t  local prompt=\"$1\"\n168\t  local reply\n169\t  if almanac_loop_ui_has_gum_interactive; then\n170\t    gum confirm \"$prompt\"\n171\t    return\n172\t  fi\n173\t  printf '%s [Y/n]: ' \"$prompt\" >&2\n174\t  read -r reply || reply=\"\"\n175\t  case \"$reply\" in\n176\t    n|N|no|NO|No) return 1 ;;\n177\t    *) return 0 ;;\n178\t  esac\n179\t}\n180\t"}]},"parent_tool_use_id":"toolu_01RZGwwDRZp9MotZJ6b26mSg","session_id":"92d47660-4965-47f1-a4d3-fc4dbbc15bee","uuid":"ca705a84-b3f5-4218-94f4-5f4e1f381be6","timestamp":"2026-05-27T06:31:23.066Z","subagent_type":"Explore","task_description":"Codebase friction survey"}
