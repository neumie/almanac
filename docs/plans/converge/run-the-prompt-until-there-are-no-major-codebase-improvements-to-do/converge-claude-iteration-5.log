{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016QdrhgtWPebmWnD2jYA98b","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# converge-core.sh - Generic convergence loop core\n3\t\n4\t# Source focused deps idempotently so tests can source this file directly.\n5\t# core.sh owns the helper, so it's pulled in via the literal pattern.\n6\tif ! declare -F _error >/dev/null 2>&1; then\n7\t  __converge_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n8\t  # shellcheck source=lib/core.sh\n9\t  source \"$__converge_core_dir/core.sh\"\n10\t  unset __converge_core_dir\n11\tfi\n12\t\n13\t_almanac_source_sibling run.sh    almanac_loop_register_run\n14\t_almanac_source_sibling agent.sh  almanac_loop_agent_capture\n15\t_almanac_source_sibling role.sh   almanac_loop_role_config\n16\t\n17\talmanac_converge_plan_dir() {\n18\t  local root=\"$1\"\n19\t  local slug=\"$2\"\n20\t\n21\t  printf '%s/docs/plans/converge/%s\\n' \"$root\" \"$slug\"\n22\t}\n23\t\n24\talmanac_converge_scaffold() {\n25\t  local root=\"$1\"\n26\t  local goal=\"$2\"\n27\t  local plan_dir\n28\t\n29\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n30\t\n31\t  if ! mkdir -p \"$plan_dir\"; then\n32\t    _die \"Could not create converge plan dir: ${plan_dir#\"$root\"/}\"\n33\t  fi\n34\t  if ! printf '%s\\n' \"$goal\" > \"$plan_dir/goal.md\"; then\n35\t    _die \"Could not write converge goal: ${plan_dir#\"$root\"/}/goal.md\"\n36\t  fi\n37\t  if ! : > \"$plan_dir/agent-reports.log\"; then\n38\t    _die \"Could not write converge report log: ${plan_dir#\"$root\"/}/agent-reports.log\"\n39\t  fi\n40\t  if ! : > \"$plan_dir/goal.history.log\"; then\n41\t    _die \"Could not write converge goal history: ${plan_dir#\"$root\"/}/goal.history.log\"\n42\t  fi\n43\t}\n44\t\n45\talmanac_converge_role() {\n46\t  local role=\"$1\"\n47\t\n48\t  case \"$role\" in\n49\t    agent|overseer) ;;\n50\t    *) return 2 ;;\n51\t  esac\n52\t\n53\t  almanac_loop_role_config \"converge\" \"$role\" \"\" \"$(almanac_provider_default)\" \"\" \"\"\n54\t}\n55\t\n56\talmanac_converge_role_field() {\n57\t  local role=\"$1\"\n58\t  local field=\"$2\"\n59\t\n60\t  almanac_converge_role \"$role\" | awk -F'\\t' -v k=\"$field\" '$1 == k { v = $2 } END { print v }'\n61\t}\n62\t\n63\talmanac_converge_ensure_prompt_template() {\n64\t  local root=\"$1\"\n65\t  local goal=\"$2\"\n66\t  local plan_dir prompt_file\n67\t\n68\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n69\t  prompt_file=\"$plan_dir/prompt.md\"\n70\t  [ -f \"$prompt_file\" ] && return 0\n71\t\n72\t  cat > \"$prompt_file\" <<'EOF'\n73\t# Converge Worker\n74\t\n75\tYou are one worker round in a generic convergence loop.\n76\t\n77\tRead current goal, follow one-shot steer directive if present, run exact exec\n78\tcommand, then leave clear evidence in git history and agent-reports.log.\n79\t\n80\tDo not edit the goal unless explicitly asked by the exec command. Do not commit\n81\t.almanac or converge state files under docs/plans/converge/.\n82\tEOF\n83\t}\n84\t\n85\talmanac_converge_worker_prompt() {\n86\t  local root=\"$1\"\n87\t  local goal=\"$2\"\n88\t  local exec_cmd=\"$3\"\n89\t  local round=\"$4\"\n90\t  local slug plan_dir rel_plan steer_file\n91\t\n92\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n93\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n94\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n95\t  steer_file=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n96\t\n97\t  almanac_converge_ensure_prompt_template \"$root\" \"$goal\"\n98\t\n99\t  cat \"$plan_dir/prompt.md\"\n100\t  cat <<EOF\n101\t\n102\tCONVERGE_TICK=$round\n103\tCONVERGE_SLUG=$slug\n104\tCONVERGE_PLAN_DIR=$rel_plan\n105\tCONVERGE_REPORT_LOG=$rel_plan/agent-reports.log\n106\t\n107\tCommit user-visible worktree changes, excluding .almanac and $rel_plan, with:\n108\tCONVERGE($slug): <one-line summary>\n109\t\n110\tAppend one structured self-report to $rel_plan/agent-reports.log. Use this exact\n111\theader shape and these exact section labels:\n112\t\n113\t===== tick=<N> ts=<ISO> =====\n114\tsummary:\n115\tconcerns:\n116\tnext:\n117\t\n118\tFor this round, N is $round.\n119\t\n120\t===== GOAL.md =====\n121\tEOF\n122\t  cat \"$plan_dir/goal.md\"\n123\t  cat <<EOF\n124\t===== END GOAL.md =====\n125\t\n126\t===== EXEC COMMAND =====\n127\t$exec_cmd\n128\t===== END EXEC COMMAND =====\n129\tEOF\n130\t\n131\t  if [ -f \"$steer_file\" ]; then\n132\t    cat <<'EOF'\n133\t\n134\t===== STEER =====\n135\tEOF\n136\t    cat \"$steer_file\"\n137\t    cat <<'EOF'\n138\t===== END STEER =====\n139\tEOF\n140\t    rm -f \"$steer_file\"\n141\t  fi\n142\t}\n143\t\n144\talmanac_converge_report_log_has_structured_block() {\n145\t  local file=\"$1\"\n146\t\n147\t  [ -f \"$file\" ] || return 1\n148\t  awk '\n149\t    /^===== tick=[0-9][0-9]* ts=.* =====$/ {\n150\t      seen = 1\n151\t      summary = 0\n152\t      concerns = 0\n153\t      next_seen = 0\n154\t      next\n155\t    }\n156\t    seen && /^summary:$/ { summary = 1; next }\n157\t    seen && /^concerns:$/ { concerns = 1; next }\n158\t    seen && /^next:$/ { next_seen = 1; ok = summary && concerns && next_seen; next }\n159\t    END { exit ok ? 0 : 1 }\n160\t  ' \"$file\"\n161\t}\n162\t\n163\talmanac_converge_trim() {\n164\t  printf '%s' \"$1\" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'\n165\t}\n166\t\n167\talmanac_converge_overseer_prompt() {\n168\t  local root=\"$1\"\n169\t  local goal=\"$2\"\n170\t  local round=\"$3\"\n171\t  local slug plan_dir rel_plan reports_file reports commits\n172\t\n173\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n174\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n175\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n176\t  reports_file=\"$plan_dir/agent-reports.log\"\n177\t\n178\t  if [ -f \"$reports_file\" ]; then\n179\t    reports=\"$(tail -c 8192 \"$reports_file\")\"\n180\t  else\n181\t    reports=\"(no agent reports yet)\"\n182\t  fi\n183\t\n184\t  commits=\"$(git -C \"$root\" log --fixed-strings --grep=\"CONVERGE($slug):\" -n 10 \\\n185\t    --format='%H%n%ad%n%B%n---' --date=short 2>/dev/null || true)\"\n186\t  [ -n \"$commits\" ] || commits=\"No CONVERGE commits yet\"\n187\t\n188\t  cat <<EOF\n189\tYou are the overseer for converge($slug), a synchronous convergence loop.\n190\t\n191\tCONVERGE_TICK=$round\n192\tCONVERGE_SLUG=$slug\n193\tCONVERGE_PLAN_DIR=$rel_plan\n194\t\n195\tJudge whether the current goal is satisfied, whether the next worker needs a\n196\tone-shot steering directive, or whether the loop should stop.\n197\t\n198\t===== GOAL.md =====\n199\tEOF\n200\t  cat \"$plan_dir/goal.md\"\n201\t  cat <<EOF\n202\t===== END GOAL.md =====\n203\t\n204\t===== RECENT AGENT SELF-REPORTS (last ~8KB) =====\n205\t$reports\n206\t===== END RECENT AGENT SELF-REPORTS =====\n207\t\n208\t===== RECENT CONVERGE COMMITS (last 10) =====\n209\t$commits\n210\t===== END RECENT CONVERGE COMMITS =====\n211\t\n212\tOutput these fields in order with no preamble:\n213\tVERDICT: <CONVERGED|CONTINUE|STEER|STOP>\n214\tREASON: <one paragraph>\n215\tSTEER: <one paragraph, or 'none'>\n216\tGOAL_UPDATE: <new goal.md content, or 'unchanged'>\n217\t\n218\tBe conservative. Malformed output is treated as CONTINUE with no steering and no\n219\tgoal update. GOAL_UPDATE may span multiple lines because it is the final field.\n220\tEOF\n221\t}\n222\t\n223\talmanac_converge_overseer_parse() {\n224\t  local input=\"${1:-}\"\n225\t  local content line key_line current_key=\"\"\n226\t  local raw_verdict=\"\" raw_reason=\"\" raw_steer=\"\" raw_goal=\"\"\n227\t  local found_verdict=0 found_reason=0 found_steer=0 found_goal=0\n228\t\n229\t  if [ -f \"$input\" ]; then\n230\t    content=\"$(cat \"$input\")\"\n231\t  else\n232\t    content=\"$input\"\n233\t  fi\n234\t\n235\t  ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n236\t  ALMANAC_CONVERGE_REASON=\"\"\n237\t  ALMANAC_CONVERGE_STEER=\"none\"\n238\t  ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n239\t\n240\t  # State-machine line walker. Each KEY: prefix switches the current field;\n241\t  # subsequent non-key lines append to whatever field is currently open. This\n242\t  # lets the LLM emit either inline values (`REASON: blah`) or values on the\n243\t  # next line (`REASON:\\nblah`) or multi-line paragraphs that span until the\n244\t  # next KEY: marker — all parse correctly. Before this fix the parser only\n245\t  # captured the value text on the SAME line as KEY:, dropping continuation\n246\t  # lines and producing empty REASON / STEER for any LLM that emitted\n247\t  # paragraph-shaped values — the bug observed in the first --prompt converge\n248\t  # run (REASON empty, STEER none in the overseer.log entry despite the LLM\n249\t  # clearly being asked to produce both).\n250\t  while IFS= read -r line || [ -n \"$line\" ]; do\n251\t    key_line=\"$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\"\n252\t    case \"$key_line\" in\n253\t      VERDICT:*)\n254\t        current_key=\"VERDICT\"; found_verdict=1\n255\t        raw_verdict=\"${key_line#VERDICT:}\"\n256\t        case \"$raw_verdict\" in \" \"*) raw_verdict=\"${raw_verdict# }\" ;; esac\n257\t        ;;\n258\t      REASON:*)\n259\t        current_key=\"REASON\"; found_reason=1\n260\t        raw_reason=\"${key_line#REASON:}\"\n261\t        case \"$raw_reason\" in \" \"*) raw_reason=\"${raw_reason# }\" ;; esac\n262\t        ;;\n263\t      STEER:*)\n264\t        current_key=\"STEER\"; found_steer=1\n265\t        raw_steer=\"${key_line#STEER:}\"\n266\t        case \"$raw_steer\" in \" \"*) raw_steer=\"${raw_steer# }\" ;; esac\n267\t        ;;\n268\t      GOAL_UPDATE:*)\n269\t        current_key=\"GOAL_UPDATE\"; found_goal=1\n270\t        raw_goal=\"${key_line#GOAL_UPDATE:}\"\n271\t        case \"$raw_goal\" in \" \"*) raw_goal=\"${raw_goal# }\" ;; esac\n272\t        ;;\n273\t      *)\n274\t        # Continuation line — append to whichever field is currently open.\n275\t        # Lines before the first KEY: marker (preamble noise) have current_key\n276\t        # empty and are dropped, matching the prompt's \"no preamble\" contract.\n277\t        # The original line (not the leading-whitespace-stripped key_line) is\n278\t        # preserved so multi-line paragraphs keep their indentation if any.\n279\t        case \"$current_key\" in\n280\t          VERDICT)     raw_verdict=\"${raw_verdict}\"$'\\n'\"${line}\" ;;\n281\t          REASON)      raw_reason=\"${raw_reason}\"$'\\n'\"${line}\" ;;\n282\t          STEER)       raw_steer=\"${raw_steer}\"$'\\n'\"${line}\" ;;\n283\t          GOAL_UPDATE) raw_goal=\"${raw_goal}\"$'\\n'\"${line}\" ;;\n284\t        esac\n285\t        ;;\n286\t    esac\n287\t  done <<< \"$content\"\n288\t\n289\t  if [ \"$found_verdict\" -ne 1 ] || [ \"$found_reason\" -ne 1 ] || \\\n290\t    [ \"$found_steer\" -ne 1 ] || [ \"$found_goal\" -ne 1 ]; then\n291\t    return 0\n292\t  fi\n293\t\n294\t  # VERDICT is always a single token. A chatty LLM may put the token on its own\n295\t  # line and then ramble before REASON; the state-machine above will have\n296\t  # accumulated those ramble lines into raw_verdict. Reduce to the first\n297\t  # non-empty line so the case-match below still recognises the token.\n298\t  raw_verdict=\"$(printf '%s\\n' \"$raw_verdict\" | awk 'NF{print; exit}')\"\n299\t  raw_verdict=\"$(almanac_converge_trim \"$raw_verdict\")\"\n300\t  case \"$raw_verdict\" in\n301\t    CONVERGED|CONTINUE|STEER|STOP) ALMANAC_CONVERGE_VERDICT=\"$raw_verdict\" ;;\n302\t    *)\n303\t      ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n304\t      ALMANAC_CONVERGE_STEER=\"none\"\n305\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n306\t      return 0\n307\t      ;;\n308\t  esac\n309\t\n310\t  ALMANAC_CONVERGE_REASON=\"$(almanac_converge_trim \"$raw_reason\")\"\n311\t\n312\t  raw_steer=\"$(almanac_converge_trim \"$raw_steer\")\"\n313\t  if [ -n \"$raw_steer\" ] && ! printf '%s\\n' \"$raw_steer\" | grep -qiE '^none[[:space:]]*$'; then\n314\t    ALMANAC_CONVERGE_STEER=\"$raw_steer\"\n315\t  fi\n316\t\n317\t  if [ \"$found_goal\" -eq 1 ]; then\n318\t    local goal_check\n319\t    goal_check=\"$(almanac_converge_trim \"$raw_goal\")\"\n320\t    if [ -n \"$goal_check\" ] && ! printf '%s\\n' \"$goal_check\" | grep -qiE '^unchanged[[:space:]]*$'; then\n321\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"$raw_goal\"\n322\t    fi\n323\t  fi\n324\t}\n325\t\n326\talmanac_converge_write_convergence() {\n327\t  local root=\"$1\"\n328\t  local goal=\"$2\"\n329\t  local verdict=\"$3\"\n330\t  local tick=\"$4\"\n331\t  local started_epoch=\"${5:-}\"\n332\t  local reason=\"${6:-}\"\n333\t  local plan_dir now_epoch elapsed\n334\t\n335\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n336\t  now_epoch=\"$(date +%s)\"\n337\t  elapsed=\"\"\n338\t  case \"$started_epoch\" in\n339\t    ''|*[!0-9]*) ;;\n340\t    *) elapsed=\"$((now_epoch - started_epoch))s\" ;;\n341\t  esac\n342\t\n343\t  {\n344\t    printf '# Convergence\\n\\n'\n345\t    printf '## Final verdict\\n\\n%s\\n\\n' \"$verdict\"\n346\t    printf '## Tick count\\n\\n%s\\n\\n' \"$tick\"\n347\t    printf '## Time elapsed\\n\\n%s\\n\\n' \"${elapsed:-unknown}\"\n348\t    printf '## Final goal\\n\\n'\n349\t    if [ -f \"$plan_dir/goal.md\" ]; then\n350\t      cat \"$plan_dir/goal.md\"\n351\t    fi\n352\t    printf '\\n\\n## Final reason\\n\\n%s\\n' \"${reason:-none}\"\n353\t  } > \"$plan_dir/convergence.md\"\n354\t}\n355\t\n356\talmanac_converge_goal_summary() {\n357\t  printf '%s' \"$1\" | tr '\\n' ' ' | cut -c 1-80\n358\t}\n359\t\n360\talmanac_converge_latest_run_id() {\n361\t  local root=\"$1\"\n362\t  local slug=\"$2\"\n363\t  local rows id type target pid status_rel started status match=\"\"\n364\t\n365\t  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n366\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n367\t    [ -n \"$id\" ] || continue\n368\t    [ \"$type\" = \"converge\" ] || continue\n369\t    [ \"$target\" = \"$slug\" ] || continue\n370\t    match=\"$id\"\n371\t  done <<< \"$rows\"\n372\t\n373\t  [ -n \"$match\" ] || return 1\n374\t  printf '%s\\n' \"$match\"\n375\t}\n376\t\n377\talmanac_converge_worker_health() {\n378\t  local root=\"$1\"\n379\t  local run_id=\"$2\"\n380\t  local status_file status\n381\t\n382\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n383\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"dead\"; return 0; }\n384\t\n385\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n386\t  if [ \"$status\" = \"running\" ] && ! almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n387\t    printf '%s\\n' \"alive\"\n388\t  else\n389\t    printf '%s\\n' \"dead\"\n390\t  fi\n391\t}\n392\t\n393\talmanac_converge_last_verdict_line() {\n394\t  local log_file=\"$1\"\n395\t\n396\t  [ -f \"$log_file\" ] || return 1\n397\t  awk '\n398\t    /^===== tick=/ { verdict = \"\"; reason = \"\" }\n399\t    /^VERDICT: / { verdict = substr($0, 10) }\n400\t    /^REASON: / { reason = substr($0, 9) }\n401\t    END {\n402\t      if (verdict != \"\" || reason != \"\") {\n403\t        printf \"%s\\t%s\\n\", verdict, reason\n404\t      }\n405\t    }\n406\t  ' \"$log_file\"\n407\t}\n408\t\n409\talmanac_converge_last_report_header() {\n410\t  local reports_file=\"$1\"\n411\t\n412\t  [ -f \"$reports_file\" ] || return 1\n413\t  grep -E '^===== tick=[0-9][0-9]* ts=.* =====$' \"$reports_file\" 2>/dev/null | tail -n 1\n414\t}\n415\t\n416\talmanac_converge_goal_mutation_count() {\n417\t  local history_file=\"$1\"\n418\t\n419\t  [ -f \"$history_file\" ] || { printf '%s\\n' \"0\"; return 0; }\n420\t  awk '/^===== tick=[0-9][0-9]* ts=.* overseer=/ { c++ } END { print c + 0 }' \"$history_file\"\n421\t}\n422\t\n423\talmanac_converge_dashboard_frame() {\n424\t  local root=\"$1\"\n425\t  local slug=\"$2\"\n426\t  local plan_dir goal_file reports_file history_file log_file\n427\t  local run_id=\"\" status_file round=\"\" rounds=\"\" health=\"dead\"\n428\t  local verdict=\"none\" reason=\"none\" verdict_line report_header goal_text goal_summary mutations\n429\t  local tab=$'\\t'\n430\t\n431\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n432\t  [ -d \"$plan_dir\" ] || return 1\n433\t\n434\t  goal_file=\"$plan_dir/goal.md\"\n435\t  reports_file=\"$plan_dir/agent-reports.log\"\n436\t  history_file=\"$plan_dir/goal.history.log\"\n437\t  log_file=\"$plan_dir/overseer.log\"\n438\t\n439\t  if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n440\t    status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n441\t    round=\"$(almanac_loop_status_field \"$status_file\" \"round\" 2>/dev/null || true)\"\n442\t    rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" 2>/dev/null || true)\"\n443\t    health=\"$(almanac_converge_worker_health \"$root\" \"$run_id\")\"\n444\t  fi\n445\t  [ -n \"$round\" ] || round=\"0\"\n446\t  [ -n \"$rounds\" ] || rounds=\"?\"\n447\t\n448\t  if verdict_line=\"$(almanac_converge_last_verdict_line \"$log_file\" 2>/dev/null)\"; then\n449\t    verdict=\"${verdict_line%%$tab*}\"\n450\t    reason=\"${verdict_line#*$tab}\"\n451\t    [ \"$reason\" != \"$verdict_line\" ] || reason=\"none\"\n452\t    [ -n \"$verdict\" ] || verdict=\"none\"\n453\t    [ -n \"$reason\" ] || reason=\"none\"\n454\t  fi\n455\t\n456\t  report_header=\"$(almanac_converge_last_report_header \"$reports_file\" 2>/dev/null || true)\"\n457\t  [ -n \"$report_header\" ] || report_header=\"none\"\n458\t\n459\t  goal_text=\"\"\n460\t  [ -f \"$goal_file\" ] && goal_text=\"$(cat \"$goal_file\")\"\n461\t  goal_summary=\"$(almanac_converge_goal_summary \"$goal_text\")\"\n462\t  [ -n \"$goal_summary\" ] || goal_summary=\"none\"\n463\t  mutations=\"$(almanac_converge_goal_mutation_count \"$history_file\")\"\n464\t\n465\t  printf 'converge %s\\n' \"$slug\"\n466\t  printf 'current round: %s/%s\\n' \"$round\" \"$rounds\"\n467\t  printf 'last verdict: %s\\n' \"$verdict\"\n468\t  printf 'reason: %s\\n' \"$reason\"\n469\t  printf 'last report: %s\\n' \"$report_header\"\n470\t  printf 'goal: %s\\n' \"$goal_summary\"\n471\t  printf 'goal mutations: %s\\n' \"$mutations\"\n472\t  printf 'worker health: %s\\n' \"$health\"\n473\t}\n474\t\n475\talmanac_converge_status() {\n476\t  local root=\"$1\"\n477\t  local slug=\"$2\"\n478\t  local frame\n479\t\n480\t  frame=\"$(almanac_converge_dashboard_frame \"$root\" \"$slug\")\" || return 1\n481\t  printf '%s\\n' \"$frame\" | almanac_loop_ui_render\n482\t}\n483\t\n484\talmanac_converge_watch() {\n485\t  local root=\"$1\"\n486\t  local slug=\"$2\"\n487\t  local mode=\"${3:-}\"\n488\t  local interval=\"${CONVERGE_WATCH_INTERVAL:-${ALMANAC_HUB_WATCH_INTERVAL:-2}}\"\n489\t  local run_id status_file status\n490\t\n491\t  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n492\t    almanac_converge_status \"$root\" \"$slug\"\n493\t    return\n494\t  fi\n495\t\n496\t  while :; do\n497\t    almanac_loop_ui_clear\n498\t    almanac_converge_status \"$root\" \"$slug\"\n499\t    if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n500\t      status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n501\t      status=\"$(almanac_loop_status_field \"$status_file\" \"status\" 2>/dev/null || true)\"\n502\t      case \"$status\" in\n503\t        done|failed|aborted) break ;;\n504\t      esac\n505\t    fi\n506\t    sleep \"$interval\"\n507\t  done\n508\t}\n509\t\n510\talmanac_converge_stop() {\n511\t  local root=\"$1\"\n512\t  local slug=\"$2\"\n513\t  local plan_dir root_stop plan_stop\n514\t\n515\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n516\t  [ -d \"$plan_dir\" ] || return 1\n517\t  root_stop=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n518\t  plan_stop=\"$(almanac_loop_run_control_file converge \"$plan_dir\" stop)\"\n519\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$root_stop\"\n520\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$plan_stop\"\n521\t}\n522\t\n523\talmanac_converge_apply_goal_update() {\n524\t  local root=\"$1\"\n525\t  local goal=\"$2\"\n526\t  local round=\"$3\"\n527\t  local provider=\"$4\"\n528\t  local reason=\"$5\"\n529\t  local new_goal=\"$6\"\n530\t  local plan_dir goal_file history_file log_file ts old_goal old_file new_file diff_output diff_status summary\n531\t\n532\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n533\t  goal_file=\"$plan_dir/goal.md\"\n534\t  history_file=\"$plan_dir/goal.history.log\"\n535\t  log_file=\"$plan_dir/overseer.log\"\n536\t  ts=\"$(almanac_loop_now_utc)\"\n537\t  old_goal=\"\"\n538\t  [ -f \"$goal_file\" ] && old_goal=\"$(cat \"$goal_file\")\"\n539\t\n540\t  old_file=\"$plan_dir/.goal.old.$$\"\n541\t  new_file=\"$plan_dir/.goal.new.$$\"\n542\t  printf '%s\\n' \"$old_goal\" > \"$old_file\"\n543\t  printf '%s\\n' \"$new_goal\" > \"$new_file\"\n544\t\n545\t  diff_output=\"\"\n546\t  diff_status=127\n547\t  if command -v diff >/dev/null 2>&1; then\n548\t    if diff_output=\"$(diff -u \"$old_file\" \"$new_file\" 2>/dev/null)\"; then\n549\t      diff_status=0\n550\t    else\n551\t      diff_status=$?\n552\t    fi\n553\t  fi\n554\t\n555\t  {\n556\t    printf '===== tick=%s ts=%s overseer=%s =====\\n' \"$round\" \"$ts\" \"$provider\"\n557\t    printf 'REASON: %s\\n' \"$reason\"\n558\t    if [ \"$diff_status\" -le 1 ]; then\n559\t      printf -- '--- DIFF ---\\n'\n560\t      printf '%s\\n' \"$diff_output\"\n561\t    else\n562\t      printf -- '--- AFTER ---\\n'\n563\t      printf '%s\\n' \"$new_goal\"\n564\t    fi\n565\t  } >> \"$history_file\"\n566\t\n567\t  printf '%s\\n' \"$new_goal\" > \"$goal_file\"\n568\t  rm -f \"$old_file\" \"$new_file\"\n569\t\n570\t  summary=\"$(almanac_converge_goal_summary \"$new_goal\")\"\n571\t  printf '[tick=%s] goal updated: %s\\n' \"$round\" \"$summary\" >> \"$log_file\"\n572\t}\n573\t\n574\talmanac_converge_run_finalize() {\n575\t  local root=\"$1\"\n576\t  local run_id=\"$2\"\n577\t  local status=\"$3\"\n578\t  local reason=\"${4:-}\"\n579\t\n580\t  trap - EXIT INT TERM\n581\t  [ -n \"$run_id\" ] || return 0\n582\t  almanac_loop_mark_run_status \"$root\" \"$run_id\" \"$status\" \"\" \"$reason\" >/dev/null 2>&1 || true\n583\t}\n584\t\n585\talmanac_converge_git_user_status() {\n586\t  local root=\"$1\"\n587\t  local plan_dir=\"$2\"\n588\t  local rel_plan\n589\t\n590\t  git -C \"$root\" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1\n591\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n592\t\n593\t  if [ \"$rel_plan\" = \"$plan_dir\" ]; then\n594\t    git -C \"$root\" status --porcelain -- . ':!.almanac'\n595\t  else\n596\t    git -C \"$root\" status --porcelain -- . ':!.almanac' \":!$rel_plan\"\n597\t  fi\n598\t}\n599\t\n600\talmanac_converge_run_worker() {\n601\t  local root=\"$1\"\n602\t  local goal=\"$2\"\n603\t  local exec_cmd=\"$3\"\n604\t  local round=\"$4\"\n605\t  local provider model effort prompt_file result_file events_file plan_dir slug rc\n606\t\n607\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n608\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n609\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n610\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n611\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n612\t\n613\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-prompt.XXXXXX\")\"\n614\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-result.XXXXXX\")\"\n615\t  # Persistent per-round session log under the plan dir (mirrors ralph's\n616\t  # docs/plans/<name>/ralph-codex-iteration-N.log). The full raw event stream\n617\t  # tees here while the filtered agent-message text streams live to the\n618\t  # terminal — operator sees progress, durable log is kept for forensics.\n619\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n620\t\n621\t  almanac_converge_worker_prompt \"$root\" \"$goal\" \"$exec_cmd\" \"$round\" > \"$prompt_file\"\n622\t\n623\t  _info \"Converge round $round — exec-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n624\t\n625\t  # danger-full-access sandbox: converge runs are autonomous-by-design.\n626\t  # `claude --print` has no human to answer a permission prompt, so anything\n627\t  # less than full access dies on every un-allowlisted Bash call (\"This\n628\t  # command requires approval\"). For codex this drops the sandbox; for claude\n629\t  # it maps to --permission-mode bypassPermissions (per the provider adapter).\n630\t  rc=0\n631\t  almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n632\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr || rc=$?\n633\t\n634\t  rm -f \"$prompt_file\" \"$result_file\"\n635\t  return \"$rc\"\n636\t}\n637\t\n638\t# Prompt-mode round: the user's --prompt text IS the agent invocation. No worker\n639\t# template wrapper — the agent receives the prompt verbatim, prefixed only with\n640\t# a one-shot .converge-steer directive if one is queued. This is the dominant\n641\t# mode for \"run skill X in a convergence loop\" workflows; the loop driver\n642\t# handles the bookkeeping (auto-commit + agent-reports.log entry) after the\n643\t# agent exits, instead of asking the agent to know about CONVERGE conventions.\n644\t#\n645\t# Returns the agent's exit code; commit and report writes are best-effort and\n646\t# never alter the return.\n647\t# List every currently-dirty path in $root, one per line, sorted+deduped.\n648\t# Output is the union of:\n649\t#   - tracked-modified paths (`git diff --name-only HEAD`)\n650\t#   - untracked-not-ignored paths (`git ls-files --others --exclude-standard`)\n651\t# Used by the prompt-mode auto-commit to distinguish PRE-EXISTING dirty work\n652\t# (untouched by the agent) from AGENT-TOUCHED paths (commit candidates). Empty\n653\t# string on git failure or non-repo. Pure read-only — safe to call multiple\n654\t# times per round.\n655\talmanac_converge_dirty_paths() {\n656\t  local root=\"$1\"\n657\t  ( cd \"$root\" \\\n658\t      && { git diff --name-only HEAD 2>/dev/null; \\\n659\t           git ls-files --others --exclude-standard 2>/dev/null; } \\\n660\t      | sort -u\n661\t  )\n662\t}\n663\t\n664\t# Auto-commit ONLY the paths the agent newly touched this round, computed as\n665\t# (dirty-after) - (dirty-before). Pre-existing dirty paths are left alone so a\n666\t# concurrent unrelated edit never gets swept into a CONVERGE commit (the bug\n667\t# that caused commit 4526a58 to misattribute the developer's in-flight edits\n668\t# to the agent). Files that were pre-existing dirty AND also touched by the\n669\t# agent stay dirty — conservative; the agent's change in that file isn't\n670\t# committed by this round, but no false attribution happens. Best-effort:\n671\t# commit failure logs a warn and never alters the caller's return code.\n672\t#\n673\t# Args: ROOT SLUG ROUND PRE_DIRTY (newline-separated pre-existing dirty paths)\n674\talmanac_converge_commit_agent_paths() {\n675\t  local root=\"$1\" slug=\"$2\" round=\"$3\" pre_dirty=\"$4\"\n676\t  local post_dirty agent_paths\n677\t\n678\t  post_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n679\t  # comm needs sorted inputs; both producers (almanac_converge_dirty_paths +\n680\t  # the snapshot taken before the agent ran) emit sorted-unique.\n681\t  agent_paths=\"$(comm -23 <(printf '%s\\n' \"$post_dirty\") <(printf '%s\\n' \"$pre_dirty\") | sed '/^$/d')\"\n682\t\n683\t  if [ -z \"$agent_paths\" ]; then\n684\t    # Either the agent didn't change anything OR every change was on a path\n685\t    # that was already dirty (so the change stays uncommitted on purpose).\n686\t    return 0\n687\t  fi\n688\t\n689\t  # Stage each agent-touched path individually (handles deletions, new files,\n690\t  # and modifications — `git add` accepts paths to files that no longer exist\n691\t  # by recording the deletion).\n692\t  local path failed=0\n693\t  while IFS= read -r path; do\n694\t    [ -n \"$path\" ] || continue\n695\t    (cd \"$root\" && git add -- \"$path\" >/dev/null 2>&1) || failed=1\n696\t  done <<< \"$agent_paths\"\n697\t\n698\t  if [ \"$failed\" -eq 1 ]; then\n699\t    _warn \"Converge round $round: staging one or more agent-touched paths failed (changes left in worktree)\"\n700\t    return 0\n701\t  fi\n702\t\n703\t  if ! (cd \"$root\" \\\n704\t          && git -c user.email=converge@almanac -c user.name=converge \\\n705\t                 commit -m \"CONVERGE($slug): round $round\" --no-verify >/dev/null 2>&1); then\n706\t    _warn \"Converge round $round: auto-commit failed (changes left in worktree)\"\n707\t  fi\n708\t}\n709\t\n710\talmanac_converge_run_worker_prompt() {\n711\t  local root=\"$1\"\n712\t  local goal=\"$2\"\n713\t  local prompt=\"$3\"\n714\t  local round=\"$4\"\n715\t  local provider model effort prompt_file result_file events_file rc\n716\t  local slug plan_dir log_file steer_path ts result_summary\n717\t\n718\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n719\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n720\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n721\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n722\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n723\t  log_file=\"$plan_dir/agent-reports.log\"\n724\t  steer_path=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n725\t\n726\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-prompt.XXXXXX\")\"\n727\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-result.XXXXXX\")\"\n728\t  # Persistent per-round session log under the plan dir (same shape as\n729\t  # exec-mode + ralph's per-iteration logs). Streams live to terminal so the\n730\t  # operator sees the agent working; tees the raw stream here for forensics.\n731\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n732\t\n733\t  # Steer (one-shot): emitted by the overseer in the prior round, consumed and\n734\t  # removed here so the next overseer tick can re-emit if the issue persists.\n735\t  # Steer prefix comes BEFORE the user prompt so a slash command sees the\n736\t  # directive as context before its own work.\n737\t  {\n738\t    if [ -f \"$steer_path\" ]; then\n739\t      printf '# Steer directive (from previous overseer tick):\\n'\n740\t      cat \"$steer_path\"\n741\t      printf '\\n\\n'\n742\t      rm -f \"$steer_path\"\n743\t    fi\n744\t    printf '%s\\n' \"$prompt\"\n745\t  } > \"$prompt_file\"\n746\t\n747\t  _info \"Converge round $round — prompt-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n748\t\n749\t  # Snapshot the dirty worktree BEFORE the agent runs so the auto-commit below\n750\t  # can stage only the paths the agent newly touches — not whatever unrelated\n751\t  # work the operator had in-flight. (Without this snapshot, an earlier `git\n752\t  # add -A` swept up the developer's uncommitted edits and committed them\n753\t  # under the agent's name — bug observed in commit 4526a58.)\n754\t  local pre_dirty\n755\t  pre_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n756\t\n757\t  # danger-full-access: same rationale as exec-mode worker — converge agents\n758\t  # need to run arbitrary shell (tests, git status, lint) the prompt asks for.\n759\t  rc=0\n760\t  (cd \"$root\" && almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n761\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr) || rc=$?\n762\t\n763\t  # Auto-commit only the agent-touched paths. A smart prompt may have committed\n764\t  # itself (worktree clean, nothing to do); a slash command like\n765\t  # /almanac:codebase-improve typically doesn't commit, so the driver does it.\n766\t  # Best-effort: a failed commit logs a warn but never alters the return code —\n767\t  # the agent's work itself succeeded or failed, the commit is bookkeeping.\n768\t  almanac_converge_commit_agent_paths \"$root\" \"$slug\" \"$round\" \"$pre_dirty\"\n769\t\n770\t  # Auto-write a minimal self-report. Format mirrors slice-03's worker block\n771\t  # (===== tick=N ts=ISO mode=prompt exit=N =====) so the overseer's parser\n772\t  # treats it the same. result_summary is the first 500 bytes of the agent's\n773\t  # final message — enough for the overseer to see \"what the agent said it\n774\t  # did\" without dragging the full transcript through the prompt budget.\n775\t  ts=\"$(almanac_loop_now_utc)\"\n776\t  result_summary=\"(no agent output)\"\n777\t  if [ -s \"$result_file\" ]; then\n778\t    result_summary=\"$(head -c 500 \"$result_file\")\"\n779\t  fi\n780\t  {\n781\t    printf '\\n===== tick=%s ts=%s mode=prompt exit=%s =====\\n' \"$round\" \"$ts\" \"$rc\"\n782\t    printf 'summary:\\n'\n783\t    printf '%s\\n' \"$result_summary\"\n784\t    printf 'concerns:\\n(none captured — prompt mode does not enforce structured self-report)\\n'\n785\t    printf 'next:\\n(driven by overseer / next-round prompt)\\n'\n786\t  } >> \"$log_file\"\n787\t\n788\t  # events_file is the persistent per-round session log under the plan dir —\n789\t  # NOT removed here. prompt/result are still scratch.\n790\t  rm -f \"$prompt_file\" \"$result_file\"\n791\t  return \"$rc\"\n792\t}\n793\t\n794\talmanac_converge_run_overseer() {\n795\t  local root=\"$1\"\n796\t  local goal=\"$2\"\n797\t  local round=\"$3\"\n798\t  local provider model effort prompt_file result_file events_file result rc plan_dir log_file ts\n799\t\n800\t  provider=\"$(almanac_converge_role_field \"overseer\" \"provider\")\"\n801\t  model=\"$(almanac_converge_role_field \"overseer\" \"model\")\"\n802\t  effort=\"$(almanac_converge_role_field \"overseer\" \"effort\")\"\n803\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n804\t  log_file=\"$plan_dir/overseer.log\"\n805\t\n806\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-prompt.XXXXXX\")\"\n807\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-result.XXXXXX\")\"\n808\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-events.XXXXXX\")\"\n809\t\n810\t  almanac_converge_overseer_prompt \"$root\" \"$goal\" \"$round\" > \"$prompt_file\"\n811\t\n812\t  rc=0\n813\t  (cd \"$root\" && almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"read-only\" \\\n814\t    \"$prompt_file\" \"$result_file\" \"$events_file\") >/dev/null || rc=$?\n815\t\n816\t  result=\"\"\n817\t  [ -s \"$result_file\" ] && result=\"$(cat \"$result_file\")\"\n818\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n819\t\n820\t  [ \"$rc\" -eq 0 ] || _warn \"Converge overseer tick $round exited $rc; continuing\"\n821\t  almanac_converge_overseer_parse \"$result\"\n822\t\n823\t  ts=\"$(almanac_loop_now_utc)\"\n824\t  {\n825\t    printf '\\n===== tick=%s ts=%s overseer=%s exit=%s =====\\n' \"$round\" \"$ts\" \"$provider\" \"$rc\"\n826\t    printf 'VERDICT: %s\\n' \"$ALMANAC_CONVERGE_VERDICT\"\n827\t    printf 'REASON: %s\\n' \"$ALMANAC_CONVERGE_REASON\"\n828\t    printf 'STEER: %s\\n' \"$ALMANAC_CONVERGE_STEER\"\n829\t    printf 'GOAL_UPDATE: %s\\n' \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n830\t  } >> \"$log_file\"\n831\t\n832\t  if [ \"$ALMANAC_CONVERGE_GOAL_UPDATE\" != \"unchanged\" ]; then\n833\t    almanac_converge_apply_goal_update \"$root\" \"$goal\" \"$round\" \"$provider\" \\\n834\t      \"$ALMANAC_CONVERGE_REASON\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n835\t  fi\n836\t\n837\t  case \"$ALMANAC_CONVERGE_VERDICT\" in\n838\t    CONVERGED|STOP)\n839\t      : > \"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n840\t      ;;\n841\t    STEER)\n842\t      if [ \"$ALMANAC_CONVERGE_STEER\" != \"none\" ]; then\n843\t        printf '%s\\n' \"$ALMANAC_CONVERGE_STEER\" > \"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n844\t      fi\n845\t      ;;\n846\t    CONTINUE) ;;\n847\t  esac\n848\t}\n849\t\n850\talmanac_converge_run() {\n851\t  local root=\"$1\"\n852\t  local goal=\"$2\"\n853\t  local exec_cmd=\"$3\"\n854\t  local rounds=\"${4:-${CONVERGE_ROUND_BUDGET:-10}}\"\n855\t  local no_oversee=\"${5:-0}\"\n856\t  local oversee_every=\"${6:-1}\"\n857\t  local prompt=\"${7:-}\"\n858\t  local slug plan_dir run_id pid exec_rc round started_epoch final_status final_verdict final_reason action_mode\n859\t\n860\t  # Mode dispatch: prompt-mode (agent invocation, dominant) vs exec-mode (shell\n861\t  # command in a wrapping worker, escape hatch). cmd/converge.sh enforces the\n862\t  # mutex; here we just pick a label for run-config + dispatch.\n863\t  if [ -n \"$prompt\" ]; then\n864\t    action_mode=\"prompt\"\n865\t  else\n866\t    action_mode=\"exec\"\n867\t  fi\n868\t\n869\t  case \"$rounds\" in\n870\t    ''|*[!0-9]*) _die \"--rounds must be a positive integer: $rounds\" ;;\n871\t  esac\n872\t  [ \"$rounds\" -ge 1 ] || _die \"--rounds must be at least 1: $rounds\"\n873\t\n874\t  case \"$oversee_every\" in\n875\t    ''|*[!0-9]*) _die \"--oversee-every must be a positive integer: $oversee_every\" ;;\n876\t  esac\n877\t  [ \"$oversee_every\" -ge 1 ] || _die \"--oversee-every must be at least 1: $oversee_every\"\n878\t\n879\t  case \"$no_oversee\" in\n880\t    1|true|yes|on) no_oversee=1 ;;\n881\t    *) no_oversee=0 ;;\n882\t  esac\n883\t\n884\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n885\t  pid=\"${BASHPID:-$$}\"\n886\t  started_epoch=\"$(date +%s)\"\n887\t  run_id=\"$(almanac_loop_register_run \"$root\" \"converge\" \"$slug\" \"$pid\")\" \\\n888\t    || _die \"Could not register converge run\"\n889\t\n890\t  local _converge_run_finalize_cmd\n891\t  printf -v _converge_run_finalize_cmd 'almanac_converge_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n892\t  trap \"${_converge_run_finalize_cmd}; exit 130\" INT TERM\n893\t  trap \"${_converge_run_finalize_cmd}\" EXIT\n894\t\n895\t  almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n896\t    \"rounds=$rounds\" \\\n897\t    \"oversee=$([ \"$no_oversee\" -eq 1 ] && printf off || printf 'every-%s' \"$oversee_every\")\" \\\n898\t    >/dev/null 2>&1 || true\n899\t\n900\t  almanac_converge_scaffold \"$root\" \"$goal\"\n901\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n902\t\n903\t  final_status=\"done\"\n904\t  if [ \"$no_oversee\" -eq 1 ]; then\n905\t    final_verdict=\"NO_OVERSEE\"\n906\t    final_reason=\"overseer disabled; round budget exhausted\"\n907\t  else\n908\t    final_verdict=\"CONTINUE\"\n909\t    final_reason=\"round budget exhausted\"\n910\t  fi\n911\t\n912\t  local _converge_stop_file\n913\t  _converge_stop_file=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n914\t\n915\t  round=0\n916\t  while [ \"$round\" -lt \"$rounds\" ]; do\n917\t    if [ -f \"$_converge_stop_file\" ]; then\n918\t      final_status=\"aborted\"\n919\t      final_verdict=\"STOP\"\n920\t      final_reason=\"stop signal present before round $((round + 1))\"\n921\t      break\n922\t    fi\n923\t\n924\t    round=$((round + 1))\n925\t    case \"$action_mode\" in\n926\t      prompt)\n927\t        if almanac_converge_run_worker_prompt \"$root\" \"$goal\" \"$prompt\" \"$round\"; then\n928\t          exec_rc=0\n929\t        else\n930\t          exec_rc=$?\n931\t        fi\n932\t        ;;\n933\t      *)\n934\t        if (cd \"$root\" && almanac_converge_run_worker \"$root\" \"$goal\" \"$exec_cmd\" \"$round\"); then\n935\t          exec_rc=0\n936\t        else\n937\t          exec_rc=$?\n938\t        fi\n939\t        ;;\n940\t    esac\n941\t\n942\t    # In exec-mode the worker is authoritative for commits (slice 03 contract).\n943\t    # In prompt-mode the driver already attempted the auto-commit inside the\n944\t    # worker function and will have warned on failure, so the check is skipped\n945\t    # to avoid a duplicate / misleading \"driver will not commit\" message.\n946\t    if [ \"$action_mode\" = \"exec\" ] \\\n947\t       && [ -n \"$(almanac_converge_git_user_status \"$root\" \"$plan_dir\" 2>/dev/null || true)\" ]; then\n948\t      _warn \"Converge round $round: worker left uncommitted changes; driver will not commit\"\n949\t    fi\n950\t\n951\t    if [ \"$exec_rc\" -ne 0 ]; then\n952\t      if [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n953\t        _warn \"Converge round $round exec exited $exec_rc; stopping\"\n954\t      else\n955\t        _warn \"Converge round $round exec exited $exec_rc; continuing\"\n956\t      fi\n957\t    fi\n958\t\n959\t    almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \"goal=$slug\" >/dev/null 2>&1 || true\n960\t\n961\t    if [ \"$exec_rc\" -ne 0 ] && [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n962\t      almanac_converge_write_convergence \"$root\" \"$goal\" \"FAILED\" \"$round\" \"$started_epoch\" \"exec exit=$exec_rc round=$round\"\n963\t      almanac_converge_run_finalize \"$root\" \"$run_id\" \"failed\" \"exec exit=$exec_rc round=$round\"\n964\t      return \"$exec_rc\"\n965\t    fi\n966\t\n967\t    if [ \"$no_oversee\" -eq 0 ] && [ $((round % oversee_every)) -eq 0 ]; then\n968\t      almanac_converge_run_overseer \"$root\" \"$goal\" \"$round\"\n969\t      final_verdict=\"$ALMANAC_CONVERGE_VERDICT\"\n970\t      final_reason=\"$ALMANAC_CONVERGE_REASON\"\n971\t      case \"$ALMANAC_CONVERGE_VERDICT\" in\n972\t        CONVERGED)\n973\t          final_status=\"done\"\n974\t          break\n975\t          ;;\n976\t        STOP)\n977\t          final_status=\"aborted\"\n978\t          break\n979\t          ;;\n980\t      esac\n981\t    fi\n982\t  done\n983\t\n984\t  almanac_converge_write_convergence \"$root\" \"$goal\" \"$final_verdict\" \"$round\" \"$started_epoch\" \"$final_reason\"\n985\t  almanac_converge_run_finalize \"$root\" \"$run_id\" \"$final_status\"\n986\t}\n987\t"}]},"parent_tool_use_id":null,"session_id":"19c2339b-02f8-4b81-9b44-59452ec22e33","uuid":"fca0045d-2779-41e9-a761-43aff73cbf88","timestamp":"2026-05-26T18:16:24.320Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/converge-core.sh","content":"#!/usr/bin/env bash\n# converge-core.sh - Generic convergence loop core\n\n# Source focused deps idempotently so tests can source this file directly.\n# core.sh owns the helper, so it's pulled in via the literal pattern.\nif ! declare -F _error >/dev/null 2>&1; then\n  __converge_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/core.sh\n  source \"$__converge_core_dir/core.sh\"\n  unset __converge_core_dir\nfi\n\n_almanac_source_sibling run.sh    almanac_loop_register_run\n_almanac_source_sibling agent.sh  almanac_loop_agent_capture\n_almanac_source_sibling role.sh   almanac_loop_role_config\n\nalmanac_converge_plan_dir() {\n  local root=\"$1\"\n  local slug=\"$2\"\n\n  printf '%s/docs/plans/converge/%s\\n' \"$root\" \"$slug\"\n}\n\nalmanac_converge_scaffold() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local plan_dir\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n\n  if ! mkdir -p \"$plan_dir\"; then\n    _die \"Could not create converge plan dir: ${plan_dir#\"$root\"/}\"\n  fi\n  if ! printf '%s\\n' \"$goal\" > \"$plan_dir/goal.md\"; then\n    _die \"Could not write converge goal: ${plan_dir#\"$root\"/}/goal.md\"\n  fi\n  if ! : > \"$plan_dir/agent-reports.log\"; then\n    _die \"Could not write converge report log: ${plan_dir#\"$root\"/}/agent-reports.log\"\n  fi\n  if ! : > \"$plan_dir/goal.history.log\"; then\n    _die \"Could not write converge goal history: ${plan_dir#\"$root\"/}/goal.history.log\"\n  fi\n}\n\nalmanac_converge_role() {\n  local role=\"$1\"\n\n  case \"$role\" in\n    agent|overseer) ;;\n    *) return 2 ;;\n  esac\n\n  almanac_loop_role_config \"converge\" \"$role\" \"\" \"$(almanac_provider_default)\" \"\" \"\"\n}\n\nalmanac_converge_role_field() {\n  local role=\"$1\"\n  local field=\"$2\"\n\n  almanac_converge_role \"$role\" | awk -F'\\t' -v k=\"$field\" '$1 == k { v = $2 } END { print v }'\n}\n\nalmanac_converge_ensure_prompt_template() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local plan_dir prompt_file\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  prompt_file=\"$plan_dir/prompt.md\"\n  [ -f \"$prompt_file\" ] && return 0\n\n  cat > \"$prompt_file\" <<'EOF'\n# Converge Worker\n\nYou are one worker round in a generic convergence loop.\n\nRead current goal, follow one-shot steer directive if present, run exact exec\ncommand, then leave clear evidence in git history and agent-reports.log.\n\nDo not edit the goal unless explicitly asked by the exec command. Do not commit\n.almanac or converge state files under docs/plans/converge/.\nEOF\n}\n\nalmanac_converge_worker_prompt() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local exec_cmd=\"$3\"\n  local round=\"$4\"\n  local slug plan_dir rel_plan steer_file\n\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  rel_plan=\"${plan_dir#\"$root\"/}\"\n  steer_file=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n\n  almanac_converge_ensure_prompt_template \"$root\" \"$goal\"\n\n  cat \"$plan_dir/prompt.md\"\n  cat <<EOF\n\nCONVERGE_TICK=$round\nCONVERGE_SLUG=$slug\nCONVERGE_PLAN_DIR=$rel_plan\nCONVERGE_REPORT_LOG=$rel_plan/agent-reports.log\n\nCommit user-visible worktree changes, excluding .almanac and $rel_plan, with:\nCONVERGE($slug): <one-line summary>\n\nAppend one structured self-report to $rel_plan/agent-reports.log. Use this exact\nheader shape and these exact section labels:\n\n===== tick=<N> ts=<ISO> =====\nsummary:\nconcerns:\nnext:\n\nFor this round, N is $round.\n\n===== GOAL.md =====\nEOF\n  cat \"$plan_dir/goal.md\"\n  cat <<EOF\n===== END GOAL.md =====\n\n===== EXEC COMMAND =====\n$exec_cmd\n===== END EXEC COMMAND =====\nEOF\n\n  if [ -f \"$steer_file\" ]; then\n    cat <<'EOF'\n\n===== STEER =====\nEOF\n    cat \"$steer_file\"\n    cat <<'EOF'\n===== END STEER =====\nEOF\n    rm -f \"$steer_file\"\n  fi\n}\n\nalmanac_converge_report_log_has_structured_block() {\n  local file=\"$1\"\n\n  [ -f \"$file\" ] || return 1\n  awk '\n    /^===== tick=[0-9][0-9]* ts=.* =====$/ {\n      seen = 1\n      summary = 0\n      concerns = 0\n      next_seen = 0\n      next\n    }\n    seen && /^summary:$/ { summary = 1; next }\n    seen && /^concerns:$/ { concerns = 1; next }\n    seen && /^next:$/ { next_seen = 1; ok = summary && concerns && next_seen; next }\n    END { exit ok ? 0 : 1 }\n  ' \"$file\"\n}\n\nalmanac_converge_trim() {\n  printf '%s' \"$1\" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'\n}\n\nalmanac_converge_overseer_prompt() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local round=\"$3\"\n  local slug plan_dir rel_plan reports_file reports commits\n\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  rel_plan=\"${plan_dir#\"$root\"/}\"\n  reports_file=\"$plan_dir/agent-reports.log\"\n\n  if [ -f \"$reports_file\" ]; then\n    reports=\"$(tail -c 8192 \"$reports_file\")\"\n  else\n    reports=\"(no agent reports yet)\"\n  fi\n\n  commits=\"$(git -C \"$root\" log --fixed-strings --grep=\"CONVERGE($slug):\" -n 10 \\\n    --format='%H%n%ad%n%B%n---' --date=short 2>/dev/null || true)\"\n  [ -n \"$commits\" ] || commits=\"No CONVERGE commits yet\"\n\n  cat <<EOF\nYou are the overseer for converge($slug), a synchronous convergence loop.\n\nCONVERGE_TICK=$round\nCONVERGE_SLUG=$slug\nCONVERGE_PLAN_DIR=$rel_plan\n\nJudge whether the current goal is satisfied, whether the next worker needs a\none-shot steering directive, or whether the loop should stop.\n\n===== GOAL.md =====\nEOF\n  cat \"$plan_dir/goal.md\"\n  cat <<EOF\n===== END GOAL.md =====\n\n===== RECENT AGENT SELF-REPORTS (last ~8KB) =====\n$reports\n===== END RECENT AGENT SELF-REPORTS =====\n\n===== RECENT CONVERGE COMMITS (last 10) =====\n$commits\n===== END RECENT CONVERGE COMMITS =====\n\nOutput these fields in order with no preamble:\nVERDICT: <CONVERGED|CONTINUE|STEER|STOP>\nREASON: <one paragraph>\nSTEER: <one paragraph, or 'none'>\nGOAL_UPDATE: <new goal.md content, or 'unchanged'>\n\nBe conservative. Malformed output is treated as CONTINUE with no steering and no\ngoal update. GOAL_UPDATE may span multiple lines because it is the final field.\nEOF\n}\n\nalmanac_converge_overseer_parse() {\n  local input=\"${1:-}\"\n  local content line key_line current_key=\"\"\n  local raw_verdict=\"\" raw_reason=\"\" raw_steer=\"\" raw_goal=\"\"\n  local found_verdict=0 found_reason=0 found_steer=0 found_goal=0\n\n  if [ -f \"$input\" ]; then\n    content=\"$(cat \"$input\")\"\n  else\n    content=\"$input\"\n  fi\n\n  ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n  ALMANAC_CONVERGE_REASON=\"\"\n  ALMANAC_CONVERGE_STEER=\"none\"\n  ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n\n  # State-machine line walker. Each KEY: prefix switches the current field;\n  # subsequent non-key lines append to whatever field is currently open. This\n  # lets the LLM emit either inline values (`REASON: blah`) or values on the\n  # next line (`REASON:\\nblah`) or multi-line paragraphs that span until the\n  # next KEY: marker — all parse correctly. Before this fix the parser only\n  # captured the value text on the SAME line as KEY:, dropping continuation\n  # lines and producing empty REASON / STEER for any LLM that emitted\n  # paragraph-shaped values — the bug observed in the first --prompt converge\n  # run (REASON empty, STEER none in the overseer.log entry despite the LLM\n  # clearly being asked to produce both).\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    key_line=\"$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\"\n    case \"$key_line\" in\n      VERDICT:*)\n        current_key=\"VERDICT\"; found_verdict=1\n        raw_verdict=\"${key_line#VERDICT:}\"\n        case \"$raw_verdict\" in \" \"*) raw_verdict=\"${raw_verdict# }\" ;; esac\n        ;;\n      REASON:*)\n        current_key=\"REASON\"; found_reason=1\n        raw_reason=\"${key_line#REASON:}\"\n        case \"$raw_reason\" in \" \"*) raw_reason=\"${raw_reason# }\" ;; esac\n        ;;\n      STEER:*)\n        current_key=\"STEER\"; found_steer=1\n        raw_steer=\"${key_line#STEER:}\"\n        case \"$raw_steer\" in \" \"*) raw_steer=\"${raw_steer# }\" ;; esac\n        ;;\n      GOAL_UPDATE:*)\n        current_key=\"GOAL_UPDATE\"; found_goal=1\n        raw_goal=\"${key_line#GOAL_UPDATE:}\"\n        case \"$raw_goal\" in \" \"*) raw_goal=\"${raw_goal# }\" ;; esac\n        ;;\n      *)\n        # Continuation line — append to whichever field is currently open.\n        # Lines before the first KEY: marker (preamble noise) have current_key\n        # empty and are dropped, matching the prompt's \"no preamble\" contract.\n        # The original line (not the leading-whitespace-stripped key_line) is\n        # preserved so multi-line paragraphs keep their indentation if any.\n        case \"$current_key\" in\n          VERDICT)     raw_verdict=\"${raw_verdict}\"$'\\n'\"${line}\" ;;\n          REASON)      raw_reason=\"${raw_reason}\"$'\\n'\"${line}\" ;;\n          STEER)       raw_steer=\"${raw_steer}\"$'\\n'\"${line}\" ;;\n          GOAL_UPDATE) raw_goal=\"${raw_goal}\"$'\\n'\"${line}\" ;;\n        esac\n        ;;\n    esac\n  done <<< \"$content\"\n\n  if [ \"$found_verdict\" -ne 1 ] || [ \"$found_reason\" -ne 1 ] || \\\n    [ \"$found_steer\" -ne 1 ] || [ \"$found_goal\" -ne 1 ]; then\n    return 0\n  fi\n\n  # VERDICT is always a single token. A chatty LLM may put the token on its own\n  # line and then ramble before REASON; the state-machine above will have\n  # accumulated those ramble lines into raw_verdict. Reduce to the first\n  # non-empty line so the case-match below still recognises the token.\n  raw_verdict=\"$(printf '%s\\n' \"$raw_verdict\" | awk 'NF{print; exit}')\"\n  raw_verdict=\"$(almanac_converge_trim \"$raw_verdict\")\"\n  case \"$raw_verdict\" in\n    CONVERGED|CONTINUE|STEER|STOP) ALMANAC_CONVERGE_VERDICT=\"$raw_verdict\" ;;\n    *)\n      ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n      ALMANAC_CONVERGE_STEER=\"none\"\n      ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n      return 0\n      ;;\n  esac\n\n  ALMANAC_CONVERGE_REASON=\"$(almanac_converge_trim \"$raw_reason\")\"\n\n  raw_steer=\"$(almanac_converge_trim \"$raw_steer\")\"\n  if [ -n \"$raw_steer\" ] && ! printf '%s\\n' \"$raw_steer\" | grep -qiE '^none[[:space:]]*$'; then\n    ALMANAC_CONVERGE_STEER=\"$raw_steer\"\n  fi\n\n  if [ \"$found_goal\" -eq 1 ]; then\n    local goal_check\n    goal_check=\"$(almanac_converge_trim \"$raw_goal\")\"\n    if [ -n \"$goal_check\" ] && ! printf '%s\\n' \"$goal_check\" | grep -qiE '^unchanged[[:space:]]*$'; then\n      ALMANAC_CONVERGE_GOAL_UPDATE=\"$raw_goal\"\n    fi\n  fi\n}\n\nalmanac_converge_write_convergence() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local verdict=\"$3\"\n  local tick=\"$4\"\n  local started_epoch=\"${5:-}\"\n  local reason=\"${6:-}\"\n  local plan_dir now_epoch elapsed\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  now_epoch=\"$(date +%s)\"\n  elapsed=\"\"\n  case \"$started_epoch\" in\n    ''|*[!0-9]*) ;;\n    *) elapsed=\"$((now_epoch - started_epoch))s\" ;;\n  esac\n\n  {\n    printf '# Convergence\\n\\n'\n    printf '## Final verdict\\n\\n%s\\n\\n' \"$verdict\"\n    printf '## Tick count\\n\\n%s\\n\\n' \"$tick\"\n    printf '## Time elapsed\\n\\n%s\\n\\n' \"${elapsed:-unknown}\"\n    printf '## Final goal\\n\\n'\n    if [ -f \"$plan_dir/goal.md\" ]; then\n      cat \"$plan_dir/goal.md\"\n    fi\n    printf '\\n\\n## Final reason\\n\\n%s\\n' \"${reason:-none}\"\n  } > \"$plan_dir/convergence.md\"\n}\n\nalmanac_converge_goal_summary() {\n  printf '%s' \"$1\" | tr '\\n' ' ' | cut -c 1-80\n}\n\nalmanac_converge_latest_run_id() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local rows id type target pid status_rel started status match=\"\"\n\n  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n    [ -n \"$id\" ] || continue\n    [ \"$type\" = \"converge\" ] || continue\n    [ \"$target\" = \"$slug\" ] || continue\n    match=\"$id\"\n  done <<< \"$rows\"\n\n  [ -n \"$match\" ] || return 1\n  printf '%s\\n' \"$match\"\n}\n\nalmanac_converge_worker_health() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status_file status\n\n  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n  [ -f \"$status_file\" ] || { printf '%s\\n' \"dead\"; return 0; }\n\n  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n  if [ \"$status\" = \"running\" ] && ! almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n    printf '%s\\n' \"alive\"\n  else\n    printf '%s\\n' \"dead\"\n  fi\n}\n\nalmanac_converge_last_verdict_line() {\n  local log_file=\"$1\"\n\n  [ -f \"$log_file\" ] || return 1\n  awk '\n    /^===== tick=/ { verdict = \"\"; reason = \"\" }\n    /^VERDICT: / { verdict = substr($0, 10) }\n    /^REASON: / { reason = substr($0, 9) }\n    END {\n      if (verdict != \"\" || reason != \"\") {\n        printf \"%s\\t%s\\n\", verdict, reason\n      }\n    }\n  ' \"$log_file\"\n}\n\nalmanac_converge_last_report_header() {\n  local reports_file=\"$1\"\n\n  [ -f \"$reports_file\" ] || return 1\n  grep -E '^===== tick=[0-9][0-9]* ts=.* =====$' \"$reports_file\" 2>/dev/null | tail -n 1\n}\n\nalmanac_converge_goal_mutation_count() {\n  local history_file=\"$1\"\n\n  [ -f \"$history_file\" ] || { printf '%s\\n' \"0\"; return 0; }\n  awk '/^===== tick=[0-9][0-9]* ts=.* overseer=/ { c++ } END { print c + 0 }' \"$history_file\"\n}\n\nalmanac_converge_dashboard_frame() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local plan_dir goal_file reports_file history_file log_file\n  local run_id=\"\" status_file round=\"\" rounds=\"\" health=\"dead\"\n  local verdict=\"none\" reason=\"none\" verdict_line report_header goal_text goal_summary mutations\n  local tab=$'\\t'\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  [ -d \"$plan_dir\" ] || return 1\n\n  goal_file=\"$plan_dir/goal.md\"\n  reports_file=\"$plan_dir/agent-reports.log\"\n  history_file=\"$plan_dir/goal.history.log\"\n  log_file=\"$plan_dir/overseer.log\"\n\n  if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n    status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n    round=\"$(almanac_loop_status_field \"$status_file\" \"round\" 2>/dev/null || true)\"\n    rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" 2>/dev/null || true)\"\n    health=\"$(almanac_converge_worker_health \"$root\" \"$run_id\")\"\n  fi\n  [ -n \"$round\" ] || round=\"0\"\n  [ -n \"$rounds\" ] || rounds=\"?\"\n\n  if verdict_line=\"$(almanac_converge_last_verdict_line \"$log_file\" 2>/dev/null)\"; then\n    verdict=\"${verdict_line%%$tab*}\"\n    reason=\"${verdict_line#*$tab}\"\n    [ \"$reason\" != \"$verdict_line\" ] || reason=\"none\"\n    [ -n \"$verdict\" ] || verdict=\"none\"\n    [ -n \"$reason\" ] || reason=\"none\"\n  fi\n\n  report_header=\"$(almanac_converge_last_report_header \"$reports_file\" 2>/dev/null || true)\"\n  [ -n \"$report_header\" ] || report_header=\"none\"\n\n  goal_text=\"\"\n  [ -f \"$goal_file\" ] && goal_text=\"$(cat \"$goal_file\")\"\n  goal_summary=\"$(almanac_converge_goal_summary \"$goal_text\")\"\n  [ -n \"$goal_summary\" ] || goal_summary=\"none\"\n  mutations=\"$(almanac_converge_goal_mutation_count \"$history_file\")\"\n\n  printf 'converge %s\\n' \"$slug\"\n  printf 'current round: %s/%s\\n' \"$round\" \"$rounds\"\n  printf 'last verdict: %s\\n' \"$verdict\"\n  printf 'reason: %s\\n' \"$reason\"\n  printf 'last report: %s\\n' \"$report_header\"\n  printf 'goal: %s\\n' \"$goal_summary\"\n  printf 'goal mutations: %s\\n' \"$mutations\"\n  printf 'worker health: %s\\n' \"$health\"\n}\n\nalmanac_converge_status() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local frame\n\n  frame=\"$(almanac_converge_dashboard_frame \"$root\" \"$slug\")\" || return 1\n  printf '%s\\n' \"$frame\" | almanac_loop_ui_render\n}\n\nalmanac_converge_watch() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local mode=\"${3:-}\"\n  local interval=\"${CONVERGE_WATCH_INTERVAL:-${ALMANAC_HUB_WATCH_INTERVAL:-2}}\"\n  local run_id status_file status\n\n  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n    almanac_converge_status \"$root\" \"$slug\"\n    return\n  fi\n\n  while :; do\n    almanac_loop_ui_clear\n    almanac_converge_status \"$root\" \"$slug\"\n    if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n      status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n      status=\"$(almanac_loop_status_field \"$status_file\" \"status\" 2>/dev/null || true)\"\n      case \"$status\" in\n        done|failed|aborted) break ;;\n      esac\n    fi\n    sleep \"$interval\"\n  done\n}\n\nalmanac_converge_stop() {\n  local root=\"$1\"\n  local slug=\"$2\"\n  local plan_dir root_stop plan_stop\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  [ -d \"$plan_dir\" ] || return 1\n  root_stop=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n  plan_stop=\"$(almanac_loop_run_control_file converge \"$plan_dir\" stop)\"\n  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$root_stop\"\n  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$plan_stop\"\n}\n\nalmanac_converge_apply_goal_update() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local round=\"$3\"\n  local provider=\"$4\"\n  local reason=\"$5\"\n  local new_goal=\"$6\"\n  local plan_dir goal_file history_file log_file ts old_goal old_file new_file diff_output diff_status summary\n\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  goal_file=\"$plan_dir/goal.md\"\n  history_file=\"$plan_dir/goal.history.log\"\n  log_file=\"$plan_dir/overseer.log\"\n  ts=\"$(almanac_loop_now_utc)\"\n  old_goal=\"\"\n  [ -f \"$goal_file\" ] && old_goal=\"$(cat \"$goal_file\")\"\n\n  old_file=\"$plan_dir/.goal.old.$$\"\n  new_file=\"$plan_dir/.goal.new.$$\"\n  printf '%s\\n' \"$old_goal\" > \"$old_file\"\n  printf '%s\\n' \"$new_goal\" > \"$new_file\"\n\n  diff_output=\"\"\n  diff_status=127\n  if command -v diff >/dev/null 2>&1; then\n    if diff_output=\"$(diff -u \"$old_file\" \"$new_file\" 2>/dev/null)\"; then\n      diff_status=0\n    else\n      diff_status=$?\n    fi\n  fi\n\n  {\n    printf '===== tick=%s ts=%s overseer=%s =====\\n' \"$round\" \"$ts\" \"$provider\"\n    printf 'REASON: %s\\n' \"$reason\"\n    if [ \"$diff_status\" -le 1 ]; then\n      printf -- '--- DIFF ---\\n'\n      printf '%s\\n' \"$diff_output\"\n    else\n      printf -- '--- AFTER ---\\n'\n      printf '%s\\n' \"$new_goal\"\n    fi\n  } >> \"$history_file\"\n\n  printf '%s\\n' \"$new_goal\" > \"$goal_file\"\n  rm -f \"$old_file\" \"$new_file\"\n\n  summary=\"$(almanac_converge_goal_summary \"$new_goal\")\"\n  printf '[tick=%s] goal updated: %s\\n' \"$round\" \"$summary\" >> \"$log_file\"\n}\n\nalmanac_converge_run_finalize() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local status=\"$3\"\n  local reason=\"${4:-}\"\n\n  trap - EXIT INT TERM\n  [ -n \"$run_id\" ] || return 0\n  almanac_loop_mark_run_status \"$root\" \"$run_id\" \"$status\" \"\" \"$reason\" >/dev/null 2>&1 || true\n}\n\nalmanac_converge_git_user_status() {\n  local root=\"$1\"\n  local plan_dir=\"$2\"\n  local rel_plan\n\n  git -C \"$root\" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1\n  rel_plan=\"${plan_dir#\"$root\"/}\"\n\n  if [ \"$rel_plan\" = \"$plan_dir\" ]; then\n    git -C \"$root\" status --porcelain -- . ':!.almanac'\n  else\n    git -C \"$root\" status --porcelain -- . ':!.almanac' \":!$rel_plan\"\n  fi\n}\n\nalmanac_converge_run_worker() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local exec_cmd=\"$3\"\n  local round=\"$4\"\n  local provider model effort prompt_file result_file events_file plan_dir slug rc\n\n  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-prompt.XXXXXX\")\"\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-result.XXXXXX\")\"\n  # Persistent per-round session log under the plan dir (mirrors ralph's\n  # docs/plans/<name>/ralph-codex-iteration-N.log). The full raw event stream\n  # tees here while the filtered agent-message text streams live to the\n  # terminal — operator sees progress, durable log is kept for forensics.\n  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n\n  almanac_converge_worker_prompt \"$root\" \"$goal\" \"$exec_cmd\" \"$round\" > \"$prompt_file\"\n\n  _info \"Converge round $round — exec-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n\n  # danger-full-access sandbox: converge runs are autonomous-by-design.\n  # `claude --print` has no human to answer a permission prompt, so anything\n  # less than full access dies on every un-allowlisted Bash call (\"This\n  # command requires approval\"). For codex this drops the sandbox; for claude\n  # it maps to --permission-mode bypassPermissions (per the provider adapter).\n  rc=0\n  almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr || rc=$?\n\n  rm -f \"$prompt_file\" \"$result_file\"\n  return \"$rc\"\n}\n\n# Prompt-mode round: the user's --prompt text IS the agent invocation. No worker\n# template wrapper — the agent receives the prompt verbatim, prefixed only with\n# a one-shot .converge-steer directive if one is queued. This is the dominant\n# mode for \"run skill X in a convergence loop\" workflows; the loop driver\n# handles the bookkeeping (auto-commit + agent-reports.log entry) after the\n# agent exits, instead of asking the agent to know about CONVERGE conventions.\n#\n# Returns the agent's exit code; commit and report writes are best-effort and\n# never alter the return.\n# List every currently-dirty path in $root, one per line, sorted+deduped.\n# Output is the union of:\n#   - tracked-modified paths (`git diff --name-only HEAD`)\n#   - untracked-not-ignored paths (`git ls-files --others --exclude-standard`)\n# Used by the prompt-mode auto-commit to distinguish PRE-EXISTING dirty work\n# (untouched by the agent) from AGENT-TOUCHED paths (commit candidates). Empty\n# string on git failure or non-repo. Pure read-only — safe to call multiple\n# times per round.\nalmanac_converge_dirty_paths() {\n  local root=\"$1\"\n  ( cd \"$root\" \\\n      && { git diff --name-only HEAD 2>/dev/null; \\\n           git ls-files --others --exclude-standard 2>/dev/null; } \\\n      | sort -u\n  )\n}\n\n# Auto-commit ONLY the paths the agent newly touched this round, computed as\n# (dirty-after) - (dirty-before). Pre-existing dirty paths are left alone so a\n# concurrent unrelated edit never gets swept into a CONVERGE commit (the bug\n# that caused commit 4526a58 to misattribute the developer's in-flight edits\n# to the agent). Files that were pre-existing dirty AND also touched by the\n# agent stay dirty — conservative; the agent's change in that file isn't\n# committed by this round, but no false attribution happens. Best-effort:\n# commit failure logs a warn and never alters the caller's return code.\n#\n# Args: ROOT SLUG ROUND PRE_DIRTY (newline-separated pre-existing dirty paths)\nalmanac_converge_commit_agent_paths() {\n  local root=\"$1\" slug=\"$2\" round=\"$3\" pre_dirty=\"$4\"\n  local post_dirty agent_paths\n\n  post_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n  # comm needs sorted inputs; both producers (almanac_converge_dirty_paths +\n  # the snapshot taken before the agent ran) emit sorted-unique.\n  agent_paths=\"$(comm -23 <(printf '%s\\n' \"$post_dirty\") <(printf '%s\\n' \"$pre_dirty\") | sed '/^$/d')\"\n\n  if [ -z \"$agent_paths\" ]; then\n    # Either the agent didn't change anything OR every change was on a path\n    # that was already dirty (so the change stays uncommitted on purpose).\n    return 0\n  fi\n\n  # Stage each agent-touched path individually (handles deletions, new files,\n  # and modifications — `git add` accepts paths to files that no longer exist\n  # by recording the deletion).\n  local path failed=0\n  while IFS= read -r path; do\n    [ -n \"$path\" ] || continue\n    (cd \"$root\" && git add -- \"$path\" >/dev/null 2>&1) || failed=1\n  done <<< \"$agent_paths\"\n\n  if [ \"$failed\" -eq 1 ]; then\n    _warn \"Converge round $round: staging one or more agent-touched paths failed (changes left in worktree)\"\n    return 0\n  fi\n\n  if ! (cd \"$root\" \\\n          && git -c user.email=converge@almanac -c user.name=converge \\\n                 commit -m \"CONVERGE($slug): round $round\" --no-verify >/dev/null 2>&1); then\n    _warn \"Converge round $round: auto-commit failed (changes left in worktree)\"\n  fi\n}\n\nalmanac_converge_run_worker_prompt() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local prompt=\"$3\"\n  local round=\"$4\"\n  local provider model effort prompt_file result_file events_file rc\n  local slug plan_dir log_file steer_path ts result_summary\n\n  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n  log_file=\"$plan_dir/agent-reports.log\"\n  steer_path=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-prompt.XXXXXX\")\"\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-result.XXXXXX\")\"\n  # Persistent per-round session log under the plan dir (same shape as\n  # exec-mode + ralph's per-iteration logs). Streams live to terminal so the\n  # operator sees the agent working; tees the raw stream here for forensics.\n  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n\n  # Steer (one-shot): emitted by the overseer in the prior round, consumed and\n  # removed here so the next overseer tick can re-emit if the issue persists.\n  # Steer prefix comes BEFORE the user prompt so a slash command sees the\n  # directive as context before its own work.\n  {\n    if [ -f \"$steer_path\" ]; then\n      printf '# Steer directive (from previous overseer tick):\\n'\n      cat \"$steer_path\"\n      printf '\\n\\n'\n      rm -f \"$steer_path\"\n    fi\n    printf '%s\\n' \"$prompt\"\n  } > \"$prompt_file\"\n\n  _info \"Converge round $round — prompt-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n\n  # Snapshot the dirty worktree BEFORE the agent runs so the auto-commit below\n  # can stage only the paths the agent newly touches — not whatever unrelated\n  # work the operator had in-flight. (Without this snapshot, an earlier `git\n  # add -A` swept up the developer's uncommitted edits and committed them\n  # under the agent's name — bug observed in commit 4526a58.)\n  local pre_dirty\n  pre_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n\n  # danger-full-access: same rationale as exec-mode worker — converge agents\n  # need to run arbitrary shell (tests, git status, lint) the prompt asks for.\n  rc=0\n  (cd \"$root\" && almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr) || rc=$?\n\n  # Auto-commit only the agent-touched paths. A smart prompt may have committed\n  # itself (worktree clean, nothing to do); a slash command like\n  # /almanac:codebase-improve typically doesn't commit, so the driver does it.\n  # Best-effort: a failed commit logs a warn but never alters the return code —\n  # the agent's work itself succeeded or failed, the commit is bookkeeping.\n  almanac_converge_commit_agent_paths \"$root\" \"$slug\" \"$round\" \"$pre_dirty\"\n\n  # Auto-write a minimal self-report. Format mirrors slice-03's worker block\n  # (===== tick=N ts=ISO mode=prompt exit=N =====) so the overseer's parser\n  # treats it the same. result_summary is the first 500 bytes of the agent's\n  # final message — enough for the overseer to see \"what the agent said it\n  # did\" without dragging the full transcript through the prompt budget.\n  ts=\"$(almanac_loop_now_utc)\"\n  result_summary=\"(no agent output)\"\n  if [ -s \"$result_file\" ]; then\n    result_summary=\"$(head -c 500 \"$result_file\")\"\n  fi\n  {\n    printf '\\n===== tick=%s ts=%s mode=prompt exit=%s =====\\n' \"$round\" \"$ts\" \"$rc\"\n    printf 'summary:\\n'\n    printf '%s\\n' \"$result_summary\"\n    printf 'concerns:\\n(none captured — prompt mode does not enforce structured self-report)\\n'\n    printf 'next:\\n(driven by overseer / next-round prompt)\\n'\n  } >> \"$log_file\"\n\n  # events_file is the persistent per-round session log under the plan dir —\n  # NOT removed here. prompt/result are still scratch.\n  rm -f \"$prompt_file\" \"$result_file\"\n  return \"$rc\"\n}\n\nalmanac_converge_run_overseer() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local round=\"$3\"\n  local provider model effort prompt_file result_file events_file result rc plan_dir log_file ts\n\n  provider=\"$(almanac_converge_role_field \"overseer\" \"provider\")\"\n  model=\"$(almanac_converge_role_field \"overseer\" \"model\")\"\n  effort=\"$(almanac_converge_role_field \"overseer\" \"effort\")\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n  log_file=\"$plan_dir/overseer.log\"\n\n  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-prompt.XXXXXX\")\"\n  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-result.XXXXXX\")\"\n  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-events.XXXXXX\")\"\n\n  almanac_converge_overseer_prompt \"$root\" \"$goal\" \"$round\" > \"$prompt_file\"\n\n  rc=0\n  (cd \"$root\" && almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"read-only\" \\\n    \"$prompt_file\" \"$result_file\" \"$events_file\") >/dev/null || rc=$?\n\n  result=\"\"\n  [ -s \"$result_file\" ] && result=\"$(cat \"$result_file\")\"\n  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n\n  [ \"$rc\" -eq 0 ] || _warn \"Converge overseer tick $round exited $rc; continuing\"\n  almanac_converge_overseer_parse \"$result\"\n\n  ts=\"$(almanac_loop_now_utc)\"\n  {\n    printf '\\n===== tick=%s ts=%s overseer=%s exit=%s =====\\n' \"$round\" \"$ts\" \"$provider\" \"$rc\"\n    printf 'VERDICT: %s\\n' \"$ALMANAC_CONVERGE_VERDICT\"\n    printf 'REASON: %s\\n' \"$ALMANAC_CONVERGE_REASON\"\n    printf 'STEER: %s\\n' \"$ALMANAC_CONVERGE_STEER\"\n    printf 'GOAL_UPDATE: %s\\n' \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n  } >> \"$log_file\"\n\n  if [ \"$ALMANAC_CONVERGE_GOAL_UPDATE\" != \"unchanged\" ]; then\n    almanac_converge_apply_goal_update \"$root\" \"$goal\" \"$round\" \"$provider\" \\\n      \"$ALMANAC_CONVERGE_REASON\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n  fi\n\n  case \"$ALMANAC_CONVERGE_VERDICT\" in\n    CONVERGED|STOP)\n      : > \"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n      ;;\n    STEER)\n      if [ \"$ALMANAC_CONVERGE_STEER\" != \"none\" ]; then\n        printf '%s\\n' \"$ALMANAC_CONVERGE_STEER\" > \"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n      fi\n      ;;\n    CONTINUE) ;;\n  esac\n}\n\nalmanac_converge_run() {\n  local root=\"$1\"\n  local goal=\"$2\"\n  local exec_cmd=\"$3\"\n  local rounds=\"${4:-${CONVERGE_ROUND_BUDGET:-10}}\"\n  local no_oversee=\"${5:-0}\"\n  local oversee_every=\"${6:-1}\"\n  local prompt=\"${7:-}\"\n  local slug plan_dir run_id pid exec_rc round started_epoch final_status final_verdict final_reason action_mode\n\n  # Mode dispatch: prompt-mode (agent invocation, dominant) vs exec-mode (shell\n  # command in a wrapping worker, escape hatch). cmd/converge.sh enforces the\n  # mutex; here we just pick a label for run-config + dispatch.\n  if [ -n \"$prompt\" ]; then\n    action_mode=\"prompt\"\n  else\n    action_mode=\"exec\"\n  fi\n\n  case \"$rounds\" in\n    ''|*[!0-9]*) _die \"--rounds must be a positive integer: $rounds\" ;;\n  esac\n  [ \"$rounds\" -ge 1 ] || _die \"--rounds must be at least 1: $rounds\"\n\n  case \"$oversee_every\" in\n    ''|*[!0-9]*) _die \"--oversee-every must be a positive integer: $oversee_every\" ;;\n  esac\n  [ \"$oversee_every\" -ge 1 ] || _die \"--oversee-every must be at least 1: $oversee_every\"\n\n  case \"$no_oversee\" in\n    1|true|yes|on) no_oversee=1 ;;\n    *) no_oversee=0 ;;\n  esac\n\n  slug=\"$(almanac_loop_slug \"$goal\")\"\n  pid=\"${BASHPID:-$$}\"\n  started_epoch=\"$(date +%s)\"\n  run_id=\"$(almanac_loop_register_run \"$root\" \"converge\" \"$slug\" \"$pid\")\" \\\n    || _die \"Could not register converge run\"\n\n  local _converge_run_finalize_cmd\n  printf -v _converge_run_finalize_cmd 'almanac_converge_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n  trap \"${_converge_run_finalize_cmd}; exit 130\" INT TERM\n  trap \"${_converge_run_finalize_cmd}\" EXIT\n\n  almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n    \"rounds=$rounds\" \\\n    \"oversee=$([ \"$no_oversee\" -eq 1 ] && printf off || printf 'every-%s' \"$oversee_every\")\" \\\n    >/dev/null 2>&1 || true\n\n  almanac_converge_scaffold \"$root\" \"$goal\"\n  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n\n  final_status=\"done\"\n  if [ \"$no_oversee\" -eq 1 ]; then\n    final_verdict=\"NO_OVERSEE\"\n    final_reason=\"overseer disabled; round budget exhausted\"\n  else\n    final_verdict=\"CONTINUE\"\n    final_reason=\"round budget exhausted\"\n  fi\n\n  local _converge_stop_file\n  _converge_stop_file=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n\n  round=0\n  while [ \"$round\" -lt \"$rounds\" ]; do\n    if [ -f \"$_converge_stop_file\" ]; then\n      final_status=\"aborted\"\n      final_verdict=\"STOP\"\n      final_reason=\"stop signal present before round $((round + 1))\"\n      break\n    fi\n\n    round=$((round + 1))\n    case \"$action_mode\" in\n      prompt)\n        if almanac_converge_run_worker_prompt \"$root\" \"$goal\" \"$prompt\" \"$round\"; then\n          exec_rc=0\n        else\n          exec_rc=$?\n        fi\n        ;;\n      *)\n        if (cd \"$root\" && almanac_converge_run_worker \"$root\" \"$goal\" \"$exec_cmd\" \"$round\"); then\n          exec_rc=0\n        else\n          exec_rc=$?\n        fi\n        ;;\n    esac\n\n    # In exec-mode the worker is authoritative for commits (slice 03 contract).\n    # In prompt-mode the driver already attempted the auto-commit inside the\n    # worker function and will have warned on failure, so the check is skipped\n    # to avoid a duplicate / misleading \"driver will not commit\" message.\n    if [ \"$action_mode\" = \"exec\" ] \\\n       && [ -n \"$(almanac_converge_git_user_status \"$root\" \"$plan_dir\" 2>/dev/null || true)\" ]; then\n      _warn \"Converge round $round: worker left uncommitted changes; driver will not commit\"\n    fi\n\n    if [ \"$exec_rc\" -ne 0 ]; then\n      if [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n        _warn \"Converge round $round exec exited $exec_rc; stopping\"\n      else\n        _warn \"Converge round $round exec exited $exec_rc; continuing\"\n      fi\n    fi\n\n    almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \"goal=$slug\" >/dev/null 2>&1 || true\n\n    if [ \"$exec_rc\" -ne 0 ] && [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n      almanac_converge_write_convergence \"$root\" \"$goal\" \"FAILED\" \"$round\" \"$started_epoch\" \"exec exit=$exec_rc round=$round\"\n      almanac_converge_run_finalize \"$root\" \"$run_id\" \"failed\" \"exec exit=$exec_rc round=$round\"\n      return \"$exec_rc\"\n    fi\n\n    if [ \"$no_oversee\" -eq 0 ] && [ $((round % oversee_every)) -eq 0 ]; then\n      almanac_converge_run_overseer \"$root\" \"$goal\" \"$round\"\n      final_verdict=\"$ALMANAC_CONVERGE_VERDICT\"\n      final_reason=\"$ALMANAC_CONVERGE_REASON\"\n      case \"$ALMANAC_CONVERGE_VERDICT\" in\n        CONVERGED)\n          final_status=\"done\"\n          break\n          ;;\n        STOP)\n          final_status=\"aborted\"\n          break\n          ;;\n      esac\n    fi\n  done\n\n  almanac_converge_write_convergence \"$root\" \"$goal\" \"$final_verdict\" \"$round\" \"$started_epoch\" \"$final_reason\"\n  almanac_converge_run_finalize \"$root\" \"$run_id\" \"$final_status\"\n}\n","numLines":987,"startLine":1,"totalLines":987}}}
