{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01SXRjjR4wCaQHs98LALt1QM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ti39ZY4KFmbZnLtrKq8Kzz","name":"Read","input":{"file_path":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/loops.sh"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":3636,"cache_read_input_tokens":41170,"cache_creation":{"ephemeral_5m_input_tokens":3636,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_019Kz3RBNz6eX2dXbntAP8pD","session_id":"19c2339b-02f8-4b81-9b44-59452ec22e33","uuid":"d0fdd236-5a8e-4102-82bb-25a01f4aa232","request_id":"req_011CbRdrKqU7uMBkChcMx3ae","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0175643T75AMYzjKomqQaJ2w","type":"tool_result","content":"<system-reminder>[Truncated: PARTIAL view — showing lines 1-1342 of 1990 total (31508 tokens, cap 25000). Call Read with offset=1343 limit=1342 for the next page, or Grep to find a specific section. Do NOT answer from this page alone if the answer may be further in the file.]</system-reminder>\n\n1\t#!/usr/bin/env bash\n2\t# harden-core.sh - Harden loop rubric bootstrap + reviewer helpers\n3\t\n4\t# loop-core.sh (the old shared-engine barrel) is deleted; harden-core sources the\n5\t# focused modules it actually uses, each directly and idempotently so it works\n6\t# both through bin/almanac and when a test sources this file directly. core.sh\n7\t# is sourced literally (it owns the helper); the other deps go through\n8\t# _almanac_source_sibling so the boilerplate stays minimal.\n9\tif ! declare -F _error >/dev/null 2>&1; then\n10\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n11\t  # shellcheck source=lib/core.sh\n12\t  source \"$__harden_core_dir/core.sh\"\n13\t  unset __harden_core_dir\n14\tfi\n15\t\n16\t# Explicit deps (each declared module is the contract surface this file consumes;\n17\t# transitive availability is not relied on).\n18\t_almanac_source_sibling agent.sh    almanac_loop_agent_capture   # agent run shapes (ratify/fixer)\n19\t_almanac_source_sibling run.sh      almanac_loop_register_run    # run registry + worker paths/health\n20\t_almanac_source_sibling worker.sh   almanac_loop_worker_start    # worker orchestration (reviewer/fixer fan-out)\n21\t_almanac_source_sibling ui.sh       almanac_loop_ui_render       # gum-or-plain dashboard seam\n22\t_almanac_source_sibling role.sh     almanac_loop_role_config     # per-role provider/model/effort resolution\n23\t_almanac_source_sibling feedback.sh almanac_loop_feedback_run    # objective fixer gate\n24\t\n25\t# --- Role config (per-role provider / model / effort) --------------------------\n26\t#\n27\t# Each harden role selects its own agent config:\n28\t#   conductor - judges/ratifies findings and declares convergence\n29\t#   reviewer  - one read-only reviewer per lens (lens -> provider map)\n30\t#   fixer     - the single sequential write-capable fixer\n31\t#\n32\t# Resolution layers, most specific first, via the shared loop resolver:\n33\t#   provider: HARDEN_<ROLE>[_<LENS>]_PROVIDER -> HARDEN_<ROLE>_PROVIDER\n34\t#             -> HARDEN_PROVIDER -> claude (sensible default: Claude plays every role)\n35\t#   model:    HARDEN_<ROLE>[_<LENS>]_MODEL    -> HARDEN_<ROLE>_MODEL\n36\t#             -> HARDEN_MODEL -> \"\" (the provider's own default)\n37\t#   effort:   HARDEN_<ROLE>[_<LENS>]_EFFORT   -> HARDEN_<ROLE>_EFFORT\n38\t#             -> HARDEN_EFFORT -> \"\" (the provider's own default)\n39\t#\n40\t# Only reviewers consult the lens, so providers can be mixed across lenses in one\n41\t# round; conductor and fixer are single-instance and ignore it. Resolution reads\n42\t# ONLY HARDEN_* (and the shared loop env) — never any host marker — so the tuple\n43\t# is identical whether the run was launched from Claude Code or Codex. Emits three\n44\t# TSV rows (provider/model/effort); returns 2 on an unknown role.\n45\talmanac_harden_role() {\n46\t  local role=\"$1\"\n47\t  local lens=\"${2:-}\"\n48\t\n49\t  case \"$role\" in\n50\t    reviewer) ;;                 # reviewers map lens -> provider\n51\t    conductor | fixer) lens=\"\" ;; # single-instance roles ignore the lens\n52\t    *) return 2 ;;\n53\t  esac\n54\t\n55\t  almanac_loop_role_config \"harden\" \"$role\" \"$lens\" \"$(almanac_provider_default)\" \"\" \"\"\n56\t}\n57\t\n58\t# One field (provider | model | effort) of a harden role's resolved config, for\n59\t# call sites that need a single value. Thin reader over almanac_harden_role so\n60\t# harden's per-role defaults stay defined in exactly one place.\n61\talmanac_harden_role_field() {\n62\t  local role=\"$1\"\n63\t  local field=\"$2\"\n64\t  local lens=\"${3:-}\"\n65\t\n66\t  # Consume all of almanac_harden_role's output (no early awk exit) so the\n67\t  # producer never takes a SIGPIPE under `set -o pipefail`.\n68\t  almanac_harden_role \"$role\" \"$lens\" | awk -F'\\t' -v k=\"$field\" '$1 == k { v = $2 } END { print v }'\n69\t}\n70\t\n71\talmanac_harden_rubric_path() {\n72\t  local root=\"$1\"\n73\t  local target=\"$2\"\n74\t  local slug\n75\t\n76\t  slug=\"$(almanac_loop_slug \"$target\")\"\n77\t  printf '%s/docs/plans/harden/%s/rubric.md\\n' \"$root\" \"$slug\"\n78\t}\n79\t\n80\talmanac_harden_write_rubric() {\n81\t  local root=\"$1\"\n82\t  local target=\"$2\"\n83\t  local goal=\"$3\"\n84\t  local path dir\n85\t\n86\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n87\t  dir=\"$(dirname \"$path\")\"\n88\t\n89\t  if [ -e \"$path\" ]; then\n90\t    return 2\n91\t  fi\n92\t\n93\t  mkdir -p \"$dir\"\n94\t  cat > \"$path\" <<EOF\n95\t# Harden Rubric\n96\t\n97\tTarget: $target\n98\tStatus: draft\n99\t\n100\t## Goal\n101\t\n102\t$goal\n103\t\n104\t## Acceptance\n105\t\n106\t- [ ] Target behavior satisfies the stated goal.\n107\t- [ ] Blocking findings include a failing test, breaking input, or cited acceptance violation.\n108\t- [ ] Project feedback loops pass after fixes.\n109\t\n110\t## In Scope\n111\t\n112\t- $target\n113\t\n114\t## Out of Scope\n115\t\n116\t- Add non-goals here before running reviewers.\n117\t\n118\t## Severity\n119\t\n120\tBlocking findings must be falsifiable and reproducible against the current target.\n121\tSubjective or unreproducible findings are non-blocking notes.\n122\t\n123\t## Context\n124\t\n125\t- Add intentional decisions and false-positive preemptions here before running reviewers.\n126\tEOF\n127\t}\n128\t\n129\talmanac_harden_approve_rubric() {\n130\t  local root=\"$1\"\n131\t  local target=\"$2\"\n132\t  local path approved_at tmp\n133\t\n134\t  path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n135\t\n136\t  if [ ! -f \"$path\" ]; then\n137\t    return 2\n138\t  fi\n139\t\n140\t  if grep -Eq '^Status: approved$' \"$path\"; then\n141\t    return 3\n142\t  fi\n143\t\n144\t  approved_at=\"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\"\n145\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n146\t\n147\t  if grep -Eq '^Status: draft$' \"$path\"; then\n148\t    awk -v approved_at=\"$approved_at\" '\n149\t      /^Status: draft$/ && !replaced {\n150\t        print \"Status: approved\"\n151\t        replaced = 1\n152\t        next\n153\t      }\n154\t      { print }\n155\t      END {\n156\t        print \"\"\n157\t        print \"## Approval\"\n158\t        print \"\"\n159\t        print \"Approved: \" approved_at\n160\t      }\n161\t    ' \"$path\" > \"$tmp\"\n162\t  else\n163\t    awk -v approved_at=\"$approved_at\" '\n164\t      /^Target: / && !inserted {\n165\t        print\n166\t        print \"Status: approved\"\n167\t        inserted = 1\n168\t        next\n169\t      }\n170\t      { print }\n171\t      END {\n172\t        if (!inserted) {\n173\t          print \"Status: approved\"\n174\t        }\n175\t        print \"\"\n176\t        print \"## Approval\"\n177\t        print \"\"\n178\t        print \"Approved: \" approved_at\n179\t      }\n180\t    ' \"$path\" > \"$tmp\"\n181\t  fi\n182\t\n183\t  mv \"$tmp\" \"$path\"\n184\t}\n185\t\n186\t# Return 0 when the rubric is approved (locked), non-zero otherwise — including\n187\t# when it is still a draft or the file is absent. Pure read; the loop gates on\n188\t# this so reviewers never run against a half-authored bar.\n189\talmanac_harden_rubric_approved() {\n190\t  local rubric_path=\"$1\"\n191\t\n192\t  [ -f \"$rubric_path\" ] || return 1\n193\t  grep -Eq '^Status: approved$' \"$rubric_path\"\n194\t}\n195\t\n196\t# Emit the rubric's acceptance criteria — the bar reviewers and ratification work\n197\t# against. Prints every bullet line under the `## Acceptance` heading up to the\n198\t# next `## ` section. Empty when the rubric or section is absent. Pure read.\n199\talmanac_harden_rubric_acceptance() {\n200\t  local path=\"$1\"\n201\t\n202\t  [ -f \"$path\" ] || return 0\n203\t\n204\t  awk '\n205\t    /^## Acceptance[[:space:]]*$/ { in_acc = 1; next }\n206\t    in_acc && /^## / { in_acc = 0 }\n207\t    in_acc && /^- / { print }\n208\t  ' \"$path\"\n209\t}\n210\t\n211\t# Append one acceptance criterion to the rubric's `## Acceptance` section. This is\n212\t# how a ratified finding grows the bar: monotonic (criteria are only added), visible\n213\t# (a clean diff), and append-only. The new `- [ ] <criterion>` lands at the end of\n214\t# the Acceptance block, before the next section. Idempotent: an identical criterion\n215\t# is never re-added (returns 1, writes nothing) so re-ratifying a reopened finding\n216\t# cannot duplicate it. Returns 2 when the rubric or its Acceptance section is absent.\n217\talmanac_harden_rubric_append_criterion() {\n218\t  local path=\"$1\"\n219\t  local criterion=\"$2\"\n220\t  local tmp\n221\t\n222\t  [ -f \"$path\" ] || return 2\n223\t  grep -q '^## Acceptance[[:space:]]*$' \"$path\" || return 2\n224\t\n225\t  if grep -Fxq -- \"- [ ] $criterion\" \"$path\" || \\\n226\t      grep -Fxq -- \"- [x] $criterion\" \"$path\"; then\n227\t    return 1\n228\t  fi\n229\t\n230\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n231\t  awk -v crit=\"$criterion\" '\n232\t    /^## Acceptance[[:space:]]*$/ { print; in_acc = 1; next }\n233\t    in_acc && /^## / {\n234\t      print \"- [ ] \" crit\n235\t      inserted = 1\n236\t      in_acc = 0\n237\t      for (i = 1; i <= nb; i++) print blanks[i]\n238\t      nb = 0\n239\t      print\n240\t      next\n241\t    }\n242\t    in_acc && /^[[:space:]]*$/ { nb++; blanks[nb] = $0; next }\n243\t    in_acc {\n244\t      for (i = 1; i <= nb; i++) print blanks[i]\n245\t      nb = 0\n246\t      print\n247\t      next\n248\t    }\n249\t    { print }\n250\t    END {\n251\t      if (in_acc && !inserted) {\n252\t        print \"- [ ] \" crit\n253\t        for (i = 1; i <= nb; i++) print blanks[i]\n254\t      }\n255\t    }\n256\t  ' \"$path\" > \"$tmp\"\n257\t  mv \"$tmp\" \"$path\"\n258\t}\n259\t\n260\t# --- Rubric immutability guard -------------------------------------------------\n261\t#\n262\t# The rubric is the contract, and during a run it is immutable to agents: the\n263\t# goalposts move only by a deliberate human act (the developer editing the file\n264\t# between runs / approving it) or the conductor's controlled append at\n265\t# ratification (almanac_harden_rubric_append_criterion — a visible, monotonic\n266\t# diff that runs OUTSIDE the reviewer/fixer phase). Reviewers run read-only and\n267\t# cannot write the rubric; the fixer (later slice) has write access and could.\n268\t# These two helpers bracket an agent phase — snapshot before, verify after — and\n269\t# revert any agent edit, so a stray agent write during a run cannot lower the bar.\n270\t\n271\t# Snapshot the rubric to a protected temp copy and echo the snapshot path so the\n272\t# caller can pass it to almanac_harden_rubric_verify. Returns 2 (echoes nothing)\n273\t# when no rubric exists — an ad-hoc bare run with no drafted contract has nothing\n274\t# to guard.\n275\talmanac_harden_rubric_snapshot() {\n276\t  local rubric_path=\"$1\"\n277\t  local snap\n278\t\n279\t  [ -f \"$rubric_path\" ] || return 2\n280\t\n281\t  snap=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-rubric-lock.XXXXXX\")\"\n282\t  cp \"$rubric_path\" \"$snap\"\n283\t  printf '%s\\n' \"$snap\"\n284\t}\n285\t\n286\t# Verify the rubric is byte-identical to its snapshot; if an agent modified it\n287\t# during the guarded phase, revert it and warn (the contract is immutable to\n288\t# agents). Discards the snapshot either way. Returns 1 when a modification was\n289\t# reverted, 0 when unchanged, 2 when the snapshot is missing.\n290\talmanac_harden_rubric_verify() {\n291\t  local rubric_path=\"$1\"\n292\t  local snap=\"$2\"\n293\t\n294\t  [ -n \"$snap\" ] && [ -f \"$snap\" ] || return 2\n295\t\n296\t  if ! cmp -s \"$rubric_path\" \"$snap\"; then\n297\t    cp \"$snap\" \"$rubric_path\"\n298\t    rm -f \"$snap\"\n299\t    _warn \"Rubric was modified during the run; reverted (contract is immutable to agents — amend it directly between runs).\"\n300\t    return 1\n301\t  fi\n302\t\n303\t  rm -f \"$snap\"\n304\t  return 0\n305\t}\n306\t\n307\t# Emit the configured reviewer lens set, one lens per line. Defaults to the five\n308\t# PRD lenses; override at runtime via HARDEN_LENSES (comma- or whitespace-\n309\t# separated).\n310\talmanac_harden_lenses() {\n311\t  local raw=\"${HARDEN_LENSES:-correctness security perf edge-cases contracts}\"\n312\t\n313\t  # Trailing newline matters: a `read` loop consumer drops a final line that\n314\t  # lacks one, which would silently swallow the last lens.\n315\t  printf '%s\\n' \"$raw\" | tr -s ', \\t' '\\n' | sed '/^$/d'\n316\t}\n317\t\n318\talmanac_harden_max_reviewers() {\n319\t  printf '%s\\n' \"${HARDEN_MAX_REVIEWERS:-16}\"\n320\t}\n321\t\n322\t# Build the fixed prompt for one read-only reviewer over a target, including the\n323\t# JSON-Lines findings schema. When a rubric path is given and exists, the rubric's\n324\t# acceptance criteria are embedded as the bar the reviewer judges against, so\n325\t# reviewers consume the contract rather than an implicit standard. An optional\n326\t# steering directive (4th arg) is embedded too, so an operator who redirects the\n327\t# run at the HITL checkpoint (e.g. \"focus on the auth module\") reaches the\n328\t# reviewers on the next round. Kept separate so the schema can grow without\n329\t# touching orchestration. (Exact prompt wording is not asserted in tests by\n330\t# design; that the rubric bar and the steer directive are consumed is.)\n331\talmanac_harden_reviewer_prompt() {\n332\t  local target=\"$1\"\n333\t  local lens=\"${2:-correctness}\"\n334\t  local rubric_path=\"${3:-}\"\n335\t  local directive=\"${4:-}\"\n336\t  local rubric_bar=\"\"\n337\t\n338\t  if [ -n \"$rubric_path\" ] && [ -f \"$rubric_path\" ]; then\n339\t    rubric_bar=\"$(almanac_harden_rubric_acceptance \"$rubric_path\")\"\n340\t  fi\n341\t\n342\t  cat <<EOF\n343\tYou are a read-only code reviewer. Lens: ${lens}.\n344\t\n345\tReview the target below for ${lens} defects only. You cannot modify any files;\n346\tthis is a read-only review.\n347\t\n348\tTarget: ${target}\n349\tEOF\n350\t\n351\t  if [ -n \"$rubric_bar\" ]; then\n352\t    cat <<EOF\n353\t\n354\tJudge the target against this acceptance bar (the rubric contract). A finding is\n355\tonly blocking if it violates a criterion below or demonstrably breaks behavior:\n356\t\n357\t${rubric_bar}\n358\tEOF\n359\t  fi\n360\t\n361\t  if [ -n \"$directive\" ]; then\n362\t    cat <<EOF\n363\t\n364\tThe operator steered this run with the directive below — follow it and prioritize\n365\tthe findings it points you toward:\n366\t\n367\t${directive}\n368\tEOF\n369\t  fi\n370\t\n371\t  cat <<EOF\n372\t\n373\tReport each defect as one JSON object per line (JSON Lines) and output nothing\n374\telse — no prose, no markdown fences. Each object must use this schema:\n375\t\n376\t{\"lens\":\"${lens}\",\"severity\":\"high|medium|low\",\"location\":\"<file:line or symbol>\",\"claim\":\"<one-line defect>\",\"demonstration\":\"<failing test, breaking input, or cited rubric criterion>\"}\n377\t\n378\tOnly report a defect you can demonstrate with a failing test, a specific breaking\n379\tinput, or a cited criterion. If you find no demonstrable defects, output nothing.\n380\tEOF\n381\t}\n382\t\n383\t# Normalize the reviewer's JSON-Lines result into TSV rows\n384\t# (lens, severity, location, claim, demonstration). Malformed lines are dropped\n385\t# cleanly. Prefers jq; falls back to a flat-field awk extractor when jq is absent\n386\t# so harden keeps almanac's near-zero-dependency promise.\n387\talmanac_harden_findings_tsv() {\n388\t  local result_file=\"$1\"\n389\t\n390\t  [ -f \"$result_file\" ] || return 0\n391\t\n392\t  if command -v jq >/dev/null 2>&1; then\n393\t    jq -Rr '\n394\t      fromjson?\n395\t      | select(type == \"object\")\n396\t      | {\n397\t          lens: (.lens // \"\"),\n398\t          severity: (.severity // \"\"),\n399\t          location: (.location // \"\"),\n400\t          claim: (.claim // \"\"),\n401\t          demonstration: (.demonstration // \"\")\n402\t        }\n403\t      | select(\n404\t          (.lens | type == \"string\" and length > 0) and\n405\t          (.severity | type == \"string\" and length > 0) and\n406\t          (.location | type == \"string\" and length > 0) and\n407\t          (.claim | type == \"string\" and length > 0) and\n408\t          (.demonstration | type == \"string\" and length > 0)\n409\t        )\n410\t      | [.lens, .severity, .location, .claim, .demonstration]\n411\t      | @tsv\n412\t    ' \"$result_file\" 2>/dev/null\n413\t    return 0\n414\t  fi\n415\t\n416\t  awk '\n417\t    function field(line, key,   v) {\n418\t      v = line\n419\t      if (v ~ (\"\\\"\" key \"\\\"[ \\t]*:[ \\t]*\\\"\")) {\n420\t        sub(\".*\\\"\" key \"\\\"[ \\t]*:[ \\t]*\\\"\", \"\", v)\n421\t        sub(\"\\\".*\", \"\", v)\n422\t        return v\n423\t      }\n424\t      return \"\"\n425\t    }\n426\t    /\"claim\"[ \\t]*:/ {\n427\t      lens = field($0, \"lens\")\n428\t      severity = field($0, \"severity\")\n429\t      location = field($0, \"location\")\n430\t      claim = field($0, \"claim\")\n431\t      demonstration = field($0, \"demonstration\")\n432\t      if (lens != \"\" && severity != \"\" && location != \"\" && claim != \"\" && demonstration != \"\") {\n433\t        printf \"%s\\t%s\\t%s\\t%s\\t%s\\n\", lens, severity, location, claim, demonstration\n434\t      }\n435\t    }\n436\t  ' \"$result_file\"\n437\t}\n438\t\n439\t# Print parsed findings as a readable list. Reports \"No findings reported.\" when\n440\t# the reviewer returned nothing parseable.\n441\talmanac_harden_format_findings() {\n442\t  local result_file=\"$1\"\n443\t  local lens severity location claim demonstration count\n444\t\n445\t  count=0\n446\t  while IFS=$'\\t' read -r lens severity location claim demonstration; do\n447\t    [ -n \"${lens}${severity}${location}${claim}${demonstration}\" ] || continue\n448\t    printf -- '- [%s] %s: %s\\n' \"${severity:-?}\" \"${lens:-?}\" \"${claim:-?}\"\n449\t    [ -n \"$location\" ] && printf '    where: %s\\n' \"$location\"\n450\t    [ -n \"$demonstration\" ] && printf '    demo:  %s\\n' \"$demonstration\"\n451\t    count=$((count + 1))\n452\t  done < <(almanac_harden_findings_tsv \"$result_file\")\n453\t\n454\t  if [ \"$count\" -eq 0 ]; then\n455\t    printf '%s\\n' \"No findings reported.\"\n456\t  fi\n457\t}\n458\t\n459\t# --- Findings ledger -----------------------------------------------------------\n460\t#\n461\t# Canonical finding schema (one JSON object per reviewer line, see the reviewer\n462\t# prompt above): lens, severity, location, claim, demonstration. The ledger adds\n463\t# three adjudication fields when a finding is recorded:\n464\t#   id            - deterministic fingerprint of (lens, location, claim)\n465\t#   status        - open | fixed | rejected-subjective | wontfix-per-context\n466\t#   round         - the review round that first raised the finding\n467\t#   adjudication  - free-text note (why rejected / how fixed); empty when open\n468\t#\n469\t# Findings persist append-only to findings.md next to the target's rubric.md.\n470\t# Each finding is one markdown section keyed by its id, so the file is both\n471\t# human-readable and re-parseable (dedupe + open-blocking query read it back).\n472\t\n473\talmanac_harden_ledger_path() {\n474\t  local root=\"$1\"\n475\t  local target=\"$2\"\n476\t  local slug\n477\t\n478\t  slug=\"$(almanac_loop_slug \"$target\")\"\n479\t  printf '%s/docs/plans/harden/%s/findings.md\\n' \"$root\" \"$slug\"\n480\t}\n481\t\n482\t# Deterministic finding identity. Two reviewer reports of the same defect\n483\t# (same lens, same place, same claim) collapse to one id so re-raising a\n484\t# finding never re-adds it. Demonstration is deliberately excluded: a reworded\n485\t# repro must not look like a new finding. cksum keeps this dependency-free.\n486\talmanac_harden_finding_id() {\n487\t  local lens=\"$1\"\n488\t  local location=\"$2\"\n489\t  local claim=\"$3\"\n490\t  local sum\n491\t\n492\t  sum=\"$(printf '%s\\037%s\\037%s' \"$lens\" \"$location\" \"$claim\" | cksum | awk '{print $1}')\"\n493\t  printf 'f-%s\\n' \"$sum\"\n494\t}\n495\t\n496\talmanac_harden_ledger_init() {\n497\t  local path=\"$1\"\n498\t  local dir\n499\t\n500\t  dir=\"$(dirname \"$path\")\"\n501\t  mkdir -p \"$dir\"\n502\t\n503\t  if [ ! -f \"$path\" ]; then\n504\t    {\n505\t      printf '%s\\n\\n' \"# Findings Ledger\"\n506\t      printf '%s\\n' \"<!-- Append-only finding records managed by 'almanac harden'. One section per finding. -->\"\n507\t    } > \"$path\"\n508\t  fi\n509\t}\n510\t\n511\t# True when the ledger already holds a finding with this id.\n512\talmanac_harden_ledger_has() {\n513\t  local path=\"$1\"\n514\t  local id=\"$2\"\n515\t\n516\t  [ -f \"$path\" ] || return 1\n517\t  grep -Fxq -- \"## $id\" \"$path\"\n518\t}\n519\t\n520\t# Append one finding section. Returns 1 (and writes nothing) when the id is\n521\t# already present, so callers can count genuinely-new findings. Creates the\n522\t# ledger file with its header on first write.\n523\talmanac_harden_ledger_append_entry() {\n524\t  [ \"$#\" -ge 7 ] || return 2\n525\t\n526\t  local path=\"$1\"\n527\t  local id=\"$2\"\n528\t  local lens=\"$3\"\n529\t  local severity=\"$4\"\n530\t  local location=\"$5\"\n531\t  local claim=\"$6\"\n532\t  local demonstration=\"$7\"\n533\t  local status=\"${8:-open}\"\n534\t  local round=\"${9:-1}\"\n535\t  local adjudication=\"${10:-}\"\n536\t\n537\t  almanac_harden_ledger_init \"$path\"\n538\t\n539\t  if almanac_harden_ledger_has \"$path\" \"$id\"; then\n540\t    return 1\n541\t  fi\n542\t\n543\t  almanac_harden_ledger_append_entry_unchecked \\\n544\t    \"$path\" \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \\\n545\t    \"$demonstration\" \"$status\" \"$round\" \"$adjudication\"\n546\t}\n547\t\n548\t# Append one already-deduped finding section. Callers must have initialised the\n549\t# ledger and decided the id is new; this keeps bulk ingestion from grepping the\n550\t# growing ledger once per finding.\n551\talmanac_harden_ledger_append_entry_unchecked() {\n552\t  [ \"$#\" -ge 7 ] || return 2\n553\t\n554\t  local path=\"$1\"\n555\t  local id=\"$2\"\n556\t  local lens=\"$3\"\n557\t  local severity=\"$4\"\n558\t  local location=\"$5\"\n559\t  local claim=\"$6\"\n560\t  local demonstration=\"$7\"\n561\t  local status=\"${8:-open}\"\n562\t  local round=\"${9:-1}\"\n563\t  local adjudication=\"${10:-}\"\n564\t\n565\t  {\n566\t    printf '\\n## %s\\n\\n' \"$id\"\n567\t    printf -- '- lens: %s\\n' \"$lens\"\n568\t    printf -- '- severity: %s\\n' \"$severity\"\n569\t    printf -- '- location: %s\\n' \"$location\"\n570\t    printf -- '- claim: %s\\n' \"$claim\"\n571\t    printf -- '- demonstration: %s\\n' \"$demonstration\"\n572\t    printf -- '- status: %s\\n' \"$status\"\n573\t    printf -- '- round: %s\\n' \"$round\"\n574\t    printf -- '- adjudication: %s\\n' \"$adjudication\"\n575\t  } >> \"$path\"\n576\t}\n577\t\n578\t# Normalize a reviewer's JSON-Lines result into ledger-entry TSV rows\n579\t# (id, lens, severity, location, claim, demonstration, status, round,\n580\t# adjudication). New findings are status=open with an empty adjudication.\n581\t# Malformed reviewer lines are dropped cleanly (via almanac_harden_findings_tsv).\n582\talmanac_harden_parse_findings() {\n583\t  local result_file=\"$1\"\n584\t  local round=\"${2:-1}\"\n585\t  local lens severity location claim demonstration id\n586\t\n587\t  while IFS=$'\\t' read -r lens severity location claim demonstration; do\n588\t    [ -n \"${lens}${severity}${location}${claim}${demonstration}\" ] || continue\n589\t    id=\"$(almanac_harden_finding_id \"$lens\" \"$location\" \"$claim\")\"\n590\t    printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \\\n591\t      \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \"$demonstration\" \"open\" \"$round\" \"\"\n592\t  done < <(almanac_harden_findings_tsv \"$result_file\")\n593\t}\n594\t\n595\t# Parse a reviewer result and append each new finding to the ledger, deduping\n596\t# against everything already adjudicated. Prints the count of findings actually\n597\t# added (duplicates do not count).\n598\talmanac_harden_ledger_record() {\n599\t  local path=\"$1\"\n600\t  local result_file=\"$2\"\n601\t  local round=\"${3:-1}\"\n602\t  local parsed statuses actions reopen_ids action\n603\t  local id lens severity location claim demonstration status r adjudication\n604\t  local added=0\n605\t\n606\t  almanac_harden_ledger_init \"$path\"\n607\t\n608\t  parsed=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-findings.XXXXXX\")\"\n609\t  statuses=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-statuses.XXXXXX\")\"\n610\t  actions=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-actions.XXXXXX\")\"\n611\t  reopen_ids=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-reopen.XXXXXX\")\"\n612\t\n613\t  almanac_harden_parse_findings \"$result_file\" \"$round\" > \"$parsed\"\n614\t\n615\t  awk '\n616\t    /^## / { id = substr($0, 4); next }\n617\t    /^- status:/ && id != \"\" {\n618\t      val = $0\n619\t      sub(/^- status:[ \\t]*/, \"\", val)\n620\t      print id \"\\t\" val\n621\t    }\n622\t  ' \"$path\" > \"$statuses\"\n623\t\n624\t  awk '\n625\t    BEGIN { FS = \"\\t\" }\n626\t    FILENAME == ARGV[1] { existing[$1] = $2; next }\n627\t    $1 == \"\" { next }\n628\t    seen[$1]++ { next }\n629\t    !($1 in existing) {\n630\t      print \"append\\t\" $0\n631\t      next\n632\t    }\n633\t    existing[$1] == \"fixed\" {\n634\t      print \"reopen\\t\" $0\n635\t      next\n636\t    }\n637\t  ' \"$statuses\" \"$parsed\" > \"$actions\"\n638\t\n639\t  while IFS=$'\\t' read -r action id lens severity location claim demonstration status r adjudication; do\n640\t    [ -n \"$id\" ] || continue\n641\t    case \"$action\" in\n642\t      append)\n643\t        almanac_harden_ledger_append_entry_unchecked \\\n644\t          \"$path\" \"$id\" \"$lens\" \"$severity\" \"$location\" \"$claim\" \\\n645\t          \"$demonstration\" \"$status\" \"$r\" \"$adjudication\"\n646\t        added=$((added + 1))\n647\t        ;;\n648\t      reopen)\n649\t        printf '%s\\n' \"$id\" >> \"$reopen_ids\"\n650\t        ;;\n651\t    esac\n652\t  done < \"$actions\"\n653\t\n654\t  if [ -s \"$reopen_ids\" ]; then\n655\t    almanac_harden_ledger_set_status_many \"$path\" \"open\" \\\n656\t      \"re-raised by reviewer at round $round; pending ratification\" < \"$reopen_ids\"\n657\t  fi\n658\t\n659\t  rm -f \"$parsed\" \"$statuses\" \"$actions\" \"$reopen_ids\"\n660\t\n661\t  printf '%s\\n' \"$added\"\n662\t}\n663\t\n664\t# Emit the open blocking findings as TSV rows\n665\t# (id, lens, severity, location, claim, demonstration). Only status=open\n666\t# entries qualify; fixed / rejected-subjective / wontfix-per-context never gate.\n667\talmanac_harden_ledger_open_blocking() {\n668\t  local path=\"$1\"\n669\t\n670\t  [ -f \"$path\" ] || return 0\n671\t\n672\t  awk '\n673\t    function flush() {\n674\t      if (id != \"\" && status == \"open\") {\n675\t        printf \"%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n\", id, lens, severity, location, claim, demonstration\n676\t      }\n677\t    }\n678\t    /^## / {\n679\t      flush()\n680\t      id = substr($0, 4)\n681\t      lens = \"\"; severity = \"\"; location = \"\"; claim = \"\"; demonstration = \"\"; status = \"\"\n682\t      next\n683\t    }\n684\t    /^- / {\n685\t      line = substr($0, 3)\n686\t      p = index(line, \":\")\n687\t      if (p == 0) next\n688\t      key = substr(line, 1, p - 1)\n689\t      val = substr(line, p + 1)\n690\t      sub(/^ /, \"\", val)\n691\t      if (key == \"lens\") lens = val\n692\t      else if (key == \"severity\") severity = val\n693\t      else if (key == \"location\") location = val\n694\t      else if (key == \"claim\") claim = val\n695\t      else if (key == \"demonstration\") demonstration = val\n696\t      else if (key == \"status\") status = val\n697\t    }\n698\t    END { flush() }\n699\t  ' \"$path\"\n700\t}\n701\t\n702\t# Print the recorded status of the finding with this id (empty when the id is\n703\t# not in the ledger). Used by ratification to tell new from already-adjudicated.\n704\talmanac_harden_ledger_status() {\n705\t  local path=\"$1\"\n706\t  local id=\"$2\"\n707\t\n708\t  [ -f \"$path\" ] || return 0\n709\t\n710\t  awk -v want=\"$id\" '\n711\t    /^## / { cur = substr($0, 4); next }\n712\t    /^- status:/ && cur == want {\n713\t      val = $0\n714\t      sub(/^- status:[ \\t]*/, \"\", val)\n715\t      print val\n716\t      exit\n717\t    }\n718\t  ' \"$path\"\n719\t}\n720\t\n721\t# Rewrite the status (and adjudication note) of the finding with this id in\n722\t# place, leaving every other field and finding untouched. Returns 1 when the\n723\t# ledger file is absent.\n724\talmanac_harden_ledger_set_status() {\n725\t  local path=\"$1\"\n726\t  local id=\"$2\"\n727\t  local status=\"$3\"\n728\t  local adjudication=\"${4:-}\"\n729\t  local tmp\n730\t\n731\t  [ -f \"$path\" ] || return 1\n732\t\n733\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n734\t  awk -v want=\"$id\" -v status=\"$status\" -v adj=\"$adjudication\" '\n735\t    /^## / { cur = substr($0, 4); print; next }\n736\t    cur == want && /^- status:/ { print \"- status: \" status; next }\n737\t    cur == want && /^- adjudication:/ { print \"- adjudication: \" adj; next }\n738\t    { print }\n739\t  ' \"$path\" > \"$tmp\"\n740\t  mv \"$tmp\" \"$path\"\n741\t}\n742\t\n743\t# Rewrite status/adjudication for many finding ids in one ledger pass. Reads ids\n744\t# from stdin, one per line. Used after a batch fix so marking N findings fixed is\n745\t# O(ledger) instead of N full ledger rewrites.\n746\talmanac_harden_ledger_set_status_many() {\n747\t  local path=\"$1\"\n748\t  local status=\"$2\"\n749\t  local adjudication=\"${3:-}\"\n750\t  local ids tmp\n751\t\n752\t  [ -f \"$path\" ] || return 1\n753\t\n754\t  ids=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ids.XXXXXX\")\"\n755\t  cat > \"$ids\"\n756\t  [ -s \"$ids\" ] || { rm -f \"$ids\"; return 0; }\n757\t\n758\t  tmp=\"$(mktemp \"${path}.XXXXXX\")\"\n759\t  awk -v ids=\"$ids\" -v status=\"$status\" -v adj=\"$adjudication\" '\n760\t    BEGIN {\n761\t      while ((getline line < ids) > 0) {\n762\t        if (line != \"\") wanted[line] = 1\n763\t      }\n764\t      close(ids)\n765\t    }\n766\t    /^## / { cur = substr($0, 4); print; next }\n767\t    (cur in wanted) && /^- status:/ { print \"- status: \" status; next }\n768\t    (cur in wanted) && /^- adjudication:/ { print \"- adjudication: \" adj; next }\n769\t    { print }\n770\t  ' \"$path\" > \"$tmp\"\n771\t  mv \"$tmp\" \"$path\"\n772\t  rm -f \"$ids\"\n773\t}\n774\t\n775\t# --- Ratification engine -------------------------------------------------------\n776\t#\n777\t# A finding is \"blocking\" only if its demonstration objectively reproduces\n778\t# against the current target — never on a reviewer's assertion alone. Execution\n779\t# of the demonstration is isolated behind a seam (almanac_harden_demo_reproduces)\n780\t# so the decision logic is testable without running anything, and so the real\n781\t# executor (a conductor agent-runner call) can be wired in a later slice.\n782\t\n783\t# Prompt the conductor uses to execute one finding's demonstration. It must run\n784\t# the demonstration against the CURRENT code and render a strict, falsifiable\n785\t# verdict — never an opinion. The verdict contract is a single machine-readable\n786\t# token so the parser can be unambiguous (see almanac_harden_ratify_verdict).\n787\talmanac_harden_ratify_prompt() {\n788\t  local demonstration=\"$1\"\n789\t  local target_path=\"${2:-}\"\n790\t\n791\t  cat <<EOF\n792\tYou are the CONDUCTOR in a code-hardening loop. Ratify ONE reviewer finding by\n793\tEXECUTING its demonstration against the current code — decide by reproduction,\n794\tnever by opinion.\n795\t\n796\tTarget: ${target_path:-(the current working directory)}\n797\t\n798\tDemonstration to reproduce:\n799\t${demonstration}\n800\t\n801\tDo this:\n802\t1. Carry out the demonstration against the code AS IT IS RIGHT NOW: run the\n803\t   proposed failing test, try the specific breaking input, or check the cited\n804\t   rubric criterion.\n805\t2. Decide strictly. The finding reproduces ONLY if the defect actually manifests\n806\t   against the current code. A demonstration that you cannot run, that is vague\n807\t   or speculative, or that does not actually fail does NOT reproduce.\n808\t3. You are a JUDGE, not a fixer: do not modify the target to change the outcome.\n809\t\n810\tEnd your message with EXACTLY ONE of these two lines and nothing after it:\n811\tHARDEN_VERDICT=reproduces\n812\tHARDEN_VERDICT=not-reproduces\n813\tEOF\n814\t}\n815\t\n816\t# Parse the conductor's final message into a reproduce verdict. The contract is a\n817\t# single unambiguous token: the affirmative is the literal \"HARDEN_VERDICT=reproduces\"\n818\t# (the negative \"HARDEN_VERDICT=not-reproduces\" cannot match it — the char after\n819\t# `=` is `n`, not `r`). Anything else (no token, garbled, only the negative) reads\n820\t# as \"not\", so an un-parseable verdict is conservatively a non-blocking note.\n821\talmanac_harden_ratify_verdict() {\n822\t  local result_file=\"$1\"\n823\t\n824\t  [ -f \"$result_file\" ] || { printf '%s\\n' \"not\"; return 0; }\n825\t\n826\t  if grep -Fxq 'HARDEN_VERDICT=reproduces' \"$result_file\" 2>/dev/null; then\n827\t    printf '%s\\n' \"reproduces\"\n828\t  else\n829\t    printf '%s\\n' \"not\"\n830\t  fi\n831\t}\n832\t\n833\t# Execution seam: decide whether a finding's demonstration reproduces against the\n834\t# target. Return 0 = reproduces (real defect, blocking), non-zero = does not\n835\t# reproduce (opinion / stale). This seam IS the conductor executing the\n836\t# demonstration: it runs the demonstration through the resolved conductor provider\n837\t# (the (provider, model, effort) it is handed — no host-marker dependence, so it\n838\t# is mixable per the role config) via the shared agent runner and reads the\n839\t# conductor's verdict back from its final message. PRD story 8: \"blocking means\n840\t# objectively reproducible, not a reviewer's assertion.\"\n841\t#\n842\t# Conservative on every uncertainty so opinions never silently gate the loop and\n843\t# a flaky/missing provider never blocks a run: an empty demonstration, an\n844\t# unresolved conductor provider, a failed/un-runnable conductor call, or an\n845\t# un-parseable verdict all read as non-reproducing (a note). Tests override this\n846\t# to drive the decision paths directly; here it is the real executor.\n847\talmanac_harden_demo_reproduces() {\n848\t  local demonstration=\"$1\"\n849\t  local target_path=\"${2:-}\"\n850\t  local conductor_provider=\"${3:-}\"\n851\t  local conductor_model=\"${4:-}\"\n852\t  local conductor_effort=\"${5:-}\"\n853\t  local prompt_file result_file events_file verdict rc\n854\t\n855\t  # Nothing to execute / no provider to execute it through -> conservative note.\n856\t  [ -n \"$demonstration\" ] || return 1\n857\t  [ -n \"$conductor_provider\" ] || return 1\n858\t\n859\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-prompt.XXXXXX\")\" || return 1\n860\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-result.XXXXXX\")\" || { rm -f \"$prompt_file\"; return 1; }\n861\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-ratify-events.XXXXXX\")\" || { rm -f \"$prompt_file\" \"$result_file\"; return 1; }\n862\t\n863\t  almanac_harden_ratify_prompt \"$demonstration\" \"$target_path\" > \"$prompt_file\"\n864\t\n865\t  # Reviewer text is untrusted. Ratification may inspect/run existing repro\n866\t  # commands, but it must not write to the repo before the single fixer phase.\n867\t  rc=0\n868\t  almanac_loop_agent_capture \"$conductor_provider\" \"$conductor_model\" \"$conductor_effort\" \\\n869\t    \"read-only\" \"$prompt_file\" \"$result_file\" \"$events_file\" >/dev/null 2>&1 || rc=$?\n870\t\n871\t  if [ \"$rc\" -ne 0 ]; then\n872\t    # Provider missing/crashed or the demonstration was un-runnable: cannot\n873\t    # confirm reproduction -> non-blocking note, never a hang or a hard failure.\n874\t    rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n875\t    return 1\n876\t  fi\n877\t\n878\t  verdict=\"$(almanac_harden_ratify_verdict \"$result_file\")\"\n879\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n880\t\n881\t  [ \"$verdict\" = \"reproduces\" ] && return 0\n882\t  return 1\n883\t}\n884\t\n885\t# Adjudicate one finding by executing its demonstration through the seam and\n886\t# recording the outcome in the ledger. Prints the verdict:\n887\t#   blocking - new/open finding whose demonstration reproduces (ratified, gates)\n888\t#   note     - new/open finding that does not reproduce (non-blocking note)\n889\t#   reopened - an already-adjudicated finding whose demonstration newly reproduces\n890\t#   dropped  - an already-adjudicated finding that still does not reproduce\n891\t# Already-adjudicated findings are re-litigated ONLY when they newly reproduce,\n892\t# so a rejected opinion cannot churn the loop round after round.\n893\t#\n894\t# When a rubric path is given, a finding that reproduces (blocking or reopened)\n895\t# also appends a falsifiable criterion to the rubric's `## Acceptance` — the bar\n896\t# grows monotonically and visibly with every ratified defect. Notes and drops\n897\t# never touch the rubric, so opinions cannot raise the bar.\n898\t#\n899\t# The trailing conductor (provider, model, effort) args (11th-13th) identify the\n900\t# provider that executes the demonstration; they are passed straight to the\n901\t# execution seam. Optional/backward-compatible — omit them to use the default.\n902\talmanac_harden_ratify() {\n903\t  local path=\"$1\"\n904\t  local id=\"$2\"\n905\t  local lens=\"$3\"\n906\t  local severity=\"$4\"\n907\t  local location=\"$5\"\n908\t  local claim=\"$6\"\n909\t  local demonstration=\"$7\"\n910\t  local round=\"${8:-1}\"\n911\t  local target_path=\"${9:-}\"\n912\t  local rubric_path=\"${10:-}\"\n913\t  local conductor_provider=\"${11:-}\"\n914\t  local conductor_model=\"${12:-}\"\n915\t  local conductor_effort=\"${13:-}\"\n916\t  local current_status reproduces status note\n917\t\n918\t  almanac_harden_ledger_init \"$path\"\n919\t  current_status=\"$(almanac_harden_ledger_status \"$path\" \"$id\")\"\n920\t\n921\t  if almanac_harden_demo_reproduces \"$demonstration\" \"$target_path\" \\\n922\t      \"$conductor_provider\" \"$conductor_model\" \"$conductor_effort\"; then\n923\t    reproduces=1\n924\t  else\n925\t    reproduces=0\n926\t  fi\n927\t\n928\t  # A ratified (reproducing) finding grows the rubric bar, regardless of whether\n929\t  # it is newly raised or a reopened prior finding. Idempotent on the criterion\n930\t  # text, so a reopen never duplicates an already-listed criterion.\n931\t  if [ \"$reproduces\" -eq 1 ] && [ -n \"$rubric_path\" ]; then\n932\t    almanac_harden_rubric_append_criterion \"$rubric_path\" \\\n933\t      \"${claim} — must not reproduce (lens: ${lens}, at ${location})\" >/dev/null || true\n934\t  fi\n935\t\n936\t  case \"$current_status\" in\n937\t    fixed | rejected-subjective | wontfix-per-context)\n938\t      if [ \"$reproduces\" -eq 1 ]; then\n939\t        almanac_harden_ledger_set_status \"$path\" \"$id\" \"open\" \\\n940\t          \"reopened: demonstration reproduced at round $round\"\n941\t        printf '%s\\n' \"reopened\"\n942\t      else\n943\t        printf '%s\\n' \"dropped\"\n944\t      fi\n945\t      return 0\n946\t      ;;\n947\t  esac\n948\t\n949\t  if [ \"$reproduces\" -eq 1 ]; then\n950\t    status=\"open\"\n951\t    note=\"ratified: demonstration reproduced at round $round\"\n952\t  else\n953\t    status=\"rejected-subjective\"\n954\t    note=\"did not reproduce at round $round\"\n955\t  fi\n956\t\n957\t  if [ -z \"$current_status\" ]; then\n958\t    almanac_harden_ledger_append_entry \"$path\" \"$id\" \"$lens\" \"$severity\" \\\n959\t      \"$location\" \"$claim\" \"$demonstration\" \"$status\" \"$round\" \"$note\" >/dev/null\n960\t  else\n961\t    almanac_harden_ledger_set_status \"$path\" \"$id\" \"$status\" \"$note\"\n962\t  fi\n963\t\n964\t  if [ \"$reproduces\" -eq 1 ]; then\n965\t    printf '%s\\n' \"blocking\"\n966\t  else\n967\t    printf '%s\\n' \"note\"\n968\t  fi\n969\t}\n970\t\n971\t# Fan out one read-only reviewer per configured lens as a background worker via\n972\t# the shared worker orchestration, then aggregate every reviewer's findings into\n973\t# the ledger (deduped). Reviewers run concurrently and never write to the target\n974\t# (read-only sandbox); the parent aggregates sequentially after they finish, so\n975\t# there are no concurrent ledger writers. The lens set is configurable via\n976\t# HARDEN_LENSES, capped by HARDEN_MAX_REVIEWERS. Each reviewer's\n977\t# provider/model/effort resolves through the shared role config\n978\t# (HARDEN_REVIEWER[_<LENS>]_{PROVIDER,MODEL,EFFORT}). _die on a missing target\n979\t# before spawning anything.\n980\talmanac_harden_fanout() {\n981\t  local root=\"$1\"\n982\t  local target=\"$2\"\n983\t  local round=\"${3:-1}\"\n984\t  local directive=\"${4:-}\"\n985\t  local target_path run_id run_id_base registry_dir ledger_path rubric_path lens provider model effort\n986\t  local worker_id prompt_file pidfile pid result_file status_file wstatus\n987\t  local added total_added i max_reviewers succeeded_count suffix\n988\t  local -a lenses=() worker_ids=() worker_pids=() prompt_files=()\n989\t\n990\t  case \"$target\" in\n991\t    /*) target_path=\"$target\" ;;\n992\t    *)  target_path=\"$root/$target\" ;;\n993\t  esac\n994\t\n995\t  if [ ! -e \"$target_path\" ]; then\n996\t    _die \"Harden target not found: $target\"\n997\t  fi\n998\t\n999\t  while IFS= read -r lens; do\n1000\t    [ -n \"$lens\" ] || continue\n1001\t    lenses+=(\"$lens\")\n1002\t  done < <(almanac_harden_lenses)\n1003\t\n1004\t  [ \"${#lenses[@]}\" -gt 0 ] || _die \"No reviewer lenses configured\"\n1005\t  max_reviewers=\"$(almanac_harden_max_reviewers)\"\n1006\t  case \"$max_reviewers\" in\n1007\t    ''|*[!0-9]*) _die \"HARDEN_MAX_REVIEWERS must be a positive integer: $max_reviewers\" ;;\n1008\t  esac\n1009\t  [ \"$max_reviewers\" -ge 1 ] || _die \"HARDEN_MAX_REVIEWERS must be at least 1: $max_reviewers\"\n1010\t  if [ \"${#lenses[@]}\" -gt \"$max_reviewers\" ]; then\n1011\t    _die \"Too many reviewer lenses (${#lenses[@]}); cap is $max_reviewers (set HARDEN_MAX_REVIEWERS to change it)\"\n1012\t  fi\n1013\t\n1014\t  run_id=\"$(almanac_loop_run_id \"harden\" \"$target\")\"\n1015\t  run_id_base=\"$run_id\"\n1016\t  registry_dir=\"$(almanac_loop_registry_dir \"$root\")\"\n1017\t  suffix=1\n1018\t  while [ -e \"$registry_dir/$run_id\" ]; do\n1019\t    suffix=$((suffix + 1))\n1020\t    run_id=\"${run_id_base}-${suffix}\"\n1021\t  done\n1022\t  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n1023\t  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n1024\t\n1025\t  # The rubric is the contract; once one has been drafted it must be approved\n1026\t  # (locked) before the loop proceeds, so reviewers never run against a bar the\n1027\t  # human is still authoring. No rubric at all = an explicit ad-hoc run; proceed.\n1028\t  if [ -f \"$rubric_path\" ] && ! almanac_harden_rubric_approved \"$rubric_path\"; then\n1029\t    _die \"Rubric not approved: ${rubric_path#\"$root\"/} — edit it, then: almanac harden $target --approve\"\n1030\t  fi\n1031\t\n1032\t  almanac_harden_ledger_init \"$ledger_path\"\n1033\t\n1034\t  # The rubric is immutable to agents during the run. Snapshot it before any\n1035\t  # reviewer spawns; the reviewer round makes no legitimate rubric edits (the\n1036\t  # conductor's controlled append happens at ratification, a later phase), so\n1037\t  # any change observed when reviewers finish is an agent tampering — revert it.\n1038\t  local rubric_snapshot=\"\"\n1039\t  if [ -f \"$rubric_path\" ]; then\n1040\t    rubric_snapshot=\"$(almanac_harden_rubric_snapshot \"$rubric_path\")\" || rubric_snapshot=\"\"\n1041\t  fi\n1042\t\n1043\t  _info \"Hardening $target — fanning out ${#lenses[@]} read-only reviewer(s)\"\n1044\t\n1045\t  for lens in \"${lenses[@]}\"; do\n1046\t    provider=\"$(almanac_harden_role_field \"reviewer\" \"provider\" \"$lens\")\"\n1047\t    model=\"$(almanac_harden_role_field \"reviewer\" \"model\" \"$lens\")\"\n1048\t    effort=\"$(almanac_harden_role_field \"reviewer\" \"effort\" \"$lens\")\"\n1049\t\n1050\t    worker_id=\"reviewer-$lens\"\n1051\t    prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-prompt.XXXXXX\")\"\n1052\t    # Reviewers judge against the rubric when one exists (read gracefully when\n1053\t    # absent, e.g. an ad-hoc bare run with no drafted contract yet) and follow an\n1054\t    # operator steer directive when one was set at the HITL checkpoint.\n1055\t    almanac_harden_reviewer_prompt \"$target\" \"$lens\" \"$rubric_path\" \"$directive\" > \"$prompt_file\"\n1056\t\n1057\t    # Capture the worker pid via a file (not $(...)): worker_start backgrounds\n1058\t    # the agent as a child of THIS shell, so it stays waitable. A command\n1059\t    # substitution would reparent it into a subshell and break the wait.\n1060\t    pidfile=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-pid.XXXXXX\")\"\n1061\t    almanac_loop_worker_start \"$root\" \"$run_id\" \"$worker_id\" \\\n1062\t      \"$provider\" \"$model\" \"$effort\" \"read-only\" \"$prompt_file\" > \"$pidfile\"\n1063\t    pid=\"$(cat \"$pidfile\")\"\n1064\t    rm -f \"$pidfile\"\n1065\t\n1066\t    worker_ids+=(\"$worker_id\")\n1067\t    worker_pids+=(\"$pid\")\n1068\t    prompt_files+=(\"$prompt_file\")\n1069\t    _info \"  reviewer lens=$lens provider=$provider pid=$pid (read-only)\"\n1070\t  done\n1071\t\n1072\t  # Reviewers run concurrently; block until every one finishes.\n1073\t  for pid in \"${worker_pids[@]}\"; do\n1074\t    wait \"$pid\" 2>/dev/null || true\n1075\t  done\n1076\t\n1077\t  total_added=0\n1078\t  succeeded_count=0\n1079\t  i=0\n1080\t  for worker_id in \"${worker_ids[@]}\"; do\n1081\t    lens=\"${lenses[$i]}\"\n1082\t    i=$((i + 1))\n1083\t    status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n1084\t    result_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"result.txt\")\"\n1085\t\n1086\t    wstatus=\"\"\n1087\t    if [ -f \"$status_file\" ]; then\n1088\t      wstatus=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n1089\t    fi\n1090\t\n1091\t    if [ \"$wstatus\" != \"done\" ]; then\n1092\t      _warn \"reviewer lens=$lens failed or did not finish cleanly; skipping its findings\"\n1093\t      continue\n1094\t    fi\n1095\t    succeeded_count=$((succeeded_count + 1))\n1096\t\n1097\t    _info \"Findings (lens: $lens):\"\n1098\t    almanac_harden_format_findings \"$result_file\"\n1099\t\n1100\t    if [ -f \"$result_file\" ]; then\n1101\t      added=\"$(almanac_harden_ledger_record \"$ledger_path\" \"$result_file\" \"$round\")\"\n1102\t      total_added=$((total_added + added))\n1103\t    fi\n1104\t  done\n1105\t\n1106\t  [ \"${#prompt_files[@]}\" -eq 0 ] || rm -f \"${prompt_files[@]}\"\n1107\t\n1108\t  # Enforce the immutability invariant: revert (and warn about) any rubric edit\n1109\t  # an agent slipped in during the round.\n1110\t  if [ -n \"$rubric_snapshot\" ]; then\n1111\t    almanac_harden_rubric_verify \"$rubric_path\" \"$rubric_snapshot\" || true\n1112\t  fi\n1113\t\n1114\t  if [ \"$succeeded_count\" -eq 0 ]; then\n1115\t    _warn \"All reviewer workers failed; no reliable review result was produced.\"\n1116\t    return 1\n1117\t  fi\n1118\t\n1119\t  _success \"Aggregated $total_added new finding(s) into ${ledger_path#\"$root\"/}\"\n1120\t}\n1121\t\n1122\t# --- Single sequential fixer + feedback verdict --------------------------------\n1123\t#\n1124\t# After reviewers fan out and the conductor ratifies findings, ONE write-capable\n1125\t# fixer applies changes for the open blocking findings, in place, in the working\n1126\t# tree. v1 is deliberately a single sequential agent — no worktrees, no parallel\n1127\t# writers — so there is never a merge conflict to reconcile and any regression\n1128\t# test the fixer writes simply persists on disk. The fixer then runs the\n1129\t# project's feedback loops (shared detection + runner) and reports a verdict per\n1130\t# loop, so the objective half of \"bulletproof\" is enforced every round.\n1131\t\n1132\t# Build the prompt for the single sequential fixer. It receives the kill-list\n1133\t# (the open blocking findings) and the rubric bar, and is told to apply minimal\n1134\t# fixes AND leave a regression test per finding so the fix stays enforced. An\n1135\t# optional steering directive (4th arg) is embedded too, so a mid-run redirect at\n1136\t# the HITL checkpoint reaches the fixer. Exact wording is not asserted by tests by\n1137\t# design; that the fixer runs write-capable, its output persists, and it consumes\n1138\t# the steer directive is.\n1139\talmanac_harden_fixer_prompt() {\n1140\t  local target=\"$1\"\n1141\t  local findings_text=\"$2\"\n1142\t  local rubric_path=\"${3:-}\"\n1143\t  local directive=\"${4:-}\"\n1144\t  local rubric_bar=\"\"\n1145\t\n1146\t  if [ -n \"$rubric_path\" ] && [ -f \"$rubric_path\" ]; then\n1147\t    rubric_bar=\"$(almanac_harden_rubric_acceptance \"$rubric_path\")\"\n1148\t  fi\n1149\t\n1150\t  cat <<EOF\n1151\tYou are a single sequential fixer with write access to the repository. Apply the\n1152\tminimal changes that resolve every blocking finding below for the target. For\n1153\teach finding, add or update a regression test that fails before your fix and\n1154\tpasses after, so the defect cannot silently return.\n1155\t\n1156\tTarget: ${target}\n1157\t\n1158\tBlocking findings to fix:\n1159\t${findings_text}\n1160\tEOF\n1161\t\n1162\t  if [ -n \"$rubric_bar\" ]; then\n1163\t    cat <<EOF\n1164\t\n1165\tYour changes must satisfy this acceptance bar (the rubric contract):\n1166\t\n1167\t${rubric_bar}\n1168\tEOF\n1169\t  fi\n1170\t\n1171\t  if [ -n \"$directive\" ]; then\n1172\t    cat <<EOF\n1173\t\n1174\tThe operator steered this run with the directive below — apply it while you fix:\n1175\t\n1176\t${directive}\n1177\tEOF\n1178\t  fi\n1179\t\n1180\t  cat <<EOF\n1181\t\n1182\tDo not weaken, skip, or delete existing tests, and do not edit the rubric. Leave\n1183\tthe working tree building and the project's feedback loops (tests / typecheck /\n1184\tlint) green.\n1185\tEOF\n1186\t}\n1187\t\n1188\t# Run the single sequential fixer over the target's open blocking findings, then\n1189\t# run the project's feedback loops and report a pass/fail verdict per loop.\n1190\t#\n1191\t# One agent, write-capable (sandbox=workspace-write, NOT read-only), in place: no\n1192\t# worktree, so any regression tests it generates persist in the repo after the\n1193\t# run. Sequential by construction — a single foreground agent call — so there are\n1194\t# never concurrent writers. The fixer's agent call is bracketed by the rubric\n1195\t# immutability guard (snapshot before, verify after) so a write-capable fixer\n1196\t# cannot move the goalposts mid-run; legitimate rubric growth happens earlier, in\n1197\t# ratification, outside this bracket. On a clean fixer exit every open blocking\n1198\t# finding is marked `fixed` in the ledger; the next round's reviewers/ratify\n1199\t# reopen anything that still reproduces, so a still-broken finding cannot be\n1200\t# silently closed. A no-op (prints a note, returns 0) when there are no open\n1201\t# blocking findings. Returns the provider's exit code on a fixer failure, leaving\n1202\t# the findings open.\n1203\t#\n1204\t# The objective feedback gate is NOT run here: the convergence loop runs it once\n1205\t# per round (almanac_harden_round) so feedback executes every round even when\n1206\t# there is nothing to fix, and the gate reads a fresh verdict. The standalone\n1207\t# `--fix` CLI path runs almanac_harden_report_feedback explicitly afterwards.\n1208\talmanac_harden_fix() {\n1209\t  local root=\"$1\"\n1210\t  local target=\"$2\"\n1211\t  local round=\"${3:-1}\"\n1212\t  local directive=\"${4:-}\"\n1213\t  local target_path ledger_path rubric_path open findings_text count\n1214\t  local provider model effort prompt_file result_file events_file rubric_snapshot rc\n1215\t  local id lens severity location claim demonstration\n1216\t\n1217\t  case \"$target\" in\n1218\t    /*) target_path=\"$target\" ;;\n1219\t    *)  target_path=\"$root/$target\" ;;\n1220\t  esac\n1221\t\n1222\t  if [ ! -e \"$target_path\" ]; then\n1223\t    _die \"Harden target not found: $target\"\n1224\t  fi\n1225\t\n1226\t  ledger_path=\"$(almanac_harden_ledger_path \"$root\" \"$target\")\"\n1227\t  rubric_path=\"$(almanac_harden_rubric_path \"$root\" \"$target\")\"\n1228\t\n1229\t  open=\"$(almanac_harden_ledger_open_blocking \"$ledger_path\")\"\n1230\t  if [ -z \"$open\" ]; then\n1231\t    _info \"No open blocking findings to fix.\"\n1232\t    return 0\n1233\t  fi\n1234\t\n1235\t  count=\"$(printf '%s\\n' \"$open\" | grep -c .)\"\n1236\t\n1237\t  # Render the kill-list into the fixer prompt's findings block.\n1238\t  findings_text=\"$(\n1239\t    while IFS=$'\\t' read -r id lens severity location claim demonstration; do\n1240\t      [ -n \"$id\" ] || continue\n1241\t      printf -- '- [%s] %s: %s (at %s)\\n    demo: %s\\n' \\\n1242\t        \"${severity:-?}\" \"${lens:-?}\" \"${claim:-?}\" \"${location:-?}\" \"${demonstration:-?}\"\n1243\t    done <<INNER\n1244\t$open\n1245\tINNER\n1246\t  )\"\n1247\t\n1248\t  provider=\"$(almanac_harden_role_field \"fixer\" \"provider\")\"\n1249\t  model=\"$(almanac_harden_role_field \"fixer\" \"model\")\"\n1250\t  effort=\"$(almanac_harden_role_field \"fixer\" \"effort\")\"\n1251\t\n1252\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-prompt.XXXXXX\")\"\n1253\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-result.XXXXXX\")\"\n1254\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-harden-fixer-events.XXXXXX\")\"\n1255\t  almanac_harden_fixer_prompt \"$target\" \"$findings_text\" \"$rubric_path\" \"$directive\" > \"$prompt_file\"\n1256\t\n1257\t  # The rubric is immutable to agents during a run. The fixer is write-capable,\n1258\t  # so bracket its agent call: snapshot before, verify (revert + warn) after.\n1259\t  rubric_snapshot=\"\"\n1260\t  if [ -f \"$rubric_path\" ]; then\n1261\t    rubric_snapshot=\"$(almanac_harden_rubric_snapshot \"$rubric_path\")\" || rubric_snapshot=\"\"\n1262\t  fi\n1263\t\n1264\t  _info \"Fixing $count open blocking finding(s) with one sequential fixer (provider=$provider, write-capable)\"\n1265\t\n1266\t  rc=0\n1267\t  almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"workspace-write\" \\\n1268\t    \"$prompt_file\" \"$result_file\" \"$events_file\" >/dev/null || rc=$?\n1269\t\n1270\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n1271\t\n1272\t  if [ -n \"$rubric_snapshot\" ]; then\n1273\t    almanac_harden_rubric_verify \"$rubric_path\" \"$rubric_snapshot\" || true\n1274\t  fi\n1275\t\n1276\t  if [ \"$rc\" -ne 0 ]; then\n1277\t    _warn \"Fixer failed (exit $rc); blocking findings remain open.\"\n1278\t    return \"$rc\"\n1279\t  fi\n1280\t\n1281\t  # The single fixer addresses the whole kill-list; mark all open blocking\n1282\t  # findings fixed in one ledger rewrite. A finding that still reproduces is\n1283\t  # reopened next round.\n1284\t  printf '%s\\n' \"$open\" | awk -F '\\t' '$1 != \"\" { print $1 }' \\\n1285\t    | almanac_harden_ledger_set_status_many \"$ledger_path\" \"fixed\" \\\n1286\t      \"fixed by sequential fixer at round $round\"\n1287\t\n1288\t  _success \"Applied fixes for $count finding(s); regenerated tests persist in the working tree.\"\n1289\t}\n1290\t\n1291\t# Run the project's feedback loops via the shared runner and print a pass/fail\n1292\t# verdict per loop. Returns the runner's aggregate (0 = all green, non-zero =\n1293\t# any failed) so a caller (the convergence gate, later) can act on it.\n1294\talmanac_harden_report_feedback() {\n1295\t  local root=\"$1\"\n1296\t  local verdicts cmd verdict rc\n1297\t\n1298\t  _info \"Running project feedback loops:\"\n1299\t\n1300\t  rc=0\n1301\t  verdicts=\"$(almanac_loop_feedback_run \"$root\")\" || rc=$?\n1302\t\n1303\t  if [ -z \"$verdicts\" ]; then\n1304\t    _info \"  (no feedback loops detected)\"\n1305\t    return 0\n1306\t  fi\n1307\t\n1308\t  while IFS=$'\\t' read -r cmd verdict; do\n1309\t    [ -n \"$cmd\" ] || continue\n1310\t    if [ \"$verdict\" = \"pass\" ]; then\n1311\t      _success \"  PASS  $cmd\"\n1312\t    else\n1313\t      _warn \"  FAIL  $cmd\"\n1314\t    fi\n1315\t  done <<INNER\n1316\t$verdicts\n1317\tINNER\n1318\t\n1319\t  return \"$rc\"\n1320\t}\n1321\t\n1322\t# --- Convergence loop + gate ---------------------------------------------------\n1323\t#\n1324\t# A round is the full hardening pass over one target: fan out reviewers, ratify\n1325\t# their findings by execution, fix the blocking ones, and run the project's\n1326\t# feedback loops. The convergence loop repeats rounds until the gate says stop:\n1327\t# it converges when the acceptance bar is met AND no open blocking findings\n1328\t# remain, gives up with a clear NON-CONVERGED status when the round budget is\n1329\t# hit, and otherwise checks in with the human (ship vs. continue) between rounds.\n1330\t# Because the gate only ever exits on convergence or the budget, the loop always\n1331\t# terminates — a pathological target cannot run forever.\n1332\t\n1333\t# Pure convergence predicate. Given the round's state, decide what the loop does\n1334\t# next. No I/O, no side effects (besides echoing the verdict) so it is trivially\n1335\t# unit-testable across the whole input space:\n1336\t#\n1337\t#   acceptance_met  1 = every acceptance criterion is met, else 0\n1338\t#   open_blocking   count of open blocking findings still remaining\n1339\t#   round           the round that just finished (1-based)\n1340\t#   budget          the hard round cap (>= 1)\n1341\t#\n1342\t# Echoes one verdict and returns a distinct code so a caller can branch on either:"}]},"parent_tool_use_id":"toolu_019Kz3RBNz6eX2dXbntAP8pD","session_id":"19c2339b-02f8-4b81-9b44-59452ec22e33","uuid":"52f3f2d7-96cf-4016-a89d-ebd08726256f","timestamp":"2026-05-26T18:15:07.551Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ti39ZY4KFmbZnLtrKq8Kzz","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops.sh — the loop-adapter seam (discovery + dispatch).\n3\t#\n4\t# Mirrors the provider-adapter seam (lib/agent.sh): each loop (ralph, harden) is a\n5\t# drop-in adapter file at lib/loops/<name>.sh answering one fixed question set, so\n6\t# no central code branches on a loop type. This module owns discovery (the loop\n7\t# list IS the files present), name-normalising dispatch (the one place a loop type\n8\t# becomes a function call), and auto-loads the adapters at source time.\n9\t#\n10\t# Each adapter (called as almanac_loop_<name>_<verb>) declares two contracts:\n11\t#   launch  — exec_argv: how to exec its runner (config in, _ALMANAC_LOOP_ARGV out)\n12\t#             — consumed by the launcher (lib/loop-launcher.sh)\n13\t#   control — signal_file <stop|steer>: its between-round dot-file basename.\n14\t#             Optional override — almanac_loop_default_signal_file (below) handles\n15\t#             the standard `.${name}-${kind}` convention every loop uses today, so\n16\t#             adapters only define this if their convention diverges. Resolved\n17\t#             through almanac_loop_signal_file (consumed by lib/run.sh control).\n18\t#\n19\t# Self-contained: uses only printf / tr / basename / source — no lib/core.sh\n20\t# dependency — so the seam (and the adapters) are their own test surface and\n21\t# tests/test-loops.sh sources this file directly.\n22\t\n23\t__almanac_loops_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t\n25\t# Normalise a loop name to its adapter key (lowercase).\n26\talmanac_loop_adapter_key() {\n27\t  printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]'\n28\t}\n29\t\n30\t# Source every loop adapter (idempotent — adapters only define functions).\n31\talmanac_loop_adapter_load() {\n32\t  local f\n33\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n34\t    [ -f \"$f\" ] || continue\n35\t    # shellcheck source=/dev/null\n36\t    source \"$f\"\n37\t  done\n38\t  return 0\n39\t}\n40\t\n41\t# List discovered loop names — the loop list IS the files present, so there is no\n42\t# second place to update. Sorted by the glob (alphabetical).\n43\talmanac_loop_adapter_list() {\n44\t  local f name\n45\t  for f in \"$__almanac_loops_dir\"/loops/*.sh; do\n46\t    [ -f \"$f\" ] || continue\n47\t    name=\"$(basename \"$f\" .sh)\"\n48\t    printf '%s\\n' \"$name\"\n49\t  done\n50\t  return 0\n51\t}\n52\t\n53\t# Is NAME a discovered loop?\n54\talmanac_loop_adapter_known() {\n55\t  local want target\n56\t  want=\"$(almanac_loop_adapter_key \"$1\")\"\n57\t  while IFS= read -r target; do\n58\t    [ \"$target\" = \"$want\" ] && return 0\n59\t  done <<EOF\n60\t$(almanac_loop_adapter_list)\n61\tEOF\n62\t  return 1\n63\t}\n64\t\n65\t# Dispatch a contract verb to NAME's adapter: almanac_loop_adapter_call <name>\n66\t# <verb> [args…]. Returns 2 if the adapter doesn't implement the verb. This is the\n67\t# one place that turns (loop, verb) into a function call, so no caller branches on\n68\t# loop type.\n69\talmanac_loop_adapter_call() {\n70\t  local key verb fn\n71\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n72\t  verb=\"$2\"\n73\t  shift 2\n74\t  fn=\"almanac_loop_${key}_${verb}\"\n75\t  declare -F \"$fn\" >/dev/null 2>&1 || return 2\n76\t  \"$fn\" \"$@\"\n77\t}\n78\t\n79\t# Default signal-file basename for a loop's between-round control. Every loop uses\n80\t# the same `.${name}-${kind}` convention (`.ralph-stop`, `.harden-steer`, …) so the\n81\t# pattern lives once here instead of being copy-pasted into each adapter. A loop\n82\t# only needs to define its own `signal_file` if its convention diverges; this is\n83\t# the deepening that turns three identical stop|steer case-statements into none.\n84\t# Returns 1 for an unknown kind.\n85\talmanac_loop_default_signal_file() {\n86\t  local name=\"$1\" kind=\"$2\"\n87\t  case \"$kind\" in\n88\t    stop|steer) printf '.%s-%s\\n' \"$name\" \"$kind\" ;;\n89\t    *) return 1 ;;\n90\t  esac\n91\t}\n92\t\n93\t# Resolve a loop's signal-file basename: the adapter's override if it defines\n94\t# `signal_file`, else the standard `.${name}-${kind}` default. This is the\n95\t# control-contract public surface — callers (lib/run.sh, harden-core, converge-core)\n96\t# go through here instead of dispatching to the adapter directly, so adding a new\n97\t# loop costs zero signal_file code unless the loop is non-standard. Returns 1 for\n98\t# an unknown kind or an unknown loop name.\n99\talmanac_loop_signal_file() {\n100\t  local key fn\n101\t  key=\"$(almanac_loop_adapter_key \"$1\")\"\n102\t  almanac_loop_adapter_known \"$key\" || return 1\n103\t  fn=\"almanac_loop_${key}_signal_file\"\n104\t  if declare -F \"$fn\" >/dev/null 2>&1; then\n105\t    \"$fn\" \"$2\"\n106\t  else\n107\t    almanac_loop_default_signal_file \"$key\" \"$2\"\n108\t  fi\n109\t}\n110\t\n111\talmanac_loop_adapter_load\n112\t"}]},"parent_tool_use_id":"toolu_019Kz3RBNz6eX2dXbntAP8pD","session_id":"19c2339b-02f8-4b81-9b44-59452ec22e33","uuid":"83c26640-2bb5-40a1-8ca9-f6516dff775d","timestamp":"2026-05-26T18:15:07.519Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018C6VQ9FAp52Tf34hHUA5MZ","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# converge-core.sh - Generic convergence loop core\n3\t\n4\t# Source focused deps idempotently so tests can source this file directly.\n5\t# core.sh owns the helper, so it's pulled in via the literal pattern.\n6\tif ! declare -F _error >/dev/null 2>&1; then\n7\t  __converge_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n8\t  # shellcheck source=lib/core.sh\n9\t  source \"$__converge_core_dir/core.sh\"\n10\t  unset __converge_core_dir\n11\tfi\n12\t\n13\t_almanac_source_sibling run.sh    almanac_loop_register_run\n14\t_almanac_source_sibling agent.sh  almanac_loop_agent_capture\n15\t_almanac_source_sibling role.sh   almanac_loop_role_config\n16\t\n17\talmanac_converge_plan_dir() {\n18\t  local root=\"$1\"\n19\t  local slug=\"$2\"\n20\t\n21\t  printf '%s/docs/plans/converge/%s\\n' \"$root\" \"$slug\"\n22\t}\n23\t\n24\talmanac_converge_scaffold() {\n25\t  local root=\"$1\"\n26\t  local goal=\"$2\"\n27\t  local plan_dir\n28\t\n29\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n30\t\n31\t  if ! mkdir -p \"$plan_dir\"; then\n32\t    _die \"Could not create converge plan dir: ${plan_dir#\"$root\"/}\"\n33\t  fi\n34\t  if ! printf '%s\\n' \"$goal\" > \"$plan_dir/goal.md\"; then\n35\t    _die \"Could not write converge goal: ${plan_dir#\"$root\"/}/goal.md\"\n36\t  fi\n37\t  if ! : > \"$plan_dir/agent-reports.log\"; then\n38\t    _die \"Could not write converge report log: ${plan_dir#\"$root\"/}/agent-reports.log\"\n39\t  fi\n40\t  if ! : > \"$plan_dir/goal.history.log\"; then\n41\t    _die \"Could not write converge goal history: ${plan_dir#\"$root\"/}/goal.history.log\"\n42\t  fi\n43\t}\n44\t\n45\talmanac_converge_role() {\n46\t  local role=\"$1\"\n47\t\n48\t  case \"$role\" in\n49\t    agent|overseer) ;;\n50\t    *) return 2 ;;\n51\t  esac\n52\t\n53\t  almanac_loop_role_config \"converge\" \"$role\" \"\" \"$(almanac_provider_default)\" \"\" \"\"\n54\t}\n55\t\n56\talmanac_converge_role_field() {\n57\t  local role=\"$1\"\n58\t  local field=\"$2\"\n59\t\n60\t  almanac_converge_role \"$role\" | awk -F'\\t' -v k=\"$field\" '$1 == k { v = $2 } END { print v }'\n61\t}\n62\t\n63\talmanac_converge_ensure_prompt_template() {\n64\t  local root=\"$1\"\n65\t  local goal=\"$2\"\n66\t  local plan_dir prompt_file\n67\t\n68\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n69\t  prompt_file=\"$plan_dir/prompt.md\"\n70\t  [ -f \"$prompt_file\" ] && return 0\n71\t\n72\t  cat > \"$prompt_file\" <<'EOF'\n73\t# Converge Worker\n74\t\n75\tYou are one worker round in a generic convergence loop.\n76\t\n77\tRead current goal, follow one-shot steer directive if present, run exact exec\n78\tcommand, then leave clear evidence in git history and agent-reports.log.\n79\t\n80\tDo not edit the goal unless explicitly asked by the exec command. Do not commit\n81\t.almanac or converge state files under docs/plans/converge/.\n82\tEOF\n83\t}\n84\t\n85\talmanac_converge_worker_prompt() {\n86\t  local root=\"$1\"\n87\t  local goal=\"$2\"\n88\t  local exec_cmd=\"$3\"\n89\t  local round=\"$4\"\n90\t  local slug plan_dir rel_plan steer_file\n91\t\n92\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n93\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n94\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n95\t  steer_file=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n96\t\n97\t  almanac_converge_ensure_prompt_template \"$root\" \"$goal\"\n98\t\n99\t  cat \"$plan_dir/prompt.md\"\n100\t  cat <<EOF\n101\t\n102\tCONVERGE_TICK=$round\n103\tCONVERGE_SLUG=$slug\n104\tCONVERGE_PLAN_DIR=$rel_plan\n105\tCONVERGE_REPORT_LOG=$rel_plan/agent-reports.log\n106\t\n107\tCommit user-visible worktree changes, excluding .almanac and $rel_plan, with:\n108\tCONVERGE($slug): <one-line summary>\n109\t\n110\tAppend one structured self-report to $rel_plan/agent-reports.log. Use this exact\n111\theader shape and these exact section labels:\n112\t\n113\t===== tick=<N> ts=<ISO> =====\n114\tsummary:\n115\tconcerns:\n116\tnext:\n117\t\n118\tFor this round, N is $round.\n119\t\n120\t===== GOAL.md =====\n121\tEOF\n122\t  cat \"$plan_dir/goal.md\"\n123\t  cat <<EOF\n124\t===== END GOAL.md =====\n125\t\n126\t===== EXEC COMMAND =====\n127\t$exec_cmd\n128\t===== END EXEC COMMAND =====\n129\tEOF\n130\t\n131\t  if [ -f \"$steer_file\" ]; then\n132\t    cat <<'EOF'\n133\t\n134\t===== STEER =====\n135\tEOF\n136\t    cat \"$steer_file\"\n137\t    cat <<'EOF'\n138\t===== END STEER =====\n139\tEOF\n140\t    rm -f \"$steer_file\"\n141\t  fi\n142\t}\n143\t\n144\talmanac_converge_report_log_has_structured_block() {\n145\t  local file=\"$1\"\n146\t\n147\t  [ -f \"$file\" ] || return 1\n148\t  awk '\n149\t    /^===== tick=[0-9][0-9]* ts=.* =====$/ {\n150\t      seen = 1\n151\t      summary = 0\n152\t      concerns = 0\n153\t      next_seen = 0\n154\t      next\n155\t    }\n156\t    seen && /^summary:$/ { summary = 1; next }\n157\t    seen && /^concerns:$/ { concerns = 1; next }\n158\t    seen && /^next:$/ { next_seen = 1; ok = summary && concerns && next_seen; next }\n159\t    END { exit ok ? 0 : 1 }\n160\t  ' \"$file\"\n161\t}\n162\t\n163\talmanac_converge_trim() {\n164\t  printf '%s' \"$1\" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'\n165\t}\n166\t\n167\talmanac_converge_overseer_prompt() {\n168\t  local root=\"$1\"\n169\t  local goal=\"$2\"\n170\t  local round=\"$3\"\n171\t  local slug plan_dir rel_plan reports_file reports commits\n172\t\n173\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n174\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n175\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n176\t  reports_file=\"$plan_dir/agent-reports.log\"\n177\t\n178\t  if [ -f \"$reports_file\" ]; then\n179\t    reports=\"$(tail -c 8192 \"$reports_file\")\"\n180\t  else\n181\t    reports=\"(no agent reports yet)\"\n182\t  fi\n183\t\n184\t  commits=\"$(git -C \"$root\" log --fixed-strings --grep=\"CONVERGE($slug):\" -n 10 \\\n185\t    --format='%H%n%ad%n%B%n---' --date=short 2>/dev/null || true)\"\n186\t  [ -n \"$commits\" ] || commits=\"No CONVERGE commits yet\"\n187\t\n188\t  cat <<EOF\n189\tYou are the overseer for converge($slug), a synchronous convergence loop.\n190\t\n191\tCONVERGE_TICK=$round\n192\tCONVERGE_SLUG=$slug\n193\tCONVERGE_PLAN_DIR=$rel_plan\n194\t\n195\tJudge whether the current goal is satisfied, whether the next worker needs a\n196\tone-shot steering directive, or whether the loop should stop.\n197\t\n198\t===== GOAL.md =====\n199\tEOF\n200\t  cat \"$plan_dir/goal.md\"\n201\t  cat <<EOF\n202\t===== END GOAL.md =====\n203\t\n204\t===== RECENT AGENT SELF-REPORTS (last ~8KB) =====\n205\t$reports\n206\t===== END RECENT AGENT SELF-REPORTS =====\n207\t\n208\t===== RECENT CONVERGE COMMITS (last 10) =====\n209\t$commits\n210\t===== END RECENT CONVERGE COMMITS =====\n211\t\n212\tOutput these fields in order with no preamble:\n213\tVERDICT: <CONVERGED|CONTINUE|STEER|STOP>\n214\tREASON: <one paragraph>\n215\tSTEER: <one paragraph, or 'none'>\n216\tGOAL_UPDATE: <new goal.md content, or 'unchanged'>\n217\t\n218\tBe conservative. Malformed output is treated as CONTINUE with no steering and no\n219\tgoal update. GOAL_UPDATE may span multiple lines because it is the final field.\n220\tEOF\n221\t}\n222\t\n223\talmanac_converge_overseer_parse() {\n224\t  local input=\"${1:-}\"\n225\t  local content line key_line current_key=\"\"\n226\t  local raw_verdict=\"\" raw_reason=\"\" raw_steer=\"\" raw_goal=\"\"\n227\t  local found_verdict=0 found_reason=0 found_steer=0 found_goal=0\n228\t\n229\t  if [ -f \"$input\" ]; then\n230\t    content=\"$(cat \"$input\")\"\n231\t  else\n232\t    content=\"$input\"\n233\t  fi\n234\t\n235\t  ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n236\t  ALMANAC_CONVERGE_REASON=\"\"\n237\t  ALMANAC_CONVERGE_STEER=\"none\"\n238\t  ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n239\t\n240\t  # State-machine line walker. Each KEY: prefix switches the current field;\n241\t  # subsequent non-key lines append to whatever field is currently open. This\n242\t  # lets the LLM emit either inline values (`REASON: blah`) or values on the\n243\t  # next line (`REASON:\\nblah`) or multi-line paragraphs that span until the\n244\t  # next KEY: marker — all parse correctly. Before this fix the parser only\n245\t  # captured the value text on the SAME line as KEY:, dropping continuation\n246\t  # lines and producing empty REASON / STEER for any LLM that emitted\n247\t  # paragraph-shaped values — the bug observed in the first --prompt converge\n248\t  # run (REASON empty, STEER none in the overseer.log entry despite the LLM\n249\t  # clearly being asked to produce both).\n250\t  while IFS= read -r line || [ -n \"$line\" ]; do\n251\t    key_line=\"$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\"\n252\t    case \"$key_line\" in\n253\t      VERDICT:*)\n254\t        current_key=\"VERDICT\"; found_verdict=1\n255\t        raw_verdict=\"${key_line#VERDICT:}\"\n256\t        case \"$raw_verdict\" in \" \"*) raw_verdict=\"${raw_verdict# }\" ;; esac\n257\t        ;;\n258\t      REASON:*)\n259\t        current_key=\"REASON\"; found_reason=1\n260\t        raw_reason=\"${key_line#REASON:}\"\n261\t        case \"$raw_reason\" in \" \"*) raw_reason=\"${raw_reason# }\" ;; esac\n262\t        ;;\n263\t      STEER:*)\n264\t        current_key=\"STEER\"; found_steer=1\n265\t        raw_steer=\"${key_line#STEER:}\"\n266\t        case \"$raw_steer\" in \" \"*) raw_steer=\"${raw_steer# }\" ;; esac\n267\t        ;;\n268\t      GOAL_UPDATE:*)\n269\t        current_key=\"GOAL_UPDATE\"; found_goal=1\n270\t        raw_goal=\"${key_line#GOAL_UPDATE:}\"\n271\t        case \"$raw_goal\" in \" \"*) raw_goal=\"${raw_goal# }\" ;; esac\n272\t        ;;\n273\t      *)\n274\t        # Continuation line — append to whichever field is currently open.\n275\t        # Lines before the first KEY: marker (preamble noise) have current_key\n276\t        # empty and are dropped, matching the prompt's \"no preamble\" contract.\n277\t        # The original line (not the leading-whitespace-stripped key_line) is\n278\t        # preserved so multi-line paragraphs keep their indentation if any.\n279\t        case \"$current_key\" in\n280\t          VERDICT)     raw_verdict=\"${raw_verdict}\"$'\\n'\"${line}\" ;;\n281\t          REASON)      raw_reason=\"${raw_reason}\"$'\\n'\"${line}\" ;;\n282\t          STEER)       raw_steer=\"${raw_steer}\"$'\\n'\"${line}\" ;;\n283\t          GOAL_UPDATE) raw_goal=\"${raw_goal}\"$'\\n'\"${line}\" ;;\n284\t        esac\n285\t        ;;\n286\t    esac\n287\t  done <<< \"$content\"\n288\t\n289\t  if [ \"$found_verdict\" -ne 1 ] || [ \"$found_reason\" -ne 1 ] || \\\n290\t    [ \"$found_steer\" -ne 1 ] || [ \"$found_goal\" -ne 1 ]; then\n291\t    return 0\n292\t  fi\n293\t\n294\t  # VERDICT is always a single token. A chatty LLM may put the token on its own\n295\t  # line and then ramble before REASON; the state-machine above will have\n296\t  # accumulated those ramble lines into raw_verdict. Reduce to the first\n297\t  # non-empty line so the case-match below still recognises the token.\n298\t  raw_verdict=\"$(printf '%s\\n' \"$raw_verdict\" | awk 'NF{print; exit}')\"\n299\t  raw_verdict=\"$(almanac_converge_trim \"$raw_verdict\")\"\n300\t  case \"$raw_verdict\" in\n301\t    CONVERGED|CONTINUE|STEER|STOP) ALMANAC_CONVERGE_VERDICT=\"$raw_verdict\" ;;\n302\t    *)\n303\t      ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n304\t      ALMANAC_CONVERGE_STEER=\"none\"\n305\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n306\t      return 0\n307\t      ;;\n308\t  esac\n309\t\n310\t  ALMANAC_CONVERGE_REASON=\"$(almanac_converge_trim \"$raw_reason\")\"\n311\t\n312\t  raw_steer=\"$(almanac_converge_trim \"$raw_steer\")\"\n313\t  if [ -n \"$raw_steer\" ] && ! printf '%s\\n' \"$raw_steer\" | grep -qiE '^none[[:space:]]*$'; then\n314\t    ALMANAC_CONVERGE_STEER=\"$raw_steer\"\n315\t  fi\n316\t\n317\t  if [ \"$found_goal\" -eq 1 ]; then\n318\t    local goal_check\n319\t    goal_check=\"$(almanac_converge_trim \"$raw_goal\")\"\n320\t    if [ -n \"$goal_check\" ] && ! printf '%s\\n' \"$goal_check\" | grep -qiE '^unchanged[[:space:]]*$'; then\n321\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"$raw_goal\"\n322\t    fi\n323\t  fi\n324\t}\n325\t\n326\talmanac_converge_write_convergence() {\n327\t  local root=\"$1\"\n328\t  local goal=\"$2\"\n329\t  local verdict=\"$3\"\n330\t  local tick=\"$4\"\n331\t  local started_epoch=\"${5:-}\"\n332\t  local reason=\"${6:-}\"\n333\t  local plan_dir now_epoch elapsed\n334\t\n335\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n336\t  now_epoch=\"$(date +%s)\"\n337\t  elapsed=\"\"\n338\t  case \"$started_epoch\" in\n339\t    ''|*[!0-9]*) ;;\n340\t    *) elapsed=\"$((now_epoch - started_epoch))s\" ;;\n341\t  esac\n342\t\n343\t  {\n344\t    printf '# Convergence\\n\\n'\n345\t    printf '## Final verdict\\n\\n%s\\n\\n' \"$verdict\"\n346\t    printf '## Tick count\\n\\n%s\\n\\n' \"$tick\"\n347\t    printf '## Time elapsed\\n\\n%s\\n\\n' \"${elapsed:-unknown}\"\n348\t    printf '## Final goal\\n\\n'\n349\t    if [ -f \"$plan_dir/goal.md\" ]; then\n350\t      cat \"$plan_dir/goal.md\"\n351\t    fi\n352\t    printf '\\n\\n## Final reason\\n\\n%s\\n' \"${reason:-none}\"\n353\t  } > \"$plan_dir/convergence.md\"\n354\t}\n355\t\n356\talmanac_converge_goal_summary() {\n357\t  printf '%s' \"$1\" | tr '\\n' ' ' | cut -c 1-80\n358\t}\n359\t\n360\talmanac_converge_latest_run_id() {\n361\t  local root=\"$1\"\n362\t  local slug=\"$2\"\n363\t  local rows id type target pid status_rel started status match=\"\"\n364\t\n365\t  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n366\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n367\t    [ -n \"$id\" ] || continue\n368\t    [ \"$type\" = \"converge\" ] || continue\n369\t    [ \"$target\" = \"$slug\" ] || continue\n370\t    match=\"$id\"\n371\t  done <<< \"$rows\"\n372\t\n373\t  [ -n \"$match\" ] || return 1\n374\t  printf '%s\\n' \"$match\"\n375\t}\n376\t\n377\talmanac_converge_worker_health() {\n378\t  local root=\"$1\"\n379\t  local run_id=\"$2\"\n380\t  local status_file status\n381\t\n382\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n383\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"dead\"; return 0; }\n384\t\n385\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n386\t  if [ \"$status\" = \"running\" ] && ! almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n387\t    printf '%s\\n' \"alive\"\n388\t  else\n389\t    printf '%s\\n' \"dead\"\n390\t  fi\n391\t}\n392\t\n393\talmanac_converge_last_verdict_line() {\n394\t  local log_file=\"$1\"\n395\t\n396\t  [ -f \"$log_file\" ] || return 1\n397\t  awk '\n398\t    /^===== tick=/ { verdict = \"\"; reason = \"\" }\n399\t    /^VERDICT: / { verdict = substr($0, 10) }\n400\t    /^REASON: / { reason = substr($0, 9) }\n401\t    END {\n402\t      if (verdict != \"\" || reason != \"\") {\n403\t        printf \"%s\\t%s\\n\", verdict, reason\n404\t      }\n405\t    }\n406\t  ' \"$log_file\"\n407\t}\n408\t\n409\talmanac_converge_last_report_header() {\n410\t  local reports_file=\"$1\"\n411\t\n412\t  [ -f \"$reports_file\" ] || return 1\n413\t  grep -E '^===== tick=[0-9][0-9]* ts=.* =====$' \"$reports_file\" 2>/dev/null | tail -n 1\n414\t}\n415\t\n416\talmanac_converge_goal_mutation_count() {\n417\t  local history_file=\"$1\"\n418\t\n419\t  [ -f \"$history_file\" ] || { printf '%s\\n' \"0\"; return 0; }\n420\t  awk '/^===== tick=[0-9][0-9]* ts=.* overseer=/ { c++ } END { print c + 0 }' \"$history_file\"\n421\t}\n422\t\n423\talmanac_converge_dashboard_frame() {\n424\t  local root=\"$1\"\n425\t  local slug=\"$2\"\n426\t  local plan_dir goal_file reports_file history_file log_file\n427\t  local run_id=\"\" status_file round=\"\" rounds=\"\" health=\"dead\"\n428\t  local verdict=\"none\" reason=\"none\" verdict_line report_header goal_text goal_summary mutations\n429\t  local tab=$'\\t'\n430\t\n431\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n432\t  [ -d \"$plan_dir\" ] || return 1\n433\t\n434\t  goal_file=\"$plan_dir/goal.md\"\n435\t  reports_file=\"$plan_dir/agent-reports.log\"\n436\t  history_file=\"$plan_dir/goal.history.log\"\n437\t  log_file=\"$plan_dir/overseer.log\"\n438\t\n439\t  if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n440\t    status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n441\t    round=\"$(almanac_loop_status_field \"$status_file\" \"round\" 2>/dev/null || true)\"\n442\t    rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" 2>/dev/null || true)\"\n443\t    health=\"$(almanac_converge_worker_health \"$root\" \"$run_id\")\"\n444\t  fi\n445\t  [ -n \"$round\" ] || round=\"0\"\n446\t  [ -n \"$rounds\" ] || rounds=\"?\"\n447\t\n448\t  if verdict_line=\"$(almanac_converge_last_verdict_line \"$log_file\" 2>/dev/null)\"; then\n449\t    verdict=\"${verdict_line%%$tab*}\"\n450\t    reason=\"${verdict_line#*$tab}\"\n451\t    [ \"$reason\" != \"$verdict_line\" ] || reason=\"none\"\n452\t    [ -n \"$verdict\" ] || verdict=\"none\"\n453\t    [ -n \"$reason\" ] || reason=\"none\"\n454\t  fi\n455\t\n456\t  report_header=\"$(almanac_converge_last_report_header \"$reports_file\" 2>/dev/null || true)\"\n457\t  [ -n \"$report_header\" ] || report_header=\"none\"\n458\t\n459\t  goal_text=\"\"\n460\t  [ -f \"$goal_file\" ] && goal_text=\"$(cat \"$goal_file\")\"\n461\t  goal_summary=\"$(almanac_converge_goal_summary \"$goal_text\")\"\n462\t  [ -n \"$goal_summary\" ] || goal_summary=\"none\"\n463\t  mutations=\"$(almanac_converge_goal_mutation_count \"$history_file\")\"\n464\t\n465\t  printf 'converge %s\\n' \"$slug\"\n466\t  printf 'current round: %s/%s\\n' \"$round\" \"$rounds\"\n467\t  printf 'last verdict: %s\\n' \"$verdict\"\n468\t  printf 'reason: %s\\n' \"$reason\"\n469\t  printf 'last report: %s\\n' \"$report_header\"\n470\t  printf 'goal: %s\\n' \"$goal_summary\"\n471\t  printf 'goal mutations: %s\\n' \"$mutations\"\n472\t  printf 'worker health: %s\\n' \"$health\"\n473\t}\n474\t\n475\talmanac_converge_status() {\n476\t  local root=\"$1\"\n477\t  local slug=\"$2\"\n478\t  local frame\n479\t\n480\t  frame=\"$(almanac_converge_dashboard_frame \"$root\" \"$slug\")\" || return 1\n481\t  printf '%s\\n' \"$frame\" | almanac_loop_ui_render\n482\t}\n483\t\n484\talmanac_converge_watch() {\n485\t  local root=\"$1\"\n486\t  local slug=\"$2\"\n487\t  local mode=\"${3:-}\"\n488\t  local interval=\"${CONVERGE_WATCH_INTERVAL:-${ALMANAC_HUB_WATCH_INTERVAL:-2}}\"\n489\t  local run_id status_file status\n490\t\n491\t  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n492\t    almanac_converge_status \"$root\" \"$slug\"\n493\t    return\n494\t  fi\n495\t\n496\t  while :; do\n497\t    almanac_loop_ui_clear\n498\t    almanac_converge_status \"$root\" \"$slug\"\n499\t    if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n500\t      status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n501\t      status=\"$(almanac_loop_status_field \"$status_file\" \"status\" 2>/dev/null || true)\"\n502\t      case \"$status\" in\n503\t        done|failed|aborted) break ;;\n504\t      esac\n505\t    fi\n506\t    sleep \"$interval\"\n507\t  done\n508\t}\n509\t\n510\talmanac_converge_stop() {\n511\t  local root=\"$1\"\n512\t  local slug=\"$2\"\n513\t  local plan_dir root_stop plan_stop\n514\t\n515\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n516\t  [ -d \"$plan_dir\" ] || return 1\n517\t  root_stop=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n518\t  plan_stop=\"$(almanac_loop_run_control_file converge \"$plan_dir\" stop)\"\n519\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$root_stop\"\n520\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$plan_stop\"\n521\t}\n522\t\n523\talmanac_converge_apply_goal_update() {\n524\t  local root=\"$1\"\n525\t  local goal=\"$2\"\n526\t  local round=\"$3\"\n527\t  local provider=\"$4\"\n528\t  local reason=\"$5\"\n529\t  local new_goal=\"$6\"\n530\t  local plan_dir goal_file history_file log_file ts old_goal old_file new_file diff_output diff_status summary\n531\t\n532\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n533\t  goal_file=\"$plan_dir/goal.md\"\n534\t  history_file=\"$plan_dir/goal.history.log\"\n535\t  log_file=\"$plan_dir/overseer.log\"\n536\t  ts=\"$(almanac_loop_now_utc)\"\n537\t  old_goal=\"\"\n538\t  [ -f \"$goal_file\" ] && old_goal=\"$(cat \"$goal_file\")\"\n539\t\n540\t  old_file=\"$plan_dir/.goal.old.$$\"\n541\t  new_file=\"$plan_dir/.goal.new.$$\"\n542\t  printf '%s\\n' \"$old_goal\" > \"$old_file\"\n543\t  printf '%s\\n' \"$new_goal\" > \"$new_file\"\n544\t\n545\t  diff_output=\"\"\n546\t  diff_status=127\n547\t  if command -v diff >/dev/null 2>&1; then\n548\t    if diff_output=\"$(diff -u \"$old_file\" \"$new_file\" 2>/dev/null)\"; then\n549\t      diff_status=0\n550\t    else\n551\t      diff_status=$?\n552\t    fi\n553\t  fi\n554\t\n555\t  {\n556\t    printf '===== tick=%s ts=%s overseer=%s =====\\n' \"$round\" \"$ts\" \"$provider\"\n557\t    printf 'REASON: %s\\n' \"$reason\"\n558\t    if [ \"$diff_status\" -le 1 ]; then\n559\t      printf -- '--- DIFF ---\\n'\n560\t      printf '%s\\n' \"$diff_output\"\n561\t    else\n562\t      printf -- '--- AFTER ---\\n'\n563\t      printf '%s\\n' \"$new_goal\"\n564\t    fi\n565\t  } >> \"$history_file\"\n566\t\n567\t  printf '%s\\n' \"$new_goal\" > \"$goal_file\"\n568\t  rm -f \"$old_file\" \"$new_file\"\n569\t\n570\t  summary=\"$(almanac_converge_goal_summary \"$new_goal\")\"\n571\t  printf '[tick=%s] goal updated: %s\\n' \"$round\" \"$summary\" >> \"$log_file\"\n572\t}\n573\t\n574\talmanac_converge_run_finalize() {\n575\t  local root=\"$1\"\n576\t  local run_id=\"$2\"\n577\t  local status=\"$3\"\n578\t  local reason=\"${4:-}\"\n579\t\n580\t  trap - EXIT INT TERM\n581\t  [ -n \"$run_id\" ] || return 0\n582\t  almanac_loop_mark_run_status \"$root\" \"$run_id\" \"$status\" \"\" \"$reason\" >/dev/null 2>&1 || true\n583\t}\n584\t\n585\talmanac_converge_git_user_status() {\n586\t  local root=\"$1\"\n587\t  local plan_dir=\"$2\"\n588\t  local rel_plan\n589\t\n590\t  git -C \"$root\" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1\n591\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n592\t\n593\t  if [ \"$rel_plan\" = \"$plan_dir\" ]; then\n594\t    git -C \"$root\" status --porcelain -- . ':!.almanac'\n595\t  else\n596\t    git -C \"$root\" status --porcelain -- . ':!.almanac' \":!$rel_plan\"\n597\t  fi\n598\t}\n599\t\n600\talmanac_converge_run_worker() {\n601\t  local root=\"$1\"\n602\t  local goal=\"$2\"\n603\t  local exec_cmd=\"$3\"\n604\t  local round=\"$4\"\n605\t  local provider model effort prompt_file result_file events_file plan_dir slug rc\n606\t\n607\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n608\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n609\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n610\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n611\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n612\t\n613\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-prompt.XXXXXX\")\"\n614\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-result.XXXXXX\")\"\n615\t  # Persistent per-round session log under the plan dir (mirrors ralph's\n616\t  # docs/plans/<name>/ralph-codex-iteration-N.log). The full raw event stream\n617\t  # tees here while the filtered agent-message text streams live to the\n618\t  # terminal — operator sees progress, durable log is kept for forensics.\n619\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n620\t\n621\t  almanac_converge_worker_prompt \"$root\" \"$goal\" \"$exec_cmd\" \"$round\" > \"$prompt_file\"\n622\t\n623\t  _info \"Converge round $round — exec-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n624\t\n625\t  # danger-full-access sandbox: converge runs are autonomous-by-design.\n626\t  # `claude --print` has no human to answer a permission prompt, so anything\n627\t  # less than full access dies on every un-allowlisted Bash call (\"This\n628\t  # command requires approval\"). For codex this drops the sandbox; for claude\n629\t  # it maps to --permission-mode bypassPermissions (per the provider adapter).\n630\t  rc=0\n631\t  almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n632\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr || rc=$?\n633\t\n634\t  rm -f \"$prompt_file\" \"$result_file\"\n635\t  return \"$rc\"\n636\t}\n637\t\n638\t# Prompt-mode round: the user's --prompt text IS the agent invocation. No worker\n639\t# template wrapper — the agent receives the prompt verbatim, prefixed only with\n640\t# a one-shot .converge-steer directive if one is queued. This is the dominant\n641\t# mode for \"run skill X in a convergence loop\" workflows; the loop driver\n642\t# handles the bookkeeping (auto-commit + agent-reports.log entry) after the\n643\t# agent exits, instead of asking the agent to know about CONVERGE conventions.\n644\t#\n645\t# Returns the agent's exit code; commit and report writes are best-effort and\n646\t# never alter the return.\n647\t# List every currently-dirty path in $root, one per line, sorted+deduped.\n648\t# Output is the union of:\n649\t#   - tracked-modified paths (`git diff --name-only HEAD`)\n650\t#   - untracked-not-ignored paths (`git ls-files --others --exclude-standard`)\n651\t# Used by the prompt-mode auto-commit to distinguish PRE-EXISTING dirty work\n652\t# (untouched by the agent) from AGENT-TOUCHED paths (commit candidates). Empty\n653\t# string on git failure or non-repo. Pure read-only — safe to call multiple\n654\t# times per round.\n655\talmanac_converge_dirty_paths() {\n656\t  local root=\"$1\"\n657\t  ( cd \"$root\" \\\n658\t      && { git diff --name-only HEAD 2>/dev/null; \\\n659\t           git ls-files --others --exclude-standard 2>/dev/null; } \\\n660\t      | sort -u\n661\t  )\n662\t}\n663\t\n664\t# Auto-commit ONLY the paths the agent newly touched this round, computed as\n665\t# (dirty-after) - (dirty-before). Pre-existing dirty paths are left alone so a\n666\t# concurrent unrelated edit never gets swept into a CONVERGE commit (the bug\n667\t# that caused commit 4526a58 to misattribute the developer's in-flight edits\n668\t# to the agent). Files that were pre-existing dirty AND also touched by the\n669\t# agent stay dirty — conservative; the agent's change in that file isn't\n670\t# committed by this round, but no false attribution happens. Best-effort:\n671\t# commit failure logs a warn and never alters the caller's return code.\n672\t#\n673\t# Args: ROOT SLUG ROUND PRE_DIRTY (newline-separated pre-existing dirty paths)\n674\talmanac_converge_commit_agent_paths() {\n675\t  local root=\"$1\" slug=\"$2\" round=\"$3\" pre_dirty=\"$4\"\n676\t  local post_dirty agent_paths\n677\t\n678\t  post_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n679\t  # comm needs sorted inputs; both producers (almanac_converge_dirty_paths +\n680\t  # the snapshot taken before the agent ran) emit sorted-unique.\n681\t  agent_paths=\"$(comm -23 <(printf '%s\\n' \"$post_dirty\") <(printf '%s\\n' \"$pre_dirty\") | sed '/^$/d')\"\n682\t\n683\t  if [ -z \"$agent_paths\" ]; then\n684\t    # Either the agent didn't change anything OR every change was on a path\n685\t    # that was already dirty (so the change stays uncommitted on purpose).\n686\t    return 0\n687\t  fi\n688\t\n689\t  # Stage each agent-touched path individually (handles deletions, new files,\n690\t  # and modifications — `git add` accepts paths to files that no longer exist\n691\t  # by recording the deletion).\n692\t  local path failed=0\n693\t  while IFS= read -r path; do\n694\t    [ -n \"$path\" ] || continue\n695\t    (cd \"$root\" && git add -- \"$path\" >/dev/null 2>&1) || failed=1\n696\t  done <<< \"$agent_paths\"\n697\t\n698\t  if [ \"$failed\" -eq 1 ]; then\n699\t    _warn \"Converge round $round: staging one or more agent-touched paths failed (changes left in worktree)\"\n700\t    return 0\n701\t  fi\n702\t\n703\t  if ! (cd \"$root\" \\\n704\t          && git -c user.email=converge@almanac -c user.name=converge \\\n705\t                 commit -m \"CONVERGE($slug): round $round\" --no-verify >/dev/null 2>&1); then\n706\t    _warn \"Converge round $round: auto-commit failed (changes left in worktree)\"\n707\t  fi\n708\t}\n709\t\n710\talmanac_converge_run_worker_prompt() {\n711\t  local root=\"$1\"\n712\t  local goal=\"$2\"\n713\t  local prompt=\"$3\"\n714\t  local round=\"$4\"\n715\t  local provider model effort prompt_file result_file events_file rc\n716\t  local slug plan_dir log_file steer_path ts result_summary\n717\t\n718\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n719\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n720\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n721\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n722\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n723\t  log_file=\"$plan_dir/agent-reports.log\"\n724\t  steer_path=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n725\t\n726\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-prompt.XXXXXX\")\"\n727\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-result.XXXXXX\")\"\n728\t  # Persistent per-round session log under the plan dir (same shape as\n729\t  # exec-mode + ralph's per-iteration logs). Streams live to terminal so the\n730\t  # operator sees the agent working; tees the raw stream here for forensics.\n731\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n732\t\n733\t  # Steer (one-shot): emitted by the overseer in the prior round, consumed and\n734\t  # removed here so the next overseer tick can re-emit if the issue persists.\n735\t  # Steer prefix comes BEFORE the user prompt so a slash command sees the\n736\t  # directive as context before its own work.\n737\t  {\n738\t    if [ -f \"$steer_path\" ]; then\n739\t      printf '# Steer directive (from previous overseer tick):\\n'\n740\t      cat \"$steer_path\"\n741\t      printf '\\n\\n'\n742\t      rm -f \"$steer_path\"\n743\t    fi\n744\t    printf '%s\\n' \"$prompt\"\n745\t  } > \"$prompt_file\"\n746\t\n747\t  _info \"Converge round $round — prompt-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n748\t\n749\t  # Snapshot the dirty worktree BEFORE the agent runs so the auto-commit below\n750\t  # can stage only the paths the agent newly touches — not whatever unrelated\n751\t  # work the operator had in-flight. (Without this snapshot, an earlier `git\n752\t  # add -A` swept up the developer's uncommitted edits and committed them\n753\t  # under the agent's name — bug observed in commit 4526a58.)\n754\t  local pre_dirty\n755\t  pre_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n756\t\n757\t  # danger-full-access: same rationale as exec-mode worker — converge agents\n758\t  # need to run arbitrary shell (tests, git status, lint) the prompt asks for.\n759\t  rc=0\n760\t  (cd \"$root\" && almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n761\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr) || rc=$?\n762\t\n763\t  # Auto-commit only the agent-touched paths. A smart prompt may have committed\n764\t  # itself (worktree clean, nothing to do); a slash command like\n765\t  # /almanac:codebase-improve typically doesn't commit, so the driver does it.\n766\t  # Best-effort: a failed commit logs a warn but never alters the return code —\n767\t  # the agent's work itself succeeded or failed, the commit is bookkeeping.\n768\t  almanac_converge_commit_agent_paths \"$root\" \"$slug\" \"$round\" \"$pre_dirty\"\n769\t\n770\t  # Auto-write a minimal self-report. Format mirrors slice-03's worker block\n771\t  # (===== tick=N ts=ISO mode=prompt exit=N =====) so the overseer's parser\n772\t  # treats it the same. result_summary is the first 500 bytes of the agent's\n773\t  # final message — enough for the overseer to see \"what the agent said it\n774\t  # did\" without dragging the full transcript through the prompt budget.\n775\t  ts=\"$(almanac_loop_now_utc)\"\n776\t  result_summary=\"(no agent output)\"\n777\t  if [ -s \"$result_file\" ]; then\n778\t    result_summary=\"$(head -c 500 \"$result_file\")\"\n779\t  fi\n780\t  {\n781\t    printf '\\n===== tick=%s ts=%s mode=prompt exit=%s =====\\n' \"$round\" \"$ts\" \"$rc\"\n782\t    printf 'summary:\\n'\n783\t    printf '%s\\n' \"$result_summary\"\n784\t    printf 'concerns:\\n(none captured — prompt mode does not enforce structured self-report)\\n'\n785\t    printf 'next:\\n(driven by overseer / next-round prompt)\\n'\n786\t  } >> \"$log_file\"\n787\t\n788\t  # events_file is the persistent per-round session log under the plan dir —\n789\t  # NOT removed here. prompt/result are still scratch.\n790\t  rm -f \"$prompt_file\" \"$result_file\"\n791\t  return \"$rc\"\n792\t}\n793\t\n794\talmanac_converge_run_overseer() {\n795\t  local root=\"$1\"\n796\t  local goal=\"$2\"\n797\t  local round=\"$3\"\n798\t  local provider model effort prompt_file result_file events_file result rc plan_dir log_file ts\n799\t\n800\t  provider=\"$(almanac_converge_role_field \"overseer\" \"provider\")\"\n801\t  model=\"$(almanac_converge_role_field \"overseer\" \"model\")\"\n802\t  effort=\"$(almanac_converge_role_field \"overseer\" \"effort\")\"\n803\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n804\t  log_file=\"$plan_dir/overseer.log\"\n805\t\n806\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-prompt.XXXXXX\")\"\n807\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-result.XXXXXX\")\"\n808\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-events.XXXXXX\")\"\n809\t\n810\t  almanac_converge_overseer_prompt \"$root\" \"$goal\" \"$round\" > \"$prompt_file\"\n811\t\n812\t  rc=0\n813\t  (cd \"$root\" && almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"read-only\" \\\n814\t    \"$prompt_file\" \"$result_file\" \"$events_file\") >/dev/null || rc=$?\n815\t\n816\t  result=\"\"\n817\t  [ -s \"$result_file\" ] && result=\"$(cat \"$result_file\")\"\n818\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n819\t\n820\t  [ \"$rc\" -eq 0 ] || _warn \"Converge overseer tick $round exited $rc; continuing\"\n821\t  almanac_converge_overseer_parse \"$result\"\n822\t\n823\t  ts=\"$(almanac_loop_now_utc)\"\n824\t  {\n825\t    printf '\\n===== tick=%s ts=%s overseer=%s exit=%s =====\\n' \"$round\" \"$ts\" \"$provider\" \"$rc\"\n826\t    printf 'VERDICT: %s\\n' \"$ALMANAC_CONVERGE_VERDICT\"\n827\t    printf 'REASON: %s\\n' \"$ALMANAC_CONVERGE_REASON\"\n828\t    printf 'STEER: %s\\n' \"$ALMANAC_CONVERGE_STEER\"\n829\t    printf 'GOAL_UPDATE: %s\\n' \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n830\t  } >> \"$log_file\"\n831\t\n832\t  if [ \"$ALMANAC_CONVERGE_GOAL_UPDATE\" != \"unchanged\" ]; then\n833\t    almanac_converge_apply_goal_update \"$root\" \"$goal\" \"$round\" \"$provider\" \\\n834\t      \"$ALMANAC_CONVERGE_REASON\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n835\t  fi\n836\t\n837\t  case \"$ALMANAC_CONVERGE_VERDICT\" in\n838\t    CONVERGED|STOP)\n839\t      : > \"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n840\t      ;;\n841\t    STEER)\n842\t      if [ \"$ALMANAC_CONVERGE_STEER\" != \"none\" ]; then\n843\t        printf '%s\\n' \"$ALMANAC_CONVERGE_STEER\" > \"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n844\t      fi\n845\t      ;;\n846\t    CONTINUE) ;;\n847\t  esac\n848\t}\n849\t\n850\talmanac_converge_run() {\n851\t  local root=\"$1\"\n852\t  local goal=\"$2\"\n853\t  local exec_cmd=\"$3\"\n854\t  local rounds=\"${4:-${CONVERGE_ROUND_BUDGET:-10}}\"\n855\t  local no_oversee=\"${5:-0}\"\n856\t  local oversee_every=\"${6:-1}\"\n857\t  local prompt=\"${7:-}\"\n858\t  local slug plan_dir run_id pid exec_rc round started_epoch final_status final_verdict final_reason action_mode\n859\t\n860\t  # Mode dispatch: prompt-mode (agent invocation, dominant) vs exec-mode (shell\n861\t  # command in a wrapping worker, escape hatch). cmd/converge.sh enforces the\n862\t  # mutex; here we just pick a label for run-config + dispatch.\n863\t  if [ -n \"$prompt\" ]; then\n864\t    action_mode=\"prompt\"\n865\t  else\n866\t    action_mode=\"exec\"\n867\t  fi\n868\t\n869\t  case \"$rounds\" in\n870\t    ''|*[!0-9]*) _die \"--rounds must be a positive integer: $rounds\" ;;\n871\t  esac\n872\t  [ \"$rounds\" -ge 1 ] || _die \"--rounds must be at least 1: $rounds\"\n873\t\n874\t  case \"$oversee_every\" in\n875\t    ''|*[!0-9]*) _die \"--oversee-every must be a positive integer: $oversee_every\" ;;\n876\t  esac\n877\t  [ \"$oversee_every\" -ge 1 ] || _die \"--oversee-every must be at least 1: $oversee_every\"\n878\t\n879\t  case \"$no_oversee\" in\n880\t    1|true|yes|on) no_oversee=1 ;;\n881\t    *) no_oversee=0 ;;\n882\t  esac\n883\t\n884\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n885\t  pid=\"${BASHPID:-$$}\"\n886\t  started_epoch=\"$(date +%s)\"\n887\t  run_id=\"$(almanac_loop_register_run \"$root\" \"converge\" \"$slug\" \"$pid\")\" \\\n888\t    || _die \"Could not register converge run\"\n889\t\n890\t  local _converge_run_finalize_cmd\n891\t  printf -v _converge_run_finalize_cmd 'almanac_converge_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n892\t  trap \"${_converge_run_finalize_cmd}; exit 130\" INT TERM\n893\t  trap \"${_converge_run_finalize_cmd}\" EXIT\n894\t\n895\t  almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n896\t    \"rounds=$rounds\" \\\n897\t    \"oversee=$([ \"$no_oversee\" -eq 1 ] && printf off || printf 'every-%s' \"$oversee_every\")\" \\\n898\t    >/dev/null 2>&1 || true\n899\t\n900\t  almanac_converge_scaffold \"$root\" \"$goal\"\n901\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n902\t\n903\t  final_status=\"done\"\n904\t  if [ \"$no_oversee\" -eq 1 ]; then\n905\t    final_verdict=\"NO_OVERSEE\"\n906\t    final_reason=\"overseer disabled; round budget exhausted\"\n907\t  else\n908\t    final_verdict=\"CONTINUE\"\n909\t    final_reason=\"round budget exhausted\"\n910\t  fi\n911\t\n912\t  local _converge_stop_file\n913\t  _converge_stop_file=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n914\t\n915\t  round=0\n916\t  while [ \"$round\" -lt \"$rounds\" ]; do\n917\t    if [ -f \"$_converge_stop_file\" ]; then\n918\t      final_status=\"aborted\"\n919\t      final_verdict=\"STOP\"\n920\t      final_reason=\"stop signal present before round $((round + 1))\"\n921\t      break\n922\t    fi\n923\t\n924\t    round=$((round + 1))\n925\t    case \"$action_mode\" in\n926\t      prompt)\n927\t        if almanac_converge_run_worker_prompt \"$root\" \"$goal\" \"$prompt\" \"$round\"; then\n928\t          exec_rc=0\n929\t        else\n930\t          exec_rc=$?\n931\t        fi\n932\t        ;;\n933\t      *)\n934\t        if (cd \"$root\" && almanac_converge_run_worker \"$root\" \"$goal\" \"$exec_cmd\" \"$round\"); then\n935\t          exec_rc=0\n936\t        else\n937\t          exec_rc=$?\n938\t        fi\n939\t        ;;\n940\t    esac\n941\t\n942\t    # In exec-mode the worker is authoritative for commits (slice 03 contract).\n943\t    # In prompt-mode the driver already attempted the auto-commit inside the\n944\t    # worker function and will have warned on failure, so the check is skipped\n945\t    # to avoid a duplicate / misleading \"driver will not commit\" message.\n946\t    if [ \"$action_mode\" = \"exec\" ] \\\n947\t       && [ -n \"$(almanac_converge_git_user_status \"$root\" \"$plan_dir\" 2>/dev/null || true)\" ]; then\n948\t      _warn \"Converge round $round: worker left uncommitted changes; driver will not commit\"\n949\t    fi\n950\t\n951\t    if [ \"$exec_rc\" -ne 0 ]; then\n952\t      if [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n953\t        _warn \"Converge round $round exec exited $exec_rc; stopping\"\n954\t      else\n955\t        _warn \"Converge round $round exec exited $exec_rc; continuing\"\n956\t      fi\n957\t    fi\n958\t\n959\t    almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \"goal=$slug\" >/dev/null 2>&1 || true\n960\t\n961\t    if [ \"$exec_rc\" -ne 0 ] && [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n962\t      almanac_converge_write_convergence \"$root\" \"$goal\" \"FAILED\" \"$round\" \"$started_epoch\" \"exec exit=$exec_rc round=$round\"\n963\t      almanac_converge_run_finalize \"$root\" \"$run_id\" \"failed\" \"exec exit=$exec_rc round=$round\"\n964\t      return \"$exec_rc\"\n965\t    fi\n966\t\n967\t    if [ \"$no_oversee\" -eq 0 ] && [ $((round % oversee_every)) -eq 0 ]; then\n968\t      almanac_converge_run_overseer \"$root\" \"$goal\" \"$round\"\n969\t      final_verdict=\"$ALMANAC_CONVERGE_VERDICT\"\n970\t      final_reason=\"$ALMANAC_CONVERGE_REASON\"\n971\t      case \"$ALMANAC_CONVERGE_VERDICT\" in\n972\t        CONVERGED)\n973\t          final_status=\"done\"\n974\t          break\n975\t          ;;\n976\t        STOP)\n977\t          final_status=\"aborted\"\n978\t          break\n979\t          ;;\n980\t      esac\n981\t    fi\n982\t  done\n983\t\n984\t  almanac_converge_write_convergence \"$root\" \"$goal\" \"$final_verdict\" \"$round\" \"$started_epoch\" \"$final_reason\"\n985\t  almanac_converge_run_finalize \"$root\" \"$run_id\" \"$final_status\"\n986\t}\n987\t"}]},"parent_tool_use_id":"toolu_019Kz3RBNz6eX2dXbntAP8pD","session_id":"19