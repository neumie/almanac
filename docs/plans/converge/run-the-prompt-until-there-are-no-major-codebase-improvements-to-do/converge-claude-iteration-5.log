{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XGMJ7N85dd1dy3vyZeLS1C","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# run.sh — the run registry: the run-status record, registry, control, worker\n3\t# health, and the hub's read views, owned in one module (per CONTEXT.md's module\n4\t# map). loop-core.sh (the old god-module) is deleted; this is where its registry/\n5\t# control/worker-health/hub-view concerns now live (the worker orchestration /\n6\t# background fan-out lives in lib/worker.sh).\n7\t#\n8\t# A run-status *record* is a per-run status.tsv — one `key<TAB>value` line per\n9\t# field. This module owns the CANONICAL FIELD LIST and the only set/get-by-name\n10\t# accessors for it, so the run-status contract — every run (ralph or harden)\n11\t# carries exactly this key set, in this order — is enforced *by construction*:\n12\t# a caller names only the fields it has values for; the record fills in the rest,\n13\t# and no writer ever enumerates the schema by hand.\n14\t#\n15\t# No lib/core.sh dependency (uses only printf/read/awk/etc), so the record +\n16\t# registry are their own test surface — tests/test-run.sh sources this file\n17\t# directly. The hub read-views compose the gum-or-plain UI seam (lib/ui.sh) and\n18\t# the per-run control dispatches each loop's signal files through its adapter\n19\t# (lib/loops.sh), so source those two idempotently — they are self-contained\n20\t# (no core.sh) too. pwd -P resolves the install symlink so the siblings are found\n21\t# from either path.\n22\tif ! declare -F almanac_loop_ui_render >/dev/null 2>&1; then\n23\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t  # shellcheck source=lib/ui.sh\n25\t  source \"$__run_dir/ui.sh\"\n26\t  unset __run_dir\n27\tfi\n28\t\n29\tif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n30\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n31\t  # shellcheck source=lib/loops.sh\n32\t  source \"$__run_dir/loops.sh\"\n33\t  unset __run_dir\n34\tfi\n35\t\n36\t# THE single source of truth for the run-status schema: the canonical field list\n37\t# in write order. record_set iterates exactly this list, so every record carries\n38\t# the same keys regardless of which subset a caller supplies. The first seven are\n39\t# also the registry's index.tsv columns (the lightweight list pointer); the last\n40\t# three (finished_at/round/summary) are the per-run detail the index omits.\n41\talmanac_loop_record_fields() {\n42\t  printf '%s\\n' \\\n43\t    id type target pid status_file started_at status finished_at round summary failure_reason \\\n44\t    provider model effort iterations oversee lenses rounds queue_progress\n45\t}\n46\t\n47\t# Get one field from a record FILE by name. Prints the value (which may itself\n48\t# contain tabs — reassembled from the trailing columns) and returns 0; returns 1\n49\t# when the field is absent. This is the generic tab-field reader for the run\n50\t# registry; almanac_loop_status_field (below) is a thin alias over it for the\n51\t# worker-status and hub read paths.\n52\talmanac_loop_record_get() {\n53\t  local file=\"$1\" wanted=\"$2\" key value rest\n54\t\n55\t  while IFS=$'\\t' read -r key value rest; do\n56\t    if [ \"$key\" = \"$wanted\" ]; then\n57\t      if [ -n \"${rest:-}\" ]; then\n58\t        value=\"${value}\"$'\\t'\"${rest}\"\n59\t      fi\n60\t      printf '%s\\n' \"$value\"\n61\t      return 0\n62\t    fi\n63\t  done < \"$file\"\n64\t\n65\t  return 1\n66\t}\n67\t\n68\t# Generic TSV record engine: rewrite FILE with the schema in FIELDS_TEXT, in\n69\t# canonical order, with each (existing) field preserved unless overridden by a\n70\t# `field=value` PAIR. This is the deep module that owns the round-trip algorithm\n71\t# — schema-specific wrappers (record_set for run-status, worker_record_set for\n72\t# worker-status) just supply their own field list. Returns 2 on a missing file\n73\t# argument or a pair whose field isn't in FIELDS_TEXT.\n74\talmanac_loop_tsv_record_set() {\n75\t  local fields_text=\"$1\" file=\"$2\"\n76\t  shift 2 || return 2\n77\t  [ -n \"$file\" ] || return 2\n78\t\n79\t  local pair pfield field cur val out=\"\"\n80\t  local have_file=0\n81\t  if [ -f \"$file\" ]; then\n82\t    have_file=1\n83\t  fi\n84\t\n85\t  for pair in \"$@\"; do\n86\t    pfield=\"${pair%%=*}\"\n87\t    almanac_loop_tsv_has_field \"$fields_text\" \"$pfield\" || return 2\n88\t  done\n89\t\n90\t  while IFS= read -r field; do\n91\t    [ -n \"$field\" ] || continue\n92\t    cur=\"\"\n93\t    if [ \"$have_file\" = 1 ]; then\n94\t      cur=\"$(almanac_loop_record_get \"$file\" \"$field\" || true)\"\n95\t    fi\n96\t    val=\"$cur\"\n97\t    for pair in \"$@\"; do\n98\t      pfield=\"${pair%%=*}\"\n99\t      if [ \"$pfield\" = \"$field\" ]; then\n100\t        val=\"${pair#*=}\"\n101\t      fi\n102\t    done\n103\t    out=\"${out}${field}\"$'\\t'\"${val}\"$'\\n'\n104\t  done <<< \"$fields_text\"\n105\t\n106\t  printf '%s' \"$out\" > \"$file\"\n107\t}\n108\t\n109\t# True when NAME appears as a field in FIELDS_TEXT (newline-separated schema).\n110\talmanac_loop_tsv_has_field() {\n111\t  local fields_text=\"$1\" wanted=\"$2\" field\n112\t  while IFS= read -r field; do\n113\t    [ \"$field\" = \"$wanted\" ] && return 0\n114\t  done <<< \"$fields_text\"\n115\t  return 1\n116\t}\n117\t\n118\t# True when NAME is a canonical run-status field. Lets record_set reject a typo\n119\t# rather than silently writing a key no reader ever looks for.\n120\talmanac_loop_record_has_field() {\n121\t  almanac_loop_tsv_has_field \"$(almanac_loop_record_fields)\" \"$1\"\n122\t}\n123\t\n124\t# Set one or more run-status fields by name, round-tripping the rest. Each\n125\t# argument is a `field=value` pair (the value may itself contain `=`). The record\n126\t# is rewritten with the FULL canonical key set in canonical order: every\n127\t# canonical field already in the file is preserved unless overridden, and a\n128\t# not-yet-existing file is initialised with every key (blank where unset). So\n129\t# `register` seeds the record by naming only its known fields, while\n130\t# `mark`/`update` change only theirs and leave the rest intact — no caller\n131\t# enumerates the schema. Returns 2 on a missing file argument or a `field=value`\n132\t# whose field is not canonical.\n133\talmanac_loop_record_set() {\n134\t  almanac_loop_tsv_record_set \"$(almanac_loop_record_fields)\" \"$@\"\n135\t}\n136\t\n137\talmanac_loop_slug() {\n138\t  local raw=\"$1\"\n139\t  local slug\n140\t\n141\t  slug=\"$(printf '%s' \"$raw\" \\\n142\t    | tr '[:upper:]' '[:lower:]' \\\n143\t    | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')\"\n144\t\n145\t  if [ -z \"$slug\" ]; then\n146\t    slug=\"run\"\n147\t  fi\n148\t\n149\t  printf '%s\\n' \"$slug\"\n150\t}"}]},"parent_tool_use_id":null,"session_id":"19c2339b-02f8-4b81-9b44-59452ec22e33","uuid":"5137b9d6-ae00-4e80-a0cf-7148708ad445","timestamp":"2026-05-26T18:16:39.408Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/run.sh","content":"#!/usr/bin/env bash\n# run.sh — the run registry: the run-status record, registry, control, worker\n# health, and the hub's read views, owned in one module (per CONTEXT.md's module\n# map). loop-core.sh (the old god-module) is deleted; this is where its registry/\n# control/worker-health/hub-view concerns now live (the worker orchestration /\n# background fan-out lives in lib/worker.sh).\n#\n# A run-status *record* is a per-run status.tsv — one `key<TAB>value` line per\n# field. This module owns the CANONICAL FIELD LIST and the only set/get-by-name\n# accessors for it, so the run-status contract — every run (ralph or harden)\n# carries exactly this key set, in this order — is enforced *by construction*:\n# a caller names only the fields it has values for; the record fills in the rest,\n# and no writer ever enumerates the schema by hand.\n#\n# No lib/core.sh dependency (uses only printf/read/awk/etc), so the record +\n# registry are their own test surface — tests/test-run.sh sources this file\n# directly. The hub read-views compose the gum-or-plain UI seam (lib/ui.sh) and\n# the per-run control dispatches each loop's signal files through its adapter\n# (lib/loops.sh), so source those two idempotently — they are self-contained\n# (no core.sh) too. pwd -P resolves the install symlink so the siblings are found\n# from either path.\nif ! declare -F almanac_loop_ui_render >/dev/null 2>&1; then\n  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/ui.sh\n  source \"$__run_dir/ui.sh\"\n  unset __run_dir\nfi\n\nif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/loops.sh\n  source \"$__run_dir/loops.sh\"\n  unset __run_dir\nfi\n\n# THE single source of truth for the run-status schema: the canonical field list\n# in write order. record_set iterates exactly this list, so every record carries\n# the same keys regardless of which subset a caller supplies. The first seven are\n# also the registry's index.tsv columns (the lightweight list pointer); the last\n# three (finished_at/round/summary) are the per-run detail the index omits.\nalmanac_loop_record_fields() {\n  printf '%s\\n' \\\n    id type target pid status_file started_at status finished_at round summary failure_reason \\\n    provider model effort iterations oversee lenses rounds queue_progress\n}\n\n# Get one field from a record FILE by name. Prints the value (which may itself\n# contain tabs — reassembled from the trailing columns) and returns 0; returns 1\n# when the field is absent. This is the generic tab-field reader for the run\n# registry; almanac_loop_status_field (below) is a thin alias over it for the\n# worker-status and hub read paths.\nalmanac_loop_record_get() {\n  local file=\"$1\" wanted=\"$2\" key value rest\n\n  while IFS=$'\\t' read -r key value rest; do\n    if [ \"$key\" = \"$wanted\" ]; then\n      if [ -n \"${rest:-}\" ]; then\n        value=\"${value}\"$'\\t'\"${rest}\"\n      fi\n      printf '%s\\n' \"$value\"\n      return 0\n    fi\n  done < \"$file\"\n\n  return 1\n}\n\n# Generic TSV record engine: rewrite FILE with the schema in FIELDS_TEXT, in\n# canonical order, with each (existing) field preserved unless overridden by a\n# `field=value` PAIR. This is the deep module that owns the round-trip algorithm\n# — schema-specific wrappers (record_set for run-status, worker_record_set for\n# worker-status) just supply their own field list. Returns 2 on a missing file\n# argument or a pair whose field isn't in FIELDS_TEXT.\nalmanac_loop_tsv_record_set() {\n  local fields_text=\"$1\" file=\"$2\"\n  shift 2 || return 2\n  [ -n \"$file\" ] || return 2\n\n  local pair pfield field cur val out=\"\"\n  local have_file=0\n  if [ -f \"$file\" ]; then\n    have_file=1\n  fi\n\n  for pair in \"$@\"; do\n    pfield=\"${pair%%=*}\"\n    almanac_loop_tsv_has_field \"$fields_text\" \"$pfield\" || return 2\n  done\n\n  while IFS= read -r field; do\n    [ -n \"$field\" ] || continue\n    cur=\"\"\n    if [ \"$have_file\" = 1 ]; then\n      cur=\"$(almanac_loop_record_get \"$file\" \"$field\" || true)\"\n    fi\n    val=\"$cur\"\n    for pair in \"$@\"; do\n      pfield=\"${pair%%=*}\"\n      if [ \"$pfield\" = \"$field\" ]; then\n        val=\"${pair#*=}\"\n      fi\n    done\n    out=\"${out}${field}\"$'\\t'\"${val}\"$'\\n'\n  done <<< \"$fields_text\"\n\n  printf '%s' \"$out\" > \"$file\"\n}\n\n# True when NAME appears as a field in FIELDS_TEXT (newline-separated schema).\nalmanac_loop_tsv_has_field() {\n  local fields_text=\"$1\" wanted=\"$2\" field\n  while IFS= read -r field; do\n    [ \"$field\" = \"$wanted\" ] && return 0\n  done <<< \"$fields_text\"\n  return 1\n}\n\n# True when NAME is a canonical run-status field. Lets record_set reject a typo\n# rather than silently writing a key no reader ever looks for.\nalmanac_loop_record_has_field() {\n  almanac_loop_tsv_has_field \"$(almanac_loop_record_fields)\" \"$1\"\n}\n\n# Set one or more run-status fields by name, round-tripping the rest. Each\n# argument is a `field=value` pair (the value may itself contain `=`). The record\n# is rewritten with the FULL canonical key set in canonical order: every\n# canonical field already in the file is preserved unless overridden, and a\n# not-yet-existing file is initialised with every key (blank where unset). So\n# `register` seeds the record by naming only its known fields, while\n# `mark`/`update` change only theirs and leave the rest intact — no caller\n# enumerates the schema. Returns 2 on a missing file argument or a `field=value`\n# whose field is not canonical.\nalmanac_loop_record_set() {\n  almanac_loop_tsv_record_set \"$(almanac_loop_record_fields)\" \"$@\"\n}\n\nalmanac_loop_slug() {\n  local raw=\"$1\"\n  local slug\n\n  slug=\"$(printf '%s' \"$raw\" \\\n    | tr '[:upper:]' '[:lower:]' \\\n    | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')\"\n\n  if [ -z \"$slug\" ]; then\n    slug=\"run\"\n  fi\n\n  printf '%s\\n' \"$slug\"\n}","numLines":150,"startLine":1,"totalLines":1043}}}
