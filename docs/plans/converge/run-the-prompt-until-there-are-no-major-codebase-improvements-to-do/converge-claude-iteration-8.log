numeric + hyphens)\" >&2\n49\t      errors=$((errors + 1))\n50\t    fi\n51\t    if echo \"$name\" | grep -q '\\-\\-'; then\n52\t      echo \"FAIL: name '$name' contains consecutive hyphens\" >&2\n53\t      errors=$((errors + 1))\n54\t    fi\n55\t    # Name must match directory name\n56\t    local dir_name\n57\t    dir_name=$(basename \"$skill_dir\")\n58\t    if [ \"$name\" != \"$dir_name\" ]; then\n59\t      echo \"FAIL: name '$name' does not match directory '$dir_name'\" >&2\n60\t      errors=$((errors + 1))\n61\t    fi\n62\t  fi\n63\t\n64\t  # --- Required: description field ---\n65\t  # Description may span multiple lines (YAML multiline), extract the full value\n66\t  local description\n67\t  description=$(echo \"$frontmatter\" | awk '\n68\t    /^description:/ {\n69\t      sub(/^description:[[:space:]]*/, \"\")\n70\t      desc = $0\n71\t      next\n72\t    }\n73\t    desc != \"\" && /^[[:space:]]/ {\n74\t      sub(/^[[:space:]]+/, \" \")\n75\t      desc = desc $0\n76\t      next\n77\t    }\n78\t    desc != \"\" && /^[a-z]/ { exit }\n79\t    END { print desc }\n80\t  ')\n81\t  if [ -z \"$description\" ]; then\n82\t    echo \"FAIL: SKILL.md in $skill_dir missing 'description' field\" >&2\n83\t    errors=$((errors + 1))\n84\t  else\n85\t    local desc_len=${#description}\n86\t    if [ \"$desc_len\" -gt 1024 ]; then\n87\t      echo \"FAIL: description exceeds 1024 characters ($desc_len)\" >&2\n88\t      errors=$((errors + 1))\n89\t    fi\n90\t    # Cap at 220 chars to keep aggregated skills listing compact (token budget)\n91\t    if [ \"$desc_len\" -gt 220 ]; then\n92\t      echo \"FAIL: description exceeds 220 characters ($desc_len) in $skill_dir — keep terse, drop redundant 'Use this whenever the user says...' restatements\" >&2\n93\t      errors=$((errors + 1))\n94\t    fi\n95\t    # Must start with \"Use when\" — agents under-trigger without an explicit\n96\t    # trigger up front (project convention). Strip a leading YAML quote first,\n97\t    # since descriptions may be quoted (description: \"Use when ...\").\n98\t    local desc_text=\"$description\"\n99\t    desc_text=\"${desc_text#\\\"}\"\n100\t    desc_text=\"${desc_text#\\'}\"\n101\t    case \"$desc_text\" in\n102\t      \"Use when\"*) : ;;\n103\t      *)\n104\t        echo \"FAIL: description must start with 'Use when' in $skill_dir — state the trigger explicitly\" >&2\n105\t        errors=$((errors + 1))\n106\t        ;;\n107\t    esac\n108\t  fi\n109\t\n110\t  # --- Frontmatter size check ---\n111\t  local fm_size\n112\t  fm_size=$(echo \"$frontmatter\" | wc -c | tr -d ' ')\n113\t  if [ \"$fm_size\" -gt 1024 ]; then\n114\t    echo \"WARN: frontmatter exceeds 1024 characters ($fm_size)\" >&2\n115\t    warnings=$((warnings + 1))\n116\t  fi\n117\t\n118\t  # --- Optional: compatibility length ---\n119\t  local compat\n120\t  compat=$(echo \"$frontmatter\" | grep '^compatibility:' | head -1 | sed 's/^compatibility:[[:space:]]*//')\n121\t  if [ -n \"$compat\" ]; then\n122\t    local compat_len=${#compat}\n123\t    if [ \"$compat_len\" -gt 500 ]; then\n124\t      echo \"WARN: compatibility exceeds 500 characters ($compat_len)\" >&2\n125\t      warnings=$((warnings + 1))\n126\t    fi\n127\t  fi\n128\t\n129\t  # --- Line count recommendation ---\n130\t  local line_count\n131\t  line_count=$(wc -l < \"$skill_file\" | tr -d ' ')\n132\t  if [ \"$line_count\" -gt 500 ]; then\n133\t    echo \"WARN: SKILL.md has $line_count lines (recommended: under 500)\" >&2\n134\t    warnings=$((warnings + 1))\n135\t  fi\n136\t\n137\t  # --- Optional: metadata.dependencies validation ---\n138\t  # Resolve each dependency by name across the whole skills tree.\n139\t  local in_deps=0\n140\t  while IFS= read -r line; do\n141\t    if echo \"$line\" | grep -qE '^[[:space:]]+dependencies:'; then\n142\t      in_deps=1\n143\t      continue\n144\t    fi\n145\t    if [ \"$in_deps\" -eq 1 ]; then\n146\t      if echo \"$line\" | grep -qE '^[[:space:]]+-[[:space:]]'; then\n147\t        local dep\n148\t   