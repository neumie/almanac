{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BtZPpGE2iWeBuKhUKyNJqe","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/harden.sh — the harden loop adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about how to launch and\n5\t# control the harden loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n6\t#\n7\t# Contract (called as almanac_loop_harden_<verb>):\n8\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n9\t#                   dispatch (no central case-statement on loop type).\n10\t#   launch_usage  — the --help text printed for this loop's launcher.\n11\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n12\t#                   for a given target/rounds. Harden's runner runs through the\n13\t#                   CLI (`almanac harden <target> --loop`).\n14\t#   new_run_argv  — emit the hub's \"new run\" launcher argv (one token per line)\n15\t#                   from key=val pairs; reviewer/role config rides on env, not\n16\t#                   argv (see new_run_env).\n17\t#   new_run_env   — emit KEY=VALUE env lines for the reviewer/role config\n18\t#                   (HARDEN_LENSES/PROVIDER/MODEL/EFFORT) so the hub never has\n19\t#                   to know harden's env prefixes.\n20\t#\n21\t# Control contract (signal_file) inherits the default `.harden-stop` /\n22\t# `.harden-steer` convention from lib/loops.sh — no adapter override needed.\n23\t#\n24\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n25\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n26\t# and the shared UI / provider seams. The launcher sources those before\n27\t# dispatching, so the adapter need not source them itself.\n28\t\n29\t# Build harden's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n30\t# it). harden has no standalone runner script — its convergence loop runs through\n31\t# the CLI (`almanac harden <target> --loop [--rounds N]`), so the adapter yields\n32\t# that bin/almanac invocation. The reviewer/role config rides on environment\n33\t# exported by the launcher, not argv. Requires $ALMANAC_HOME (set by every entry\n34\t# point).\n35\talmanac_loop_harden_exec_argv() {\n36\t  local target=\"$1\" rounds=\"${2:-}\"\n37\t  _ALMANAC_LOOP_ARGV=(bash \"$ALMANAC_HOME/bin/almanac\" harden \"$target\" --loop)\n38\t  [ -n \"$rounds\" ] && _ALMANAC_LOOP_ARGV+=(--rounds \"$rounds\")\n39\t  return 0\n40\t}\n41\t\n42\t# Interactive config + exec for the harden loop. Parses native flags, prompts\n43\t# for any missing field, exports the role-config env, and execs the runner via\n44\t# the exec_argv verb. Called by lib/loop-launcher.sh's adapter dispatch — no\n45\t# central code branches on loop type.\n46\talmanac_loop_harden_launch() {\n47\t  local target=\"\" lenses=\"\" provider=\"\" model=\"\" effort=\"\" rounds=\"\" yes=\"\"\n48\t  while [ \"$#\" -gt 0 ]; do\n49\t    case \"$1\" in\n50\t      --lenses)   shift; lenses=\"${1:-}\";   [ -n \"$lenses\" ] || _die \"--lenses requires a value\" ;;\n51\t      --provider) shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n52\t      --model)    shift; model=\"${1:-}\";    [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n53\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n54\t      --rounds)   shift; rounds=\"${1:-}\";   [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n55\t      --yes|-y) yes=1 ;;\n56\t      --help|-h) almanac_loop_harden_launch_usage; return 0 ;;\n57\t      -*) _die \"Unknown harden launch option: $1\" ;;\n58\t      *)  [ -z \"$target\" ] && target=\"$1\" || _die \"Unexpected harden argument: $1\" ;;\n59\t    esac\n60\t    shift\n61\t  done\n62\t\n63\t  [ -n \"$target\" ] || target=\"$(almanac_loop_ui_input \"Target (file /