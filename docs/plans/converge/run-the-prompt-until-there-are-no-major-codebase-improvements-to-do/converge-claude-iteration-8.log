{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RtoFCuXZBfixuM7oiPCQt5","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# almanac-core.sh — Shared utilities for almanac\n3\t\n4\t# Resolve the almanac root directory\n5\talmanac_root() {\n6\t  cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd\n7\t}\n8\t\n9\t# Check if a skill directory has a valid SKILL.md\n10\t# Validates against the Agent Skills Open Standard (agentskills.io/specification)\n11\talmanac_validate_skill() {\n12\t  local skill_dir=\"$1\"\n13\t  local skill_file=\"$skill_dir/SKILL.md\"\n14\t  local errors=0\n15\t  local warnings=0\n16\t\n17\t  if [ ! -f \"$skill_file\" ]; then\n18\t    echo \"FAIL: missing SKILL.md in $skill_dir\" >&2\n19\t    return 1\n20\t  fi\n21\t\n22\t  # Check for YAML frontmatter\n23\t  local first_line\n24\t  first_line=$(head -1 \"$skill_file\")\n25\t  if [ \"$first_line\" != \"---\" ]; then\n26\t    echo \"FAIL: SKILL.md in $skill_dir missing YAML frontmatter\" >&2\n27\t    return 1\n28\t  fi\n29\t\n30\t  # Extract frontmatter (content between first and second ---)\n31\t  local frontmatter\n32\t  frontmatter=$(awk 'BEGIN{f=0} /^---$/{f++; next} f==1{print} f>=2{exit}' \"$skill_file\")\n33\t\n34\t  # --- Required: name field ---\n35\t  local name\n36\t  name=$(echo \"$frontmatter\" | grep '^name:' | head -1 | sed 's/^name:[[:space:]]*//')\n37\t  if [ -z \"$name\" ]; then\n38\t    echo \"FAIL: SKILL.md in $skill_dir missing 'name' field\" >&2\n39\t    errors=$((errors + 1))\n40\t  else\n41\t    # Name format: 1-64 chars, lowercase alphanumeric + hyphens, no leading/trailing/consecutive hyphens\n42\t    local name_len=${#name}\n43\t    if [ \"$name_len\" -gt 64 ]; then\n44\t      echo \"FAIL: name '$name' exceeds 64 characters ($name_len)\" >&2\n45\t      errors=$((errors + 1))\n46\t    fi\n47\t    if ! echo \"$name\" | grep -qE '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'; then\n48\t      echo \"FAIL: name '$name' invalid format (must be lowercase alphanumeric + hyphens)\" >&2\n49\t      errors=$((errors + 1))\n50\t    fi\n51\t    if echo \"$name\" | grep -q '\\-\\-'; then\n52\t      echo \"FAIL: name '$name' contains consecutive hyphens\" >&2\n53\t      errors=$((errors + 1))\n54\t    fi\n55\t    # Name must match directory name\n56\t    local dir_name\n57\t    dir_name=$(basename \"$skill_dir\")\n58\t    if [ \"$name\" != \"$dir_name\" ]; then\n59\t      echo \"FAIL: name '$name' does not match directory '$dir_name'\" >&2\n60\t      errors=$((errors + 1))\n61\t    fi\n62\t  fi\n63\t\n64\t  # --- Required: description field ---\n65\t  # Description may span multiple lines (YAML multiline), extract the full value\n66\t  local description\n67\t  description=$(echo \"$frontmatter\" | awk '\n68\t    /^description:/ {\n69\t      sub(/^description:[[:space:]]*/, \"\")\n70\t      desc = $0\n71\t      next\n72\t    }\n73\t    desc != \"\" && /^[[:space:]]/ {\n74\t      sub(/^[[:space:]]+/, \" \")\n75\t      desc = desc $0\n76\t      next\n77\t    }\n78\t    desc != \"\" && /^[a-z]/ { exit }\n79\t    END { print desc }\n80\t  ')\n81\t  if [ -z \"$description\" ]; then\n82\t    echo \"FAIL: SKILL.md in $skill_dir missing 'description' field\" >&2\n83\t    errors=$((errors + 1))\n84\t  else\n85\t    local desc_len=${#description}\n86\t    if [ \"$desc_len\" -gt 1024 ]; then\n87\t      echo \"FAIL: description exceeds 1024 characters ($desc_len)\" >&2\n88\t      errors=$((errors + 1))\n89\t    fi\n90\t    # Cap at 220 chars to keep aggregated skills listing compact (token budget)\n91\t    if [ \"$desc_len\" -gt 220 ]; then\n92\t      echo \"FAIL: description exceeds 220 characters ($desc_len) in $skill_dir — keep terse, drop redundant 'Use this whenever the user says...' restatements\" >&2\n93\t      errors=$((errors + 1))\n94\t    fi\n95\t    # Must start with \"Use when\" — agents under-trigger without an explicit\n96\t    # trigger up front (project convention). Strip a leading YAML quote first,\n97\t    # since descriptions may be quoted (description: \"Use when ...\").\n98\t    local desc_text=\"$description\"\n99\t    desc_text=\"${desc_text#\\\"}\"\n100\t    desc_text=\"${desc_text#\\'}\"\n101\t    case \"$desc_text\" in\n102\t      \"Use when\"*) : ;;\n103\t      *)\n104\t        echo \"FAIL: description must start with 'Use when' in $skill_dir — state the trigger explicitly\" >&2\n105\t        errors=$((errors + 1))\n106\t        ;;\n107\t    esac\n108\t  fi\n109\t\n110\t  # --- Frontmatter size check ---\n111\t  local fm_size\n112\t  fm_size=$(echo \"$frontmatter\" | wc -c | tr -d ' ')\n113\t  if [ \"$fm_size\" -gt 1024 ]; then\n114\t    echo \"WARN: frontmatter exceeds 1024 characters ($fm_size)\" >&2\n115\t    warnings=$((warnings + 1))\n116\t  fi\n117\t\n118\t  # --- Optional: compatibility length ---\n119\t  local compat\n120\t  compat=$(echo \"$frontmatter\" | grep '^compatibility:' | head -1 | sed 's/^compatibility:[[:space:]]*//')\n121\t  if [ -n \"$compat\" ]; then\n122\t    local compat_len=${#compat}\n123\t    if [ \"$compat_len\" -gt 500 ]; then\n124\t      echo \"WARN: compatibility exceeds 500 characters ($compat_len)\" >&2\n125\t      warnings=$((warnings + 1))\n126\t    fi\n127\t  fi\n128\t\n129\t  # --- Line count recommendation ---\n130\t  local line_count\n131\t  line_count=$(wc -l < \"$skill_file\" | tr -d ' ')\n132\t  if [ \"$line_count\" -gt 500 ]; then\n133\t    echo \"WARN: SKILL.md has $line_count lines (recommended: under 500)\" >&2\n134\t    warnings=$((warnings + 1))\n135\t  fi\n136\t\n137\t  # --- Optional: metadata.dependencies validation ---\n138\t  # Resolve each dependency by name across the whole skills tree.\n139\t  local in_deps=0\n140\t  while IFS= read -r line; do\n141\t    if echo \"$line\" | grep -qE '^[[:space:]]+dependencies:'; then\n142\t      in_deps=1\n143\t      continue\n144\t    fi\n145\t    if [ \"$in_deps\" -eq 1 ]; then\n146\t      if echo \"$line\" | grep -qE '^[[:space:]]+-[[:space:]]'; then\n147\t        local dep\n148\t        dep=$(echo \"$line\" | sed 's/^[[:space:]]*-[[:space:]]*//')\n149\t        if [ -z \"$(almanac_find_skill \"$dep\")\" ]; then\n150\t          echo \"FAIL: dependency '$dep' not found (required by $(basename \"$skill_dir\"))\" >&2\n151\t          errors=$((errors + 1))\n152\t        fi\n153\t      else\n154\t        in_deps=0\n155\t      fi\n156\t    fi\n157\t  done <<< \"$frontmatter\"\n158\t\n159\t  [ \"$errors\" -eq 0 ] && return 0 || return 1\n160\t}\n161\t\n162\t# List all skill directories — recurses skills/<category>/<name>/SKILL.md.\n163\t# Echoes one absolute path per skill dir.\n164\talmanac_list_skills() {\n165\t  local root\n166\t  root=\"$(almanac_root)\"\n167\t  local f\n168\t  while IFS= read -r f; do\n169\t    echo \"$(dirname \"$f\")/\"\n170\t  done < <(find \"$root/skills\" -mindepth 3 -maxdepth 3 -name SKILL.md -type f 2>/dev/null | sort)\n171\t}\n172\t\n173\t# Find a skill directory by name. Echoes the dir path or empty string.\n174\talmanac_find_skill() {\n175\t  local name=\"$1\"\n176\t  local root\n177\t  root=\"$(almanac_root)\"\n178\t  local match\n179\t  match=$(find \"$root/skills\" -mindepth 2 -maxdepth 2 -type d -name \"$name\" 2>/dev/null | head -1)\n180\t  [ -n \"$match\" ] && [ -f \"$match/SKILL.md\" ] && echo \"$match\"\n181\t}\n182\t\n183\t# Validate uniqueness of skill names across the whole tree.\n184\t# Returns 0 on success, 1 on collision (and prints offending names to stderr).\n185\talmanac_validate_unique_names() {\n186\t  local root\n187\t  root=\"$(almanac_root)\"\n188\t  local dupes\n189\t  dupes=$(find \"$root/skills\" -mindepth 3 -maxdepth 3 -name SKILL.md -type f 2>/dev/null \\\n190\t    | awk -F/ '{print $(NF-1)}' \\\n191\t    | sort | uniq -d)\n192\t  if [ -n \"$dupes\" ]; then\n193\t    echo \"FAIL: skill names must be unique across the tree. Duplicates:\" >&2\n194\t    echo \"$dupes\" >&2\n195\t    return 1\n196\t  fi\n197\t  return 0\n198\t}\n199\t"}]},"parent_tool_use_id":"toolu_01A4A9waHDHnQqf3E6JyWFYr","session_id":"69a482d3-3134-43a5-90c0-a00b8e39408a","uuid":"2113d328-50cb-4bee-8963-933561cf8a7f","timestamp":"2026-05-27T06:09:27.314Z","subagent_type":"Explore","task_description":"Find friction in engine modules"}
