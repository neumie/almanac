{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UCUtZ3ntGJET936BHohA2j","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/converge.sh - converge loop adapter.\n3\t#\n4\t# Contract (called as almanac_loop_converge_<verb>):\n5\t#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n6\t#                   dispatch (no central case-statement on loop type).\n7\t#   launch_usage  — the --help text printed for this loop's launcher.\n8\t#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n9\t#                   for a given goal / exec / rounds / oversee config. Converge's\n10\t#                   runner is the CLI itself (`almanac converge --goal … --exec …`),\n11\t#                   so the adapter yields that bin/almanac invocation. Mirrors\n12\t#                   harden's adapter shape (no standalone runner script).\n13\t#   new_run_argv  — emit the hub's \"new run\" launcher argv (one token per line)\n14\t#                   from key=val pairs; role config rides on env (see\n15\t#                   new_run_env). Enforces the prompt/exec mutex.\n16\t#   new_run_env   — emit KEY=VALUE env lines for the role config (CONVERGE_*)\n17\t#                   so the hub never has to know converge's env prefixes.\n18\t#\n19\t# Control contract (signal_file) inherits the default `.converge-stop` /\n20\t# `.converge-steer` convention from lib/loops.sh — no adapter override needed.\n21\t#\n22\t# The launch verb uses helpers defined in lib/loop-launcher.sh\n23\t# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n24\t# and the shared UI / provider seams. The launcher sources those before\n25\t# dispatching, so the adapter need not source them itself.\n26\t\n27\t# Build converge's runner exec command into _ALMANAC_LOOP_ARGV (the launcher\n28\t# execs it). Positional args:\n29\t#   $1  goal           (required)\n30\t#   $2  action_mode    \"prompt\" | \"exec\" (required) — picks the flag $3 maps to\n31\t#   $3  action         the prompt text OR shell command (required)\n32\t#   $4  rounds         (optional) numeric budget\n33\t#   $5  no_oversee     (optional) \"1\" / \"true\" enables, anything else is off\n34\t#   $6  oversee_every  (optional) cadence\n35\t# The role config (provider/model/effort per CONVERGE_AGENT_* / CONVERGE_OVERSEER_*)\n36\t# rides on environment exported by the launcher, not argv — same split ralph and\n37\t# harden use. Requires $ALMANAC_HOME (set by every entry point).\n38\t# Returns 2 on an unknown action_mode.\n39\talmanac_loop_converge_exec_argv() {\n40\t  local goal=\"$1\" mode=\"$2\" action=\"$3\" rounds=\"${4:-}\" no_oversee=\"${5:-}\" oversee_every=\"${6:-}\"\n41\t  local action_flag\n42\t  case \"$mode\" in\n43\t    prompt) action_flag=\"--prompt\" ;;\n44\t    exec)   action_flag=\"--exec\" ;;\n45\t    *) return 2 ;;\n46\t  esac\n47\t  _ALMANAC_LOOP_ARGV=(bash \"$ALMANAC_HOME/bin/almanac\" converge --goal \"$goal\" \"$action_flag\" \"$action\")\n48\t  [ -n \"$rounds\" ]         && _ALMANAC_LOOP_ARGV+=(--rounds \"$rounds\")\n49\t  [ -n \"$no_oversee\" ]     && [ \"$no_oversee\" != \"0\" ] && _ALMANAC_LOOP_ARGV+=(--no-oversee)\n50\t  [ -n \"$oversee_every\" ]  && _ALMANAC_LOOP_ARGV+=(--oversee-every \"$oversee_every\")\n51\t  return 0\n52\t}\n53\t\n54\t# Interactive config + exec for the converge loop. Parses native flags, prompts\n55\t# for any missing field, exports the role-config env, and execs the runner via\n56\t# the exec_argv verb. Called by lib/loop-launcher.sh's adapter dispatch — no\n57\t# central code branches on loop type.\n58\talmanac_loop_converge_launch() {\n59\t  local goal=\"\" exec_cmd=\"\" prompt=\"\" rounds=\"\" provider=\"\" model=\"\" effort=\"\" no_oversee=\"\" oversee_every=\"\" yes=\"\"\n60\t  while [ \"$#\" -gt 0 ]; do\n61\t    case \"$1\" in\n62\t      --goal)       shift; goal=\"${1:-}\";       [ -n \"$goal\" ] || _die \"--goal requires a value\" ;;\n63\t      --exec)       shift; exec_cmd=\"${1:-}\";   [ -n \"$exec_cmd\" ] || _die \"--exec requires a value\" ;;\n64\t      --prompt)     shift; prompt=\"${1:-}\";     [ -n \"$prompt\" ] || _die \"--prompt requires a value\" ;;\n65\t      --rounds)     shift; rounds=\"${1:-}\";     [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n66\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n67\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n68\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n69\t      --no-oversee) no_oversee=1 ;;\n70\t      --oversee-every) shift; oversee_every=\"${1:-}\"; [ -n \"$oversee_every\" ] || _die \"--oversee-every requires a value\" ;;\n71\t      --yes|-y) yes=1 ;;\n72\t      --help|-h) almanac_loop_converge_launch_usage; return 0 ;;\n73\t      *) _die \"Unknown converge launch option: $1\" ;;\n74\t    esac\n75\t    shift\n76\t  done\n77\t\n78\t  # Goal is always required. Action is either --prompt (agent invocation —\n79\t  # dominant mode, takes slash commands / chains / free-form text) or --exec\n80\t  # (shell command run by a wrapping worker agent — escape hatch). Mutex\n81\t  # enforced; the runner enforces it again so direct invocations stay safe.\n82\t  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then\n83\t    _die \"--prompt and --exec are mutually exclusive — pick one\"\n84\t  fi\n85\t\n86\t  [ -n \"$goal\" ] || goal=\"$(almanac_loop_ui_input \"Goal (one-line description of convergence target)\")\" || return 1\n87\t  [ -n \"$goal\" ] || _die \"A converge goal is required.\"\n88\t\n89\t  # If neither --prompt nor --exec was passed, ask which mode the operator\n90\t  # wants and prompt for the value. Default to prompt-mode because slash-command\n91\t  # convergence is the canonical use case.\n92\t  if [ -z \"$prompt\" ] && [ -z \"$exec_cmd\" ]; then\n93\t    local action_mode\n94\t    action_mode=\"$(almanac_loop_ui_choose \"Action mode\" \"prompt (agent invocation — recommended)\" \"exec (shell command)\")\" || return 1\n95\t    case \"$action_mode\" in\n96\t      prompt*)\n97\t        prompt=\"$(almanac_loop_ui_input \"Prompt (slash command, chain, or free-form — sent to agent each round)\")\" || return 1\n98\t        [ -n \"$prompt\" ] || _die \"A converge --prompt or --exec is required.\"\n99\t        ;;\n100\t      exec*)\n101\t        exec_cmd=\"$(almanac_loop_ui_input \"Exec (shell command run by wrapping worker agent each round)\")\" || return 1\n102\t        [ -n \"$exec_cmd\" ] || _die \"A converge --prompt or --exec is required.\"\n103\t        ;;\n104\t    esac\n105\t  fi\n106\t\n107\t  local action_mode action_text\n108\t  if [ -n \"$prompt\" ]; then\n109\t    action_mode=\"prompt\"\n110\t    action_text=\"$prompt\"\n111\t  else\n112\t    action_mode=\"exec\"\n113\t    action_text=\"$exec_cmd\"\n114\t  fi\n115\t\n116\t  # Provider / model / effort — same resolution as ralph + harden. Single\n117\t  # provider drives both the worker and overseer roles by default; the user can\n118\t  # still override per-role via CONVERGE_{AGENT,OVERSEER}_* env outside the\n119\t  # launcher.\n120\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n121\t  almanac_provider_known \"$provider\"     || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n122\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n123\t  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n124\t  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n125\t\n126\t  # Rounds: optional; blank accepts the cmd/converge.sh default\n127\t  # (CONVERGE_ROUND_BUDGET or 10). Validated when present.\n128\t  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n129\t  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n130\t\n131\t  # Overseer: on by default; ask the operator only if neither flag was passed.\n132\t  if [ -z \"$no_oversee\" ]; then\n133\t    almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n134\t  fi\n135\t\n136\t  almanac_loop_launch_summary \"converge\" \\\n137\t    \"Goal:$goal\" \\\n138\t    \"$([ \"$action_mode\" = \"prompt\" ] && printf 'Prompt:%s' \"$action_text\" || printf 'Exec:%s' \"$action_text\")\" \\\n139\t    \"Provider:$provider\" \\\n140\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n141\t    \"Rounds:${rounds:-default budget}\" \\\n142\t    \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\" \\\n143\t    $([ -n \"$oversee_every\" ] && printf 'Oversee-every:%s' \"$oversee_every\")\n144\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n145\t\n146\t  # Export role config — same shape as ralph/harden. The consumer-wide\n147\t  # CONVERGE_PROVIDER/MODEL/EFFORT becomes the fallback that role.sh's lookup\n148\t  # uses for both the worker and overseer roles unless the user has set\n149\t  # CONVERGE_{AGENT,OVERSEER}_* explicitly.\n150\t  export CONVERGE_PROVIDER=\"$provider\"\n151\t  [ -n \"$model\" ]  && export CONVERGE_MODEL=\"$model\"   || unset CONVERGE_MODEL\n152\t  [ -n \"$effort\" ] && export CONVERGE_EFFORT=\"$effort\" || unset CONVERGE_EFFORT\n153\t\n154\t  # Build the runner argv via the adapter (the path to bin/almanac and the flag\n155\t  # composition both live in this file — the launcher doesn't know them). The\n156\t  # adapter takes mode + action so the same call shape works for both --prompt\n157\t  # and --exec.\n158\t  almanac_loop_adapter_call converge exec_argv \"$goal\" \"$action_mode\" \"$action_text\" \"$rounds\" \"$no_oversee\" \"$oversee_every\" \\\n159\t    || _die \"converge adapter could not build a runner for goal: $goal\"\n160\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n161\t}\n162\t\n163\t# Compose the hub's new-run launcher argv for converge (one token per line). The\n164\t# runner is `almanac converge --goal <g> (--prompt|--exec) <action> [...]`; role\n165\t# config (provider/model/effort) rides on env via new_run_env. Returns 2 when a\n166\t# required field is missing or the prompt/exec mutex is violated.\n167\talmanac_loop_converge_new_run_argv() {\n168\t  local goal=\"\" prompt=\"\" exec_cmd=\"\" rounds=\"\" oversee=\"\" oversee_every=\"\"\n169\t  local kv key val\n170\t  for kv in \"$@\"; do\n171\t    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n172\t    case \"$key\" in\n173\t      goal) goal=\"$val\" ;;\n174\t      prompt) prompt=\"$val\" ;;\n175\t      exec) exec_cmd=\"$val\" ;;\n176\t      rounds) rounds=\"$val\" ;;\n177\t      oversee) oversee=\"$val\" ;;\n178\t      oversee_every) oversee_every=\"$val\" ;;\n179\t    esac\n180\t  done\n181\t\n182\t  [ -n \"$goal\" ] || return 2\n183\t  # Mutex: prompt is the dominant mode (agent invocation); exec is the escape\n184\t  # hatch (shell command in a wrapping worker). Enforced here so the hub never\n185\t  # composes a malformed launch; cmd/converge.sh enforces it again for direct\n186\t  # invocations.\n187\t  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then return 2; fi\n188\t  [ -n \"$prompt\" ] || [ -n \"$exec_cmd\" ] || return 2\n189\t\n190\t  printf '%s\\n' converge\n191\t  printf '%s\\n%s\\n' --goal \"$goal\"\n192\t  if [ -n \"$prompt\" ]; then\n193\t    printf '%s\\n%s\\n' --prompt \"$prompt\"\n194\t  else\n195\t    printf '%s\\n%s\\n' --exec \"$exec_cmd\"\n196\t  fi\n197\t  [ -n \"$rounds\" ]        && printf '%s\\n%s\\n' --rounds \"$rounds\"\n198\t  [ \"$oversee\" = \"off\" ]  && printf '%s\\n' --no-oversee\n199\t  [ -n \"$oversee_every\" ] && printf '%s\\n%s\\n' --oversee-every \"$oversee_every\"\n200\t  return 0\n201\t}\n202\t\n203\t# Compose the hub's new-run env stream for converge (KEY=VALUE per line) from\n204\t# key=val pairs: the consumer-wide CONVERGE_PROVIDER/MODEL/EFFORT that role.sh's\n205\t# lookup uses for both worker and overseer roles unless the user has set\n206\t# CONVERGE_{AGENT,OVERSEER}_* explicitly. Empty fields drop their key.\n207\talmanac_loop_converge_new_run_env() {\n208\t  local provider=\"\" model=\"\" effort=\"\" kv key val\n209\t  for kv in \"$@\"; do\n210\t    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n211\t    case \"$key\" in\n212\t      provider) provider=\"$val\" ;;\n213\t      model)    model=\"$val\" ;;\n214\t      effort)   effort=\"$val\" ;;\n215\t    esac\n216\t  done\n217\t  [ -n \"$provider\" ] && printf 'CONVERGE_PROVIDER=%s\\n' \"$provider\"\n218\t  [ -n \"$model\" ]    && printf 'CONVERGE_MODEL=%s\\n' \"$model\"\n219\t  [ -n \"$effort\" ]   && printf 'CONVERGE_EFFORT=%s\\n' \"$effort\"\n220\t  return 0\n221\t}\n222\t\n223\t# --help text for `almanac converge` / `almanac_loop_launch converge`. Stays\n224\t# inside the adapter so adding a loop is a one-file change.\n225\talmanac_loop_converge_launch_usage() {\n226\t  cat >&2 <<'EOF'\n227\tUsage (loop launch): converge [options]\n228\t  --goal <text>       one-line convergence goal (overseer can mutate it)\n229\t  --prompt <text>     prompt sent to the configured agent each round (slash\n230\t                      command, chain, or free-form). The dominant mode.\n231\t  --exec <cmd>        shell command run by a wrapping worker agent each round\n232\t                      (escape hatch for non-agent workflows).\n233\t                      Exactly one of --prompt / --exec is required.\n234\t  --provider <p>      codex | claude\n235\t  --model <m>         worker / overseer model\n236\t  --effort <l>        thinking level\n237\t  --rounds <n>        round budget (blank = default 10)\n238\t  --no-oversee        disable the overseer (rounds budget is the only stop)\n239\t  --oversee-every <n> overseer cadence in rounds (default 1)\n240\tAny option not given is prompted interactively.\n241\tEOF\n242\t}\n243\t"}]},"parent_tool_use_id":null,"session_id":"048450e6-ddc8-4b99-9d57-06daabf0abc2","uuid":"170013e2-2684-4bae-a791-77d97238f273","timestamp":"2026-05-27T06:04:09.645Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/loops/converge.sh","content":"#!/usr/bin/env bash\n# lib/loops/converge.sh - converge loop adapter.\n#\n# Contract (called as almanac_loop_converge_<verb>):\n#   launch        — interactive config + exec. Used by lib/loop-launcher.sh's\n#                   dispatch (no central case-statement on loop type).\n#   launch_usage  — the --help text printed for this loop's launcher.\n#   exec_argv     — populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n#                   for a given goal / exec / rounds / oversee config. Converge's\n#                   runner is the CLI itself (`almanac converge --goal … --exec …`),\n#                   so the adapter yields that bin/almanac invocation. Mirrors\n#                   harden's adapter shape (no standalone runner script).\n#   new_run_argv  — emit the hub's \"new run\" launcher argv (one token per line)\n#                   from key=val pairs; role config rides on env (see\n#                   new_run_env). Enforces the prompt/exec mutex.\n#   new_run_env   — emit KEY=VALUE env lines for the role config (CONVERGE_*)\n#                   so the hub never has to know converge's env prefixes.\n#\n# Control contract (signal_file) inherits the default `.converge-stop` /\n# `.converge-steer` convention from lib/loops.sh — no adapter override needed.\n#\n# The launch verb uses helpers defined in lib/loop-launcher.sh\n# (_almanac_launch_need_provider/_choice/_positive_int, almanac_loop_launch_summary)\n# and the shared UI / provider seams. The launcher sources those before\n# dispatching, so the adapter need not source them itself.\n\n# Build converge's runner exec command into _ALMANAC_LOOP_ARGV (the launcher\n# execs it). Positional args:\n#   $1  goal           (required)\n#   $2  action_mode    \"prompt\" | \"exec\" (required) — picks the flag $3 maps to\n#   $3  action         the prompt text OR shell command (required)\n#   $4  rounds         (optional) numeric budget\n#   $5  no_oversee     (optional) \"1\" / \"true\" enables, anything else is off\n#   $6  oversee_every  (optional) cadence\n# The role config (provider/model/effort per CONVERGE_AGENT_* / CONVERGE_OVERSEER_*)\n# rides on environment exported by the launcher, not argv — same split ralph and\n# harden use. Requires $ALMANAC_HOME (set by every entry point).\n# Returns 2 on an unknown action_mode.\nalmanac_loop_converge_exec_argv() {\n  local goal=\"$1\" mode=\"$2\" action=\"$3\" rounds=\"${4:-}\" no_oversee=\"${5:-}\" oversee_every=\"${6:-}\"\n  local action_flag\n  case \"$mode\" in\n    prompt) action_flag=\"--prompt\" ;;\n    exec)   action_flag=\"--exec\" ;;\n    *) return 2 ;;\n  esac\n  _ALMANAC_LOOP_ARGV=(bash \"$ALMANAC_HOME/bin/almanac\" converge --goal \"$goal\" \"$action_flag\" \"$action\")\n  [ -n \"$rounds\" ]         && _ALMANAC_LOOP_ARGV+=(--rounds \"$rounds\")\n  [ -n \"$no_oversee\" ]     && [ \"$no_oversee\" != \"0\" ] && _ALMANAC_LOOP_ARGV+=(--no-oversee)\n  [ -n \"$oversee_every\" ]  && _ALMANAC_LOOP_ARGV+=(--oversee-every \"$oversee_every\")\n  return 0\n}\n\n# Interactive config + exec for the converge loop. Parses native flags, prompts\n# for any missing field, exports the role-config env, and execs the runner via\n# the exec_argv verb. Called by lib/loop-launcher.sh's adapter dispatch — no\n# central code branches on loop type.\nalmanac_loop_converge_launch() {\n  local goal=\"\" exec_cmd=\"\" prompt=\"\" rounds=\"\" provider=\"\" model=\"\" effort=\"\" no_oversee=\"\" oversee_every=\"\" yes=\"\"\n  while [ \"$#\" -gt 0 ]; do\n    case \"$1\" in\n      --goal)       shift; goal=\"${1:-}\";       [ -n \"$goal\" ] || _die \"--goal requires a value\" ;;\n      --exec)       shift; exec_cmd=\"${1:-}\";   [ -n \"$exec_cmd\" ] || _die \"--exec requires a value\" ;;\n      --prompt)     shift; prompt=\"${1:-}\";     [ -n \"$prompt\" ] || _die \"--prompt requires a value\" ;;\n      --rounds)     shift; rounds=\"${1:-}\";     [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n      --no-oversee) no_oversee=1 ;;\n      --oversee-every) shift; oversee_every=\"${1:-}\"; [ -n \"$oversee_every\" ] || _die \"--oversee-every requires a value\" ;;\n      --yes|-y) yes=1 ;;\n      --help|-h) almanac_loop_converge_launch_usage; return 0 ;;\n      *) _die \"Unknown converge launch option: $1\" ;;\n    esac\n    shift\n  done\n\n  # Goal is always required. Action is either --prompt (agent invocation —\n  # dominant mode, takes slash commands / chains / free-form text) or --exec\n  # (shell command run by a wrapping worker agent — escape hatch). Mutex\n  # enforced; the runner enforces it again so direct invocations stay safe.\n  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then\n    _die \"--prompt and --exec are mutually exclusive — pick one\"\n  fi\n\n  [ -n \"$goal\" ] || goal=\"$(almanac_loop_ui_input \"Goal (one-line description of convergence target)\")\" || return 1\n  [ -n \"$goal\" ] || _die \"A converge goal is required.\"\n\n  # If neither --prompt nor --exec was passed, ask which mode the operator\n  # wants and prompt for the value. Default to prompt-mode because slash-command\n  # convergence is the canonical use case.\n  if [ -z \"$prompt\" ] && [ -z \"$exec_cmd\" ]; then\n    local action_mode\n    action_mode=\"$(almanac_loop_ui_choose \"Action mode\" \"prompt (agent invocation — recommended)\" \"exec (shell command)\")\" || return 1\n    case \"$action_mode\" in\n      prompt*)\n        prompt=\"$(almanac_loop_ui_input \"Prompt (slash command, chain, or free-form — sent to agent each round)\")\" || return 1\n        [ -n \"$prompt\" ] || _die \"A converge --prompt or --exec is required.\"\n        ;;\n      exec*)\n        exec_cmd=\"$(almanac_loop_ui_input \"Exec (shell command run by wrapping worker agent each round)\")\" || return 1\n        [ -n \"$exec_cmd\" ] || _die \"A converge --prompt or --exec is required.\"\n        ;;\n    esac\n  fi\n\n  local action_mode action_text\n  if [ -n \"$prompt\" ]; then\n    action_mode=\"prompt\"\n    action_text=\"$prompt\"\n  else\n    action_mode=\"exec\"\n    action_text=\"$exec_cmd\"\n  fi\n\n  # Provider / model / effort — same resolution as ralph + harden. Single\n  # provider drives both the worker and overseer roles by default; the user can\n  # still override per-role via CONVERGE_{AGENT,OVERSEER}_* env outside the\n  # launcher.\n  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n  almanac_provider_known \"$provider\"     || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n\n  # Rounds: optional; blank accepts the cmd/converge.sh default\n  # (CONVERGE_ROUND_BUDGET or 10). Validated when present.\n  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n\n  # Overseer: on by default; ask the operator only if neither flag was passed.\n  if [ -z \"$no_oversee\" ]; then\n    almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n  fi\n\n  almanac_loop_launch_summary \"converge\" \\\n    \"Goal:$goal\" \\\n    \"$([ \"$action_mode\" = \"prompt\" ] && printf 'Prompt:%s' \"$action_text\" || printf 'Exec:%s' \"$action_text\")\" \\\n    \"Provider:$provider\" \\\n    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n    \"Rounds:${rounds:-default budget}\" \\\n    \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\" \\\n    $([ -n \"$oversee_every\" ] && printf 'Oversee-every:%s' \"$oversee_every\")\n  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n\n  # Export role config — same shape as ralph/harden. The consumer-wide\n  # CONVERGE_PROVIDER/MODEL/EFFORT becomes the fallback that role.sh's lookup\n  # uses for both the worker and overseer roles unless the user has set\n  # CONVERGE_{AGENT,OVERSEER}_* explicitly.\n  export CONVERGE_PROVIDER=\"$provider\"\n  [ -n \"$model\" ]  && export CONVERGE_MODEL=\"$model\"   || unset CONVERGE_MODEL\n  [ -n \"$effort\" ] && export CONVERGE_EFFORT=\"$effort\" || unset CONVERGE_EFFORT\n\n  # Build the runner argv via the adapter (the path to bin/almanac and the flag\n  # composition both live in this file — the launcher doesn't know them). The\n  # adapter takes mode + action so the same call shape works for both --prompt\n  # and --exec.\n  almanac_loop_adapter_call converge exec_argv \"$goal\" \"$action_mode\" \"$action_text\" \"$rounds\" \"$no_oversee\" \"$oversee_every\" \\\n    || _die \"converge adapter could not build a runner for goal: $goal\"\n  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n}\n\n# Compose the hub's new-run launcher argv for converge (one token per line). The\n# runner is `almanac converge --goal <g> (--prompt|--exec) <action> [...]`; role\n# config (provider/model/effort) rides on env via new_run_env. Returns 2 when a\n# required field is missing or the prompt/exec mutex is violated.\nalmanac_loop_converge_new_run_argv() {\n  local goal=\"\" prompt=\"\" exec_cmd=\"\" rounds=\"\" oversee=\"\" oversee_every=\"\"\n  local kv key val\n  for kv in \"$@\"; do\n    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n    case \"$key\" in\n      goal) goal=\"$val\" ;;\n      prompt) prompt=\"$val\" ;;\n      exec) exec_cmd=\"$val\" ;;\n      rounds) rounds=\"$val\" ;;\n      oversee) oversee=\"$val\" ;;\n      oversee_every) oversee_every=\"$val\" ;;\n    esac\n  done\n\n  [ -n \"$goal\" ] || return 2\n  # Mutex: prompt is the dominant mode (agent invocation); exec is the escape\n  # hatch (shell command in a wrapping worker). Enforced here so the hub never\n  # composes a malformed launch; cmd/converge.sh enforces it again for direct\n  # invocations.\n  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then return 2; fi\n  [ -n \"$prompt\" ] || [ -n \"$exec_cmd\" ] || return 2\n\n  printf '%s\\n' converge\n  printf '%s\\n%s\\n' --goal \"$goal\"\n  if [ -n \"$prompt\" ]; then\n    printf '%s\\n%s\\n' --prompt \"$prompt\"\n  else\n    printf '%s\\n%s\\n' --exec \"$exec_cmd\"\n  fi\n  [ -n \"$rounds\" ]        && printf '%s\\n%s\\n' --rounds \"$rounds\"\n  [ \"$oversee\" = \"off\" ]  && printf '%s\\n' --no-oversee\n  [ -n \"$oversee_every\" ] && printf '%s\\n%s\\n' --oversee-every \"$oversee_every\"\n  return 0\n}\n\n# Compose the hub's new-run env stream for converge (KEY=VALUE per line) from\n# key=val pairs: the consumer-wide CONVERGE_PROVIDER/MODEL/EFFORT that role.sh's\n# lookup uses for both worker and overseer roles unless the user has set\n# CONVERGE_{AGENT,OVERSEER}_* explicitly. Empty fields drop their key.\nalmanac_loop_converge_new_run_env() {\n  local provider=\"\" model=\"\" effort=\"\" kv key val\n  for kv in \"$@\"; do\n    key=\"${kv%%=*}\"; val=\"${kv#*=}\"\n    case \"$key\" in\n      provider) provider=\"$val\" ;;\n      model)    model=\"$val\" ;;\n      effort)   effort=\"$val\" ;;\n    esac\n  done\n  [ -n \"$provider\" ] && printf 'CONVERGE_PROVIDER=%s\\n' \"$provider\"\n  [ -n \"$model\" ]    && printf 'CONVERGE_MODEL=%s\\n' \"$model\"\n  [ -n \"$effort\" ]   && printf 'CONVERGE_EFFORT=%s\\n' \"$effort\"\n  return 0\n}\n\n# --help text for `almanac converge` / `almanac_loop_launch converge`. Stays\n# inside the adapter so adding a loop is a one-file change.\nalmanac_loop_converge_launch_usage() {\n  cat >&2 <<'EOF'\nUsage (loop launch): converge [options]\n  --goal <text>       one-line convergence goal (overseer can mutate it)\n  --prompt <text>     prompt sent to the configured agent each round (slash\n                      command, chain, or free-form). The dominant mode.\n  --exec <cmd>        shell command run by a wrapping worker agent each round\n                      (escape hatch for non-agent workflows).\n                      Exactly one of --prompt / --exec is required.\n  --provider <p>      codex | claude\n  --model <m>         worker / overseer model\n  --effort <l>        thinking level\n  --rounds <n>        round budget (blank = default 10)\n  --no-oversee        disable the overseer (rounds budget is the only stop)\n  --oversee-every <n> overseer cadence in rounds (default 1)\nAny option not given is prompted interactively.\nEOF\n}\n","numLines":243,"startLine":1,"totalLines":243}}}
