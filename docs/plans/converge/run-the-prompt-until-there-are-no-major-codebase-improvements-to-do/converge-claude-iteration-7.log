{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019v1Mf5gNxeP8A7BZUqYJ2u","type":"tool_result","content":"1715\t    esac\n1716\t  done\n1717\t}\n1718\t\n1719\t# --- Supervision dashboard -----------------------------------------------------\n1720\t#\n1721\t# A gum-styled redraw dashboard for supervising a harden run: reviewer status (per\n1722\t# lens, with health), the round, findings tallies, rubric progress, and the\n1723\t# feedback verdict. The render LOGIC is pure (almanac_harden_dashboard_rows: state\n1724\t# -> printable rows) so it is unit-testable without a terminal; the gather helpers\n1725\t# read live run state into that pure composer, and almanac_harden_render_dashboard\n1726\t# wraps the result in gum styling that degrades to plain output when gum is absent\n1727\t# (via the shared UI primitives in lib/ui.sh).\n1728\t\n1729\t# Findings tally for the dashboard: counts the ledger's findings by status as\n1730\t# `open=N fixed=N notes=N`, where notes = rejected-subjective + wontfix-per-context\n1731\t# (the non-blocking outcomes). Prints all-zero when the ledger is absent.\n1732\talmanac_harden_findings_tally() {\n1733\t  local path=\"$1\"\n1734\t\n1735\t  [ -f \"$path\" ] || { printf '%s\\n' \"open=0 fixed=0 notes=0\"; return 0; }\n1736\t\n1737\t  awk '\n1738\t    /^- status:/ {\n1739\t      s = $0; sub(/^- status:[ \\t]*/, \"\", s)\n1740\t      if (s == \"open\") o++\n1741\t      else if (s == \"fixed\") f++\n1742\t      else if (s == \"rejected-subjective\" || s == \"wontfix-per-context\") n++\n1743\t    }\n1744\t    END { printf \"open=%d fixed=%d notes=%d\\n\", o, f, n }\n1745\t  ' \"$path\"\n1746\t}\n1747\t\n1748\t# Rubric acceptance progress for the dashboard: `checked/total` over the\n1749\t# `## Acceptance` checklist. Prints 0/0 when the rubric or section is absent.\n1750\talmanac_harden_rubric_progress() {\n1751\t  local path=\"$1\"\n1752\t  local acc total checked\n1753\t\n1754\t  acc=\"$(almanac_harden_rubric_acceptance \"$path\")\"\n1755\t  total=\"$(printf '%s\\n' \"$acc\" | grep -c '^- \\[' || true)\"\n1756\t  checked=\"$(printf '%s\\n' \"$acc\" | grep -c '^- \\[[xX]\\]' || true)\"\n1757\t  printf '%s/%s\\n' \"$checked\" \"$total\"\n1758\t}\n1759\t\n1760\t# Pure render: compose the dashboard's printable rows from already-gathered state.\n1761\t# Reads worker rows from stdin as TSV (id<TAB>provider<TAB>health), one per\n1762\t# reviewer, and takes round/budget, findings tally, rubric progress, and feedback\n1763\t# verdict as args. No file I/O, no clock, no gum — fully deterministic and\n1764\t# unit-testable. Surfaces each reviewer's health (running, stalled, idle, looping,\n1765\t# done, failed) with a status glyph, and reports an empty reviewer set explicitly.\n1766\talmanac_harden_dashboard_rows() {\n1767\t  local round=\"${1:-?}\"\n1768\t  local budget=\"${2:-?}\"\n1769\t  local tally=\"${3:-}\"\n1770\t  local progress=\"${4:-}\"\n1771\t  local verdict=\"${5:-n/a}\"\n1772\t  local id provider health glyph\n1773\t  local any=0\n1774\t\n1775\t  printf 'Harden dashboard — round %s/%s\\n' \"$round\" \"$budget\"\n1776\t  printf 'Reviewers:\\n'\n1777\t  while IFS=$'\\t' read -r id provider health; do\n1778\t    [ -n \"$id\" ] || continue\n1779\t    glyph=\"$(almanac_loop_ui_status_glyph \"$health\")\"\n1780\t    printf '  %s %s  %s  %s\\n' \"$glyph\" \"$id\" \"${provider:-?}\" \"${health:-?}\"\n1781\t    any=1\n1782\t  done\n1783\t  [ \"$any\" -eq 1 ] || printf '  (no reviewers)\\n'\n1784\t  printf 'Findings: %s\\n' \"${tally:-open=0 fixed=0 notes=0}\"\n1785\t  printf 'Rubric: %s acceptance criteria\\n' \"${progress:-0/0}\"\n1786\t  printf 'Feedback: %s\\n' \"$verdict\"\n1787\t}\n1788\t\n1789\t# Gather the run's reviewer rows for the composer: one TSV line per worker\n1790\t# (id<TAB>provider<TAB>health), reading each worker's status.tsv and classifying\n1791\t# its health via the shared detector. Empty when the run has no workers yet.\n1792\t# now/stall/loop pass through to the classifier (overridable for tests).\n1793\talmanac_harden_dashboard_worker_rows() {\n1794\t  local root=\"$1\"\n1795\t  local run_id=\"$2\"\n1796\t  local now=\"${3:-}\"\n1797\t  local stall=\"${4:-120}\"\n1798\t  local loop=\"${5:-5}\"\n1799\t  local workers_dir wdir status_file base id provider health\n1800\t\n1801\t  workers_dir=\"$(almanac_loop_registry_dir \"$root\")/$run_id/workers\"\n1802\t  [ -d \"$workers_dir\" ] || return 0\n1803\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n1804\t\n1805\t  for wdir in \"$workers_dir\"/*/; do\n1806\t    [ -d \"$wdir\" ] || continue\n1807\t    status_file=\"$wdir/status.tsv\"\n1808\t    [ -f \"$status_file\" ] || continue\n1809\t    base=\"$(basename \"$wdir\")\"\n1810\t    id=\"$(almanac_loop_status_field \"$status_file\" \"id\" || true)\"\n1811\t    provider=\"$(almanac_loop_status_field \"$status_file\" \"provider\" || true)\"\n1812\t    health=\"$(almanac_loop_worker_health_of \"$root\" \"$run_id\" \"$base\" \"$now\" \"$stall\" \"$loop\")\"\n1813\t    printf '%s\\t%s\\t%s\\n' \"${id:-$base}\" \"${provider:-?}\" \"$health\"\n1814\t  done\n1815\t}\n1816\t\n1817\t# Find the most recent harden run id for a target under the run registry (newest\n1818\t# by directory mtime). Returns non-zero when no matching run exists. Used by the\n1819\t# dashboard to render the live run's state.\n1820\talmanac_harden_latest_run_id() {\n1821\t  local root=\"$1\"\n1822\t  local target=\"$2\"\n1823\t  local registry slug prefix d t base=\"\"\n1824\t  local newest_t=0"}]},"parent_tool_use_id":null,"session_id":"048450e6-ddc8-4b99-9d57-06daabf0abc2","uuid":"365bb051-dfde-4bd7-b44e-ebb1193556ef","timestamp":"2026-05-27T06:05:16.961Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/harden-core.sh","content":"    esac\n  done\n}\n\n# --- Supervision dashboard -----------------------------------------------------\n#\n# A gum-styled redraw dashboard for supervising a harden run: reviewer status (per\n# lens, with health), the round, findings tallies, rubric progress, and the\n# feedback verdict. The render LOGIC is pure (almanac_harden_dashboard_rows: state\n# -> printable rows) so it is unit-testable without a terminal; the gather helpers\n# read live run state into that pure composer, and almanac_harden_render_dashboard\n# wraps the result in gum styling that degrades to plain output when gum is absent\n# (via the shared UI primitives in lib/ui.sh).\n\n# Findings tally for the dashboard: counts the ledger's findings by status as\n# `open=N fixed=N notes=N`, where notes = rejected-subjective + wontfix-per-context\n# (the non-blocking outcomes). Prints all-zero when the ledger is absent.\nalmanac_harden_findings_tally() {\n  local path=\"$1\"\n\n  [ -f \"$path\" ] || { printf '%s\\n' \"open=0 fixed=0 notes=0\"; return 0; }\n\n  awk '\n    /^- status:/ {\n      s = $0; sub(/^- status:[ \\t]*/, \"\", s)\n      if (s == \"open\") o++\n      else if (s == \"fixed\") f++\n      else if (s == \"rejected-subjective\" || s == \"wontfix-per-context\") n++\n    }\n    END { printf \"open=%d fixed=%d notes=%d\\n\", o, f, n }\n  ' \"$path\"\n}\n\n# Rubric acceptance progress for the dashboard: `checked/total` over the\n# `## Acceptance` checklist. Prints 0/0 when the rubric or section is absent.\nalmanac_harden_rubric_progress() {\n  local path=\"$1\"\n  local acc total checked\n\n  acc=\"$(almanac_harden_rubric_acceptance \"$path\")\"\n  total=\"$(printf '%s\\n' \"$acc\" | grep -c '^- \\[' || true)\"\n  checked=\"$(printf '%s\\n' \"$acc\" | grep -c '^- \\[[xX]\\]' || true)\"\n  printf '%s/%s\\n' \"$checked\" \"$total\"\n}\n\n# Pure render: compose the dashboard's printable rows from already-gathered state.\n# Reads worker rows from stdin as TSV (id<TAB>provider<TAB>health), one per\n# reviewer, and takes round/budget, findings tally, rubric progress, and feedback\n# verdict as args. No file I/O, no clock, no gum — fully deterministic and\n# unit-testable. Surfaces each reviewer's health (running, stalled, idle, looping,\n# done, failed) with a status glyph, and reports an empty reviewer set explicitly.\nalmanac_harden_dashboard_rows() {\n  local round=\"${1:-?}\"\n  local budget=\"${2:-?}\"\n  local tally=\"${3:-}\"\n  local progress=\"${4:-}\"\n  local verdict=\"${5:-n/a}\"\n  local id provider health glyph\n  local any=0\n\n  printf 'Harden dashboard — round %s/%s\\n' \"$round\" \"$budget\"\n  printf 'Reviewers:\\n'\n  while IFS=$'\\t' read -r id provider health; do\n    [ -n \"$id\" ] || continue\n    glyph=\"$(almanac_loop_ui_status_glyph \"$health\")\"\n    printf '  %s %s  %s  %s\\n' \"$glyph\" \"$id\" \"${provider:-?}\" \"${health:-?}\"\n    any=1\n  done\n  [ \"$any\" -eq 1 ] || printf '  (no reviewers)\\n'\n  printf 'Findings: %s\\n' \"${tally:-open=0 fixed=0 notes=0}\"\n  printf 'Rubric: %s acceptance criteria\\n' \"${progress:-0/0}\"\n  printf 'Feedback: %s\\n' \"$verdict\"\n}\n\n# Gather the run's reviewer rows for the composer: one TSV line per worker\n# (id<TAB>provider<TAB>health), reading each worker's status.tsv and classifying\n# its health via the shared detector. Empty when the run has no workers yet.\n# now/stall/loop pass through to the classifier (overridable for tests).\nalmanac_harden_dashboard_worker_rows() {\n  local root=\"$1\"\n  local run_id=\"$2\"\n  local now=\"${3:-}\"\n  local stall=\"${4:-120}\"\n  local loop=\"${5:-5}\"\n  local workers_dir wdir status_file base id provider health\n\n  workers_dir=\"$(almanac_loop_registry_dir \"$root\")/$run_id/workers\"\n  [ -d \"$workers_dir\" ] || return 0\n  [ -n \"$now\" ] || now=\"$(date +%s)\"\n\n  for wdir in \"$workers_dir\"/*/; do\n    [ -d \"$wdir\" ] || continue\n    status_file=\"$wdir/status.tsv\"\n    [ -f \"$status_file\" ] || continue\n    base=\"$(basename \"$wdir\")\"\n    id=\"$(almanac_loop_status_field \"$status_file\" \"id\" || true)\"\n    provider=\"$(almanac_loop_status_field \"$status_file\" \"provider\" || true)\"\n    health=\"$(almanac_loop_worker_health_of \"$root\" \"$run_id\" \"$base\" \"$now\" \"$stall\" \"$loop\")\"\n    printf '%s\\t%s\\t%s\\n' \"${id:-$base}\" \"${provider:-?}\" \"$health\"\n  done\n}\n\n# Find the most recent harden run id for a target under the run registry (newest\n# by directory mtime). Returns non-zero when no matching run exists. Used by the\n# dashboard to render the live run's state.\nalmanac_harden_latest_run_id() {\n  local root=\"$1\"\n  local target=\"$2\"\n  local registry slug prefix d t base=\"\"\n  local newest_t=0","numLines":110,"startLine":1715,"totalLines":1980}}}
