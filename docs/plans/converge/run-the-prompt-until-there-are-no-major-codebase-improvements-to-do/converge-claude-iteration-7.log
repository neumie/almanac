{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cy5aTjv28VHyKVGhLRs3qT","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# converge-core.sh - Generic convergence loop core\n3\t\n4\t# Source focused deps idempotently so tests can source this file directly.\n5\t# core.sh owns the helper, so it's pulled in via the literal pattern.\n6\tif ! declare -F _error >/dev/null 2>&1; then\n7\t  __converge_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n8\t  # shellcheck source=lib/core.sh\n9\t  source \"$__converge_core_dir/core.sh\"\n10\t  unset __converge_core_dir\n11\tfi\n12\t\n13\t_almanac_source_sibling run.sh    almanac_loop_register_run\n14\t_almanac_source_sibling agent.sh  almanac_loop_agent_capture\n15\t_almanac_source_sibling role.sh   almanac_loop_role_config\n16\t\n17\talmanac_converge_plan_dir() {\n18\t  local root=\"$1\"\n19\t  local slug=\"$2\"\n20\t\n21\t  printf '%s/docs/plans/converge/%s\\n' \"$root\" \"$slug\"\n22\t}\n23\t\n24\talmanac_converge_scaffold() {\n25\t  local root=\"$1\"\n26\t  local goal=\"$2\"\n27\t  local plan_dir\n28\t\n29\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n30\t\n31\t  if ! mkdir -p \"$plan_dir\"; then\n32\t    _die \"Could not create converge plan dir: ${plan_dir#\"$root\"/}\"\n33\t  fi\n34\t  if ! printf '%s\\n' \"$goal\" > \"$plan_dir/goal.md\"; then\n35\t    _die \"Could not write converge goal: ${plan_dir#\"$root\"/}/goal.md\"\n36\t  fi\n37\t  if ! : > \"$plan_dir/agent-reports.log\"; then\n38\t    _die \"Could not write converge report log: ${plan_dir#\"$root\"/}/agent-reports.log\"\n39\t  fi\n40\t  if ! : > \"$plan_dir/goal.history.log\"; then\n41\t    _die \"Could not write converge goal history: ${plan_dir#\"$root\"/}/goal.history.log\"\n42\t  fi\n43\t}\n44\t\n45\talmanac_converge_role() {\n46\t  local role=\"$1\"\n47\t\n48\t  case \"$role\" in\n49\t    agent|overseer) ;;\n50\t    *) return 2 ;;\n51\t  esac\n52\t\n53\t  almanac_loop_role_config \"converge\" \"$role\" \"\" \"$(almanac_provider_default)\" \"\" \"\"\n54\t}\n55\t\n56\talmanac_converge_role_field() {\n57\t  local role=\"$1\"\n58\t  local field=\"$2\"\n59\t\n60\t  almanac_converge_role \"$role\" | awk -F'\\t' -v k=\"$field\" '$1 == k { v = $2 } END { print v }'\n61\t}\n62\t\n63\talmanac_converge_ensure_prompt_template() {\n64\t  local root=\"$1\"\n65\t  local goal=\"$2\"\n66\t  local plan_dir prompt_file\n67\t\n68\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n69\t  prompt_file=\"$plan_dir/prompt.md\"\n70\t  [ -f \"$prompt_file\" ] && return 0\n71\t\n72\t  cat > \"$prompt_file\" <<'EOF'\n73\t# Converge Worker\n74\t\n75\tYou are one worker round in a generic convergence loop.\n76\t\n77\tRead current goal, follow one-shot steer directive if present, run exact exec\n78\tcommand, then leave clear evidence in git history and agent-reports.log.\n79\t\n80\tDo not edit the goal unless explicitly asked by the exec command. Do not commit\n81\t.almanac or converge state files under docs/plans/converge/.\n82\tEOF\n83\t}\n84\t\n85\talmanac_converge_worker_prompt() {\n86\t  local root=\"$1\"\n87\t  local goal=\"$2\"\n88\t  local exec_cmd=\"$3\"\n89\t  local round=\"$4\"\n90\t  local slug plan_dir rel_plan steer_file\n91\t\n92\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n93\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n94\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n95\t  steer_file=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n96\t\n97\t  almanac_converge_ensure_prompt_template \"$root\" \"$goal\"\n98\t\n99\t  cat \"$plan_dir/prompt.md\"\n100\t  cat <<EOF\n101\t\n102\tCONVERGE_TICK=$round\n103\tCONVERGE_SLUG=$slug\n104\tCONVERGE_PLAN_DIR=$rel_plan\n105\tCONVERGE_REPORT_LOG=$rel_plan/agent-reports.log\n106\t\n107\tCommit user-visible worktree changes, excluding .almanac and $rel_plan, with:\n108\tCONVERGE($slug): <one-line summary>\n109\t\n110\tAppend one structured self-report to $rel_plan/agent-reports.log. Use this exact\n111\theader shape and these exact section labels:\n112\t\n113\t===== tick=<N> ts=<ISO> =====\n114\tsummary:\n115\tconcerns:\n116\tnext:\n117\t\n118\tFor this round, N is $round.\n119\t\n120\t===== GOAL.md =====\n121\tEOF\n122\t  cat \"$plan_dir/goal.md\"\n123\t  cat <<EOF\n124\t===== END GOAL.md =====\n125\t\n126\t===== EXEC COMMAND =====\n127\t$exec_cmd\n128\t===== END EXEC COMMAND =====\n129\tEOF\n130\t\n131\t  if [ -f \"$steer_file\" ]; then\n132\t    cat <<'EOF'\n133\t\n134\t===== STEER =====\n135\tEOF\n136\t    cat \"$steer_file\"\n137\t    cat <<'EOF'\n138\t===== END STEER =====\n139\tEOF\n140\t    rm -f \"$steer_file\"\n141\t  fi\n142\t}\n143\t\n144\talmanac_converge_report_log_has_structured_block() {\n145\t  local file=\"$1\"\n146\t\n147\t  [ -f \"$file\" ] || return 1\n148\t  awk '\n149\t    /^===== tick=[0-9][0-9]* ts=.* =====$/ {\n150\t      seen = 1\n151\t      summary = 0\n152\t      concerns = 0\n153\t      next_seen = 0\n154\t      next\n155\t    }\n156\t    seen && /^summary:$/ { summary = 1; next }\n157\t    seen && /^concerns:$/ { concerns = 1; next }\n158\t    seen && /^next:$/ { next_seen = 1; ok = summary && concerns && next_seen; next }\n159\t    END { exit ok ? 0 : 1 }\n160\t  ' \"$file\"\n161\t}\n162\t\n163\talmanac_converge_trim() {\n164\t  printf '%s' \"$1\" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'\n165\t}\n166\t\n167\talmanac_converge_overseer_prompt() {\n168\t  local root=\"$1\"\n169\t  local goal=\"$2\"\n170\t  local round=\"$3\"\n171\t  local slug plan_dir rel_plan reports_file reports commits\n172\t\n173\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n174\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n175\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n176\t  reports_file=\"$plan_dir/agent-reports.log\"\n177\t\n178\t  if [ -f \"$reports_file\" ]; then\n179\t    reports=\"$(tail -c 8192 \"$reports_file\")\"\n180\t  else\n181\t    reports=\"(no agent reports yet)\"\n182\t  fi\n183\t\n184\t  commits=\"$(git -C \"$root\" log --fixed-strings --grep=\"CONVERGE($slug):\" -n 10 \\\n185\t    --format='%H%n%ad%n%B%n---' --date=short 2>/dev/null || true)\"\n186\t  [ -n \"$commits\" ] || commits=\"No CONVERGE commits yet\"\n187\t\n188\t  cat <<EOF\n189\tYou are the overseer for converge($slug), a synchronous convergence loop.\n190\t\n191\tCONVERGE_TICK=$round\n192\tCONVERGE_SLUG=$slug\n193\tCONVERGE_PLAN_DIR=$rel_plan\n194\t\n195\tJudge whether the current goal is satisfied, whether the next worker needs a\n196\tone-shot steering directive, or whether the loop should stop.\n197\t\n198\t===== GOAL.md =====\n199\tEOF\n200\t  cat \"$plan_dir/goal.md\"\n201\t  cat <<EOF\n202\t===== END GOAL.md =====\n203\t\n204\t===== RECENT AGENT SELF-REPORTS (last ~8KB) =====\n205\t$reports\n206\t===== END RECENT AGENT SELF-REPORTS =====\n207\t\n208\t===== RECENT CONVERGE COMMITS (last 10) =====\n209\t$commits\n210\t===== END RECENT CONVERGE COMMITS =====\n211\t\n212\tOutput these fields in order with no preamble:\n213\tVERDICT: <CONVERGED|CONTINUE|STEER|STOP>\n214\tREASON: <one paragraph>\n215\tSTEER: <one paragraph, or 'none'>\n216\tGOAL_UPDATE: <new goal.md content, or 'unchanged'>\n217\t\n218\tBe conservative. Malformed output is treated as CONTINUE with no steering and no\n219\tgoal update. GOAL_UPDATE may span multiple lines because it is the final field.\n220\tEOF\n221\t}\n222\t\n223\talmanac_converge_overseer_parse() {\n224\t  local input=\"${1:-}\"\n225\t  local content line key_line current_key=\"\"\n226\t  local raw_verdict=\"\" raw_reason=\"\" raw_steer=\"\" raw_goal=\"\"\n227\t  local found_verdict=0 found_reason=0 found_steer=0 found_goal=0\n228\t\n229\t  if [ -f \"$input\" ]; then\n230\t    content=\"$(cat \"$input\")\"\n231\t  else\n232\t    content=\"$input\"\n233\t  fi\n234\t\n235\t  ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n236\t  ALMANAC_CONVERGE_REASON=\"\"\n237\t  ALMANAC_CONVERGE_STEER=\"none\"\n238\t  ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n239\t\n240\t  # State-machine line walker. Each KEY: prefix switches the current field;\n241\t  # subsequent non-key lines append to whatever field is currently open. This\n242\t  # lets the LLM emit either inline values (`REASON: blah`) or values on the\n243\t  # next line (`REASON:\\nblah`) or multi-line paragraphs that span until the\n244\t  # next KEY: marker — all parse correctly. Before this fix the parser only\n245\t  # captured the value text on the SAME line as KEY:, dropping continuation\n246\t  # lines and producing empty REASON / STEER for any LLM that emitted\n247\t  # paragraph-shaped values — the bug observed in the first --prompt converge\n248\t  # run (REASON empty, STEER none in the overseer.log entry despite the LLM\n249\t  # clearly being asked to produce both).\n250\t  while IFS= read -r line || [ -n \"$line\" ]; do\n251\t    key_line=\"$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\"\n252\t    case \"$key_line\" in\n253\t      VERDICT:*)\n254\t        current_key=\"VERDICT\"; found_verdict=1\n255\t        raw_verdict=\"${key_line#VERDICT:}\"\n256\t        case \"$raw_verdict\" in \" \"*) raw_verdict=\"${raw_verdict# }\" ;; esac\n257\t        ;;\n258\t      REASON:*)\n259\t        current_key=\"REASON\"; found_reason=1\n260\t        raw_reason=\"${key_line#REASON:}\"\n261\t        case \"$raw_reason\" in \" \"*) raw_reason=\"${raw_reason# }\" ;; esac\n262\t        ;;\n263\t      STEER:*)\n264\t        current_key=\"STEER\"; found_steer=1\n265\t        raw_steer=\"${key_line#STEER:}\"\n266\t        case \"$raw_steer\" in \" \"*) raw_steer=\"${raw_steer# }\" ;; esac\n267\t        ;;\n268\t      GOAL_UPDATE:*)\n269\t        current_key=\"GOAL_UPDATE\"; found_goal=1\n270\t        raw_goal=\"${key_line#GOAL_UPDATE:}\"\n271\t        case \"$raw_goal\" in \" \"*) raw_goal=\"${raw_goal# }\" ;; esac\n272\t        ;;\n273\t      *)\n274\t        # Continuation line — append to whichever field is currently open.\n275\t        # Lines before the first KEY: marker (preamble noise) have current_key\n276\t        # empty and are dropped, matching the prompt's \"no preamble\" contract.\n277\t        # The original line (not the leading-whitespace-stripped key_line) is\n278\t        # preserved so multi-line paragraphs keep their indentation if any.\n279\t        case \"$current_key\" in\n280\t          VERDICT)     raw_verdict=\"${raw_verdict}\"$'\\n'\"${line}\" ;;\n281\t          REASON)      raw_reason=\"${raw_reason}\"$'\\n'\"${line}\" ;;\n282\t          STEER)       raw_steer=\"${raw_steer}\"$'\\n'\"${line}\" ;;\n283\t          GOAL_UPDATE) raw_goal=\"${raw_goal}\"$'\\n'\"${line}\" ;;\n284\t        esac\n285\t        ;;\n286\t    esac\n287\t  done <<< \"$content\"\n288\t\n289\t  if [ \"$found_verdict\" -ne 1 ] || [ \"$found_reason\" -ne 1 ] || \\\n290\t    [ \"$found_steer\" -ne 1 ] || [ \"$found_goal\" -ne 1 ]; then\n291\t    return 0\n292\t  fi\n293\t\n294\t  # VERDICT is always a single token. A chatty LLM may put the token on its own\n295\t  # line and then ramble before REASON; the state-machine above will have\n296\t  # accumulated those ramble lines into raw_verdict. Reduce to the first\n297\t  # non-empty line so the case-match below still recognises the token.\n298\t  raw_verdict=\"$(printf '%s\\n' \"$raw_verdict\" | awk 'NF{print; exit}')\"\n299\t  raw_verdict=\"$(almanac_converge_trim \"$raw_verdict\")\"\n300\t  case \"$raw_verdict\" in\n301\t    CONVERGED|CONTINUE|STEER|STOP) ALMANAC_CONVERGE_VERDICT=\"$raw_verdict\" ;;\n302\t    *)\n303\t      ALMANAC_CONVERGE_VERDICT=\"CONTINUE\"\n304\t      ALMANAC_CONVERGE_STEER=\"none\"\n305\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"unchanged\"\n306\t      return 0\n307\t      ;;\n308\t  esac\n309\t\n310\t  ALMANAC_CONVERGE_REASON=\"$(almanac_converge_trim \"$raw_reason\")\"\n311\t\n312\t  raw_steer=\"$(almanac_converge_trim \"$raw_steer\")\"\n313\t  if [ -n \"$raw_steer\" ] && ! printf '%s\\n' \"$raw_steer\" | grep -qiE '^none[[:space:]]*$'; then\n314\t    ALMANAC_CONVERGE_STEER=\"$raw_steer\"\n315\t  fi\n316\t\n317\t  if [ \"$found_goal\" -eq 1 ]; then\n318\t    local goal_check\n319\t    goal_check=\"$(almanac_converge_trim \"$raw_goal\")\"\n320\t    if [ -n \"$goal_check\" ] && ! printf '%s\\n' \"$goal_check\" | grep -qiE '^unchanged[[:space:]]*$'; then\n321\t      ALMANAC_CONVERGE_GOAL_UPDATE=\"$raw_goal\"\n322\t    fi\n323\t  fi\n324\t}\n325\t\n326\talmanac_converge_write_convergence() {\n327\t  local root=\"$1\"\n328\t  local goal=\"$2\"\n329\t  local verdict=\"$3\"\n330\t  local tick=\"$4\"\n331\t  local started_epoch=\"${5:-}\"\n332\t  local reason=\"${6:-}\"\n333\t  local plan_dir now_epoch elapsed\n334\t\n335\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n336\t  now_epoch=\"$(date +%s)\"\n337\t  elapsed=\"\"\n338\t  case \"$started_epoch\" in\n339\t    ''|*[!0-9]*) ;;\n340\t    *) elapsed=\"$((now_epoch - started_epoch))s\" ;;\n341\t  esac\n342\t\n343\t  {\n344\t    printf '# Convergence\\n\\n'\n345\t    printf '## Final verdict\\n\\n%s\\n\\n' \"$verdict\"\n346\t    printf '## Tick count\\n\\n%s\\n\\n' \"$tick\"\n347\t    printf '## Time elapsed\\n\\n%s\\n\\n' \"${elapsed:-unknown}\"\n348\t    printf '## Final goal\\n\\n'\n349\t    if [ -f \"$plan_dir/goal.md\" ]; then\n350\t      cat \"$plan_dir/goal.md\"\n351\t    fi\n352\t    printf '\\n\\n## Final reason\\n\\n%s\\n' \"${reason:-none}\"\n353\t  } > \"$plan_dir/convergence.md\"\n354\t}\n355\t\n356\talmanac_converge_goal_summary() {\n357\t  printf '%s' \"$1\" | tr '\\n' ' ' | cut -c 1-80\n358\t}\n359\t\n360\talmanac_converge_latest_run_id() {\n361\t  local root=\"$1\"\n362\t  local slug=\"$2\"\n363\t  local rows id type target pid status_rel started status match=\"\"\n364\t\n365\t  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n366\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n367\t    [ -n \"$id\" ] || continue\n368\t    [ \"$type\" = \"converge\" ] || continue\n369\t    [ \"$target\" = \"$slug\" ] || continue\n370\t    match=\"$id\"\n371\t  done <<< \"$rows\"\n372\t\n373\t  [ -n \"$match\" ] || return 1\n374\t  printf '%s\\n' \"$match\"\n375\t}\n376\t\n377\talmanac_converge_worker_health() {\n378\t  local root=\"$1\"\n379\t  local run_id=\"$2\"\n380\t  local status_file status\n381\t\n382\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n383\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"dead\"; return 0; }\n384\t\n385\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n386\t  if [ \"$status\" = \"running\" ] && ! almanac_loop_run_is_stale \"$root\" \"$run_id\"; then\n387\t    printf '%s\\n' \"alive\"\n388\t  else\n389\t    printf '%s\\n' \"dead\"\n390\t  fi\n391\t}\n392\t\n393\talmanac_converge_last_verdict_line() {\n394\t  local log_file=\"$1\"\n395\t\n396\t  [ -f \"$log_file\" ] || return 1\n397\t  awk '\n398\t    /^===== tick=/ { verdict = \"\"; reason = \"\" }\n399\t    /^VERDICT: / { verdict = substr($0, 10) }\n400\t    /^REASON: / { reason = substr($0, 9) }\n401\t    END {\n402\t      if (verdict != \"\" || reason != \"\") {\n403\t        printf \"%s\\t%s\\n\", verdict, reason\n404\t      }\n405\t    }\n406\t  ' \"$log_file\"\n407\t}\n408\t\n409\talmanac_converge_last_report_header() {\n410\t  local reports_file=\"$1\"\n411\t\n412\t  [ -f \"$reports_file\" ] || return 1\n413\t  grep -E '^===== tick=[0-9][0-9]* ts=.* =====$' \"$reports_file\" 2>/dev/null | tail -n 1\n414\t}\n415\t\n416\talmanac_converge_goal_mutation_count() {\n417\t  local history_file=\"$1\"\n418\t\n419\t  [ -f \"$history_file\" ] || { printf '%s\\n' \"0\"; return 0; }\n420\t  awk '/^===== tick=[0-9][0-9]* ts=.* overseer=/ { c++ } END { print c + 0 }' \"$history_file\"\n421\t}\n422\t\n423\talmanac_converge_dashboard_frame() {\n424\t  local root=\"$1\"\n425\t  local slug=\"$2\"\n426\t  local plan_dir goal_file reports_file history_file log_file\n427\t  local run_id=\"\" status_file round=\"\" rounds=\"\" health=\"dead\"\n428\t  local verdict=\"none\" reason=\"none\" verdict_line report_header goal_text goal_summary mutations\n429\t  local tab=$'\\t'\n430\t\n431\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n432\t  [ -d \"$plan_dir\" ] || return 1\n433\t\n434\t  goal_file=\"$plan_dir/goal.md\"\n435\t  reports_file=\"$plan_dir/agent-reports.log\"\n436\t  history_file=\"$plan_dir/goal.history.log\"\n437\t  log_file=\"$plan_dir/overseer.log\"\n438\t\n439\t  if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n440\t    status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n441\t    round=\"$(almanac_loop_status_field \"$status_file\" \"round\" 2>/dev/null || true)\"\n442\t    rounds=\"$(almanac_loop_status_field \"$status_file\" \"rounds\" 2>/dev/null || true)\"\n443\t    health=\"$(almanac_converge_worker_health \"$root\" \"$run_id\")\"\n444\t  fi\n445\t  [ -n \"$round\" ] || round=\"0\"\n446\t  [ -n \"$rounds\" ] || rounds=\"?\"\n447\t\n448\t  if verdict_line=\"$(almanac_converge_last_verdict_line \"$log_file\" 2>/dev/null)\"; then\n449\t    verdict=\"${verdict_line%%$tab*}\"\n450\t    reason=\"${verdict_line#*$tab}\"\n451\t    [ \"$reason\" != \"$verdict_line\" ] || reason=\"none\"\n452\t    [ -n \"$verdict\" ] || verdict=\"none\"\n453\t    [ -n \"$reason\" ] || reason=\"none\"\n454\t  fi\n455\t\n456\t  report_header=\"$(almanac_converge_last_report_header \"$reports_file\" 2>/dev/null || true)\"\n457\t  [ -n \"$report_header\" ] || report_header=\"none\"\n458\t\n459\t  goal_text=\"\"\n460\t  [ -f \"$goal_file\" ] && goal_text=\"$(cat \"$goal_file\")\"\n461\t  goal_summary=\"$(almanac_converge_goal_summary \"$goal_text\")\"\n462\t  [ -n \"$goal_summary\" ] || goal_summary=\"none\"\n463\t  mutations=\"$(almanac_converge_goal_mutation_count \"$history_file\")\"\n464\t\n465\t  printf 'converge %s\\n' \"$slug\"\n466\t  printf 'current round: %s/%s\\n' \"$round\" \"$rounds\"\n467\t  printf 'last verdict: %s\\n' \"$verdict\"\n468\t  printf 'reason: %s\\n' \"$reason\"\n469\t  printf 'last report: %s\\n' \"$report_header\"\n470\t  printf 'goal: %s\\n' \"$goal_summary\"\n471\t  printf 'goal mutations: %s\\n' \"$mutations\"\n472\t  printf 'worker health: %s\\n' \"$health\"\n473\t}\n474\t\n475\talmanac_converge_status() {\n476\t  local root=\"$1\"\n477\t  local slug=\"$2\"\n478\t  local frame\n479\t\n480\t  frame=\"$(almanac_converge_dashboard_frame \"$root\" \"$slug\")\" || return 1\n481\t  printf '%s\\n' \"$frame\" | almanac_loop_ui_render\n482\t}\n483\t\n484\talmanac_converge_watch() {\n485\t  local root=\"$1\"\n486\t  local slug=\"$2\"\n487\t  local mode=\"${3:-}\"\n488\t  local interval=\"${CONVERGE_WATCH_INTERVAL:-${ALMANAC_HUB_WATCH_INTERVAL:-2}}\"\n489\t  local run_id status_file status\n490\t\n491\t  if [ \"$mode\" != \"follow\" ] || [ ! -t 1 ]; then\n492\t    almanac_converge_status \"$root\" \"$slug\"\n493\t    return\n494\t  fi\n495\t\n496\t  while :; do\n497\t    almanac_loop_ui_clear\n498\t    almanac_converge_status \"$root\" \"$slug\"\n499\t    if run_id=\"$(almanac_converge_latest_run_id \"$root\" \"$slug\" 2>/dev/null)\"; then\n500\t      status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n501\t      status=\"$(almanac_loop_status_field \"$status_file\" \"status\" 2>/dev/null || true)\"\n502\t      case \"$status\" in\n503\t        done|failed|aborted) break ;;\n504\t      esac\n505\t    fi\n506\t    sleep \"$interval\"\n507\t  done\n508\t}\n509\t\n510\talmanac_converge_stop() {\n511\t  local root=\"$1\"\n512\t  local slug=\"$2\"\n513\t  local plan_dir root_stop plan_stop\n514\t\n515\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n516\t  [ -d \"$plan_dir\" ] || return 1\n517\t  root_stop=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n518\t  plan_stop=\"$(almanac_loop_run_control_file converge \"$plan_dir\" stop)\"\n519\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$root_stop\"\n520\t  printf 'stop requested via almanac converge: %s\\n' \"$slug\" > \"$plan_stop\"\n521\t}\n522\t\n523\talmanac_converge_apply_goal_update() {\n524\t  local root=\"$1\"\n525\t  local goal=\"$2\"\n526\t  local round=\"$3\"\n527\t  local provider=\"$4\"\n528\t  local reason=\"$5\"\n529\t  local new_goal=\"$6\"\n530\t  local plan_dir goal_file history_file log_file ts old_goal old_file new_file diff_output diff_status summary\n531\t\n532\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n533\t  goal_file=\"$plan_dir/goal.md\"\n534\t  history_file=\"$plan_dir/goal.history.log\"\n535\t  log_file=\"$plan_dir/overseer.log\"\n536\t  ts=\"$(almanac_loop_now_utc)\"\n537\t  old_goal=\"\"\n538\t  [ -f \"$goal_file\" ] && old_goal=\"$(cat \"$goal_file\")\"\n539\t\n540\t  old_file=\"$plan_dir/.goal.old.$$\"\n541\t  new_file=\"$plan_dir/.goal.new.$$\"\n542\t  printf '%s\\n' \"$old_goal\" > \"$old_file\"\n543\t  printf '%s\\n' \"$new_goal\" > \"$new_file\"\n544\t\n545\t  diff_output=\"\"\n546\t  diff_status=127\n547\t  if command -v diff >/dev/null 2>&1; then\n548\t    if diff_output=\"$(diff -u \"$old_file\" \"$new_file\" 2>/dev/null)\"; then\n549\t      diff_status=0\n550\t    else\n551\t      diff_status=$?\n552\t    fi\n553\t  fi\n554\t\n555\t  {\n556\t    printf '===== tick=%s ts=%s overseer=%s =====\\n' \"$round\" \"$ts\" \"$provider\"\n557\t    printf 'REASON: %s\\n' \"$reason\"\n558\t    if [ \"$diff_status\" -le 1 ]; then\n559\t      printf -- '--- DIFF ---\\n'\n560\t      printf '%s\\n' \"$diff_output\"\n561\t    else\n562\t      printf -- '--- AFTER ---\\n'\n563\t      printf '%s\\n' \"$new_goal\"\n564\t    fi\n565\t  } >> \"$history_file\"\n566\t\n567\t  printf '%s\\n' \"$new_goal\" > \"$goal_file\"\n568\t  rm -f \"$old_file\" \"$new_file\"\n569\t\n570\t  summary=\"$(almanac_converge_goal_summary \"$new_goal\")\"\n571\t  printf '[tick=%s] goal updated: %s\\n' \"$round\" \"$summary\" >> \"$log_file\"\n572\t}\n573\t\n574\talmanac_converge_run_finalize() {\n575\t  local root=\"$1\"\n576\t  local run_id=\"$2\"\n577\t  local status=\"$3\"\n578\t  local reason=\"${4:-}\"\n579\t\n580\t  trap - EXIT INT TERM\n581\t  [ -n \"$run_id\" ] || return 0\n582\t  almanac_loop_mark_run_status \"$root\" \"$run_id\" \"$status\" \"\" \"$reason\" >/dev/null 2>&1 || true\n583\t}\n584\t\n585\talmanac_converge_git_user_status() {\n586\t  local root=\"$1\"\n587\t  local plan_dir=\"$2\"\n588\t  local rel_plan\n589\t\n590\t  git -C \"$root\" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1\n591\t  rel_plan=\"${plan_dir#\"$root\"/}\"\n592\t\n593\t  if [ \"$rel_plan\" = \"$plan_dir\" ]; then\n594\t    git -C \"$root\" status --porcelain -- . ':!.almanac'\n595\t  else\n596\t    git -C \"$root\" status --porcelain -- . ':!.almanac' \":!$rel_plan\"\n597\t  fi\n598\t}\n599\t\n600\talmanac_converge_run_worker() {\n601\t  local root=\"$1\"\n602\t  local goal=\"$2\"\n603\t  local exec_cmd=\"$3\"\n604\t  local round=\"$4\"\n605\t  local provider model effort prompt_file result_file events_file plan_dir slug rc\n606\t\n607\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n608\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n609\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n610\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n611\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n612\t\n613\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-prompt.XXXXXX\")\"\n614\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-worker-result.XXXXXX\")\"\n615\t  # Persistent per-round session log under the plan dir (mirrors ralph's\n616\t  # docs/plans/<name>/ralph-codex-iteration-N.log). The full raw event stream\n617\t  # tees here while the filtered agent-message text streams live to the\n618\t  # terminal — operator sees progress, durable log is kept for forensics.\n619\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n620\t\n621\t  almanac_converge_worker_prompt \"$root\" \"$goal\" \"$exec_cmd\" \"$round\" > \"$prompt_file\"\n622\t\n623\t  _info \"Converge round $round — exec-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n624\t\n625\t  # danger-full-access sandbox: converge runs are autonomous-by-design.\n626\t  # `claude --print` has no human to answer a permission prompt, so anything\n627\t  # less than full access dies on every un-allowlisted Bash call (\"This\n628\t  # command requires approval\"). For codex this drops the sandbox; for claude\n629\t  # it maps to --permission-mode bypassPermissions (per the provider adapter).\n630\t  rc=0\n631\t  almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n632\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr || rc=$?\n633\t\n634\t  rm -f \"$prompt_file\" \"$result_file\"\n635\t  return \"$rc\"\n636\t}\n637\t\n638\t# Prompt-mode round: the user's --prompt text IS the agent invocation. No worker\n639\t# template wrapper — the agent receives the prompt verbatim, prefixed only with\n640\t# a one-shot .converge-steer directive if one is queued. This is the dominant\n641\t# mode for \"run skill X in a convergence loop\" workflows; the loop driver\n642\t# handles the bookkeeping (auto-commit + agent-reports.log entry) after the\n643\t# agent exits, instead of asking the agent to know about CONVERGE conventions.\n644\t#\n645\t# Returns the agent's exit code; commit and report writes are best-effort and\n646\t# never alter the return.\n647\t# List every currently-dirty path in $root, one per line, sorted+deduped.\n648\t# Output is the union of:\n649\t#   - tracked-modified paths (`git diff --name-only HEAD`)\n650\t#   - untracked-not-ignored paths (`git ls-files --others --exclude-standard`)\n651\t# Used by the prompt-mode auto-commit to distinguish PRE-EXISTING dirty work\n652\t# (untouched by the agent) from AGENT-TOUCHED paths (commit candidates). Empty\n653\t# string on git failure or non-repo. Pure read-only — safe to call multiple\n654\t# times per round.\n655\talmanac_converge_dirty_paths() {\n656\t  local root=\"$1\"\n657\t  ( cd \"$root\" \\\n658\t      && { git diff --name-only HEAD 2>/dev/null; \\\n659\t           git ls-files --others --exclude-standard 2>/dev/null; } \\\n660\t      | sort -u\n661\t  )\n662\t}\n663\t\n664\t# Auto-commit ONLY the paths the agent newly touched this round, computed as\n665\t# (dirty-after) - (dirty-before). Pre-existing dirty paths are left alone so a\n666\t# concurrent unrelated edit never gets swept into a CONVERGE commit (the bug\n667\t# that caused commit 4526a58 to misattribute the developer's in-flight edits\n668\t# to the agent). Files that were pre-existing dirty AND also touched by the\n669\t# agent stay dirty — conservative; the agent's change in that file isn't\n670\t# committed by this round, but no false attribution happens. Best-effort:\n671\t# commit failure logs a warn and never alters the caller's return code.\n672\t#\n673\t# Args: ROOT SLUG ROUND PRE_DIRTY (newline-separated pre-existing dirty paths)\n674\talmanac_converge_commit_agent_paths() {\n675\t  local root=\"$1\" slug=\"$2\" round=\"$3\" pre_dirty=\"$4\"\n676\t  local post_dirty agent_paths\n677\t\n678\t  post_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n679\t  # comm needs sorted inputs; both producers (almanac_converge_dirty_paths +\n680\t  # the snapshot taken before the agent ran) emit sorted-unique.\n681\t  agent_paths=\"$(comm -23 <(printf '%s\\n' \"$post_dirty\") <(printf '%s\\n' \"$pre_dirty\") | sed '/^$/d')\"\n682\t\n683\t  if [ -z \"$agent_paths\" ]; then\n684\t    # Either the agent didn't change anything OR every change was on a path\n685\t    # that was already dirty (so the change stays uncommitted on purpose).\n686\t    return 0\n687\t  fi\n688\t\n689\t  # Stage each agent-touched path individually (handles deletions, new files,\n690\t  # and modifications — `git add` accepts paths to files that no longer exist\n691\t  # by recording the deletion).\n692\t  local path failed=0\n693\t  while IFS= read -r path; do\n694\t    [ -n \"$path\" ] || continue\n695\t    (cd \"$root\" && git add -- \"$path\" >/dev/null 2>&1) || failed=1\n696\t  done <<< \"$agent_paths\"\n697\t\n698\t  if [ \"$failed\" -eq 1 ]; then\n699\t    _warn \"Converge round $round: staging one or more agent-touched paths failed (changes left in worktree)\"\n700\t    return 0\n701\t  fi\n702\t\n703\t  if ! (cd \"$root\" \\\n704\t          && git -c user.email=converge@almanac -c user.name=converge \\\n705\t                 commit -m \"CONVERGE($slug): round $round\" --no-verify >/dev/null 2>&1); then\n706\t    _warn \"Converge round $round: auto-commit failed (changes left in worktree)\"\n707\t  fi\n708\t}\n709\t\n710\talmanac_converge_run_worker_prompt() {\n711\t  local root=\"$1\"\n712\t  local goal=\"$2\"\n713\t  local prompt=\"$3\"\n714\t  local round=\"$4\"\n715\t  local provider model effort prompt_file result_file events_file rc\n716\t  local slug plan_dir log_file steer_path ts result_summary\n717\t\n718\t  provider=\"$(almanac_converge_role_field \"agent\" \"provider\")\"\n719\t  model=\"$(almanac_converge_role_field \"agent\" \"model\")\"\n720\t  effort=\"$(almanac_converge_role_field \"agent\" \"effort\")\"\n721\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n722\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n723\t  log_file=\"$plan_dir/agent-reports.log\"\n724\t  steer_path=\"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n725\t\n726\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-prompt.XXXXXX\")\"\n727\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-result.XXXXXX\")\"\n728\t  # Persistent per-round session log under the plan dir (same shape as\n729\t  # exec-mode + ralph's per-iteration logs). Streams live to terminal so the\n730\t  # operator sees the agent working; tees the raw stream here for forensics.\n731\t  events_file=\"$plan_dir/converge-${provider}-iteration-${round}.log\"\n732\t\n733\t  # Steer (one-shot): emitted by the overseer in the prior round, consumed and\n734\t  # removed here so the next overseer tick can re-emit if the issue persists.\n735\t  # Steer prefix comes BEFORE the user prompt so a slash command sees the\n736\t  # directive as context before its own work.\n737\t  {\n738\t    if [ -f \"$steer_path\" ]; then\n739\t      printf '# Steer directive (from previous overseer tick):\\n'\n740\t      cat \"$steer_path\"\n741\t      printf '\\n\\n'\n742\t      rm -f \"$steer_path\"\n743\t    fi\n744\t    printf '%s\\n' \"$prompt\"\n745\t  } > \"$prompt_file\"\n746\t\n747\t  _info \"Converge round $round — prompt-mode worker (provider=$provider, log: ${events_file#\"$root\"/})\"\n748\t\n749\t  # Snapshot the dirty worktree BEFORE the agent runs so the auto-commit below\n750\t  # can stage only the paths the agent newly touches — not whatever unrelated\n751\t  # work the operator had in-flight. (Without this snapshot, an earlier `git\n752\t  # add -A` swept up the developer's uncommitted edits and committed them\n753\t  # under the agent's name — bug observed in commit 4526a58.)\n754\t  local pre_dirty\n755\t  pre_dirty=\"$(almanac_converge_dirty_paths \"$root\")\"\n756\t\n757\t  # danger-full-access: same rationale as exec-mode worker — converge agents\n758\t  # need to run arbitrary shell (tests, git status, lint) the prompt asks for.\n759\t  rc=0\n760\t  (cd \"$root\" && almanac_loop_agent_stream \"$provider\" \"$model\" \"$effort\" \"danger-full-access\" \\\n761\t    \"$prompt_file\" \"$result_file\" \"$events_file\" merge-stderr) || rc=$?\n762\t\n763\t  # Auto-commit only the agent-touched paths. A smart prompt may have committed\n764\t  # itself (worktree clean, nothing to do); a slash command like\n765\t  # /almanac:codebase-improve typically doesn't commit, so the driver does it.\n766\t  # Best-effort: a failed commit logs a warn but never alters the return code —\n767\t  # the agent's work itself succeeded or failed, the commit is bookkeeping.\n768\t  almanac_converge_commit_agent_paths \"$root\" \"$slug\" \"$round\" \"$pre_dirty\"\n769\t\n770\t  # Auto-write a minimal self-report. Format mirrors slice-03's worker block\n771\t  # (===== tick=N ts=ISO mode=prompt exit=N =====) so the overseer's parser\n772\t  # treats it the same. result_summary is the first 500 bytes of the agent's\n773\t  # final message — enough for the overseer to see \"what the agent said it\n774\t  # did\" without dragging the full transcript through the prompt budget.\n775\t  ts=\"$(almanac_loop_now_utc)\"\n776\t  result_summary=\"(no agent output)\"\n777\t  if [ -s \"$result_file\" ]; then\n778\t    result_summary=\"$(head -c 500 \"$result_file\")\"\n779\t  fi\n780\t  {\n781\t    printf '\\n===== tick=%s ts=%s mode=prompt exit=%s =====\\n' \"$round\" \"$ts\" \"$rc\"\n782\t    printf 'summary:\\n'\n783\t    printf '%s\\n' \"$result_summary\"\n784\t    printf 'concerns:\\n(none captured — prompt mode does not enforce structured self-report)\\n'\n785\t    printf 'next:\\n(driven by overseer / next-round prompt)\\n'\n786\t  } >> \"$log_file\"\n787\t\n788\t  # events_file is the persistent per-round session log under the plan dir —\n789\t  # NOT removed here. prompt/result are still scratch.\n790\t  rm -f \"$prompt_file\" \"$result_file\"\n791\t  return \"$rc\"\n792\t}\n793\t\n794\talmanac_converge_run_overseer() {\n795\t  local root=\"$1\"\n796\t  local goal=\"$2\"\n797\t  local round=\"$3\"\n798\t  local provider model effort prompt_file result_file events_file result rc plan_dir log_file ts\n799\t\n800\t  provider=\"$(almanac_converge_role_field \"overseer\" \"provider\")\"\n801\t  model=\"$(almanac_converge_role_field \"overseer\" \"model\")\"\n802\t  effort=\"$(almanac_converge_role_field \"overseer\" \"effort\")\"\n803\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$(almanac_loop_slug \"$goal\")\")\"\n804\t  log_file=\"$plan_dir/overseer.log\"\n805\t\n806\t  prompt_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-prompt.XXXXXX\")\"\n807\t  result_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-result.XXXXXX\")\"\n808\t  events_file=\"$(mktemp \"${TMPDIR:-/tmp}/almanac-converge-overseer-events.XXXXXX\")\"\n809\t\n810\t  almanac_converge_overseer_prompt \"$root\" \"$goal\" \"$round\" > \"$prompt_file\"\n811\t\n812\t  rc=0\n813\t  (cd \"$root\" && almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"read-only\" \\\n814\t    \"$prompt_file\" \"$result_file\" \"$events_file\") >/dev/null || rc=$?\n815\t\n816\t  result=\"\"\n817\t  [ -s \"$result_file\" ] && result=\"$(cat \"$result_file\")\"\n818\t  rm -f \"$prompt_file\" \"$result_file\" \"$events_file\"\n819\t\n820\t  [ \"$rc\" -eq 0 ] || _warn \"Converge overseer tick $round exited $rc; continuing\"\n821\t  almanac_converge_overseer_parse \"$result\"\n822\t\n823\t  ts=\"$(almanac_loop_now_utc)\"\n824\t  {\n825\t    printf '\\n===== tick=%s ts=%s overseer=%s exit=%s =====\\n' \"$round\" \"$ts\" \"$provider\" \"$rc\"\n826\t    printf 'VERDICT: %s\\n' \"$ALMANAC_CONVERGE_VERDICT\"\n827\t    printf 'REASON: %s\\n' \"$ALMANAC_CONVERGE_REASON\"\n828\t    printf 'STEER: %s\\n' \"$ALMANAC_CONVERGE_STEER\"\n829\t    printf 'GOAL_UPDATE: %s\\n' \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n830\t  } >> \"$log_file\"\n831\t\n832\t  if [ \"$ALMANAC_CONVERGE_GOAL_UPDATE\" != \"unchanged\" ]; then\n833\t    almanac_converge_apply_goal_update \"$root\" \"$goal\" \"$round\" \"$provider\" \\\n834\t      \"$ALMANAC_CONVERGE_REASON\" \"$ALMANAC_CONVERGE_GOAL_UPDATE\"\n835\t  fi\n836\t\n837\t  case \"$ALMANAC_CONVERGE_VERDICT\" in\n838\t    CONVERGED|STOP)\n839\t      : > \"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n840\t      ;;\n841\t    STEER)\n842\t      if [ \"$ALMANAC_CONVERGE_STEER\" != \"none\" ]; then\n843\t        printf '%s\\n' \"$ALMANAC_CONVERGE_STEER\" > \"$(almanac_loop_run_control_file converge \"$root\" steer)\"\n844\t      fi\n845\t      ;;\n846\t    CONTINUE) ;;\n847\t  esac\n848\t}\n849\t\n850\talmanac_converge_run() {\n851\t  local root=\"$1\"\n852\t  local goal=\"$2\"\n853\t  local exec_cmd=\"$3\"\n854\t  local rounds=\"${4:-${CONVERGE_ROUND_BUDGET:-10}}\"\n855\t  local no_oversee=\"${5:-0}\"\n856\t  local oversee_every=\"${6:-1}\"\n857\t  local prompt=\"${7:-}\"\n858\t  local slug plan_dir run_id pid exec_rc round started_epoch final_status final_verdict final_reason action_mode\n859\t\n860\t  # Mode dispatch: prompt-mode (agent invocation, dominant) vs exec-mode (shell\n861\t  # command in a wrapping worker, escape hatch). cmd/converge.sh enforces the\n862\t  # mutex; here we just pick a label for run-config + dispatch.\n863\t  if [ -n \"$prompt\" ]; then\n864\t    action_mode=\"prompt\"\n865\t  else\n866\t    action_mode=\"exec\"\n867\t  fi\n868\t\n869\t  case \"$rounds\" in\n870\t    ''|*[!0-9]*) _die \"--rounds must be a positive integer: $rounds\" ;;\n871\t  esac\n872\t  [ \"$rounds\" -ge 1 ] || _die \"--rounds must be at least 1: $rounds\"\n873\t\n874\t  case \"$oversee_every\" in\n875\t    ''|*[!0-9]*) _die \"--oversee-every must be a positive integer: $oversee_every\" ;;\n876\t  esac\n877\t  [ \"$oversee_every\" -ge 1 ] || _die \"--oversee-every must be at least 1: $oversee_every\"\n878\t\n879\t  case \"$no_oversee\" in\n880\t    1|true|yes|on) no_oversee=1 ;;\n881\t    *) no_oversee=0 ;;\n882\t  esac\n883\t\n884\t  slug=\"$(almanac_loop_slug \"$goal\")\"\n885\t  pid=\"${BASHPID:-$$}\"\n886\t  started_epoch=\"$(date +%s)\"\n887\t  run_id=\"$(almanac_loop_register_run \"$root\" \"converge\" \"$slug\" \"$pid\")\" \\\n888\t    || _die \"Could not register converge run\"\n889\t\n890\t  local _converge_run_finalize_cmd\n891\t  printf -v _converge_run_finalize_cmd 'almanac_converge_run_finalize %q %q aborted' \"$root\" \"$run_id\"\n892\t  trap \"${_converge_run_finalize_cmd}; exit 130\" INT TERM\n893\t  trap \"${_converge_run_finalize_cmd}\" EXIT\n894\t\n895\t  almanac_loop_set_run_config \"$root\" \"$run_id\" \\\n896\t    \"rounds=$rounds\" \\\n897\t    \"oversee=$([ \"$no_oversee\" -eq 1 ] && printf off || printf 'every-%s' \"$oversee_every\")\" \\\n898\t    >/dev/null 2>&1 || true\n899\t\n900\t  almanac_converge_scaffold \"$root\" \"$goal\"\n901\t  plan_dir=\"$(almanac_converge_plan_dir \"$root\" \"$slug\")\"\n902\t\n903\t  final_status=\"done\"\n904\t  if [ \"$no_oversee\" -eq 1 ]; then\n905\t    final_verdict=\"NO_OVERSEE\"\n906\t    final_reason=\"overseer disabled; round budget exhausted\"\n907\t  else\n908\t    final_verdict=\"CONTINUE\"\n909\t    final_reason=\"round budget exhausted\"\n910\t  fi\n911\t\n912\t  local _converge_stop_file\n913\t  _converge_stop_file=\"$(almanac_loop_run_control_file converge \"$root\" stop)\"\n914\t\n915\t  round=0\n916\t  while [ \"$round\" -lt \"$rounds\" ]; do\n917\t    if [ -f \"$_converge_stop_file\" ]; then\n918\t      final_status=\"aborted\"\n919\t      final_verdict=\"STOP\"\n920\t      final_reason=\"stop signal present before round $((round + 1))\"\n921\t      break\n922\t    fi\n923\t\n924\t    round=$((round + 1))\n925\t    case \"$action_mode\" in\n926\t      prompt)\n927\t        if almanac_converge_run_worker_prompt \"$root\" \"$goal\" \"$prompt\" \"$round\"; then\n928\t          exec_rc=0\n929\t        else\n930\t          exec_rc=$?\n931\t        fi\n932\t        ;;\n933\t      *)\n934\t        if (cd \"$root\" && almanac_converge_run_worker \"$root\" \"$goal\" \"$exec_cmd\" \"$round\"); then\n935\t          exec_rc=0\n936\t        else\n937\t          exec_rc=$?\n938\t        fi\n939\t        ;;\n940\t    esac\n941\t\n942\t    # In exec-mode the worker is authoritative for commits (slice 03 contract).\n943\t    # In prompt-mode the driver already attempted the auto-commit inside the\n944\t    # worker function and will have warned on failure, so the check is skipped\n945\t    # to avoid a duplicate / misleading \"driver will not commit\" message.\n946\t    if [ \"$action_mode\" = \"exec\" ] \\\n947\t       && [ -n \"$(almanac_converge_git_user_status \"$root\" \"$plan_dir\" 2>/dev/null || true)\" ]; then\n948\t      _warn \"Converge round $round: worker left uncommitted changes; driver will not commit\"\n949\t    fi\n950\t\n951\t    if [ \"$exec_rc\" -ne 0 ]; then\n952\t      if [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n953\t        _warn \"Converge round $round exec exited $exec_rc; stopping\"\n954\t      else\n955\t        _warn \"Converge round $round exec exited $exec_rc; continuing\"\n956\t      fi\n957\t    fi\n958\t\n959\t    almanac_loop_update_run_progress \"$root\" \"$run_id\" \"$round\" \"goal=$slug\" >/dev/null 2>&1 || true\n960\t\n961\t    if [ \"$exec_rc\" -ne 0 ] && [ \"${CONVERGE_FAIL_ON_EXEC_ERROR:-0}\" = \"1\" ]; then\n962\t      almanac_converge_write_convergence \"$root\" \"$goal\" \"FAILED\" \"$round\" \"$started_epoch\" \"exec exit=$exec_rc round=$round\"\n963\t      almanac_converge_run_finalize \"$root\" \"$run_id\" \"failed\" \"exec exit=$exec_rc round=$round\"\n964\t      return \"$exec_rc\"\n965\t    fi\n966\t\n967\t    if [ \"$no_oversee\" -eq 0 ] && [ $((round % oversee_every)) -eq 0 ]; then\n968\t      almanac_converge_run_overseer \"$root\" \"$goal\" \"$round\"\n969\t      final_verdict=\"$ALMANAC_CONVERGE_VERDICT\"\n970\t      final_reason=\"$ALMANAC_CONVERGE_REASON\"\n971\t      case \"$ALMANAC_CONVERGE_VERDICT\" in\n972\t        CONVERGED)\n973\t          final_status=\"done\"\n974\t          break\n975\t          ;;\n976\t        STOP)\n977\t          final_status=\"aborted\"\n978\t          break\n979\t          ;;\n980\t      esac\n981\t    fi\n982\t  done\n983\t\n984\t  almanac_converge_write_convergence \"$root\" \"$goal\" \"$final_verdict\" \"$round\" \"$started_epoch\" \"$final_reason\"\n985\t  almanac_converge_run_finalize \"$root\" \"$run_id\" \"$final_status\"\n986\t}\n987\t"}]},"parent_tool_use_id":"toolu_01RmrkhyD6hi6hJV8qXrRsBk","session_id":"048450e6-ddc8-4b99-9d57-06daabf0abc2","uuid":"ac791598-2805-4984-8629-39d00be57b3d","timestamp":"2026-05-27T06:02:18.379Z","subagent_type":"Explore","task_description":"Find architectural friction in lib"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DjaX2vKADQ7q9EbBJHp9Z8","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# run.sh — the run registry: the run-status record, registry, control, worker\n3\t# health, and the hub's read views, owned in one module (per CONTEXT.md's module\n4\t# map). loop-core.sh (the old god-module) is deleted; this is where its registry/\n5\t# control/worker-health/hub-view concerns now live (the worker orchestration /\n6\t# background fan-out lives in lib/worker.sh).\n7\t#\n8\t# A run-status *record* is a per-run status.tsv — one `key<TAB>value` line per\n9\t# field. This module owns the CANONICAL FIELD LIST and the only set/get-by-name\n10\t# accessors for it, so the run-status contract — every run (ralph or harden)\n11\t# carries exactly this key set, in this order — is enforced *by construction*:\n12\t# a caller names only the fields it has values for; the record fills in the rest,\n13\t# and no writer ever enumerates the schema by hand.\n14\t#\n15\t# No lib/core.sh dependency (uses only printf/read/awk/etc), so the record +\n16\t# registry are their own test surface — tests/test-run.sh sources this file\n17\t# directly. The hub read-views compose the gum-or-plain UI seam (lib/ui.sh) and\n18\t# the per-run control dispatches each loop's signal files through its adapter\n19\t# (lib/loops.sh), so source those two idempotently — they are self-contained\n20\t# (no core.sh) too. pwd -P resolves the install symlink so the siblings are found\n21\t# from either path.\n22\tif ! declare -F almanac_loop_ui_render >/dev/null 2>&1; then\n23\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n24\t  # shellcheck source=lib/ui.sh\n25\t  source \"$__run_dir/ui.sh\"\n26\t  unset __run_dir\n27\tfi\n28\t\n29\tif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n30\t  __run_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n31\t  # shellcheck source=lib/loops.sh\n32\t  source \"$__run_dir/loops.sh\"\n33\t  unset __run_dir\n34\tfi\n35\t\n36\t# THE single source of truth for the run-status schema: the canonical field list\n37\t# in write order. record_set iterates exactly this list, so every record carries\n38\t# the same keys regardless of which subset a caller supplies. The first seven are\n39\t# also the registry's index.tsv columns (the lightweight list pointer); the last\n40\t# three (finished_at/round/summary) are the per-run detail the index omits.\n41\talmanac_loop_record_fields() {\n42\t  printf '%s\\n' \\\n43\t    id type target pid status_file started_at status finished_at round summary failure_reason \\\n44\t    provider model effort iterations oversee lenses rounds queue_progress\n45\t}\n46\t\n47\t# Get one field from a record FILE by name. Prints the value (which may itself\n48\t# contain tabs — reassembled from the trailing columns) and returns 0; returns 1\n49\t# when the field is absent. This is the generic tab-field reader for the run\n50\t# registry; almanac_loop_status_field (below) is a thin alias over it for the\n51\t# worker-status and hub read paths.\n52\talmanac_loop_record_get() {\n53\t  local file=\"$1\" wanted=\"$2\" key value rest\n54\t\n55\t  while IFS=$'\\t' read -r key value rest; do\n56\t    if [ \"$key\" = \"$wanted\" ]; then\n57\t      if [ -n \"${rest:-}\" ]; then\n58\t        value=\"${value}\"$'\\t'\"${rest}\"\n59\t      fi\n60\t      printf '%s\\n' \"$value\"\n61\t      return 0\n62\t    fi\n63\t  done < \"$file\"\n64\t\n65\t  return 1\n66\t}\n67\t\n68\t# Generic TSV record engine: rewrite FILE with the schema in FIELDS_TEXT, in\n69\t# canonical order, with each (existing) field preserved unless overridden by a\n70\t# `field=value` PAIR. This is the deep module that owns the round-trip algorithm\n71\t# — schema-specific wrappers (record_set for run-status, worker_record_set for\n72\t# worker-status) just supply their own field list. Returns 2 on a missing file\n73\t# argument or a pair whose field isn't in FIELDS_TEXT.\n74\talmanac_loop_tsv_record_set() {\n75\t  local fields_text=\"$1\" file=\"$2\"\n76\t  shift 2 || return 2\n77\t  [ -n \"$file\" ] || return 2\n78\t\n79\t  local pair pfield field cur val out=\"\"\n80\t  local have_file=0\n81\t  if [ -f \"$file\" ]; then\n82\t    have_file=1\n83\t  fi\n84\t\n85\t  for pair in \"$@\"; do\n86\t    pfield=\"${pair%%=*}\"\n87\t    almanac_loop_tsv_has_field \"$fields_text\" \"$pfield\" || return 2\n88\t  done\n89\t\n90\t  while IFS= read -r field; do\n91\t    [ -n \"$field\" ] || continue\n92\t    cur=\"\"\n93\t    if [ \"$have_file\" = 1 ]; then\n94\t      cur=\"$(almanac_loop_record_get \"$file\" \"$field\" || true)\"\n95\t    fi\n96\t    val=\"$cur\"\n97\t    for pair in \"$@\"; do\n98\t      pfield=\"${pair%%=*}\"\n99\t      if [ \"$pfield\" = \"$field\" ]; then\n100\t        val=\"${pair#*=}\"\n101\t      fi\n102\t    done\n103\t    out=\"${out}${field}\"$'\\t'\"${val}\"$'\\n'\n104\t  done <<< \"$fields_text\"\n105\t\n106\t  printf '%s' \"$out\" > \"$file\"\n107\t}\n108\t\n109\t# True when NAME appears as a field in FIELDS_TEXT (newline-separated schema).\n110\talmanac_loop_tsv_has_field() {\n111\t  local fields_text=\"$1\" wanted=\"$2\" field\n112\t  while IFS= read -r field; do\n113\t    [ \"$field\" = \"$wanted\" ] && return 0\n114\t  done <<< \"$fields_text\"\n115\t  return 1\n116\t}\n117\t\n118\t# True when NAME is a canonical run-status field. Lets record_set reject a typo\n119\t# rather than silently writing a key no reader ever looks for.\n120\talmanac_loop_record_has_field() {\n121\t  almanac_loop_tsv_has_field \"$(almanac_loop_record_fields)\" \"$1\"\n122\t}\n123\t\n124\t# Set one or more run-status fields by name, round-tripping the rest. Each\n125\t# argument is a `field=value` pair (the value may itself contain `=`). The record\n126\t# is rewritten with the FULL canonical key set in canonical order: every\n127\t# canonical field already in the file is preserved unless overridden, and a\n128\t# not-yet-existing file is initialised with every key (blank where unset). So\n129\t# `register` seeds the record by naming only its known fields, while\n130\t# `mark`/`update` change only theirs and leave the rest intact — no caller\n131\t# enumerates the schema. Returns 2 on a missing file argument or a `field=value`\n132\t# whose field is not canonical.\n133\talmanac_loop_record_set() {\n134\t  almanac_loop_tsv_record_set \"$(almanac_loop_record_fields)\" \"$@\"\n135\t}\n136\t\n137\talmanac_loop_slug() {\n138\t  local raw=\"$1\"\n139\t  local slug\n140\t\n141\t  slug=\"$(printf '%s' \"$raw\" \\\n142\t    | tr '[:upper:]' '[:lower:]' \\\n143\t    | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')\"\n144\t\n145\t  if [ -z \"$slug\" ]; then\n146\t    slug=\"run\"\n147\t  fi\n148\t\n149\t  printf '%s\\n' \"$slug\"\n150\t}\n151\t\n152\talmanac_loop_now_utc() {\n153\t  date -u '+%Y-%m-%dT%H:%M:%SZ'\n154\t}\n155\t\n156\talmanac_loop_run_id() {\n157\t  local type=\"$1\"\n158\t  local target=\"$2\"\n159\t  local compact_now\n160\t\n161\t  compact_now=\"$(date -u '+%Y%m%dT%H%M%SZ')\"\n162\t  printf '%s-%s-%s-%s\\n' \\\n163\t    \"$(almanac_loop_slug \"$type\")\" \\\n164\t    \"$(almanac_loop_slug \"$target\")\" \\\n165\t    \"$compact_now\" \\\n166\t    \"$$\"\n167\t}\n168\t\n169\talmanac_loop_registry_dir() {\n170\t  local root=\"${1:-.}\"\n171\t\n172\t  if [ \"$root\" != \"/\" ]; then\n173\t    root=\"${root%/}\"\n174\t  fi\n175\t\n176\t  printf '%s/.almanac/runs\\n' \"$root\"\n177\t}\n178\t\n179\talmanac_loop_run_status_file() {\n180\t  local root=\"$1\"\n181\t  local run_id=\"$2\"\n182\t\n183\t  printf '%s/%s/status.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\" \"$run_id\"\n184\t}\n185\t\n186\talmanac_loop_run_status_relpath() {\n187\t  local run_id=\"$1\"\n188\t\n189\t  printf '.almanac/runs/%s/status.tsv\\n' \"$run_id\"\n190\t}\n191\t\n192\talmanac_loop_run_index_file() {\n193\t  local root=\"$1\"\n194\t\n195\t  printf '%s/index.tsv\\n' \"$(almanac_loop_registry_dir \"$root\")\"\n196\t}\n197\t\n198\t# The run's status.tsv blob — the per-run detail view the hub reads — is the\n199\t# run-status RECORD: its canonical field list and the set/get-by-name accessors\n200\t# (almanac_loop_record_*) live above. The registry functions below seed and\n201\t# update it through that record, so the schema (id/type/target/pid/\n202\t# status_file/started_at/status + the live finished_at/round/summary) is never\n203\t# enumerated here. The index.tsv is a separate lightweight list pointer (the\n204\t# record's first seven fields), written below.\n205\t\n206\t# Thin alias for the record's generic tab-field reader, kept for the worker-status\n207\t# and hub read paths that read a field by name. The implementation (and the\n208\t# run-status record's canonical getter) is almanac_loop_record_get, above.\n209\talmanac_loop_status_field() {\n210\t  almanac_loop_record_get \"$@\"\n211\t}\n212\t\n213\talmanac_loop_register_run() {\n214\t  [ \"$#\" -ge 4 ] || return 2\n215\t\n216\t  local root=\"$1\"\n217\t  local type=\"$2\"\n218\t  local target=\"$3\"\n219\t  local pid=\"$4\"\n220\t  local run_id=\"${5:-}\"\n221\t  local started_at=\"${6:-}\"\n222\t  local registry_dir run_dir status_file status_rel index_file\n223\t\n224\t  [ -n \"$root\" ] || return 2\n225\t  [ -n \"$type\" ] || return 2\n226\t  [ -n \"$target\" ] || return 2\n227\t  [ -n \"$pid\" ] || return 2\n228\t\n229\t  if [ -z \"$run_id\" ]; then\n230\t    run_id=\"$(almanac_loop_run_id \"$type\" \"$target\")\"\n231\t  fi\n232\t\n233\t  if [ -z \"$started_at\" ]; then\n234\t    started_at=\"$(almanac_loop_now_utc)\"\n235\t  fi\n236\t\n237\t  registry_dir=\"$(almanac_loop_registry_dir \"$root\")\"\n238\t  run_dir=\"$registry_dir/$run_id\"\n239\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n240\t  status_rel=\"$(almanac_loop_run_status_relpath \"$run_id\")\"\n241\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n242\t\n243\t  if [ -e \"$run_dir\" ]; then\n244\t    return 3\n245\t  fi\n246\t\n247\t  mkdir -p \"$run_dir\"\n248\t\n249\t  if [ ! -f \"$index_file\" ]; then\n250\t    printf 'id\\ttype\\ttarget\\tpid\\tstatus_file\\tstarted_at\\tstatus\\n' > \"$index_file\"\n251\t  fi\n252\t\n253\t  # Seed the run-status record by naming only the fields known at launch; the\n254\t  # record fills the rest (finished_at/round/summary blank) from the canonical\n255\t  # schema. The index row is the lightweight pointer (the record's first seven\n256\t  # fields).\n257\t  almanac_loop_record_set \"$status_file\" \"id=$run_id\" \"type=$type\" \"target=$target\" \"pid=$pid\" \"status_file=$status_rel\" \"started_at=$started_at\" \"status=running\"\n258\t  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$run_id\" \"$type\" \"$target\" \"$pid\" \"$status_rel\" \"$started_at\" \"running\" >> \"$index_file\"\n259\t  printf '%s\\n' \"$run_id\"\n260\t}\n261\t\n262\t# Set config fields on a run after registration. Thin convenience over record_set\n263\t# that names intent: \"store the resolved launch config so resume can rebuild it.\"\n264\t# Accepts any subset of the config keys (provider/model/effort/iterations/oversee\n265\t# for ralph; provider/model/effort/lenses/rounds for harden). Blank values are\n266\t# acceptable — record_set keeps the field present-but-blank. Returns 2 when the\n267\t# run is unknown so callers can guard without aborting.\n268\talmanac_loop_set_run_config() {\n269\t  [ \"$#\" -ge 3 ] || return 2\n270\t  local root=\"$1\" run_id=\"$2\"; shift 2\n271\t  local status_file\n272\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n273\t  [ -f \"$status_file\" ] || return 2\n274\t  almanac_loop_record_set \"$status_file\" \"$@\"\n275\t}\n276\t\n277\talmanac_loop_mark_run_status() {\n278\t  [ \"$#\" -ge 3 ] || return 2\n279\t\n280\t  local root=\"$1\"\n281\t  local run_id=\"$2\"\n282\t  local status=\"$3\"\n283\t  local finished_at=\"${4:-}\"\n284\t  local reason=\"${5:-}\"\n285\t  local status_file index_file tmp\n286\t\n287\t  case \"$status\" in\n288\t    done|failed|aborted) ;;\n289\t    *) return 3 ;;\n290\t  esac\n291\t\n292\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n293\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n294\t\n295\t  [ -f \"$status_file\" ] || return 2\n296\t  [ -f \"$index_file\" ] || return 2\n297\t\n298\t  if [ -z \"$finished_at\" ]; then\n299\t    finished_at=\"$(almanac_loop_now_utc)\"\n300\t  fi\n301\t\n302\t  tmp=\"$(mktemp \"${index_file}.XXXXXX\")\"\n303\t  if ! awk -v run_id=\"$run_id\" -v status=\"$status\" '\n304\t    BEGIN { FS = OFS = \"\\t\" }\n305\t    NR == 1 { print; next }\n306\t    $1 == run_id { $7 = status; found = 1 }\n307\t    { print }\n308\t    END { if (!found) exit 4 }\n309\t  ' \"$index_file\" > \"$tmp\"; then\n310\t    rm -f \"$tmp\"\n311\t    return 2\n312\t  fi\n313\t  mv \"$tmp\" \"$index_file\"\n314\t\n315\t  # Set only the lifecycle fields; record_set round-trips id/type/target/pid/\n316\t  # status_file/started_at/round/summary, so the schema is never re-enumerated.\n317\t  # An optional 5th arg supplies a one-line failure reason (typically \"exit=N\"\n318\t  # plus a log-tail hint) so the hub can show *why* a run failed, not just that\n319\t  # it did. Blank reason → leave the field as-is (running runs start blank).\n320\t  local _fields=(\"status=$status\" \"finished_at=$finished_at\")\n321\t  [ -n \"$reason\" ] && _fields+=(\"failure_reason=$reason\")\n322\t  almanac_loop_record_set \"$status_file\" \"${_fields[@]}\"\n323\t  # Best-effort end-of-run notification (macOS osascript / Linux notify-send /\n324\t  # terminal-bell fallback). Opt out via ALMANAC_NO_NOTIFY=1. Notification\n325\t  # trouble never sinks the mark — if osascript is missing or notify-send\n326\t  # errors, the run is still correctly marked.\n327\t  almanac_loop_notify_run_end \"$root\" \"$run_id\" >/dev/null 2>&1 || true\n328\t}\n329\t\n330\t# Tell the user a run reached a terminal state. Reads the just-written record so\n331\t# the notification carries type/status/target (and failure_reason on a failed\n332\t# run). Dispatch order: macOS osascript → Linux notify-send → terminal bell\n333\t# fallback (so you at least *hear* a finish on a bare server). Opt out entirely\n334\t# with ALMANAC_NO_NOTIFY=1. ALMANAC_NOTIFY_TEST_SINK (a file path) replaces the\n335\t# OS dispatcher with a write to that file, so tests can assert title+body\n336\t# without a desktop environment.\n337\talmanac_loop_notify_run_end() {\n338\t  [ -z \"${ALMANAC_NO_NOTIFY:-}\" ] || return 0\n339\t  # Skip when there's no terminal attached (tests, daemons, captured output) —\n340\t  # nobody to notify. The test sink bypasses this so unit tests can still assert\n341\t  # the dispatch path without a TTY.\n342\t  if [ -z \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n343\t    [ -t 2 ] || return 0\n344\t  fi\n345\t  local root=\"$1\" run_id=\"$2\"\n346\t  local status_file type status target reason title body body_esc title_esc\n347\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\" 2>/dev/null)\" || return 0\n348\t  [ -f \"$status_file\" ] || return 0\n349\t  type=\"$(almanac_loop_status_field \"$status_file\" type 2>/dev/null || true)\"\n350\t  status=\"$(almanac_loop_status_field \"$status_file\" status 2>/dev/null || true)\"\n351\t  target=\"$(almanac_loop_status_field \"$status_file\" target 2>/dev/null || true)\"\n352\t  reason=\"$(almanac_loop_status_field \"$status_file\" failure_reason 2>/dev/null || true)\"\n353\t  case \"$status\" in done|failed|aborted) ;; *) return 0 ;; esac\n354\t  title=\"almanac · ${type:-run} ${status}\"\n355\t  body=\"${target}${reason:+ — $reason}\"\n356\t  if [ -n \"${ALMANAC_NOTIFY_TEST_SINK:-}\" ]; then\n357\t    printf '%s|%s\\n' \"$title\" \"$body\" >> \"$ALMANAC_NOTIFY_TEST_SINK\"\n358\t    return 0\n359\t  fi\n360\t  if command -v osascript >/dev/null 2>&1; then\n361\t    body_esc=\"$(printf '%s' \"$body\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n362\t    title_esc=\"$(printf '%s' \"$title\" | tr -d '\\n' | sed 's/\"/\\\\\"/g')\"\n363\t    osascript -e \"display notification \\\"$body_esc\\\" with title \\\"$title_esc\\\"\" >/dev/null 2>&1 || true\n364\t  elif command -v notify-send >/dev/null 2>&1; then\n365\t    notify-send \"$title\" \"$body\" >/dev/null 2>&1 || true\n366\t  else\n367\t    printf '\\a' >&2 || true\n368\t  fi\n369\t}\n370\t\n371\t# Update a live run's progress mid-flight: rewrite its status.tsv with a new\n372\t# round (harden round / ralph iteration) and worker/lens summary, preserving the\n373\t# lifecycle status, start, and finish fields. This is the \"updated as it\n374\t# progresses\" half of the run-status contract — the loop calls it each round so\n375\t# the hub's read view reflects current progress. Touches only the per-run blob,\n376\t# not index.tsv (the index stays the lightweight lifecycle pointer). Returns 2\n377\t# when the run has no status file.\n378\talmanac_loop_update_run_progress() {\n379\t  [ \"$#\" -ge 2 ] || return 2\n380\t\n381\t  local root=\"$1\"\n382\t  local run_id=\"$2\"\n383\t  local round=\"${3:-}\"\n384\t  local summary=\"${4:-}\"\n385\t  local status_file\n386\t\n387\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n388\t  [ -f \"$status_file\" ] || return 2\n389\t\n390\t  # Set only the live-progress fields; record_set preserves the identity and\n391\t  # lifecycle (status/start/finish) fields untouched.\n392\t  almanac_loop_record_set \"$status_file\" \"round=$round\" \"summary=$summary\"\n393\t}\n394\t\n395\t# Detect a stale registry entry: a run whose recorded status is still `running`\n396\t# but whose process is gone (crashed/killed without marking itself), so the hub\n397\t# can surface or reap it. Returns 0 (stale) only when status is running AND the\n398\t# pid is not alive — a numeric pid that `kill -0` cannot signal, or a missing/\n399\t# non-numeric pid that cannot be verified. Returns 1 for a live running pid or\n400\t# any terminal status; returns 2 when the run is unknown.\n401\talmanac_loop_run_is_stale() {\n402\t  local root=\"$1\"\n403\t  local run_id=\"$2\"\n404\t  local status_file status pid\n405\t\n406\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n407\t  [ -f \"$status_file\" ] || return 2\n408\t\n409\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n410\t  [ \"$status\" = \"running\" ] || return 1\n411\t\n412\t  pid=\"$(almanac_loop_status_field \"$status_file\" \"pid\" || true)\"\n413\t  case \"$pid\" in\n414\t    ''|*[!0-9]*) return 0 ;;\n415\t  esac\n416\t\n417\t  if kill -0 \"$pid\" 2>/dev/null; then\n418\t    return 1\n419\t  fi\n420\t  return 0\n421\t}\n422\t\n423\t# List every registered run as index.tsv data rows (id/type/target/pid/status-\n424\t# file/start/status), header stripped — the API the hub reads to enumerate runs.\n425\t# Returns 1 when there is no registry or no run has been registered yet, so a\n426\t# caller can branch on \"any runs?\" without parsing.\n427\talmanac_loop_list_runs() {\n428\t  local root=\"$1\"\n429\t  local index_file rows\n430\t\n431\t  index_file=\"$(almanac_loop_run_index_file \"$root\")\"\n432\t  [ -f \"$index_file\" ] || return 1\n433\t\n434\t  rows=\"$(awk 'NR > 1' \"$index_file\")\"\n435\t  [ -n \"$rows\" ] || return 1\n436\t\n437\t  printf '%s\\n' \"$rows\"\n438\t}\n439\t\n440\t# Read a single run's full status.tsv blob — the detail view the hub renders for\n441\t# one run (identity plus live round/summary and finish state). Returns 1 when the\n442\t# run is unknown.\n443\talmanac_loop_read_run() {\n444\t  local root=\"$1\"\n445\t  local run_id=\"$2\"\n446\t  local status_file\n447\t\n448\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n449\t  [ -f \"$status_file\" ] || return 1\n450\t\n451\t  cat \"$status_file\"\n452\t}\n453\t\n454\talmanac_loop_worker_dir() {\n455\t  local root=\"$1\"\n456\t  local run_id=\"$2\"\n457\t  local worker_id=\"$3\"\n458\t\n459\t  printf '%s/%s/workers/%s\\n' \\\n460\t    \"$(almanac_loop_registry_dir \"$root\")\" \\\n461\t    \"$run_id\" \\\n462\t    \"$(almanac_loop_slug \"$worker_id\")\"\n463\t}\n464\t\n465\talmanac_loop_worker_status_file() {\n466\t  local root=\"$1\"\n467\t  local run_id=\"$2\"\n468\t  local worker_id=\"$3\"\n469\t\n470\t  printf '%s/status.tsv\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\"\n471\t}\n472\t\n473\talmanac_loop_worker_file() {\n474\t  local root=\"$1\"\n475\t  local run_id=\"$2\"\n476\t  local worker_id=\"$3\"\n477\t  local filename=\"$4\"\n478\t\n479\t  printf '%s/%s\\n' \"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\" \"$filename\"\n480\t}\n481\t\n482\t# --- Worker health detection ---------------------------------------------------\n483\t#\n484\t# Classify a worker's health from progress signals so the dashboard can surface a\n485\t# reviewer that is stalled (log stopped advancing), idle (running but never\n486\t# produced an event), or looping (emitting the same event over and over) rather\n487\t# than the operator discovering it by hand. The classifier is a PURE predicate\n488\t# over already-gathered numbers, so it is table-testable with no files, clock, or\n489\t# terminal; the gather wrapper (almanac_loop_worker_health_of) feeds it real run\n490\t# state.\n491\t\n492\t# Pure predicate: (status, log-age-secs, event-count, trailing-repeat-count,\n493\t# stall-threshold-secs, loop-repeat-threshold) -> one of\n494\t# running|stalled|idle|looping|done|failed. A terminal status passes straight\n495\t# through. For a live worker: a trailing run of identical events at/over the loop\n496\t# threshold is a loop; otherwise zero events past the stall threshold is idle, any\n497\t# log silence past the stall threshold is stalled, and anything else is running.\n498\talmanac_loop_worker_health() {\n499\t  local status=\"${1:-running}\"\n500\t  local age=\"${2:-0}\"\n501\t  local count=\"${3:-0}\"\n502\t  local repeat=\"${4:-0}\"\n503\t  local stall=\"${5:-120}\"\n504\t  local loop=\"${6:-5}\"\n505\t\n506\t  case \"$status\" in\n507\t    done)   printf '%s\\n' \"done\";   return 0 ;;\n508\t    failed) printf '%s\\n' \"failed\"; return 0 ;;\n509\t  esac\n510\t\n511\t  if [ \"$loop\" -gt 0 ] && [ \"$repeat\" -ge \"$loop\" ]; then\n512\t    printf '%s\\n' \"looping\"; return 0\n513\t  fi\n514\t  if [ \"$count\" -eq 0 ] && [ \"$age\" -ge \"$stall\" ]; then\n515\t    printf '%s\\n' \"idle\"; return 0\n516\t  fi\n517\t  if [ \"$age\" -ge \"$stall\" ]; then\n518\t    printf '%s\\n' \"stalled\"; return 0\n519\t  fi\n520\t  printf '%s\\n' \"running\"\n521\t}\n522\t\n523\t# Seconds since a file was last modified (now - mtime). Prints -1 when the file is\n524\t# absent. now-epoch is overridable (tests) so age is deterministic. Handles both\n525\t# BSD/macOS (stat -f %m) and GNU/Linux (stat -c %Y).\n526\talmanac_loop_file_age_secs() {\n527\t  local file=\"$1\"\n528\t  local now=\"${2:-}\"\n529\t  local mtime\n530\t\n531\t  [ -f \"$file\" ] || { printf '%s\\n' \"-1\"; return 0; }\n532\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n533\t  mtime=\"$(stat -f %m \"$file\" 2>/dev/null || stat -c %Y \"$file\" 2>/dev/null || printf '%s' \"\")\"\n534\t  [ -n \"$mtime\" ] || { printf '%s\\n' \"-1\"; return 0; }\n535\t  printf '%s\\n' \"$((now - mtime))\"\n536\t}\n537\t\n538\t# Count lines in a file (0 when absent). awk NR counts a final unterminated line.\n539\talmanac_loop_count_lines() {\n540\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n541\t  awk 'END { print NR }' \"$1\"\n542\t}\n543\t\n544\t# Count the trailing run of identical lines at the end of a file (0 when absent or\n545\t# empty, 1 when the last line is unique). A long run is the loop signal.\n546\talmanac_loop_trailing_repeat() {\n547\t  [ -f \"$1\" ] || { printf '%s\\n' \"0\"; return 0; }\n548\t  awk '\n549\t    NR == 1 { last = $0; c = 1; next }\n550\t    $0 == last { c++; next }\n551\t    { last = $0; c = 1 }\n552\t    END {\n553\t      if (NR == 0) { print 0; exit }\n554\t      print c\n555\t    }\n556\t  ' \"$1\"\n557\t}\n558\t\n559\t# Gather one worker's real run state and classify its health. Reads the worker's\n560\t# status.tsv (status + events-log path), measures the log's age/size/trailing\n561\t# repeat, and returns the pure predicate's verdict. Prints \"unknown\" when the\n562\t# worker has no status file yet. now/stall/loop are overridable.\n563\talmanac_loop_worker_health_of() {\n564\t  local root=\"$1\"\n565\t  local run_id=\"$2\"\n566\t  local worker_id=\"$3\"\n567\t  local now=\"${4:-}\"\n568\t  local stall=\"${5:-120}\"\n569\t  local loop=\"${6:-5}\"\n570\t  local status_file status events_file age count repeat\n571\t\n572\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n573\t  [ -f \"$status_file\" ] || { printf '%s\\n' \"unknown\"; return 0; }\n574\t\n575\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n576\t  events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n577\t\n578\t  [ -n \"$now\" ] || now=\"$(date +%s)\"\n579\t  age=\"$(almanac_loop_file_age_secs \"$events_file\" \"$now\")\"\n580\t  count=\"$(almanac_loop_count_lines \"$events_file\")\"\n581\t  repeat=\"$(almanac_loop_trailing_repeat \"$events_file\")\"\n582\t  [ \"$age\" -ge 0 ] 2>/dev/null || age=0\n583\t\n584\t  almanac_loop_worker_health \"${status:-running}\" \"$age\" \"$count\" \"$repeat\" \"$stall\" \"$loop\"\n585\t}\n586\t\n587\t# --- Hub overview --------------------------------------------------------------\n588\t#\n589\t# The interactive hub (`almanac` in a TTY, or `almanac hub`) is the front door to\n590\t# every loop. Its read views are PURE registry projections so they are testable\n591\t# off a terminal and degrade to plain text without gum; the interactive menus\n592\t# (new-run, per-run watch/stop/steer) layer on top of these.\n593\t\n594\t# Project the run registry into one of the hub's two lists as plain printable\n595\t# rows (text only — gum frames them later, so this stays unit-testable off a\n596\t# TTY). `which` selects the section:\n597\t#   running — every run whose lifecycle status is still `running`, carrying its\n598\t#             live round/summary from the run-status blob; a running entry whose\n599\t#             pid is gone is surfaced as `stale` (almanac_loop_run_is_stale) so a\n600\t#             crashed run is visible rather than silently lost.\n601\t#   recent  — the finished runs (done/failed/aborted), newest finish first,\n602\t#             capped at `limit` (default 10).\n603\t# Each row is \"<glyph>  <state>  <type>  <target>  <detail>  [<id>]\". Returns 1\n604\t# (no rows) when the section is empty so the caller can print an empty-state line.\n605\talmanac_loop_hub_render() {\n606\t  local root=\"$1\"\n607\t  local which=\"$2\"\n608\t  local limit=\"${3:-10}\"\n609\t  local rows id type target pid status_rel started status\n610\t  local blob round summary finished detail glyph live count reason_field display queue\n611\t\n612\t  rows=\"$(almanac_loop_list_runs \"$root\")\" || return 1\n613\t  count=0\n614\t\n615\t  if [ \"$which\" = \"recent\" ]; then\n616\t    local sortable=\"\"\n617\t    while IFS=$'\\t' read -r id type target pid status_rel started status; do\n618\t      [ -n \"$id\" ] || continue\n619\t      case \"$status\" in\n620\t        done|failed|aborted) ;;\n621\t        *) continue ;;\n622\t      esac\n623\t      blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n624\t      finished=\"$(almanac_loop_status_field \"$blob\" \"finished_at\" 2>/dev/null || true)\"\n625\t      [ -n \"$finished\" ] || finished=\"$started\"\n626\t      reason_field=\"\"\n627\t      if [ \"$status\" = \"failed\" ]; then\n628\t        reason_field=\"$(almanac_loop_status_field \"$blob\" \"failure_reason\" 2>/dev/null || true)\"\n629\t      fi\n630\t      sortable+=\"$finished\"$'\\t'\"$id\"$'\\t'\"$type\"$'\\t'\"$target\"$'\\t'\"$status\"$'\\t'\"$reason_field\"$'\\n'\n631\t    done <<< \"$rows\"\n632\t    [ -n \"$sortable\" ] || return 1\n633\t    while IFS=$'\\t' read -r finished id type target status reason_field; do\n634\t      [ -n \"$id\" ] || continue\n635\t      glyph=\"$(almanac_loop_ui_status_glyph \"$status\")\"\n636\t      display=\"$finished\"\n637\t      if [ \"$status\" = \"failed\" ] && [ -n \"$reason_field\" ]; then\n638\t        display=\"$finished — $reason_field\"\n639\t      fi\n640\t      printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$status\" \"$type\" \"$target\" \"$display\" \"$id\"\n641\t      count=$((count + 1))\n642\t      if [ \"$count\" -ge \"$limit\" ]; then break; fi\n643\t    done < <(printf '%s' \"$sortable\" | sort -t$'\\t' -k1,1r)\n644\t    if [ \"$count\" -gt 0 ]; then return 0; fi\n645\t    return 1\n646\t  fi\n647\t\n648\t  # which == running (default)\n649\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n650\t    [ -n \"$id\" ] || continue\n651\t    [ \"$status\" = \"running\" ] || continue\n652\t    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n653\t    round=\"$(almanac_loop_status_field \"$blob\" \"round\" 2>/dev/null || true)\"\n654\t    summary=\"$(almanac_loop_status_field \"$blob\" \"summary\" 2>/dev/null || true)\"\n655\t    queue=\"$(almanac_loop_status_field \"$blob\" \"queue_progress\" 2>/dev/null || true)\"\n656\t    live=\"running\"\n657\t    if almanac_loop_run_is_stale \"$root\" \"$id\"; then\n658\t      live=\"stale\"\n659\t    fi\n660\t    glyph=\"$(almanac_loop_ui_status_glyph \"$live\")\"\n661\t    detail=\"\"\n662\t    if [ -n \"$round\" ]; then detail=\"round $round\"; fi\n663\t    if [ -n \"$summary\" ]; then detail=\"${detail:+$detail  }$summary\"; fi\n664\t    if [ -n \"$queue\" ]; then detail=\"${detail:+$detail  }queue $queue\"; fi\n665\t    if [ -z \"$detail\" ]; then detail=\"—\"; fi\n666\t    printf '%s  %s  %s  %s  %s  [%s]\\n' \"$glyph\" \"$live\" \"$type\" \"$target\" \"$detail\" \"$id\"\n667\t    count=$((count + 1))\n668\t  done <<< \"$rows\"\n669\t  if [ \"$count\" -gt 0 ]; then return 0; fi\n670\t  return 1\n671\t}\n672\t\n673\t# Compose the hub's read-only overview screen: a Running section (live loops from\n674\t# the registry) and a Recent section (last finished loops), each framed through\n675\t# the shared ui renderer so it shows as a gum panel on a TTY and plain text\n676\t# without gum. This is the whole hub output off a TTY and the status screen the\n677\t# interactive hub draws around its menu. Each section prints an empty-state line\n678\t# when there are no matching runs.\n679\talmanac_loop_hub_overview() {\n680\t  local root=\"$1\"\n681\t  local recent_limit=\"${2:-10}\"\n682\t  local running recent\n683\t\n684\t  {\n685\t    printf '%s\\n' \"almanac — loop hub\"\n686\t    printf '\\n'\n687\t    printf '%s\\n' \"Running\"\n688\t    if running=\"$(almanac_loop_hub_render \"$root\" running)\"; then\n689\t      printf '%s\\n' \"$running\"\n690\t    else\n691\t      printf '%s\\n' \"  (no running loops)\"\n692\t    fi\n693\t    printf '\\n'\n694\t    printf '%s\\n' \"Recent\"\n695\t    if recent=\"$(almanac_loop_hub_render \"$root\" recent \"$recent_limit\")\"; then\n696\t      printf '%s\\n' \"$recent\"\n697\t    else\n698\t      printf '%s\\n' \"  (no recent loops)\"\n699\t    fi\n700\t  } | almanac_loop_ui_render\n701\t}\n702\t\n703\t# Aggregate finished runs (done/failed/aborted) by (type, provider, model) and\n704\t# print a small table: runs + success rate. Reads provider/model from each run's\n705\t# blob, so older runs (no recorded config) bucket under `?` for the missing\n706\t# fields rather than disappearing. Returns 1 (with no output) when the registry\n707\t# has no finished runs, so the caller can print an empty-state line.\n708\t#\n709\t# Pipeline is `read registry rows → emit (type,provider,model,status) lines →\n710\t# awk groups + counts → sort by total runs desc → awk reformats with a header`.\n711\t# Pure data + awk so the table is identical with or without gum (the caller\n712\t# frames it).\n713\talmanac_loop_hub_stats() {\n714\t  local root=\"$1\"\n715\t  local rows lines id type target pid status_rel started status blob provider model\n716\t  rows=\"$(almanac_loop_list_runs \"$root\" 2>/dev/null)\" || return 1\n717\t  [ -n \"$rows\" ] || return 1\n718\t\n719\t  lines=\"\"\n720\t  while IFS=$'\\t' read -r id type target pid status_rel started status; do\n721\t    [ -n \"$id\" ] || continue\n722\t    case \"$status\" in done|failed|aborted) ;; *) continue ;; esac\n723\t    blob=\"$(almanac_loop_run_status_file \"$root\" \"$id\")\"\n724\t    provider=\"$(almanac_loop_status_field \"$blob\" provider 2>/dev/null || true)\"\n725\t    model=\"$(almanac_loop_status_field \"$blob\" model 2>/dev/null || true)\"\n726\t    lines+=\"$type\"$'\\t'\"${provider:-?}\"$'\\t'\"${model:-?}\"$'\\t'\"$status\"$'\\n'\n727\t  done <<< \"$rows\"\n728\t  [ -n \"$lines\" ] || return 1\n729\t\n730\t  printf '%s' \"$lines\" | awk -F'\\t' '\n731\t    {\n732\t      key = $1 \"|\" $2 \"|\" $3\n733\t      total[key]++\n734\t      if ($4 == \"done\") done[key]++\n735\t    }\n736\t    END {\n737\t      for (k in total) {\n738\t        n = total[k]; d = (k in done) ? done[k] : 0\n739\t        rate = (n > 0) ? (d * 100.0 / n) : 0\n740\t        split(k, kk, \"|\")\n741\t        printf \"%s\\t%s\\t%s\\t%d\\t%.0f\\n\", kk[1], kk[2], kk[3], n, rate\n742\t      }\n743\t    }\n744\t  ' | sort -t$'\\t' -k4,4 -n -r | awk -F'\\t' '\n745\t    BEGIN { printf \"%-8s %-8s %-22s %6s %8s\\n\", \"type\", \"provider\", \"model\", \"runs\", \"success\" }\n746\t    { printf \"%-8s %-8s %-22s %6d %7d%%\\n\", $1, $2, $3, $4, $5 }\n747\t  '\n748\t  return 0\n749\t}\n750\t\n751\t# --- Hub per-run actions -------------------------------------------------------\n752\t#\n753\t# The interactive hub lets the operator act on a selected running loop: watch its\n754\t# live status, stop it, or queue a steer directive for its next round. These are\n755\t# pure-ish file/signal operations (no gum, no menu), so they are unit-testable and\n756\t# also drivable non-interactively (`almanac hub --stop|--steer|--watch <id>`); the\n757\t# gum selection menu in cmd/hub.sh is a thin TTY layer over them.\n758\t\n759\t# Map a run type + signal kind to the dot-file basename the loop's runner watches\n760\t# for between rounds. Thin pass-through to almanac_loop_signal_file (lib/loops.sh),\n761\t# which resolves the adapter's override if any else the standard `.${type}-${kind}`\n762\t# default — so this run-registry layer is independent of which loops opt to use\n763\t# the default and which override. Prints the basename; returns 1 for an unknown\n764\t# type or kind.\n765\talmanac_loop_run_signal_file() {\n766\t  almanac_loop_signal_file \"$1\" \"$2\"\n767\t}\n768\t\n769\t# Absolute path to a loop's between-round control file under BASE: BASE joined with\n770\t# the type's stop|steer dot-file basename (`<base>/.harden-stop`, …). Centralises\n771\t# the harden/converge pattern of \"look up the signal file, prepend the path\" so\n772\t# each loop's core stops re-implementing its own _control_file wrapper. Returns 1\n773\t# when the loop type or kind is unknown.\n774\talmanac_loop_run_control_file() {\n775\t  local type=\"$1\" base=\"$2\" kind=\"$3\"\n776\t  local name\n777\t  name=\"$(almanac_loop_run_signal_file \"$type\" \"$kind\")\" || return 1\n778\t  printf '%s/%s\\n' \"$base\" \"$name\"\n779\t}\n780\t\n781\t# Stop a registered running run: write the run type's stop file under root (runs\n782\t# register with root = their working dir, so the loop sees it at its next\n783\t# between-round check). The registry lives in the project and is not trusted for\n784\t# host PID signaling, so hub stop never sends TERM from a recorded pid. Returns 2\n785\t# when the run is unknown, 3 when its type has no stop convention, and 4 when the\n786\t# run is already terminal/non-running.\n787\talmanac_loop_run_stop() {\n788\t  local root=\"$1\"\n789\t  local run_id=\"$2\"\n790\t  local status_file type status stop_file\n791\t\n792\t  status_file=\"$(almanac_loop_run_status_file \"$root\" \"$run_id\")\"\n793\t  [ -f \"$status_file\" ] || return 2\n794\t\n795\t  type=\"$(almanac_loop_status_field \"$status_file\" \"type\" || true)\"\n796\t  status=\"$(almanac_loop_status_field \"$status_file\" \"status\" || true)\"\n797\t  [ \"$status\" = \"running\" ] || return 4\n798\t\n799\t  stop_file=\"$(almanac_loop_run_signal_file \"$type\" stop)\" || return 3\n800\t  printf '%s\\n' \"stop requested via almanac hub: $run_id\" > \"$root/$stop_file\""}]},"parent_tool_use_id":"toolu_01RmrkhyD6hi6hJV8qXrRsBk","session_id":"048450e6-ddc8-4b99-9d57-06daabf0abc2","uuid":"1b1a8307-4aaa-43a3-bfc2-6365674b91e2","timestamp":"2026-05-27T06:02:18.386Z","subagent_type":"Explore","task_description":"Find architectural friction in lib"}
