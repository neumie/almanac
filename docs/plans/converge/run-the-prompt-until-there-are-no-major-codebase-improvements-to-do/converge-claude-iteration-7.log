e/almanac/cmd/help.sh:17:echo \"  harden <target> --fix  Run one sequential fixer over open blocking findings + feedback loops\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:18:echo \"  harden <target> --loop Run the convergence loop (rounds) until converged or budget hit\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:19:echo \"                         (HITL checkpoint each round: ship / continue / steer)\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:20:echo \"  harden <target> --watch  Redraw the live supervision dashboard for the latest run\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:21:echo \"  harden <target> --watch-worker <lens>  Stream one reviewer's live event log\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:22:echo \"  converge --goal <goal> --exec <cmd> [--rounds N]\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:23:echo \"                         Run one generic convergence exec round (slice 01)\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:24:echo \"  update                 Update almanac (git pull)\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:25:echo \"  sync                   Check adapted skills for upstream changes\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:26:echo \"  doctor                 Report optional-dependency status (gum, gh, jq)\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/help.sh:27:echo \"  help                   Show this help\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/install.sh:95:    echo \"\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/list.sh:6:echo \"Available providers:\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/list.sh:9:    echo -e \"  ${_GREEN}$provider${_RESET}  (installed)\"\n/Users/jakubneumann/Documents/code/neumie/almanac/cmd/list.sh:11:    echo \"  $provider\"","is_error":false}]},"parent_tool_use_id"