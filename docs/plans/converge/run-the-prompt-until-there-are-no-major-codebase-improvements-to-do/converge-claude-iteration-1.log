{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018wMhsrZEqLq7PxoSCUofgZ","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# test-run.sh - run registry tests (lib/run.sh)\n3\t#\n4\t# Sources lib/run.sh DIRECTLY (its interface is its own test surface) — loop-core.sh\n5\t# was deleted and its run registry, control, worker-health, and hub read-views moved\n6\t# into lib/run.sh, alongside the run-status record it already owned. These tests pin:\n7\t#   - the run-status RECORD: canonical field list, set/get-by-name, round-trip write,\n8\t#     unknown-field rejection, identical-key-set-by-construction\n9\t#   - the run REGISTRY: register/mark/update, staleness, list/read\n10\t#   - WORKER HEALTH: the pure classifier + the gather wrapper\n11\t#   - the HUB read-views: running/recent render, overview, per-run detail/watch\n12\t#   - CONTROL: stop/steer signal-file dispatch (via the loop adapter)\n13\t#   - the NEW-RUN composer: argv/env for ralph + harden\n14\t# The worker ORCHESTRATION (background fan-out) lives in lib/worker.sh and is\n15\t# tested in tests/test-worker.sh.\n16\t\n17\tset -euo pipefail\n18\t\n19\tROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n20\tsource \"$ROOT/lib/run.sh\"\n21\t\n22\tTMPDIRS=()\n23\tNEW_TMPDIR=\"\"\n24\t\n25\tcleanup() {\n26\t  local dir\n27\t  [ \"${#TMPDIRS[@]}\" -eq 0 ] && return 0\n28\t  for dir in \"${TMPDIRS[@]}\"; do\n29\t    rm -rf \"$dir\"\n30\t  done\n31\t}\n32\ttrap cleanup EXIT\n33\t\n34\tfail() {\n35\t  echo \"  FAIL: $1\" >&2\n36\t  exit 1\n37\t}\n38\t\n39\tassert_eq() {\n40\t  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n41\t  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n42\t}\n43\t\n44\tassert_file_contains() {\n45\t  local file=\"$1\" needle=\"$2\" message=\"$3\"\n46\t  grep -Fq -- \"$needle\" \"$file\" || fail \"$message\"\n47\t}\n48\t\n49\tassert_contains() {\n50\t  local haystack=\"$1\" needle=\"$2\" message=\"$3\"\n51\t  case \"$haystack\" in\n52\t    *\"$needle\"*) ;;\n53\t    *) fail \"$message\" ;;\n54\t  esac\n55\t}\n56\t\n57\tnew_tmpdir() {\n58\t  NEW_TMPDIR=$(mktemp -d)\n59\t  TMPDIRS+=(\"$NEW_TMPDIR\")\n60\t}\n61\t\n62\ttest_record_fields_is_canonical_schema() {\n63\t  local expected actual\n64\t  expected=$(printf '%s\\n' \\\n65\t    id type target pid status_file started_at status finished_at round summary failure_reason \\\n66\t    provider model effort iterations oversee lenses rounds queue_progress)\n67\t  actual=\"$(almanac_loop_record_fields)\"\n68\t  assert_eq \"$expected\" \"$actual\" \"record_fields must be the canonical run-status schema, in order\"\n69\t  echo \"  PASS: record_fields is the canonical schema\"\n70\t}\n71\t\n72\ttest_record_has_field_recognises_only_canonical() {\n73\t  almanac_loop_record_has_field \"id\" || fail \"id must be a canonical field\"\n74\t  almanac_loop_record_has_field \"summary\" || fail \"summary must be a canonical field\"\n75\t  if almanac_loop_record_has_field \"bogus\"; then\n76\t    fail \"a non-canonical field must not be recognised\"\n77\t  fi\n78\t  echo \"  PASS: record_has_field recognises only canonical fields\"\n79\t}\n80\t\n81\ttest_record_set_initialises_full_key_set() {\n82\t  local tmp file keys expected\n83\t  new_tmpdir; tmp=\"$NEW_TMPDIR\"; file=\"$tmp/status.tsv\"\n84\t\n85\t  # Name only a subset; the record must still carry EVERY canonical key in order.\n86\t  almanac_loop_record_set \"$file\" \"id=r1\" \"type=ralph\" \"status=running\"\n87\t\n88\t  keys=\"$(cut -f1 \"$file\")\"\n89\t  expected=\"$(almanac_loop_record_fields)\"\n90\t  assert_eq \"$expected\" \"$keys\" \"a fresh record must carry every canonical key in order\"\n91\t  assert_eq \"r1\" \"$(almanac_loop_record_get \"$file\" id)\" \"supplied id must be set\"\n92\t  assert_eq \"ralph\" \"$(almanac_loop_record_get \"$file\" type)\" \"supplied type must be set\"\n93\t  assert_eq \"running\" \"$(almanac_loop_record_get \"$file\" status)\" \"supplied status must be set\"\n94\t  assert_eq \"\" \"$(almanac_loop_record_get \"$file\" summary)\" \"an unsupplied field must be present but blank\"\n95\t  echo \"  PASS: record_set initialises the full canonical key set\"\n96\t}\n97\t\n98\ttest_record_set_round_trips_untouched_fields() {\n99\t  local tmp file\n100\t  new_tmpdir; tmp=\"$NEW_TMPDIR\"; file=\"$tmp/status.tsv\"\n101\t\n102\t  almanac_loop_record_set \"$file\" \\\n103\t    \"id=r1\" \"type=harden\" \"target=src/app.js\" \"pid=42\" \"status=running\" \"started_at=T0\"\n104\t  # update only live progress\n105\t  almanac_loop_record_set \"$file\" \"round=3\" \"summary=lenses=security open-blocking=2\"\n106\t  # mark terminal\n107\t  almanac_loop_record_set \"$file\" \"status=done\" \"finished_at=T1\"\n108\t\n109\t  assert_eq \"r1\"         \"$(almanac_loop_record_get \"$file\" id)\"          \"id preserved across sets\"\n110\t  assert_eq \"harden\"     \"$(almanac_loop_record_get \"$file\" type)\"        \"type preserved\"\n111\t  assert_eq \"src/app.js\" \"$(almanac_loop_record_get \"$file\" target)\"      \"target preserved\"\n112\t  assert_eq \"42\"         \"$(almanac_loop_record_get \"$file\" pid)\"         \"pid preserved\"\n113\t  assert_eq \"T0\"         \"$(almanac_loop_record_get \"$file\" started_at)\"  \"started_at preserved\"\n114\t  assert_eq \"3\"          \"$(almanac_loop_record_get \"$file\" round)\"       \"round set\"\n115\t  assert_eq \"lenses=security open-blocking=2\" \\\n116\t    \"$(almanac_loop_record_get \"$file\" summary)\" \"a value containing '=' is preserved verbatim\"\n117\t  assert_eq \"done\"       \"$(almanac_loop_record_get \"$file\" status)\"      \"status updated\"\n118\t  assert_eq \"T1\"         \"$(almanac_loop_record_get \"$file\" finished_at)\" \"finished_at set\"\n119\t  echo \"  PASS: record_set round-trips untouched fields\"\n120\t}\n121\t\n122\ttest_record_get_absent_field_returns_nonzero() {\n123\t  local tmp file rc\n124\t  new_tmpdir; tmp=\"$NEW_TMPDIR\"; file=\"$tmp/status.tsv\"\n125\t  printf 'id\\tr1\\n' > \"$file\"   # a partial record missing most keys\n126\t\n127\t  rc=0; almanac_loop_record_get \"$file\" \"summary\" >/dev/null || rc=$?\n128\t  assert_eq \"1\" \"$rc\" \"record_get must return 1 for an absent field\"\n129\t  echo \"  PASS: record_get returns non-zero for an absent field\"\n130\t}\n131\t\n132\ttest_record_set_rejects_unknown_field() {\n133\t  local tmp file rc\n134\t  new_tmpdir; tmp=\"$NEW_TMPDIR\"; file=\"$tmp/status.tsv\"\n135\t\n136\t  rc=0; almanac_loop_record_set \"$file\" \"bogus=x\" || rc=$?\n137\t  assert_eq \"2\" \"$rc\" \"record_set must reject a non-canonical field\"\n138\t  if [ -f \"$file\" ]; then\n139\t    fail \"record_set must not write the file when an override is rejected\"\n140\t  fi\n141\t  echo \"  PASS: record_set rejects unknown fields\"\n142\t}\n143\t\n144\ttest_record_set_requires_file_arg() {\n145\t  local rc\n146\t  rc=0; almanac_loop_record_set \"\" \"status=done\" || rc=$?\n147\t  assert_eq \"2\" \"$rc\" \"record_set must require a file path\"\n148\t  echo \"  PASS: record_set requires a file argument\"\n149\t}\n150\t\n151\ttest_records_share_identical_key_set_by_construction() {\n152\t  local tmp ralph harden ralph_keys harden_keys\n153\t  new_tmpdir; tmp=\"$NEW_TMPDIR\"\n154\t  ralph=\"$tmp/ralph.tsv\"; harden=\"$tmp/harden.tsv\"\n155\t\n156\t  # Two loops set DIFFERENT subsets — the key set must still be identical because\n157\t  # both writes iterate the one canonical field list.\n158\t  almanac_loop_record_set \"$ralph\" \\\n159\t    \"id=a\" \"type=ralph\" \"target=prd.md\" \"status=running\"\n160\t  almanac_loop_record_set \"$harden\" \\\n161\t    \"id=b\" \"type=harden\" \"target=src/x.js\" \"status=running\" \"round=1\" \"summary=lenses=security\"\n162\t\n163\t  ralph_keys=\"$(cut -f1 \"$ralph\")\"\n164\t  harden_keys=\"$(cut -f1 \"$harden\")\"\n165\t  assert_eq \"$ralph_keys\" \"$harden_keys\" \\\n166\t    \"ralph and harden records must carry an identical key set by construction\"\n167\t  assert_eq \"$(almanac_loop_record_fields)\" \"$ralph_keys\" \\\n168\t    \"the shared key set must be the canonical schema\"\n169\t  echo \"  PASS: records share an identical key set by construction\"\n170\t}\n171\t\n172\ttest_registers_run_in_registry() {\n173\t  local tmp run_id status_file index_file expected_index\n174\t  new_tmpdir\n175\t  tmp=\"$NEW_TMPDIR\"\n176\t\n177\t  run_id=\"$(almanac_loop_register_run \"$tmp\" \"harden\" \"src/app.js\" \"4242\" \"harden-src-app-js-001\" \"2026-05-25T12:00:00Z\")\"\n178\t  status_file=\"$tmp/.almanac/runs/harden-src-app-js-001/status.tsv\"\n179\t  index_file=\"$tmp/.almanac/runs/index.tsv\"\n180\t\n181\t  expected_index=$(cat <<'EOF'\n182\tid\ttype\ttarget\tpid\tstatus_file\tstarted_at\tstatus\n183\tharden-src-app-js-001\tharden\tsrc/app.js\t4242\t.almanac/runs/harden-src-app-js-001/status.tsv\t2026-05-25T12:00:00Z\trunning\n184\tEOF\n185\t)\n186\t\n187\t  assert_eq \"harden-src-app-js-001\" \"$run_id\" \"register should print run id\"\n188\t  [ -f \"$status_file\" ] || fail \"register should write run status file\"\n189\t  [ -f \"$index_file\" ] || fail \"register should write run index\"\n190\t  assert_eq \"$expected_index\" \"$(cat \"$index_file\")\" \"run index should capture launched run\"\n191\t  assert_file_contains \"$status_file\" $'id\\tharden-src-app-js-001' \"status should record id\"\n192\t  assert_file_contains \"$status_file\" $'type\\tharden' \"status should record type\"\n193\t  assert_file_contains \"$status_file\" $'target\\tsrc/app.js' \"status should record target\"\n194\t  assert_file_contains \"$status_file\" $'pid\\t4242' \"status should record pid\"\n195\t  assert_file_contains \"$status_file\" $'status\\trunning' \"status should start running\"\n196\t  assert_file_contains \"$status_file\" $'started_at\\t2026-05-25T12:00:00Z' \"status should record start time\"\n197\t  echo \"  PASS: registers run in registry\"\n198\t}\n199\t\n200\ttest_marks_registered_run_done() {\n201\t  local