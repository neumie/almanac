{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013XX6WrZSr362V2rsQTxj49","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# sync.sh — Check adapted skills for upstream changes\n3\t\n4\tsource \"$ALMANAC_HOME/lib/core.sh\"\n5\tsource \"$ALMANAC_HOME/lib/almanac-core.sh\"\n6\t\n7\tSHOW_DIFF=false\n8\t[ \"${1:-}\" = \"--diff\" ] && SHOW_DIFF=true\n9\t\n10\t# Fetch SHA of a file from GitHub.\n11\t# Emits ONLY a valid 40-char git blob SHA. On 404 / rate-limit, `gh api` prints\n12\t# the JSON error body to stdout — without this guard that body gets captured and\n13\t# mistaken for a SHA, so every skill falsely reports \"changed\".\n14\t_fetch_sha() {\n15\t  local api_path=\"$1\" raw=\"\"\n16\t  if command -v gh &>/dev/null; then\n17\t    raw=$(gh api \"$api_path\" --jq '.sha' 2>/dev/null || true)\n18\t  elif command -v curl &>/dev/null; then\n19\t    raw=$(curl -sL \"https://api.github.com/$api_path\" 2>/dev/null | grep '\"sha\"' | head -1 | sed 's/.*\"sha\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/' || true)\n20\t  else\n21\t    _die \"Neither gh nor curl available\"\n22\t  fi\n23\t  if printf '%s' \"$raw\" | grep -Eq '^[0-9a-f]{40}$'; then\n24\t    printf '%s' \"$raw\"\n25\t  fi\n26\t}\n27\t\n28\t_info \"Checking adapted skills for upstream changes...\"\n29\techo \"\"\n30\t\n31\tfound=0\n32\tup_to_date=0\n33\tchanged=0\n34\tunbaselined=0\n35\terrors=0\n36\t\n37\twhile IFS= read -r skill_dir; do\n38\t  [ -d \"$skill_dir\" ] || continue\n39\t  skill_file=\"$skill_dir/SKILL.md\"\n40\t  [ -f \"$skill_file\" ] || continue\n41\t\n42\t  # Extract upstream metadata from frontmatter\n43\t  frontmatter=$(awk 'BEGIN{f=0} /^---$/{f++; next} f==1{print} f>=2{exit}' \"$skill_file\")\n44\t\n45\t  upstream=$(echo \"$frontmatter\" | grep 'upstream:' | head -1 | sed 's/^[[:space:]]*upstream:[[:space:]]*//' || true)\n46\t  [ -z \"$upstream\" ] && continue\n47\t\n48\t  upstream_sha=$(echo \"$frontmatter\" | grep 'upstream-sha:' | head -1 | sed 's/^[[:space:]]*upstream-sha:[[:space:]]*//' || true)\n49\t  adapted_date=$(echo \"$frontmatter\" | grep 'adapted-date:' | head -1 | sed 's/^[[:space:]]*adapted-date:[[:space:]]*//' | tr -d '\"' || true)\n50\t\n51\t  skill_name=$(basename \"$skill_dir\")\n52\t  found=$((found + 1))\n53\t\n54\t  # Parse repo and path from upstream (format: owner/repo/path)\n55\t  repo=$(echo \"$upstream\" | cut -d'/' -f1-2)\n56\t  skill_path=$(echo \"$upstream\" | cut -d'/' -f3-)\n57\t\n58\t  # Get current SHA from GitHub API\n59\t  current_sha=$(_fetch_sha \"repos/$repo/contents/$skill_path/SKILL.md\")\n60\t\n61\t  if [ -z \"$current_sha\" ]; then\n62\t    echo -e \"  ${_RED}✗${_RESET} $skill_name: failed to fetch upstream (bad path or API error)\"\n63\t    errors=$((errors + 1))\n64\t    continue\n65\t  fi\n66\t\n67\t  if [ -z \"$upstream_sha\" ]; then\n68\t    echo -e \"  ${_YELLOW}⚠${_RESET} $skill_name: no baseline upstream-sha recorded (upstream now ${current_sha:0:12})\"\n69\t    unbaselined=$((unbaselined + 1))\n70\t    continue\n71\t  fi\n72\t\n73\t  if [ \"$current_sha\" = \"$upstream_sha\" ]; then\n74\t    echo -e \"  ${_GREEN}✓${_RESET} $skill_name: up to date\"\n75\t    up_to_date=$((up_to_date + 1))\n76\t  else\n77\t    echo -e \"  ${_YELLOW}⚠${_RESET} $skill_name: upstream changed (adapted $adapted_date)\"\n78\t    changed=$((changed + 1))\n79\t\n80\t    if [ \"$SHOW_DIFF\" = true ]; then\n81\t      echo \"\"\n82\t      echo \"    Upstream: https://github.com/$repo/blob/main/$skill_path/SKILL.md\"\n83\t      echo \"    Local SHA:    ${upstream_sha:0:12}\"\n84\t      echo \"    Upstream SHA: ${current_sha:0:12}\"\n85\t      echo \"\"\n86\t    fi\n87\t  fi\n88\tdone < <(almanac_list_skills)\n89\t\n90\techo \"\"\n91\tif [ \"$found\" -eq 0 ]; then\n92\t  _info \"No skills with upstream tracking found\"\n93\telse\n94\t  echo \"Results: $found tracked, $up_to_date up to date, $changed changed, $unbaselined unbaselined, $errors errors\"\n95\t  if [ \"$changed\" -gt 0 ] && [ \"$SHOW_DIFF\" = false ]; then\n96\t    _warn \"Run 'almanac sync --diff' to see details\"\n97\t  fi\n98\tfi\n99\t"}]},"parent_tool_use_id":"toolu_01DVjSuExduGkSWtUUfLNTL4","session_id":"250917c1-763a-4661-b412-670ee21b67f2","uuid":"2c5f8c50-b7cb-406f-9989-777e0c22ed75","timestamp":"2026-05-26T14:18:11.314Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac codebase"}
