{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013MhinBWJgKQE27jhj3v6XT","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# test-worker.sh - worker orchestration tests (lib/worker.sh)\n3\t#\n4\t# Sources lib/worker.sh DIRECTLY (its interface is its own test surface) — the\n5\t# worker ORCHESTRATION (background fan-out) moved here from the deleted loop-core.sh.\n6\t# worker.sh pulls in lib/run.sh (worker path helpers + run-status reader) and\n7\t# lib/agent.sh (the capture shape a spawned worker runs) idempotently, so sourcing\n8\t# worker.sh alone gives these tests everything they exercise:\n9\t#   - almanac_loop_worker_start: spawns a provider run in the background through the\n10\t#     agent capture shape, recording the worker's status.tsv / events.jsonl /\n11\t#     result.txt under the run dir, and marks it done with the agent's exit code\n12\t#   - almanac_loop_worker_watch: streams one worker's live event log (and reports\n13\t#     cleanly when no log exists yet)\n14\t# The run registry / worker-health read-views live in lib/run.sh (tests/test-run.sh).\n15\t\n16\tset -euo pipefail\n17\t\n18\tROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n19\tsource \"$ROOT/lib/worker.sh\"\n20\t\n21\tTMPDIRS=()\n22\tNEW_TMPDIR=\"\"\n23\t\n24\tcleanup() {\n25\t  local dir\n26\t  [ \"${#TMPDIRS[@]}\" -eq 0 ] && return 0\n27\t  for dir in \"${TMPDIRS[@]}\"; do\n28\t    rm -rf \"$dir\"\n29\t  done\n30\t}\n31\ttrap cleanup EXIT\n32\t\n33\tfail() {\n34\t  echo \"  FAIL: $1\" >&2\n35\t  exit 1\n36\t}\n37\t\n38\tassert_eq() {\n39\t  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n40\t  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n41\t}\n42\t\n43\tassert_file_contains() {\n44\t  local file=\"$1\" needle=\"$2\" message=\"$3\"\n45\t  grep -Fq -- \"$needle\" \"$file\" || fail \"$message\"\n46\t}\n47\t\n48\tassert_contains() {\n49\t  local haystack=\"$1\" needle=\"$2\" message=\"$3\"\n50\t  case \"$haystack\" in\n51\t    *\"$needle\"*) ;;\n52\t    *) fail \"$message\" ;;\n53\t  esac\n54\t}\n55\t\n56\tnew_tmpdir() {\n57\t  NEW_TMPDIR=$(mktemp -d)\n58\t  TMPDIRS+=(\"$NEW_TMPDIR\")\n59\t}\n60\t\n61\twrite_fake_codex_agent() {\n62\t  local fakebin=\"$1\"\n63\t  local args_log=\"$2\"\n64\t\n65\t  mkdir -p \"$fakebin\"\n66\t  cat > \"$fakebin/codex\" <<EOF\n67\t#!/usr/bin/env bash\n68\tset -euo pipefail\n69\t\n70\tprintf '%s\\n' \"\\$*\" > \"$args_log\"\n71\tresult_file=\"\"\n72\tprompt=\"\"\n73\twhile [ \"\\$#\" -gt 0 ]; do\n74\t  case \"\\$1\" in\n75\t    --output-last-message)\n76\t      shift\n77\t      result_file=\"\\${1:-}\"\n78\t      ;;\n79\t    *)\n80\t      prompt=\"\\$1\"\n81\t      ;;\n82\t  esac\n83\t  shift || true\n84\tdone\n85\t\n86\t[ -n \"\\$result_file\" ] && printf '%s\\n' \"codex final: \\$prompt\" > \"\\$result_file\"\n87\tprintf '%s\\n' '{\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"codex event\"}}'\n88\tprintf '%s\\n' '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"codex streamed: hardened\"}}'\n89\tEOF\n90\t  chmod +x \"$fakebin/codex\"\n91\t}\n92\t\n93\ttest_worker_start_tracks_background_agent() {\n94\t  local tmp fakebin prompt pid status_file events_file result_file args\n95\t  new_tmpdir\n96\t  tmp=\"$NEW_TMPDIR\"\n97\t  fakebin=\"$tmp/bin\"\n98\t  prompt=\"$tmp/prompt.md\"\n99\t\n100\t  printf '%s\\n' \"review target\" > \"$prompt\"\n101\t  write_fake_codex_agent \"$fakebin\" \"$tmp/codex-args.txt\"\n102\t\n103\t  PATH=\"$fakebin:$PATH\" almanac_loop_worker_start \\\n104\t    \"$tmp\" \\\n105\t    \"harden-demo-001\" \\\n106\t    \"reviewer-security\" \\\n107\t    \"codex\" \\\n108\t    \"gpt-worker\" \\\n109\t    \"high\" \\\n110\t    \"read-only\" \\\n111\t    \"$prompt\" \\\n112\t    \"2026-05-25T12:00:00Z\" > \"$tmp/worker-pid.txt\"\n113\t\n114\t  pid=\"$(cat \"$tmp/worker-pid.txt\")\"\n115\t  wait \"$pid\"\n116\t\n117\t  status_file=\"$tmp/.almanac/runs/harden-demo-001/workers/reviewer-security/status.tsv\"\n118\t  events_file=\"$tmp/.almanac/runs/harden-demo-001/workers/reviewer-security/events.jsonl\"\n119\t  result_file=\"$tmp/.almanac/runs/harden-demo-001/workers/reviewer-security/result.txt\"\n120\t\n121\t  [ -f \"$status_file\" ] || fail \"worker should write status file\"\n122\t  [ -f \"$events_file\" ] || fail \"worker should write event log\"\n123\t  [ -f \"$result_file\" ] || fail \"worker should write result file\"\n124\t  assert_file_contains \"$status_file\" $'id\\treviewer-security' \"worker status should record id\"\n125\t  assert_file_contains \"$status_file\" $'run_id\\tharden-demo-001' \"worker status should record run id\"\n126\t  assert_file_contains \"$status_file\" $'provider\\tcodex' \"worker status should record provider\"\n127\t  assert_file_contains \"$status_file\" $'sandbox\\tread-only' \"worker status should record sandbox\"\n128\t  assert_file_contains \"$status_file\" $'status\\tdone' \"worker status should mark successful completion\"\n129\t  assert_file_contains \"$status_file\" $'exit_code\\t0' \"worker status should record exit code\"\n130\t  assert_file_contains \"$events_file\" \"codex event\" \"worker should stream agent events to log\"\n131\t  assert_file_contains \"$result_file\" \"codex final: review target\" \"worker should capture agent result\"\n132\t  args=\"$(cat \"$tmp/codex-args.txt\")\"\n133\t  assert_contains \"$args\" \"--sandbox read-only\" \"worker should pass sandbox through agent runner\"\n134\t  echo \"  PASS: worker start tracks background agent\"\n135\t}\n136\t\n137\t# A single worker's live event stream can be watched: the shared watcher reads the\n138\t# worker's events-file path from its status.tsv and prints the log (non-follow mode\n139\t# so it returns rather than tailing), and reports cleanly when no log exists yet.\n140\ttest_worker_watch_streams_event_log() {\n141\t  local tmp run_id wdir events out rc perfdir\n142\t  new_tmpdir\n143\t  tmp=\"$NEW_TMPDIR\"\n144\t  run_id=\"harden-demo-001\"\n145\t  wdir=\"$tmp/.almanac/runs/$run_id/workers/reviewer-security\"\n146\t  mkdir -p \"$wdir\"\n147\t  events=\"$wdir/events.jsonl\"\n148\t  printf '%s\\n' '{\"e\":\"started\"}' '{\"e\":\"thinking\"}' > \"$events\"\n149\t  almanac_loop_worker_record_set \"$wdir/status.tsv\" \\\n150\t    \"id=reviewer-security\" \"run_id=$run_id\" \"pid=111\" \"provider=codex\" \\\n151\t    \"sandbox=read-only\" \"prompt_file=p\" \"events_file=$events\" \\\n152\t    \"result_file=r\" \"stderr_file=s\" \"started_at=2026-05-25T12:00:00Z\" \"status=running\"\n153\t\n154\t  out=\"$(almanac_loop_worker_watch \"$tmp\" \"$run_id\" \"reviewer-security\")\"\n155\t  assert_contains \"$out\" '{\"e\":\"started\"}' \"watch should stream the worker's event log\"\n156\t  assert_contains \"$out\" '{\"e\":\"thinking\"}' \"watch should stream every event line\"\n157\t\n158\t  # A worker whose event log does not exist yet reports cleanly (non-zero) instead\n159\t  # of hanging or erroring.\n160\t  perfdir=\"$tmp/.almanac/runs/$run_id/workers/reviewer-perf\"\n161\t  mkdir -p \"$perfdir\"\n162\t  almanac_loop_worker_record_set \"$perfdir/status.tsv\" \\\n163\t    \"id=reviewer-perf\" \"run_id=$run_id\" \"pid=112\" \"provider=codex\" \\\n164\t    \"sandbox=read-only\" \"prompt_file=p\" \"events_file=$perfdir/events.jsonl\" \\\n165\t    \"result_file=r\" \"stderr_file=s\" \"started_at=2026-05-25T12:00:00Z\" \"status=running\"\n166\t  rc=0\n167\t  almanac_loop_worker_watch \"$tmp\" \"$run_id\" \"reviewer-perf\" >/dev/null 2>&1 || rc=$?\n168\t  [ \"$rc\" -eq 1 ] || fail \"watch should return non-zero when the worker has no event log yet (got $rc)\"\n169\t  echo \"  PASS: worker watch streams the worker event log\"\n170\t}\n171\t\n172\techo \"=== Worker Orchestration Tests ===\"\n173\ttest_worker_start_tracks_background_agent\n174\ttest_worker_watch_streams_event_log\n175\t\n176\techo \"\"\n177\techo \"All worker orchestration tests passed.\"\n178\t"}]},"parent_tool_use_id":"toolu_01DVjSuExduGkSWtUUfLNTL4","session_id":"250917c1-763a-4661-b412-670ee21b67f2","uuid":"da208164-358d-43aa-bf8d-e2144738c41a","timestamp":"2026-05-26T14:18:32.207Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac codebase"}
