ort ALMANAC_HOME=\"${ALMANAC_HOME:-$(cd -P \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd -P)}\"\n\nsource \"$ALMANAC_HOME/lib/core.sh\"\n\nCOMMAND=\"${1:-}\"\n[[ -n \"$COMMAND\" ]] && shift\n\ncase \"$COMMAND\" in\n  install|uninstall|update|list|sync|ralph|harden|converge|hub|doctor|help)\n    source \"$ALMANAC_HOME/cmd/${COMMAND}.sh\"\n    ;;\n  \"\")\n    # Bare `almanac`: open the interactive hub when run in a TTY; otherwise\n    # (piped / non-interactive) print help so scripts that call bare almanac\n    # don't break and never block on a menu.\n    if [ -t 0 ] && [ -t 1 ]; then\n      source \"$ALMANAC_HOME/cmd/hub.sh\"\n    else\n      source \"$ALMANAC_HOME/cmd/help.sh\"\n    fi\n    ;;\n  *)\n    _error \"Unknown command: $COMMAND\"\n    source \"$ALMANAC_HOME/cmd/help.sh\"\n    exit 1\n    ;;\nesac\n","numLines":36,"startLine":1,"totalLines":36}}}
