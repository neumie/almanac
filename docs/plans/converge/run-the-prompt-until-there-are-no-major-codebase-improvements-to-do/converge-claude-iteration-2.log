{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ArThRghnw3LeCXmrYx4ixL","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/ralph.sh — the ralph loop adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about how to launch and\n5\t# control the ralph loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n6\t#\n7\t# Contract (called as almanac_loop_ralph_<verb>):\n8\t#   exec_argv   — launch: populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n9\t#                 for a given mode/prd/iterations. The ralph runner path lives\n10\t#                 HERE now (not hard-coded in the launcher).\n11\t#   signal_file — control: the between-round dot-file basename for stop|steer.\n12\t\n13\t# Build ralph's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n14\t# it). MODE selects the runner: `once` runs a single iteration (once.sh PRD),\n15\t# `afk` runs autonomously (afk.sh PRD ITERATIONS). The ralph runner scripts live\n16\t# under the ralph-loop skill — this adapter is the single place that path is\n17\t# named, so the launcher no longer hard-codes …/ralph-loop/scripts/…. Returns 2\n18\t# for an unknown mode. Requires $ALMANAC_HOME (set by every entry point).\n19\talmanac_loop_ralph_exec_argv() {\n20\t  local mode=\"$1\" prd=\"$2\" iterations=\"${3:-}\"\n21\t  local scripts=\"$ALMANAC_HOME/skills/loop/ralph-loop/scripts\"\n22\t  case \"$mode\" in\n23\t    once) _ALMANAC_LOOP_ARGV=(bash \"$scripts/once.sh\" \"$prd\") ;;\n24\t    afk)  _ALMANAC_LOOP_ARGV=(bash \"$scripts/afk.sh\" \"$prd\" \"$iterations\") ;;\n25\t    *) return 2 ;;\n26\t  esac\n27\t  return 0\n28\t}\n29\t\n30\t# ralph's between-round signal files: the afk runner watches `.ralph-stop` to halt\n31\t# and consumes `.ralph-steer` as a one-shot operator/overseer directive. Prints\n32\t# the basename; returns 1 for an unknown kind.\n33\talmanac_loop_ralph_signal_file() {\n34\t  case \"$1\" in\n35\t    stop)  printf '%s\\n' \".ralph-stop\" ;;\n36\t    steer) printf '%s\\n' \".ralph-steer\" ;;\n37\t    *) return 1 ;;\n38\t  esac\n39\t}\n40\t"}]},"parent_tool_use_id":"toolu_01VBXnEJr4hBEm1954BzWA3K","session_id":"7f32d037-1d78-4726-b16f-75668d38d257","uuid":"13813f9a-2348-4692-a8ce-c88ee7c15f98","timestamp":"2026-05-26T14:25:38.850Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
