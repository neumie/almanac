returns 1 for an unknown kind.\nalmanac_loop_converge_signal_file() {\n  case \"$1\" in\n    stop)  printf '%s\\n' \".converge-stop\" ;;\n    steer) printf '%s\\n' \".converge-steer\" ;;\n    *) return 1 ;;\n  esac\n}\n","structuredPatch":[{"oldStart":7,"oldLines":7,"newStart":7,"newLines":9,"lines":[" #                 runner is the CLI itself (`almanac converge --goal … --exec …`),"," #                 so the adapter yields that bin/almanac invocation. Mirrors"," #                 harden's adapter shape (no standalone runner script).","-#   signal_file — control: the between-round dot-file basename for stop|steer.","+#","+# Control contract (signal_file) inherits the default `.converge-stop` /","+# `.converge-steer` convention from lib/loops.sh — no adapter override needed."," "," # Build converge's runner exec command into _ALMANAC_LOOP_ARGV (the launcher"," # execs it). Positional args:"]}],"userModified":false,"replaceAll":false}}
