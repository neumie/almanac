{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F6opBotRANpjXC86GF5KHi","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# worker.sh — worker orchestration (background fan-out).\n3\t#\n4\t# Per CONTEXT.md's module map, this owns the WRITE/spawn side of a run's workers:\n5\t# write/mark a worker's status.tsv, spawn a provider run in the background\n6\t# (almanac_loop_worker_start — the fan-out), and stream one worker's live event\n7\t# log (almanac_loop_worker_watch). harden's reviewer/fixer fan-out is the\n8\t# consumer; the run-level registry, the worker PATH helpers + the worker-health\n9\t# read views live in lib/run.sh (this is the orchestration layer on top of them).\n10\t#\n11\t# Dependencies (sourced idempotently): lib/run.sh (worker path helpers +\n12\t# almanac_loop_status_field + almanac_loop_now_utc), lib/agent.sh (the capture\n13\t# shape the spawned worker runs), and lib/core.sh (_warn, for worker_watch's\n14\t# no-event-log notice). pwd -P resolves the install symlink so the siblings are\n15\t# found from either path.\n16\tif ! declare -F almanac_loop_worker_status_file >/dev/null 2>&1; then\n17\t  __worker_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n18\t  # shellcheck source=lib/run.sh\n19\t  source \"$__worker_dir/run.sh\"\n20\t  unset __worker_dir\n21\tfi\n22\t\n23\tif ! declare -F almanac_loop_agent_capture >/dev/null 2>&1; then\n24\t  __worker_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n25\t  # shellcheck source=lib/agent.sh\n26\t  source \"$__worker_dir/agent.sh\"\n27\t  unset __worker_dir\n28\tfi\n29\t\n30\tif ! declare -F _warn >/dev/null 2>&1; then\n31\t  __worker_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n32\t  # shellcheck source=lib/core.sh\n33\t  source \"$__worker_dir/core.sh\"\n34\t  unset __worker_dir\n35\tfi\n36\t\n37\t# THE single source of truth for the worker-status schema: the canonical field\n38\t# list in write order. Mirrors run.sh's almanac_loop_record_fields; the generic\n39\t# almanac_loop_tsv_record_set engine iterates this list so every worker record\n40\t# carries the same keys regardless of which subset a caller supplies.\n41\talmanac_loop_worker_record_fields() {\n42\t  printf '%s\\n' \\\n43\t    id run_id pid provider model effort sandbox \\\n44\t    prompt_file events_file result_file stderr_file \\\n45\t    started_at status finished_at exit_code\n46\t}\n47\t\n48\t# Set one or more worker-status fields by name, round-tripping the rest. Thin\n49\t# wrapper over the shared tsv-record engine — callers name only the fields they\n50\t# have values for; the rest are preserved (or seeded blank on first write). No\n51\t# caller enumerates the worker schema.\n52\talmanac_loop_worker_record_set() {\n53\t  almanac_loop_tsv_record_set \"$(almanac_loop_worker_record_fields)\" \"$@\"\n54\t}\n55\t\n56\talmanac_loop_mark_worker_status() {\n57\t  [ \"$#\" -ge 5 ] || return 2\n58\t\n59\t  local root=\"$1\"\n60\t  local run_id=\"$2\"\n61\t  local worker_id=\"$3\"\n62\t  local status=\"$4\"\n63\t  local exit_code=\"$5\"\n64\t  local finished_at=\"${6:-}\"\n65\t  local status_file\n66\t\n67\t  case \"$status\" in\n68\t    done|failed) ;;\n69\t    *) return 3 ;;\n70\t  esac\n71\t\n72\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n73\t  [ -f \"$status_file\" ] || return 2\n74\t\n75\t  if [ -z \"$finished_at\" ]; then\n76\t    finished_at=\"$(almanac_loop_now_utc)\"\n77\t  fi\n78\t\n79\t  almanac_loop_worker_record_set \"$status_file\" \\\n80\t    \"status=$status\" \\\n81\t    \"finished_at=$finished_at\" \\\n82\t    \"exit_code=$exit_code\"\n83\t}\n84\t\n85\talmanac_loop_worker_start() {\n86\t  [ \"$#\" -ge 8 ] || return 2\n87\t\n88\t  local root=\"$1\"\n89\t  local run_id=\"$2\"\n90\t  local worker_id=\"$3\"\n91\t  local provider=\"$4\"\n92\t  local model=\"$5\"\n93\t  local effort=\"$6\"\n94\t  local sandbox=\"$7\"\n95\t  local prompt_file=\"$8\"\n96\t  local started_at=\"${9:-}\"\n97\t  local worker_dir status_file events_file result_file stderr_file worker_pid\n98\t\n99\t  [ -n \"$root\" ] || return 2\n100\t  [ -n \"$run_id\" ] || return 2\n101\t  [ -n \"$worker_id\" ] || return 2\n102\t  [ -n \"$provider\" ] || return 2\n103\t  [ -f \"$prompt_file\" ] || return 2\n104\t\n105\t  if [ -z \"$started_at\" ]; then\n106\t    started_at=\"$(almanac_loop_now_utc)\"\n107\t  fi\n108\t\n109\t  worker_dir=\"$(almanac_loop_worker_dir \"$root\" \"$run_id\" \"$worker_id\")\"\n110\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n111\t  events_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"events.jsonl\")\"\n112\t  result_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"result.txt\")\"\n113\t  stderr_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"stderr.log\")\"\n114\t\n115\t  if [ -e \"$worker_dir\" ]; then\n116\t    return 3\n117\t  fi\n118\t\n119\t  mkdir -p \"$worker_dir\"\n120\t\n121\t  (\n122\t    local status exit_code\n123\t\n124\t    while [ ! -f \"$status_file\" ]; do\n125\t      sleep 0.05\n126\t    done\n127\t\n128\t    if almanac_loop_agent_capture \"$provider\" \"$model\" \"$effort\" \"$sandbox\" \"$prompt_file\" \"$result_file\" \"$events_file\" 2> \"$stderr_file\"; then\n129\t      status=\"done\"\n130\t      exit_code=0\n131\t    else\n132\t      exit_code=\"$?\"\n133\t      status=\"failed\"\n134\t    fi\n135\t\n136\t    almanac_loop_mark_worker_status \"$root\" \"$run_id\" \"$worker_id\" \"$status\" \"$exit_code\" >/dev/null\n137\t    exit \"$exit_code\"\n138\t  ) &\n139\t  worker_pid=\"$!\"\n140\t\n141\t  almanac_loop_worker_record_set \"$status_file\" \\\n142\t    \"id=$worker_id\" \\\n143\t    \"run_id=$run_id\" \\\n144\t    \"pid=$worker_pid\" \\\n145\t    \"provider=$provider\" \\\n146\t    \"model=$model\" \\\n147\t    \"effort=$effort\" \\\n148\t    \"sandbox=${sandbox:-danger-full-access}\" \\\n149\t    \"prompt_file=$prompt_file\" \\\n150\t    \"events_file=$events_file\" \\\n151\t    \"result_file=$result_file\" \\\n152\t    \"stderr_file=$stderr_file\" \\\n153\t    \"started_at=$started_at\" \\\n154\t    \"status=running\"\n155\t\n156\t  printf '%s\\n' \"$worker_pid\"\n157\t}\n158\t\n159\t# Stream one worker's live event log (events.jsonl) so an operator can watch what\n160\t# a single reviewer/fixer is doing. Reads the worker's events-file path from its\n161\t# status.tsv (falling back to the conventional path), so it works regardless of\n162\t# where the runner allocated the log. With follow=\"follow\" on a TTY it tails the\n163\t# log live (-f); otherwise it prints the current contents once and returns, so\n164\t# tests, pipes, and non-interactive callers never block. Returns 1 (and warns)\n165\t# when the worker has produced no event log yet.\n166\talmanac_loop_worker_watch() {\n167\t  local root=\"$1\"\n168\t  local run_id=\"$2\"\n169\t  local worker_id=\"$3\"\n170\t  local follow=\"${4:-}\"\n171\t  local status_file events_file=\"\"\n172\t\n173\t  status_file=\"$(almanac_loop_worker_status_file \"$root\" \"$run_id\" \"$worker_id\")\"\n174\t  if [ -f \"$status_file\" ]; then\n175\t    events_file=\"$(almanac_loop_status_field \"$status_file\" \"events_file\" || true)\"\n176\t  fi\n177\t  [ -n \"$events_file\" ] || events_file=\"$(almanac_loop_worker_file \"$root\" \"$run_id\" \"$worker_id\" \"events.jsonl\")\"\n178\t\n179\t  if [ ! -f \"$events_file\" ]; then\n180\t    _warn \"No event stream for worker '$worker_id' in run '$run_id' yet.\"\n181\t    return 1\n182\t  fi\n183\t\n184\t  if [ \"$follow\" = \"follow\" ] && [ -t 1 ]; then\n185\t    tail -n +1 -f \"$events_file\"\n186\t  else\n187\t    cat \"$events_file\"\n188\t  fi\n189\t}\n190\t"}]},"parent_tool_use_id":"toolu_01VBXnEJr4hBEm1954BzWA3K","session_id":"7f32d037-1d78-4726-b16f-75668d38d257","uuid":"e4058405-e95b-41e1-9d1c-be8e99f77e00","timestamp":"2026-05-26T14:26:04.106Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
