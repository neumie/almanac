{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RJh4UEpYksmYkQJApSjG5q","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# hub.sh — interactive front door to almanac loops (ralph, harden)\n3\t#\n4\t# Bare `almanac` routes here on a TTY (and `almanac hub` always does). The hub\n5\t# reads the run registry under the caller's repo ($PWD/.almanac/runs) and shows\n6\t# the loops it finds: a Running section (live status) and a Recent section (last\n7\t# finished). On a TTY it opens an interactive menu — start a new run, or act on a\n8\t# running loop (watch its live status, stop it, or queue a steer directive for its\n9\t# next round). The menu is gum-styled when gum is present and degrades to a plain\n10\t# numbered menu (built on the shared almanac_loop_ui_choose/input/confirm seam)\n11\t# when gum is absent, so it works on any TTY. Off a TTY it renders the overview as\n12\t# plain text and exits — it never blocks on a menu, so `almanac hub | cat`, scripts\n13\t# and tests get a clean read view.\n14\t#\n15\t# The per-run actions are also drivable non-interactively, the seam the menu and\n16\t# scripts/tests share:\n17\t#   almanac hub --watch <id>           tail a run's live status (one frame off a TTY)\n18\t#   almanac hub --stop  <id>           signal a run to stop (loop stop file)\n19\t#   almanac hub --steer <id> <text…>   queue a steer directive for the next round\n20\t#   almanac hub --new <ralph|harden|converge> [config…] [--dry-run]\n21\t#                                      launch a new run (dry-run previews the command)\n22\t#   almanac hub --resume <id>          re-launch a finished run with the same config (auto-confirm)\n23\t#   almanac hub --clone  <id>          start the launcher pre-filled from a finished run (no auto-confirm)\n24\t#   almanac hub --stats                summarise finished runs by (type, provider, model)\n25\t\n26\tset -euo pipefail\n27\t\n28\tsource \"$ALMANAC_HOME/lib/ui.sh\"\n29\tsource \"$ALMANAC_HOME/lib/run.sh\"\n30\tsource \"$ALMANAC_HOME/lib/loop-launcher.sh\"\n31\t\n32\tROOT=\"$PWD\"\n33\t\n34\thub_usage() {\n35\t  printf '%s\\n' \"Usage:\"\n36\t  printf '%s\\n' \"  almanac hub                      open the hub (interactive on a TTY, overview otherwise)\"\n37\t  printf '%s\\n' \"  almanac hub --watch <run-id>     tail a run's live status\"\n38\t  printf '%s\\n' \"  almanac hub --stop  <run-id>     signal a run to stop\"\n39\t  printf '%s\\n' \"  almanac hub --steer <run-id> …   queue a steer directive for the next round\"\n40\t  printf '%s\\n' \"  almanac hub --new <ralph|harden|converge> [config…] [--dry-run]\"\n41\t  printf '%s\\n' \"                                  launch a new run (--dry-run previews it)\"\n42\t  printf '%s\\n' \"  almanac hub --resume <run-id>    re-launch a finished run with the same config\"\n43\t  printf '%s\\n' \"  almanac hub --clone  <run-id>    start the launcher pre-filled from a finished run\"\n44\t  printf '%s\\n' \"  almanac hub --stats              summarise finished runs (runs + success rate per provider/model)\"\n45\t}\n46\t\n47\t# Launch (or, with dry_run=1, preview) a composed new run. env_raw/argv_raw are\n48\t# the newline-token streams from almanac_loop_new_run_env / almanac_loop_new_run_argv.\n49\t# Dry-run prints the resolved `ENV… almanac <argv>` command and returns — the\n50\t# non-interactive, scripts-safe preview tests and the gum confirm both use.\n51\t# Otherwise it exports the env lines and execs the launcher, handing over the\n52\t# terminal to the new run.\n53\talmanac_hub_launch_new() {\n54\t  local dry_run=\"$1\" env_raw=\"$2\" argv_raw=\"$3\"\n55\t  local line display=\"\" argv=()\n56\t\n57\t  while IFS= read -r line; do\n58\t    [ -n \"$line\" ] || continue\n59\t    argv+=(\"$line\")\n60\t  done <<< \"$argv_raw\"\n61\t  [ \"${#argv[@]}\" -gt 0 ] || _die \"Nothing to launch\"\n62\t\n63\t  if [ \"$dry_run\" = \"1\" ]; then\n64\t    while IFS= read -r line; do\n65\t      [ -n \"$line\" ] || continue\n66\t      display+=\"$line \"\n67\t    done <<< \"$env_raw\"\n68\t    display+=\"almanac\"\n69\t    for line in \"${argv[@]}\"; do\n70\t      display+=\" $line\"\n71\t    done\n72\t    printf '%s\\n' \"$display\"\n73\t    return 0\n74\t  fi\n75\t\n76\t  while IFS= read -r line; do\n77\t    [ -n \"$line\" ] || continue\n78\t    export \"$line\"\n79\t  done <<< \"$env_raw\"\n80\t\n81\t  exec bash \"$ALMANAC_HOME/bin/almanac\" \"${argv[@]}\"\n82\t}\n83\t\n84\t# Interactive New-run flow: pick the loop type, then hand off to the shared\n85\t# almanac launcher (almanac_loop_launch), which gathers that loop's config\n86\t# through the same gum seam, summarises, confirms, and execs the runner. No\n87\t# config logic lives here — one launcher, one UX, shared with `almanac ralph`\n88\t# and `almanac harden`. On confirm the launcher execs (hands over the terminal);\n89\t# if the operator cancels first it returns here and the menu loop continues.\n90\talmanac_hub_new_run() {\n91\t  local type\n92\t  type=\"$(almanac_loop_ui_choose \"New run — pick a loop\" ralph harden converge)\" || return 0\n93\t  almanac_loop_launch \"$type\"\n94\t}\n95\t\n96\talmanac_hub_menu() {\n97\t  local root=\"$1\"\n98\t  local running line choice run_id action directive\n99\t  local options\n100\t"}]},"parent_tool_use_id":"toolu_01VBXnEJr4hBEm1954BzWA3K","session_id":"7f32d037-1d78-4726-b16f-75668d38d257","uuid":"3c886784-ff61-4901-9ed9-626f86474e6d","timestamp":"2026-05-26T14:26:11.680Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
