{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ByYtrBsMFTEfjjrTRS6pdM","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# core.sh — Shared CLI utilities for almanac\n3\t\n4\t# Colors (if terminal supports them)\n5\tif [[ -t 1 ]]; then\n6\t  _BOLD=\"\\033[1m\"\n7\t  _RED=\"\\033[31m\"\n8\t  _GREEN=\"\\033[32m\"\n9\t  _YELLOW=\"\\033[33m\"\n10\t  _BLUE=\"\\033[34m\"\n11\t  _RESET=\"\\033[0m\"\n12\telse\n13\t  _BOLD=\"\" _RED=\"\" _GREEN=\"\" _YELLOW=\"\" _BLUE=\"\" _RESET=\"\"\n14\tfi\n15\t\n16\t_info()    { echo -e \"${_BLUE}[info]${_RESET} $*\"; }\n17\t_success() { echo -e \"${_GREEN}[ok]${_RESET} $*\"; }\n18\t_warn()    { echo -e \"${_YELLOW}[warn]${_RESET} $*\"; }\n19\t_error()   { echo -e \"${_RED}[error]${_RESET} $*\" >&2; }\n20\t_die()     { _error \"$@\"; exit 1; }\n21\t\n22\t# --- ALMANAC_HOME resolution -----------------------------------------------\n23\t# Canonical resolver and single source of truth for locating the real repo root\n24\t# from an entry point. Prefer an already-exported ALMANAC_HOME; otherwise resolve\n25\t# the caller's own path to its physical directory (pwd -P, so the install\n26\t# dir-symlink ~/.claude/skills/almanac/<name> -> repo/skills/<category>/<name>\n27\t# and a plain checkout both land on the real repo) and climb <depth> parents to\n28\t# the repo root.\n29\t#\n30\t# Entry points can't call this until core.sh is sourced, so each inlines an\n31\t# identical one-line bootstrap that mirrors it (the standardized snippet):\n32\t#   ALMANAC_HOME=\"${ALMANAC_HOME:-$(cd -P \"$(dirname \"${BASH_SOURCE[0]}\")/<REL>\" && pwd -P)}\"\n33\t# where <REL> is the file's known depth below the root (bin/ -> \"..\",\n34\t# skills/<cat>/<name>/scripts/ -> \"../../../..\"). Keep snippet and function in\n35\t# sync; this function is the tested form (tests/test-home-resolve.sh).\n36\talmanac_resolve_home() {\n37\t  local src=\"${1:?almanac_resolve_home: source path required}\" depth=\"${2:-0}\"\n38\t  if [ -n \"${ALMANAC_HOME:-}\" ]; then\n39\t    printf '%s\\n' \"$ALMANAC_HOME\"\n40\t    return 0\n41\t  fi\n42\t  local home\n43\t  home=\"$(cd -P \"$(dirname \"$src\")\" && pwd -P)\"\n44\t  while [ \"$depth\" -gt 0 ]; do\n45\t    home=\"$(dirname \"$home\")\"\n46\t    depth=$((depth - 1))\n47\t  done\n48\t  printf '%s\\n' \"$home\"\n49\t}\n50\t\n51\t# Providers with adapters\n52\talmanac_providers() {\n53\t  local provider\n54\t  for dir in \"$ALMANAC_HOME\"/providers/*/; do\n55\t    [[ -d \"$dir\" ]] || continue\n56\t    provider=\"$(basename \"$dir\")\"\n57\t    [[ \"$provider\" == _* ]] && continue\n58\t    printf '%s\\n' \"$provider\"\n59\t  done\n60\t}\n61\t\n62\t# Optional-dependency detection. `gum` (Charm) styles the harden/ralph\n63\t# dashboards and HITL prompts; it is optional — the CLI degrades to plain output\n64\t# when absent. This is a pure binary-presence check (unlike the runtime\n65\t# TTY-gated almanac_loop_ui_has_gum), so install/doctor can report it.\n66\talmanac_gum_present() { command -v gum >/dev/null 2>&1; }\n67\t\n68\t# Report gum presence/absence with an actionable hint. Used by `almanac doctor`\n69\t# and the installers so users learn the dashboard is gum-styled and optional.\n70\talmanac_report_gum() {\n71\t  if almanac_gum_present; then\n72\t    _success \"gum: installed ($(command -v gum)) — dashboards render styled\"\n73\t  else\n74\t    _warn \"gum: not found — harden/ralph dashboards degrade to plain output\"\n75\t    _info \"Install gum (optional) for styled dashboards: https://github.com/charmbracelet/gum\"\n76\t  fi\n77\t}\n78\t\n79\t# Check if a provider is installed (return 0 = yes, 1 = no)\n80\t_is_installed() {\n81\t  local provider=\"$1\"\n82\t  case \"$provider\" in\n83\t    claude-code)\n84\t      [[ -d \"$HOME/.claude/commands/almanac\" ]]\n85\t      ;;\n86\t    opencode)\n87\t      [[ -e \"$HOME/.config/opencode/skills/almanac\" ]]\n88\t      ;;\n89\t    cursor)\n90\t      [[ -e \"$HOME/.cursor/skills/almanac\" ]]\n91\t      ;;\n92\t    codex)\n93\t      [[ -e \"$HOME/.agents/skills/almanac\" ]]\n94\t      ;;\n95\t    *)\n96\t      return 1\n97\t      ;;\n98\t  esac\n99\t}\n100\t"}]},"parent_tool_use_id":"toolu_01VBXnEJr4hBEm1954BzWA3K","session_id":"7f32d037-1d78-4726-b16f-75668d38d257","uuid":"ae9ccac0-f21c-4fbb-bf71-10d01369ac8f","timestamp":"2026-05-26T14:26:39.251Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
