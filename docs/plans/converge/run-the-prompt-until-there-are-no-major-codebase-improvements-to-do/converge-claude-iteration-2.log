{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KWbMXEWom2gUxDcWrrjhA7","type":"tool_result","content":"334\t# --- summary + dispatch --------------------------------------------------------\n335\t\n336\t# Render a \"LABEL:value\" config summary as a gum-styled (or plain) panel. Each\n337\t# remaining arg is one \"Field:value\" line. Presentation only.\n338\talmanac_loop_launch_summary() {\n339\t  local type=\"$1\"; shift\n340\t  local line\n341\t  {\n342\t    printf '%s\\n' \"$(printf '%s' \"$type\" | tr '[:lower:]' '[:upper:]') run\"\n343\t    printf '%s\\n' \"──────────────────\"\n344\t    for line in \"$@\"; do\n345\t      printf '  %-11s %s\\n' \"${line%%:*}\" \"${line#*:}\"\n346\t    done\n347\t  } | almanac_loop_ui_render >&2\n348\t}\n349\t\n350\t# Per-type usage, printed for --help. Goes to stderr (stdout stays capture-clean).\n351\talmanac_loop_launch_usage() {\n352\t  case \"$1\" in\n353\t    ralph) cat >&2 <<'EOF'\n354\tUsage: almanac ralph [options]   (also: bash ralph.sh [options])\n355\t  --prd <name>        PRD under docs/plans/<name>/\n356\t  --mode <once|afk>   one iteration, or autonomous\n357\t  --provider <p>      codex | claude\n358\t  --model <m>         model name (\"default\" = provider default)\n359\t  --effort <l>        thinking level (\"default\" = provider default)\n360\t  --iterations <n>    afk iteration count\n361\t  --no-oversee        disable the afk overseer\n362\tAny option not given is prompted interactively.\n363\tEOF\n364\t      ;;\n365\t    harden) cat >&2 <<'EOF'\n366\tUsage (loop launch): <target> [options]\n367\t  <target>            file / dir / PR to harden\n368\t  --lenses <list>     reviewer lenses (blank = default set)\n369\t  --provider <p>      codex | claude\n370\t  --model <m>         reviewer model\n371\t  --effort <l>        reviewer thinking level\n372\t  --rounds <n>        round budget\n373\tAny option not given is prompted interactively.\n374\tEOF\n375\t      ;;\n376\t    converge) cat >&2 <<'EOF'\n377\tUsage (loop launch): converge [options]\n378\t  --goal <text>       one-line convergence goal (overseer can mutate it)\n379\t  --prompt <text>     prompt sent to the configured agent each round (slash\n380\t                      command, chain, or free-form). The dominant mode.\n381\t  --exec <cmd>        shell command run by a wrapping worker agent each round\n382\t                      (escape hatch for non-agent workflows).\n383\t                      Exactly one of --prompt / --exec is required."}]},"parent_tool_use_id":"toolu_01VBXnEJr4hBEm1954BzWA3K","session_id":"7f32d037-1d78-4726-b16f-75668d38d257","uuid":"96fb5a88-ef70-469a-b70e-be62ee672b75","timestamp":"2026-05-26T14:26:35.450Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
