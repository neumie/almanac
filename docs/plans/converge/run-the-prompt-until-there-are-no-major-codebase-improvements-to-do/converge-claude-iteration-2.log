{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WvVDGeksz1EqRDQ6ckAmQN","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# test-loops.sh - loop-adapter seam tests (lib/loops.sh + lib/loops/*)\n3\t#\n4\t# Sources lib/loops.sh DIRECTLY (not through loop-core / the launcher) so the\n5\t# seam's interface is its own test surface. The adapters are pure config (exec\n6\t# argv composition + signal-file mapping), so nothing here calls a real runner —\n7\t# exec_argv is asserted against a fake $ALMANAC_HOME, never executed.\n8\t\n9\tset -euo pipefail\n10\t\n11\tROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n12\tsource \"$ROOT/lib/loops.sh\"\n13\t\n14\tfail() {\n15\t  echo \"  FAIL: $1\" >&2\n16\t  exit 1\n17\t}\n18\t\n19\tassert_eq() {\n20\t  local expected=\"$1\" actual=\"$2\" message=\"$3\"\n21\t  [ \"$expected\" = \"$actual\" ] || fail \"$message (expected '$expected', got '$actual')\"\n22\t}\n23\t\n24\ttest_discovery_lists_present_adapters() {\n25\t  local list\n26\t  list=\"$(almanac_loop_adapter_list)\"\n27\t  case \"$list\" in *ralph*) ;; *) fail \"loop list should include the ralph adapter file\" ;; esac\n28\t  case \"$list\" in *harden*) ;; *) fail \"loop list should include the harden adapter file\" ;; esac\n29\t  case \"$list\" in *converge*) ;; *) fail \"loop list should include the converge adapter file\" ;; esac\n30\t\n31\t  almanac_loop_adapter_known ralph  || fail \"ralph must be a known loop\"\n32\t  almanac_loop_adapter_known harden || fail \"harden must be a known loop\"\n33\t  almanac_loop_adapter_known converge || fail \"converge must be a known loop\"\n34\t  almanac_loop_adapter_known RALPH  || fail \"known must normalise case (RALPH -> ralph)\"\n35\t  if almanac_loop_adapter_known bogus; then fail \"an undiscovered name must not be known\"; fi\n36\t  echo \"  PASS: discovery lists present adapters\"\n37\t}\n38\t\n39\ttest_dispatch_rejects_unknown_verb() {\n40\t  local rc=0\n41\t  almanac_loop_adapter_call ralph no_such_verb >/dev/null 2>&1 || rc=$?\n42\t  assert_eq 2 \"$rc\" \"dispatch should return 2 for a verb the adapter does not implement\"\n43\t  echo \"  PASS: dispatch rejects an unimplemented verb\"\n44\t}\n45\t\n46\ttest_signal_file_control_contract() {\n47\t  assert_eq \".ralph-stop\"   \"$(almanac_loop_adapter_call ralph signal_file stop)\"   \"ralph stop file basename\"\n48\t  assert_eq \".ralph-steer\"  \"$(almanac_loop_adapter_call ralph signal_file steer)\"  \"ralph steer file basename\"\n49\t  assert_eq \".harden-stop\"  \"$(almanac_loop_adapter_call harden signal_file stop)\"  \"harden stop file basename\"\n50\t  assert_eq \".harden-steer\" \"$(almanac_loop_adapter_call harden signal_file steer)\" \"harden steer file basename\"\n51\t  assert_eq \".converge-stop\" \"$(almanac_loop_adapter_call converge signal_file stop)\" \"converge stop file basename\"\n52\t  assert_eq \".converge-steer\" \"$(almanac_loop_adapter_call converge signal_file steer)\" \"converge steer file basename\"\n53\t\n54\t  local rc=0\n55\t  almanac_loop_adapter_call ralph signal_file bogus >/dev/null 2>&1 || rc=$?\n56\t  [ \"$rc\" -ne 0 ] || fail \"an unknown signal kind should be rejected\"\n57\t  echo \"  PASS: signal_file control contract\"\n58\t}\n59\t\n60\ttest_ralph_exec_argv_launch_contract() {\n61\t  local ALMANAC_HOME=\"/fake/home\"\n62\t\n63\t  almanac_loop_adapter_call ralph exec_argv once \"demo-prd\"\n64\t  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/once.sh demo-prd\" \\\n65\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph once exec argv\"\n66\t\n67\t  almanac_loop_adapter_call ralph exec_argv afk \"demo-prd\" \"7\"\n68\t  assert_eq \"bash /fake/home/skills/loop/ralph-loop/scripts/afk.sh demo-prd 7\" \\\n69\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"ralph afk exec argv\"\n70\t\n71\t  local rc=0\n72\t  almanac_loop_adapter_call ralph exec_argv bogus \"demo-prd\" >/dev/null 2>&1 || rc=$?\n73\t  assert_eq 2 \"$rc\" \"an unknown ralph mode should be rejected\"\n74\t  echo \"  PASS: ralph exec_argv launch contract\"\n75\t}\n76\t\n77\ttest_harden_exec_argv_launch_contract() {\n78\t  local ALMANAC_HOME=\"/fake/home\"\n79\t\n80\t  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\"\n81\t  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop\" \\\n82\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (no rounds)\"\n83\t\n84\t  almanac_loop_adapter_call harden exec_argv \"src/foo.sh\" \"3\"\n85\t  assert_eq \"bash /fake/home/bin/almanac harden src/foo.sh --loop --rounds 3\" \\\n86\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"harden exec argv (with rounds)\"\n87\t  echo \"  PASS: harden exec_argv launch contract\"\n88\t}\n89\t\n90\ttest_converge_exec_argv_launch_contract() {\n91\t  local ALMANAC_HOME=\"/fake/home\"\n92\t  local rc\n93\t\n94\t  # Minimum exec-mode: goal + exec\n95\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\"\n96\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi\" \\\n97\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (exec-mode goal + action)\"\n98\t\n99\t  # Minimum prompt-mode: goal + prompt\n100\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"prompt\" \"/almanac:codebase-improve\"\n101\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --prompt /almanac:codebase-improve\" \\\n102\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (prompt-mode goal + action)\"\n103\t\n104\t  # With rounds (4th positional)\n105\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\"\n106\t  assert_eq \"bash /fake/home/bin/almanac converge --goal ship it --exec echo hi --rounds 5\" \\\n107\t    \"${_ALMANAC_LOOP_ARGV[*]}\" \"converge exec argv (with rounds)\"\n108\t\n109\t  # With --no-oversee (5th positional, non-empty + non-\"0\" enables)\n110\t  almanac_loop_adapter_call converge exec_argv \"ship it\" \"exec\" \"echo hi\" \"5\" \"1\"\n111\t  assert_eq \"bash /fake/home/bin/almanac converge --goal