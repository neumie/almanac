{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WfmBMWyY3hQ2xiAtUgHrEt","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# loop-launcher.sh — the single almanac launcher (ralph + harden + converge).\n3\t#\n4\t# almanac_loop_launch <type> [native flags…] interactively configures and starts\n5\t# a loop run. It is loop-agnostic: one launcher for every consumer — `almanac\n6\t# ralph`, `almanac harden`, the hub's New-run flow, and the ralph skill launcher\n7\t# all route here, so the config UX is identical everywhere (the PRD's \"almanac\n8\t# launcher, not per-loop reimplementations\").\n9\t#\n10\t# Each loop's flag parsing, prompts, env-export, and runner exec live in its\n11\t# adapter (lib/loops/<name>.sh) as the `launch` verb, and its --help text as the\n12\t# `launch_usage` verb. The launcher dispatches via the loop-adapter seam — no\n13\t# central case-statement branches on loop type, so adding a 4th loop is a\n14\t# single new file in lib/loops/.\n15\t#\n16\t# The shared bits — field collectors (provider / choice / positive-int) and the\n17\t# summary panel — stay here because every adapter uses them identically. They\n18\t# are sourced once at launcher boot, so any adapter dispatched through\n19\t# `almanac_loop_launch` finds them in scope.\n20\t#\n21\t# Requires lib/core.sh (_die/_info/_success), sourced by every entry point before\n22\t# this file. The gum-or-plain UI seam (almanac_loop_ui_*) lives in lib/ui.sh and\n23\t# is pulled in directly below, so the launcher's dependency on it is explicit.\n24\t\n25\t# The launcher drives the whole config UX through the gum-or-plain seam\n26\t# (choose/input/confirm/render). Source it directly and idempotently so the\n27\t# dependency is the launcher's own, not borrowed from whatever sourced this file.\n28\tif ! declare -F almanac_loop_ui_choose >/dev/null 2>&1; then\n29\t  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n30\t  # shellcheck source=lib/ui.sh\n31\t  source \"$__loop_launcher_dir/ui.sh\"\n32\t  unset __loop_launcher_dir\n33\tfi\n34\t\n35\t# Provider knowledge (availability, the model/effort menus, default-selection,\n36\t# the provider list) lives in the provider-adapter seam (lib/agent.sh →\n37\t# almanac_provider_*). The launcher consumes it rather than branching on provider\n38\t# name. Source it directly and idempotently so the dependency is the launcher's\n39\t# own, not borrowed from whatever sourced this file.\n40\tif ! declare -F almanac_provider_default >/dev/null 2>&1; then\n41\t  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n42\t  # shellcheck source=lib/agent.sh\n43\t  source \"$__loop_launcher_dir/agent.sh\"\n44\t  unset __loop_launcher_dir\n45\tfi\n46\t\n47\t# The loop-adapter seam (almanac_loop_adapter_*) lives in lib/loops.sh. The\n48\t# launcher dispatches the `launch` verb through it (each loop adapter owns its\n49\t# own config UI + exec). Source it directly and idempotently so the dependency\n50\t# is the launcher's own, not borrowed from whatever sourced this file.\n51\tif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n52\t  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n53\t  # shellcheck source=lib/loops.sh\n54\t  source \"$__loop_launcher_dir/loops.sh\"\n55\t  unset __loop_launcher_dir\n56\tfi\n57\t\n58\t# --- field collectors ---------------------------------------------------------\n59\t#\n60\t# Used by every loop adapter's `launch` verb (lib/loops/<name>.sh::almanac_loop_<name>_launch).\n61\t# The underscore prefix signals \"private to the launching subsystem (this file +\n62\t# adapter launch verbs)\" — not for callers outside that path.\n63\t\n64\t# Pick a provider into the named-by-$1 variable if it is empty. Lists only\n65\t# installed providers (discovered via the seam); dies if none.\n66\t_almanac_launch_need_provider() {\n67\t  local var=\"$1\" current=\"${2:-}\" providers=() p chosen\n68\t  if [ -n \"$current\" ]; then printf '%s\\n' \"$current\"; return 0; fi\n69\t  for p in $(almanac_provider_list); do\n70\t    almanac_provider_available \"$p\" && providers+=(\"$p\")\n71\t  done\n72\t  [ \"${#providers[@]}\" -gt 0 ] || _die \"No supported provider found. Install Codex or Claude Code.\"\n73\t  if [ \"${#providers[@]}\" -eq 1 ]; then printf '%s\\n' \"${providers[0]}\"; return 0; fi\n74\t  chosen=\"$(almanac_loop_ui_choose \"Provider\" \"${providers[@]}\")\" || return 1\n75\t  printf '%s\\n' \"$chosen\"\n76\t}\n77\t\n78\t# Resolve a model/effort value: if empty, show the provider menu; map \"default\"\n79\t# to empty and \"custom\" to a free-text prompt. Echoes the resolved value.\n80\t_almanac_launch_need_choice() {\n81\t  local header=\"$1\" current=\"$2\" picked\n82\t  shift 2\n83\t  if [ -n \"$current\" ]; then\n84\t    [ \"$current\" = \"default\" ] && current=\"\"\n85\t    printf '%s\\n' \"$current\"; return 0\n86\t  fi\n87\t  picked=\"$(almanac_loop_ui_choose \"$header\" \"$@\")\" || return 1\n88\t  if [ \"$picked\" = \"custom\" ]; then\n89\t    picked=\"$(almanac_loop_ui_input \"$header (custom)\")\" || return 1\n90\t  fi\n91\t  [ \"$picked\" = \"default\" ] && picked=\"\"\n92\t  printf '%s\\n' \"$picked\"\n93\t}\n94\t\n95\t# Resolve a positive integer. A preset (flag) value is validated once and dies on\n96\t# failure; an interactive value re-prompts until valid. Echoes the integer.\n97\t_almanac_launch_need_positive_int() {\n98\t  local header=\"$1\" current=\"$2\" default=\"${3:-}\" reply\n99\t  if [ -n \"$current\" ]; then\n100\t    case \"$current\" in ''|*[!0-9]*) _die \"$header must be a positive integer (got: $current)\";; esac\n101\t    [ \"$current\" -gt 0 ] || _die \"$header must be a positive integer (got: $current)\"\n102\t    printf '%s\\n' \"$current\"; return 0\n103\t  fi\n104\t  while :; do\n105\t    reply=\"$(almanac_loop_ui_input \"$header\" \"$default\")\" || return 1\n106\t    case \"$reply\" in ''|*[!0-9]*) _warn \"Enter a positive integer.\" >&2; continue;; esac\n107\t    [ \"$reply\" -gt 0 ] && { printf '%s\\n' \"$reply\"; return 0; }\n108\t    _warn \"Enter a positive integer.\" >&2\n109\t  done\n110\t}\n111\t\n112\t# --- summary + dispatch --------------------------------------------------------\n113\t\n114\t# Render a \"LABEL:value\" config summary as a gum-styled (or plain) panel. Each\n115\t# remaining arg is one \"Field:value\" line. Presentation only.\n116\talmanac_loop_launch_summary() {\n117\t  local type=\"$1\"; shift\n118\t  local line\n119\t  {\n120\t    printf '%s\\n' \"$(printf '%s' \"$type\" | tr '[:lower:]' '[:upper:]') run\"\n121\t    printf '%s\\n' \"──────────────────\"\n122\t    for line in \"$@\"; do\n123\t      printf '  %-11s %s\\n' \"${line%%:*}\" \"${line#*:}\"\n124\t    done\n125\t  } | almanac_loop_ui_render >&2\n126\t}\n127\t\n128\t# Per-type usage, printed for --help. Goes to stderr (stdout stays capture-clean).\n129\t# Dispatched to the loop adapter's `launch_usage` verb — no central case-statement\n130\t# on loop type. Adding a new loop puts its usage text in lib/loops/<name>.sh\n131\t# alongside its launch verb. A missing adapter or missing verb is a no-op so\n132\t# `--help` for an unknown loop fails through to the launcher's usage error\n133\t# rather than crashing.\n134\talmanac_loop_launch_usage() {\n135\t  local type=\"${1:-}\"\n136\t  [ -n \"$type\" ] || return 0\n137\t  almanac_loop_adapter_known \"$type\" || return 0\n138\t  local fn\n139\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch_usage\"\n140\t  declare -F \"$fn\" >/dev/null 2>&1 && \"$fn\"\n141\t}\n142\t\n143\t# Public entry: configure and launch a run of TYPE (ralph|harden|converge|…).\n144\t# Remaining args are that type's native flags; missing fields are prompted by\n145\t# the adapter's `launch` verb, which also execs the runner. The launcher does\n146\t# not enumerate loop types — discovery is via the loop-adapter seam, so adding\n147\t# a new loop is a single new file in lib/loops/. We resolve the launch verb's\n148\t# function name and invoke it directly (rather than going through\n149\t# almanac_loop_adapter_call) so a missing verb is a hard die — the launch\n150\t# function itself may legitimately exit non-zero (user cancelled / validation\n151\t# error), and adapter_call's \"verb missing\" rc=2 would collide with those.\n152\talmanac_loop_launch() {\n153\t  local type=\"${1:-}\"; shift || true\n154\t  [ -n \"$type\" ] || _die \"Usage: almanac_loop_launch <loop> [options] (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n155\t  almanac_loop_adapter_known \"$type\" || _die \"Unknown loop type: $type (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n156\t  local fn\n157\t  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch\"\n158\t  declare -F \"$fn\" >/dev/null 2>&1 || _die \"Loop adapter '$type' does not implement the launch verb\"\n159\t  \"$fn\" \"$@\"\n160\t}\n161\t"}]},"parent_tool_use_id":null,"session_id":"a891a69f-75d4-4053-b662-17c3d63f7902","uuid":"7adda659-54ad-4180-bc38-88495dd9bf39","timestamp":"2026-05-26T14:49:22.955Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/loop-launcher.sh","content":"#!/usr/bin/env bash\n# loop-launcher.sh — the single almanac launcher (ralph + harden + converge).\n#\n# almanac_loop_launch <type> [native flags…] interactively configures and starts\n# a loop run. It is loop-agnostic: one launcher for every consumer — `almanac\n# ralph`, `almanac harden`, the hub's New-run flow, and the ralph skill launcher\n# all route here, so the config UX is identical everywhere (the PRD's \"almanac\n# launcher, not per-loop reimplementations\").\n#\n# Each loop's flag parsing, prompts, env-export, and runner exec live in its\n# adapter (lib/loops/<name>.sh) as the `launch` verb, and its --help text as the\n# `launch_usage` verb. The launcher dispatches via the loop-adapter seam — no\n# central case-statement branches on loop type, so adding a 4th loop is a\n# single new file in lib/loops/.\n#\n# The shared bits — field collectors (provider / choice / positive-int) and the\n# summary panel — stay here because every adapter uses them identically. They\n# are sourced once at launcher boot, so any adapter dispatched through\n# `almanac_loop_launch` finds them in scope.\n#\n# Requires lib/core.sh (_die/_info/_success), sourced by every entry point before\n# this file. The gum-or-plain UI seam (almanac_loop_ui_*) lives in lib/ui.sh and\n# is pulled in directly below, so the launcher's dependency on it is explicit.\n\n# The launcher drives the whole config UX through the gum-or-plain seam\n# (choose/input/confirm/render). Source it directly and idempotently so the\n# dependency is the launcher's own, not borrowed from whatever sourced this file.\nif ! declare -F almanac_loop_ui_choose >/dev/null 2>&1; then\n  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/ui.sh\n  source \"$__loop_launcher_dir/ui.sh\"\n  unset __loop_launcher_dir\nfi\n\n# Provider knowledge (availability, the model/effort menus, default-selection,\n# the provider list) lives in the provider-adapter seam (lib/agent.sh →\n# almanac_provider_*). The launcher consumes it rather than branching on provider\n# name. Source it directly and idempotently so the dependency is the launcher's\n# own, not borrowed from whatever sourced this file.\nif ! declare -F almanac_provider_default >/dev/null 2>&1; then\n  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/agent.sh\n  source \"$__loop_launcher_dir/agent.sh\"\n  unset __loop_launcher_dir\nfi\n\n# The loop-adapter seam (almanac_loop_adapter_*) lives in lib/loops.sh. The\n# launcher dispatches the `launch` verb through it (each loop adapter owns its\n# own config UI + exec). Source it directly and idempotently so the dependency\n# is the launcher's own, not borrowed from whatever sourced this file.\nif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/loops.sh\n  source \"$__loop_launcher_dir/loops.sh\"\n  unset __loop_launcher_dir\nfi\n\n# --- field collectors ---------------------------------------------------------\n#\n# Used by every loop adapter's `launch` verb (lib/loops/<name>.sh::almanac_loop_<name>_launch).\n# The underscore prefix signals \"private to the launching subsystem (this file +\n# adapter launch verbs)\" — not for callers outside that path.\n\n# Pick a provider into the named-by-$1 variable if it is empty. Lists only\n# installed providers (discovered via the seam); dies if none.\n_almanac_launch_need_provider() {\n  local var=\"$1\" current=\"${2:-}\" providers=() p chosen\n  if [ -n \"$current\" ]; then printf '%s\\n' \"$current\"; return 0; fi\n  for p in $(almanac_provider_list); do\n    almanac_provider_available \"$p\" && providers+=(\"$p\")\n  done\n  [ \"${#providers[@]}\" -gt 0 ] || _die \"No supported provider found. Install Codex or Claude Code.\"\n  if [ \"${#providers[@]}\" -eq 1 ]; then printf '%s\\n' \"${providers[0]}\"; return 0; fi\n  chosen=\"$(almanac_loop_ui_choose \"Provider\" \"${providers[@]}\")\" || return 1\n  printf '%s\\n' \"$chosen\"\n}\n\n# Resolve a model/effort value: if empty, show the provider menu; map \"default\"\n# to empty and \"custom\" to a free-text prompt. Echoes the resolved value.\n_almanac_launch_need_choice() {\n  local header=\"$1\" current=\"$2\" picked\n  shift 2\n  if [ -n \"$current\" ]; then\n    [ \"$current\" = \"default\" ] && current=\"\"\n    printf '%s\\n' \"$current\"; return 0\n  fi\n  picked=\"$(almanac_loop_ui_choose \"$header\" \"$@\")\" || return 1\n  if [ \"$picked\" = \"custom\" ]; then\n    picked=\"$(almanac_loop_ui_input \"$header (custom)\")\" || return 1\n  fi\n  [ \"$picked\" = \"default\" ] && picked=\"\"\n  printf '%s\\n' \"$picked\"\n}\n\n# Resolve a positive integer. A preset (flag) value is validated once and dies on\n# failure; an interactive value re-prompts until valid. Echoes the integer.\n_almanac_launch_need_positive_int() {\n  local header=\"$1\" current=\"$2\" default=\"${3:-}\" reply\n  if [ -n \"$current\" ]; then\n    case \"$current\" in ''|*[!0-9]*) _die \"$header must be a positive integer (got: $current)\";; esac\n    [ \"$current\" -gt 0 ] || _die \"$header must be a positive integer (got: $current)\"\n    printf '%s\\n' \"$current\"; return 0\n  fi\n  while :; do\n    reply=\"$(almanac_loop_ui_input \"$header\" \"$default\")\" || return 1\n    case \"$reply\" in ''|*[!0-9]*) _warn \"Enter a positive integer.\" >&2; continue;; esac\n    [ \"$reply\" -gt 0 ] && { printf '%s\\n' \"$reply\"; return 0; }\n    _warn \"Enter a positive integer.\" >&2\n  done\n}\n\n# --- summary + dispatch --------------------------------------------------------\n\n# Render a \"LABEL:value\" config summary as a gum-styled (or plain) panel. Each\n# remaining arg is one \"Field:value\" line. Presentation only.\nalmanac_loop_launch_summary() {\n  local type=\"$1\"; shift\n  local line\n  {\n    printf '%s\\n' \"$(printf '%s' \"$type\" | tr '[:lower:]' '[:upper:]') run\"\n    printf '%s\\n' \"──────────────────\"\n    for line in \"$@\"; do\n      printf '  %-11s %s\\n' \"${line%%:*}\" \"${line#*:}\"\n    done\n  } | almanac_loop_ui_render >&2\n}\n\n# Per-type usage, printed for --help. Goes to stderr (stdout stays capture-clean).\n# Dispatched to the loop adapter's `launch_usage` verb — no central case-statement\n# on loop type. Adding a new loop puts its usage text in lib/loops/<name>.sh\n# alongside its launch verb. A missing adapter or missing verb is a no-op so\n# `--help` for an unknown loop fails through to the launcher's usage error\n# rather than crashing.\nalmanac_loop_launch_usage() {\n  local type=\"${1:-}\"\n  [ -n \"$type\" ] || return 0\n  almanac_loop_adapter_known \"$type\" || return 0\n  local fn\n  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch_usage\"\n  declare -F \"$fn\" >/dev/null 2>&1 && \"$fn\"\n}\n\n# Public entry: configure and launch a run of TYPE (ralph|harden|converge|…).\n# Remaining args are that type's native flags; missing fields are prompted by\n# the adapter's `launch` verb, which also execs the runner. The launcher does\n# not enumerate loop types — discovery is via the loop-adapter seam, so adding\n# a new loop is a single new file in lib/loops/. We resolve the launch verb's\n# function name and invoke it directly (rather than going through\n# almanac_loop_adapter_call) so a missing verb is a hard die — the launch\n# function itself may legitimately exit non-zero (user cancelled / validation\n# error), and adapter_call's \"verb missing\" rc=2 would collide with those.\nalmanac_loop_launch() {\n  local type=\"${1:-}\"; shift || true\n  [ -n \"$type\" ] || _die \"Usage: almanac_loop_launch <loop> [options] (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n  almanac_loop_adapter_known \"$type\" || _die \"Unknown loop type: $type (loops: $(almanac_loop_adapter_list | tr '\\n' ' '))\"\n  local fn\n  fn=\"almanac_loop_$(almanac_loop_adapter_key \"$type\")_launch\"\n  declare -F \"$fn\" >/dev/null 2>&1 || _die \"Loop adapter '$type' does not implement the launch verb\"\n  \"$fn\" \"$@\"\n}\n","numLines":161,"startLine":1,"totalLines":161}}}
