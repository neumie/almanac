{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AeB6bbpcTGMGRK2XroQ9MZ","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# lib/loops/ralph.sh — the ralph loop adapter.\n3\t#\n4\t# One file owns everything the engine needs to know about how to launch and\n5\t# control the ralph loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n6\t#\n7\t# Contract (called as almanac_loop_ralph_<verb>):\n8\t#   exec_argv   — launch: populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n9\t#                 for a given mode/prd/iterations. The ralph runner path lives\n10\t#                 HERE now (not hard-coded in the launcher).\n11\t#\n12\t# Control contract (signal_file) inherits the default `.ralph-stop` / `.ralph-steer`\n13\t# convention from lib/loops.sh — no adapter override needed.\n14\t\n15\t# Build ralph's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n16\t# it). MODE selects the runner: `once` runs a single iteration (once.sh PRD),\n17\t# `afk` runs autonomously (afk.sh PRD ITERATIONS). The ralph runner scripts live\n18\t# under the ralph-loop skill — this adapter is the single place that path is\n19\t# named, so the launcher no longer hard-codes …/ralph-loop/scripts/…. Returns 2\n20\t# for an unknown mode. Requires $ALMANAC_HOME (set by every entry point).\n21\talmanac_loop_ralph_exec_argv() {\n22\t  local mode=\"$1\" prd=\"$2\" iterations=\"${3:-}\"\n23\t  local scripts=\"$ALMANAC_HOME/skills/loop/ralph-loop/scripts\"\n24\t  case \"$mode\" in\n25\t    once) _ALMANAC_LOOP_ARGV=(bash \"$scripts/once.sh\" \"$prd\") ;;\n26\t    afk)  _ALMANAC_LOOP_ARGV=(bash \"$scripts/afk.sh\" \"$prd\" \"$iterations\") ;;\n27\t    *) return 2 ;;\n28\t  esac\n29\t  return 0\n30\t}\n31\t"}]},"parent_tool_use_id":null,"session_id":"a891a69f-75d4-4053-b662-17c3d63f7902","uuid":"1eb60abc-adc7-4fb0-9223-aae10550fad3","timestamp":"2026-05-26T14:39:00.146Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/loops/ralph.sh","content":"#!/usr/bin/env bash\n# lib/loops/ralph.sh — the ralph loop adapter.\n#\n# One file owns everything the engine needs to know about how to launch and\n# control the ralph loop. Auto-discovered by lib/loops.sh from lib/loops/*.sh.\n#\n# Contract (called as almanac_loop_ralph_<verb>):\n#   exec_argv   — launch: populate _ALMANAC_LOOP_ARGV with the runner exec tokens\n#                 for a given mode/prd/iterations. The ralph runner path lives\n#                 HERE now (not hard-coded in the launcher).\n#\n# Control contract (signal_file) inherits the default `.ralph-stop` / `.ralph-steer`\n# convention from lib/loops.sh — no adapter override needed.\n\n# Build ralph's runner exec command into _ALMANAC_LOOP_ARGV (the launcher execs\n# it). MODE selects the runner: `once` runs a single iteration (once.sh PRD),\n# `afk` runs autonomously (afk.sh PRD ITERATIONS). The ralph runner scripts live\n# under the ralph-loop skill — this adapter is the single place that path is\n# named, so the launcher no longer hard-codes …/ralph-loop/scripts/…. Returns 2\n# for an unknown mode. Requires $ALMANAC_HOME (set by every entry point).\nalmanac_loop_ralph_exec_argv() {\n  local mode=\"$1\" prd=\"$2\" iterations=\"${3:-}\"\n  local scripts=\"$ALMANAC_HOME/skills/loop/ralph-loop/scripts\"\n  case \"$mode\" in\n    once) _ALMANAC_LOOP_ARGV=(bash \"$scripts/once.sh\" \"$prd\") ;;\n    afk)  _ALMANAC_LOOP_ARGV=(bash \"$scripts/afk.sh\" \"$prd\" \"$iterations\") ;;\n    *) return 2 ;;\n  esac\n  return 0\n}\n","numLines":31,"startLine":1,"totalLines":31}}}
