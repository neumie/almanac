{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EeGe7Vnkns6PzeGGSMYLUu","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# loop-launcher.sh — the single almanac launcher (ralph + harden).\n3\t#\n4\t# almanac_loop_launch <type> [native flags…] interactively configures and starts\n5\t# a loop run. It is loop-agnostic: one launcher for every consumer — `almanac\n6\t# ralph`, `almanac harden`, the hub's New-run flow, and the ralph skill launcher\n7\t# all route here, so the config UX is identical everywhere (the PRD's \"almanac\n8\t# launcher, not per-loop reimplementations\").\n9\t#\n10\t# Each type parses its own native flags; any field a flag did not supply is asked\n11\t# once, through the shared gum-or-plain seam (almanac_loop_ui_*). Numeric fields\n12\t# validate and RE-PROMPT on a TTY rather than hard-dying (so a stray keystroke is\n13\t# a retry, not a crash); a bad value passed as a flag still errors. After a\n14\t# summary + confirm it execs the underlying runner — it never reimplements the\n15\t# run, only the configuration.\n16\t#\n17\t# Requires lib/core.sh (_die/_info/_success), sourced by every entry point before\n18\t# this file. The gum-or-plain UI seam (almanac_loop_ui_*) lives in lib/ui.sh and\n19\t# is pulled in directly below, so the launcher's dependency on it is explicit.\n20\t\n21\t# The launcher drives the whole config UX through the gum-or-plain seam\n22\t# (choose/input/confirm/render). Source it directly and idempotently so the\n23\t# dependency is the launcher's own, not borrowed from whatever sourced this file.\n24\tif ! declare -F almanac_loop_ui_choose >/dev/null 2>&1; then\n25\t  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n26\t  # shellcheck source=lib/ui.sh\n27\t  source \"$__loop_launcher_dir/ui.sh\"\n28\t  unset __loop_launcher_dir\n29\tfi\n30\t\n31\t# Provider knowledge (availability, the model/effort menus, default-selection,\n32\t# the provider list) lives in the provider-adapter seam (lib/agent.sh →\n33\t# almanac_provider_*). The launcher consumes it rather than branching on provider\n34\t# name. Source it directly and idempotently so the dependency is the launcher's\n35\t# own, not borrowed from whatever sourced this file.\n36\tif ! declare -F almanac_provider_default >/dev/null 2>&1; then\n37\t  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n38\t  # shellcheck source=lib/agent.sh\n39\t  source \"$__loop_launcher_dir/agent.sh\"\n40\t  unset __loop_launcher_dir\n41\tfi\n42\t\n43\t# The loop-adapter seam (almanac_loop_adapter_*) lives in lib/loops.sh. The\n44\t# launcher execs each loop's runner via its adapter's exec_argv (so no central\n45\t# code hard-codes a loop's runner path). Source it directly and idempotently so\n46\t# the dependency is the launcher's own, not borrowed from whatever sourced this\n47\t# file.\n48\tif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n49\t  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n50\t  # shellcheck source=lib/loops.sh\n51\t  source \"$__loop_launcher_dir/loops.sh\"\n52\t  unset __loop_launcher_dir\n53\tfi\n54\t\n55\t# --- field collectors ---------------------------------------------------------\n56\t\n57\t# Pick a provider into the named-by-$1 variable if it is empty. Lists only\n58\t# installed providers (discovered via the seam); dies if none.\n59\t_almanac_launch_need_provider() {\n60\t  local var=\"$1\" current=\"${2:-}\" providers=() p chosen\n61\t  if [ -n \"$current\" ]; then printf '%s\\n' \"$current\"; return 0; fi\n62\t  for p in $(almanac_provider_list); do\n63\t    almanac_provider_available \"$p\" && providers+=(\"$p\")\n64\t  done\n65\t  [ \"${#providers[@]}\" -gt 0 ] || _die \"No supported provider found. Install Codex or Claude Code.\"\n66\t  if [ \"${#providers[@]}\" -eq 1 ]; then printf '%s\\n' \"${providers[0]}\"; return 0; fi\n67\t  chosen=\"$(almanac_loop_ui_choose \"Provider\" \"${providers[@]}\")\" || return 1\n68\t  printf '%s\\n' \"$chosen\"\n69\t}\n70\t\n71\t# Resolve a model/effort value: if empty, show the provider menu; map \"default\"\n72\t# to empty and \"custom\" to a free-text prompt. Echoes the resolved value.\n73\t_almanac_launch_need_choice() {\n74\t  local header=\"$1\" current=\"$2\" picked\n75\t  shift 2\n76\t  if [ -n \"$current\" ]; then\n77\t    [ \"$current\" = \"default\" ] && current=\"\"\n78\t    printf '%s\\n' \"$current\"; return 0\n79\t  fi\n80\t  picked=\"$(almanac_loop_ui_choose \"$header\" \"$@\")\" || return 1\n81\t  if [ \"$picked\" = \"custom\" ]; then\n82\t    picked=\"$(almanac_loop_ui_input \"$header (custom)\")\" || return 1\n83\t  fi\n84\t  [ \"$picked\" = \"default\" ] && picked=\"\"\n85\t  printf '%s\\n' \"$picked\"\n86\t}\n87\t\n88\t# Resolve a positive integer. A preset (flag) value is validated once and dies on\n89\t# failure; an interactive value re-prompts until valid. Echoes the integer.\n90\t_almanac_launch_need_positive_int() {\n91\t  local header=\"$1\" current=\"$2\" default=\"${3:-}\" reply\n92\t  if [ -n \"$current\" ]; then\n93\t    case \"$current\" in ''|*[!0-9]*) _die \"$header must be a positive integer (got: $current)\";; esac\n94\t    [ \"$current\" -gt 0 ] || _die \"$header must be a positive integer (got: $current)\"\n95\t    printf '%s\\n' \"$current\"; return 0\n96\t  fi\n97\t  while :; do\n98\t    reply=\"$(almanac_loop_ui_input \"$header\" \"$default\")\" || return 1\n99\t    case \"$reply\" in ''|*[!0-9]*) _warn \"Enter a positive integer.\" >&2; continue;; esac\n100\t    [ \"$reply\" -gt 0 ] && { printf '%s\\n' \"$reply\"; return 0; }\n101\t    _warn \"Enter a positive integer.\" >&2\n102\t  done\n103\t}\n104\t\n105\t# --- ralph ---------------------------------------------------------------------\n106\t\n107\t_almanac_launch_ralph() {\n108\t  local prd=\"\" mode=\"\" provider=\"\" model=\"\" effort=\"\" iterations=\"\" no_oversee=\"\" yes=\"\"\n109\t  while [ \"$#\" -gt 0 ]; do\n110\t    case \"$1\" in\n111\t      --prd)        shift; prd=\"${1:-}\";        [ -n \"$prd\" ] || _die \"--prd requires a value\" ;;\n112\t      --mode)       shift; mode=\"${1:-}\";       [ -n \"$mode\" ] || _die \"--mode requires a value\" ;;\n113\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n114\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n115\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n116\t      --iterations) shift; iterations=\"${1:-}\"; [ -n \"$iterations\" ] || _die \"--iterations requires a value\" ;;\n117\t      --no-oversee) no_oversee=1 ;;\n118\t      --yes|-y) yes=1 ;;\n119\t      --help|-h) almanac_loop_launch_usage ralph; return 0 ;;\n120\t      *) _die \"Unknown ralph launch option: $1\" ;;\n121\t    esac\n122\t    shift\n123\t  done\n124\t\n125\t  [ -d docs/plans ] || _die \"docs/plans/ not found. Run from the project root.\"\n126\t\n127\t  # PRD\n128\t  if [ -z \"$prd\" ]; then\n129\t    local prds=() dir\n130\t    for dir in docs/plans/*/; do\n131\t      [ -f \"${dir}prd.md\" ] && prds+=(\"$(basename \"$dir\")\")\n132\t    done\n133\t    [ \"${#prds[@]}\" -gt 0 ] || _die \"No PRDs in docs/plans/. Run /prd-create first.\"\n134\t    if [ \"${#prds[@]}\" -eq 1 ]; then prd=\"${prds[0]}\"; else prd=\"$(almanac_loop_ui_choose \"Select PRD\" \"${prds[@]}\")\" || return 1; fi\n135\t  fi\n136\t  [ -f \"docs/plans/${prd}/prd.md\" ]    || _die \"docs/plans/${prd}/prd.md not found.\"\n137\t  [ -f \"docs/plans/${prd}/prompt.md\" ] || _die \"docs/plans/${prd}/prompt.md not found. Run /ralph-loop ${prd} first.\"\n138\t\n139\t  # Mode\n140\t  [ -n \"$mode\" ] || mode=\"$(almanac_loop_ui_choose \"Mode\" once afk)\" || return 1\n141\t  case \"$mode\" in once|afk) ;; *) _die \"--mode must be once or afk\" ;; esac\n142\t\n143\t  # Provider / model / effort\n144\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n145\t  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n146\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n147\t  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n148\t  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n149\t\n150\t  # Iterations + overseer (afk only)\n151\t  if [ \"$mode\" = \"afk\" ]; then\n152\t    iterations=\"$(_almanac_launch_need_positive_int \"Iterations\" \"$iterations\" \"10\")\" || return 1\n153\t    if [ -z \"$no_oversee\" ]; then\n154\t      almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n155\t    fi\n156\t  fi\n157\t\n158\t  # Summary + confirm\n159\t  almanac_loop_launch_summary \"ralph\" \\\n160\t    \"PRD:$prd\" \"Mode:$mode\" \"Provider:$provider\" \\\n161\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n162\t    $([ \"$mode\" = \"afk\" ] && printf '%s\\n%s' \"Iterations:$iterations\" \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\")\n163\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n164\t\n165\t  # Export role config + exec the runner (no re-launch through `almanac ralph`).\n166\t  export RALPH_PROVIDER=\"$provider\"\n167\t  [ -n \"$model\" ]  && export RALPH_MODEL=\"$model\"   || unset RALPH_MODEL\n168\t  [ -n \"$effort\" ] && export RALPH_EFFORT=\"$effort\" || unset RALPH_EFFORT\n169\t  [ -n \"$no_oversee\" ] && export RALPH_NO_OVERSEE=1\n170\t\n171\t  # Exec the runner via the ralph adapter (no hard-coded …/ralph-loop/scripts/…\n172\t  # path lives here any more — the adapter owns it).\n173\t  almanac_loop_adapter_call ralph exec_argv \"$mode\" \"$prd\" \"$iterations\" \\\n174\t    || _die \"ralph adapter could not build a runner for mode: $mode\"\n175\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n176\t}\n177\t\n178\t# --- harden --------------------------------------------------------------------\n179\t\n180\t_almanac_launch_harden() {\n181\t  local target=\"\" lenses=\"\" provider=\"\" model=\"\" effort=\"\" rounds=\"\" yes=\"\"\n182\t  while [ \"$#\" -gt 0 ]; do\n183\t    case \"$1\" in\n184\t      --lenses)   shift; lenses=\"${1:-}\";   [ -n \"$lenses\" ] || _die \"--lenses requires a value\" ;;\n185\t      --provider) shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n186\t      --model)    shift; model=\"${1:-}\";    [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n187\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n188\t      --rounds)   shift; rounds=\"${1:-}\";   [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n189\t      --yes|-y) yes=1 ;;\n190\t      --help|-h) almanac_loop_launch_usage harden; return 0 ;;\n191\t      -*) _die \"Unknown harden launch option: $1\" ;;\n192\t      *)  [ -z \"$target\" ] && target=\"$1\" || _die \"Unexpected harden argument: $1\" ;;\n193\t    esac\n194\t    shift\n195\t  done\n196\t\n197\t  [ -n \"$target\" ] || target=\"$(almanac_loop_ui_input \"Target (file / dir / PR)\")\" || return 1\n198\t  [ -n \"$target\" ] || _die \"A harden target is required.\"\n199\t\n200\t  lenses=\"$(test -n \"$lenses\" && printf '%s' \"$lenses\" || almanac_loop_ui_input \"Lenses (blank = default set)\")\" || return 1\n201\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n202\t  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n203\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n204\t  model=\"$(_almanac_launch_need_choice \"Reviewer model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n205\t  effort=\"$(_almanac_launch_need_choice \"Reviewer thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n206\t  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n207\t  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n208\t\n209\t  almanac_loop_launch_summary \"harden\" \\\n210\t    \"Target:$target\" \"Lenses:${lenses:-default set}\" \"Provider:$provider\" \\\n211\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n212\t    \"Rounds:${rounds:-default budget}\"\n213\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n214\t\n215\t  [ -n \"$lenses\" ]   && export HARDEN_LENSES=\"$lenses\"\n216\t  export HARDEN_PROVIDER=\"$provider\"\n217\t  [ -n \"$model\" ]    && export HARDEN_MODEL=\"$model\"   || unset HARDEN_MODEL\n218\t  [ -n \"$effort\" ]   && export HARDEN_EFFORT=\"$effort\" || unset HARDEN_EFFORT\n219\t\n220\t  # Exec the runner via the harden adapter (its convergence loop runs through\n221\t  # `almanac harden <target> --loop` — the adapter owns that invocation).\n222\t  almanac_loop_adapter_call harden exec_argv \"$target\" \"$rounds\" \\\n223\t    || _die \"harden adapter could not build a runner for target: $target\"\n224\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n225\t}\n226\t\n227\t# --- converge ------------------------------------------------------------------\n228\t\n229\t_almanac_launch_converge() {\n230\t  local goal=\"\" exec_cmd=\"\" prompt=\"\" rounds=\"\" provider=\"\" model=\"\" effort=\"\" no_oversee=\"\" oversee_every=\"\" yes=\"\"\n231\t  while [ \"$#\" -gt 0 ]; do\n232\t    case \"$1\" in\n233\t      --goal)       shift; goal=\"${1:-}\";       [ -n \"$goal\" ] || _die \"--goal requires a value\" ;;\n234\t      --exec)       shift; exec_cmd=\"${1:-}\";   [ -n \"$exec_cmd\" ] || _die \"--exec requires a value\" ;;\n235\t      --prompt)     shift; prompt=\"${1:-}\";     [ -n \"$prompt\" ] || _die \"--prompt requires a value\" ;;\n236\t      --rounds)     shift; rounds=\"${1:-}\";     [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n237\t      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n238\t      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n239\t      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n240\t      --no-oversee) no_oversee=1 ;;\n241\t      --oversee-every) shift; oversee_every=\"${1:-}\"; [ -n \"$oversee_every\" ] || _die \"--oversee-every requires a value\" ;;\n242\t      --yes|-y) yes=1 ;;\n243\t      --help|-h) almanac_loop_launch_usage converge; return 0 ;;\n244\t      *) _die \"Unknown converge launch option: $1\" ;;\n245\t    esac\n246\t    shift\n247\t  done\n248\t\n249\t  # Goal is always required. Action is either --prompt (agent invocation —\n250\t  # dominant mode, takes slash commands / chains / free-form text) or --exec\n251\t  # (shell command run by a wrapping worker agent — escape hatch). Mutex\n252\t  # enforced; the runner enforces it again so direct invocations stay safe.\n253\t  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then\n254\t    _die \"--prompt and --exec are mutually exclusive — pick one\"\n255\t  fi\n256\t\n257\t  [ -n \"$goal\" ] || goal=\"$(almanac_loop_ui_input \"Goal (one-line description of convergence target)\")\" || return 1\n258\t  [ -n \"$goal\" ] || _die \"A converge goal is required.\"\n259\t\n260\t  # If neither --prompt nor --exec was passed, ask which mode the operator\n261\t  # wants and prompt for the value. Default to prompt-mode because slash-command\n262\t  # convergence is the canonical use case.\n263\t  if [ -z \"$prompt\" ] && [ -z \"$exec_cmd\" ]; then\n264\t    local action_mode\n265\t    action_mode=\"$(almanac_loop_ui_choose \"Action mode\" \"prompt (agent invocation — recommended)\" \"exec (shell command)\")\" || return 1\n266\t    case \"$action_mode\" in\n267\t      prompt*)\n268\t        prompt=\"$(almanac_loop_ui_input \"Prompt (slash command, chain, or free-form — sent to agent each round)\")\" || return 1\n269\t        [ -n \"$prompt\" ] || _die \"A converge --prompt or --exec is required.\"\n270\t        ;;\n271\t      exec*)\n272\t        exec_cmd=\"$(almanac_loop_ui_input \"Exec (shell command run by wrapping worker agent each round)\")\" || return 1\n273\t        [ -n \"$exec_cmd\" ] || _die \"A converge --prompt or --exec is required.\"\n274\t        ;;\n275\t    esac\n276\t  fi\n277\t\n278\t  local action_mode action_text\n279\t  if [ -n \"$prompt\" ]; then\n280\t    action_mode=\"prompt\"\n281\t    action_text=\"$prompt\"\n282\t  else\n283\t    action_mode=\"exec\"\n284\t    action_text=\"$exec_cmd\"\n285\t  fi\n286\t\n287\t  # Provider / model / effort — same resolution as ralph + harden. Single\n288\t  # provider drives both the worker and overseer roles by default; the user can\n289\t  # still override per-role via CONVERGE_{AGENT,OVERSEER}_* env outside the\n290\t  # launcher.\n291\t  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n292\t  almanac_provider_known \"$provider\"     || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n293\t  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n294\t  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n295\t  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n296\t\n297\t  # Rounds: optional; blank accepts the cmd/converge.sh default\n298\t  # (CONVERGE_ROUND_BUDGET or 10). Validated when present.\n299\t  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n300\t  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n301\t\n302\t  # Overseer: on by default; ask the operator only if neither flag was passed.\n303\t  if [ -z \"$no_oversee\" ]; then\n304\t    almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n305\t  fi\n306\t\n307\t  almanac_loop_launch_summary \"converge\" \\\n308\t    \"Goal:$goal\" \\\n309\t    \"$([ \"$action_mode\" = \"prompt\" ] && printf 'Prompt:%s' \"$action_text\" || printf 'Exec:%s' \"$action_text\")\" \\\n310\t    \"Provider:$provider\" \\\n311\t    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n312\t    \"Rounds:${rounds:-default budget}\" \\\n313\t    \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\" \\\n314\t    $([ -n \"$oversee_every\" ] && printf 'Oversee-every:%s' \"$oversee_every\")\n315\t  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n316\t\n317\t  # Export role config — same shape as ralph/harden. The consumer-wide\n318\t  # CONVERGE_PROVIDER/MODEL/EFFORT becomes the fallback that role.sh's lookup\n319\t  # uses for both the worker and overseer roles unless the user has set\n320\t  # CONVERGE_{AGENT,OVERSEER}_* explicitly.\n321\t  export CONVERGE_PROVIDER=\"$provider\"\n322\t  [ -n \"$model\" ]  && export CONVERGE_MODEL=\"$model\"   || unset CONVERGE_MODEL\n323\t  [ -n \"$effort\" ] && export CONVERGE_EFFORT=\"$effort\" || unset CONVERGE_EFFORT\n324\t\n325\t  # Build the runner argv via the adapter (the path to bin/almanac and the flag\n326\t  # composition both live in lib/loops/converge.sh — the launcher doesn't know\n327\t  # them). The adapter takes mode + action so the same call shape works for\n328\t  # both --prompt and --exec.\n329\t  almanac_loop_adapter_call converge exec_argv \"$goal\" \"$action_mode\" \"$action_text\" \"$rounds\" \"$no_oversee\" \"$oversee_every\" \\\n330\t    || _die \"converge adapter could not build a runner for goal: $goal\"\n331\t  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n332\t}\n333\t\n334\t# --- summary + dispatch --------------------------------------------------------\n335\t\n336\t# Render a \"LABEL:value\" config summary as a gum-styled (or plain) panel. Each\n337\t# remaining arg is one \"Field:value\" line. Presentation only.\n338\talmanac_loop_launch_summary() {\n339\t  local type=\"$1\"; shift\n340\t  local line\n341\t  {\n342\t    printf '%s\\n' \"$(printf '%s' \"$type\" | tr '[:lower:]' '[:upper:]') run\"\n343\t    printf '%s\\n' \"──────────────────\"\n344\t    for line in \"$@\"; do\n345\t      printf '  %-11s %s\\n' \"${line%%:*}\" \"${line#*:}\"\n346\t    done\n347\t  } | almanac_loop_ui_render >&2\n348\t}\n349\t\n350\t# Per-type usage, printed for --help. Goes to stderr (stdout stays capture-clean).\n351\talmanac_loop_launch_usage() {\n352\t  case \"$1\" in\n353\t    ralph) cat >&2 <<'EOF'\n354\tUsage: almanac ralph [options]   (also: bash ralph.sh [options])\n355\t  --prd <name>        PRD under docs/plans/<name>/\n356\t  --mode <once|afk>   one iteration, or autonomous\n357\t  --provider <p>      codex | claude\n358\t  --model <m>         model name (\"default\" = provider default)\n359\t  --effort <l>        thinking level (\"default\" = provider default)\n360\t  --iterations <n>    afk iteration count\n361\t  --no-oversee        disable the afk overseer\n362\tAny option not given is prompted interactively.\n363\tEOF\n364\t      ;;\n365\t    harden) cat >&2 <<'EOF'\n366\tUsage (loop launch): <target> [options]\n367\t  <target>            file / dir / PR to harden\n368\t  --lenses <list>     reviewer lenses (blank = default set)\n369\t  --provider <p>      codex | claude\n370\t  --model <m>         reviewer model\n371\t  --effort <l>        reviewer thinking level\n372\t  --rounds <n>        round budget\n373\tAny option not given is prompted interactively.\n374\tEOF\n375\t      ;;\n376\t    converge) cat >&2 <<'EOF'\n377\tUsage (loop launch): converge [options]\n378\t  --goal <text>       one-line convergence goal (overseer can mutate it)\n379\t  --prompt <text>     prompt sent to the configured agent each round (slash\n380\t                      command, chain, or free-form). The dominant mode.\n381\t  --exec <cmd>        shell command run by a wrapping worker agent each round\n382\t                      (escape hatch for non-agent workflows).\n383\t                      Exactly one of --prompt / --exec is required.\n384\t  --provider <p>      codex | claude\n385\t  --model <m>         worker / overseer model\n386\t  --effort <l>        thinking level\n387\t  --rounds <n>        round budget (blank = default 10)\n388\t  --no-oversee        disable the overseer (rounds budget is the only stop)\n389\t  --oversee-every <n> overseer cadence in rounds (default 1)\n390\tAny option not given is prompted interactively.\n391\tEOF\n392\t      ;;\n393\t  esac\n394\t}\n395\t\n396\t# Public entry: configure and launch a run of TYPE (ralph|harden|converge).\n397\t# Remaining args are that type's native flags; missing fields are prompted.\n398\t# Execs the runner.\n399\talmanac_loop_launch() {\n400\t  local type=\"${1:-}\"; shift || true\n401\t  case \"$type\" in\n402\t    ralph)    _almanac_launch_ralph \"$@\" ;;\n403\t    harden)   _almanac_launch_harden \"$@\" ;;\n404\t    converge) _almanac_launch_converge \"$@\" ;;\n405\t    \"\")       _die \"Usage: almanac_loop_launch <ralph|harden|converge> [options]\" ;;\n406\t    *)        _die \"Unknown loop type: $type (use ralph, harden, or converge)\" ;;\n407\t  esac\n408\t}\n409\t"}]},"parent_tool_use_id":null,"session_id":"a891a69f-75d4-4053-b662-17c3d63f7902","uuid":"83fb0903-ed3a-4219-a452-f0aac2895fb3","timestamp":"2026-05-26T14:39:04.475Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jakubneumann/Documents/code/neumie/almanac/lib/loop-launcher.sh","content":"#!/usr/bin/env bash\n# loop-launcher.sh — the single almanac launcher (ralph + harden).\n#\n# almanac_loop_launch <type> [native flags…] interactively configures and starts\n# a loop run. It is loop-agnostic: one launcher for every consumer — `almanac\n# ralph`, `almanac harden`, the hub's New-run flow, and the ralph skill launcher\n# all route here, so the config UX is identical everywhere (the PRD's \"almanac\n# launcher, not per-loop reimplementations\").\n#\n# Each type parses its own native flags; any field a flag did not supply is asked\n# once, through the shared gum-or-plain seam (almanac_loop_ui_*). Numeric fields\n# validate and RE-PROMPT on a TTY rather than hard-dying (so a stray keystroke is\n# a retry, not a crash); a bad value passed as a flag still errors. After a\n# summary + confirm it execs the underlying runner — it never reimplements the\n# run, only the configuration.\n#\n# Requires lib/core.sh (_die/_info/_success), sourced by every entry point before\n# this file. The gum-or-plain UI seam (almanac_loop_ui_*) lives in lib/ui.sh and\n# is pulled in directly below, so the launcher's dependency on it is explicit.\n\n# The launcher drives the whole config UX through the gum-or-plain seam\n# (choose/input/confirm/render). Source it directly and idempotently so the\n# dependency is the launcher's own, not borrowed from whatever sourced this file.\nif ! declare -F almanac_loop_ui_choose >/dev/null 2>&1; then\n  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/ui.sh\n  source \"$__loop_launcher_dir/ui.sh\"\n  unset __loop_launcher_dir\nfi\n\n# Provider knowledge (availability, the model/effort menus, default-selection,\n# the provider list) lives in the provider-adapter seam (lib/agent.sh →\n# almanac_provider_*). The launcher consumes it rather than branching on provider\n# name. Source it directly and idempotently so the dependency is the launcher's\n# own, not borrowed from whatever sourced this file.\nif ! declare -F almanac_provider_default >/dev/null 2>&1; then\n  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/agent.sh\n  source \"$__loop_launcher_dir/agent.sh\"\n  unset __loop_launcher_dir\nfi\n\n# The loop-adapter seam (almanac_loop_adapter_*) lives in lib/loops.sh. The\n# launcher execs each loop's runner via its adapter's exec_argv (so no central\n# code hard-codes a loop's runner path). Source it directly and idempotently so\n# the dependency is the launcher's own, not borrowed from whatever sourced this\n# file.\nif ! declare -F almanac_loop_adapter_call >/dev/null 2>&1; then\n  __loop_launcher_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n  # shellcheck source=lib/loops.sh\n  source \"$__loop_launcher_dir/loops.sh\"\n  unset __loop_launcher_dir\nfi\n\n# --- field collectors ---------------------------------------------------------\n\n# Pick a provider into the named-by-$1 variable if it is empty. Lists only\n# installed providers (discovered via the seam); dies if none.\n_almanac_launch_need_provider() {\n  local var=\"$1\" current=\"${2:-}\" providers=() p chosen\n  if [ -n \"$current\" ]; then printf '%s\\n' \"$current\"; return 0; fi\n  for p in $(almanac_provider_list); do\n    almanac_provider_available \"$p\" && providers+=(\"$p\")\n  done\n  [ \"${#providers[@]}\" -gt 0 ] || _die \"No supported provider found. Install Codex or Claude Code.\"\n  if [ \"${#providers[@]}\" -eq 1 ]; then printf '%s\\n' \"${providers[0]}\"; return 0; fi\n  chosen=\"$(almanac_loop_ui_choose \"Provider\" \"${providers[@]}\")\" || return 1\n  printf '%s\\n' \"$chosen\"\n}\n\n# Resolve a model/effort value: if empty, show the provider menu; map \"default\"\n# to empty and \"custom\" to a free-text prompt. Echoes the resolved value.\n_almanac_launch_need_choice() {\n  local header=\"$1\" current=\"$2\" picked\n  shift 2\n  if [ -n \"$current\" ]; then\n    [ \"$current\" = \"default\" ] && current=\"\"\n    printf '%s\\n' \"$current\"; return 0\n  fi\n  picked=\"$(almanac_loop_ui_choose \"$header\" \"$@\")\" || return 1\n  if [ \"$picked\" = \"custom\" ]; then\n    picked=\"$(almanac_loop_ui_input \"$header (custom)\")\" || return 1\n  fi\n  [ \"$picked\" = \"default\" ] && picked=\"\"\n  printf '%s\\n' \"$picked\"\n}\n\n# Resolve a positive integer. A preset (flag) value is validated once and dies on\n# failure; an interactive value re-prompts until valid. Echoes the integer.\n_almanac_launch_need_positive_int() {\n  local header=\"$1\" current=\"$2\" default=\"${3:-}\" reply\n  if [ -n \"$current\" ]; then\n    case \"$current\" in ''|*[!0-9]*) _die \"$header must be a positive integer (got: $current)\";; esac\n    [ \"$current\" -gt 0 ] || _die \"$header must be a positive integer (got: $current)\"\n    printf '%s\\n' \"$current\"; return 0\n  fi\n  while :; do\n    reply=\"$(almanac_loop_ui_input \"$header\" \"$default\")\" || return 1\n    case \"$reply\" in ''|*[!0-9]*) _warn \"Enter a positive integer.\" >&2; continue;; esac\n    [ \"$reply\" -gt 0 ] && { printf '%s\\n' \"$reply\"; return 0; }\n    _warn \"Enter a positive integer.\" >&2\n  done\n}\n\n# --- ralph ---------------------------------------------------------------------\n\n_almanac_launch_ralph() {\n  local prd=\"\" mode=\"\" provider=\"\" model=\"\" effort=\"\" iterations=\"\" no_oversee=\"\" yes=\"\"\n  while [ \"$#\" -gt 0 ]; do\n    case \"$1\" in\n      --prd)        shift; prd=\"${1:-}\";        [ -n \"$prd\" ] || _die \"--prd requires a value\" ;;\n      --mode)       shift; mode=\"${1:-}\";       [ -n \"$mode\" ] || _die \"--mode requires a value\" ;;\n      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n      --iterations) shift; iterations=\"${1:-}\"; [ -n \"$iterations\" ] || _die \"--iterations requires a value\" ;;\n      --no-oversee) no_oversee=1 ;;\n      --yes|-y) yes=1 ;;\n      --help|-h) almanac_loop_launch_usage ralph; return 0 ;;\n      *) _die \"Unknown ralph launch option: $1\" ;;\n    esac\n    shift\n  done\n\n  [ -d docs/plans ] || _die \"docs/plans/ not found. Run from the project root.\"\n\n  # PRD\n  if [ -z \"$prd\" ]; then\n    local prds=() dir\n    for dir in docs/plans/*/; do\n      [ -f \"${dir}prd.md\" ] && prds+=(\"$(basename \"$dir\")\")\n    done\n    [ \"${#prds[@]}\" -gt 0 ] || _die \"No PRDs in docs/plans/. Run /prd-create first.\"\n    if [ \"${#prds[@]}\" -eq 1 ]; then prd=\"${prds[0]}\"; else prd=\"$(almanac_loop_ui_choose \"Select PRD\" \"${prds[@]}\")\" || return 1; fi\n  fi\n  [ -f \"docs/plans/${prd}/prd.md\" ]    || _die \"docs/plans/${prd}/prd.md not found.\"\n  [ -f \"docs/plans/${prd}/prompt.md\" ] || _die \"docs/plans/${prd}/prompt.md not found. Run /ralph-loop ${prd} first.\"\n\n  # Mode\n  [ -n \"$mode\" ] || mode=\"$(almanac_loop_ui_choose \"Mode\" once afk)\" || return 1\n  case \"$mode\" in once|afk) ;; *) _die \"--mode must be once or afk\" ;; esac\n\n  # Provider / model / effort\n  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n\n  # Iterations + overseer (afk only)\n  if [ \"$mode\" = \"afk\" ]; then\n    iterations=\"$(_almanac_launch_need_positive_int \"Iterations\" \"$iterations\" \"10\")\" || return 1\n    if [ -z \"$no_oversee\" ]; then\n      almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n    fi\n  fi\n\n  # Summary + confirm\n  almanac_loop_launch_summary \"ralph\" \\\n    \"PRD:$prd\" \"Mode:$mode\" \"Provider:$provider\" \\\n    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n    $([ \"$mode\" = \"afk\" ] && printf '%s\\n%s' \"Iterations:$iterations\" \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\")\n  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n\n  # Export role config + exec the runner (no re-launch through `almanac ralph`).\n  export RALPH_PROVIDER=\"$provider\"\n  [ -n \"$model\" ]  && export RALPH_MODEL=\"$model\"   || unset RALPH_MODEL\n  [ -n \"$effort\" ] && export RALPH_EFFORT=\"$effort\" || unset RALPH_EFFORT\n  [ -n \"$no_oversee\" ] && export RALPH_NO_OVERSEE=1\n\n  # Exec the runner via the ralph adapter (no hard-coded …/ralph-loop/scripts/…\n  # path lives here any more — the adapter owns it).\n  almanac_loop_adapter_call ralph exec_argv \"$mode\" \"$prd\" \"$iterations\" \\\n    || _die \"ralph adapter could not build a runner for mode: $mode\"\n  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n}\n\n# --- harden --------------------------------------------------------------------\n\n_almanac_launch_harden() {\n  local target=\"\" lenses=\"\" provider=\"\" model=\"\" effort=\"\" rounds=\"\" yes=\"\"\n  while [ \"$#\" -gt 0 ]; do\n    case \"$1\" in\n      --lenses)   shift; lenses=\"${1:-}\";   [ -n \"$lenses\" ] || _die \"--lenses requires a value\" ;;\n      --provider) shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n      --model)    shift; model=\"${1:-}\";    [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n      --rounds)   shift; rounds=\"${1:-}\";   [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n      --yes|-y) yes=1 ;;\n      --help|-h) almanac_loop_launch_usage harden; return 0 ;;\n      -*) _die \"Unknown harden launch option: $1\" ;;\n      *)  [ -z \"$target\" ] && target=\"$1\" || _die \"Unexpected harden argument: $1\" ;;\n    esac\n    shift\n  done\n\n  [ -n \"$target\" ] || target=\"$(almanac_loop_ui_input \"Target (file / dir / PR)\")\" || return 1\n  [ -n \"$target\" ] || _die \"A harden target is required.\"\n\n  lenses=\"$(test -n \"$lenses\" && printf '%s' \"$lenses\" || almanac_loop_ui_input \"Lenses (blank = default set)\")\" || return 1\n  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n  almanac_provider_known \"$provider\" || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n  model=\"$(_almanac_launch_need_choice \"Reviewer model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n  effort=\"$(_almanac_launch_need_choice \"Reviewer thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n\n  almanac_loop_launch_summary \"harden\" \\\n    \"Target:$target\" \"Lenses:${lenses:-default set}\" \"Provider:$provider\" \\\n    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n    \"Rounds:${rounds:-default budget}\"\n  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n\n  [ -n \"$lenses\" ]   && export HARDEN_LENSES=\"$lenses\"\n  export HARDEN_PROVIDER=\"$provider\"\n  [ -n \"$model\" ]    && export HARDEN_MODEL=\"$model\"   || unset HARDEN_MODEL\n  [ -n \"$effort\" ]   && export HARDEN_EFFORT=\"$effort\" || unset HARDEN_EFFORT\n\n  # Exec the runner via the harden adapter (its convergence loop runs through\n  # `almanac harden <target> --loop` — the adapter owns that invocation).\n  almanac_loop_adapter_call harden exec_argv \"$target\" \"$rounds\" \\\n    || _die \"harden adapter could not build a runner for target: $target\"\n  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n}\n\n# --- converge ------------------------------------------------------------------\n\n_almanac_launch_converge() {\n  local goal=\"\" exec_cmd=\"\" prompt=\"\" rounds=\"\" provider=\"\" model=\"\" effort=\"\" no_oversee=\"\" oversee_every=\"\" yes=\"\"\n  while [ \"$#\" -gt 0 ]; do\n    case \"$1\" in\n      --goal)       shift; goal=\"${1:-}\";       [ -n \"$goal\" ] || _die \"--goal requires a value\" ;;\n      --exec)       shift; exec_cmd=\"${1:-}\";   [ -n \"$exec_cmd\" ] || _die \"--exec requires a value\" ;;\n      --prompt)     shift; prompt=\"${1:-}\";     [ -n \"$prompt\" ] || _die \"--prompt requires a value\" ;;\n      --rounds)     shift; rounds=\"${1:-}\";     [ -n \"$rounds\" ] || _die \"--rounds requires a value\" ;;\n      --provider)   shift; provider=\"$(printf '%s' \"${1:-}\" | tr '[:upper:]' '[:lower:]')\"; [ -n \"$provider\" ] || _die \"--provider requires a value\" ;;\n      --model)      shift; model=\"${1:-}\";      [ -n \"$model\" ] || _die \"--model requires a value\" ;;\n      --effort|--thinking) shift; effort=\"${1:-}\"; [ -n \"$effort\" ] || _die \"$1 requires a value\" ;;\n      --no-oversee) no_oversee=1 ;;\n      --oversee-every) shift; oversee_every=\"${1:-}\"; [ -n \"$oversee_every\" ] || _die \"--oversee-every requires a value\" ;;\n      --yes|-y) yes=1 ;;\n      --help|-h) almanac_loop_launch_usage converge; return 0 ;;\n      *) _die \"Unknown converge launch option: $1\" ;;\n    esac\n    shift\n  done\n\n  # Goal is always required. Action is either --prompt (agent invocation —\n  # dominant mode, takes slash commands / chains / free-form text) or --exec\n  # (shell command run by a wrapping worker agent — escape hatch). Mutex\n  # enforced; the runner enforces it again so direct invocations stay safe.\n  if [ -n \"$prompt\" ] && [ -n \"$exec_cmd\" ]; then\n    _die \"--prompt and --exec are mutually exclusive — pick one\"\n  fi\n\n  [ -n \"$goal\" ] || goal=\"$(almanac_loop_ui_input \"Goal (one-line description of convergence target)\")\" || return 1\n  [ -n \"$goal\" ] || _die \"A converge goal is required.\"\n\n  # If neither --prompt nor --exec was passed, ask which mode the operator\n  # wants and prompt for the value. Default to prompt-mode because slash-command\n  # convergence is the canonical use case.\n  if [ -z \"$prompt\" ] && [ -z \"$exec_cmd\" ]; then\n    local action_mode\n    action_mode=\"$(almanac_loop_ui_choose \"Action mode\" \"prompt (agent invocation — recommended)\" \"exec (shell command)\")\" || return 1\n    case \"$action_mode\" in\n      prompt*)\n        prompt=\"$(almanac_loop_ui_input \"Prompt (slash command, chain, or free-form — sent to agent each round)\")\" || return 1\n        [ -n \"$prompt\" ] || _die \"A converge --prompt or --exec is required.\"\n        ;;\n      exec*)\n        exec_cmd=\"$(almanac_loop_ui_input \"Exec (shell command run by wrapping worker agent each round)\")\" || return 1\n        [ -n \"$exec_cmd\" ] || _die \"A converge --prompt or --exec is required.\"\n        ;;\n    esac\n  fi\n\n  local action_mode action_text\n  if [ -n \"$prompt\" ]; then\n    action_mode=\"prompt\"\n    action_text=\"$prompt\"\n  else\n    action_mode=\"exec\"\n    action_text=\"$exec_cmd\"\n  fi\n\n  # Provider / model / effort — same resolution as ralph + harden. Single\n  # provider drives both the worker and overseer roles by default; the user can\n  # still override per-role via CONVERGE_{AGENT,OVERSEER}_* env outside the\n  # launcher.\n  provider=\"$(_almanac_launch_need_provider provider \"$provider\")\" || return 1\n  almanac_provider_known \"$provider\"     || _die \"--provider must be a supported provider (e.g. codex or claude)\"\n  almanac_provider_available \"$provider\" || _die \"Provider '$provider' selected but its CLI is not on PATH.\"\n  model=\"$(_almanac_launch_need_choice \"Model\" \"$model\" $(almanac_provider_models \"$provider\"))\" || return 1\n  effort=\"$(_almanac_launch_need_choice \"Thinking effort\" \"$effort\" $(almanac_provider_efforts \"$provider\"))\" || return 1\n\n  # Rounds: optional; blank accepts the cmd/converge.sh default\n  # (CONVERGE_ROUND_BUDGET or 10). Validated when present.\n  [ -n \"$rounds\" ] || rounds=\"$(almanac_loop_ui_input \"Round budget (blank = default)\")\" || return 1\n  [ -z \"$rounds\" ] || rounds=\"$(_almanac_launch_need_positive_int \"Round budget\" \"$rounds\")\" || return 1\n\n  # Overseer: on by default; ask the operator only if neither flag was passed.\n  if [ -z \"$no_oversee\" ]; then\n    almanac_loop_ui_confirm \"Run the overseer?\" || no_oversee=1\n  fi\n\n  almanac_loop_launch_summary \"converge\" \\\n    \"Goal:$goal\" \\\n    \"$([ \"$action_mode\" = \"prompt\" ] && printf 'Prompt:%s' \"$action_text\" || printf 'Exec:%s' \"$action_text\")\" \\\n    \"Provider:$provider\" \\\n    \"Model:${model:-provider default}\" \"Thinking:${effort:-provider default}\" \\\n    \"Rounds:${rounds:-default budget}\" \\\n    \"Overseer:$([ -n \"$no_oversee\" ] && echo off || echo on)\" \\\n    $([ -n \"$oversee_every\" ] && printf 'Oversee-every:%s' \"$oversee_every\")\n  [ -n \"$yes\" ] || almanac_loop_ui_confirm \"Launch this run?\" || { _info \"Cancelled.\"; return 0; }\n\n  # Export role config — same shape as ralph/harden. The consumer-wide\n  # CONVERGE_PROVIDER/MODEL/EFFORT becomes the fallback that role.sh's lookup\n  # uses for both the worker and overseer roles unless the user has set\n  # CONVERGE_{AGENT,OVERSEER}_* explicitly.\n  export CONVERGE_PROVIDER=\"$provider\"\n  [ -n \"$model\" ]  && export CONVERGE_MODEL=\"$model\"   || unset CONVERGE_MODEL\n  [ -n \"$effort\" ] && export CONVERGE_EFFORT=\"$effort\" || unset CONVERGE_EFFORT\n\n  # Build the runner argv via the adapter (the path to bin/almanac and the flag\n  # composition both live in lib/loops/converge.sh — the launcher doesn't know\n  # them). The adapter takes mode + action so the same call shape works for\n  # both --prompt and --exec.\n  almanac_loop_adapter_call converge exec_argv \"$goal\" \"$action_mode\" \"$action_text\" \"$rounds\" \"$no_oversee\" \"$oversee_every\" \\\n    || _die \"converge adapter could not build a runner for goal: $goal\"\n  exec \"${_ALMANAC_LOOP_ARGV[@]}\"\n}\n\n# --- summary + dispatch --------------------------------------------------------\n\n# Render a \"LABEL:value\" config summary as a gum-styled (or plain) panel. Each\n# remaining arg is one \"Field:value\" line. Presentation only.\nalmanac_loop_launch_summary() {\n  local type=\"$1\"; shift\n  local line\n  {\n    printf '%s\\n' \"$(printf '%s' \"$type\" | tr '[:lower:]' '[:upper:]') run\"\n    printf '%s\\n' \"──────────────────\"\n    for line in \"$@\"; do\n      printf '  %-11s %s\\n' \"${line%%:*}\" \"${line#*:}\"\n    done\n  } | almanac_loop_ui_render >&2\n}\n\n# Per-type usage, printed for --help. Goes to stderr (stdout stays capture-clean).\nalmanac_loop_launch_usage() {\n  case \"$1\" in\n    ralph) cat >&2 <<'EOF'\nUsage: almanac ralph [options]   (also: bash ralph.sh [options])\n  --prd <name>        PRD under docs/plans/<name>/\n  --mode <once|afk>   one iteration, or autonomous\n  --provider <p>      codex | claude\n  --model <m>         model name (\"default\" = provider default)\n  --effort <l>        thinking level (\"default\" = provider default)\n  --iterations <n>    afk iteration count\n  --no-oversee        disable the afk overseer\nAny option not given is prompted interactively.\nEOF\n      ;;\n    harden) cat >&2 <<'EOF'\nUsage (loop launch): <target> [options]\n  <target>            file / dir / PR to harden\n  --lenses <list>     reviewer lenses (blank = default set)\n  --provider <p>      codex | claude\n  --model <m>         reviewer model\n  --effort <l>        reviewer thinking level\n  --rounds <n>        round budget\nAny option not given is prompted interactively.\nEOF\n      ;;\n    converge) cat >&2 <<'EOF'\nUsage (loop launch): converge [options]\n  --goal <text>       one-line convergence goal (overseer can mutate it)\n  --prompt <text>     prompt sent to the configured agent each round (slash\n                      command, chain, or free-form). The dominant mode.\n  --exec <cmd>        shell command run by a wrapping worker agent each round\n                      (escape hatch for non-agent workflows).\n                      Exactly one of --prompt / --exec is required.\n  --provider <p>      codex | claude\n  --model <m>         worker / overseer model\n  --effort <l>        thinking level\n  --rounds <n>        round budget (blank = default 10)\n  --no-oversee        disable the overseer (rounds budget is the only stop)\n  --oversee-every <n> overseer cadence in rounds (default 1)\nAny option not given is prompted interactively.\nEOF\n      ;;\n  esac\n}\n\n# Public entry: configure and launch a run of TYPE (ralph|harden|converge).\n# Remaining args are that type's native flags; missing fields are prompted.\n# Execs the runner.\nalmanac_loop_launch() {\n  local type=\"${1:-}\"; shift || true\n  case \"$type\" in\n    ralph)    _almanac_launch_ralph \"$@\" ;;\n    harden)   _almanac_launch_harden \"$@\" ;;\n    converge) _almanac_launch_converge \"$@\" ;;\n    \"\")       _die \"Usage: almanac_loop_launch <ralph|harden|converge> [options]\" ;;\n    *)        _die \"Unknown loop type: $type (use ralph, harden, or converge)\" ;;\n  esac\n}\n","numLines":409,"startLine":1,"totalLines":409}}}
