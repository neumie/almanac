{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D9qvLjmqWZHWkThuPfkGdh","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# sync.sh — Check adapted skills for upstream changes\n3\t\n4\tsource \"$ALMANAC_HOME/lib/core.sh\"\n5\tsource \"$ALMANAC_HOME/lib/almanac-core.sh\"\n6\t\n7\tSHOW_DIFF=false\n8\t[ \"${1:-}\" = \"--diff\" ] && SHOW_DIFF=true\n9\t\n10\t# Fetch SHA of a file from GitHub.\n11\t# Emits ONLY a valid 40-char git blob SHA. On 404 / rate-limit, `gh api` prints\n12\t# the JSON error body to stdout — without this guard that body gets captured and\n13\t# mistaken for a SHA, so every skill falsely reports \"changed\".\n14\t_fetch_sha() {\n15\t  local api_path=\"$1\" raw=\"\"\n16\t  if command -v gh &>/dev/null; then\n17\t    raw=$(gh api \"$api_path\" --jq '.sha' 2>/dev/null || true)\n18\t  elif command -v curl &>/dev/null; then\n19\t    raw=$(curl -sL \"https://api.github.com/$api_path\" 2>/dev/null | grep '\"sha\"' | head -1 | sed 's/.*\"sha\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/' || true)\n20\t  else\n21\t    _die \"Neither gh nor curl available\"\n22\t  fi\n23\t  if printf '%s' \"$raw\" | grep -Eq '^[0-9a-f]{40}$'; then\n24\t    printf '%s' \"$raw\"\n25\t  fi\n26\t}\n27\t\n28\t_info \"Checking adapted skills for upstream changes...\"\n29\techo \"\"\n30\t\n31\tfound=0\n32\tup_to_date=0\n33\tchanged=0\n34\tunbaselined=0\n35\terrors=0\n36\t\n37\twhile IFS= read -r skill_dir; do\n38\t  [ -d \"$skill_dir\" ] || continue\n39\t  skill_file=\"$skill_dir/SKILL.md\"\n40\t  [ -f \"$skill_file\" ] || continue\n41\t\n42\t  # Extract upstream metadata from frontmatter\n43\t  frontmatter=$(awk 'BEGIN{f=0} /^---$/{f++; next} f==1{print} f>=2{exit}' \"$skill_file\")\n44\t\n45\t  upstream=$(echo \"$frontmatter\" | grep 'upstream:' | head -1 | sed 's/^[[:space:]]*upstream:[[:space:]]*//' || true)\n46\t  [ -z \"$upstream\" ] && continue\n47\t\n48\t  upstream_sha=$(echo \"$frontmatter\" | grep 'upstream-sha:' | head -1 | sed 's/^[[:space:]]*upstream-sha:[[:space:]]*//' || true)\n49\t  adapted_date=$(echo \"$frontmatter\" | grep 'adapted-date:' | head -1 | sed 's/^[[:space:]]*adapted-date:[[:space:]]*//' | tr -d '\"' || true)\n50\t"}]},"parent_tool_use_id":"toolu_01WYQyxcojgyBHfYkApZpoqk","session_id":"14593634-940e-4f64-9481-34cf5bee965a","uuid":"43289ceb-508d-4fcc-831a-a5031911bfd5","timestamp":"2026-05-26T13:47:21.091Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
