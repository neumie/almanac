{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KpucBHCWce7KS3vbmSKopg","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# harden-core.sh - Harden loop rubric bootstrap + reviewer helpers\n3\t\n4\t# loop-core.sh (the old shared-engine barrel) is deleted; harden-core sources the\n5\t# focused modules it actually uses, each directly and idempotently so it works\n6\t# both through bin/almanac and when a test sources this file directly. pwd -P\n7\t# resolves the install symlink so the siblings are found from either path.\n8\t#\n9\t# Output helpers (_die/_info/_warn/…) — lib/core.sh. (Came in transitively via\n10\t# loop-core before; now an explicit dependency.)\n11\tif ! declare -F _error >/dev/null 2>&1; then\n12\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n13\t  # shellcheck source=lib/core.sh\n14\t  source \"$__harden_core_dir/core.sh\"\n15\t  unset __harden_core_dir\n16\tfi\n17\t\n18\t# The agent run shapes (almanac_loop_agent_capture, the ratify/fixer path) live in\n19\t# lib/agent.sh.\n20\tif ! declare -F almanac_loop_agent_capture >/dev/null 2>&1; then\n21\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n22\t  # shellcheck source=lib/agent.sh\n23\t  source \"$__harden_core_dir/agent.sh\"\n24\t  unset __harden_core_dir\n25\tfi\n26\t\n27\t# The run registry + worker path/health helpers (register/mark/update the run,\n28\t# worker_status_file / worker_file / worker_health_of) live in lib/run.sh.\n29\tif ! declare -F almanac_loop_register_run >/dev/null 2>&1; then\n30\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n31\t  # shellcheck source=lib/run.sh\n32\t  source \"$__harden_core_dir/run.sh\"\n33\t  unset __harden_core_dir\n34\tfi\n35\t\n36\t# Worker orchestration (almanac_loop_worker_start / _worker_watch — the reviewer/\n37\t# fixer fan-out) lives in lib/worker.sh.\n38\tif ! declare -F almanac_loop_worker_start >/dev/null 2>&1; then\n39\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n40\t  # shellcheck source=lib/worker.sh\n41\t  source \"$__harden_core_dir/worker.sh\"\n42\t  unset __harden_core_dir\n43\tfi\n44\t\n45\t# The dashboard composes the gum-or-plain UI seam (status glyph / render / clear)\n46\t# from lib/ui.sh — source it directly and idempotently so harden-core's own\n47\t# dependency is explicit (not borrowed transitively).\n48\tif ! declare -F almanac_loop_ui_render >/dev/null 2>&1; then\n49\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n50\t  # shellcheck source=lib/ui.sh\n51\t  source \"$__harden_core_dir/ui.sh\"\n52\t  unset __harden_core_dir\n53\tfi\n54\t\n55\t# Per-role provider/model/effort resolution (almanac_loop_role_config) lives in\n56\t# lib/role.sh — source it directly and idempotently so harden-core's dependency\n57\t# on the role resolver is explicit (not borrowed transitively).\n58\tif ! declare -F almanac_loop_role_config >/dev/null 2>&1; then\n59\t  __harden_core_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n60\t  # shellcheck source=lib/role.sh"}]},"parent_tool_use_id":"toolu_01WYQyxcojgyBHfYkApZpoqk","session_id":"14593634-940e-4f64-9481-34cf5bee965a","uuid":"99142ce1-8cde-4101-a840-6a7985068171","timestamp":"2026-05-26T13:47:24.783Z","subagent_type":"Explore","task_description":"Find architectural friction in almanac"}
